package dev.cajeta.wgrtime;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelTimer;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;

/** workgroup-reduce 6.1.2: device time per launch of the seven moved kernels at the engine's shapes. Prints kernel, min and median us over 15 brackets of 200 launches. */
public class WgrTiming {

    static final int64 DIM = 2048L;
    static final int64 COLS = 768L;
    static final int32 USED = 8;
    static final int32 EXPERTS = 128;
    static final int32 NH = 32;
    static final int32 NKV = 4;
    static final int32 HD = 128;
    static final int32 SPLITS = 8;

    KernelBuffer<float32> q;
    KernelBuffer<float32> k;
    KernelBuffer<float32> v;
    KernelBuffer<float16> kp;
    KernelBuffer<float16> vp;
    KernelBuffer<float32> qw;
    KernelBuffer<float32> kw;
    KernelBuffer<float32> inv;
    KernelBuffer<float32> part;
    KernelBuffer<int8> packedA;
    KernelBuffer<float32> hs;
    KernelBuffer<float32> nw;
    KernelBuffer<float32> wSel;
    KernelBuffer<int32> sel;
    KernelBuffer<int32> counter;
    KernelBuffer<int8> xp;
    KernelBuffer<float32> nOut;
    KernelBuffer<int8> pk;
    KernelBuffer<int8> slab4;
    KernelBuffer<int8> slab6;
    KernelBuffer<int8> img;
    KernelBuffer<int8> deq;
    KernelBuffer<float32> wRouter;
    KernelBuffer<float32> logits;
    KernelBuffer<int32> rSel;
    KernelBuffer<float32> rW;

    public WgrTiming() { return; }

    static #KernelBuffer<float32> floats(int64 n, int64 salt) {
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float32) (((i * 37L + salt * 11L) % 101L) - 50L) / 64.0f;
            i = i + 1;
        }
        KernelBuffer<float32> b #= heap KernelBuffer<float32>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<float16> halves(int64 n) {
        float16[] h = heap float16[n];
        KernelBuffer<float16> b #= heap KernelBuffer<float16>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<int8> zeros(int64 n) {
        int8[] h = heap int8[n];
        KernelBuffer<int8> b #= heap KernelBuffer<int8>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<int32> ints(int64 n, int32 step) {
        int32[] h = heap int32[n];
        int64 i = 0;
        while (i < n) { h[i] = (int32) i * step; i = i + 1; }
        KernelBuffer<int32> b #= heap KernelBuffer<int32>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    void setup() {
        int64 qd = (int64) (WgrTiming.NH * WgrTiming.HD);
        int64 kvd = (int64) (WgrTiming.NKV * WgrTiming.HD);
        this.q #= WgrTiming.floats(qd, 1L);
        this.k #= WgrTiming.floats(kvd, 2L);
        this.v #= WgrTiming.floats(kvd, 3L);
        this.kp #= WgrTiming.halves(kvd * 64L);
        this.vp #= WgrTiming.halves(kvd * 64L);
        this.qw #= WgrTiming.floats((int64) WgrTiming.HD, 4L);
        this.kw #= WgrTiming.floats((int64) WgrTiming.HD, 5L);
        this.inv #= WgrTiming.floats((int64) (WgrTiming.HD / 2), 6L);
        int64 pn = (int64) WgrTiming.NH * (int64) WgrTiming.SPLITS * 130L;
        this.part #= WgrTiming.floats(pn, 7L);
        this.packedA #= WgrTiming.zeros((int64) (WgrTiming.NH / 2) * 320L);
        int64 rows = WgrTiming.DIM;
        int64 cols = WgrTiming.COLS;
        int64 used = (int64) WgrTiming.USED;
        this.hs #= WgrTiming.floats(rows, 8L);
        this.nw #= WgrTiming.floats(rows, 9L);
        float32[] w0 = heap float32[used];
        this.wSel #= heap KernelBuffer<float32>((uint64) used);
        this.wSel.upload(w0, used);
        this.sel #= WgrTiming.ints(used, 1);
        this.counter #= WgrTiming.ints(4L, 0);
        int64 xRowBlocks = cols / 256L;
        this.xp #= WgrTiming.zeros(used * xRowBlocks * 320L + 64L);
        this.nOut #= heap KernelBuffer<float32>((uint64) rows);
        this.pk #= WgrTiming.zeros((rows / 256L) * 320L);
        int64 bpr = cols / 256L;
        this.slab4 #= WgrTiming.zeros(used * rows * bpr * 144L + 512L);
        int64 row6 = ((bpr * 2L + 3L) / 4L) * 4L + bpr * 208L;
        this.slab6 #= WgrTiming.zeros(used * rows * row6 + 512L);
        int64 sbpr = cols / 32L;
        this.img #= WgrTiming.zeros(used * rows * sbpr * 2L + 64L);
        this.deq #= WgrTiming.zeros(used * ((rows / 16L + 1L) * sbpr * 512L) + 512L);
        int64 e = (int64) WgrTiming.EXPERTS;
        this.wRouter #= WgrTiming.floats(e * rows, 10L);
        this.logits #= heap KernelBuffer<float32>((uint64) e);
        this.rSel #= WgrTiming.ints(used, 0);
        this.rW #= heap KernelBuffer<float32>((uint64) used);
        QuantKernel.stream().sync();
    }

    static String name(int32 which) {
        if (which == 0) { return "qkPrepKernel"; }
        if (which == 1) { return "attnReducePackQ8Kernel"; }
        if (which == 2) { return "q4kQ8IdDownCombineKernel"; }
        if (which == 3) { return "q6kQ8IdDownCombineKernel"; }
        if (which == 4) { return "symQ8IdDownCombineKernel"; }
        if (which == 5) { return "routerTopKWaveKernel"; }
        return "rmsnormRouterTopKKernel";
    }

    void once(int32 which) {
        int64 rows = WgrTiming.DIM;
        int64 cols = WgrTiming.COLS;
        int32 used = WgrTiming.USED;
        int64 xrb = cols / 256L;
        if (which == 0) {
            AttnKernel.qkPrepLaunchNoSync(this.q, this.k, this.v, this.kp, this.vp,
                this.qw, this.kw, this.inv, WgrTiming.NH, WgrTiming.NKV, WgrTiming.HD,
                true, 0.000001f, 0, 11, 11);
        } else if (which == 1) {
            AttnKernel.reducePackFromLaunchNoSync(this.packedA, this.part,
                WgrTiming.NH, WgrTiming.SPLITS);
        } else if (which == 2) {
            QuantKernel.idDownCombineTailLaunchNoSync(12, this.hs, this.slab4, this.xp,
                this.sel, this.wSel, used, rows, cols, xrb, this.nOut, this.pk,
                this.nw, rows, 0.000001f, 1, this.counter);
        } else if (which == 3) {
            QuantKernel.idDownCombineTailLaunchNoSync(14, this.hs, this.slab6, this.xp,
                this.sel, this.wSel, used, rows, cols, xrb, this.nOut, this.pk,
                this.nw, rows, 0.000001f, 1, this.counter);
        } else if (which == 4) {
            QuantKernel.symQ8IdDownCombineTailLaunchNoSync(this.hs, this.deq, this.img,
                this.xp, this.sel, this.wSel, used, rows, cols, xrb, this.nOut,
                this.pk, this.nw, rows, 0.000001f, 1, this.counter);
        } else if (which == 5) {
            QuantKernel.routerTopKWaveLaunchNoSync(this.rSel, this.rW, this.logits,
                this.wRouter, this.hs, this.counter, (int64) WgrTiming.EXPERTS, rows,
                (int64) used, true, 0.0f);
        } else {
            QuantKernel.rmsnormRouterTopKLaunchNoSync(this.nOut, this.pk, this.hs, this.nw,
                rows, 0.000001f, 0, this.rSel, this.rW, this.logits, this.wRouter,
                this.counter, (int64) WgrTiming.EXPERTS, (int64) used, true, 0.0f);
        }
    }

    static void sort(float64[] a, int32 n) {
        int32 i = 1;
        while (i < n) {
            float64 x = a[i];
            int32 j = i - 1;
            while (j >= 0 && a[j] > x) { a[j + 1] = a[j]; j = j - 1; }
            a[j + 1] = x;
            i = i + 1;
        }
    }

    public static void run() {
        int32 launches = 200;
        int32 repeats = 15;
        WgrTiming t #= heap WgrTiming();
        t.setup();
        KernelStream s = QuantKernel.stream();
        System.stdout.println("# backend " + Device.activeBackend() + " wave " + Device.waveSize()
            + " tier " + KernelTimer.tier() + " scale " + KernelTimer.clockScale());
        KernelTimer kt #= KernelTimer.create();
        float64[] us = heap float64[repeats];
        int32 which = 0;
        while (which < 7) {
            int32 i = 0;
            while (i < 20) { t.once(which); i = i + 1; }
            s.sync();
            int32 r = 0;
            while (r < repeats) {
                kt.begin(s);
                i = 0;
                while (i < launches) { t.once(which); i = i + 1; }
                kt.end(s);
                int64 ns = kt.elapsedNanos();
                us[r] = (float64) ns / 1000.0 / (float64) launches;
                r = r + 1;
            }
            s.sync();
            WgrTiming.sort(us, repeats);
            System.stdout.println(WgrTiming.name(which) + "\t" + us[0]
                + "\t" + us[repeats / 2]);
            which = which + 1;
        }
        kt.destroy();
    }
}
