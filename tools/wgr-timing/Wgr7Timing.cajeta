package dev.cajeta.wgrtime;

import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelTimer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;

/** workgroup-reduce 7.1.4: device time per launch of the six tree sites at the engine's shapes. Prints kernel, min and median us over 15 brackets of 200 launches. */
public class Wgr7Timing {

    static final int32 NH = 32;
    static final int32 NKV = 4;
    static final int32 HD = 128;
    static final int32 COUNT = 512;
    static final int32 ROWS = 128;
    static final int64 DIM = 2048L;
    static final int64 COLS = 768L;
    static final int32 USED = 8;
    static final int64 EXPERTS = 128L;
    static final int64 HID = 2048L;

    KernelBuffer<float32> q;
    KernelBuffer<float32> qRows;
    KernelBuffer<float16> kp;
    KernelBuffer<float16> vp;
    KernelBuffer<float32> scores;
    KernelBuffer<float32> scoresRows;
    KernelBuffer<float32> out;
    KernelBuffer<float32> outRows;
    KernelBuffer<float32> hs;
    KernelBuffer<float32> nw;
    KernelBuffer<float32> wSel;
    KernelBuffer<int32> sel;
    KernelBuffer<int32> counter;
    KernelBuffer<int8> xp;
    KernelBuffer<float32> nOut;
    KernelBuffer<int8> pk;
    KernelBuffer<int8> slab;
    KernelBuffer<float32> wRouter;
    KernelBuffer<float32> x;
    KernelBuffer<float32> logits;
    KernelBuffer<int32> rSel;
    KernelBuffer<float32> rW;

    public Wgr7Timing() { return; }

    static #KernelBuffer<float32> floats(int64 n, int64 salt) {
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float32) (((i * 37L + salt * 11L) % 101L) - 50L) / 64.0f;
            i = i + 1;
        }
        KernelBuffer<float32> b #= heap KernelBuffer<float32>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<float16> halves(int64 n, int64 salt) {
        float16[] h = heap float16[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float16) ((float32) (((i * 29L + salt * 7L) % 61L) - 30L) / 32.0f);
            i = i + 1;
        }
        KernelBuffer<float16> b #= heap KernelBuffer<float16>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<int8> zeros(int64 n) {
        int8[] h = heap int8[n];
        KernelBuffer<int8> b #= heap KernelBuffer<int8>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<int32> ints(int64 n, int32 step) {
        int32[] h = heap int32[n];
        int64 i = 0;
        while (i < n) { h[i] = (int32) i * step; i = i + 1; }
        KernelBuffer<int32> b #= heap KernelBuffer<int32>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    void setup() {
        int64 qd = (int64) (Wgr7Timing.NH * Wgr7Timing.HD);
        int64 kvd = (int64) (Wgr7Timing.NKV * Wgr7Timing.HD);
        int64 ctx = (int64) Wgr7Timing.COUNT;
        this.q #= Wgr7Timing.floats(qd, 1L);
        this.qRows #= Wgr7Timing.floats(qd * (int64) Wgr7Timing.ROWS, 2L);
        this.kp #= Wgr7Timing.halves(kvd * ctx, 3L);
        this.vp #= Wgr7Timing.halves(kvd * ctx, 4L);
        this.scores #= heap KernelBuffer<float32>((uint64) ((int64) Wgr7Timing.NH * ctx));
        this.scoresRows #= heap KernelBuffer<float32>(
            (uint64) ((int64) Wgr7Timing.ROWS * (int64) Wgr7Timing.NH * (int64) Wgr7Timing.ROWS));
        this.out #= heap KernelBuffer<float32>((uint64) qd);
        this.outRows #= heap KernelBuffer<float32>((uint64) (qd * (int64) Wgr7Timing.ROWS));
        int64 rows = Wgr7Timing.DIM;
        int64 cols = Wgr7Timing.COLS;
        int64 used = (int64) Wgr7Timing.USED;
        this.hs #= Wgr7Timing.floats(rows, 8L);
        this.nw #= Wgr7Timing.floats(rows, 9L);
        float32[] w0 = heap float32[used];
        this.wSel #= heap KernelBuffer<float32>((uint64) used);
        this.wSel.upload(w0, used);
        this.sel #= Wgr7Timing.ints(used, 1);
        this.counter #= Wgr7Timing.ints(4L, 0);
        int64 xRowBlocks = cols / 256L;
        this.xp #= Wgr7Timing.zeros(used * xRowBlocks * 320L + 64L);
        this.nOut #= heap KernelBuffer<float32>((uint64) rows);
        this.pk #= Wgr7Timing.zeros((rows / 256L) * 320L);
        int64 bpr = cols / 32L;
        int64 rowBytes = ((bpr * 2L + 3L) / 4L) * 4L + bpr * 16L;
        this.slab #= Wgr7Timing.zeros(used * rows * rowBytes + 512L);
        this.wRouter #= Wgr7Timing.floats(Wgr7Timing.EXPERTS * Wgr7Timing.HID, 10L);
        this.x #= Wgr7Timing.floats(Wgr7Timing.HID, 11L);
        this.logits #= heap KernelBuffer<float32>((uint64) Wgr7Timing.EXPERTS);
        this.rSel #= Wgr7Timing.ints(used, 0);
        this.rW #= heap KernelBuffer<float32>((uint64) used);
        AttnKernel.setFlashDecode(false);
        AttnKernel.setPrefillTile(false);
        AttnKernel.setAttnFlash(false);
        AttnKernel.setAttnV2(false);
        AttnKernel.setSkipForMeasurement(8 | 16);
        QuantKernel.stream().sync();
    }

    static String name(int32 which) {
        if (which == 0) { return "attnScoreKernel"; }
        if (which == 1) { return "attnScorePrefillRowKernel"; }
        if (which == 2) { return "attnScorePrefillKernel"; }
        if (which == 3) { return "iq4nlQ8IdDownCombineKernel"; }
        if (which == 4) { return "routerF32MatVecKernel"; }
        return "routerTopKKernel";
    }

    void once(int32 which) {
        float32 scale = 1.0f / Math.sqrt((float32) Wgr7Timing.HD);
        if (which == 0) {
            AttnKernel.attendDecodeLaunchNoSync(this.out, this.scores, this.q, this.kp,
                this.vp, Wgr7Timing.NH, Wgr7Timing.NKV, Wgr7Timing.HD, Wgr7Timing.COUNT,
                0, Wgr7Timing.COUNT, scale);
        } else if (which == 1 || which == 2) {
            AttnKernel.setRowScore(which == 1);
            AttnKernel.attendPrefillLaunchNoSync(this.outRows, this.scoresRows, this.qRows,
                this.kp, this.vp, Wgr7Timing.ROWS, Wgr7Timing.NH, Wgr7Timing.NKV,
                Wgr7Timing.HD, 0, Wgr7Timing.ROWS, scale);
        } else if (which == 3) {
            QuantKernel.idDownCombineTailLaunchNoSync(Quant.GG_IQ4_NL, this.hs, this.slab,
                this.xp, this.sel, this.wSel, Wgr7Timing.USED, Wgr7Timing.DIM,
                Wgr7Timing.COLS, Wgr7Timing.COLS / 256L, this.nOut, this.pk, this.nw,
                Wgr7Timing.DIM, 0.000001f, 1, this.counter);
        } else if (which == 4) {
            QuantKernel.routerF32MatVecLaunchNoSync(this.logits, this.wRouter, this.x,
                Wgr7Timing.EXPERTS, Wgr7Timing.HID);
        } else {
            QuantKernel.routerTopKLaunchNoSync(this.rSel, this.rW, this.logits,
                this.wRouter, this.x, this.counter, Wgr7Timing.EXPERTS, Wgr7Timing.HID,
                (int64) Wgr7Timing.USED, true, 0.0f);
        }
    }

    static void sort(float64[] a, int32 n) {
        int32 i = 1;
        while (i < n) {
            float64 x = a[i];
            int32 j = i - 1;
            while (j >= 0 && a[j] > x) { a[j + 1] = a[j]; j = j - 1; }
            a[j + 1] = x;
            i = i + 1;
        }
    }

    public static void run() {
        int32 launches = 200;
        int32 repeats = 15;
        Wgr7Timing t #= heap Wgr7Timing();
        t.setup();
        KernelStream s = QuantKernel.stream();
        System.stdout.println("# backend " + Device.activeBackend() + " wave " + Device.waveSize()
            + " tier " + KernelTimer.tier() + " scale " + KernelTimer.clockScale());
        KernelTimer kt #= KernelTimer.create();
        float64[] us = heap float64[repeats];
        int32 which = 0;
        while (which < 6) {
            int32 i = 0;
            while (i < 20) { t.once(which); i = i + 1; }
            s.sync();
            int32 r = 0;
            while (r < repeats) {
                kt.begin(s);
                i = 0;
                while (i < launches) { t.once(which); i = i + 1; }
                kt.end(s);
                int64 ns = kt.elapsedNanos();
                us[r] = (float64) ns / 1000.0 / (float64) launches;
                r = r + 1;
            }
            s.sync();
            Wgr7Timing.sort(us, repeats);
            System.stdout.println(Wgr7Timing.name(which) + "\t" + us[0]
                + "\t" + us[repeats / 2]);
            which = which + 1;
        }
        kt.destroy();
    }
}
