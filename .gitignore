build/

# Compiler cache — bitcode and prebuilt archives, regenerated on every build.
**/.cajeta/cache/
tmp/

# Build artifacts NEVER belong in src/. 75 of them (8 MB) were committed on
# 2026-08-27 because a compile handed two source roots binds the SECOND to the
# output directory and drops objects into it — silently, at exit 0. That is a
# compiler defect (fixed in cajeta c963d19b, which now rejects the arity), but
# the ignore stays as a backstop: nothing generated belongs beside sources.
*.o
*.obj
app.jsonl

# Profiler traces. `cajeta profile summary cajeta.pftrace` is the documented
# way to read a bench probe's timeline (see bench/Mxfp4Bench), so the trace
# lands in the working copy every time anyone follows those instructions.
*.pftrace

# Kernel manifests the toolchain stages beside the archive it is building.
# `./run-tests.sh` regenerates `deps/llama/` (197 files) on every run even
# though it points the compiler at a mktemp output directory, so this is
# not a stray path someone once passed by hand -- it comes back for anyone
# who runs the suite.
deps/
