package dev.cajeta.llama.model;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.math.Tensor;
import dev.cajeta.llama.LlamaException;
import dev.cajeta.llama.io.Checkpoint;

/**
 * The tape-free inference model (plan Unit 6; spec §4). Construction
 * builds the decoder stack from a HF `config.json`; binding loads HF
 * safetensors by torch `state_dict` name with no rename table; the
 * forward path is decode-first:
 *
 * - {@link #decodeStep} runs one token through pooled activations and
 *   the in-place KV cache — ZERO heap allocations per step (6.1.6), so
 *   the global live-set mutex never enters the hot path.
 * - {@link #prefill} runs the prompt through ONE arena block sized to the
 *   actual sequence length, carved into borrowed slices (spec 4.9/4.10);
 *   nothing survives the call, so peak activation memory is O(one layer)
 *   regardless of depth (6.1.1).
 *
 * Under `tie_word_embeddings` the `lmHead` field stays null and logits
 * are produced against the embedding matrix (spec 4.7).
 *
 * v1 computes on the HOST at f32; a model loaded `toDevice` is fully
 * device-resident after binding (6.1.4), and Unit 7's kernels take the
 * forward path to the device behind the same HostOps seams.
 */
public final class LlamaForCausalLM extends InfModule {
    // Walked fields first: these two produce the state_dict key space.
    LlamaModel model;
    Linear lmHead;          // null when tie_word_embeddings (spec 4.7)

    // Non-parameter state (skipped by the reflective walk).
    ModelConfig cfg;
    ActivationPool pool;
    PagedKvCache cache;
    int32 maxSeq;
    int32 maxSeqsN;
    int32 pos;

    /**
     * `maxSeqs` sequences share the cache pool; `numBlocks` 0 auto-sizes
     * so every sequence can hold a full context (the scheduler passes a
     * deliberately scarcer pool to exercise admission and preemption).
     */
    public LlamaForCausalLM(#ModelConfig cfg, int32 maxSeq, int32 maxSeqs,
            int32 numBlocks) {
        this.cfg #= cfg;
        this.model = heap LlamaModel(this.cfg);
        if (this.cfg.tieWordEmbeddings) {
            this.lmHead = null;
        } else {
            this.lmHead = heap Linear(this.cfg.hiddenSize,
                this.cfg.vocabSize);
        }
        this.pool = heap ActivationPool(this.cfg, maxSeq);
        // Pool capacity: every unwindowed layer can hold a full-context
        // sequence (windowed layers keep rings and draw no blocks).
        int32 blocksPerSeq = (maxSeq + this.cfg.blockTokens - 1)
            / this.cfg.blockTokens;
        int32 fullLayers = 0;
        int32 li = 0;
        while (li < this.cfg.numLayers) {
            if (this.cfg.windowForLayer(li) == 0) {
                fullLayers = fullLayers + 1;
            }
            li = li + 1;
        }
        int32 nb = numBlocks;
        if (nb == 0) {
            nb = fullLayers * blocksPerSeq * maxSeqs;
        }
        if (nb == 0) {
            nb = 1;
        }
        this.cache = heap PagedKvCache(this.cfg, maxSeq, maxSeqs, nb);
        this.maxSeq = maxSeq;
        this.maxSeqsN = maxSeqs;
        this.pos = 0;
    }

    public int32 maxSequences() {
        return this.maxSeqsN;
    }

    public int32 layerCount() {
        return this.cfg.numLayers;
    }

    /** The cache — observable occupancy for tests and the scheduler. */
    /** The vocabulary width, for a caller inspecting logits. */
    public int32 vocabSize() { return this.cfg.vocabSize; }

    /** Logit `i` of the last step — the measurement surface for the
     *  top-2 gap at a divergence. */
    public float32 logitAt(int32 i) {
        return this.pool.logits.flatGet((int64) i);
    }

    public PagedKvCache kvCache() {
        return this.cache;
    }

    /** Parse config, build the stack, bind the checkpoint. */
    public static #LlamaForCausalLM load(String configPath, String ckptPath,
            int32 maxSeq, boolean toDevice) {
        LlamaForCausalLM m = heap LlamaForCausalLM(
            ModelConfig.parse(configPath), maxSeq, 1, 0);
        Checkpoint ckpt = Checkpoint.open(ckptPath);
        m.bind(ckpt, toDevice);
        ckpt.close();
        return #m;
    }

    /** Bind every parameter from `ckpt` by its torch state_dict key. */
    public void bind(Checkpoint ckpt, boolean toDevice) {
        this.model.bind(ckpt, toDevice);
        if (this.lmHead != null) {
            this.lmHead.bind(ckpt, "lm_head.weight", toDevice);
        }
    }

    public int32 position() {
        return this.pos;
    }

    public int32 vocabSize() {
        return this.cfg.vocabSize;
    }

    /** The logits of the most recent step — a borrow of pooled storage. */
    public Tensor<float32> logits() {
        return this.pool.logits;
    }

    /**
     * Run the prompt `tokens[0, n)` from the current position of the
     * DEFAULT sequence — sequence 0's convenience wrapper over
     * {@link #stepSeq}.
     */
    public int32 prefill(int32[] tokens, int32 n) {
        int32 r = this.stepSeq(0, tokens, 0, n);
        this.pos = this.seqLength(0);
        return r;
    }

    /**
     * THE step function (spec 13.14): consume `n` tokens
     * `tokens[off, off+n)` of sequence `seq` from its current cache
     * length — a prefill chunk at n=chunk, a decode at n=1, one forward
     * path. Returns the argmax over the LAST consumed position's logits
     * (meaningful when that position is the sequence's newest token;
     * interior chunks' argmax is discarded by the caller). n=1 runs in
     * pooled buffers (zero allocations); larger chunks carve one arena
     * block sized to the actual chunk (spec 4.9).
     */
    public int32 stepSeq(int32 seq, int32[] tokens, int32 off, int32 n) {
        if (n <= 0) {
            throw heap LlamaException("step: token count must be positive");
        }
        int32 seqPos = this.seqLength(seq);
        if (seqPos + n > this.maxSeq) {
            throw heap LlamaException("step: " + n
                + " tokens at position " + seqPos
                + " exceeds maxSeq " + this.maxSeq);
        }
        if (n == 1) {
            return this.stepOne(seq, tokens[off]);
        }
        int64 rows = (int64) n;
        int64 h = (int64) this.cfg.hiddenSize;
        int64 qd = (int64) this.cfg.qDim();
        int64 kvd = (int64) this.cfg.kvDim();
        int64 inter = (int64) this.cfg.intermediateSize;

        // One block sized to the ACTUAL sequence length (spec 4.9).
        int64 total = rows * (h * 4 + qd * 2 + kvd * 2 + inter * 2);
        PrefillArena arena = heap PrefillArena(total);
        Tensor<float32> hs = arena.take(rows, h);
        Tensor<float32> xn = arena.take(rows, h);
        Tensor<float32> proj = arena.take(rows, h);
        Tensor<float32> mlpOut = arena.take(rows, h);
        Tensor<float32> q = arena.take(rows, qd);
        Tensor<float32> ao = arena.take(rows, qd);
        Tensor<float32> k = arena.take(rows, kvd);
        Tensor<float32> v = arena.take(rows, kvd);
        Tensor<float32> gate = arena.take(rows, inter);
        Tensor<float32> up = arena.take(rows, inter);

        Tensor<float32> emb = this.model.embedTokens.weight;
        int32 r = 0;
        while (r < n) {
            this.model.embedTokens.rowIntoTensor(tokens[off + r], hs,
                (int64) r * h, this.cfg.hiddenSize);
            r = r + 1;
        }
        int32 seqPos2 = this.seqLength(seq);
        this.forwardRows(seq, hs, xn, q, k, v, ao, proj, gate, up, mlpOut,
            n, seqPos2);
        return HostOps.argmaxRow(this.pool.logits, this.cfg.vocabSize);
    }

    /**
     * One decode step for `token` at the current position of sequence 0,
     * entirely in pooled buffers: zero heap allocations (6.1.6). Returns
     * the argmax of the resulting logits.
     */
    public int32 decodeStep(int32 token) {
        int32 r = this.stepOne(0, token);
        this.pos = this.seqLength(0);
        return r;
    }

    /** The N=1 specialization of {@link #stepSeq}: pooled buffers, zero
     *  heap allocations, same `forwardRows`. */
    int32 stepOne(int32 seq, int32 token) {
        int32 seqPos = this.seqLength(seq);
        if (seqPos >= this.maxSeq) {
            throw heap LlamaException("decode: context is full (maxSeq "
                + this.maxSeq + ")");
        }
        ActivationPool p = this.pool;
        this.model.embedTokens.rowIntoTensor(token, p.x, 0,
            this.cfg.hiddenSize);
        this.forwardRows(seq, p.x, p.xn, p.q, p.k, p.v, p.attnOut,
            p.attnProj, p.gate, p.up, p.mlpOut, 1, seqPos);
        return HostOps.argmaxRow(p.logits, this.cfg.vocabSize);
    }

    /**
     * The shared step function over `rows` consecutive positions starting
     * at absolute `startPos`: the layer stack (norm → GQA attention with
     * causal-by-construction cache reads → norm → SwiGLU, residuals in
     * place on `hs`), then the final norm and the output projection of
     * the LAST row into `pool.logits`. Buffers are caller-owned; row `r`
     * of a buffer is its flat range `[r·dim, (r+1)·dim)`.
     */
    void forwardRows(int32 seq, Tensor<float32> hs, Tensor<float32> xn,
            Tensor<float32> q, Tensor<float32> k, Tensor<float32> v,
            Tensor<float32> ao, Tensor<float32> proj,
            Tensor<float32> gate, Tensor<float32> up,
            Tensor<float32> mlpOut, int32 rows, int32 startPos) {
        int32 h = this.cfg.hiddenSize;
        int32 qd = this.cfg.qDim();
        int32 kvd = this.cfg.kvDim();
        int32 inter = this.cfg.intermediateSize;
        int32 nH = this.cfg.numHeads;
        int32 nKv = this.cfg.numKvHeads;
        int32 hd = this.cfg.headDim;
        Tensor<float32> scores = this.pool.scores;

        // FULL LAYER RESIDENCY (plan 10.2), when the layout allows it.
        // Gated on the Llama shape — no QK-norm, no four-norm — because the
        // extra norms in the other layouts have no device path yet, and a
        // half-resident layer that silently used a stale `hs` would be the
        // worst of both. rows==1 because only decode has a residual chain
        // short enough for one buffer.
        boolean resident = rows == 1 && this.deviceResidentReady();
        if (!resident) {
            // The host path reads K/V bytes, so the device planes owe the
            // cache whatever they hold beyond it (10.11.2). Prefill, a
            // non-Llama layout and a disabled route all land here.
            this.syncKvToHost(seq);
        }
        if (resident) {
            this.ensureResidentBuffers(h);
            this.ensureDeviceKv(seq);
            float32[] hb = hs.hostBuffer();
            int64 hbase = hs.hostBase();
            int64 ci = 0;
            while (ci < (int64) h) {
                this.hsHost[ci] = hb[hbase + ci];
                ci = ci + 1;
            }
            this.hsDev.upload(this.hsHost);
        }

        // BATCHED PREFILL (plan 10.12.1). The projections run over ALL
        // rows at once so a 32-token tile shares one pass over the
        // weights; the per-row path below reads all 4.58 GB of an 8B
        // checkpoint once PER PROMPT TOKEN, which is 2.4 TB for a
        // 512-token prompt and is why prefill(512) took 34 s.
        boolean batched = rows > 1 && this.batchReady();
        if (batched && LlamaForCausalLM.devAttnOn
                && DeviceKv.supports(this.cfg)) {
            // The prefill attend needs the device planes; the same ones
            // decode then inherits, already holding the prompt, so the
            // 10.11 seed becomes free.
            if (this.dkv == null) {
                this.dkv #= heap DeviceKv(this.cfg, this.maxSeq);
                this.dkv.bindRope(this.model);
            }
        }
        if (rows > 1 && !this.batchSaid) {
            // SAY whether it engaged. The first version of this only knew
            // Q4_K, and Q4_K_M is a MIXTURE — attn_v and some ffn_down are
            // Q6_K — so `batchReady` was false and the whole prefill ran
            // per row. It read as "batching bought 4%" when it never ran.
            this.batchSaid = true;
            if (batched) {
                System.stdout.println("prefill: BATCHED projections");
            } else {
                System.stdout.println("prefill: per-row projections "
                    + "(no batched GEMM for some weight type)");
            }
        }
        if (batched) {
            this.forwardRowsBatched(seq, hs, xn, q, k, v, ao, proj, gate,
                up, mlpOut, rows, startPos, h, qd, kvd, inter, nH, nKv, hd,
                scores);
            return;
        }

        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            if (resident) {
                this.residentLayer(seq, l, d, a, q, k, v, ao, scores,
                    h, qd, kvd, inter, nH, nKv, hd, startPos);
                l = l + 1;
                continue;
            }
            int32 r = 0;
            while (r < rows) {
                int64 rh = (int64) r * (int64) h;
                int64 rq = (int64) r * (int64) qd;
                int64 rkv = (int64) r * (int64) kvd;
                int64 ri = (int64) r * (int64) inter;
                int32 p = startPos + r;

                // Attention sublayer.
                Prim.rmsnormRowHost(hs, rh, d.inputLayernorm.weight,
                    d.inputLayernorm.eps, xn, rh, h, d.normForm);
                // A NEW activation is current: `xn` was just rewritten at
                // `rh`. q, k and v then all read that same window, and the
                // shared stage quantizes and uploads it once instead of three
                // times. Declared here rather than inferred, because `xn` is
                // reused at the same offset every layer — identity and offset
                // cannot tell layer N's activation from layer N+1's.
                Linear.beginSharedActivation();
                a.qProj.matvecInto(xn, rh, q, rq);
                a.kProj.matvecInto(xn, rh, k, rkv);
                a.vProj.matvecInto(xn, rh, v, rkv);
                Linear.endSharedActivation();
                if (a.qNorm != null) {
                    // QK-norm BEFORE RoPE (spec 5.10), per head.
                    int32 hh = 0;
                    while (hh < nH) {
                        Prim.rmsnormRowHost(q, rq + (int64) (hh * hd),
                            a.qNorm.weight, a.qNorm.eps,
                            q, rq + (int64) (hh * hd), hd, d.normForm);
                        hh = hh + 1;
                    }
                    hh = 0;
                    while (hh < nKv) {
                        Prim.rmsnormRowHost(k, rkv + (int64) (hh * hd),
                            a.kNorm.weight, a.kNorm.eps,
                            k, rkv + (int64) (hh * hd), hd, d.normForm);
                        hh = hh + 1;
                    }
                }
                // RoPE at the ABSOLUTE position, per-layer frequencies —
                // never the ring slot (spec 6.10).
                Prim.ropeRowHost(q, rq, nH, hd, p, a.ropeInv);
                Prim.ropeRowHost(k, rkv, nKv, hd, p, a.ropeInv);
                if (!this.cache.appendRow(seq, l, k, rkv, v, rkv, p)) {
                    // The scheduler's admission/headroom arithmetic must
                    // prevent this; hitting it here is an invariant
                    // violation, not a schedulable event (6.4, 13.15).
                    throw heap LlamaException("kv pool exhausted at layer "
                        + l + " position " + p);
                }
                // Causal by construction; the layer's window clamps in
                // prefill AND decode inside the cache read (spec 5.9).
                this.cache.attendRow(seq, l, q, rq, a.scale, scores, ao, rq,
                    nH, nKv, hd);
                a.oProj.matvecInto(ao, rq, proj, rh);
                if (d.fourNorm) {
                    // Gemma layout: post-norm on the sublayer OUTPUT.
                    Prim.rmsnormRowHost(proj, rh,
                        d.postAttentionLayernorm.weight,
                        d.postAttentionLayernorm.eps, proj, rh, h,
                        d.normForm);
                }
                HostOps.addRow(hs, rh, proj, rh, h);

                // MLP sublayer. Two-norm layout uses
                // post_attention_layernorm as the pre-MLP norm.
                RMSNorm pre = d.postAttentionLayernorm;
                if (d.fourNorm) {
                    pre = d.preFeedforwardLayernorm;
                }
                Prim.rmsnormRowHost(hs, rh, pre.weight, pre.eps,
                    xn, rh, h, d.normForm);
                Linear.beginSharedActivation();
                if (d.mlp.gateProj.isDeviceRouted()
                        && d.mlp.upProj.isDeviceRouted()
                        && d.mlp.downProj.isDeviceRouted()) {
                    // THE MLP MIDDLE NEVER LEAVES THE DEVICE (plan 10.2).
                    // gate and up are produced there, the SwiGLU runs there,
                    // and down quantizes the result there — where the host
                    // path downloads gate and up, folds them, and uploads
                    // the fold again, three crossings a layer for a value
                    // no one on this side ever looks at.
                    d.mlp.gateProj.matvecKeepOnDevice(xn, rh);
                    d.mlp.upProj.matvecKeepOnDevice(xn, rh);
                    Linear.endSharedActivation();
                    Prim.gluDevice(d.mlp.gateProj.out(), d.mlp.upProj.out(),
                        (int64) inter, d.activation);
                    d.mlp.downProj.matvecFromDevice(d.mlp.gateProj.out(),
                        (int64) inter, mlpOut, rh);
                } else {
                    d.mlp.gateProj.matvecInto(xn, rh, gate, ri);
                    d.mlp.upProj.matvecInto(xn, rh, up, ri);
                    Linear.endSharedActivation();
                    Prim.gluRowHost(gate, ri, up, ri, gate, ri, inter,
                        d.activation);
                    d.mlp.downProj.matvecInto(gate, ri, mlpOut, rh);
                }
                if (d.fourNorm) {
                    Prim.rmsnormRowHost(mlpOut, rh,
                        d.postFeedforwardLayernorm.weight,
                        d.postFeedforwardLayernorm.eps, mlpOut, rh, h,
                        d.normForm);
                }
                HostOps.addRow(hs, rh, mlpOut, rh, h);
                r = r + 1;
            }
            l = l + 1;
        }

        if (resident) {
            if (this.dkv != null) {
                // One position was appended to every layer's device
                // planes. The paged cache is NOT advanced — see
                // `seqLength`.
                this.dkv.notePosition(startPos);
            }
            // Back to the host once, for the final norm and lm_head.
            this.hsDev.download(this.hsHost);
            float32[] hb2 = hs.hostBuffer();
            int64 hb2base = hs.hostBase();
            int64 co = 0;
            while (co < (int64) h) {
                hb2[hb2base + co] = this.hsHost[co];
                co = co + 1;
            }
        }

        // Final norm of the last row, then the output projection.
        int64 lastH = (int64) (rows - 1) * (int64) h;
        Prim.rmsnormRowHost(hs, lastH, this.model.norm.weight,
            this.model.norm.eps, xn, lastH, h, this.cfg.normForm);
        if (this.lmHead != null) {
            this.lmHead.matvecInto(xn, lastH, this.pool.logits, 0);
        } else {
            // Tied output projection: logits against the embedding matrix.
            HostOps.rowsDotRow(this.model.embedTokens.weight, xn, lastH,
                this.pool.logits, this.cfg.vocabSize, h);
        }
    }

    // Device-resident decode state (plan 10.2). One hidden-wide buffer for
    // the residual stream and one for the norm output, allocated once.
    KernelBuffer<float32> hsDev;
    KernelBuffer<float32> xnDev;
    float32[] hsHost;

    // Prefill-resident hidden state (10.12.7.b): `[rows x h]` device
    // twins of hs/xn for the batched path, plus the scratch host array
    // the one-per-prefill upload/download bounces through — an arena
    // slice's `hostBase` is nonzero and `KernelBuffer.upload` starts at
    // index 0, the exact trap that broke `prefillAttend` (spec 9).
    KernelBuffer<float32> pfHsDev;
    KernelBuffer<float32> pfXnDev;
    float32[] pfHsHost;
    int64 pfHsCap;
    // 10.12.7.c: per-row positions for the batched device rope, and the
    // scratch the roped k/v come down through for the paged cache's
    // host append (the cache stays authoritative).
    KernelBuffer<int32> pfPosDev;
    int32[] pfPosHost;
    int32 pfPosCap;
    float32[] pfKScr;
    float32[] pfVScr;
    int64 pfKvCap;

    void ensurePrefillRes(int64 n) {
        if (this.pfHsCap >= n) { return; }
        this.pfHsDev #= heap KernelBuffer<float32>((uint64) n);
        this.pfXnDev #= heap KernelBuffer<float32>((uint64) n);
        this.pfHsHost #= heap float32[n];
        this.pfHsCap = n;
        return;
    }

    void ensurePrefillPos(int32 rows, int32 startPos) {
        if (this.pfPosCap < rows) {
            this.pfPosDev #= heap KernelBuffer<int32>((uint64) rows);
            this.pfPosHost #= heap int32[(int64) rows];
            this.pfPosCap = rows;
        }
        int32 i = 0;
        while (i < rows) {
            this.pfPosHost[(int64) i] = startPos + i;
            i = i + 1;
        }
        this.pfPosDev.upload(this.pfPosHost, (int64) rows);
        return;
    }

    void ensurePrefillKv(int64 n) {
        if (this.pfKvCap >= n) { return; }
        this.pfKScr #= heap float32[n];
        this.pfVScr #= heap float32[n];
        this.pfKvCap = n;
        return;
    }

    // Device attention (plan 10.11): RoPE, the KV planes and the attend.
    DeviceKv dkv;

    static boolean devAttnOn = true;
    static boolean forceReseed = false;

    // Prefill phase timers (10.12.22): the batch phases in Linear cover
    // the projections; these cover the rest of `forwardRowsBatched`, so
    // the whole prefill is accounted rather than "launch plus a
    // mystery". Host prims = the rmsnorm/GLU/add row loops.
    static int64 pfPrimNs;
    static int64 pfRopeNs;
    static int64 pfAttendNs;

    public static int64 prefillPrimNs()   { return LlamaForCausalLM.pfPrimNs; }
    public static int64 prefillRopeNs()   { return LlamaForCausalLM.pfRopeNs; }
    public static int64 prefillAttendNs() { return LlamaForCausalLM.pfAttendNs; }
    public static void resetPrefillTimers() {
        LlamaForCausalLM.pfPrimNs = 0L;
        LlamaForCausalLM.pfRopeNs = 0L;
        LlamaForCausalLM.pfAttendNs = 0L;
        return;
    }

    public static void setForceReseed(boolean on) {
        LlamaForCausalLM.forceReseed = on;
    }

    /** Arm for 10.11 — the attention tail on the device. On by default:
     *  the host tail is 3 ms of a 32 ms token at 12 positions of context
     *  but 97 ms of a 125 ms token at 512, and it is the only part of a
     *  decode token that grows with context. */
    public static void setDeviceAttention(boolean on) {
        LlamaForCausalLM.devAttnOn = on;
    }

    public static boolean deviceAttentionEnabled() {
        return LlamaForCausalLM.devAttnOn;
    }

    /**
     * The sequence's length in POSITIONS, device-held rows included.
     *
     * While the device owns rows the paged cache is deliberately behind —
     * its length and its bytes stay consistent with each other, and
     * `DeviceKv.writeback` catches it up in one pass (10.11.2). Every
     * position decision has to ask here rather than the cache, or a
     * device-resident generation would emit the same position forever.
     */
    int32 seqLength(int32 seq) {
        if (this.dkv != null && this.dkv.owns() && this.dkv.seq == seq) {
            return this.dkv.length();
        }
        return this.cache.lengthOf(seq, 0);
    }

    /** Bring the paged cache back up to date, so a host-path token — or
     *  anything that reads K/V — sees real bytes. */
    void syncKvToHost(int32 seq) {
        if (this.dkv != null && this.dkv.owns()) {
            this.dkv.writeback(this.cache, seq);
        }
        return;
    }

    /** Is every projection in the stack on a device route, and is the
     *  layout the plain Llama one the resident path implements? */
    boolean deviceResidentReady() {
        if (!Linear.residentEnabled()) { return false; }
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            if (d.fourNorm || a.qNorm != null) { return false; }
            if (!a.qProj.isDeviceRouted() || !a.kProj.isDeviceRouted()
                    || !a.vProj.isDeviceRouted()
                    || !a.oProj.isDeviceRouted()
                    || !d.mlp.gateProj.isDeviceRouted()
                    || !d.mlp.upProj.isDeviceRouted()
                    || !d.mlp.downProj.isDeviceRouted()) {
                return false;
            }
            l = l + 1;
        }
        return true;
    }

    /** Every projection in the stack has a batched GEMM kernel. */
    boolean batchReady() {
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            if (d.fourNorm || a.qNorm != null) { return false; }
            if (!a.qProj.isBatchRouted() || !a.kProj.isBatchRouted()
                    || !a.vProj.isBatchRouted()
                    || !a.oProj.isBatchRouted()
                    || !d.mlp.gateProj.isBatchRouted()
                    || !d.mlp.upProj.isBatchRouted()
                    || !d.mlp.downProj.isBatchRouted()) {
                return false;
            }
            l = l + 1;
        }
        return true;
    }

    /** Monotonic, so the batch stage can never hit on a stale window:
     *  `xn` is rewritten at the SAME address every layer, and identity
     *  plus offset cannot tell layer N's activation from layer N+1's. */
    int64 stageTag;
    boolean batchSaid;

    /**
     * The layer stack with the PROJECTIONS BATCHED over all rows.
     *
     * Same arithmetic as the per-row path and the same order within a
     * row; what changes is that the row loop moved INSIDE each
     * projection, so the weights are streamed once per 32-row tile
     * instead of once per row. Attention stays per row for now — it is
     * O(n^2) and the next unit — but it is no longer competing with 2.4
     * TB of redundant weight traffic.
     */
    void forwardRowsBatched(int32 seq, Tensor<float32> hs,
            Tensor<float32> xn, Tensor<float32> q, Tensor<float32> k,
            Tensor<float32> v, Tensor<float32> ao, Tensor<float32> proj,
            Tensor<float32> gate, Tensor<float32> up,
            Tensor<float32> mlpOut, int32 rows, int32 startPos,
            int32 h, int32 qd, int32 kvd, int32 inter,
            int32 nH, int32 nKv, int32 hd, Tensor<float32> scores) {
        // RESIDENT HIDDEN STATE (10.12.7.b): hs lives on the device for
        // the whole layer stack — norms, residual adds and the MLP chain
        // never read it on the host. It crosses the bus exactly twice: up
        // here, down after the last layer. q/k/v still come down each
        // layer because rope/append/attend keep their host seam (.c).
        boolean res = Linear.devicePackOn();
        int64 nHs = (int64) rows * (int64) h;
        if (res) {
            this.ensurePrefillRes(nHs);
            float32[] hb = hs.hostBuffer();
            int64 hb0 = hs.hostBase();
            int64 c = 0;
            while (c < nHs) {
                this.pfHsHost[c] = hb[hb0 + c];
                c = c + 1;
            }
            this.pfHsDev.upload(this.pfHsHost, nHs);
        }
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;

            // ── attention sublayer ──────────────────────────────────────
            if (res) {
                Prim.rmsnormBatchDevice(this.pfXnDev, this.pfHsDev,
                    d.inputLayernorm.deviceWeight(), (int64) rows,
                    (int64) h, d.inputLayernorm.eps, d.normForm);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatchFromDevice(this.pfXnDev, rows, h,
                    this.stageTag);
            } else {
                int64 tp0 = Clock.nanoTime();
                int32 r0 = 0;
                while (r0 < rows) {
                    Prim.rmsnormRowHost(hs, (int64) r0 * (int64) h,
                        d.inputLayernorm.weight, d.inputLayernorm.eps,
                        xn, (int64) r0 * (int64) h, h, d.normForm);
                    r0 = r0 + 1;
                }
                LlamaForCausalLM.pfPrimNs = LlamaForCausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp0);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatch(xn, 0L, rows, h, this.stageTag);
            }
            int32 r = 0;
            // 10.12.7.c: with the device attend available, q/k/v never
            // exist on the host at all — roped on the device, appended
            // to the planes there, attended there, and the o input
            // packed straight from the attend's output. The paged cache
            // stays authoritative through ONE k/v download per layer
            // into appendRowRaw, replacing per-row host rope + append.
            boolean resAttn = res && this.dkv != null;
            if (resAttn) {
                a.qProj.matmulBatchKeep(rows);
                a.kProj.matmulBatchKeep(rows);
                a.vProj.matmulBatchKeep(rows);
                int64 tr0 = Clock.nanoTime();
                this.ensurePrefillPos(rows, startPos);
                Prim.ropeBatchDevice(a.qProj.yBatch, a.deviceRopeInv(),
                    this.pfPosDev, (int64) rows, nH, hd);
                Prim.ropeBatchDevice(a.kProj.yBatch, a.deviceRopeInv(),
                    this.pfPosDev, (int64) rows, nKv, hd);
                int64 ta0 = Clock.nanoTime();
                LlamaForCausalLM.pfRopeNs = LlamaForCausalLM.pfRopeNs
                    + (ta0 - tr0);
                KernelBuffer<float32> aoDev = this.dkv
                    .prefillAttendResident(l, a.qProj.yBatch,
                        a.kProj.yBatch, a.vProj.yBatch, rows, startPos,
                        a.scale);
                int64 kvn = (int64) rows * (int64) kvd;
                this.ensurePrefillKv(kvn);
                a.kProj.yBatch.download(this.pfKScr, kvn);
                a.vProj.yBatch.download(this.pfVScr, kvn);
                r = 0;
                while (r < rows) {
                    if (!this.cache.appendRowRaw(seq, l, this.pfKScr,
                            (int64) r * (int64) kvd, this.pfVScr,
                            (int64) r * (int64) kvd, startPos + r)) {
                        throw heap LlamaException("kv pool exhausted at "
                            + "layer " + l + " position "
                            + (startPos + r));
                    }
                    r = r + 1;
                }
                LlamaForCausalLM.pfAttendNs = LlamaForCausalLM.pfAttendNs
                    + (Clock.nanoTime() - ta0);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatchFromDevice(aoDev, rows, qd,
                    this.stageTag);
            } else {
            a.qProj.matmulInto(rows, q, 0L);
            a.kProj.matmulInto(rows, k, 0L);
            a.vProj.matmulInto(rows, v, 0L);

            // RoPE and the cache append stay on the host: they are O(n)
            // and they are what keeps the paged cache authoritative for
            // everything outside this pass. The ATTEND is O(n^2) and is
            // 16.5 s of a 23.6 s prefill at 512 tokens, so it goes to the
            // device for every row at once (10.12.2).
            if (this.dkv != null) {
                // Device attend: RoPE and the append for every row first,
                // then ONE attend for all of them. Safe here only because
                // the kernel takes `startPos` and derives each row's
                // causal range from it.
                int64 tr0 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    int64 rkv = (int64) r * (int64) kvd;
                    int32 p = startPos + r;
                    Prim.ropeRowHost(q, (int64) r * (int64) qd, nH, hd, p,
                        a.ropeInv);
                    Prim.ropeRowHost(k, rkv, nKv, hd, p, a.ropeInv);
                    if (!this.cache.appendRow(seq, l, k, rkv, v, rkv, p)) {
                        throw heap LlamaException("kv pool exhausted at "
                            + "layer " + l + " position " + p);
                    }
                    r = r + 1;
                }
                int64 ta0 = Clock.nanoTime();
                LlamaForCausalLM.pfRopeNs = LlamaForCausalLM.pfRopeNs
                    + (ta0 - tr0);
                this.dkv.prefillAttend(l, q, k, v, ao, rows, startPos,
                    a.scale);
                LlamaForCausalLM.pfAttendNs = LlamaForCausalLM.pfAttendNs
                    + (Clock.nanoTime() - ta0);
            } else {
                // INTERLEAVED, and it must be. `attendRow` takes the query
                // position from `lenSL - 1`, so appending every row before
                // attending makes every row attend as the LAST one — a
                // causality break that still decodes, just wrongly. It
                // decoded 1882 1889 1882 1889 rather than 198 14196.
                r = 0;
                while (r < rows) {
                    int64 rq = (int64) r * (int64) qd;
                    int64 rkv = (int64) r * (int64) kvd;
                    int32 p = startPos + r;
                    Prim.ropeRowHost(q, rq, nH, hd, p, a.ropeInv);
                    Prim.ropeRowHost(k, rkv, nKv, hd, p, a.ropeInv);
                    if (!this.cache.appendRow(seq, l, k, rkv, v, rkv, p)) {
                        throw heap LlamaException("kv pool exhausted at "
                            + "layer " + l + " position " + p);
                    }
                    this.cache.attendRow(seq, l, q, rq, a.scale, scores,
                        ao, rq, nH, nKv, hd);
                    r = r + 1;
                }
            }

            this.stageTag = this.stageTag + 1L;
            Linear.stageBatch(ao, 0L, rows, qd, this.stageTag);
            }
            if (res) {
                // o_proj's output joins the resident hs; the second
                // norm reads it there.
                a.oProj.matmulBatchKeep(rows);
                Prim.addDevice(this.pfHsDev, a.oProj.yBatch, nHs);
                Prim.rmsnormBatchDevice(this.pfXnDev, this.pfHsDev,
                    d.postAttentionLayernorm.deviceWeight(),
                    (int64) rows, (int64) h,
                    d.postAttentionLayernorm.eps, d.normForm);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatchFromDevice(this.pfXnDev, rows, h,
                    this.stageTag);
            } else {
                a.oProj.matmulInto(rows, proj, 0L);
                int64 tp1 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    HostOps.addRow(hs, (int64) r * (int64) h, proj,
                        (int64) r * (int64) h, h);
                    r = r + 1;
                }

                // ── MLP sublayer ────────────────────────────────────────
                r = 0;
                while (r < rows) {
                    Prim.rmsnormRowHost(hs, (int64) r * (int64) h,
                        d.postAttentionLayernorm.weight,
                        d.postAttentionLayernorm.eps, xn,
                        (int64) r * (int64) h, h, d.normForm);
                    r = r + 1;
                }
                LlamaForCausalLM.pfPrimNs = LlamaForCausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp1);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatch(xn, 0L, rows, h, this.stageTag);
            }
            if (Linear.devicePackOn()) {
                // RESIDENT MLP CHAIN (10.12.7.a): gate and up never
                // leave the device — the GLU runs in place on gate's
                // yBatch and the down projection packs straight from
                // it. 10.12.22 measured gate/up as two thirds of the
                // downloaded bytes and the GLU as the largest host
                // prim; all of it disappears here. Stream-ordered
                // throughout: keep -> keep -> glu -> pack -> down all
                // launch on the current stream, and down's launch
                // syncs.
                d.mlp.gateProj.matmulBatchKeep(rows);
                d.mlp.upProj.matmulBatchKeep(rows);
                Prim.gluDevice(d.mlp.gateProj.yBatch,
                    d.mlp.upProj.yBatch,
                    (int64) rows * (int64) inter, d.activation);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatchFromDevice(d.mlp.gateProj.yBatch,
                    rows, inter, this.stageTag);
                // With hs resident (.b) the down projection joins it on
                // the device; devicePackOn == res here, so both arms of
                // the residual agree on where hs lives.
                d.mlp.downProj.matmulBatchKeep(rows);
                Prim.addDevice(this.pfHsDev, d.mlp.downProj.yBatch,
                    nHs);
            } else {
                d.mlp.gateProj.matmulInto(rows, gate, 0L);
                d.mlp.upProj.matmulInto(rows, up, 0L);
                int64 tp2 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    int64 ri = (int64) r * (int64) inter;
                    Prim.gluRowHost(gate, ri, up, ri, gate, ri, inter,
                        d.activation);
                    r = r + 1;
                }
                LlamaForCausalLM.pfPrimNs = LlamaForCausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp2);
                this.stageTag = this.stageTag + 1L;
                Linear.stageBatch(gate, 0L, rows, inter, this.stageTag);
                d.mlp.downProj.matmulInto(rows, mlpOut, 0L);
            }
            if (!res) {
                int64 tp3 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    HostOps.addRow(hs, (int64) r * (int64) h, mlpOut,
                        (int64) r * (int64) h, h);
                    r = r + 1;
                }
                LlamaForCausalLM.pfPrimNs = LlamaForCausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp3);
            }
            l = l + 1;
        }
        if (res) {
            // hs comes home ONCE — the logits path below and every
            // later host read see exactly what the device accumulated.
            KernelStream ps #= KernelStream.current();
            ps.sync();
            this.pfHsDev.download(this.pfHsHost, nHs);
            float32[] hb2 = hs.hostBuffer();
            int64 hb02 = hs.hostBase();
            int64 c2 = 0;
            while (c2 < nHs) {
                hb2[hb02 + c2] = this.pfHsHost[c2];
                c2 = c2 + 1;
            }
        }

        if (this.dkv != null && !LlamaForCausalLM.forceReseed) {
            // The planes now hold every prompt position, written by
            // `prefillAttend`, and the paged cache holds them too. Say so,
            // or the first decode token re-seeds 134 MB it already has.
            //
            // `forceReseed` is the CONTROL for that claim: it skips the
            // adopt so decode seeds from the paged cache instead. If a
            // run agrees with the host only under `reseed`, the planes
            // prefill wrote are wrong; if it disagrees either way, they
            // are fine and the difference is the softmax reassociation
            // moving a near-tied argmax.
            this.dkv.adopt(seq, startPos + rows);
        }

        int64 lastH = (int64) (rows - 1) * (int64) h;
        Prim.rmsnormRowHost(hs, lastH, this.model.norm.weight,
            this.model.norm.eps, xn, lastH, h, this.cfg.normForm);
        if (this.lmHead != null) {
            this.lmHead.matvecInto(xn, lastH, this.pool.logits, 0);
        } else {
            HostOps.rowsDotRow(this.model.embedTokens.weight, xn, lastH,
                this.pool.logits, this.cfg.vocabSize, h);
        }
        return;
    }

    /**
     * Allocate the device K/V planes on first use and make them agree
     * with the paged cache (plan 10.11.2).
     *
     * A configuration the flat planes cannot serve — a windowed layer, a
     * head wider than the combine kernel's workgroup — leaves `dkv` null,
     * and `residentLayer` then runs its host attention tail. Falling back
     * is checked rather than assumed: both of those produce a silently
     * wrong answer, not a crash.
     */
    void ensureDeviceKv(int32 seq) {
        if (!LlamaForCausalLM.devAttnOn || !DeviceKv.supports(this.cfg)) {
            this.syncKvToHost(seq);
            this.dkv = null;
            return;
        }
        if (this.dkv == null) {
            this.dkv #= heap DeviceKv(this.cfg, this.maxSeq);
            this.dkv.bindRope(this.model);
        }
        if (!this.dkv.isCurrentFor(this.cache, seq)) {
            this.dkv.seed(this.cache, seq);
        }
        return;
    }

    void ensureResidentBuffers(int32 h) {
        if (this.hsDev != null) { return; }
        this.hsHost #= heap float32[(int64) h];
        this.hsDev #= heap KernelBuffer<float32>((uint64) h);
        this.xnDev #= heap KernelBuffer<float32>((uint64) h);
        return;
    }

    /**
     * One decoder layer with the residual stream LEFT ON THE DEVICE.
     *
     * `hs` never crosses the bus inside the stack: the two norms, the
     * SwiGLU and both residual adds all run on the device, and the
     * activation is quantized there. What still crosses is attention —
     * q, k and v come back so RoPE, the KV cache and the attend can run on
     * the host, and the attention output goes up again. Four crossings a
     * layer where the host-driven path has eleven.
     */
    void residentLayer(int32 seq, int32 li, DecoderLayer d, Attention a,
            Tensor<float32> q, Tensor<float32> k, Tensor<float32> v,
            Tensor<float32> ao, Tensor<float32> scores,
            int32 h, int32 qd, int32 kvd, int32 inter,
            int32 nH, int32 nKv, int32 hd, int32 p) {
        // Attention sublayer.
        Prim.rmsnormDevice(this.xnDev, this.hsDev,
            d.inputLayernorm.deviceWeight(), (int64) h,
            d.inputLayernorm.eps, d.normForm);
        Linear.stageDeviceActivation(this.xnDev, (int64) h);
        if (this.dkv != null) {
            // THE ATTENTION TAIL NEVER LEAVES THE DEVICE (plan 10.11).
            // q, k and v stay in the projections' own output buffers;
            // RoPE rotates them there, the append writes the K/V planes
            // there, the attend reads them there, and o_proj quantizes
            // the result there. Nothing in this branch crosses the bus.
            //
            // Ordering is the stream's, not a sync's: append writes the
            // planes the attend reads and rope rewrites the q the attend
            // reads, and all of them are NoSync launches on one stream.
            a.qProj.matvecStagedKeep();
            a.kProj.matvecStagedKeep();
            a.vProj.matvecStagedKeep();
            this.dkv.rope(li, a.qProj.out(), a.kProj.out(), p);
            this.dkv.append(li, a.kProj.out(), a.vProj.out(), p);
            this.dkv.attend(li, a.qProj.out(), p, a.scale);
            Linear.stageDeviceActivation(this.dkv.out(), (int64) qd);
            a.oProj.matvecStagedKeep();
        } else {
            a.qProj.matvecStaged(q, 0L);
            a.kProj.matvecStaged(k, 0L);
            a.vProj.matvecStaged(v, 0L);
            Prim.ropeRowHost(q, 0L, nH, hd, p, a.ropeInv);
            Prim.ropeRowHost(k, 0L, nKv, hd, p, a.ropeInv);
            if (!this.cache.appendRow(seq, li, k, 0L, v, 0L, p)) {
                throw heap LlamaException("kv pool exhausted at layer "
                    + li + " position " + p);
            }
            this.cache.attendRow(seq, li, q, 0L, a.scale, scores,
                ao, 0L, nH, nKv, hd);
            a.oProj.matvecKeepOnDevice(ao, 0L);
        }
        Prim.addDevice(this.hsDev, a.oProj.out(), (int64) h);

        // MLP sublayer.
        Prim.rmsnormDevice(this.xnDev, this.hsDev,
            d.postAttentionLayernorm.deviceWeight(), (int64) h,
            d.postAttentionLayernorm.eps, d.normForm);
        Linear.stageDeviceActivation(this.xnDev, (int64) h);
        d.mlp.gateProj.matvecStagedKeep();
        d.mlp.upProj.matvecStagedKeep();
        Prim.gluDevice(d.mlp.gateProj.out(), d.mlp.upProj.out(),
            (int64) inter, d.activation);
        Linear.stageDeviceActivation(d.mlp.gateProj.out(), (int64) inter);
        d.mlp.downProj.matvecStagedKeep();
        Prim.addDevice(this.hsDev, d.mlp.downProj.out(), (int64) h);
        return;
    }

}
