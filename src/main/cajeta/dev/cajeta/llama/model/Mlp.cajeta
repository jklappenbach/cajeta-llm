package dev.cajeta.llama.model;

import cajeta.lang.String;
import dev.cajeta.llama.io.Checkpoint;

/**
 * The SwiGLU MLP projections for one decoder layer:
 * `down(silu(gate(x)) · up(x))`. Field names are the torch key segments.
 */
public final class Mlp extends InfModule {
    Linear gateProj;
    Linear upProj;
    Linear downProj;

    Mlp(int32 hidden, int32 inter) {
        this.gateProj = heap Linear(hidden, inter);
        this.upProj = heap Linear(hidden, inter);
        this.downProj = heap Linear(inter, hidden);
    }

    void bind(Checkpoint ckpt, String prefix, boolean toDevice) {
        this.gateProj.bind(ckpt, prefix + "gate_proj.weight", toDevice);
        this.upProj.bind(ckpt, prefix + "up_proj.weight", toDevice);
        this.downProj.bind(ckpt, prefix + "down_proj.weight", toDevice);
    }
}
