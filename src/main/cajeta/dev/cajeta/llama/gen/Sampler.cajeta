package dev.cajeta.llama.gen;

import cajeta.lang.Math;
import cajeta.math.Tensor;
import cajeta.xpu.Rng;

/**
 * The per-sequence sampler (plan 14.2.1/14.2.2; spec 8.1–8.6, 13.10):
 * temperature, top-k, top-p and repetition penalty over one logits row,
 * drawing from a private xorshift64 stream seeded by the request.
 *
 * ZERO heap allocations per token (13.10): both scratch arrays are sized
 * to the vocabulary at construction and reused — `p` holds the adjusted
 * logits and then the normalized probabilities INDEXED BY TOKEN ID, `idx`
 * the candidate ids in descending-probability order. `Rng` is the
 * multiply-free stdlib xorshift64 (int64 multiplication traps on
 * overflow, so a SplitMix-style mixer is not expressible in-language).
 *
 * `prepare` + `preparedProb` expose the post-filter distribution so the
 * reference tests assert the arithmetic (8.6) without depending on a
 * draw; `sample` is prepare + one draw.
 */
public final class Sampler {
    SampleParams params;
    int64 rng;
    float32[] p;      // by token id: adjusted logits, then probabilities
    int32[] idx;      // descending-probability candidate ids
    int32 vocab;
    int32 survivors;

    public Sampler(#SampleParams params, int32 vocab) {
        this.params #= params;
        this.vocab = vocab;
        this.p #= heap float32[vocab];
        this.idx #= heap int32[vocab];
        this.rng = Rng.seedState(this.params.seed);
        this.survivors = 0;
    }

    /** The request's parameters — a borrow; the sampler keeps title. */
    public SampleParams params() {
        return this.params;
    }

    /**
     * Fill the scratch from `logits` (a vocab-length row) and the
     * penalty history `hist[histOff, histOff+histLen)`, apply
     * temperature / top-k / top-p, and normalize. Returns the survivor
     * count; the survivors are `idx[0 .. count)` in descending order and
     * `preparedProb` answers by token id (0 for a filtered token).
     */
    public int32 prepare(Tensor<float32> logits, int32[] hist, int32 histOff,
            int32 histLen) {
        int32 v = this.vocab;
        int32 i = 0;
        while (i < v) {
            this.p[i] = logits.flatGet((int64) i);
            this.idx[i] = i;
            i = i + 1;
        }
        // 8.5 — repetition penalty over previously emitted tokens.
        float32 pen = this.params.repeatPenalty;
        if (pen != 1.0f) {
            i = 0;
            while (i < histLen) {
                int32 t = hist[histOff + i];
                if (t >= 0) {
                    if (t < v) {
                        float32 lg = this.p[t];
                        if (lg > 0.0f) {
                            this.p[t] = lg / pen;
                        } else {
                            this.p[t] = lg * pen;
                        }
                    }
                }
                i = i + 1;
            }
        }
        float32 temp = this.params.temperature;
        if (temp == 0.0f) {
            // 8.1 — greedy: the argmax is the single survivor.
            int32 best = 0;
            float32 bl = this.p[0];
            i = 1;
            while (i < v) {
                if (this.p[i] > bl) {
                    bl = this.p[i];
                    best = i;
                }
                i = i + 1;
            }
            i = 0;
            while (i < v) {
                this.p[i] = 0.0f;
                i = i + 1;
            }
            this.p[best] = 1.0f;
            this.idx[0] = best;
            this.survivors = 1;
            return 1;
        }
        // 8.2 — temperature scales logits before softmax.
        i = 0;
        while (i < v) {
            this.p[i] = this.p[i] / temp;
            i = i + 1;
        }
        this.sortIdxDescending();
        // 8.3 — top-k cut.
        int32 cut = v;
        int32 k = this.params.topK;
        if (k > 0) {
            if (k < cut) {
                cut = k;
            }
        }
        // Softmax over the top-k set, stably (max-subtracted). e-values
        // land in p[] at their token slots; non-candidates zero below.
        float32 mx = this.p[this.idx[0]];
        float32 total = 0.0f;
        i = 0;
        while (i < cut) {
            float32 e = Math.exp(this.p[this.idx[i]] - mx);
            this.p[this.idx[i]] = e;
            total = total + e;
            i = i + 1;
        }
        // 8.4 — top-p: the smallest prefix reaching p.
        float32 tp = this.params.topP;
        if (tp > 0.0f) {
            if (tp < 1.0f) {
                float32 cum = 0.0f;
                int32 j = 0;
                while (j < cut) {
                    cum = cum + this.p[this.idx[j]] / total;
                    if (cum >= tp) {
                        cut = j + 1;
                        break;
                    }
                    j = j + 1;
                }
            }
        }
        // Renormalize over the final survivor set; zero the rest.
        float32 total2 = 0.0f;
        i = 0;
        while (i < cut) {
            total2 = total2 + this.p[this.idx[i]];
            i = i + 1;
        }
        i = 0;
        while (i < cut) {
            this.p[this.idx[i]] = this.p[this.idx[i]] / total2;
            i = i + 1;
        }
        i = cut;
        while (i < v) {
            this.p[this.idx[i]] = 0.0f;
            i = i + 1;
        }
        this.survivors = cut;
        return cut;
    }

    /** The normalized probability of `token` after the last prepare —
     *  0 when the token was filtered out. */
    public float32 preparedProb(int32 token) {
        return this.p[token];
    }

    /** prepare + one draw from this sequence's stream (8.6). */
    public int32 sample(Tensor<float32> logits, int32[] hist, int32 histOff,
            int32 histLen) {
        int32 n = this.prepare(logits, hist, histOff, histLen);
        if (n == 1) {
            return this.idx[0];
        }
        this.rng = Rng.next(this.rng);
        float32 u = Rng.toUnitFloat(this.rng);
        float32 cum = 0.0f;
        int32 j = 0;
        while (j < n) {
            cum = cum + this.p[this.idx[j]];
            if (u < cum) {
                return this.idx[j];
            }
            j = j + 1;
        }
        return this.idx[n - 1];   // float-sum shortfall guard
    }

    // Heapsort `idx[0, vocab)` ASCENDING by p[idx[·]], then reverse —
    // descending order, in place, no allocations, deterministic ties.
    void sortIdxDescending() {
        int32 n = this.vocab;
        int32 start = n / 2 - 1;
        while (start >= 0) {
            this.siftDown(start, n);
            start = start - 1;
        }
        int32 end = n - 1;
        while (end > 0) {
            int32 tmp = this.idx[0];
            this.idx[0] = this.idx[end];
            this.idx[end] = tmp;
            this.siftDown(0, end);
            end = end - 1;
        }
        int32 a = 0;
        int32 b = n - 1;
        while (a < b) {
            int32 t2 = this.idx[a];
            this.idx[a] = this.idx[b];
            this.idx[b] = t2;
            a = a + 1;
            b = b - 1;
        }
    }

    void siftDown(int32 root, int32 end) {
        int32 r = root;
        while (r * 2 + 1 < end) {
            int32 child = r * 2 + 1;
            if (child + 1 < end) {
                if (this.p[this.idx[child + 1]] > this.p[this.idx[child]]) {
                    child = child + 1;
                }
            }
            if (this.p[this.idx[child]] > this.p[this.idx[r]]) {
                int32 tmp = this.idx[r];
                this.idx[r] = this.idx[child];
                this.idx[child] = tmp;
                r = child;
            } else {
                return;
            }
        }
    }
}
