package dev.cajeta.llama.cli;

import cajeta.lang.String;
import dev.cajeta.llama.EngineOptions;
import dev.cajeta.llama.LlamaException;
import dev.cajeta.llama.gen.SampleParams;

/**
 * `cajeta-llama run` argument parsing (spec 11.1–11.6; plan 19.2.1),
 * separated from Main so the mapping is unit-testable in-process: every
 * flag lands either on {@link EngineOptions} (engine/scheduler/store) or
 * on {@link SampleParams} (§8 sampling), never on private CLI state — the
 * CLI stays one caller of the library API (11.7).
 */
public final class CliArgs {
    public EngineOptions engine;
    public SampleParams sampling;
    public String prompt;
    public int32 maxNew;
    public boolean noKvStore;

    CliArgs() {
        this.engine = null;
        this.sampling = null;
        this.prompt = "";
        this.maxNew = 128;
        this.noKvStore = false;
    }

    static int32 needVal(String[] args, int32 i, String flag) {
        if (i + 1 >= (int32) args.count()) {
            throw heap LlamaException("cajeta-llama: " + flag
                + " needs a value");
        }
        return i + 1;
    }

    /** Parse the args AFTER the `run` verb. */
    public static #CliArgs parse(String[] args) {
        CliArgs c = heap CliArgs();
        String model = "";
        String config = "";
        String device = "";
        String kvStore = "";
        int64 kvSize = 268435456L;
        int32 ctx = 4096;
        int32 maxSeqs = 4;
        int32 blockTokens = 16;
        int32 chunk = 128;
        SampleParams p = heap SampleParams(0.0f, 0L);
        int32 i = 0;
        int32 n = (int32) args.count();
        while (i < n) {
            String a = args[i];
            if (a.equals("--model")) {
                i = CliArgs.needVal(args, i, a);
                model = "" + args[i];
            } else if (a.equals("--config")) {
                i = CliArgs.needVal(args, i, a);
                config = "" + args[i];
            } else if (a.equals("--prompt")) {
                i = CliArgs.needVal(args, i, a);
                c.prompt = "" + args[i];
            } else if (a.equals("--device")) {
                i = CliArgs.needVal(args, i, a);
                device = "" + args[i];
            } else if (a.equals("--ctx")) {
                i = CliArgs.needVal(args, i, a);
                ctx = Integer.parseInt(args[i]);
            } else if (a.equals("-n")) {
                i = CliArgs.needVal(args, i, a);
                c.maxNew = Integer.parseInt(args[i]);
            } else if (a.equals("--temp")) {
                i = CliArgs.needVal(args, i, a);
                p.temperature = (float32) Double.parseDouble(args[i]);
            } else if (a.equals("--top-k")) {
                i = CliArgs.needVal(args, i, a);
                p.topK = Integer.parseInt(args[i]);
            } else if (a.equals("--top-p")) {
                i = CliArgs.needVal(args, i, a);
                p.topP = (float32) Double.parseDouble(args[i]);
            } else if (a.equals("--seed")) {
                i = CliArgs.needVal(args, i, a);
                p.seed = Long.parseLong(args[i]);
            } else if (a.equals("--repeat-penalty")) {
                i = CliArgs.needVal(args, i, a);
                p.repeatPenalty = (float32) Double.parseDouble(args[i]);
            } else if (a.equals("--max-seqs")) {
                i = CliArgs.needVal(args, i, a);
                maxSeqs = Integer.parseInt(args[i]);
            } else if (a.equals("--block-size")) {
                i = CliArgs.needVal(args, i, a);
                blockTokens = Integer.parseInt(args[i]);
            } else if (a.equals("--chunk")) {
                i = CliArgs.needVal(args, i, a);
                chunk = Integer.parseInt(args[i]);
            } else if (a.equals("--kv-store")) {
                i = CliArgs.needVal(args, i, a);
                kvStore = "" + args[i];
            } else if (a.equals("--kv-store-size")) {
                i = CliArgs.needVal(args, i, a);
                kvSize = Long.parseLong(args[i]);
            } else if (a.equals("--no-kv-store")) {
                c.noKvStore = true;
            } else {
                throw heap LlamaException("cajeta-llama: unknown flag '"
                    + a + "'");
            }
            i = i + 1;
        }
        if (model.equals("")) {
            throw heap LlamaException("cajeta-llama: --model is required");
        }
        EngineOptions o = heap EngineOptions(model);
        o.config = config;
        o.ctx = ctx;
        o.maxSeqs = maxSeqs;
        o.blockTokens = blockTokens;
        o.chunk = chunk;
        o.device = device;
        if (!c.noKvStore) {
            o.kvStore = kvStore;
        }
        o.kvStoreSize = kvSize;
        c.engine #= o;
        c.sampling #= p;
        return #c;
    }
}
