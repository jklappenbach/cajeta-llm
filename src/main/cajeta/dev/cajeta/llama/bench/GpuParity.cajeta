package dev.cajeta.llama.bench;

import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Ewise;
import cajeta.math.Tensor;

/**
 * Kernel-level two-backend agreement (plan 15.1.4, spec 12.3): the SAME
 * f32 GEMM computed host-side and device-side, compared numerically.
 *
 * Built with `--xpu-backend=amdgpu` ONLY (no cpu backend bundled), a
 * device launch cannot silently fall back to a CPU kernel — so a run that
 * reports `onGpu: yes` and returns correct numbers is proof the GEMM
 * executed on silicon, not merely that the suite stayed green.
 */
public class GpuParity {

    static #Tensor<float32> mk(int32 m, int32 n, int32 seed) {
        int64[] shp #= heap int64[2];
        shp[0] = (int64) m;
        shp[1] = (int64) n;
        Tensor<float32> t #= Tensor.zeros<float32>(shp);
        int32 i = 0;
        while (i < m * n) {
            t.flatSet((int64) i, (float32) (((i * 37 + seed * 11) % 17) - 8) * 0.25f);
            i = i + 1;
        }
        return #t;
    }

    public static void run() {
        int32 m = 32;
        int32 k = 32;
        int32 n = 32;
        Tensor<float32> a #= GpuParity.mk(m, k, 1);
        Tensor<float32> b #= GpuParity.mk(k, n, 2);

        // Host reference: both operands stay host-resident, so matmulF32Op
        // takes its scalar fallback.
        Tensor<float32> hostOut #= Ewise.matmulF32Op(a, b);
        float32[] host #= heap float32[m * n];
        int32 i = 0;
        while (i < m * n) { host[i] = hostOut.flatGet((int64) i); i = i + 1; }

        // Device: place BOTH operands, which is what Placement.pair keys on.
        a.gpu();
        b.gpu();
        System.stdout.println("a onGpu: " + (a.isOnGpu() ? "yes" : "no")
            + ", b onGpu: " + (b.isOnGpu() ? "yes" : "no"));
        Tensor<float32> devOut #= Ewise.matmulF32Op(a, b);
        System.stdout.println("result onGpu: " + (devOut.isOnGpu() ? "yes" : "no"));
        if (devOut.isOnGpu()) {
            devOut.cpu();
        }
        float32[] dev #= heap float32[m * n];
        i = 0;
        while (i < m * n) { dev[i] = devOut.flatGet((int64) i); i = i + 1; }

        // Compare: cosine over the flattened result, plus max abs diff and an
        // exact-match count. f32 GEMM reassociation is the only expected
        // source of difference (spec 13.21's rationale for cosine over
        // elementwise error).
        float64 cos = Metrics.cosine(host, dev, m * n);
        float64 maxAbs = 0.0;
        int32 exact = 0;
        i = 0;
        while (i < m * n) {
            float64 d = (float64) host[i] - (float64) dev[i];
            if (d < 0.0) { d = 0.0 - d; }
            if (d > maxAbs) { maxAbs = d; }
            if (host[i] == dev[i]) { exact = exact + 1; }
            i = i + 1;
        }
        System.stdout.println("cosine: " + cos);
        System.stdout.println("maxAbsDiff: " + maxAbs);
        System.stdout.println("exactMatches: " + exact + " / " + (m * n));
        System.stdout.println("host[0]: " + (float64) host[0]
            + "  dev[0]: " + (float64) dev[0]);
        return;
    }
}
