package dev.cajeta.llama.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.llama.io.Quant;
import cajeta.time.Clock;

/**
 * Why the f32 parity run takes hours: HostOps.matvecRow's INNER loop walks
 * the input dim, reading w.get2(i, o) from a weight stored [in, out]
 * contiguous — so each step strides outDim*4 bytes. This times that access
 * order against the contiguous one on a realistic projection shape.
 */
public class MatvecProbe {

    // The current shape: inner loop over i, strided reads down a column.
    static float64 strided(Tensor<float32> src, Tensor<float32> w,
            Tensor<float32> dst, int32 inDim, int32 outDim) {
        int64 t0 = Clock.nanoTime();
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 acc = 0.0f;
            int64 i = 0;
            while (i < (int64) inDim) {
                acc = acc + src.flatGet(i) * w.get2(i, o);
                i = i + 1;
            }
            dst.flatSet(o, acc);
            o = o + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    // Same math, contiguous: broadcast src[i] and accumulate across o, which
    // walks w in storage order.
    static float64 contiguous(Tensor<float32> src, Tensor<float32> w,
            Tensor<float32> dst, int32 inDim, int32 outDim) {
        int64 t0 = Clock.nanoTime();
        int64 o = 0;
        while (o < (int64) outDim) { dst.flatSet(o, 0.0f); o = o + 1; }
        int64 i = 0;
        while (i < (int64) inDim) {
            float32 s = src.flatGet(i);
            int64 base = i * (int64) outDim;
            int64 oo = 0;
            while (oo < (int64) outDim) {
                dst.flatSet(oo, dst.flatGet(oo) + s * w.flatGet(base + oo));
                oo = oo + 1;
            }
            i = i + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    // Identical arithmetic over RAW arrays: no Tensor/Storage accessors, no
    // placement check, no stride reads. Isolates the per-element overhead.
    static float64 rawArrays(float32[] src, float32[] w, float32[] dst,
            int32 inDim, int32 outDim) {
        int64 t0 = Clock.nanoTime();
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 acc = 0.0f;
            int64 i = 0;
            while (i < (int64) inDim) {
                acc = acc + src[i] * w[i * (int64) outDim + o];
                i = i + 1;
            }
            dst[o] = acc;
            o = o + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    // Same Tensor API, but flatGet with a precomputed index instead of
    // get2 — drops the two bounds-checked strideDims[] reads per element.
    static float64 flatIdx(Tensor<float32> src, Tensor<float32> w,
            Tensor<float32> dst, int32 inDim, int32 outDim) {
        int64 t0 = Clock.nanoTime();
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 acc = 0.0f;
            int64 i = 0;
            while (i < (int64) inDim) {
                acc = acc + src.flatGet(i) * w.flatGet(i * (int64) outDim + o);
                i = i + 1;
            }
            dst.flatSet(o, acc);
            o = o + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    // Layout question (mmap): the checkpoint stores W as [out, in] (torch
    // convention) and Linear.bind transposes to [in, out] and COPIES. For a
    // matvec, [out, in] gives a CONTIGUOUS inner loop (walk W[o]) while
    // [in, out] strides by outDim. Both on raw arrays, so accessor cost no
    // longer masks locality.
    static float64 rawFileLayout(float32[] src, float32[] wT, float32[] dst,
            int32 inDim, int32 outDim) {
        int64 t0 = Clock.nanoTime();
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 acc = 0.0f;
            int64 base = o * (int64) inDim;
            int64 i = 0;
            while (i < (int64) inDim) {
                acc = acc + src[i] * wT[base + i];
                i = i + 1;
            }
            dst[o] = acc;
            o = o + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    // Q4_K block-direct at the same logical shape: is the packed path
    // memory-bound (where fewer bytes wins) or compute-bound in its scalar
    // unpack (where it loses)?
    static float64 q4kTimed(int8[] packed, int32 rows, int32 cols,
            float32[] x, float32[] y) {
        int64 t0 = Clock.nanoTime();
        Quant.q4kMatVec(packed, (int64) rows, (int64) cols, x, y);
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    /** Time one packed format vectorized vs its scalar floor at a real
     *  projection shape. Synthetic bytes: the DECODE cost is what is being
     *  measured and it is data-independent, so the pattern only has to be
     *  well-defined, not meaningful. */
    static void timePair(String fmt, int32 inDim, int32 outDim, float32[] x,
            int64 blockBytes, int64 blockElems) {
        int64 blocksPerRow = (int64) inDim / blockElems;
        int8[] p #= heap int8[(int64) outDim * blocksPerRow * blockBytes];
        int64 z = 0;
        while (z < (int64) p.count()) {
            p[z] = (int8) ((z * 31L) % 251L);
            z = z + 1;
        }
        float32[] y #= heap float32[outDim];
        int64 rows = (int64) outDim;
        int64 cols = (int64) inDim;
        int64 t0 = Clock.nanoTime();
        if (fmt.equals("Q6_K")) { Quant.q6kMatVecInto(p, rows, cols, x, 0L, y, 0L); }
        if (fmt.equals("Q5_K")) { Quant.q5kMatVecInto(p, rows, cols, x, 0L, y, 0L); }
        if (fmt.equals("Q8_0")) { Quant.q8MatVecInto(p, rows, cols, x, 0L, y, 0L); }
        float64 msV = (float64) (Clock.nanoTime() - t0) / 1000000.0;
        int64 t1 = Clock.nanoTime();
        if (fmt.equals("Q6_K")) { Quant.q6kMatVecIntoScalar(p, rows, cols, x, 0L, y, 0L); }
        if (fmt.equals("Q5_K")) { Quant.q5kMatVecIntoScalar(p, rows, cols, x, 0L, y, 0L); }
        if (fmt.equals("Q8_0")) { Quant.q8MatVecIntoScalar(p, rows, cols, x, 0L, y, 0L); }
        float64 msS = (float64) (Clock.nanoTime() - t1) / 1000000.0;
        System.stdout.println(fmt + " simd " + msV + " ms  scalar " + msS
            + " ms  margin " + (msS / msV) + "x");
        return;
    }

    static #Tensor<float32> mk2(int32 r, int32 c) {
        int64[] shp #= heap int64[2];
        shp[0] = (int64) r;
        shp[1] = (int64) c;
        Tensor<float32> t #= Tensor.zeros<float32>(shp);
        int64 i = 0;
        while (i < (int64) r * (int64) c) {
            t.flatSet(i, (float32) ((i % 13) - 6) * 0.125f);
            i = i + 1;
        }
        return #t;
    }

    static #Tensor<float32> mk1(int32 n) {
        int64[] shp #= heap int64[1];
        shp[0] = (int64) n;
        Tensor<float32> t #= Tensor.zeros<float32>(shp);
        int64 i = 0;
        while (i < (int64) n) {
            t.flatSet(i, (float32) ((i % 7) - 3) * 0.25f);
            i = i + 1;
        }
        return #t;
    }

    public static void run() {
        int32 inDim = 4096;
        int32 outDim = 4096;          // Llama-3.1-8B q_proj / o_proj shape
        Tensor<float32> src #= MatvecProbe.mk1(inDim);
        Tensor<float32> w #= MatvecProbe.mk2(inDim, outDim);
        Tensor<float32> d1 #= MatvecProbe.mk1(outDim);
        Tensor<float32> d2 #= MatvecProbe.mk1(outDim);

        float64 ms1 = MatvecProbe.strided(src, w, d1, inDim, outDim);
        float64 ms2 = MatvecProbe.contiguous(src, w, d2, inDim, outDim);

        // Same answer either way (float addition order differs, so compare
        // with a tolerance rather than bitwise).
        float64 maxAbs = 0.0;
        int64 o = 0;
        while (o < (int64) outDim) {
            float64 diff = (float64) d1.flatGet(o) - (float64) d2.flatGet(o);
            if (diff < 0.0) { diff = 0.0 - diff; }
            if (diff > maxAbs) { maxAbs = diff; }
            o = o + 1;
        }
        // Raw-array control, same access order as `strided`.
        float32[] rs #= heap float32[inDim];
        float32[] rw #= heap float32[inDim * outDim];
        float32[] rd #= heap float32[outDim];
        int64 z = 0;
        while (z < (int64) inDim) { rs[z] = src.flatGet(z); z = z + 1; }
        z = 0;
        while (z < (int64) inDim * (int64) outDim) {
            rw[z] = w.flatGet(z); z = z + 1;
        }
        float64 ms3 = MatvecProbe.rawArrays(rs, rw, rd, inDim, outDim);

        int64 blocksPerRow = (int64) inDim / 256L;
        int8[] q4 #= heap int8[(int64) outDim * blocksPerRow * 144L];
        int64 z2 = 0;
        while (z2 < (int64) q4.count()) {
            q4[z2] = (int8) ((z2 * 31L) % 251L);
            z2 = z2 + 1;
        }
        float32[] q4y #= heap float32[outDim];
        float64 msq = MatvecProbe.q4kTimed(q4, outDim, inDim, rs, q4y);
        System.stdout.println("Q4_K block-direct       : " + msq + " ms");

        // 15.1.16 — the other three packed formats at the SAME shape, each
        // timed vectorized and scalar so the margin is attributable rather
        // than inferred. Q6_K is the one that matters most in a Q4_K_M file:
        // output.weight and attn_v are stored as Q6_K, so it runs every token.
        MatvecProbe.timePair("Q6_K", inDim, outDim, rs, 210L, 256L);
        MatvecProbe.timePair("Q5_K", inDim, outDim, rs, 176L, 256L);
        MatvecProbe.timePair("Q8_0", inDim, outDim, rs, 34L, 32L);
        System.stdout.println("shape: " + inDim + "x" + outDim
            + "  (one projection, ONE token)");
        Tensor<float32> d4 #= MatvecProbe.mk1(outDim);
        float64 ms4 = MatvecProbe.flatIdx(src, w, d4, inDim, outDim);
        // [out, in] copy of the same matrix: wT[o*inDim + i] == rw[i*outDim + o]
        float32[] wT #= heap float32[inDim * outDim];
        int64 oo2 = 0;
        while (oo2 < (int64) outDim) {
            int64 ii2 = 0;
            while (ii2 < (int64) inDim) {
                wT[oo2 * (int64) inDim + ii2] = rw[ii2 * (int64) outDim + oo2];
                ii2 = ii2 + 1;
            }
            oo2 = oo2 + 1;
        }
        float32[] rd2 #= heap float32[outDim];
        float64 ms5 = MatvecProbe.rawFileLayout(rs, wT, rd2, inDim, outDim);

        System.stdout.println("raw [in,out] strided    : " + ms3 + " ms");
        System.stdout.println("raw [out,in] contiguous : " + ms5 + " ms"
            + "   <- file layout, no transpose");
        System.stdout.println("Tensor flatGet(idx)     : " + ms4 + " ms");
        System.stdout.println("Tensor overhead factor  : " + (ms1 / ms3) + "x");
        System.stdout.println("strided  (HostOps today): " + ms1 + " ms");
        System.stdout.println("contiguous             : " + ms2 + " ms");
        System.stdout.println("speedup: " + (ms1 / ms2) + "x");
        System.stdout.println("maxAbsDiff: " + maxAbs);
        return;
    }
}
