package dev.cajeta.llama.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.llama.io.GgufFile;
import dev.cajeta.llama.model.ModelConfig;

/**
 * cajeta-llama plan 18.3.2 — is cajeta's K-quant dequantization right?
 *
 * The `nopack` probe was read as exonerating quantization. It does not:
 * disabling packing turns off the BLOCK-DIRECT MAT-VEC, but the weights are
 * still dequantized from Q4_K / Q6_K by the same `Quant` code. A dequant fault
 * therefore breaks the packed and unpacked paths IDENTICALLY, which is exactly
 * what the real model showed.
 *
 * Reads through the RAW GgufFile reader, NOT Checkpoint, so no rope un-permute
 * is applied and the numbers line up element-for-element with gguf-py's
 * `gguf.quants.dequantize` on the same tensors.
 */
public class DequantProbe {
    static void show(GgufFile g, String name) {
        int32 idx = g.tensorIndexOf(name);
        if (idx < 0) {
            System.stdout.println(name + ": ABSENT");
            return;
        }
        Tensor<float32> t #= g.loadF32(name);
        int64 n = t.size();
        String line = name + " ty=" + g.typeOf(idx) + " n=" + n + " first8=";
        int64 i = 0;
        while (i < 8L && i < n) {
            line = line + " " + t.flatGet(i);
            i = i + 1L;
        }
        float64 sum = 0.0;
        float32 absmax = 0.0f;
        i = 0;
        while (i < n) {
            float32 v = t.flatGet(i);
            sum = sum + (float64) v;
            float32 a = v < 0.0f ? 0.0f - v : v;
            if (a > absmax) { absmax = a; }
            i = i + 1L;
        }
        System.stdout.println(line);
        System.stdout.println("    sum=" + sum + " absmax=" + absmax);
        return;
    }

    /** Every field the two config sources could disagree on. GGUF derives
     *  the config from metadata, safetensors from config.json -- a mismatch
     *  there is invisible to the toy fixture, whose two sources are written
     *  from the same generator. */
    static void dumpCfg(String tag, ModelConfig c) {
        System.stdout.println(tag + " arch=" + c.architecture
            + " hidden=" + c.hiddenSize + " inter=" + c.intermediateSize
            + " layers=" + c.numLayers + " heads=" + c.numHeads
            + " kvHeads=" + c.numKvHeads + " headDim=" + c.headDim
            + " vocab=" + c.vocabSize + " maxPos=" + c.maxPositionEmbeddings);
        System.stdout.println(tag + " eps=" + c.rmsNormEps
            + " theta=" + c.ropeTheta
            + " scalingType=" + c.ropeScalingType
            + " factor=" + c.ropeScalingFactor
            + " low=" + c.ropeLowFreq + " high=" + c.ropeHighFreq
            + " origMaxPos=" + c.ropeOrigMaxPos
            + " qScale=" + c.queryScale + " act=" + c.activation
            + " normForm=" + c.normForm
            + " ropeFreqs=" + (c.ropeFreqs == null ? "<null>"
                : "" + (int32) c.ropeFreqs.count()));
        return;
    }

    public static void run(String[] args) {
        GgufFile g #= heap GgufFile(args[0]);
        DequantProbe.show(g, "blk.0.attn_v.weight");
        DequantProbe.show(g, "blk.0.attn_q.weight");
        ModelConfig fromMeta #= ModelConfig.fromGguf(g);
        DequantProbe.dumpCfg("gguf ", fromMeta);
        if ((int32) args.count() > 1) {
            ModelConfig fromJson #= ModelConfig.parse(args[1]);
            DequantProbe.dumpCfg("json ", fromJson);
        }
        g.close();
        return;
    }
}
