package dev.cajeta.llama.bench;

import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import dev.cajeta.llama.io.Checkpoint;
import dev.cajeta.llama.io.QuantKernel;
import dev.cajeta.llama.model.Linear;
import dev.cajeta.llama.model.LlamaForCausalLM;
import dev.cajeta.llama.model.Prim;
import dev.cajeta.llama.model.ModelConfig;

/**
 * Resident-memory and decode measurement for a REAL quantized checkpoint
 * (plan 15.1.7, spec 12.11), driven by raw token ids so the tokenizer is
 * not in the way — the point is what the WEIGHTS cost and how fast they
 * multiply, not text handling.
 */
public class PackedResident {
    public static void run(String[] args) {
        String path = args[0];
        // Arm selection (plan 7.1.1): `serial` forces every packed mat-vec
        // back to its host path so the two arms can be compared in the same
        // session, on the same binary, one flag apart.
        boolean routed = true;
        if (args.count() > 1 && args[1].equals("serial")) { routed = false; }
        if (args.count() > 1 && args[1].equals("nomatvec")) {
            QuantKernel.setSkipMatvecForMeasurement(true);
        }
        // `skipN` — time a token with host primitives removed
        // (1 rmsnorm, 2 glu, 4 rope, 8 attend), projections also off.
        int32 mv = -1;
        if (args.count() > 1) {
            if (args[1].equals("skip1"))  { mv = 1; }
            if (args[1].equals("skip2"))  { mv = 2; }
            if (args[1].equals("skip4"))  { mv = 4; }
            if (args[1].equals("skip8"))  { mv = 8; }
            if (args[1].equals("skip15")) { mv = 15; }
            if (args[1].equals("skip16")) { mv = 16; }
            if (args[1].equals("skip32")) { mv = 32; }
            if (args[1].equals("skip48")) { mv = 48; }
            if (args[1].equals("skip63")) { mv = 63; }
        }
        if (mv >= 0) {
            QuantKernel.setSkipMatvecForMeasurement(true);
            Prim.setSkipMaskForMeasurement(mv);
        }
        QuantKernel.setRoutingEnabled(routed);
        // `time` as a THIRD argument, not a fourth arm: the phase timers
        // must run on the very arm being characterized, so they are a
        // modifier of `routed`, never a substitute for it.
        // `uni` in any argument slot: Unified (managed) activation buffers.
        boolean uni = false;
        // `ctxN` — prefill N tokens before the timed decode, so the attend
        // is measured at a context that resembles a real one. The default 8
        // makes the host attend almost free (count <= 12) and would let a
        // device attend look like a wash for the wrong reason.
        int32 preLen = 8;
        int64 ai = 1L;
        int64 nargs = (int64) args.count();
        while (ai < nargs) {
            if (args[ai].equals("uni")) { uni = true; }
            // `syncall` restores one sync per DISPATCH (the pre-10.3 arm).
            if (args[ai].equals("res")) {
                Linear.setDeviceResident(true);
            }
            if (args[ai].equals("nores")) {
                Linear.setDeviceResident(false);
            }
            if (args[ai].equals("noWave")) {
                Linear.setWaveMatVec(false);
            }
            if (args[ai].equals("syncall")) {
                Linear.setOneSyncPerProjection(false);
            }
            if (args[ai].equals("async")) { Linear.setAsyncTransfers(true); }
            // HOST-ATTENTION-TAIL arms (plan 10.11). Unlike `skipN`, these
            // leave the projections ON — the question is what the host
            // attention tail costs INSIDE a real token, and `skipN` answers
            // a different question because it disables the mat-vecs too.
            // Output is garbage on any of them, by construction.
            if (args[ai].equals("noRope")) {
                Prim.setSkipMaskForMeasurement(4);
            }
            if (args[ai].equals("noKv")) {
                Prim.setSkipMaskForMeasurement(48);
            }
            if (args[ai].equals("noAttn")) {
                Prim.setSkipMaskForMeasurement(52);
            }
            if (args[ai].equals("devattn")) {
                LlamaForCausalLM.setDeviceAttention(true);
            }
            if (args[ai].equals("nodevattn")) {
                LlamaForCausalLM.setDeviceAttention(false);
            }
            if (args[ai].equals("ctx128"))  { preLen = 128; }
            if (args[ai].equals("ctx512"))  { preLen = 512; }
            if (args[ai].equals("ctx1024")) { preLen = 1024; }
            if (args[ai].equals("ctx2048")) { preLen = 2048; }
            if (args[ai].equals("q8"))  { Linear.setQ8Route(true); }
            if (args[ai].equals("f32")) { Linear.setQ8Route(false); }
            if (args[ai].equals("x2")) { Linear.setTransferReps(1); }
            if (args[ai].equals("x4")) { Linear.setTransferReps(3); }
            if (args[ai].equals("notrans")) {
                Linear.setSkipTransfersForMeasurement(true);
                System.stdout.println("SKIPPING TRANSFERS - output is "
                    + "garbage by construction");
            }
            ai = ai + 1L;
        }
        Linear.setUnifiedActivations(uni);
        System.stdout.println("unified activations: " + uni);
        boolean timed = args.count() > 2 && args[2].equals("time");
        Linear.setDeviceTimingEnabled(timed);
        // Fourth argument: launch-chunk size in MiB (0/absent = one launch
        // per weight, the shipped behaviour).
        if (args.count() > 3) {
            int64 r = 0L;
            if (args[3].equals("2048"))  { r = 2048L; }
            if (args[3].equals("3072"))  { r = 3072L; }
            if (args[3].equals("4096"))  { r = 4096L; }
            if (args[3].equals("5120"))  { r = 5120L; }
            if (args[3].equals("6144"))  { r = 6144L; }
            if (args[3].equals("8192"))  { r = 8192L; }
            // ONLY when the argument actually named a chunk size. An
            // unrecognised value here used to fall through to r = 0, which
            // means chunking OFF — and an unchunked lm_head is 10 GB/s. That
            // silently confounded three separate measurements and got filed
            // once as a compiler defect (10.7) before it was understood.
            if (r > 0L) {
                Linear.setLaunchChunkRows(r);
                System.stdout.println("chunk rows: " + r);
            } else if (!args[3].equals("nochunk")) {
                System.stdout.println("note: '" + args[3] + "' is not a chunk"
                    + " size and is being ignored, not applied as 0");
            } else {
                Linear.setLaunchChunkRows(0L);
                System.stdout.println("chunk rows: 0 (chunking OFF)");
            }
        }
        System.stdout.println("arm: " + (routed ? "routed" : "serial")
            + "  prefill: " + preLen);
        int32 ctxCap = preLen + 64;
        int64 t0 = Clock.nanoTime();
        Checkpoint ck #= Checkpoint.open(path);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        cfg.blockTokens = 16;
        System.stdout.println("layers: " + cfg.numLayers
            + "  hidden: " + cfg.hiddenSize
            + "  vocab: " + cfg.vocabSize);
        LlamaForCausalLM m = heap LlamaForCausalLM(#cfg, ctxCap, 1, 0);
        m.bind(ck, false);
        ck.close();
        float64 loadMs = (float64) (Clock.nanoTime() - t0) / 1000000.0;
        System.stdout.println("load ms: " + loadMs);
        System.stdout.println("rssKb after bind: " + PackedResident.rssKb());

        int32[] toks #= heap int32[preLen];
        int32 i = 0;
        while (i < preLen) { toks[i] = 1000 + i * 7; i = i + 1; }
        int64 p0 = Clock.nanoTime();
        int32 nxt = m.prefill(toks, preLen);
        float64 preMs = (float64) (Clock.nanoTime() - p0) / 1000000.0;
        System.stdout.println("prefill(" + preLen + ") ms: " + preMs
            + "  next: " + nxt);

        int32[] one #= heap int32[1];
        one[0] = nxt;
        Linear.resetDeviceTimers();
        Prim.resetDevOpTimers();
        Linear.resetStageCounts();
        int64 d0 = Clock.nanoTime();
        int32 steps = 0;
        // The token SEQUENCE, not just a count: 7.1.1's bar is that serial
        // and routed decode the same tokens, and a timing that does not say
        // what was produced cannot show that.
        String seq #= "" + nxt;
        while (steps < 4) {
            one[0] = m.stepSeq(0, one, 0, 1);
            seq #= seq + " " + one[0];
            steps = steps + 1;
        }
        float64 decMs = (float64) (Clock.nanoTime() - d0) / 1000000.0;
        System.stdout.println("tokens: " + seq);
        System.stdout.println("decode 4 tokens ms: " + decMs
            + "  (" + (decMs / 4.0) + " ms/token)");
        if (timed) {
            float64 n = (float64) Linear.devCalls();
            System.stdout.println("dev calls: " + Linear.devCalls());
            System.stdout.println("dev copyIn ms: "
                + ((float64) Linear.devCopyInNs() / 1000000.0)
                + "  upload ms: " + ((float64) Linear.devUploadNs() / 1000000.0)
                + "  launch ms: " + ((float64) Linear.devLaunchNs() / 1000000.0)
                + "  download ms: " + ((float64) Linear.devDownloadNs() / 1000000.0)
                + "  copyOut ms: " + ((float64) Linear.devCopyOutNs() / 1000000.0));
            if (n > 0.0) {
                System.stdout.println("per call us:  copyIn "
                    + ((float64) Linear.devCopyInNs() / n / 1000.0)
                    + "  upload " + ((float64) Linear.devUploadNs() / n / 1000.0)
                    + "  launch " + ((float64) Linear.devLaunchNs() / n / 1000.0)
                    + "  download " + ((float64) Linear.devDownloadNs() / n / 1000.0)
                    + "  copyOut " + ((float64) Linear.devCopyOutNs() / n / 1000.0));
            }
            System.stdout.println("dev ops ms:  norm "
                + ((float64) Prim.devNormNs() / 1000000.0)
                + " x" + Prim.devNormCalls()
                + "   add " + ((float64) Prim.devAddNs() / 1000000.0)
                + " x" + Prim.devAddCalls()
                + "   glu " + ((float64) Prim.devGluNs() / 1000000.0)
                + " x" + Prim.devGluCalls());
            System.stdout.println("pack ms: "
                + ((float64) Linear.devPackNs() / 1000000.0)
                + "  packs: " + Linear.devPackCalls()
                + "  upload calls: " + Linear.devUploadCalls()
                + "  upload-minus-pack ms: "
                + ((float64) (Linear.devUploadNs() - Linear.devPackNs())
                    / 1000000.0));
            int32 b = 0;
            while (b < Linear.devBucketCount()) {
                float64 mb = (float64) Linear.devBucketBytes(b) / 1048576.0;
                float64 us = (float64) Linear.devBucketNs(b)
                    / (float64) Linear.devBucketCalls(b) / 1000.0;
                System.stdout.println("  shape " + mb + " MB / "
                    + Linear.devBucketRows(b) + " rows  x"
                    + Linear.devBucketCalls(b) + "  " + us + " us/launch  "
                    + (mb / us * 1000000.0 / 1024.0) + " GB/s"
                    + "   min " + ((float64) Linear.devBucketMinNs(b) / 1000.0)
                    + " us  max " + ((float64) Linear.devBucketMaxNs(b) / 1000.0)
                    + " us");
                b = b + 1;
            }
        }
        System.stdout.println("stage hits: " + Linear.stageHits()
            + "  misses: " + Linear.stageMisses());
        System.stdout.println("rssKb peak: " + PackedResident.rssKb());
        return;
    }

    /** VmRSS in KiB from /proc/self/status — streaming read, since procfs
     *  files fstat as size 0 (the SafetensorsTest helper's shape). */
    static int64 rssKb() {
        File f = File.open("/proc/self/status", OpenMode.READ);
        int8[] st #= heap int8[8192];
        int64 n = f.read(st, 0, 8192);
        f.close();
        int64 i = 0;
        while (i < n - 6L) {
            if (st[i] == 86 && st[i + 1L] == 109 && st[i + 2L] == 82
                    && st[i + 3L] == 83 && st[i + 4L] == 83
                    && st[i + 5L] == 58) {
                int64 j = i + 6L;
                int64 v = 0;
                while (j < n && st[j] != 10) {
                    if (st[j] >= 48 && st[j] <= 57) {
                        v = v * 10L + (int64) (st[j] - 48);
                    }
                    j = j + 1L;
                }
                return v;
            }
            i = i + 1L;
        }
        return 0;
    }
}
