package dev.cajeta.llama.bench;

import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Barrier;
import cajeta.xpu.BlockPadded;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import dev.cajeta.llama.io.GgufFile;
import dev.cajeta.llama.io.Quant;
import dev.cajeta.llama.io.QuantKernel;

/**
 * Mechanism spike for the mmq-shaped tiled batch GEMM (the llama.cpp
 * `mul_mmq` port). The tile kernel needs five things the Vulkan backend
 * has never run together in this engine: byte-element LDS tiles
 * (Shared<uint8> / Shared<int8>), vload/vstore ON the shared tile, a
 * workgroup barrier between stage and compute, cross-lane reads of
 * staged data, and dotAccum over vectors loaded from shared. Ownership
 * rules here are measured-not-reasoned; so is backend support — this
 * probe proves the mechanism BEFORE the 300-line kernel is written on
 * top of it, so a lowering gap surfaces as one wrong lane in a 64-line
 * table instead of garbage logits.
 *
 * Stage 1: each of 64 lanes stages its own 32-byte row of w (unsigned)
 * and x (signed) into LDS with vstore, barriers, then computes the
 * integer dot of its NEIGHBOR's rows ((lane+1)%64) via vload from LDS +
 * dotAccum. Wrong values name the broken verb; a hang names the barrier.
 */
public final class MmqProbe {

    @Kernel
    public static void ldsDotKernel(KernelBuffer<int32> out,
            KernelBuffer<int8> w, KernelBuffer<int8> x) {
        Shared<uint8> sw = shared uint8[64 * 32];
        Shared<int8> sx = shared int8[64 * 32];
        uint32 lane = KernelThread.x();
        int64 ro = (int64) lane * 32L;
        sw.vstore(ro, w.vload<32>(ro).asUnsigned());
        sx.vstore(ro, x.vload<32>(ro));
        Barrier.workgroup();
        uint32 peer = (lane + 1) % 64;
        int64 po = (int64) peer * 32L;
        Vector<uint8,32> wv = sw.vload<32>(po);
        Vector<int8,32> xv = sx.vload<32>(po);
        Vector<int32,8> zv = out.vload<8>(0) * 0;
        Vector<int32,8> t = wv.dotAccum(xv, zv);
        out[(int64) lane] = t[0] + t[1] + t[2] + t[3]
            + t[4] + t[5] + t[6] + t[7];
    }

    static int64 checkLdsDot() {
        int32 n = 64 * 32;
        int8[] w #= heap int8[n];
        int8[] x #= heap int8[n];
        int32 i = 0;
        while (i < n) {
            w[i] = (int8) ((i * 7 + 3) % 15);        // 0..14, reads as uint8
            x[i] = (int8) ((i * 11 + 5) % 17 - 8);   // -8..8
            i = i + 1;
        }
        int32[] outH #= heap int32[64];
        KernelBuffer<int8> wD = heap KernelBuffer<int8>((uint64) n);
        KernelBuffer<int8> xD = heap KernelBuffer<int8>((uint64) n);
        KernelBuffer<int32> oD = heap KernelBuffer<int32>((uint64) 64);
        wD.upload(w);
        xD.upload(x);
        KernelStream s = QuantKernel.stream();
        ldsDotKernel.launch(s, grid: [1], block: [64])(oD, wD, xD);
        s.sync();
        oD.download(outH);
        int64 bad = 0;
        int32 lane = 0;
        while (lane < 64) {
            int32 peer = (lane + 1) % 64;
            int32 want = 0;
            int32 k = 0;
            while (k < 32) {
                want = want + (int32) w[peer * 32 + k] * (int32) x[peer * 32 + k];
                k = k + 1;
            }
            if (outH[lane] != want) {
                if (bad < 5L) {
                    System.stdout.println("  ldsDot[" + lane + "]: got "
                        + outH[lane] + " want " + want);
                }
                bad = bad + 1;
            }
            lane = lane + 1;
        }
        return bad;
    }

    @Kernel
    public static void mmqClockKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<int32> xp,
            uint32 rows, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow, KernelBuffer<int64> cyc) {
        // Dword-typed tiles: SPIR-V types an LDS tile by ELEMENT and Mesa
        // does not merge Workgroup byte accesses (384 scalar ds_read_u8 in
        // the byte-tiled form of this loop) — int32 tiles keep every LDS
        // access dword-shaped, with asWords()/asBytes() at the seams.
        // Block-padded: a wave's lanes step whole 64-dword rows, and an
        // unpadded stride puts every lane on the same LDS bank (32-way
        // replay on each tile read). Pad=1 dword per row -> 2-way worst.
        BlockPadded<int32,64,1> swq = shared int32[64 * 65];
        BlockPadded<int32,64,1> sxq = shared int32[32 * 65];
        BlockPadded<int32,8,1> ssc = shared int32[64 * 9];
        BlockPadded<int32,8,1> smn = shared int32[64 * 9];
        Shared<int32> sbs = shared int32[32 * 8];
        Shared<float32> sd = shared float32[64];
        Shared<float32> sdm = shared float32[64];
        Shared<float32> sxd = shared float32[32];
        uint32 tid = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 rowTile = wg % nRowTiles;
        uint32 tokTile = wg / nRowTiles;
        int64 rowWords = blocksPerRow * 36L;
        int64 xRowWords = blocksPerRow * 80L;

        // Staging roles (fixed per thread, applied each super-block):
        uint32 wRow = tid / 4;            // 64 rows, 4 threads each
        uint32 wG = tid % 4;              //   this thread's 32-byte quarter
        uint32 aTok = tid / 8;            // 32 tokens, 8 threads each
        uint32 aE = tid % 8;              //   this thread's 32-byte eighth
        uint32 gRow = rowTile * 64 + wRow;
        uint32 gTok = tokTile * 32 + aTok;
        // A dead row/token still stages (from row/token 0) so every
        // thread reaches both barriers; its results are never stored.
        int64 wBase = 0L;
        int64 aBase = 0L;
        if (gRow < outDim) { wBase = (int64) gRow * rowWords; }
        if (gTok < rows) { aBase = (int64) gTok * xRowWords; }

        // Compute roles: 2 consecutive rows x 4 consecutive tokens.
        uint32 lr0 = (tid % 32) * 2;
        uint32 lt0 = (tid / 32) * 4;
        int64 r0 = (int64) lr0 * 64L;
        int64 r1 = r0 + 64L;
        int64 a0o = (int64) lt0 * 64L;

        float32 acc00 = 0.0f;
        float32 acc01 = 0.0f;
        float32 acc02 = 0.0f;
        float32 acc03 = 0.0f;
        float32 acc10 = 0.0f;
        float32 acc11 = 0.0f;
        float32 acc12 = 0.0f;
        float32 acc13 = 0.0f;
        int64 tStage = 0L;
        int64 tComp = 0L;
        int64 tBar2 = 0L;
        int64 b = 0;
        while (b < blocksPerRow) {
            int64 c0 = (int64) KernelThread.clock();
            // ── stage weights: nibbles + header, once per tile ──────
            // All dword-domain: byte-typed loads scalarize per byte under
            // SPIR-V logical addressing and repack with shifts; the same
            // nibble split is `w & 0x0F0F0F0F` on packed words.
            int64 ro = wBase + b * 36L;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L + (int64) (8 * wG));
            int64 wq = (int64) wRow * 64L + (int64) (16 * wG);
            swq.vstore(wq, qw & 252645135);
            swq.vstore(wq + 8L, (qw >> 4) & 252645135);
            if (wG == 0) {
                Vector<int32,4> hw = packed.vload<4>(ro);
                int32 h0 = hw[0];
                sd[(int64) wRow] = GgufFile.halfBitsToF32(h0 & 65535);
                sdm[(int64) wRow] = GgufFile.halfBitsToF32(
                    (h0 >> 16) & 65535);
                int32 hA = hw[1];
                int32 hB = hw[2];
                int32 hC = hw[3];
                int32 d0 = hA & 255;
                int32 d1 = (hA >> 8) & 255;
                int32 d2 = (hA >> 16) & 255;
                int32 d3 = (hA >> 24) & 255;
                int32 m0 = hB & 255;
                int32 m1 = (hB >> 8) & 255;
                int32 m2 = (hB >> 16) & 255;
                int32 m3 = (hB >> 24) & 255;
                int32 k0 = hC & 255;
                int32 k1 = (hC >> 8) & 255;
                int32 k2 = (hC >> 16) & 255;
                int32 k3 = (hC >> 24) & 255;
                int64 sb = (int64) wRow * 8L;
                ssc[sb] = d0 & 63;
                ssc[sb + 1L] = d1 & 63;
                ssc[sb + 2L] = d2 & 63;
                ssc[sb + 3L] = d3 & 63;
                ssc[sb + 4L] = (k0 & 15) | ((d0 >> 2) & 48);
                ssc[sb + 5L] = (k1 & 15) | ((d1 >> 2) & 48);
                ssc[sb + 6L] = (k2 & 15) | ((d2 >> 2) & 48);
                ssc[sb + 7L] = (k3 & 15) | ((d3 >> 2) & 48);
                smn[sb] = m0 & 63;
                smn[sb + 1L] = m1 & 63;
                smn[sb + 2L] = m2 & 63;
                smn[sb + 3L] = m3 & 63;
                smn[sb + 4L] = (k0 >> 4) | ((m0 >> 2) & 48);
                smn[sb + 5L] = (k1 >> 4) | ((m1 >> 2) & 48);
                smn[sb + 6L] = (k2 >> 4) | ((m2 >> 2) & 48);
                smn[sb + 7L] = (k3 >> 4) | ((m3 >> 2) & 48);
            }
            // ── stage activations, once per tile ────────────────────
            int64 xb = aBase + b * 80L;
            int64 aq = (int64) aTok * 64L + (int64) (8 * aE);
            sxq.vstore(aq, xp.vload<8>(xb + (int64) (8 * aE)));
            if (aE == 0) {
                sbs.vstore((int64) aTok * 8L, xp.vload<8>(xb + 64L));
                sxd[(int64) aTok] = Cajeta.bitsToF32(xp[xb + 72L]);
            }
            Barrier.workgroup();
            int64 c1 = (int64) KernelThread.clock();

            // ── register-tiled inner product, all reads from LDS ────
            // Scalar accumulators via dotSum's chained dp4a: the previous
            // <8 x i32> accumulator per (row, token) pair cost 64 VGPRs and
            // pinned the kernel at 256 VGPRs = 1 wave/SIMD (no spills — no
            // latency hiding either, and the phases that measure 1.8 ms
            // apart ran at 7.5 ms together).
            int32 si00 = 0;
            int32 si01 = 0;
            int32 si02 = 0;
            int32 si03 = 0;
            int32 si10 = 0;
            int32 si11 = 0;
            int32 si12 = 0;
            int32 si13 = 0;
            int64 s0 = (int64) lr0 * 8L;
            int32 g = 0;
            while (g < 8) {
                int64 go = (int64) (8 * g);
                Vector<uint8,32> w0 = swq.vload<8>(r0 + go).asBytes().asUnsigned();
                Vector<uint8,32> w1 = swq.vload<8>(r1 + go).asBytes().asUnsigned();
                Vector<int8,32> av0 = sxq.vload<8>(a0o + go).asBytes();
                Vector<int8,32> av1 = sxq.vload<8>(a0o + 64L + go).asBytes();
                Vector<int8,32> av2 = sxq.vload<8>(a0o + 128L + go).asBytes();
                Vector<int8,32> av3 = sxq.vload<8>(a0o + 192L + go).asBytes();
                int32 sc0 = ssc[s0 + (int64) g];
                int32 sc1 = ssc[s0 + 8L + (int64) g];
                si00 = si00 + w0.dotSum(av0, 0) * sc0;
                si01 = si01 + w0.dotSum(av1, 0) * sc0;
                si02 = si02 + w0.dotSum(av2, 0) * sc0;
                si03 = si03 + w0.dotSum(av3, 0) * sc0;
                si10 = si10 + w1.dotSum(av0, 0) * sc1;
                si11 = si11 + w1.dotSum(av1, 0) * sc1;
                si12 = si12 + w1.dotSum(av2, 0) * sc1;
                si13 = si13 + w1.dotSum(av3, 0) * sc1;
                g = g + 1;
            }
            // Fold the block term: sumi and the min/bsum correction.
            Vector<int32,8> mn0 = smn.vload<8>(s0);
            Vector<int32,8> mn1 = smn.vload<8>(s0 + 8L);
            float32 d0f = sd[(int64) lr0];
            float32 dm0 = sdm[(int64) lr0];
            float32 d1f = sd[(int64) lr0 + 1L];
            float32 dm1 = sdm[(int64) lr0 + 1L];
            int32 tt = 0;
            while (tt < 4) {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + tt) * 8L);
                float32 xs = sxd[(int64) (lt0 + tt)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                int32 sv0 = si00;
                int32 sv1 = si10;
                if (tt == 1) { sv0 = si01; sv1 = si11; }
                if (tt == 2) { sv0 = si02; sv1 = si12; }
                if (tt == 3) { sv0 = si03; sv1 = si13; }
                float32 v0 = d0f * xs * (float32) sv0
                    - dm0 * xs * (float32) dms0;
                float32 v1 = d1f * xs * (float32) sv1
                    - dm1 * xs * (float32) dms1;
                if (tt == 0) { acc00 = acc00 + v0; acc10 = acc10 + v1; }
                if (tt == 1) { acc01 = acc01 + v0; acc11 = acc11 + v1; }
                if (tt == 2) { acc02 = acc02 + v0; acc12 = acc12 + v1; }
                if (tt == 3) { acc03 = acc03 + v0; acc13 = acc13 + v1; }
                tt = tt + 1;
            }
            int64 c2 = (int64) KernelThread.clock();
            Barrier.workgroup();
            int64 c3 = (int64) KernelThread.clock();
            tStage = tStage + (c1 - c0);
            tComp = tComp + (c2 - c1);
            tBar2 = tBar2 + (c3 - c2);
            b = b + 1;
        }
        cyc.atomicAdd(0L, tStage);
        cyc.atomicAdd(1L, tComp);
        cyc.atomicAdd(2L, tBar2);

        // Guarded stores: y is token-major, y[token*outDim + row].
        uint32 oR0 = rowTile * 64 + lr0;
        uint32 oR1 = oR0 + 1;
        uint32 oT = tokTile * 32 + lt0;
        int64 od = (int64) outDim;
        if (oR0 < outDim) {
            if (oT < rows) { y[(int64) oT * od + (int64) oR0] = acc00; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR0] = acc01; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR0] = acc02; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR0] = acc03; }
        }
        if (oR1 < outDim) {
            if (oT < rows) { y[(int64) oT * od + (int64) oR1] = acc10; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR1] = acc11; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR1] = acc12; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR1] = acc13; }
        }
    }

    @Kernel
    public static void mmqLdsHackKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<int32> xp,
            uint32 rows, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // Dword-typed tiles: SPIR-V types an LDS tile by ELEMENT and Mesa
        // does not merge Workgroup byte accesses (384 scalar ds_read_u8 in
        // the byte-tiled form of this loop) — int32 tiles keep every LDS
        // access dword-shaped, with asWords()/asBytes() at the seams.
        // Block-padded: a wave's lanes step whole 64-dword rows, and an
        // unpadded stride puts every lane on the same LDS bank (32-way
        // replay on each tile read). Pad=1 dword per row -> 2-way worst.
        BlockPadded<int32,64,1> swq = shared int32[64 * 65];
        BlockPadded<int32,64,1> sxq = shared int32[32 * 65];
        BlockPadded<int32,8,1> ssc = shared int32[64 * 9];
        BlockPadded<int32,8,1> smn = shared int32[64 * 9];
        Shared<int32> sbs = shared int32[32 * 8];
        Shared<float32> sd = shared float32[64];
        Shared<float32> sdm = shared float32[64];
        Shared<float32> sxd = shared float32[32];
        uint32 tid = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 rowTile = wg % nRowTiles;
        uint32 tokTile = wg / nRowTiles;
        int64 rowWords = blocksPerRow * 36L;
        int64 xRowWords = blocksPerRow * 80L;

        // Staging roles (fixed per thread, applied each super-block):
        uint32 wRow = tid / 4;            // 64 rows, 4 threads each
        uint32 wG = tid % 4;              //   this thread's 32-byte quarter
        uint32 aTok = tid / 8;            // 32 tokens, 8 threads each
        uint32 aE = tid % 8;              //   this thread's 32-byte eighth
        uint32 gRow = rowTile * 64 + wRow;
        uint32 gTok = tokTile * 32 + aTok;
        // A dead row/token still stages (from row/token 0) so every
        // thread reaches both barriers; its results are never stored.
        int64 wBase = 0L;
        int64 aBase = 0L;
        if (gRow < outDim) { wBase = (int64) gRow * rowWords; }
        if (gTok < rows) { aBase = (int64) gTok * xRowWords; }

        // Compute roles: 2 consecutive rows x 4 consecutive tokens.
        uint32 lr0 = (tid % 32) * 2;
        uint32 lt0 = (tid / 32) * 4;
        int64 r0 = (int64) lr0 * 64L;
        int64 r1 = r0 + 64L;
        int64 a0o = (int64) lt0 * 64L;

        float32 acc00 = 0.0f;
        float32 acc01 = 0.0f;
        float32 acc02 = 0.0f;
        float32 acc03 = 0.0f;
        float32 acc10 = 0.0f;
        float32 acc11 = 0.0f;
        float32 acc12 = 0.0f;
        float32 acc13 = 0.0f;
        int64 b = 0;
        while (b < blocksPerRow) {
            // ── stage weights: nibbles + header, once per tile ──────
            // All dword-domain: byte-typed loads scalarize per byte under
            // SPIR-V logical addressing and repack with shifts; the same
            // nibble split is `w & 0x0F0F0F0F` on packed words.
            int64 ro = wBase + b * 36L;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L + (int64) (8 * wG));
            int64 wq = (int64) wRow * 64L + (int64) (16 * wG);
            swq.vstore(wq, qw & 252645135);
            swq.vstore(wq + 8L, (qw >> 4) & 252645135);
            if (wG == 0) {
                Vector<int32,4> hw = packed.vload<4>(ro);
                int32 h0 = hw[0];
                sd[(int64) wRow] = GgufFile.halfBitsToF32(h0 & 65535);
                sdm[(int64) wRow] = GgufFile.halfBitsToF32(
                    (h0 >> 16) & 65535);
                int32 hA = hw[1];
                int32 hB = hw[2];
                int32 hC = hw[3];
                int32 d0 = hA & 255;
                int32 d1 = (hA >> 8) & 255;
                int32 d2 = (hA >> 16) & 255;
                int32 d3 = (hA >> 24) & 255;
                int32 m0 = hB & 255;
                int32 m1 = (hB >> 8) & 255;
                int32 m2 = (hB >> 16) & 255;
                int32 m3 = (hB >> 24) & 255;
                int32 k0 = hC & 255;
                int32 k1 = (hC >> 8) & 255;
                int32 k2 = (hC >> 16) & 255;
                int32 k3 = (hC >> 24) & 255;
                int64 sb = (int64) wRow * 8L;
                ssc[sb] = d0 & 63;
                ssc[sb + 1L] = d1 & 63;
                ssc[sb + 2L] = d2 & 63;
                ssc[sb + 3L] = d3 & 63;
                ssc[sb + 4L] = (k0 & 15) | ((d0 >> 2) & 48);
                ssc[sb + 5L] = (k1 & 15) | ((d1 >> 2) & 48);
                ssc[sb + 6L] = (k2 & 15) | ((d2 >> 2) & 48);
                ssc[sb + 7L] = (k3 & 15) | ((d3 >> 2) & 48);
                smn[sb] = m0 & 63;
                smn[sb + 1L] = m1 & 63;
                smn[sb + 2L] = m2 & 63;
                smn[sb + 3L] = m3 & 63;
                smn[sb + 4L] = (k0 >> 4) | ((m0 >> 2) & 48);
                smn[sb + 5L] = (k1 >> 4) | ((m1 >> 2) & 48);
                smn[sb + 6L] = (k2 >> 4) | ((m2 >> 2) & 48);
                smn[sb + 7L] = (k3 >> 4) | ((m3 >> 2) & 48);
            }
            // ── stage activations, once per tile ────────────────────
            int64 xb = aBase + b * 80L;
            int64 aq = (int64) aTok * 64L + (int64) (8 * aE);
            sxq.vstore(aq, xp.vload<8>(xb + (int64) (8 * aE)));
            if (aE == 0) {
                sbs.vstore((int64) aTok * 8L, xp.vload<8>(xb + 64L));
                sxd[(int64) aTok] = Cajeta.bitsToF32(xp[xb + 72L]);
            }
            Barrier.workgroup();

            // ── register-tiled inner product, all reads from LDS ────
            // Scalar accumulators via dotSum's chained dp4a: the previous
            // <8 x i32> accumulator per (row, token) pair cost 64 VGPRs and
            // pinned the kernel at 256 VGPRs = 1 wave/SIMD (no spills — no
            // latency hiding either, and the phases that measure 1.8 ms
            // apart ran at 7.5 ms together).
            int32 si00 = 0;
            int32 si01 = 0;
            int32 si02 = 0;
            int32 si03 = 0;
            int32 si10 = 0;
            int32 si11 = 0;
            int32 si12 = 0;
            int32 si13 = 0;
            int64 s0 = (int64) lr0 * 8L;
            int32 g = 0;
            while (g < 8) {
                int64 go = (int64) (8 * g);
                Vector<uint8,32> w0 = swq.vload<8>(r0 + go).asBytes().asUnsigned();
                Vector<uint8,32> w1 = swq.vload<8>(r1 + go).asBytes().asUnsigned();
                Vector<int8,32> av0 = sxq.vload<8>(a0o + go).asBytes();
                Vector<int8,32> av1 = av0;
                Vector<int8,32> av2 = av0;
                Vector<int8,32> av3 = av0;
                int32 sc0 = ssc[s0 + (int64) g];
                int32 sc1 = ssc[s0 + 8L + (int64) g];
                si00 = si00 + w0.dotSum(av0, 0) * sc0;
                si01 = si01 + w0.dotSum(av1, 0) * sc0;
                si02 = si02 + w0.dotSum(av2, 0) * sc0;
                si03 = si03 + w0.dotSum(av3, 0) * sc0;
                si10 = si10 + w1.dotSum(av0, 0) * sc1;
                si11 = si11 + w1.dotSum(av1, 0) * sc1;
                si12 = si12 + w1.dotSum(av2, 0) * sc1;
                si13 = si13 + w1.dotSum(av3, 0) * sc1;
                g = g + 1;
            }
            // Fold the block term: sumi and the min/bsum correction.
            Vector<int32,8> mn0 = smn.vload<8>(s0);
            Vector<int32,8> mn1 = smn.vload<8>(s0 + 8L);
            float32 d0f = sd[(int64) lr0];
            float32 dm0 = sdm[(int64) lr0];
            float32 d1f = sd[(int64) lr0 + 1L];
            float32 dm1 = sdm[(int64) lr0 + 1L];
            int32 tt = 0;
            while (tt < 4) {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + tt) * 8L);
                float32 xs = sxd[(int64) (lt0 + tt)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                int32 sv0 = si00;
                int32 sv1 = si10;
                if (tt == 1) { sv0 = si01; sv1 = si11; }
                if (tt == 2) { sv0 = si02; sv1 = si12; }
                if (tt == 3) { sv0 = si03; sv1 = si13; }
                float32 v0 = d0f * xs * (float32) sv0
                    - dm0 * xs * (float32) dms0;
                float32 v1 = d1f * xs * (float32) sv1
                    - dm1 * xs * (float32) dms1;
                if (tt == 0) { acc00 = acc00 + v0; acc10 = acc10 + v1; }
                if (tt == 1) { acc01 = acc01 + v0; acc11 = acc11 + v1; }
                if (tt == 2) { acc02 = acc02 + v0; acc12 = acc12 + v1; }
                if (tt == 3) { acc03 = acc03 + v0; acc13 = acc13 + v1; }
                tt = tt + 1;
            }
            Barrier.workgroup();
            b = b + 1;
        }

        // Guarded stores: y is token-major, y[token*outDim + row].
        uint32 oR0 = rowTile * 64 + lr0;
        uint32 oR1 = oR0 + 1;
        uint32 oT = tokTile * 32 + lt0;
        int64 od = (int64) outDim;
        if (oR0 < outDim) {
            if (oT < rows) { y[(int64) oT * od + (int64) oR0] = acc00; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR0] = acc01; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR0] = acc02; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR0] = acc03; }
        }
        if (oR1 < outDim) {
            if (oT < rows) { y[(int64) oT * od + (int64) oR1] = acc10; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR1] = acc11; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR1] = acc12; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR1] = acc13; }
        }
    }

    /**
     * Stage 2 — the tiled kernel against the token-proven Batch kernel
     * at a real prefill shape. Both fold identical per-block float
     * terms in the same block order, so agreement should be essentially
     * exact; a loose match would itself be a finding. Then wall-clock
     * for each over `iters` launches.
     */
    static int64 checkMmq(int64 rows, int64 outDim, int64 cols) {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q4_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<int8> xpD #= heap KernelBuffer<int8>(
            (uint64) (rows * Quant.q8kPackedBytes(cols)));
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wD.upload(raw);
        xfD.upload(x);
        QuantKernel.q8kPackLaunch(xpD, xfD, rows * cols);
        KernelStream s = QuantKernel.stream();

        KernelBuffer<int32> wW #= wD.wordView();
        KernelBuffer<int32> xpW #= xpD.wordView();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
            outDim, cols);
        s.sync();
        QuantKernel.q4kQ8MmqLaunchNoSync(yB, wW, xpW, rows, outDim, cols);
        s.sync();

        float32[] a #= heap float32[rows * outDim];
        float32[] g #= heap float32[rows * outDim];
        yA.download(a);
        yB.download(g);
        int64 bad = 0;
        i = 0;
        while (i < rows * outDim) {
            float32 diff = a[i] - g[i];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            if (diff > mag * 0.001f + 0.001f) {
                if (bad < 5L) {
                    System.stdout.println("  mmq[" + (i / outDim) + ","
                        + (i % outDim) + "]: got " + g[i] + " want " + a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }

        int32 iters = 5;
        int64 t0 = Clock.nanoTime();
        int32 it = 0;
        while (it < iters) {
            QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
                outDim, cols);
            it = it + 1;
        }
        s.sync();
        float64 msA = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            QuantKernel.q4kQ8MmqLaunchNoSync(yB, wW, xpW, rows, outDim,
                cols);
            it = it + 1;
        }
        s.sync();
        float64 msB = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        int64 nRowTiles = (outDim + 63L) / 64L;
        int64 nTokTiles = (rows + 31L) / 32L;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            mmqLdsHackKernel.launch(s,
                grid: [(uint32) (nRowTiles * nTokTiles)], block: [256])
                (yB, wW, xpW, (uint32) rows, (uint32) outDim,
                 (uint32) nRowTiles, cols / 256L);
            it = it + 1;
        }
        s.sync();
        float64 msH = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        System.stdout.println("  ldsHack(3/6 loads dropped): " + msH + " ms");
        KernelBuffer<int64> cyc #= heap KernelBuffer<int64>((uint64) 4);
        int64[] cycH #= heap int64[4];
        cycH[0] = 0L; cycH[1] = 0L; cycH[2] = 0L; cycH[3] = 0L;
        cyc.upload(cycH);
        mmqClockKernel.launch(s,
            grid: [(uint32) (nRowTiles * nTokTiles)], block: [256])
            (yB, wW, xpW, (uint32) rows, (uint32) outDim,
             (uint32) nRowTiles, cols / 256L, cyc);
        s.sync();
        cyc.download(cycH);
        float64 tmacs = (float64) (rows * outDim * cols) / 1.0e12;
        System.stdout.println("  batch " + msA + " ms ("
            + (tmacs / (msA / 1000.0)) + " TMAC/s)   mmq " + msB
            + " ms (" + (tmacs / (msB / 1000.0)) + " TMAC/s)");
        int64 tot = cycH[0] + cycH[1] + cycH[2];
        System.stdout.println("  in-kernel cycles%: stage+bar1 "
            + (cycH[0] * 100L / tot) + "  compute " + (cycH[1] * 100L / tot)
            + "  bar2 " + (cycH[2] * 100L / tot));
        return bad;
    }

    /**
     * Stage 3 — the Q6 twin against the token-proven Q6 batch kernel,
     * through the padded copy. Same near-exact expectation as stage 2.
     */
    static int64 checkMmq6(int64 rows, int64 outDim, int64 cols) {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q6_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q6_K);
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<int8> xpD #= heap KernelBuffer<int8>(
            (uint64) (rows * Quant.q8kPackedBytes(cols)));
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wD.upload(raw);
        xfD.upload(x);
        QuantKernel.q8kPackLaunch(xpD, xfD, rows * cols);
        KernelStream s = QuantKernel.stream();

        KernelBuffer<int8> padD #= heap KernelBuffer<int8>(
            (uint64) (blocks * 212L));
        QuantKernel.q6kPadLaunch(padD, wD, blocks);
        KernelBuffer<int32> padW #= padD.wordView();
        KernelBuffer<int32> xpW #= xpD.wordView();

        QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
            outDim, cols);
        s.sync();
        QuantKernel.q6kQ8MmqLaunchNoSync(yB, padW, xpW, rows, outDim,
            cols);
        s.sync();

        float32[] a #= heap float32[rows * outDim];
        float32[] g #= heap float32[rows * outDim];
        yA.download(a);
        yB.download(g);
        int64 bad = 0;
        i = 0;
        while (i < rows * outDim) {
            float32 diff = a[i] - g[i];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            if (diff > mag * 0.001f + 0.001f) {
                if (bad < 5L) {
                    System.stdout.println("  mmq6[" + (i / outDim) + ","
                        + (i % outDim) + "]: got " + g[i] + " want " + a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }

        int32 iters = 5;
        int64 t0 = Clock.nanoTime();
        int32 it = 0;
        while (it < iters) {
            QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
                outDim, cols);
            it = it + 1;
        }
        s.sync();
        float64 msA = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            QuantKernel.q6kQ8MmqLaunchNoSync(yB, padW, xpW, rows, outDim,
                cols);
            it = it + 1;
        }
        s.sync();
        float64 msB = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        float64 tmacs = (float64) (rows * outDim * cols) / 1.0e12;
        System.stdout.println("  q6batch " + msA + " ms ("
            + (tmacs / (msA / 1000.0)) + " TMAC/s)   q6mmq " + msB
            + " ms (" + (tmacs / (msB / 1000.0)) + " TMAC/s)");
        return bad;
    }

    public static int32 run() {
        System.stdout.println("backend: " + Device.activeBackend());
        int64 b1 = MmqProbe.checkLdsDot();
        System.stdout.println("stage1 lds vload/vstore/barrier/dotAccum: "
            + b1 + "/64 wrong");
        int64 b2 = MmqProbe.checkMmq(512L, 4096L, 4096L);
        System.stdout.println("stage2 mmq@512x4096x4096: " + b2
            + "/2097152 wrong");
        int64 b3 = MmqProbe.checkMmq6(512L, 1024L, 4096L);
        System.stdout.println("stage3 q6mmq@512x1024x4096: " + b3
            + "/524288 wrong");
        int64 b4 = MmqProbe.checkMmq6(512L, 4096L, 14336L);
        System.stdout.println("stage3b q6mmq@512x4096x14336: " + b4
            + "/2097152 wrong");
        return (b1 + b2 + b3 + b4) == 0L ? 0 : 1;
    }
}
