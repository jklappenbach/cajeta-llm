package dev.cajeta.llama.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llama.io.Quant;
import dev.cajeta.llama.io.QuantKernel;

/**
 * Isolation probe for the 10.12.39 Q5/Q8 wave kernels: the suite showed a
 * device MEMORY FAULT that poisons the HIP context for every later test,
 * and parallel execution hides which kernel faulted. Run each new kernel
 * alone, then say so — a fault kills the process mid-line.
 */
public class Q58WaveProbe {
    static #int8[] blocks(int64 n, int32 seed) {
        int8[] out #= heap int8[n];
        int32 s = seed;
        int64 i = 0;
        while (i < n) {
            s = s * 1103515245 + 12345;
            out[i] = (int8) (s >> 16);
            i = i + 1;
        }
        return #out;
    }

    static #float32[] acts(int64 n) {
        float32[] x #= heap float32[n];
        int64 i = 0;
        while (i < n) {
            x[i] = ((float32) (i % 97L) - 48.0f) / 37.0f;
            i = i + 1;
        }
        return #x;
    }

    public static void run(String[] args) {
        int64 rows = 2L;

        System.stdout.println("q8_0 wave: 256 blocks/row ...");
        int64 b8 = 512L;
        int8[] p8 #= Q58WaveProbe.blocks(b8 * 34L, 7);
        int64 c8 = (b8 / rows) * 32L;
        float32[] x8 #= Q58WaveProbe.acts(c8);
        float32[] w8 #= heap float32[rows];
        float32[] g8 #= heap float32[rows];
        Quant.q8MatVec(p8, rows, c8, x8, w8);
        QuantKernel.q80Q8WaveMatVecIntoDevice(p8, rows, c8, x8, 0L, g8, 0L);
        System.stdout.println("  q8_0 ok: host " + w8[0L] + " " + w8[1L]
            + "  wave " + g8[0L] + " " + g8[1L]);

        System.stdout.println("q5_k wave: 64 blocks/row ...");
        int64 b5 = 128L;
        int8[] p5 #= Q58WaveProbe.blocks(b5 * 176L, 11);
        int64 c5 = (b5 / rows) * 256L;
        float32[] x5 #= Q58WaveProbe.acts(c5);
        float32[] w5 #= heap float32[rows];
        float32[] g5 #= heap float32[rows];
        Quant.q5kMatVec(p5, rows, c5, x5, w5);
        QuantKernel.q5kQ8WaveMatVecIntoDevice(p5, rows, c5, x5, 0L, g5, 0L);
        System.stdout.println("  q5_k ok: host " + w5[0L] + " " + w5[1L]
            + "  wave " + g5[0L] + " " + g5[1L]);

        System.stdout.println("### Q58PROBEDONE");
    }
}
