package dev.cajeta.llama.bench;

import cajeta.lang.Math;

/**
 * The parity detectors of spec 13.21 (plan 15.2.3): cosine similarity on
 * a final-layer logit vector, top-1 token agreement, and KL divergence of
 * the softmax — three complementary detectors rather than one brittle
 * number (elementwise relative error was rejected: the distribution tail
 * is where floating-point noise concentrates). All accumulation runs at
 * float64; softmax and KL go through max-subtracted logsumexp so a large
 * vocabulary cannot overflow.
 */
public final class Metrics {

    private Metrics() { }

    /** Cosine similarity of two logit vectors. */
    public static float64 cosine(float32[] a, float32[] b, int32 n) {
        float64 dot = 0.0;
        float64 na = 0.0;
        float64 nb = 0.0;
        int32 i = 0;
        while (i < n) {
            float64 x = a[i];
            float64 y = b[i];
            dot = dot + x * y;
            na = na + x * x;
            nb = nb + y * y;
            i = i + 1;
        }
        if (na == 0.0 || nb == 0.0) {
            return 0.0;
        }
        return dot / (Math.sqrt(na) * Math.sqrt(nb));
    }

    /** The argmax index — top-1 agreement is argmax equality. */
    public static int32 argmax(float32[] a, int32 n) {
        int32 best = 0;
        float32 bv = a[0];
        int32 i = 1;
        while (i < n) {
            if (a[i] > bv) {
                bv = a[i];
                best = i;
            }
            i = i + 1;
        }
        return best;
    }

    /** log(sum(exp(a[i] - max))) + max, at float64. */
    public static float64 logSumExp(float32[] a, int32 n) {
        float64 mx = a[0];
        int32 i = 1;
        while (i < n) {
            if (a[i] > mx) {
                mx = a[i];
            }
            i = i + 1;
        }
        float64 s = 0.0;
        i = 0;
        while (i < n) {
            s = s + Math.exp((float64) a[i] - mx);
            i = i + 1;
        }
        return Math.log(s) + mx;
    }

    /**
     * KL(P‖Q) of the softmax distributions of `refLogits` (P) and
     * `gotLogits` (Q): Σ p·(log p − log q), each log-prob taken directly
     * as `logit − logsumexp` — no materialized probability vector, no
     * underflow for large vocabularies.
     */
    public static float64 softmaxKl(float32[] refLogits, float32[] gotLogits,
            int32 n) {
        float64 lseP = Metrics.logSumExp(refLogits, n);
        float64 lseQ = Metrics.logSumExp(gotLogits, n);
        float64 kl = 0.0;
        int32 i = 0;
        while (i < n) {
            float64 lp = (float64) refLogits[i] - lseP;
            float64 lq = (float64) gotLogits[i] - lseQ;
            kl = kl + Math.exp(lp) * (lp - lq);
            i = i + 1;
        }
        return kl;
    }

    /** The gap between the largest and second-largest logit — the tie
     *  detector of spec 13.22 (a divergence is excusable only where this
     *  is under 1e-3). n must be at least 2. */
    public static float32 top2Gap(float32[] a, int32 n) {
        float32 first = a[0];
        float32 second = a[1];
        if (second > first) {
            float32 t = first;
            first = second;
            second = t;
        }
        int32 i = 2;
        while (i < n) {
            float32 v = a[i];
            if (v > first) {
                second = first;
                first = v;
            } else if (v > second) {
                second = v;
            }
            i = i + 1;
        }
        return first - second;
    }
}
