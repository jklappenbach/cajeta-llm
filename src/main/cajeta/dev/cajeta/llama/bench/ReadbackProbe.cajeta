package dev.cajeta.llama.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llama.io.QuantKernel;

/**
 * WHAT does a logits-sized readback cost, by transport?
 *
 * The decode trace shows a ~2.8 ms GPU-idle stall once per token, sitting
 * exactly where `fetchResult` hostLoads lm_head's 128256 floats on the
 * unified backend. The hypothesis: a direct host READ of device-visible
 * memory is uncached (~200 MB/s), while the copy engine (`download`) moves
 * the same bytes by DMA. This probe times both transports at the two sizes
 * the engine actually uses — a per-layer 4096-float output and the
 * 128256-float logits row — with arm order alternated per round.
 */
public class ReadbackProbe {
    static void fill(KernelBuffer<float32> dev, float32[] scratch, int64 n) {
        int64 i = 0;
        while (i < n) {
            scratch[i] = (float32) (i % 251L) * 0.5f;
            i = i + 1;
        }
        dev.upload(scratch, n);
    }

    static float64 armHostLoad(KernelBuffer<float32> dev, float32[] dst,
            int32 reps) {
        int64 t0 = Clock.nanoTime();
        int32 r = 0;
        while (r < reps) {
            dev.hostLoad(dst);
            r = r + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / (float64) reps / 1000.0;
    }

    static float64 armDownload(KernelBuffer<float32> dev, float32[] dst,
            int32 reps) {
        int64 t0 = Clock.nanoTime();
        int32 r = 0;
        while (r < reps) {
            dev.download(dst);
            r = r + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / (float64) reps / 1000.0;
    }

    static void probeSize(int64 n, int32 reps) {
        KernelBuffer<float32> dev #= heap KernelBuffer<float32>((uint64) n);
        float32[] host #= heap float32[n];
        ReadbackProbe.fill(dev, host, n);
        float32[] dst #= heap float32[n];
        System.stdout.println("-- n=" + n + " (" + (n * 4L / 1024L)
            + " KB), " + reps + " reps/arm, 4 rounds alternating");
        int32 round = 0;
        while (round < 4) {
            float64 a;
            float64 b;
            if (round % 2 == 0) {
                a = ReadbackProbe.armHostLoad(dev, dst, reps);
                b = ReadbackProbe.armDownload(dev, dst, reps);
            } else {
                b = ReadbackProbe.armDownload(dev, dst, reps);
                a = ReadbackProbe.armHostLoad(dev, dst, reps);
            }
            float64 mb = (float64) (n * 4L) / 1048576.0;
            System.stdout.println("   round " + round
                + "  hostLoad " + a + " us (" + (mb / (a / 1000000.0))
                + " MB/s)   download " + b + " us ("
                + (mb / (b / 1000000.0)) + " MB/s)");
            // Guard against a transport that silently read nothing.
            if (dst[(int64) 100] != host[(int64) 100]) {
                System.stdout.println("   MISMATCH at 100: " + dst[(int64) 100]
                    + " vs " + host[(int64) 100]);
            }
            round = round + 1;
        }
    }

    public static void run(String[] args) {
        System.stdout.println("backend probe: readback transports");
        ReadbackProbe.probeSize(4096L, 500);
        ReadbackProbe.probeSize(128256L, 100);
        System.stdout.println("### READBACKPROBEDONE");
    }
}
