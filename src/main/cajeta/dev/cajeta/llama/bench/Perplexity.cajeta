package dev.cajeta.llama.bench;

import cajeta.lang.Math;

/**
 * The perplexity harness for the quantized gate (spec 12.15, plan
 * 15.2.4): exp of the mean negative log-likelihood of each target token
 * under the model's per-position logits — llama.cpp's own methodology,
 * which is the stated gate for quantized weights (§12.1's logit
 * tolerance must NOT be asserted against them). NLL accumulates at
 * float64 through the same stable logsumexp as {@link Metrics}.
 */
public final class Perplexity {
    float64 nllSum;
    int32 count;

    public Perplexity() {
        this.nllSum = 0.0;
        this.count = 0;
    }

    /** One position: the model's logits row and the corpus target. */
    public void add(float32[] logits, int32 n, int32 target) {
        float64 lse = Metrics.logSumExp(logits, n);
        this.nllSum = this.nllSum + (lse - (float64) logits[target]);
        this.count = this.count + 1;
    }

    public int32 positions() {
        return this.count;
    }

    public float64 meanNll() {
        if (this.count == 0) {
            return 0.0;
        }
        return this.nllSum / (float64) this.count;
    }

    public float64 ppl() {
        return Math.exp(this.meanNll());
    }
}
