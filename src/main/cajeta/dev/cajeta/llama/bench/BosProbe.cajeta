package dev.cajeta.llama.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llama.io.Checkpoint;
import dev.cajeta.llama.io.Quant;
import dev.cajeta.llama.model.LlamaForCausalLM;
import dev.cajeta.llama.model.ModelConfig;
import dev.cajeta.llama.tok.Tokenizer;

/**
 * Isolate BOS: greedy-decode "The capital of France is" WITH and WITHOUT a
 * leading <|begin_of_text|> (128000). llama.cpp prepends it by default and
 * answers " Paris."; our CLI encodes without it and answered " the".
 */
public class BosProbe {
    static void once(LlamaForCausalLM m, Tokenizer t, int32[] ids, int32 n,
            String label) {
        int32 nxt = m.prefill(ids, n);
        int32[] one #= heap int32[1];
        one[0] = nxt;
        int8[] b #= t.decode(one, 1);
        String s #= heap String(#b, (int32) b.count());
        System.stdout.println(label + " -> id " + nxt + " = '" + s + "'");
        return;
    }

    public static void run(String[] args) {
        String path = args[0];
        // args[1] == "nopack" runs the SAME checkpoint dequantized, so a
        // wrong token can be attributed to the packed path or exonerated.
        if ((int32) args.count() > 1 && args[1].equals("nopack")) {
            Quant.setPackingEnabled(false);
            System.stdout.println("(packing DISABLED)");
        }
        Checkpoint ck #= Checkpoint.open(path);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        cfg.blockTokens = 16;
        Tokenizer t #= ck.gguf().tokenizer();
        LlamaForCausalLM m = heap LlamaForCausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();

        int32[] withBos #= heap int32[6];
        withBos[0] = 128000;
        withBos[1] = 791;
        withBos[2] = 6864;
        withBos[3] = 315;
        withBos[4] = 9822;
        withBos[5] = 374;
        BosProbe.once(m, t, withBos, 6, "WITH bos");
        return;
    }
}
