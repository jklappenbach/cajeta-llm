package dev.cajeta.llama.io;

import cajeta.lang.Cajeta;
import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import dev.cajeta.llama.io.GgufFile;
import dev.cajeta.llama.io.Quant;
import dev.cajeta.llama.io.QuantKernel;

/**
 * Q4_K x Q8_K on the MATRIX CORES (plan 10.12.14).
 *
 * Measured ceilings, all on this box and each validated by doubling the
 * probe's iteration count:
 *
 *   our dotAccum GEMM today       1.08 TMAC/s
 *   llama.cpp prefill achieves    9.3
 *   dotAccum ceiling              9.9
 *   WMMA int8 ceiling            27.0
 *
 * `dotAccum` cannot win: its ceiling is 9.9 and llama.cpp already gets
 * 9.3. WMMA is 2.7x that ceiling, and `int8` is a NATIVE config on
 * amdgpu — the `[mma-tiering]` notes name only bfloat16, float32 and
 * float64 as software-tier, so int8 and float16 reach the hardware.
 *
 * ONE WAVE COMPUTES ONE 16x16 OUTPUT TILE: 16 prompt tokens by 16 output
 * rows, accumulated over the whole K extent.
 *
 * THE SCALE SEAM IS THE DESIGN PROBLEM. A Q4_K scale covers 32 K
 * elements and applies PER OUTPUT ROW; a WMMA tile spans K=16 and its
 * accumulator cannot be indexed per element. So the K loop runs two
 * `mma`s to cover one 32-element sub-block, spills the int32 accumulator
 * to LDS, applies `scale[outRow][sub] * d[outRow] * xs[token]` there
 * into an f32 accumulator, and re-zeroes. Two `mma` (8192 MACs) per
 * spill keeps the ratio at ~32 MACs per scalar op.
 *
 * The A operand loads STRAIGHT from the packed activation buffer — no
 * staging — because q8_K quants are already contiguous per token with a
 * constant row stride, which is exactly what `load(buf, offset, layout,
 * stride)` wants. Only B needs LDS, because Q4_K nibbles must be widened
 * to int8 first.
 */
public final class WmmaKernel {

    /**
     * `y[rows x outDim] = X . W^T`, X packed q8_K, W packed Q4_K.
     * Requires `rows % 16 == 0` and `outDim % 16 == 0`; the launcher
     * checks both and falls back rather than truncating.
     */
    @Kernel
    public static void q4kWmmaKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 tilesN,
            int64 blocksPerRow) {
        // B tile, widened nibbles: [k][outRow], 16x16.
        // THE WHOLE BLOCK'S nibbles, widened ONCE: [k][outRow] for all
        // 256 k. The first version staged 16 k at a time, re-widening
        // for every `mma` pair — the same 4096 nibble extracts, but as
        // 256 scattered 16-byte reads instead of 16 contiguous 128-byte
        // ones, and with ~32 workgroup barriers a block instead of 2. It
        // measured SLOWER than the dotAccum kernel it was meant to beat.
        Shared<int8> bt = shared int8[4096];
        // Accumulator spill and the f32 running sum, both [token][outRow].
        Shared<int32> ct = shared int32[256];
        Shared<float32> acc = shared float32[256];
        // Per-output-row block header state, and per-token activation
        // scales. Decoded ONCE per block by the first 16 lanes, then read
        // by every lane — the redundant-decode fix the dotAccum kernel
        // could not have, since there each lane owned a different token.
        Shared<int32> scLds = shared int32[128];   // [outRow][sub]
        Shared<int32> mnLds = shared int32[128];
        Shared<float32> dLds = shared float32[16];
        Shared<float32> dmLds = shared float32[16];
        Shared<float32> xsLds = shared float32[16];
        Shared<int32> psLds = shared int32[128];   // [token][sub]

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;

            uint32 z = lane;
            while (z < 256) { acc[z] = 0.0f; z = z + 32; }
            Barrier.workgroup();

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;

            int64 b = 0;
            while (b < blocksPerRow) {
                // ── per-block header decode, once per wave ──────────────
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 144L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro] & 255)
                        | (((int32) packed[ro + 1L] & 255) << 8));
                    dmLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 2L] & 255)
                        | (((int32) packed[ro + 3L] & 255) << 8));
                    int32 q = 0;
                    while (q < 4) {
                        int32 dq = (int32) packed[ro + 4L + (int64) q] & 255;
                        int32 mq = (int32) packed[ro + 8L + (int64) q] & 255;
                        int32 kq = (int32) packed[ro + 12L + (int64) q] & 255;
                        scLds[lane * 8 + q] = dq & 63;
                        scLds[lane * 8 + 4 + q] =
                            (kq & 15) | ((dq >> 2) & 48);
                        mnLds[lane * 8 + q] = mq & 63;
                        mnLds[lane * 8 + 4 + q] =
                            (kq >> 4) | ((mq >> 2) & 48);
                        q = q + 1;
                    }
                } else {
                    // The activation side: one token per lane, 16 of them.
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    int32 sbi = 0;
                    while (sbi < 8) {
                        int64 at = xb + 256L + (int64) (sbi * 4);
                        psLds[tk * 8 + sbi] = ((int32) xp[at] & 255)
                            | (((int32) xp[at + 1L] & 255) << 8)
                            | (((int32) xp[at + 2L] & 255) << 16)
                            | (((int32) xp[at + 3L]) << 24);
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                // ── eight 32-element sub-blocks, two mma each ───────────
                // Widen the block ONCE. Lane `l` walks contiguous bytes
                // of one weight row: 128 bytes hold this block's 256
                // nibbles, so the wave reads 16 contiguous runs.
                uint32 wnib = lane;
                while (wnib < 2048) {
                    uint32 ii = wnib / 128;
                    uint32 byteIdx = wnib % 128;
                    int64 ro3 = (int64) (i0 + ii) * rowBytes + b * 144L
                        + 16L + (int64) byteIdx;
                    int32 rb = (int32) packed[ro3] & 255;
                    // Byte `t` of the 32 at 16+32g carries element 64g+t
                    // in its LOW nibble and 64g+32+t in its HIGH one —
                    // the pairing `lo`/`hi` had against a0/a1.
                    uint32 g = byteIdx / 32;
                    uint32 t2 = byteIdx % 32;
                    uint32 kLo = 64 * g + t2;
                    uint32 kHi = 64 * g + 32 + t2;
                    bt[ii * 256 + kLo] = (int8) (rb & 15);
                    bt[ii * 256 + kHi] = (int8) ((rb >> 4) & 15);
                    wnib = wnib + 32;
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    mc.splat(0);
                    uint32 half = 0;
                    while (half < 2) {
                        // Widen 16 k x 16 outRow nibbles into the B tile.
                        // Sub-block j lives in the 32 bytes at 16+32*(j/2),
                        // low nibbles for even j and high for odd — the
                        // same pairing the dotAccum kernel used, where
                        // scv[2g] fed `lo` and scv[2g+1] fed `hi`.
                        // READ COALESCED, WRITE TRANSPOSED. `ii` is the
                        // OUTPUT ROW and `kk` the K index, and the two
                        // are assigned this way round deliberately:
                        // consecutive lanes take consecutive `kk` within
                        // ONE weight row, so the wave reads a contiguous
                        // 16-byte run. The other assignment gives each
                        // lane a different output row, `rowBytes` apart —
                        // 11.0's one-row-per-lane shape, which measured
                        // two thirds the bandwidth. LDS absorbs the
                        // transpose for free.
                        uint32 kBase = 32 * j + 16 * half;
                        int64 aOff = (int64) t0 * xRowBytes + b * 320L
                            + (int64) kBase;
                        ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                        mb.load(bt, kBase, 1, 256);
                        mc.mma(ma, mb);
                        half = half + 1;
                    }
                    mc.store(ct, 0, 0, 16);
                    Barrier.workgroup();
                    uint32 p = lane;
                    while (p < 256) {
                        uint32 tt = p / 16;
                        uint32 ii = p % 16;
                        acc[p] = acc[p] + dLds[ii] * xsLds[tt]
                            * (float32) (scLds[ii * 8 + j] * ct[p]);
                        p = p + 32;
                    }
                    Barrier.workgroup();
                    j = j + 1;
                }

                // ── the dmin correction, separable and mma-free ─────────
                uint32 p2 = lane;
                while (p2 < 256) {
                    uint32 tt = p2 / 16;
                    uint32 ii = p2 % 16;
                    int32 dm = 0;
                    uint32 sj = 0;
                    while (sj < 8) {
                        dm = dm + mnLds[ii * 8 + sj] * psLds[tt * 8 + sj];
                        sj = sj + 1;
                    }
                    acc[p2] = acc[p2]
                        - dmLds[ii] * xsLds[tt] * (float32) dm;
                    p2 = p2 + 32;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            uint32 w = lane;
            while (w < 256) {
                uint32 tt = w / 16;
                uint32 ii = w % 16;
                y[(int64) (t0 + tt) * (int64) outDim + (int64) (i0 + ii)] =
                    acc[w];
                w = w + 32;
            }
        }
    }

    /** True when the shapes suit the tiled kernel. */
    public static boolean fits(int64 rows, int64 outDim) {
        return rows % 16L == 0L && outDim % 16L == 0L;
    }

    public static void q4kWmmaLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaKernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        // NoSync (10.12.24): the stream is in-order and every consumer
        // is either another launch or a download behind an explicit
        // sync. The per-launch sync was ~250 GPU-host round trips per
        // prefill.
        return;
    }

    /**
     * 10.12.16 — the ONE-TIME widen: packed Q4_K nibbles out to a
     * TILE-MAJOR int8 copy holding the RAW nibble 0..15. Scales, mins,
     * d and dmin are NOT folded in — they stay in the packed buffer and
     * the deq GEMM applies them at the seam exactly as the staged
     * kernel does, so the two kernels are bit-identical.
     *
     * WHY TILED AND NOT `[outDim x cols]`: the flat layout was BUILT
     * AND MEASURED FIRST — `mb.load(deq, ., 1, cols)` is functionally
     * correct (bit-identical output) and 52% SLOWER (launch 4.6 s vs
     * 3.03 s at 512 ctx), because a column-major fragment load gathers
     * sixteen 16-byte runs a weight-row apart: one cache line per run
     * at quarter utilization, with no LDS to absorb the stride.
     * llama.cpp's MMQ corroborates: their WMMA path never feeds B from
     * strided global either — `load_tiles` always stages through shared.
     *
     * So the copy is stored the way the FRAGMENT wants it: tile
     * `(I, K) = (i/16, k/16)` is a contiguous 256-byte `[k%16][i%16]`
     * run at `(I*(cols/16) + K) * 256` — the exact layout the staged
     * kernel builds in LDS — and the GEMM reads it with
     * `mb.load(deq, tileBase, 0, 16)`: four fully-utilized cache lines,
     * no staging, no barriers.
     *
     * One thread per packed nibble byte: reads are coalesced along the
     * 128-byte nibble area; the widen's scattered writes run ONCE per
     * weight, so their pattern is irrelevant.
     */
    @Kernel
    public static void q4kWidenKernel(KernelBuffer<int8> deq,
            KernelBuffer<int8> packed, uint32 total, int64 blocksPerRow) {
        uint32 tid = KernelThread.globalIdX();
        if (tid < total) {
            uint32 perRow = (uint32) blocksPerRow * 128;
            uint32 ii = tid / perRow;
            uint32 rem = tid % perRow;
            uint32 b = rem / 128;
            uint32 byteIdx = rem % 128;
            int64 ro = (int64) ii * (blocksPerRow * 144L)
                + (int64) b * 144L + 16L + (int64) byteIdx;
            int32 rb = (int32) packed[ro] & 255;
            uint32 g = byteIdx / 32;
            uint32 t = byteIdx % 32;
            int64 tilesK = blocksPerRow * 16L;
            int64 kLo = (int64) b * 256L + (int64) (64 * g + t);
            int64 kHi = kLo + 32L;
            int64 tI = (int64) (ii / 16);
            int64 iIn = (int64) (ii % 16);
            // [col][k] within the tile (10.12.26): each lane's 16
            // fragment bytes are CONSECUTIVE, so the GEMM's B load is
            // one <4 x i32> per lane instead of sixteen byte loads.
            deq[(tI * tilesK + kLo / 16L) * 256L
                + iIn * 16L + (kLo % 16L)] = (int8) (rb & 15);
            deq[(tI * tilesK + kHi / 16L) * 256L
                + iIn * 16L + (kHi % 16L)] = (int8) ((rb >> 4) & 15);
        }
    }

    public static void q4kWidenLaunch(KernelBuffer<int8> deq,
            KernelBuffer<int8> packed, int64 outDim, int64 cols) {
        int64 bpr = cols / 256L;
        int64 total = outDim * bpr * 128L;
        KernelStream s = QuantKernel.stream();
        q4kWidenKernel.launch(s, grid: [(uint32) ((total + 255L) / 256L)],
            block: [256])
            (deq, packed, (uint32) total, bpr);
        return;
    }

    /** 10.12.32: device-side byte copy at an offset — builds the
     *  fused packed weight buffers (q|k|v, gate|up) from the resident
     *  per-tensor copies at device bandwidth, once, at prewarm. */
    @Kernel
    public static void concatI8Kernel(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, uint32 n, uint32 dstOff) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { dst[dstOff + i] = src[i]; }
    }

    public static void concatI8Launch(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, int64 n, int64 dstOff) {
        KernelStream s = QuantKernel.stream();
        concatI8Kernel.launch(s, grid: [(uint32) ((n + 255L) / 256L)],
            block: [256])
            (dst, src, (uint32) n, (uint32) dstOff);
        return;
    }

    /** The read-side twin: copy `n` bytes starting at `srcOff` — the
     *  grid-sweep probe carves row-range slices with it. */
    @Kernel
    public static void sliceI8Kernel(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, uint32 n, uint32 srcOff) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { dst[i] = src[srcOff + i]; }
    }

    public static void sliceI8Launch(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, int64 n, int64 srcOff) {
        KernelStream s = QuantKernel.stream();
        sliceI8Kernel.launch(s, grid: [(uint32) ((n + 255L) / 256L)],
            block: [256])
            (dst, src, (uint32) n, (uint32) srcOff);
        return;
    }

    /**
     * The deq GEMM (10.12.16): the staged kernel with the B feed moved
     * to the widened TILE-MAJOR global copy. Each `mb.load(deq,
     * tileBase, 0, 16)` reads one contiguous 256-byte fragment — the
     * `bt` tile, its 2048-nibble widen loop and its barrier are GONE;
     * LDS keeps only the seam spill and the header state. The header
     * decode, the scale seam and the dmin correction are UNCHANGED, so
     * the output is bit-identical to the staged kernel's. (The flat
     * `[outDim x cols]` + layout=1 form was measured 52% slower — see
     * the widen kernel's comment.)
     */
    @Kernel
    public static void q4kWmmaDeqKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN, int64 blocksPerRow) {
        Shared<int32> ct = shared int32[256];
        Shared<float32> acc = shared float32[256];
        Shared<int32> scLds = shared int32[128];
        Shared<int32> mnLds = shared int32[128];
        Shared<float32> dLds = shared float32[16];
        Shared<float32> dmLds = shared float32[16];
        Shared<float32> xsLds = shared float32[16];
        Shared<int32> psLds = shared int32[128];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;

            uint32 z = lane;
            while (z < 256) { acc[z] = 0.0f; z = z + 32; }
            Barrier.workgroup();

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;

            int64 b = 0;
            while (b < blocksPerRow) {
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 144L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro] & 255)
                        | (((int32) packed[ro + 1L] & 255) << 8));
                    dmLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 2L] & 255)
                        | (((int32) packed[ro + 3L] & 255) << 8));
                    int32 q = 0;
                    while (q < 4) {
                        int32 dq = (int32) packed[ro + 4L + (int64) q] & 255;
                        int32 mq = (int32) packed[ro + 8L + (int64) q] & 255;
                        int32 kq = (int32) packed[ro + 12L + (int64) q] & 255;
                        scLds[lane * 8 + q] = dq & 63;
                        scLds[lane * 8 + 4 + q] =
                            (kq & 15) | ((dq >> 2) & 48);
                        mnLds[lane * 8 + q] = mq & 63;
                        mnLds[lane * 8 + 4 + q] =
                            (kq >> 4) | ((mq >> 2) & 48);
                        q = q + 1;
                    }
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    int32 sbi = 0;
                    while (sbi < 8) {
                        int64 at = xb + 256L + (int64) (sbi * 4);
                        psLds[tk * 8 + sbi] = ((int32) xp[at] & 255)
                            | (((int32) xp[at + 1L] & 255) << 8)
                            | (((int32) xp[at + 2L] & 255) << 16)
                            | (((int32) xp[at + 3L]) << 24);
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    mc.splat(0);
                    uint32 half = 0;
                    while (half < 2) {
                        uint32 kBase = 32 * j + 16 * half;
                        int64 aOff = (int64) t0 * xRowBytes + b * 320L
                            + (int64) kBase;
                        ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                        // Tile (i0/16, kAbs/16) is one contiguous
                        // 256-byte [k][outRow] run — the bt layout,
                        // pre-materialized.
                        int64 kAbs = b * 256L + (int64) kBase;
                        int64 bOff = ((int64) (i0 / 16)
                            * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                        mb.load(deq, (uint32) bOff, 1, 16);
                        mc.mma(ma, mb);
                        half = half + 1;
                    }
                    mc.store(ct, 0, 0, 16);
                    Barrier.workgroup();
                    uint32 p = lane;
                    while (p < 256) {
                        uint32 tt = p / 16;
                        uint32 ii = p % 16;
                        acc[p] = acc[p] + dLds[ii] * xsLds[tt]
                            * (float32) (scLds[ii * 8 + j] * ct[p]);
                        p = p + 32;
                    }
                    Barrier.workgroup();
                    j = j + 1;
                }

                uint32 p2 = lane;
                while (p2 < 256) {
                    uint32 tt = p2 / 16;
                    uint32 ii = p2 % 16;
                    int32 dm = 0;
                    uint32 sj = 0;
                    while (sj < 8) {
                        dm = dm + mnLds[ii * 8 + sj] * psLds[tt * 8 + sj];
                        sj = sj + 1;
                    }
                    acc[p2] = acc[p2]
                        - dmLds[ii] * xsLds[tt] * (float32) dm;
                    p2 = p2 + 32;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            uint32 w = lane;
            while (w < 256) {
                uint32 tt = w / 16;
                uint32 ii = w % 16;
                y[(int64) (t0 + tt) * (int64) outDim + (int64) (i0 + ii)] =
                    acc[w];
                w = w + 32;
            }
        }
    }

    public static void q4kWmmaDeqLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqKernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        // NoSync (10.12.24): the stream is in-order and every consumer
        // is either another launch or a download behind an explicit
        // sync. The per-launch sync was ~250 GPU-host round trips per
        // prefill.
        return;
    }

    /**
     * Both kernels over HOST arrays on the same bytes — the shape a test
     * can call. `want` comes from the shipped one-token-per-lane batch
     * kernel, `got` from the matrix cores.
     */
    public static void compareInto(int8[] rawW, float32[] x, int64 rows,
            int64 outDim, int64 cols, float32[] want, float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        KernelStream s = QuantKernel.stream();
        s.sync();
        yDev.download(want, rows * outDim);
        WmmaKernel.q4kWmmaLaunch(yDev, wDev, xDev, rows, outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /**
     * Q6_K x q8_K on the MATRIX CORES (plan 10.12.23) — the 10.12.14
     * structure with Q6_K's layout, routed for `attn_v` and the Q6_K
     * `ffn_down` projections that 10.12.22 measured at 1290 ms on the
     * dotAccum fallback (32 calls costing ~as much as all 192 WMMA
     * calls).
     *
     * TWO WAYS Q6_K IS SIMPLER THAN Q4_K HERE, both load-bearing:
     *
     * - The quants widen SIGNED. The dotAccum kernel keeps q unsigned
     *   (0..63) and corrects with `-32*asum` because its VNNI dot is
     *   uint8 x int8; the matrix cores multiply signed int8, so the B
     *   tile holds `q - 32` directly and the correction pass — and the
     *   per-16 activation sums it would need, which our q8_K pack does
     *   not even store — never exists.
     * - The scale seam ALIGNS with the fragment: one scale covers 16
     *   elements, exactly one mma's K extent, so each spill applies one
     *   scale cleanly. The price is 16 spills per block where Q4_K pays
     *   8 (its scales span two mmas) — the seam-in-registers work
     *   (10.12.20) will collapse both.
     *
     * Scales are SIGNED int8 (no dmin, no mins): `w = d * sc * q`.
     */
    @Kernel
    public static void q6kWmmaKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 tilesN,
            int64 blocksPerRow) {
        // [k][outRow] signed widened quants, whole block: 256 x 16.
        Shared<int8> bt = shared int8[4096];
        Shared<int32> ct = shared int32[256];
        Shared<float32> acc = shared float32[256];
        Shared<int32> scLds = shared int32[256];   // [outRow][group]
        Shared<float32> dLds = shared float32[16];
        Shared<float32> xsLds = shared float32[16];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 210L;
            int64 xRowBytes = blocksPerRow * 320L;

            uint32 z = lane;
            while (z < 256) { acc[z] = 0.0f; z = z + 32; }
            Barrier.workgroup();

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;

            int64 b = 0;
            while (b < blocksPerRow) {
                // ── per-block header decode, once per wave ──────────────
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 210L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 208L] & 255)
                        | (((int32) packed[ro + 209L] & 255) << 8));
                    // Scales sign-extend deliberately: int8, no mask.
                    int32 s = 0;
                    while (s < 16) {
                        scLds[lane * 16 + s] =
                            (int32) packed[ro + 192L + (int64) s];
                        s = s + 1;
                    }
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                }
                Barrier.workgroup();

                // ── widen the block once: 16 rows x 128 ql bytes ────────
                // ql byte `64h + l64` carries element `128h + l64` in its
                // low nibble and `128h + l64 + 64` in its high one; both
                // share qh byte `32h + l64%32`, at shifts 2*(l64/32) and
                // 2*(l64/32) + 4 — the batch kernel's addressing, per
                // element instead of per 16-vector. Signed, biased here.
                uint32 w6 = lane;
                while (w6 < 2048) {
                    uint32 ii = w6 / 128;
                    uint32 byteIdx = w6 % 128;
                    uint32 h = byteIdx / 64;
                    uint32 l64 = byteIdx % 64;
                    int64 ro2 = (int64) (i0 + ii) * rowBytes + b * 210L;
                    int32 qlb = (int32) packed[ro2 + (int64) byteIdx] & 255;
                    int32 qhb = (int32) packed[ro2 + 128L
                        + (int64) (32 * h) + (int64) (l64 % 32)] & 255;
                    uint32 sh = 2 * (l64 / 32);
                    int32 vLo = ((qlb & 15)
                        | (((qhb >> sh) & 3) << 4)) - 32;
                    int32 vHi = (((qlb >> 4) & 15)
                        | (((qhb >> (sh + 4)) & 3) << 4)) - 32;
                    uint32 kLo = 128 * h + l64;
                    bt[ii * 256 + kLo] = (int8) vLo;
                    bt[ii * 256 + kLo + 64] = (int8) vHi;
                    w6 = w6 + 32;
                }
                Barrier.workgroup();

                // ── sixteen 16-element groups, one mma + one scale each ─
                uint32 j = 0;
                while (j < 16) {
                    mc.splat(0);
                    uint32 kBase = 16 * j;
                    int64 aOff = (int64) t0 * xRowBytes + b * 320L
                        + (int64) kBase;
                    ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                    mb.load(bt, kBase, 1, 256);
                    mc.mma(ma, mb);
                    mc.store(ct, 0, 0, 16);
                    Barrier.workgroup();
                    uint32 p = lane;
                    while (p < 256) {
                        uint32 tt = p / 16;
                        uint32 ii = p % 16;
                        acc[p] = acc[p] + dLds[ii] * xsLds[tt]
                            * (float32) (scLds[ii * 16 + j] * ct[p]);
                        p = p + 32;
                    }
                    Barrier.workgroup();
                    j = j + 1;
                }
                b = b + 1;
            }

            uint32 w = lane;
            while (w < 256) {
                uint32 tt = w / 16;
                uint32 ii = w % 16;
                y[(int64) (t0 + tt) * (int64) outDim + (int64) (i0 + ii)] =
                    acc[w];
                w = w + 32;
            }
        }
    }

    public static void q6kWmmaLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q6kWmmaKernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        // NoSync (10.12.24): the stream is in-order and every consumer
        // is either another launch or a download behind an explicit
        // sync. The per-launch sync was ~250 GPU-host round trips per
        // prefill.
        return;
    }

    /**
     * Q6_K batch kernel vs Q6_K WMMA on the same bytes — `want` from
     * the shipped dotAccum twin, `got` from the matrix cores.
     */
    public static void compareQ6Into(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        KernelStream s = QuantKernel.stream();
        s.sync();
        yDev.download(want, rows * outDim);
        WmmaKernel.q6kWmmaLaunch(yDev, wDev, xDev, rows, outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    // ── the EPILOGUE kernels (xpu-coopmatrix-epilogue U3; plan 10.12.20) ──
    //
    // The spill kernels above pay the seam through LDS: store the int32
    // accumulator tile, barrier, apply scales with scalar code, barrier,
    // re-splat — 8x per block for Q4_K, 16x for Q6_K. These variants run
    // the seam IN THE ACCUMULATOR'S REGISTERS via
    // `CooperativeMatrix.scaledAccumInto`/`rank1Accum`: a float32
    // accumulator fragment persists across the whole K extent and stores
    // to `y` once at the end. THE C FRAGMENT'S ROWS ARE TOKENS and its
    // COLUMNS ARE OUTPUT ROWS (A is the activations), so the verb's
    // `rowF` is the per-token activation scale and `colF` is the d*sc
    // fold (built per K-slice by 16 lanes — llama.cpp's stage-time
    // fold); getting that backwards passes only on the tile diagonal,
    // which is exactly how the first build failed. Q4_K's dmin term
    // becomes 8 rank-1 accumulates.
    //
    // BARRIERS ARE REQUIRED, and that was MEASURED the hard way: the
    // barrier-free build corrupted exactly the odd fragment rows — the
    // half=1 lanes reading a fold the other half had just written — and
    // the staleness is TIMING-dependent (reads issued right after the
    // fold saw stale LDS; reads after long-latency loads did not), so a
    // passing test without barriers proves nothing. The single-wave
    // "LDS is in-order per wave" model does NOT hold through cajeta's
    // diverged-fold codegen. An earlier experiment that "showed"
    // barriers changed nothing was CONFOUNDED — it ran with the row/col
    // swap bug present in both arms. What the epi kernels still remove
    // vs the spill kernels is the SPILLS: the 256-element accumulator
    // round-trip and re-splat per sub-block; the barrier count is
    // roughly a wash.

    /** Q4_K epi GEMM over the tile-major widened int8 copy — the int8
     *  prefill-weight mode's flagship. */
    @Kernel
    public static void q4kWmmaDeqEpiKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN, int64 blocksPerRow) {
        Shared<int32> scLds = shared int32[128];
        Shared<int32> mnLds = shared int32[128];
        Shared<float32> dLds = shared float32[16];
        Shared<float32> dmLds = shared float32[16];
        Shared<float32> xsLds = shared float32[16];
        Shared<int32> psLds = shared int32[128];
        Shared<float32> rowFj = shared float32[16];
        Shared<float32> rowGj = shared float32[16];
        Shared<float32> colGj = shared float32[16];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;
            CooperativeMatrix<float32,16,16,2> facc;
            facc.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 144L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro] & 255)
                        | (((int32) packed[ro + 1L] & 255) << 8));
                    dmLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 2L] & 255)
                        | (((int32) packed[ro + 3L] & 255) << 8));
                    int32 q = 0;
                    while (q < 4) {
                        int32 dq = (int32) packed[ro + 4L + (int64) q] & 255;
                        int32 mq = (int32) packed[ro + 8L + (int64) q] & 255;
                        int32 kq = (int32) packed[ro + 12L + (int64) q] & 255;
                        scLds[lane * 8 + q] = dq & 63;
                        scLds[lane * 8 + 4 + q] =
                            (kq & 15) | ((dq >> 2) & 48);
                        mnLds[lane * 8 + q] = mq & 63;
                        mnLds[lane * 8 + 4 + q] =
                            (kq >> 4) | ((mq >> 2) & 48);
                        q = q + 1;
                    }
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    int32 sbi = 0;
                    while (sbi < 8) {
                        int64 at = xb + 256L + (int64) (sbi * 4);
                        psLds[tk * 8 + sbi] = ((int32) xp[at] & 255)
                            | (((int32) xp[at + 1L] & 255) << 8)
                            | (((int32) xp[at + 2L] & 255) << 16)
                            | (((int32) xp[at + 3L]) << 24);
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    // ONE fold, ONE barrier envelope for BOTH verbs: the
                    // d*sc row scale, the -dmin*mn rank-1 row term and
                    // the xs*ps rank-1 token term of THIS sub-block. The
                    // first build ran dmin as a separate 8x rank-1 loop
                    // with its own barriers - measured +42% on the GEMM.
                    if (lane < 16) {
                        rowFj[lane] = dLds[lane]
                            * (float32) scLds[lane * 8 + j];
                        rowGj[lane] = 0.0f - dmLds[lane]
                            * (float32) mnLds[lane * 8 + j];
                        colGj[lane] = xsLds[lane]
                            * (float32) psLds[lane * 8 + j];
                    }
                    Barrier.workgroup();
                    mc.splat(0);
                    uint32 half = 0;
                    while (half < 2) {
                        uint32 kBase = 32 * j + 16 * half;
                        int64 aOff = (int64) t0 * xRowBytes + b * 320L
                            + (int64) kBase;
                        ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                        int64 kAbs = b * 256L + (int64) kBase;
                        int64 bOff = ((int64) (i0 / 16)
                            * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                        mb.load(deq, (uint32) bOff, 1, 16);
                        mc.mma(ma, mb);
                        half = half + 1;
                    }
                    mc.scaledAccumInto(facc, xsLds, rowFj);
                    facc.rank1Accum(colGj, rowGj);
                    Barrier.workgroup();
                    j = j + 1;
                }
                b = b + 1;
            }

            facc.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    public static void q4kWmmaDeqEpiLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqEpiKernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        // NoSync (10.12.24): the stream is in-order and every consumer
        // is either another launch or a download behind an explicit
        // sync. The per-launch sync was ~250 GPU-host round trips per
        // prefill.
        return;
    }

    /** Q4_K epi GEMM with the LDS-staged B widen — the packed mode. */
    @Kernel
    public static void q4kWmmaEpiKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 tilesN,
            int64 blocksPerRow) {
        Shared<int8> bt = shared int8[4096];
        Shared<int32> scLds = shared int32[128];
        Shared<int32> mnLds = shared int32[128];
        Shared<float32> dLds = shared float32[16];
        Shared<float32> dmLds = shared float32[16];
        Shared<float32> xsLds = shared float32[16];
        Shared<int32> psLds = shared int32[128];
        Shared<float32> rowFj = shared float32[16];
        Shared<float32> rowGj = shared float32[16];
        Shared<float32> colGj = shared float32[16];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;
            CooperativeMatrix<float32,16,16,2> facc;
            facc.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 144L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro] & 255)
                        | (((int32) packed[ro + 1L] & 255) << 8));
                    dmLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 2L] & 255)
                        | (((int32) packed[ro + 3L] & 255) << 8));
                    int32 q = 0;
                    while (q < 4) {
                        int32 dq = (int32) packed[ro + 4L + (int64) q] & 255;
                        int32 mq = (int32) packed[ro + 8L + (int64) q] & 255;
                        int32 kq = (int32) packed[ro + 12L + (int64) q] & 255;
                        scLds[lane * 8 + q] = dq & 63;
                        scLds[lane * 8 + 4 + q] =
                            (kq & 15) | ((dq >> 2) & 48);
                        mnLds[lane * 8 + q] = mq & 63;
                        mnLds[lane * 8 + 4 + q] =
                            (kq >> 4) | ((mq >> 2) & 48);
                        q = q + 1;
                    }
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    int32 sbi = 0;
                    while (sbi < 8) {
                        int64 at = xb + 256L + (int64) (sbi * 4);
                        psLds[tk * 8 + sbi] = ((int32) xp[at] & 255)
                            | (((int32) xp[at + 1L] & 255) << 8)
                            | (((int32) xp[at + 2L] & 255) << 16)
                            | (((int32) xp[at + 3L]) << 24);
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                uint32 wnib = lane;
                while (wnib < 2048) {
                    uint32 ii = wnib / 128;
                    uint32 byteIdx = wnib % 128;
                    int64 ro3 = (int64) (i0 + ii) * rowBytes + b * 144L
                        + 16L + (int64) byteIdx;
                    int32 rb = (int32) packed[ro3] & 255;
                    uint32 g = byteIdx / 32;
                    uint32 t2 = byteIdx % 32;
                    uint32 kLo = 64 * g + t2;
                    uint32 kHi = 64 * g + 32 + t2;
                    bt[ii * 256 + kLo] = (int8) (rb & 15);
                    bt[ii * 256 + kHi] = (int8) ((rb >> 4) & 15);
                    wnib = wnib + 32;
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    // ONE fold, ONE barrier envelope for BOTH verbs: the
                    // d*sc row scale, the -dmin*mn rank-1 row term and
                    // the xs*ps rank-1 token term of THIS sub-block. The
                    // first build ran dmin as a separate 8x rank-1 loop
                    // with its own barriers - measured +42% on the GEMM.
                    if (lane < 16) {
                        rowFj[lane] = dLds[lane]
                            * (float32) scLds[lane * 8 + j];
                        rowGj[lane] = 0.0f - dmLds[lane]
                            * (float32) mnLds[lane * 8 + j];
                        colGj[lane] = xsLds[lane]
                            * (float32) psLds[lane * 8 + j];
                    }
                    Barrier.workgroup();
                    mc.splat(0);
                    uint32 half = 0;
                    while (half < 2) {
                        uint32 kBase = 32 * j + 16 * half;
                        int64 aOff = (int64) t0 * xRowBytes + b * 320L
                            + (int64) kBase;
                        ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                        mb.load(bt, kBase, 1, 256);
                        mc.mma(ma, mb);
                        half = half + 1;
                    }
                    mc.scaledAccumInto(facc, xsLds, rowFj);
                    facc.rank1Accum(colGj, rowGj);
                    Barrier.workgroup();
                    j = j + 1;
                }
                b = b + 1;
            }

            facc.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    public static void q4kWmmaEpiLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaEpiKernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        // NoSync (10.12.24): the stream is in-order and every consumer
        // is either another launch or a download behind an explicit
        // sync. The per-launch sync was ~250 GPU-host round trips per
        // prefill.
        return;
    }

    /** Q6_K epi GEMM: signed widen, one scale per K-slice, no dmin. */
    @Kernel
    public static void q6kWmmaEpiKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 tilesN,
            int64 blocksPerRow) {
        Shared<int8> bt = shared int8[4096];
        Shared<int32> scLds = shared int32[256];
        Shared<float32> dLds = shared float32[16];
        Shared<float32> xsLds = shared float32[16];
        Shared<float32> rowFj = shared float32[16];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 210L;
            int64 xRowBytes = blocksPerRow * 320L;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;
            CooperativeMatrix<float32,16,16,2> facc;
            facc.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 210L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 208L] & 255)
                        | (((int32) packed[ro + 209L] & 255) << 8));
                    int32 s = 0;
                    while (s < 16) {
                        scLds[lane * 16 + s] =
                            (int32) packed[ro + 192L + (int64) s];
                        s = s + 1;
                    }
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                }
                Barrier.workgroup();

                uint32 w6 = lane;
                while (w6 < 2048) {
                    uint32 ii = w6 / 128;
                    uint32 byteIdx = w6 % 128;
                    uint32 h = byteIdx / 64;
                    uint32 l64 = byteIdx % 64;
                    int64 ro2 = (int64) (i0 + ii) * rowBytes + b * 210L;
                    int32 qlb = (int32) packed[ro2 + (int64) byteIdx] & 255;
                    int32 qhb = (int32) packed[ro2 + 128L
                        + (int64) (32 * h) + (int64) (l64 % 32)] & 255;
                    uint32 sh = 2 * (l64 / 32);
                    int32 vLo = ((qlb & 15)
                        | (((qhb >> sh) & 3) << 4)) - 32;
                    int32 vHi = (((qlb >> 4) & 15)
                        | (((qhb >> (sh + 4)) & 3) << 4)) - 32;
                    uint32 kLo = 128 * h + l64;
                    bt[ii * 256 + kLo] = (int8) vLo;
                    bt[ii * 256 + kLo + 64] = (int8) vHi;
                    w6 = w6 + 32;
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 16) {
                    if (lane < 16) {
                        rowFj[lane] = dLds[lane]
                            * (float32) scLds[lane * 16 + j];
                    }
                    Barrier.workgroup();
                    mc.splat(0);
                    uint32 kBase = 16 * j;
                    int64 aOff = (int64) t0 * xRowBytes + b * 320L
                        + (int64) kBase;
                    ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                    mb.load(bt, kBase, 1, 256);
                    mc.mma(ma, mb);
                    mc.scaledAccumInto(facc, xsLds, rowFj);
                    Barrier.workgroup();
                    j = j + 1;
                }
                b = b + 1;
            }

            facc.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    public static void q6kWmmaEpiLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q6kWmmaEpiKernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        // NoSync (10.12.24): the stream is in-order and every consumer
        // is either another launch or a download behind an explicit
        // sync. The per-launch sync was ~250 GPU-host round trips per
        // prefill.
        return;
    }

    /**
     * REGISTER-TILED T=2 deq GEMM (10.12.21): one wave computes TWO
     * 16-token tiles of the same output-tile column, so every B
     * fragment is loaded ONCE and mma'd twice — B traffic and the
     * per-j fold/epilogue overhead halve per token. No LDS growth
     * (10.12.15's occupancy refutation targeted LDS-staged widening;
     * the deq feed has none), grid halves in the token dimension, and
     * the register cost is one extra int32 + one extra f32 accumulator
     * fragment (16 VGPRs/lane).
     *
     * Requires `rows % 32 == 0`; the launcher checks and the route
     * falls back to the T1 kernel otherwise.
     */
    @Kernel
    public static void q4kWmmaDeqT2Kernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN, int64 blocksPerRow) {
        Shared<int32> scLds = shared int32[128];
        Shared<int32> mnLds = shared int32[128];
        Shared<float32> dLds = shared float32[16];
        Shared<float32> dmLds = shared float32[16];
        Shared<float32> xsA = shared float32[16];
        Shared<float32> xsB = shared float32[16];
        Shared<int32> psA = shared int32[128];
        Shared<int32> psB = shared int32[128];
        Shared<float32> rowFj = shared float32[16];
        Shared<float32> rowGj = shared float32[16];
        Shared<float32> colGjA = shared float32[16];
        Shared<float32> colGjB = shared float32[16];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 t0 = tileT * 32;
        uint32 i0 = tileI * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;

            CooperativeMatrix<int8,16,16,0> ma0;
            CooperativeMatrix<int8,16,16,0> ma1;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc0;
            CooperativeMatrix<int32,16,16,2> mc1;
            CooperativeMatrix<float32,16,16,2> facc0;
            CooperativeMatrix<float32,16,16,2> facc1;
            facc0.splat(0.0f);
            facc1.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                if (lane < 16) {
                    int64 ro = (int64) (i0 + lane) * rowBytes + b * 144L;
                    dLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro] & 255)
                        | (((int32) packed[ro + 1L] & 255) << 8));
                    dmLds[lane] = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 2L] & 255)
                        | (((int32) packed[ro + 3L] & 255) << 8));
                    int32 q = 0;
                    while (q < 4) {
                        int32 dq = (int32) packed[ro + 4L + (int64) q] & 255;
                        int32 mq = (int32) packed[ro + 8L + (int64) q] & 255;
                        int32 kq = (int32) packed[ro + 12L + (int64) q] & 255;
                        scLds[lane * 8 + q] = dq & 63;
                        scLds[lane * 8 + 4 + q] =
                            (kq & 15) | ((dq >> 2) & 48);
                        mnLds[lane * 8 + q] = mq & 63;
                        mnLds[lane * 8 + 4 + q] =
                            (kq >> 4) | ((mq >> 2) & 48);
                        q = q + 1;
                    }
                } else {
                    // Two tokens per lane: tk and tk+16.
                    uint32 tk = lane - 16;
                    int64 xbA = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    int64 xbB = (int64) (t0 + tk + 16) * xRowBytes
                        + b * 320L;
                    xsA[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xbA + 288L] & 255)
                        | (((int32) xp[xbA + 289L] & 255) << 8)
                        | (((int32) xp[xbA + 290L] & 255) << 16)
                        | (((int32) xp[xbA + 291L] & 255) << 24));
                    xsB[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xbB + 288L] & 255)
                        | (((int32) xp[xbB + 289L] & 255) << 8)
                        | (((int32) xp[xbB + 290L] & 255) << 16)
                        | (((int32) xp[xbB + 291L] & 255) << 24));
                    int32 sbi = 0;
                    while (sbi < 8) {
                        int64 atA = xbA + 256L + (int64) (sbi * 4);
                        int64 atB = xbB + 256L + (int64) (sbi * 4);
                        psA[tk * 8 + sbi] = ((int32) xp[atA] & 255)
                            | (((int32) xp[atA + 1L] & 255) << 8)
                            | (((int32) xp[atA + 2L] & 255) << 16)
                            | (((int32) xp[atA + 3L]) << 24);
                        psB[tk * 8 + sbi] = ((int32) xp[atB] & 255)
                            | (((int32) xp[atB + 1L] & 255) << 8)
                            | (((int32) xp[atB + 2L] & 255) << 16)
                            | (((int32) xp[atB + 3L]) << 24);
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    if (lane < 16) {
                        rowFj[lane] = dLds[lane]
                            * (float32) scLds[lane * 8 + j];
                        rowGj[lane] = 0.0f - dmLds[lane]
                            * (float32) mnLds[lane * 8 + j];
                        colGjA[lane] = xsA[lane]
                            * (float32) psA[lane * 8 + j];
                        colGjB[lane] = xsB[lane]
                            * (float32) psB[lane * 8 + j];
                    }
                    Barrier.workgroup();
                    mc0.splat(0);
                    mc1.splat(0);
                    uint32 half = 0;
                    while (half < 2) {
                        uint32 kBase = 32 * j + 16 * half;
                        int64 kAbs = b * 256L + (int64) kBase;
                        int64 bOff = ((int64) (i0 / 16)
                            * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                        mb.load(deq, (uint32) bOff, 1, 16);
                        int64 aOffA = (int64) t0 * xRowBytes + b * 320L
                            + (int64) kBase;
                        int64 aOffB = (int64) (t0 + 16) * xRowBytes
                            + b * 320L + (int64) kBase;
                        ma0.load(xp, (uint32) aOffA, 0, (uint32) xRowBytes);
                        ma1.load(xp, (uint32) aOffB, 0, (uint32) xRowBytes);
                        mc0.mma(ma0, mb);
                        mc1.mma(ma1, mb);
                        half = half + 1;
                    }
                    mc0.scaledAccumInto(facc0, xsA, rowFj);
                    mc1.scaledAccumInto(facc1, xsB, rowFj);
                    facc0.rank1Accum(colGjA, rowGj);
                    facc1.rank1Accum(colGjB, rowGj);
                    Barrier.workgroup();
                    j = j + 1;
                }
                b = b + 1;
            }

            facc0.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
            facc1.store(y, (uint32) ((int64) (t0 + 16) * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    /**
     * N=4 OUTPUT-TILED deq GEMM (10.12.21 second iteration) — the
     * counter pass's answer. The memory unit sits at 92% busy on
     * REDUNDANT traffic: with one output tile per wave, every A
     * fragment is re-read once per output-tile column (up to 896x per
     * projection) and L2 holds only 27% of it. Here one wave computes
     * FOUR adjacent output tiles of the same token tile: the A
     * fragments are loaded ONCE per K-slice (two wide loads) and mma'd
     * against four B tiles — A traffic and A load ops divide by four,
     * the dominant term T2 never touched. Seam and B stay per-tile
     * (the spill seam is the measured Q4_K champion). Requires
     * `outDim % 64 == 0` — true for every Q4_K projection of the 8B.
     */
    @Kernel
    public static void q4kWmmaDeqN4Kernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN4, int64 blocksPerRow) {
        Shared<int32> ct = shared int32[256];
        Shared<float32> acc = shared float32[1024];
        Shared<int32> scLds = shared int32[512];   // [64 rows][8 subs]
        Shared<int32> mnLds = shared int32[512];
        Shared<float32> dLds = shared float32[64];
        Shared<float32> dmLds = shared float32[64];
        Shared<float32> xsLds = shared float32[16];
        Shared<int32> psLds = shared int32[128];

        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tileT = wg / tilesN4;
        uint32 tileI = wg % tilesN4;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI * 64;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;

            uint32 z = lane;
            while (z < 1024) { acc[z] = 0.0f; z = z + 32; }
            Barrier.workgroup();

            CooperativeMatrix<int8,16,16,0> ma0;
            CooperativeMatrix<int8,16,16,0> ma1;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;

            int64 b = 0;
            while (b < blocksPerRow) {
                // Header decode for all 64 output rows: 16 lanes x 4.
                if (lane < 16) {
                    uint32 r4 = 0;
                    while (r4 < 4) {
                        uint32 rr = r4 * 16 + lane;
                        int64 ro = (int64) (i0 + rr) * rowBytes
                            + b * 144L;
                        dLds[rr] = GgufFile.halfBitsToF32(
                            ((int32) packed[ro] & 255)
                            | (((int32) packed[ro + 1L] & 255) << 8));
                        dmLds[rr] = GgufFile.halfBitsToF32(
                            ((int32) packed[ro + 2L] & 255)
                            | (((int32) packed[ro + 3L] & 255) << 8));
                        int32 q = 0;
                        while (q < 4) {
                            int32 dq = (int32) packed[ro + 4L
                                + (int64) q] & 255;
                            int32 mq = (int32) packed[ro + 8L
                                + (int64) q] & 255;
                            int32 kq = (int32) packed[ro + 12L
                                + (int64) q] & 255;
                            scLds[rr * 8 + q] = dq & 63;
                            scLds[rr * 8 + 4 + q] =
                                (kq & 15) | ((dq >> 2) & 48);
                            mnLds[rr * 8 + q] = mq & 63;
                            mnLds[rr * 8 + 4 + q] =
                                (kq >> 4) | ((mq >> 2) & 48);
                            q = q + 1;
                        }
                        r4 = r4 + 1;
                    }
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + tk) * xRowBytes + b * 320L;
                    xsLds[tk] = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    int32 sbi = 0;
                    while (sbi < 8) {
                        int64 at = xb + 256L + (int64) (sbi * 4);
                        psLds[tk * 8 + sbi] = ((int32) xp[at] & 255)
                            | (((int32) xp[at + 1L] & 255) << 8)
                            | (((int32) xp[at + 2L] & 255) << 16)
                            | (((int32) xp[at + 3L]) << 24);
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    // A ONCE per K-slice, both halves, held in
                    // registers across the four output tiles.
                    int64 aOff0 = (int64) t0 * xRowBytes + b * 320L
                        + (int64) (32 * j);
                    ma0.load(xp, (uint32) aOff0, 0, (uint32) xRowBytes);
                    ma1.load(xp, (uint32) (aOff0 + 16L), 0,
                        (uint32) xRowBytes);
                    uint32 t = 0;
                    while (t < 4) {
                        mc.splat(0);
                        int64 kAbs0 = b * 256L + (int64) (32 * j);
                        int64 bOff0 = ((int64) ((i0 + 16 * t) / 16)
                            * (blocksPerRow * 16L) + kAbs0 / 16L)
                            * 256L;
                        mb.load(deq, (uint32) bOff0, 1, 16);
                        mc.mma(ma0, mb);
                        mb.load(deq, (uint32) (bOff0 + 256L), 1, 16);
                        mc.mma(ma1, mb);
                        mc.store(ct, 0, 0, 16);
                        Barrier.workgroup();
                        uint32 p = lane;
                        while (p < 256) {
                            uint32 tt = p / 16;
                            uint32 ii = p % 16;
                            acc[t * 256 + p] = acc[t * 256 + p]
                                + dLds[t * 16 + ii] * xsLds[tt]
                                * (float32) (scLds[(t * 16 + ii) * 8
                                    + j] * ct[p]);
                            p = p + 32;
                        }
                        Barrier.workgroup();
                        t = t + 1;
                    }
                    j = j + 1;
                }

                // dmin correction, per tile.
                uint32 p2 = lane;
                while (p2 < 1024) {
                    uint32 t2 = p2 / 256;
                    uint32 pp = p2 % 256;
                    uint32 tt = pp / 16;
                    uint32 ii = t2 * 16 + pp % 16;
                    int32 dm = 0;
                    uint32 sj = 0;
                    while (sj < 8) {
                        dm = dm + mnLds[ii * 8 + sj]
                            * psLds[tt * 8 + sj];
                        sj = sj + 1;
                    }
                    acc[p2] = acc[p2]
                        - dmLds[ii] * xsLds[tt] * (float32) dm;
                    p2 = p2 + 32;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            uint32 w = lane;
            while (w < 1024) {
                uint32 t3 = w / 256;
                uint32 pp = w % 256;
                uint32 tt = pp / 16;
                uint32 ii = pp % 16;
                y[(int64) (t0 + tt) * (int64) outDim
                    + (int64) (i0 + t3 * 16 + ii)] = acc[w];
                w = w + 32;
            }
        }
    }

    /**
     * THE MULTI-WAVE deq GEMM (10.12.21 FINAL) — all three levers the
     * six single-lever probes showed only pay TOGETHER:
     *
     * 1. EIGHT WAVES PER WORKGROUP, each its own 16-col output tile
     *    (same total wave count as the champion — concurrency
     *    preserved, unlike N4), sharing only the token-side xs/ps
     *    staging. LDS ~1.8 KB per WG (was 3.8 KB per WAVE): the
     *    occupancy cap lifts entirely.
     * 2. REGISTER EPILOGUE via the DUAL verb: the weight-side header
     *    (d, dmin, 8 scales, 8 mins) is decoded into PER-LANE
     *    REGISTERS straight from global — no scale LDS, no header
     *    barriers — and the dmin term rides the same accumulator
     *    visit (`scaledAccumInto2`), so the separate ranked pass is
     *    gone. ~55 issue slots per mma pair where the spill seam paid
     *    ~150.
     * 3. BARRIER-FREE K-LOOP: the only barriers are the two around
     *    the once-per-block token staging, so the scheduler is free
     *    to pipeline the wide A/B loads across j iterations.
     */
    @Kernel
    public static void q4kWmmaDeqMwKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN8, int64 blocksPerRow) {
        Shared<float32> xsLds = shared float32[16];
        Shared<int32> psLds = shared int32[128];
        // Per-wave scale vectors: the verb resolves its Shared args at
        // the array BASE, so each wave gets its own set, selected by a
        // wave-uniform branch. rg (xs*ps_j) is VALUE-identical across
        // waves but must still be PER-WAVE: the j-loop is barrier-free,
        // waves drift, and a shared rg let wave 0's j=5 overwrite what
        // wave 1's j=3 was reading — caught by the outDim=128 test at
        // exactly the first element of wave 1's tile.
        Shared<float32> rg0 = shared float32[16];
        Shared<float32> rg1 = shared float32[16];
        Shared<float32> rg2 = shared float32[16];
        Shared<float32> rg3 = shared float32[16];
        Shared<float32> rg4 = shared float32[16];
        Shared<float32> rg5 = shared float32[16];
        Shared<float32> rg6 = shared float32[16];
        Shared<float32> rg7 = shared float32[16];
        Shared<float32> cf0 = shared float32[16];
        Shared<float32> cf1 = shared float32[16];
        Shared<float32> cf2 = shared float32[16];
        Shared<float32> cf3 = shared float32[16];
        Shared<float32> cf4 = shared float32[16];
        Shared<float32> cf5 = shared float32[16];
        Shared<float32> cf6 = shared float32[16];
        Shared<float32> cf7 = shared float32[16];
        Shared<float32> cg0 = shared float32[16];
        Shared<float32> cg1 = shared float32[16];
        Shared<float32> cg2 = shared float32[16];
        Shared<float32> cg3 = shared float32[16];
        Shared<float32> cg4 = shared float32[16];
        Shared<float32> cg5 = shared float32[16];
        Shared<float32> cg6 = shared float32[16];
        Shared<float32> cg7 = shared float32[16];

        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wid = tid / 32;
        uint32 lane16 = lane % 16;
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 tileT = wg / tilesN8;
        uint32 tileI8 = wg % tilesN8;
        uint32 t0 = tileT * 16;
        uint32 i0 = tileI8 * 128 + wid * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 myRo = (int64) (i0 + lane16) * rowBytes;

            CooperativeMatrix<int8,16,16,0> ma0;
            CooperativeMatrix<int8,16,16,0> ma1;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc;
            CooperativeMatrix<float32,16,16,2> facc;
            facc.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                // Token staging: wave 0 only, the block's two barriers.
                if (wid == 0) {
                    if (lane < 16) {
                        int64 xb = (int64) (t0 + lane) * xRowBytes
                            + b * 320L;
                        xsLds[lane] = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                    } else {
                        uint32 tk = lane - 16;
                        int64 xb = (int64) (t0 + tk) * xRowBytes
                            + b * 320L;
                        int32 sbi = 0;
                        while (sbi < 8) {
                            int64 at = xb + 256L + (int64) (sbi * 4);
                            psLds[tk * 8 + sbi] = ((int32) xp[at] & 255)
                                | (((int32) xp[at + 1L] & 255) << 8)
                                | (((int32) xp[at + 2L] & 255) << 16)
                                | (((int32) xp[at + 3L]) << 24);
                            sbi = sbi + 1;
                        }
                    }
                }
                Barrier.workgroup();

                // Weight-side header: PER-LANE REGISTERS from global.
                // Both half-lanes of a column decode the same row.
                int64 ro = myRo + b * 144L;
                float32 dv = GgufFile.halfBitsToF32(
                    ((int32) packed[ro] & 255)
                    | (((int32) packed[ro + 1L] & 255) << 8));
                float32 dmv = GgufFile.halfBitsToF32(
                    ((int32) packed[ro + 2L] & 255)
                    | (((int32) packed[ro + 3L] & 255) << 8));
                int32 d0 = (int32) packed[ro + 4L] & 255;
                int32 d1 = (int32) packed[ro + 5L] & 255;
                int32 d2 = (int32) packed[ro + 6L] & 255;
                int32 d3 = (int32) packed[ro + 7L] & 255;
                int32 m0 = (int32) packed[ro + 8L] & 255;
                int32 m1 = (int32) packed[ro + 9L] & 255;
                int32 m2 = (int32) packed[ro + 10L] & 255;
                int32 m3 = (int32) packed[ro + 11L] & 255;
                int32 k0 = (int32) packed[ro + 12L] & 255;
                int32 k1 = (int32) packed[ro + 13L] & 255;
                int32 k2 = (int32) packed[ro + 14L] & 255;
                int32 k3 = (int32) packed[ro + 15L] & 255;
                int32 s0 = d0 & 63;
                int32 s1 = d1 & 63;
                int32 s2 = d2 & 63;
                int32 s3 = d3 & 63;
                int32 s4 = (k0 & 15) | ((d0 >> 2) & 48);
                int32 s5 = (k1 & 15) | ((d1 >> 2) & 48);
                int32 s6 = (k2 & 15) | ((d2 >> 2) & 48);
                int32 s7 = (k3 & 15) | ((d3 >> 2) & 48);
                int32 n0 = m0 & 63;
                int32 n1 = m1 & 63;
                int32 n2 = m2 & 63;
                int32 n3 = m3 & 63;
                int32 n4 = (k0 >> 4) | ((m0 >> 2) & 48);
                int32 n5 = (k1 >> 4) | ((m1 >> 2) & 48);
                int32 n6 = (k2 >> 4) | ((m2 >> 2) & 48);
                int32 n7 = (k3 >> 4) | ((m3 >> 2) & 48);

                uint32 j = 0;
                while (j < 8) {
                    int32 scj = s0;
                    int32 mnj = n0;
                    if (j == 1) { scj = s1; mnj = n1; }
                    else if (j == 2) { scj = s2; mnj = n2; }
                    else if (j == 3) { scj = s3; mnj = n3; }
                    else if (j == 4) { scj = s4; mnj = n4; }
                    else if (j == 5) { scj = s5; mnj = n5; }
                    else if (j == 6) { scj = s6; mnj = n6; }
                    else if (j == 7) { scj = s7; mnj = n7; }
                    float32 cfv = dv * (float32) scj;
                    float32 cgv = 0.0f - dmv * (float32) mnj;
                    float32 rgv = 0.0f;
                    if (lane < 16) {
                        rgv = xsLds[lane]
                            * (float32) psLds[lane * 8 + j];
                    }
                    mc.splat(0);
                    uint32 kBase = 32 * j;
                    int64 aOff = (int64) t0 * xRowBytes + b * 320L
                        + (int64) kBase;
                    ma0.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                    ma1.load(xp, (uint32) (aOff + 16L), 0,
                        (uint32) xRowBytes);
                    int64 kAbs = b * 256L + (int64) kBase;
                    int64 bOff = ((int64) (i0 / 16)
                        * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                    mb.load(deq, (uint32) bOff, 1, 16);
                    mc.mma(ma0, mb);
                    mb.load(deq, (uint32) (bOff + 256L), 1, 16);
                    mc.mma(ma1, mb);
                    // Wave-uniform 8-way select of this wave's pair.
                    if (wid == 0) {
                        if (lane < 16) {
                            cf0[lane] = cfv; cg0[lane] = cgv;
                            rg0[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf0, rg0, cg0);
                    } else if (wid == 1) {
                        if (lane < 16) {
                            cf1[lane] = cfv; cg1[lane] = cgv;
                            rg1[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf1, rg1, cg1);
                    } else if (wid == 2) {
                        if (lane < 16) {
                            cf2[lane] = cfv; cg2[lane] = cgv;
                            rg2[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf2, rg2, cg2);
                    } else if (wid == 3) {
                        if (lane < 16) {
                            cf3[lane] = cfv; cg3[lane] = cgv;
                            rg3[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf3, rg3, cg3);
                    } else if (wid == 4) {
                        if (lane < 16) {
                            cf4[lane] = cfv; cg4[lane] = cgv;
                            rg4[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf4, rg4, cg4);
                    } else if (wid == 5) {
                        if (lane < 16) {
                            cf5[lane] = cfv; cg5[lane] = cgv;
                            rg5[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf5, rg5, cg5);
                    } else if (wid == 6) {
                        if (lane < 16) {
                            cf6[lane] = cfv; cg6[lane] = cgv;
                            rg6[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf6, rg6, cg6);
                    } else {
                        if (lane < 16) {
                            cf7[lane] = cfv; cg7[lane] = cgv;
                            rg7[lane] = rgv;
                        }
                        mc.scaledAccumInto2(facc, xsLds, cf7, rg7, cg7);
                    }
                    j = j + 1;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            facc.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    /** True when the multi-wave tiling applies. */
    public static boolean fitsMw(int64 rows, int64 outDim) {
        return rows % 16L == 0L && outDim % 128L == 0L;
    }

    public static void q4kWmmaDeqMwLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN8 = outDim / 128L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqMwKernel.launch(s, grid: [(uint32) (tilesM * tilesN8)],
            block: [256])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN8, cols / 256L);
        return;
    }

    /** Batch kernel vs the multi-wave deq kernel — the test harness. */
    public static void compareMwInto(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        KernelStream s = QuantKernel.stream();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(want, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q4kWmmaDeqMwLaunch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /**
     * 10.12.21 token blocking — the Mw kernel with FOUR token-tiles
     * per workgroup (64 tokens x 128 rows). The kernel-stats profile
     * on the 3-lever Mw kernel measured 1097 ms at ~155 GB/s: the
     * MEMORY WALL, because every 16-token tile re-reads the entire
     * dequantized weight matrix — 32 full re-reads at ctx512, ~163 GB
     * of weight traffic per prefill. Issue economy was never the
     * binding constraint (cutting ~150 issues/pair to ~55 bought 5%);
     * arithmetic intensity is. This is llama.cpp's `mmq_x` lever.
     *
     * Each weight fragment (mb) is loaded ONCE and consumed by four
     * mmas — one per token-tile — into four int32 accumulators, so
     * weight traffic drops 4x while activation traffic (the small
     * side, and MALL-resident at 2.6 MB per call) grows not at all.
     * The register epilogue runs per tile against per-tile token
     * vectors (xs, rg) and shared per-wave row vectors (cf, cg); rg
     * stays per-wave AND per-tile — the j-loop is still barrier-free,
     * so waves drift (the shared-rg lesson from the Mw kernel).
     */
    @Kernel
    public static void q4kWmmaDeqMw4Kernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN8, int64 blocksPerRow) {
        Shared<float32> xsA = shared float32[16];
        Shared<float32> xsB = shared float32[16];
        Shared<float32> xsC = shared float32[16];
        Shared<float32> xsD = shared float32[16];
        // 10.12.33: ps and the per-wave rg arrays are GONE — see
        // the Mw8 kernel; rgAll[(tile * 8 + j) * 16 + token], four
        // tiles here.
        Shared<float32> rgAll = shared float32[512];

        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wid = tid / 32;
        uint32 lane16 = lane % 16;
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 tileT = wg / tilesN8;
        uint32 tileI8 = wg % tilesN8;
        uint32 t0 = tileT * 64;
        uint32 i0 = tileI8 * 128 + wid * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 myRo = (int64) (i0 + lane16) * rowBytes;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc0;
            CooperativeMatrix<int32,16,16,2> mc1;
            CooperativeMatrix<int32,16,16,2> mc2;
            CooperativeMatrix<int32,16,16,2> mc3;
            CooperativeMatrix<float32,16,16,2> facc0;
            CooperativeMatrix<float32,16,16,2> facc1;
            CooperativeMatrix<float32,16,16,2> facc2;
            CooperativeMatrix<float32,16,16,2> facc3;
            facc0.splat(0.0f);
            facc1.splat(0.0f);
            facc2.splat(0.0f);
            facc3.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                // Token staging: waves 0-3 each stage one token-tile
                // (wave w -> tokens t0+16w..t0+16w+15) — the block's
                // two barriers, same as Mw.
                if (wid == 0) {
                    if (lane < 16) {
                        int64 xb = (int64) (t0 + lane) * xRowBytes
                            + b * 320L;
                        xsA[lane] = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                    } else {
                        uint32 tk = lane - 16;
                        int64 xb = (int64) (t0 + tk) * xRowBytes
                            + b * 320L;
                        float32 xv = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                        uint32 sbi = 0;
                        while (sbi < 8) {
                            int64 at = xb + 256L + (int64) (sbi * 4);
                            rgAll[(0 * 8 + sbi) * 16 + tk] = xv * (float32) ( ((int32) xp[at] & 255)
                                | (((int32) xp[at + 1L] & 255) << 8)
                                | (((int32) xp[at + 2L] & 255) << 16)
                                | (((int32) xp[at + 3L]) << 24));
                            sbi = sbi + 1;
                        }
                    }
                } else if (wid == 1) {
                    if (lane < 16) {
                        int64 xb = (int64) (t0 + 16 + lane) * xRowBytes
                            + b * 320L;
                        xsB[lane] = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                    } else {
                        uint32 tk = lane - 16;
                        int64 xb = (int64) (t0 + 16 + tk) * xRowBytes
                            + b * 320L;
                        float32 xv = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                        uint32 sbi = 0;
                        while (sbi < 8) {
                            int64 at = xb + 256L + (int64) (sbi * 4);
                            rgAll[(1 * 8 + sbi) * 16 + tk] = xv * (float32) (
                                ((int32) xp[at] & 255)
                                | (((int32) xp[at + 1L] & 255) << 8)
                                | (((int32) xp[at + 2L] & 255) << 16)
                                | (((int32) xp[at + 3L]) << 24));
                            sbi = sbi + 1;
                        }
                    }
                } else if (wid == 2) {
                    if (lane < 16) {
                        int64 xb = (int64) (t0 + 32 + lane) * xRowBytes
                            + b * 320L;
                        xsC[lane] = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                    } else {
                        uint32 tk = lane - 16;
                        int64 xb = (int64) (t0 + 32 + tk) * xRowBytes
                            + b * 320L;
                        float32 xv = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                        uint32 sbi = 0;
                        while (sbi < 8) {
                            int64 at = xb + 256L + (int64) (sbi * 4);
                            rgAll[(2 * 8 + sbi) * 16 + tk] = xv * (float32) (
                                ((int32) xp[at] & 255)
                                | (((int32) xp[at + 1L] & 255) << 8)
                                | (((int32) xp[at + 2L] & 255) << 16)
                                | (((int32) xp[at + 3L]) << 24));
                            sbi = sbi + 1;
                        }
                    }
                } else if (wid == 3) {
                    if (lane < 16) {
                        int64 xb = (int64) (t0 + 48 + lane) * xRowBytes
                            + b * 320L;
                        xsD[lane] = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                    } else {
                        uint32 tk = lane - 16;
                        int64 xb = (int64) (t0 + 48 + tk) * xRowBytes
                            + b * 320L;
                        float32 xv = Cajeta.bitsToF32(
                            ((int32) xp[xb + 288L] & 255)
                            | (((int32) xp[xb + 289L] & 255) << 8)
                            | (((int32) xp[xb + 290L] & 255) << 16)
                            | (((int32) xp[xb + 291L] & 255) << 24));
                        uint32 sbi = 0;
                        while (sbi < 8) {
                            int64 at = xb + 256L + (int64) (sbi * 4);
                            rgAll[(3 * 8 + sbi) * 16 + tk] = xv * (float32) (
                                ((int32) xp[at] & 255)
                                | (((int32) xp[at + 1L] & 255) << 8)
                                | (((int32) xp[at + 2L] & 255) << 16)
                                | (((int32) xp[at + 3L]) << 24));
                            sbi = sbi + 1;
                        }
                    }
                }
                Barrier.workgroup();

                // Weight-side header: per-lane registers (as Mw).
                int64 ro = myRo + b * 144L;
                float32 dv = GgufFile.halfBitsToF32(
                    ((int32) packed[ro] & 255)
                    | (((int32) packed[ro + 1L] & 255) << 8));
                float32 dmv = GgufFile.halfBitsToF32(
                    ((int32) packed[ro + 2L] & 255)
                    | (((int32) packed[ro + 3L] & 255) << 8));
                int32 d0 = (int32) packed[ro + 4L] & 255;
                int32 d1 = (int32) packed[ro + 5L] & 255;
                int32 d2 = (int32) packed[ro + 6L] & 255;
                int32 d3 = (int32) packed[ro + 7L] & 255;
                int32 m0 = (int32) packed[ro + 8L] & 255;
                int32 m1 = (int32) packed[ro + 9L] & 255;
                int32 m2 = (int32) packed[ro + 10L] & 255;
                int32 m3 = (int32) packed[ro + 11L] & 255;
                int32 k0 = (int32) packed[ro + 12L] & 255;
                int32 k1 = (int32) packed[ro + 13L] & 255;
                int32 k2 = (int32) packed[ro + 14L] & 255;
                int32 k3 = (int32) packed[ro + 15L] & 255;
                int32 s0 = d0 & 63;
                int32 s1 = d1 & 63;
                int32 s2 = d2 & 63;
                int32 s3 = d3 & 63;
                int32 s4 = (k0 & 15) | ((d0 >> 2) & 48);
                int32 s5 = (k1 & 15) | ((d1 >> 2) & 48);
                int32 s6 = (k2 & 15) | ((d2 >> 2) & 48);
                int32 s7 = (k3 & 15) | ((d3 >> 2) & 48);
                int32 n0 = m0 & 63;
                int32 n1 = m1 & 63;
                int32 n2 = m2 & 63;
                int32 n3 = m3 & 63;
                int32 n4 = (k0 >> 4) | ((m0 >> 2) & 48);
                int32 n5 = (k1 >> 4) | ((m1 >> 2) & 48);
                int32 n6 = (k2 >> 4) | ((m2 >> 2) & 48);
                int32 n7 = (k3 >> 4) | ((m3 >> 2) & 48);

                uint32 j = 0;
                while (j < 8) {
                    int32 scj = s0;
                    int32 mnj = n0;
                    if (j == 1) { scj = s1; mnj = n1; }
                    else if (j == 2) { scj = s2; mnj = n2; }
                    else if (j == 3) { scj = s3; mnj = n3; }
                    else if (j == 4) { scj = s4; mnj = n4; }
                    else if (j == 5) { scj = s5; mnj = n5; }
                    else if (j == 6) { scj = s6; mnj = n6; }
                    else if (j == 7) { scj = s7; mnj = n7; }
                    float32 cfv = dv * (float32) scj;
                    float32 cgv = 0.0f - dmv * (float32) mnj;
                    mc0.splat(0);
                    mc1.splat(0);
                    mc2.splat(0);
                    mc3.splat(0);
                    uint32 kBase = 32 * j;
                    int64 aOff = (int64) t0 * xRowBytes + b * 320L
                        + (int64) kBase;
                    int64 kAbs = b * 256L + (int64) kBase;
                    int64 bOff = ((int64) (i0 / 16)
                        * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                    // Half 0: ONE weight fragment, four mmas.
                    mb.load(deq, (uint32) bOff, 1, 16);
                    ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                    mc0.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 16L), 0,
                        (uint32) xRowBytes);
                    mc1.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 32L), 0,
                        (uint32) xRowBytes);
                    mc2.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 48L), 0,
                        (uint32) xRowBytes);
                    mc3.mma(ma, mb);
                    // Half 1.
                    mb.load(deq, (uint32) (bOff + 256L), 1, 16);
                    ma.load(xp, (uint32) (aOff + 16L), 0,
                        (uint32) xRowBytes);
                    mc0.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 16L + 16L),
                        0, (uint32) xRowBytes);
                    mc1.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 32L + 16L),
                        0, (uint32) xRowBytes);
                    mc2.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 48L + 16L),
                        0, (uint32) xRowBytes);
                    mc3.mma(ma, mb);
                    // 10.12.33: straight-line — rg comes from the
                    // block-precomputed rgAll via verb slices; no
                    // branch, no per-wave copies (rgAll is read-only
                    // in the j-loop, so drift cannot touch it).
                    mc0.scaledAccumInto2S(facc0, xsA, cfv,
                        rgAll[j * 16], cgv);
                    mc1.scaledAccumInto2S(facc1, xsB, cfv,
                        rgAll[(8 + j) * 16], cgv);
                    mc2.scaledAccumInto2S(facc2, xsC, cfv,
                        rgAll[(16 + j) * 16], cgv);
                    mc3.scaledAccumInto2S(facc3, xsD, cfv,
                        rgAll[(24 + j) * 16], cgv);
                    j = j + 1;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            facc0.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
            facc1.store(y, (uint32) ((int64) (t0 + 16) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc2.store(y, (uint32) ((int64) (t0 + 32) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc3.store(y, (uint32) ((int64) (t0 + 48) * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    /** True when the 4-token-tile multi-wave tiling applies. */
    public static boolean fitsMw4(int64 rows, int64 outDim) {
        return rows % 64L == 0L && outDim % 128L == 0L;
    }

    public static void q4kWmmaDeqMw4Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM4 = rows / 64L;
        int64 tilesN8 = outDim / 128L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqMw4Kernel.launch(s,
            grid: [(uint32) (tilesM4 * tilesN8)], block: [256])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN8, cols / 256L);
        return;
    }

    /** Batch kernel vs the token-blocked Mw4 deq kernel — harness. */
    public static void compareMw4Into(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        KernelStream s = QuantKernel.stream();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(want, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q4kWmmaDeqMw4Launch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /**
     * 10.12.28 — T=8 token blocking: EIGHT token-tiles per workgroup
     * (128 tok x 128 rows), weight traffic /8. SPECULATIVE by its own
     * plan entry: Mw4 already runs UNDER the memory wall (~84 GB/s
     * implied), so the traffic this cuts may no longer be binding —
     * but eight mma pairs per weight fragment also multiply the ILP
     * available to hide VMEM latency, which is the CURRENT limiter
     * hypothesis. Measured either way.
     *
     * Register economy vs Mw4: BOTH weight halves stay resident
     * (mbA/mbB), the four int32 accumulators are REUSED across two
     * 4-tile chunks (epilogue drains them between chunks), and the
     * per-wave rg arrays are reused too — within one wave the chunk-0
     * verb calls complete before chunk 1 rewrites them, so no drift
     * hazard is introduced. cf/cg are written once per j: both chunks
     * see the same weight sub-block. Eight persistent float
     * accumulators (~64 VGPRs) are the price.
     */
    // 10.12.42 NOTE: @Occupancy(minResident = 8) was MEASURED here and
    // REFUTED: the VGPR cap engaged (256 -> 192, so the attr is not
    // inert on gfx1151) but occupancy stayed ~20% — the limiter is the
    // partitioned launch's WG supply, not registers — and the extra
    // spill (124 -> 212 B/lane) cost ~190 ms. Do not re-add without a
    // wider partition to feed the freed slots.
    @Kernel @FastMath
    public static void q4kWmmaDeqMw8Kernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN8, int64 blocksPerRow, uint32 rowBase) {
        Shared<float32> xsA = shared float32[16];
        Shared<float32> xsB = shared float32[16];
        Shared<float32> xsC = shared float32[16];
        Shared<float32> xsD = shared float32[16];
        Shared<float32> xsE = shared float32[16];
        Shared<float32> xsF = shared float32[16];
        Shared<float32> xsG = shared float32[16];
        Shared<float32> xsH = shared float32[16];
        // 10.12.33: ps and the per-wave rg arrays are GONE. The rg
        // vectors (xs * ps_j) are PRECOMPUTED once per block at
        // staging time, behind the block's barriers, into one array
        // indexed rgAll[(tile * 8 + j) * 16 + token]: read-only in
        // the j-loop (drift cannot touch it), sliced per (tile, j)
        // by the verb.
        Shared<float32> rgAll = shared float32[1024];
        // 10.12.42: cf/cg pre-folded per (row-in-WG, j) at block
        // staging — d*sc and -dmin*mn land in LDS ONCE per block, so
        // the j-loop reads two scalars instead of holding the 24-
        // register header decode + select chain across all 8 j
        // (llama.cpp's (d*sc,-d*m)-at-tile-load shape). Indexed
        // [(wid*16 + lane16) * 8 + j].
        Shared<float32> cfAll = shared float32[1024];
        Shared<float32> cgAll = shared float32[1024];

        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wid = tid / 32;
        uint32 lane16 = lane % 16;
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 tileT = wg / tilesN8;
        uint32 tileI8 = wg % tilesN8;
        uint32 t0 = tileT * 128;
        // 10.12.34: rowBase slides the workgroup's output window — the
        // partitioned launch covers a big matrix in ~32-WG slices
        // (the grid-sweep's occupancy sweet spot) sharing ALL buffers.
        uint32 i0 = rowBase + tileI8 * 128 + wid * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 myRo = (int64) (i0 + lane16) * rowBytes;

            CooperativeMatrix<int8,16,16,0> ma;
            // 10.12.42: ONE weight fragment, single-buffered — each
            // K-half is loaded, used by four mmas, and overwritten.
            // Halves the weight-fragment live range (the retile's
            // register diet); the int32 accumulation is exact, so
            // running all four half-0 mmas before the half-1 mmas is
            // the same sum. Costs two extra (L0-hot) fragment loads
            // per j for chunk 1.
            CooperativeMatrix<int8,16,16,1> mbA;
            CooperativeMatrix<int32,16,16,2> mc0;
            CooperativeMatrix<int32,16,16,2> mc1;
            CooperativeMatrix<int32,16,16,2> mc2;
            CooperativeMatrix<int32,16,16,2> mc3;
            CooperativeMatrix<float32,16,16,2> facc0;
            CooperativeMatrix<float32,16,16,2> facc1;
            CooperativeMatrix<float32,16,16,2> facc2;
            CooperativeMatrix<float32,16,16,2> facc3;
            CooperativeMatrix<float32,16,16,2> facc4;
            CooperativeMatrix<float32,16,16,2> facc5;
            CooperativeMatrix<float32,16,16,2> facc6;
            CooperativeMatrix<float32,16,16,2> facc7;
            facc0.splat(0.0f);
            facc1.splat(0.0f);
            facc2.splat(0.0f);
            facc3.splat(0.0f);
            facc4.splat(0.0f);
            facc5.splat(0.0f);
            facc6.splat(0.0f);
            facc7.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                // Token staging: EVERY wave stages its own tile (wave
                // w -> tokens t0+16w..t0+16w+15). Only the xs target
                // needs the wave-uniform select; ps is index-computed.
                if (lane < 16) {
                    int64 xb = (int64) (t0 + wid * 16 + lane)
                        * xRowBytes + b * 320L;
                    float32 xv = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    if (wid == 0) { xsA[lane] = xv; }
                    else if (wid == 1) { xsB[lane] = xv; }
                    else if (wid == 2) { xsC[lane] = xv; }
                    else if (wid == 3) { xsD[lane] = xv; }
                    else if (wid == 4) { xsE[lane] = xv; }
                    else if (wid == 5) { xsF[lane] = xv; }
                    else if (wid == 6) { xsG[lane] = xv; }
                    else { xsH[lane] = xv; }
                    // 10.12.42: this lane's ROW header, decoded once
                    // per block and pre-folded to (cf, cg) per j —
                    // nothing of it survives into the j-loop.
                    int64 ro = myRo + b * 144L;
                    float32 dv = GgufFile.halfBitsToF32(
                        ((int32) packed[ro] & 255)
                        | (((int32) packed[ro + 1L] & 255) << 8));
                    float32 dmv = GgufFile.halfBitsToF32(
                        ((int32) packed[ro + 2L] & 255)
                        | (((int32) packed[ro + 3L] & 255) << 8));
                    int32 d0 = (int32) packed[ro + 4L] & 255;
                    int32 d1 = (int32) packed[ro + 5L] & 255;
                    int32 d2 = (int32) packed[ro + 6L] & 255;
                    int32 d3 = (int32) packed[ro + 7L] & 255;
                    int32 m0 = (int32) packed[ro + 8L] & 255;
                    int32 m1 = (int32) packed[ro + 9L] & 255;
                    int32 m2 = (int32) packed[ro + 10L] & 255;
                    int32 m3 = (int32) packed[ro + 11L] & 255;
                    int32 k0 = (int32) packed[ro + 12L] & 255;
                    int32 k1 = (int32) packed[ro + 13L] & 255;
                    int32 k2 = (int32) packed[ro + 14L] & 255;
                    int32 k3 = (int32) packed[ro + 15L] & 255;
                    uint32 cb = (wid * 16 + lane) * 8;
                    cfAll[cb] = dv * (float32) (d0 & 63);
                    cfAll[cb + 1] = dv * (float32) (d1 & 63);
                    cfAll[cb + 2] = dv * (float32) (d2 & 63);
                    cfAll[cb + 3] = dv * (float32) (d3 & 63);
                    cfAll[cb + 4] = dv
                        * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                    cfAll[cb + 5] = dv
                        * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                    cfAll[cb + 6] = dv
                        * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                    cfAll[cb + 7] = dv
                        * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                    cgAll[cb] = 0.0f - dmv * (float32) (m0 & 63);
                    cgAll[cb + 1] = 0.0f - dmv * (float32) (m1 & 63);
                    cgAll[cb + 2] = 0.0f - dmv * (float32) (m2 & 63);
                    cgAll[cb + 3] = 0.0f - dmv * (float32) (m3 & 63);
                    cgAll[cb + 4] = 0.0f - dmv
                        * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                    cgAll[cb + 5] = 0.0f - dmv
                        * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                    cgAll[cb + 6] = 0.0f - dmv
                        * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                    cgAll[cb + 7] = 0.0f - dmv
                        * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));
                } else {
                    uint32 tk = lane - 16;
                    int64 xb = (int64) (t0 + wid * 16 + tk)
                        * xRowBytes + b * 320L;
                    float32 xv = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    uint32 sbi = 0;
                    while (sbi < 8) {
                        int64 at = xb + 256L + (int64) (sbi * 4);
                        int32 ps = ((int32) xp[at] & 255)
                            | (((int32) xp[at + 1L] & 255) << 8)
                            | (((int32) xp[at + 2L] & 255) << 16)
                            | (((int32) xp[at + 3L]) << 24);
                        rgAll[(wid * 8 + sbi) * 16 + tk] =
                            xv * (float32) ps;
                        sbi = sbi + 1;
                    }
                }
                Barrier.workgroup();

                uint32 j = 0;
                while (j < 8) {
                    // 10.12.42: the pre-folded row factors — two LDS
                    // scalar reads replace the header decode + 8-way
                    // select that used to live here.
                    float32 cfv = cfAll[(wid * 16 + lane16) * 8 + j];
                    float32 cgv = cgAll[(wid * 16 + lane16) * 8 + j];
                    uint32 kBase = 32 * j;
                    int64 aOff = (int64) t0 * xRowBytes + b * 320L
                        + (int64) kBase;
                    int64 kAbs = b * 256L + (int64) kBase;
                    int64 bOff = ((int64) (i0 / 16)
                        * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                    // Chunk 0: tiles 0-3, half 0 then half 1 with the
                    // single-buffered weight fragment.
                    mc0.splat(0);
                    mc1.splat(0);
                    mc2.splat(0);
                    mc3.splat(0);
                    mbA.load(deq, (uint32) bOff, 1, 16);
                    ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                    mc0.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 16L), 0,
                        (uint32) xRowBytes);
                    mc1.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 32L), 0,
                        (uint32) xRowBytes);
                    mc2.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 48L), 0,
                        (uint32) xRowBytes);
                    mc3.mma(ma, mbA);
                    mbA.load(deq, (uint32) (bOff + 256L), 1, 16);
                    ma.load(xp, (uint32) (aOff + 16L), 0,
                        (uint32) xRowBytes);
                    mc0.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 16L + 16L),
                        0, (uint32) xRowBytes);
                    mc1.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 32L + 16L),
                        0, (uint32) xRowBytes);
                    mc2.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 48L + 16L),
                        0, (uint32) xRowBytes);
                    mc3.mma(ma, mbA);
                    // 10.12.33: straight-line — rg comes from the
                    // block-precomputed rgAll via verb slices; no
                    // branch, no per-wave copies (rgAll is read-only
                    // in the j-loop, so drift cannot touch it).
                    mc0.scaledAccumInto2S(facc0, xsA, cfv,
                        rgAll[j * 16], cgv);
                    mc1.scaledAccumInto2S(facc1, xsB, cfv,
                        rgAll[(8 + j) * 16], cgv);
                    mc2.scaledAccumInto2S(facc2, xsC, cfv,
                        rgAll[(16 + j) * 16], cgv);
                    mc3.scaledAccumInto2S(facc3, xsD, cfv,
                        rgAll[(24 + j) * 16], cgv);
                    // Chunk 1: tiles 4-7 — mc and rg REUSED; within a
                    // wave the chunk-0 verb calls above are complete,
                    // so the rewrite introduces no drift hazard. The
                    // weight halves reload (L0-hot) for the
                    // single-buffered fragment.
                    mc0.splat(0);
                    mc1.splat(0);
                    mc2.splat(0);
                    mc3.splat(0);
                    mbA.load(deq, (uint32) bOff, 1, 16);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 64L), 0,
                        (uint32) xRowBytes);
                    mc0.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 80L), 0,
                        (uint32) xRowBytes);
                    mc1.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 96L), 0,
                        (uint32) xRowBytes);
                    mc2.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 112L), 0,
                        (uint32) xRowBytes);
                    mc3.mma(ma, mbA);
                    mbA.load(deq, (uint32) (bOff + 256L), 1, 16);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 64L + 16L),
                        0, (uint32) xRowBytes);
                    mc0.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 80L + 16L),
                        0, (uint32) xRowBytes);
                    mc1.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 96L + 16L),
                        0, (uint32) xRowBytes);
                    mc2.mma(ma, mbA);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 112L + 16L),
                        0, (uint32) xRowBytes);
                    mc3.mma(ma, mbA);
                    mc0.scaledAccumInto2S(facc4, xsE, cfv,
                        rgAll[(32 + j) * 16], cgv);
                    mc1.scaledAccumInto2S(facc5, xsF, cfv,
                        rgAll[(40 + j) * 16], cgv);
                    mc2.scaledAccumInto2S(facc6, xsG, cfv,
                        rgAll[(48 + j) * 16], cgv);
                    mc3.scaledAccumInto2S(facc7, xsH, cfv,
                        rgAll[(56 + j) * 16], cgv);
                    j = j + 1;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            facc0.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
            facc1.store(y, (uint32) ((int64) (t0 + 16) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc2.store(y, (uint32) ((int64) (t0 + 32) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc3.store(y, (uint32) ((int64) (t0 + 48) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc4.store(y, (uint32) ((int64) (t0 + 64) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc5.store(y, (uint32) ((int64) (t0 + 80) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc6.store(y, (uint32) ((int64) (t0 + 96) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc7.store(y, (uint32) ((int64) (t0 + 112) * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    /** True when the 8-token-tile multi-wave tiling applies. */
    public static boolean fitsMw8(int64 rows, int64 outDim) {
        return rows % 128L == 0L && outDim % 128L == 0L;
    }

    public static void q4kWmmaDeqMw8Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM8 = rows / 128L;
        int64 tilesN8 = outDim / 128L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqMw8Kernel.launch(s,
            grid: [(uint32) (tilesM8 * tilesN8)], block: [256])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN8, cols / 256L, 0);
        return;
    }

    /**
     * 10.12.34: the PARTITIONED Mw8 launch — the same GEMM as one
     * back-to-back run of ~32-WG slices, each a full launch over a
     * `rowBase` window of the output. The grid sweep measured the
     * same work at 6.85 TMAC/s in 32-WG launches vs 5.3-5.5 in one
     * monolithic launch: 32 fills the ~40-concurrent-WG capacity (2
     * per WGP x 20) with no scheduling tail, and the narrow weight
     * window keeps the activation slab MALL-resident. All slices
     * share every buffer; the stream keeps them in order.
     */
    // 10.12.42: the partition width is SWEEPABLE — the 32-WG optimum
    // was measured pre-retile (10.12.34) and the retile changed the
    // kernel it was tuned for. `partw N` re-tunes it.
    static int64 partWgs = 32L;
    public static void setPartWgs(int64 n) {
        WmmaKernel.partWgs = n;
    }

    public static void q4kWmmaDeqMw8PartLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM8 = rows / 128L;
        int64 tilesN8 = outDim / 128L;
        // partWgs WGs per launch: tilesM8 * sliceN8 = partWgs -> sliceN8.
        int64 sliceN8 = WmmaKernel.partWgs / tilesM8;
        if (sliceN8 < 1L) { sliceN8 = 1L; }
        KernelStream s = QuantKernel.stream();
        int64 base = 0L;
        while (base < tilesN8) {
            int64 n8 = sliceN8;
            if (base + n8 > tilesN8) { n8 = tilesN8 - base; }
            q4kWmmaDeqMw8Kernel.launch(s,
                grid: [(uint32) (tilesM8 * n8)], block: [256])
                (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
                 (uint32) n8, cols / 256L, (uint32) (base * 128L));
            base = base + n8;
        }
        return;
    }

    /** Batch kernel vs the T=8 deq kernel — the test harness. */
    public static void compareMw8Into(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        KernelStream s = QuantKernel.stream();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(want, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q4kWmmaDeqMw8Launch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /**
     * 10.12.27 — the ONE-TIME Q6_K widen: signed q-32 values (they fit
     * int8 exactly) out to the same TILE-MAJOR layout as the Q4 widen,
     * so the Q6 deq GEMM shares the Q4 kernel's B addressing verbatim.
     * The per-slice scales and d stay in the packed buffer, applied at
     * the epilogue. One thread per ql byte (128 per block), producing
     * the lo/hi pair exactly as q6kWmmaEpiKernel's in-LDS widen does —
     * which this replaces, along with its 32x re-widen per prefill.
     */
    @Kernel
    public static void q6kWidenKernel(KernelBuffer<int8> deq,
            KernelBuffer<int8> packed, uint32 total, int64 blocksPerRow) {
        uint32 tid = KernelThread.globalIdX();
        if (tid < total) {
            uint32 perRow = (uint32) blocksPerRow * 128;
            uint32 ii = tid / perRow;
            uint32 rem = tid % perRow;
            uint32 b = rem / 128;
            uint32 byteIdx = rem % 128;
            int64 ro = (int64) ii * (blocksPerRow * 210L)
                + (int64) b * 210L;
            int32 qlb = (int32) packed[ro + (int64) byteIdx] & 255;
            uint32 h = byteIdx / 64;
            uint32 l64 = byteIdx % 64;
            int32 qhb = (int32) packed[ro + 128L
                + (int64) (32 * h) + (int64) (l64 % 32)] & 255;
            uint32 sh = 2 * (l64 / 32);
            int32 vLo = ((qlb & 15)
                | (((qhb >> sh) & 3) << 4)) - 32;
            int32 vHi = (((qlb >> 4) & 15)
                | (((qhb >> (sh + 4)) & 3) << 4)) - 32;
            int64 tilesK = blocksPerRow * 16L;
            int64 kLo = (int64) b * 256L + (int64) (128 * h + l64);
            int64 kHi = kLo + 64L;
            int64 tI = (int64) (ii / 16);
            int64 iIn = (int64) (ii % 16);
            deq[(tI * tilesK + kLo / 16L) * 256L
                + iIn * 16L + (kLo % 16L)] = (int8) vLo;
            deq[(tI * tilesK + kHi / 16L) * 256L
                + iIn * 16L + (kHi % 16L)] = (int8) vHi;
        }
    }

    public static void q6kWidenLaunch(KernelBuffer<int8> deq,
            KernelBuffer<int8> packed, int64 outDim, int64 cols) {
        int64 bpr = cols / 256L;
        int64 total = outDim * bpr * 128L;
        KernelStream s = QuantKernel.stream();
        q6kWidenKernel.launch(s, grid: [(uint32) ((total + 255L) / 256L)],
            block: [256])
            (deq, packed, (uint32) total, bpr);
        return;
    }

    /**
     * 10.12.27 — the Q6_K token-blocked multi-wave deq GEMM: the Mw4
     * transform applied to `q6kWmmaEpiKernel`, which the profile put
     * at ITS memory wall (49 GB packed / 323 ms = 152 GB/s, one
     * 16-token tile per WG re-reading and RE-WIDENING the matrix 32x).
     * Q6 is the simpler epilogue: signed q-32 (baked into the widen),
     * one scale per 16-wide K-slice, NO dmin — so no rank-1 term, no
     * group sums, single-verb `scaledAccumInto` per tile. Per-lane
     * header registers (d + 16 signed slice scales), per-tile token
     * vectors (xs), per-wave row vectors (cf — the barrier-free drift
     * rule), 4 mmas per weight fragment.
     */
    @Kernel @FastMath
    public static void q6kWmmaDeqMw4Kernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, uint32 rows, uint32 outDim,
            uint32 tilesN8, int64 blocksPerRow, uint32 rowBase) {
        Shared<float32> xsA = shared float32[16];
        Shared<float32> xsB = shared float32[16];
        Shared<float32> xsC = shared float32[16];
        Shared<float32> xsD = shared float32[16];
        // 10.12.31: no cf arrays — the lane-local row scale rides the
        // scalar verb; the wave-uniform branch is gone with it.

        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wid = tid / 32;
        uint32 lane16 = lane % 16;
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 tileT = wg / tilesN8;
        uint32 tileI8 = wg % tilesN8;
        uint32 t0 = tileT * 64;
        uint32 i0 = rowBase + tileI8 * 128 + wid * 16;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * 210L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 myRo = (int64) (i0 + lane16) * rowBytes;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1> mb;
            CooperativeMatrix<int32,16,16,2> mc0;
            CooperativeMatrix<int32,16,16,2> mc1;
            CooperativeMatrix<int32,16,16,2> mc2;
            CooperativeMatrix<int32,16,16,2> mc3;
            CooperativeMatrix<float32,16,16,2> facc0;
            CooperativeMatrix<float32,16,16,2> facc1;
            CooperativeMatrix<float32,16,16,2> facc2;
            CooperativeMatrix<float32,16,16,2> facc3;
            facc0.splat(0.0f);
            facc1.splat(0.0f);
            facc2.splat(0.0f);
            facc3.splat(0.0f);

            int64 b = 0;
            while (b < blocksPerRow) {
                // Token staging: waves 0-3, one token-tile each — only
                // the per-token q8 scale; Q6 needs no group sums.
                if (wid < 4 && lane < 16) {
                    int64 xb = (int64) (t0 + wid * 16 + lane)
                        * xRowBytes + b * 320L;
                    float32 xv = Cajeta.bitsToF32(
                        ((int32) xp[xb + 288L] & 255)
                        | (((int32) xp[xb + 289L] & 255) << 8)
                        | (((int32) xp[xb + 290L] & 255) << 16)
                        | (((int32) xp[xb + 291L] & 255) << 24));
                    if (wid == 0) { xsA[lane] = xv; }
                    else if (wid == 1) { xsB[lane] = xv; }
                    else if (wid == 2) { xsC[lane] = xv; }
                    else { xsD[lane] = xv; }
                }
                Barrier.workgroup();

                // Weight-side header: d and 16 SIGNED slice scales in
                // per-lane registers.
                int64 ro = myRo + b * 210L;
                float32 dv = GgufFile.halfBitsToF32(
                    ((int32) packed[ro + 208L] & 255)
                    | (((int32) packed[ro + 209L] & 255) << 8));
                int32 s0 = (int32) packed[ro + 192L];
                int32 s1 = (int32) packed[ro + 193L];
                int32 s2 = (int32) packed[ro + 194L];
                int32 s3 = (int32) packed[ro + 195L];
                int32 s4 = (int32) packed[ro + 196L];
                int32 s5 = (int32) packed[ro + 197L];
                int32 s6 = (int32) packed[ro + 198L];
                int32 s7 = (int32) packed[ro + 199L];
                int32 s8 = (int32) packed[ro + 200L];
                int32 s9 = (int32) packed[ro + 201L];
                int32 s10 = (int32) packed[ro + 202L];
                int32 s11 = (int32) packed[ro + 203L];
                int32 s12 = (int32) packed[ro + 204L];
                int32 s13 = (int32) packed[ro + 205L];
                int32 s14 = (int32) packed[ro + 206L];
                int32 s15 = (int32) packed[ro + 207L];

                uint32 j = 0;
                while (j < 16) {
                    int32 scj = s0;
                    if (j == 1) { scj = s1; }
                    else if (j == 2) { scj = s2; }
                    else if (j == 3) { scj = s3; }
                    else if (j == 4) { scj = s4; }
                    else if (j == 5) { scj = s5; }
                    else if (j == 6) { scj = s6; }
                    else if (j == 7) { scj = s7; }
                    else if (j == 8) { scj = s8; }
                    else if (j == 9) { scj = s9; }
                    else if (j == 10) { scj = s10; }
                    else if (j == 11) { scj = s11; }
                    else if (j == 12) { scj = s12; }
                    else if (j == 13) { scj = s13; }
                    else if (j == 14) { scj = s14; }
                    else if (j == 15) { scj = s15; }
                    float32 cfv = dv * (float32) scj;
                    mc0.splat(0);
                    mc1.splat(0);
                    mc2.splat(0);
                    mc3.splat(0);
                    uint32 kBase = 16 * j;
                    int64 aOff = (int64) t0 * xRowBytes + b * 320L
                        + (int64) kBase;
                    int64 kAbs = b * 256L + (int64) kBase;
                    int64 bOff = ((int64) (i0 / 16)
                        * (blocksPerRow * 16L) + kAbs / 16L) * 256L;
                    // ONE weight fragment, four mmas.
                    mb.load(deq, (uint32) bOff, 1, 16);
                    ma.load(xp, (uint32) aOff, 0, (uint32) xRowBytes);
                    mc0.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 16L), 0,
                        (uint32) xRowBytes);
                    mc1.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 32L), 0,
                        (uint32) xRowBytes);
                    mc2.mma(ma, mb);
                    ma.load(xp, (uint32) (aOff + xRowBytes * 48L), 0,
                        (uint32) xRowBytes);
                    mc3.mma(ma, mb);
                    // 10.12.31: straight-line scalar epilogue —
                    // no branch, no LDS staging.
                    mc0.scaledAccumIntoS(facc0, xsA, cfv);
                    mc1.scaledAccumIntoS(facc1, xsB, cfv);
                    mc2.scaledAccumIntoS(facc2, xsC, cfv);
                    mc3.scaledAccumIntoS(facc3, xsD, cfv);
                    j = j + 1;
                }
                Barrier.workgroup();
                b = b + 1;
            }

            facc0.store(y, (uint32) ((int64) t0 * (int64) outDim
                + (int64) i0), 0, outDim);
            facc1.store(y, (uint32) ((int64) (t0 + 16) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc2.store(y, (uint32) ((int64) (t0 + 32) * (int64) outDim
                + (int64) i0), 0, outDim);
            facc3.store(y, (uint32) ((int64) (t0 + 48) * (int64) outDim
                + (int64) i0), 0, outDim);
        }
    }

    public static void q6kWmmaDeqMw4Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM4 = rows / 64L;
        int64 tilesN8 = outDim / 128L;
        KernelStream s = QuantKernel.stream();
        q6kWmmaDeqMw4Kernel.launch(s,
            grid: [(uint32) (tilesM4 * tilesN8)], block: [256])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN8, cols / 256L, 0);
        return;
    }

    /** 10.12.34: the partitioned Q6 launch — ~32-WG slices, same
     *  rationale as q4kWmmaDeqMw8PartLaunch. */
    public static void q6kWmmaDeqMw4PartLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM4 = rows / 64L;
        int64 tilesN8 = outDim / 128L;
        int64 sliceN8 = 32L / tilesM4;
        if (sliceN8 < 1L) { sliceN8 = 1L; }
        KernelStream s = QuantKernel.stream();
        int64 base = 0L;
        while (base < tilesN8) {
            int64 n8 = sliceN8;
            if (base + n8 > tilesN8) { n8 = tilesN8 - base; }
            q6kWmmaDeqMw4Kernel.launch(s,
                grid: [(uint32) (tilesM4 * n8)], block: [256])
                (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
                 (uint32) n8, cols / 256L, (uint32) (base * 128L));
            base = base + n8;
        }
        return;
    }

    /** Batch kernel vs the Q6 token-blocked deq kernel — harness. */
    public static void compareQ6Mw4Into(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        KernelStream s = QuantKernel.stream();
        QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(want, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q6kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q6kWmmaDeqMw4Launch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /** True when the N4 tiling applies. */
    public static boolean fitsN4(int64 rows, int64 outDim) {
        return rows % 16L == 0L && outDim % 64L == 0L;
    }

    public static void q4kWmmaDeqN4Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 16L;
        int64 tilesN4 = outDim / 64L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqN4Kernel.launch(s, grid: [(uint32) (tilesM * tilesN4)],
            block: [32])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN4, cols / 256L);
        return;
    }

    /** Batch kernel vs the N4 deq kernel — the test harness. */
    public static void compareN4Into(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        KernelStream s = QuantKernel.stream();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(want, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q4kWmmaDeqN4Launch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /** True when the T2 tiling applies. */
    public static boolean fitsT2(int64 rows, int64 outDim) {
        return rows % 32L == 0L && outDim % 16L == 0L;
    }

    public static void q4kWmmaDeqT2Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> deq,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols) {
        int64 tilesM = rows / 32L;
        int64 tilesN = outDim / 16L;
        KernelStream s = QuantKernel.stream();
        q4kWmmaDeqT2Kernel.launch(s, grid: [(uint32) (tilesM * tilesN)],
            block: [32])
            (y, packed, deq, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN, cols / 256L);
        return;
    }

