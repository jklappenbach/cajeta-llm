    /** The widen kernel over a host array — the shape a test can call. */
    public static void widenInto(int8[] rawW, int64 outDim, int64 cols,
            int8[] out) {
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        wDev.upload(rawW);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        KernelStream ws #= KernelStream.current();
        ws.sync();
        deqDev.download(out, outDim * cols);
        return;
    }

    /**
     * The batch kernel vs BOTH Q4_K epilogue kernels on the same bytes
     * (epilogue plan U3): `want` from the dotAccum batch kernel,
     * `gotStaged`/`gotDeq` from the register-epilogue variants.
     * Tolerance oracle — the epi kernels pre-fold `d*sc` and run the
     * dmin term as rank-1 float accumulates, so the association moves.
     */
    public static void compareEpiInto(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] gotStaged, float32[] gotDeq) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        KernelStream s #= KernelStream.current();
        s.sync();
        yDev.download(want, rows * outDim);
        WmmaKernel.q4kWmmaEpiLaunch(yDev, wDev, xDev, rows, outDim, cols);
        s.sync();
        yDev.download(gotStaged, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q4kWmmaDeqEpiLaunch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        s.sync();
        yDev.download(gotDeq, rows * outDim);
        return;
    }

    /** As {@link #compareQ6Into} but `got` from the epilogue kernel. */
    public static void compareQ6EpiInto(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev, rows,
            outDim, cols);
        KernelStream s #= KernelStream.current();
        s.sync();
        yDev.download(want, rows * outDim);
        WmmaKernel.q6kWmmaEpiLaunch(yDev, wDev, xDev, rows, outDim, cols);
        s.sync();
        yDev.download(got, rows * outDim);
        return;
    }

    /**
     * Staged vs deq WMMA on the same bytes (10.12.16): `want` from the
     * staged kernel, `got` from the widen + global-B kernel. The pair is
     * expected EXACTLY equal — identical accumulation order.
     */
    public static void compareDeqInto(int8[] rawW, float32[] x,
            int64 rows, int64 outDim, int64 cols, float32[] want,
            float32[] got) {
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 r = 0;
        while (r < rows) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) rawW.count());
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wDev.upload(rawW);
        xDev.upload(xph);
        KernelStream ds #= KernelStream.current();
        WmmaKernel.q4kWmmaLaunch(yDev, wDev, xDev, rows, outDim, cols);
        ds.sync();
        yDev.download(want, rows * outDim);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        WmmaKernel.q4kWmmaDeqLaunch(yDev, wDev, deqDev, xDev, rows,
            outDim, cols);
        ds.sync();
        yDev.download(got, rows * outDim);
        return;
    }
}
