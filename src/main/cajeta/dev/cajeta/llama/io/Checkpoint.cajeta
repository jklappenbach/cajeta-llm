package dev.cajeta.llama.io;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.collection.ArrayList;
import cajeta.collection.HashMap;
import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.math.Tensor;
import dev.cajeta.llama.LlamaException;

/**
 * A whole checkpoint as one logical state dict (cajeta-llama plan 5.2.3;
 * spec §3.4) — one `.safetensors` file, or a Hugging Face sharded layout
 * where `model.safetensors.index.json` carries a `weight_map` of
 * `tensor name → shard filename`. Either way the caller sees a single
 * name → tensor surface; shard resolution is this class's problem.
 *
 * `open` decides by filename: a path ending in `.json` is a sharded
 * index (shard filenames resolve against the index's directory, per the
 * HF layout); anything else is a single safetensors file.
 *
 * Shards open eagerly — each is an mmap + a header parse, cheap and
 * page-lazy — so a bad shard fails at open, not at the 40th minute of a
 * long load.
 */
public final class Checkpoint {
    SafetensorsFile[] shards;
    int32 shardCount;
    // name → packed location: (shard index << 32) | directory index.
    HashMap<String, int64> where;
    int32 n;
    // GGUF mode (plan Unit 16): the whole checkpoint is one GgufFile and
    // HF tensor names translate to ggml names at the load seam — the
    // binding layer keeps speaking HF, and 16.3.1's "same model, either
    // format" is this one field.
    GgufFile gg;

    Checkpoint() {
        this.shards = null;
        this.shardCount = 0;
        this.where #= heap HashMap<String, int64>();
        this.n = 0;
        this.gg = null;
    }

    /** Open a checkpoint — `.safetensors`, a sharded index JSON, or a
     *  `.gguf` file (Unit 16). */
    public static #Checkpoint open(String path) {
        Checkpoint c = heap Checkpoint();
        if (path.endsWith(".gguf")) {
            c.gg #= heap GgufFile(path);
            c.n = (int32) c.gg.tensorCount();
        } else if (path.endsWith(".json")) {
            c.openSharded(path);
        } else {
            c.openSingle(path);
        }
        return #c;
    }

    /** The GGUF behind this checkpoint, or null — the metadata surface
     *  (config, tokenizer, chat template) for gguf-opened checkpoints. */
    public GgufFile gguf() {
        return this.gg;
    }

    /**
     * HF tensor name → ggml name (the llama architecture's table). Names
     * that don't match the known families pass through unchanged, so a
     * direct ggml name also resolves.
     */
    static #String ggufNameOf(String hf) {
        if (hf.equals("model.embed_tokens.weight")) {
            return #"token_embd.weight";
        }
        if (hf.equals("model.norm.weight")) {
            return #"output_norm.weight";
        }
        if (hf.equals("lm_head.weight")) {
            return #"output.weight";
        }
        if (hf.startsWith("model.layers.")) {
            // model.layers.<N>.<rest> → blk.<N>.<mapped rest>
            int64 tail = ((int64) "model.layers.".count());
            int64 dot = hf.indexOfFrom(".", tail);
            if (dot > 0) {
                String num #= hf.substring((int32) tail, (int32) dot);
                String rest #= hf.substring((int32) (dot + 1L),
                    (int32) hf.count());
                String m = null;
                if (rest.equals("input_layernorm.weight")) {
                    m = "attn_norm.weight";
                } else if (rest.equals("self_attn.q_proj.weight")) {
                    m = "attn_q.weight";
                } else if (rest.equals("self_attn.k_proj.weight")) {
                    m = "attn_k.weight";
                } else if (rest.equals("self_attn.v_proj.weight")) {
                    m = "attn_v.weight";
                } else if (rest.equals("self_attn.o_proj.weight")) {
                    m = "attn_output.weight";
                } else if (rest.equals("post_attention_layernorm.weight")) {
                    m = "ffn_norm.weight";
                } else if (rest.equals("mlp.gate_proj.weight")) {
                    m = "ffn_gate.weight";
                } else if (rest.equals("mlp.up_proj.weight")) {
                    m = "ffn_up.weight";
                } else if (rest.equals("mlp.down_proj.weight")) {
                    m = "ffn_down.weight";
                }
                if (m != null) {
                    String out = "blk." + num + "." + m;
                    return #out;
                }
            }
        }
        String same = "" + hf;
        return #same;
    }

    /** Tensors across every shard. */
    public int32 tensorCount() {
        return this.n;
    }

    /** `true` when `name` resolves to a tensor in some shard. */
    public boolean contains(String name) {
        if (this.gg != null) {
            String gn #= Checkpoint.ggufNameOf(name);
            return this.gg.contains(gn);
        }
        return this.where.containsKey(name);
    }

    /** Load an F16 tensor from whichever shard holds it. */
    public #Tensor<float16> loadF16(String name) {
        SafetensorsFile f = this.shardFor(name);
        return f.loadF16(name);
    }

    /** Load a BF16 tensor from whichever shard holds it. */
    public #Tensor<bfloat16> loadBf16(String name) {
        SafetensorsFile f = this.shardFor(name);
        return f.loadBf16(name);
    }

    /** Load an F32 tensor from whichever shard holds it. GGUF-backed
     *  checkpoints dequantize whatever the tensor's stored type is. */
    public #Tensor<float32> loadF32(String name) {
        if (this.gg != null) {
            String gn #= Checkpoint.ggufNameOf(name);
            return this.gg.loadF32(gn);
        }
        SafetensorsFile f = this.shardFor(name);
        return f.loadF32(name);
    }

    /** Stored dtype of `name` — for the binding layer's loader pick. */
    public String dtypeOf(String name) {
        SafetensorsFile f = this.shardFor(name);
        return f.dtypeOf(f.indexOf(name));
    }

    /** Unmap every shard. Loaded tensors are unaffected (they own copies). */
    public void close() {
        if (this.gg != null) {
            this.gg.close();
            return;
        }
        int32 i = 0;
        while (i < this.shardCount) {
            this.shards[i].close();
            i = i + 1;
        }
    }

    // ── internals ───────────────────────────────────────────────────────

    void openSingle(String path) {
        this.shards #= heap SafetensorsFile[1];
        this.shards[0] #= heap SafetensorsFile(path);
        this.shardCount = 1;
        this.indexShard(0);
    }

    void openSharded(String indexPath) {
        int8[] raw = File.readAllBytes(indexPath);
        int64 rawLen = (int64) raw.count();
        if (rawLen <= 0) {
            throw heap LlamaException("checkpoint: index '" + indexPath
                + "' is missing or empty");
        }
        JsonValue v #= Json.parse(raw, rawLen);
        JsonObject root = v.object();
        JsonValue wm = root.get("weight_map");
        if (wm == null) {
            throw heap LlamaException("checkpoint: index '" + indexPath
                + "' has no weight_map");
        }
        JsonObject weightMap = wm.object();
        String dir #= Checkpoint.dirOf(indexPath);

        // Unique shard files, in first-appearance order.
        HashMap<String, int32> shardIdx = heap HashMap<String, int32>();
        ArrayList<String> shardFiles = heap ArrayList<String>();
        int32 k = 0;
        while (k < weightMap.count()) {
            String fname #= weightMap.valueAt(k).asString();
            if (!shardIdx.containsKey(fname)) {
                int32 pos = (int32) shardFiles.count();
                // The LIST takes ownership; the dedup map's key borrows the
                // list's element (HashMap.put stores plain args as borrows,
                // so the key must outlive the loop-local — it's consulted by
                // containsKey on later iterations).
                shardFiles.add(#fname);
                shardIdx.put(shardFiles.get(pos), pos);
            }
            k = k + 1;
        }
        int32 nShards = (int32) shardFiles.count();
        this.shards #= heap SafetensorsFile[nShards];
        int32 s = 0;
        while (s < nShards) {
            String shardPath = dir + shardFiles.get(s);
            this.shards[s] #= heap SafetensorsFile(shardPath);
            s = s + 1;
        }
        this.shardCount = nShards;
        s = 0;
        while (s < nShards) {
            this.indexShard(s);
            s = s + 1;
        }
    }

    /** Fold shard `s`'s directory into the checkpoint-wide name map. */
    void indexShard(int32 s) {
        SafetensorsFile f = this.shards[s];
        int32 i = 0;
        while (i < f.tensorCount()) {
            int64 packed = ((int64) s << 32) | (int64) i;
            this.where.put(f.nameAt(i), packed);
            this.n = this.n + 1;
            i = i + 1;
        }
    }

    /** The shard holding `name`; throws naming the tensor when absent. */
    SafetensorsFile shardFor(String name) {
        if (!this.where.containsKey(name)) {
            throw heap LlamaException("checkpoint: no tensor named '" + name
                + "' in any shard");
        }
        int64 packed = this.where.get(name);
        int32 s = (int32) (packed >>> 32);
        return this.shards[s];
    }

    /** `path` up to and including its last '/' — "" when path has none. */
    static #String dirOf(String path) {
        int64 last = -1;
        int64 at = path.indexOf("/");
        while (at >= 0) {
            last = at;
            at = path.indexOfFrom("/", at + 1);
        }
        if (last < 0) {
            return "";
        }
        return path.substring(0, (int32) (last + 1));
    }
}
