package dev.cajeta.llama.io;

import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Wave;

/**
 * The packed mat-vecs as XPU kernels (threaded-forward-path plan Unit 3;
 * spec §4.1, §4.2).
 *
 * The decomposition is one work item per OUTPUT ROW. That is not a choice
 * so much as a reading of the existing loop: `Quant.q4kMatVecInto`'s row
 * loop already touches nothing but its own row's blocks and its own
 * `y[i]`, so the rows are independent by construction and the work is
 * re-homing the body, not rewriting it. Everything inside one row —
 * the header decode, the four sub-block folds, the final horizontal sum —
 * is left in the order the serial form performs it, which is what lets
 * `QuantKernelTest` demand BIT-IDENTICAL agreement rather than a
 * tolerance.
 *
 * `Quant.q4kMatVecInto` stays as the serial reference (spec §4.5). It is
 * what these are checked against, and it is the fallback when a backend
 * cannot take the kernel.
 */
public final class QuantKernel {

    /**
     * The routing switch (plan 4.2.2): when false, `Linear.matvecInto`
     * takes the serial path for every format, kernel included.
     *
     * A static flag with a setter rather than an environment read, because
     * that is what this codebase already does for exactly this job
     * (`Quant.setPackingEnabled`) and because the 5.x scaling runs need to
     * flip it BETWEEN measurements in one process — alternating the arm
     * order, which a process-lifetime environment variable cannot do.
     */
    static boolean routeEnabled = true;

    public static void setRoutingEnabled(boolean on) {
        QuantKernel.routeEnabled = on;
    }

    public static boolean routingEnabled() {
        return QuantKernel.routeEnabled;
    }

    /**
     * MEASUREMENT INSTRUMENT, not a feature: when true, `matvecInto` returns
     * without computing anything, so a forward pass times EVERYTHING EXCEPT
     * the projections.
     *
     * It exists to check a number that was otherwise derived rather than
     * observed. The token split was solved from the worker-cap sweep
     * (32 workers 261.4 ms, 1 worker 1216.6) against the kernels' measured
     * 9.06x scaling — which assumes the non-mat-vec remainder is completely
     * unaffected by worker count. That assumption is plausible and untested,
     * and the whole parity plan rests on the answer, so it gets measured
     * directly too.
     *
     * The output is garbage while this is set. Any timing taken with it on
     * describes cost, never correctness.
     */
    static boolean skipMatvec = false;

    public static void setSkipMatvecForMeasurement(boolean on) {
        QuantKernel.skipMatvec = on;
    }

    public static boolean skipMatvecForMeasurement() {
        return QuantKernel.skipMatvec;
    }

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q4_K.
     *
     * FOUR lanes, not sixteen, and that is measured rather than stylistic
     * (plan 6.3.3). Four shapes were raced on identical grids:
     *
     *   A  16-lane + `@Device` helper   0.790 ms @32   11.1 GB/s
     *   B  16-lane, helper inlined      0.782 ms       11.2   (1.00x vs A)
     *   C  4-lane, reduce per sub-block 0.228 ms       38.5   (3.46x vs A)
     *   D  4-lane, reduce per block     0.240 ms       36.6   (3.29x vs A)
     *
     * B ties A, so the `@Device` call was never the cost — it inlines. The
     * width is: inside a kernel the CPU backend vectorizes ACROSS work
     * items, and a body that already occupies 16 float lanes leaves it no
     * room. That is also why the HOST path keeps its 16-lane form, where
     * 4 lanes measured 2.19x SLOWER (11.75 ms against 25.76) — there is no
     * outer loop to widen there, so width is pure win.
     *
     * `q4kAcc`'s standing warning that reducing per sub-block cost more
     * than width saved is specific to 16-lane horizontal sums: at width 4,
     * C beats D.
     *
     * The block header decodes into NAMED LOCALS — a work item has no heap
     * for `headK4`'s `int32[8]` scratch — and the eight scales and minima
     * become two VECTORS, so the sub-block loop indexes them with a runtime
     * `sb` without any of it reaching memory.
     *
     * `Quant.q4kMatVecIntoLanes4` is this body on the host, in this order;
     * it exists to be the bit-identity oracle and nothing else.
     */
    @Kernel
    public static void q4kMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                int64 xb = xOff + b * 256L;
                Vector<float32,8> tv = x.vload<8>(xb) * 0.0f;
                Vector<float32,8> uv = tv;
                tv[0] = d * (float32) (d0 & 63);
                tv[1] = d * (float32) (d1 & 63);
                tv[2] = d * (float32) (d2 & 63);
                tv[3] = d * (float32) (d3 & 63);
                tv[4] = d * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                tv[5] = d * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                tv[6] = d * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                tv[7] = d * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                uv[0] = dmin * (float32) (m0 & 63);
                uv[1] = dmin * (float32) (m1 & 63);
                uv[2] = dmin * (float32) (m2 & 63);
                uv[3] = dmin * (float32) (m3 & 63);
                uv[4] = dmin * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                uv[5] = dmin * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                uv[6] = dmin * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                uv[7] = dmin * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));

                // Sub-block `sb` reads the 32 bytes at `16 + 32*(sb/2)` and
                // takes nibble half `sb%2` — Q5_K's layout minus the fifth
                // bit, which is why the two bodies look alike.
                int32 sb = 0;
                while (sb < 8) {
                    int64 bo = ro + 16L + 32L * (int64) (sb / 2);
                    Vector<int8,16> c0 = packed.vload<16>(bo);
                    Vector<int8,16> c1 = packed.vload<16>(bo + 16L);
                    Vector<int8,16> q0 = c0 & 15;
                    Vector<int8,16> q1 = c1 & 15;
                    if ((sb - (sb / 2) * 2) == 1) {
                        q0 = (c0 >> 4) & 15;
                        q1 = (c1 >> 4) & 15;
                    }
                    int64 xo = xb + (int64) (sb * 32);
                    Vector<int16,8> a0 = q0.widenLo();
                    Vector<int16,8> a1 = q0.widenHi();
                    Vector<int16,8> a2 = q1.widenLo();
                    Vector<int16,8> a3 = q1.widenHi();
                    Vector<float32,4> x0 = x.vload<4>(xo);
                    Vector<float32,4> x1 = x.vload<4>(xo + 4L);
                    Vector<float32,4> x2 = x.vload<4>(xo + 8L);
                    Vector<float32,4> x3 = x.vload<4>(xo + 12L);
                    Vector<float32,4> x4 = x.vload<4>(xo + 16L);
                    Vector<float32,4> x5 = x.vload<4>(xo + 20L);
                    Vector<float32,4> x6 = x.vload<4>(xo + 24L);
                    Vector<float32,4> x7 = x.vload<4>(xo + 28L);
                    Vector<float32,4> p = a0.widenLo().toF32() * x0;
                    p = p + a0.widenHi().toF32() * x1;
                    p = p + a1.widenLo().toF32() * x2;
                    p = p + a1.widenHi().toF32() * x3;
                    p = p + a2.widenLo().toF32() * x4;
                    p = p + a2.widenHi().toF32() * x5;
                    p = p + a3.widenLo().toF32() * x6;
                    p = p + a3.widenHi().toF32() * x7;
                    Vector<float32,4> sv = x0 + x1 + x2 + x3;
                    sv = sv + x4 + x5 + x6 + x7;
                    float32 qx = p[0] + p[1] + p[2] + p[3];
                    float32 sx = sv[0] + sv[1] + sv[2] + sv[3];
                    acc = acc + tv[sb] * qx - uv[sb] * sx;
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    // ── Q6_K (plan 6.2.1) ───────────────────────────────────────────────
    //
    // Q6_K carries 25.6% of a Q4_K_M file by bytes (measured on
    // Meta-Llama-3.1-8B-Instruct-Q4_K_M: 74.4% Q4_K, 25.6% Q6_K, no Q5_K
    // and no Q8_0), and it is what `output.weight` and `attn_v` are stored
    // as — so it runs for every token. With Q4_K routed and Q6_K left
    // serial, Amdahl caps the end-to-end gain at about 3x however well the
    // Q4_K kernel scales. Routing it too is what makes the ~10x reachable.

    /** The f16 block scale at `off`, from a device buffer. */
    @Device
    static float32 f16AtDev(KernelBuffer<int8> raw, int64 off) {
        int32 h = ((int32) raw[off] & 255)
            | (((int32) raw[off + 1L] & 255) << 8);
        return GgufFile.halfBitsToF32(h);
    }

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q6_K.
     *
     * Lifted from `Quant.q6kMatVecInto` with its 16-way sub-block loop
     * INTACT — unlike Q4_K, nothing here needs unrolling: the per-sub-block
     * scale is read straight out of the buffer (`packed[ro + 192 + sb]`)
     * rather than out of a decoded header, so there is no scratch array to
     * turn into registers and no runtime index into one.
     */
    @Kernel
    public static void q6kMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 210L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 210L;
                float32 d = QuantKernel.f16AtDev(packed, ro + 208L);
                int64 xb = xOff + b * 256L;
                Vector<float32,4> accv = x.vload<4>(xb) * 0.0f;
                int32 sb = 0;
                while (sb < 16) {
                    int32 g = sb / 8;
                    int32 r0 = sb * 16 - g * 128;
                    int32 sl = r0 / 64;
                    int32 l64 = r0 - sl * 64;
                    int32 shi = r0 / 32;
                    int32 l32 = r0 - shi * 32;
                    Vector<int8,16> qlv = packed.vload<16>(
                        ro + (int64) (64 * g + l64));
                    Vector<int8,16> qhv = packed.vload<16>(
                        ro + (int64) (128 + 32 * g + l32));
                    Vector<int8,16> lo = qlv & 15;
                    if (sl == 1) { lo = (qlv >> 4) & 15; }
                    Vector<int8,16> hi = (qhv >> (2 * shi)) & 3;
                    // 0..63 biased by -32 -> -32..31, still int8; the widen
                    // below is SIGNED, which is what carries the bias up.
                    Vector<int8,16> q = (lo | (hi << 4)) - 32;
                    Vector<int16,8> w0 = q.widenLo();
                    Vector<int16,8> w1 = q.widenHi();
                    int64 xo = xb + (int64) (sb * 16);
                    // Fold the scale in BEFORE accumulating, so the block
                    // reduces once instead of once per sub-block.
                    float32 sc = d * (float32) packed[ro + (int64) (192 + sb)];
                    accv = accv + x.vload<4>(xo)
                        * (w0.widenLo().toF32() * sc);
                    accv = accv + x.vload<4>(xo + 4L)
                        * (w0.widenHi().toF32() * sc);
                    accv = accv + x.vload<4>(xo + 8L)
                        * (w1.widenLo().toF32() * sc);
                    accv = accv + x.vload<4>(xo + 12L)
                        * (w1.widenHi().toF32() * sc);
                    sb = sb + 1;
                }
                acc = acc + accv[0] + accv[1] + accv[2] + accv[3];
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    // ── Q8_0 (plan 6.2.1) ───────────────────────────────────────────────

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q8_0.
     * `Quant.q8MatVecInto`'s body verbatim — no header to decode at all,
     * just one f16 scale per 32 elements.
     */
    @Kernel
    public static void q8MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 34L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 34L;
                float32 dv = QuantKernel.f16AtDev(packed, ro);
                int64 xo = xOff + b * 32L;
                Vector<int8,16> q0 = packed.vload<16>(ro + 2L);
                Vector<int8,16> q1 = packed.vload<16>(ro + 18L);
                Vector<int16,8> a0 = q0.widenLo();
                Vector<int16,8> a1 = q0.widenHi();
                Vector<int16,8> a2 = q1.widenLo();
                Vector<int16,8> a3 = q1.widenHi();
                Vector<float32,4> p = a0.widenLo().toF32() * x.vload<4>(xo);
                p = p + a0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + a1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + a1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + a2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + a2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + a3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + a3.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + dv * (p[0] + p[1] + p[2] + p[3]);
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    // ── Q5_K (plan 6.2.1) ───────────────────────────────────────────────
    //
    // Q4_K's nibble structure plus a 5th bit held apart: the high bits for
    // the WHOLE super-block live in bytes 16..47, one bit per element, and
    // sub-block `sb` is bit `sb` of each.
    //
    // The sub-block loop stays a LOOP here rather than unrolling 8 ways
    // like Q4_K's. Q4_K unrolled because its per-sub-block scales came out
    // of `headK4`'s heap scratch arrays, which a work item has no room for;
    // Q5_K reads the same header, so the eight scales and eight minima are
    // built ONCE per block into two VECTORS and indexed by the running
    // `sb`. A vector lane read with a runtime index is a register
    // operation, an `int32[8]` in thread memory is not.

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q5_K.
     */
    @Kernel
    public static void q5kMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 176L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 176L;

                // The Q4_K header, byte for byte (see q4kMatVecKernel).
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                // Eight scales and eight minima as VECTOR lanes, so the
                // sub-block loop can index them with a runtime `sb` without
                // any of it reaching memory.
                int64 xb = xOff + b * 256L;
                Vector<float32,8> tv = x.vload<8>(xb) * 0.0f;
                Vector<float32,8> uv = tv;
                tv[0] = d * (float32) (d0 & 63);
                tv[1] = d * (float32) (d1 & 63);
                tv[2] = d * (float32) (d2 & 63);
                tv[3] = d * (float32) (d3 & 63);
                tv[4] = d * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                tv[5] = d * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                tv[6] = d * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                tv[7] = d * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                uv[0] = dmin * (float32) (m0 & 63);
                uv[1] = dmin * (float32) (m1 & 63);
                uv[2] = dmin * (float32) (m2 & 63);
                uv[3] = dmin * (float32) (m3 & 63);
                uv[4] = dmin * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                uv[5] = dmin * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                uv[6] = dmin * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                uv[7] = dmin * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));

                Vector<int8,16> hbA = packed.vload<16>(ro + 16L);
                Vector<int8,16> hbB = packed.vload<16>(ro + 32L);
                int32 sb = 0;
                while (sb < 8) {
                    int64 bo = ro + 48L + 32L * (int64) (sb / 2);
                    Vector<int8,16> r0 = packed.vload<16>(bo);
                    Vector<int8,16> r1 = packed.vload<16>(bo + 16L);
                    Vector<int8,16> n0 = r0 & 15;
                    Vector<int8,16> n1 = r1 & 15;
                    if ((sb - (sb / 2) * 2) == 1) {
                        n0 = (r0 >> 4) & 15;
                        n1 = (r1 >> 4) & 15;
                    }
                    Vector<int8,16> q0 = n0 | (((hbA >> sb) & 1) << 4);
                    Vector<int8,16> q1 = n1 | (((hbB >> sb) & 1) << 4);
                    int64 xo = xb + (int64) (sb * 32);
                    Vector<int16,8> a0 = q0.widenLo();
                    Vector<int16,8> a1 = q0.widenHi();
                    Vector<int16,8> a2 = q1.widenLo();
                    Vector<int16,8> a3 = q1.widenHi();
                    Vector<float32,4> x0 = x.vload<4>(xo);
                    Vector<float32,4> x1 = x.vload<4>(xo + 4L);
                    Vector<float32,4> x2 = x.vload<4>(xo + 8L);
                    Vector<float32,4> x3 = x.vload<4>(xo + 12L);
                    Vector<float32,4> x4 = x.vload<4>(xo + 16L);
                    Vector<float32,4> x5 = x.vload<4>(xo + 20L);
                    Vector<float32,4> x6 = x.vload<4>(xo + 24L);
                    Vector<float32,4> x7 = x.vload<4>(xo + 28L);
                    Vector<float32,4> p = a0.widenLo().toF32() * x0;
                    p = p + a0.widenHi().toF32() * x1;
                    p = p + a1.widenLo().toF32() * x2;
                    p = p + a1.widenHi().toF32() * x3;
                    p = p + a2.widenLo().toF32() * x4;
                    p = p + a2.widenHi().toF32() * x5;
                    p = p + a3.widenLo().toF32() * x6;
                    p = p + a3.widenHi().toF32() * x7;
                    Vector<float32,4> sv = x0 + x1 + x2 + x3;
                    sv = sv + x4 + x5 + x6 + x7;
                    float32 qx = p[0] + p[1] + p[2] + p[3];
                    float32 sx = sv[0] + sv[1] + sv[2] + sv[3];
                    acc = acc + tv[sb] * qx - uv[sb] * sx;
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** Rows per grid block. One work item is a whole row, so this is a
     *  scheduling width, not a tile size. */
    static final int32 ROWS_PER_BLOCK = 64;

    /** Work items per launch block — the divisor turning a target WORKGROUP
     *  count into a row count (see Linear.effectiveChunkRows). */
    public static int32 rowsPerBlock() { return QuantKernel.ROWS_PER_BLOCK; }

    /**
     * Launch {@link #q4kMatVecKernel} over device-resident buffers.
     *
     * The grid is `ceil(rows / 64)` blocks of 64, so a row count that does
     * not fill the last block is normal rather than exceptional — the
     * kernel's `gi < rows` guard is the only thing that handles it, and
     * `QuantKernelTest.q4kKernelCoversEveryRowWhenRowsDoNotFillTheGrid`
     * is what proves it does.
     */
    public static void q4kMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s #= KernelStream.current();
        q4kMatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 256L, xOff, yOff);
        return;
    }

    public static void q4kMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q4kMatVecLaunchNoSync(y, packed, x, rows, cols, xOff, yOff);
        KernelStream s #= KernelStream.current();
        s.sync();
        return;
    }

    /**
     * Q4_K weights against q8_K-QUANTIZED activations — the integer path.
     *
     * Same decomposition as `q4kMatVecKernel` (one output row per work
     * item, one reduce per 256-block) and a different inner loop: the
     * nibbles stay integers and meet int8 activations through `dotAccum`,
     * which on x86 with VNNI is `vpdpbusd` — unsigned weights x signed
     * activations, exactly this shape. Measured on the host form: 2.9x over
     * the f32 arm, with `vpdpbusd` confirmed in the disassembly rather than
     * assumed.
     *
     * THIS DOES NOT COMPUTE THE SAME THING. Quantizing the activations to
     * int8 is an approximation the f32 path does not make. It is the trade
     * llama.cpp makes by default, and it is why this is a separate kernel
     * behind a switch instead of a replacement.
     *
     * Both integer sums stay in int32 by construction: a nibble is at most
     * 15 and an activation quant at most 127, so 32 products cap at 60960,
     * and a 6-bit sub-block scale takes the block to about 3.8M — two
     * orders inside int32, which matters because cajeta TRAPS on signed
     * overflow rather than wrapping.
     */
    @Kernel
    public static void q4kQ8MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<int32> xbsums,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                // The sub-block scales and mins stay INTEGER here — the f32
                // kernel folds d and dmin in at this point, and the whole
                // gain is in not doing that until the block is finished.
                Vector<int32,8> zv = xbsums.vload<8>(0) * 0;
                Vector<int32,8> scv = zv;
                Vector<int32,8> mnv = zv;
                scv[0] = d0 & 63;
                scv[1] = d1 & 63;
                scv[2] = d2 & 63;
                scv[3] = d3 & 63;
                scv[4] = (k0 & 15) | ((d0 >> 2) & 48);
                scv[5] = (k1 & 15) | ((d1 >> 2) & 48);
                scv[6] = (k2 & 15) | ((d2 >> 2) & 48);
                scv[7] = (k3 & 15) | ((d3 >> 2) & 48);
                mnv[0] = m0 & 63;
                mnv[1] = m1 & 63;
                mnv[2] = m2 & 63;
                mnv[3] = m3 & 63;
                mnv[4] = (k0 >> 4) | ((m0 >> 2) & 48);
                mnv[5] = (k1 >> 4) | ((m1 >> 2) & 48);
                mnv[6] = (k2 >> 4) | ((m2 >> 2) & 48);
                mnv[7] = (k3 >> 4) | ((m3 >> 2) & 48);

                int64 xb = b * 256L;
                Vector<int32,8> tot = zv;
                int32 g = 0;
                while (g < 4) {
                    // Chunk g covers bytes [32g, 32g+32): LOW nibbles are
                    // sub-block 2g, HIGH nibbles are 2g+1.
                    //
                    // asUnsigned is load-bearing, not cosmetic: the nibbles
                    // are 0..15 but arrive in an int8 buffer, and dotAccum
                    // picks its tier from the ELEMENT TYPE. Signed here and
                    // it never reaches vpdpbusd at all.
                    Vector<uint8,32> raw = packed.vload<32>(
                        ro + 16L + (int64) (32 * g)).asUnsigned();
                    Vector<uint8,32> lo = raw & 15;
                    Vector<uint8,32> hi = (raw >> 4) & 15;
                    Vector<int8,32> a0 = xq.vload<32>(xb + (int64) (64 * g));
                    Vector<int8,32> a1 = xq.vload<32>(
                        xb + (int64) (64 * g + 32));
                    tot = tot + lo.dotAccum(a0, zv) * scv[2 * g];
                    tot = tot + hi.dotAccum(a1, zv) * scv[2 * g + 1];
                    g = g + 1;
                }
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];

                // The dmin term reads the precomputed group sums, so it never
                // leaves integer space either. Each 32-element sub-block
                // spans two 16-element groups.
                int32 dmins = 0;
                int32 sb = 0;
                while (sb < 8) {
                    dmins = dmins + mnv[sb]
                        * (xbsums[b * 16L + (int64) (2 * sb)]
                         + xbsums[b * 16L + (int64) (2 * sb + 1)]);
                    sb = sb + 1;
                }

                float32 xs = xd[b];
                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** {@link #q4kMatVecLaunch} for the Q4_K/q8_K integer path. */
    public static void q4kQ8MatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<int32> xbsums,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s #= KernelStream.current();
        q4kQ8MatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, xq, xd, xbsums, ur, cols / 256L, yOff);
        return;
    }

    public static void q4kQ8MatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<int32> xbsums,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q4kQ8MatVecLaunchNoSync(y, packed, xq, xd, xbsums, rows, cols, yOff);
        KernelStream s #= KernelStream.current();
        s.sync();
        return;
    }


    /**
     * The integer path over ONE packed activation buffer (plan 10.1).
     *
     * Body for body the same arithmetic as {@link #q4kQ8MatVecKernel} —
     * same loads of the weight, same dotAccum tiers, same order of sums —
     * with the activation's three buffers replaced by `Quant.q8kPack`'s
     * self-contained 320-byte block. That is a TRANSFER change, not a
     * compute one: three driver calls per distinct activation become one,
     * and the results stay bit-identical because folding q8_K's group sums
     * into sub-block pairs is the same int32 addition performed earlier.
     *
     * The scalars are rebuilt from bytes here rather than read from typed
     * buffers. They are UNIFORM across the dispatch — their address does
     * not depend on the work item — so the assembly is scalar-unit work
     * beside the vector loads it accompanies.
     */
    @Kernel
    public static void q4kQ8PackedMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                // No int32 buffer to borrow a zero from any more, now that
                // the sums arrive as bytes — so the accumulator seed is
                // constructed rather than loaded.
                Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0,
                                                          0, 0, 0, 0);
                Vector<int32,8> scv = zv;
                Vector<int32,8> mnv = zv;
                scv[0] = d0 & 63;
                scv[1] = d1 & 63;
                scv[2] = d2 & 63;
                scv[3] = d3 & 63;
                scv[4] = (k0 & 15) | ((d0 >> 2) & 48);
                scv[5] = (k1 & 15) | ((d1 >> 2) & 48);
                scv[6] = (k2 & 15) | ((d2 >> 2) & 48);
                scv[7] = (k3 & 15) | ((d3 >> 2) & 48);
                mnv[0] = m0 & 63;
                mnv[1] = m1 & 63;
                mnv[2] = m2 & 63;
                mnv[3] = m3 & 63;
                mnv[4] = (k0 >> 4) | ((m0 >> 2) & 48);
                mnv[5] = (k1 >> 4) | ((m1 >> 2) & 48);
                mnv[6] = (k2 >> 4) | ((m2 >> 2) & 48);
                mnv[7] = (k3 >> 4) | ((m3 >> 2) & 48);

                // The activation block: quants at [0,256), sums at [256,288),
                // scale bits at [288,292), stride 320.
                int64 xb = b * 320L;
                Vector<int32,8> tot = zv;
                int32 g = 0;
                while (g < 4) {
                    Vector<uint8,32> raw = packed.vload<32>(
                        ro + 16L + (int64) (32 * g)).asUnsigned();
                    Vector<uint8,32> lo = raw & 15;
                    Vector<uint8,32> hi = (raw >> 4) & 15;
                    Vector<int8,32> a0 = xp.vload<32>(xb + (int64) (64 * g));
                    Vector<int8,32> a1 = xp.vload<32>(
                        xb + (int64) (64 * g + 32));
                    tot = tot + lo.dotAccum(a0, zv) * scv[2 * g];
                    tot = tot + hi.dotAccum(a1, zv) * scv[2 * g + 1];
                    g = g + 1;
                }
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];

                // All eight sub-block sums in ONE aligned 32-byte load —
                // which is why they sit before the scale in the block.
                Vector<int8,32> sv = xp.vload<32>(xb + 256L);
                int32 dmins = 0;
                int32 sb = 0;
                while (sb < 8) {
                    int32 sbb = sb * 4;
                    // The top byte keeps its sign extension: `& 255` then
                    // `<< 24` would overflow int32 on a negative sum, and
                    // cajeta TRAPS rather than wrapping.
                    int32 ps = ((int32) sv[sbb] & 255)
                        | (((int32) sv[sbb + 1] & 255) << 8)
                        | (((int32) sv[sbb + 2] & 255) << 16)
                        | (((int32) sv[sbb + 3]) << 24);
                    dmins = dmins + mnv[sb] * ps;
                    sb = sb + 1;
                }

                // The scale is amax/127 and so never negative, which is what
                // lets the top byte be masked and shifted like the others.
                Vector<int8,16> dv = xp.vload<16>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** {@link #q4kQ8MatVecLaunch} over the packed activation buffer. */
    public static void q4kQ8PackedMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s #= KernelStream.current();
        q4kQ8PackedMatVecKernel.launch(s,
            grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q4kQ8PackedMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q4kQ8PackedMatVecLaunchNoSync(y, packed, xp, rows, cols, yOff);
        KernelStream s #= KernelStream.current();
        s.sync();
        return;
    }


    /**
     * WAVE-COOPERATIVE Q4_K x q8_K — llama.cpp's mmvq decomposition
     * (plan 11.1).
     *
     * Every mat-vec kernel here so far gives ONE OUTPUT ROW to ONE WORK
     * ITEM. llama.cpp gives one output row to one WAVE. On gfx1151 that is
     * not a guess: RDNA3.5 takes their MMVQ_PARAMETERS_RDNA2 table, which
     * resolves `nwarps = 1` and `rows_per_cuda_block = 1`, so a CUDA block
     * is 32 threads = one wave32 = one row, the lanes split each weight
     * block between them, and the row finishes with a wave reduction.
     *
     * Two things follow, and they are the two problems 10.5's buckets
     * found:
     *
     *   OCCUPANCY. One item per row gives a 1024-row weight 32 waves for
     *   160 SIMDs. One wave per row gives it 1024 — the wave count stops
     *   being rows/32 and becomes rows.
     *
     *   LOCALITY. Under one-item-per-row a wave's 32 lanes read 32
     *   addresses `rowBytes` apart. Here four consecutive lanes read one
     *   block's 128 contiguous quant bytes, so a wave reads eight runs of
     *   128 bytes. 9.6 refuted "uncoalesced reads are the problem" by
     *   moving the BYTES while keeping one item per row; this moves the
     *   decomposition instead, which is the variable that test held fixed.
     *
     * The lane split is chosen so that no byte is read twice: lane `l`
     * takes block `l/4` of the eight in flight and, within it, the
     * 32-byte chunk `l%4` — which is exactly one iteration of the serial
     * kernel's `g` loop, carrying sub-blocks 2g and 2g+1. Four lanes
     * therefore cover a block's 128 quant bytes and its 256 activation
     * bytes exactly once each.
     */
    @Kernel
    public static void q4kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        Shared<float32> part = shared float32[32];
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 144L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int32 g = (int32) (lane % 4);
            int64 b = (int64) (lane / 4);
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                // Read by all four lanes of the block; it is 16 bytes and it
                // is in cache after the first.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Only THIS lane's two sub-blocks are unpacked, where the
                // serial kernel unpacks all eight — and the two forms are
                // NOT interchangeable. Q4_K packs sub-blocks 0-3 and 4-7 in
                // different fields, and a lane owning `g` needs sub-blocks
                // 2g and 2g+1, so g < 2 lands entirely in the first field
                // and g >= 2 entirely in the second. Reading field `g`
                // instead of sub-block `2g` is the shape of the first
                // version of this kernel, which was wrong on every row.
                int32 sc0 = 0;
                int32 sc1 = 0;
                int32 mn0 = 0;
                int32 mn1 = 0;
                if (g < 2) {
                    int32 j = 2 * g;
                    sc0 = (int32) hv[4 + j] & 63;
                    sc1 = (int32) hv[5 + j] & 63;
                    mn0 = (int32) hv[8 + j] & 63;
                    mn1 = (int32) hv[9 + j] & 63;
                } else {
                    int32 j = 2 * g - 4;
                    int32 k0 = (int32) hv[12 + j] & 255;
                    int32 k1 = (int32) hv[13 + j] & 255;
                    int32 d0 = (int32) hv[4 + j] & 255;
                    int32 d1 = (int32) hv[5 + j] & 255;
                    int32 m0 = (int32) hv[8 + j] & 255;
                    int32 m1 = (int32) hv[9 + j] & 255;
                    sc0 = (k0 & 15) | ((d0 >> 2) & 48);
                    sc1 = (k1 & 15) | ((d1 >> 2) & 48);
                    mn0 = (k0 >> 4) | ((m0 >> 2) & 48);
                    mn1 = (k1 >> 4) | ((m1 >> 2) & 48);
                }

                Vector<uint8,32> raw = packed.vload<32>(
                    ro + 16L + (int64) (32 * g)).asUnsigned();
                Vector<uint8,32> lo = raw & 15;
                Vector<uint8,32> hi = (raw >> 4) & 15;
                int64 xb = b * 320L + (int64) (64 * g);
                Vector<int8,32> a0 = xp.vload<32>(xb);
                Vector<int8,32> a1 = xp.vload<32>(xb + 32L);
                Vector<int32,8> tot = lo.dotAccum(a0, zv) * sc0
                                    + hi.dotAccum(a1, zv) * sc1;
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];

                // The dmin term needs the sum of THIS LANE's activations,
                // and the packed block's precomputed sums are per 32-element
                // sub-block — which only helps a lane that owns a whole one.
                // llama.cpp does not read a precomputed sum at all: it takes
                // `dp4a(0x01010101, u)`, so any lane granularity is free.
                // Same trick here, and it drops a 32-byte load per lane per
                // block as well.
                Vector<uint8,32> ones = (lo ^ lo) | 1;
                Vector<int32,8> tot2 = ones.dotAccum(a0, zv) * mn0
                                     + ones.dotAccum(a1, zv) * mn1;
                int32 dmins = tot2[0] + tot2[1] + tot2[2] + tot2[3]
                            + tot2[4] + tot2[5] + tot2[6] + tot2[7];

                Vector<int8,4> dv = xp.vload<4>(b * 320L + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 8L;
            }
        }
        // The wave reduction, as a shared-memory tree.
        //
        // llama.cpp uses a shuffle butterfly (warp_reduce_sum) here and this
        // was written that way first. Two things came back: the shuffle form
        // was WRONG on every row, and it was exactly as FAST — 89.1 against
        // 88.5 GB/s at 1024 rows, 128.5 against 127.9 at 14336. So the
        // reduction is not what this kernel spends its time on, and the
        // correct-and-simple form is kept until something says otherwise.
        part[lane] = acc;
        Barrier.workgroup();
        uint32 s = 16;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = part[0];
        }
    }

    /** One WORKGROUP per output row, 32 threads each — the geometry is the
     *  point, so it is not chunked and not tunable. */
    public static void q4kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        KernelStream s #= KernelStream.current();
        q4kQ8WaveMatVecKernel.launch(s, grid: [ur], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q4kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s #= KernelStream.current();
        s.sync();
        return;
    }


    /**
     * WAVE-COOPERATIVE Q6_K x q8_K (plan 11.2).
     *
     * The Q4_K twin's decomposition applied to Q6_K's shape: one workgroup
     * of 32 threads per output row, and here SIXTEEN lanes to a block
     * rather than four, because Q6_K's natural unit is its 16-element
     * sub-block — one per lane, two blocks in flight per wave.
     *
     * Q6_K quants are `(lo | hi<<4) - 32`, i.e. signed after the bias. The
     * bias is NOT applied per element: dotAccum's fast tier is unsigned x
     * signed, so the raw 0..63 value goes in and the bias leaves as
     * `-32 * (sum of this lane's activations)`. That sum is taken the way
     * llama.cpp takes it — a dot against all-ones — rather than read from a
     * precomputed table, which is what frees the lane granularity.
     *
     * 10.5 measured a one-item-per-row Q6_K integer kernel as SLOWER than
     * the f32 body it would replace, and 10.6 showed the format was not
     * misaligned but ALU-bound. Neither says anything about this: 11.0's
     * probe puts one-item-per-row's ceiling at ~162-170 GB/s and a
     * coalesced pattern's at ~208, so the decomposition is the variable
     * both of those held fixed.
     *
     * Every intermediate stays inside int32: a quant caps at 63 and an
     * activation quant at 127, so a 16-element dot caps at 128016, the
     * bias term at 65024, and a signed 8-bit scale takes the pair to about
     * 24.5M — two orders inside int32, which matters because cajeta TRAPS
     * on signed overflow rather than wrapping.
     */
    @Kernel
    public static void q6kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        Shared<float32> part = shared float32[32];
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 210L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int32 sb = (int32) (lane % 16);
            int64 b = (int64) (lane / 16);
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 210L;
                float32 d = QuantKernel.f16AtDev(packed, ro + 208L);
                int64 xb = b * 320L;

                // The serial kernel's sub-block index maths, unchanged —
                // one iteration of its `sb` loop is one lane here.
                int32 g = sb / 8;
                int32 r0 = sb * 16 - g * 128;
                int32 sl = r0 / 64;
                int32 l64 = r0 - sl * 64;
                int32 shi = r0 / 32;
                int32 l32 = r0 - shi * 32;
                Vector<int8,16> qlv = packed.vload<16>(
                    ro + (int64) (64 * g + l64));
                Vector<int8,16> qhv = packed.vload<16>(
                    ro + (int64) (128 + 32 * g + l32));
                Vector<int8,16> lo = qlv & 15;
                if (sl == 1) { lo = (qlv >> 4) & 15; }
                Vector<int8,16> hi = (qhv >> (2 * shi)) & 3;
                Vector<uint8,16> qu = (lo | (hi << 4)).asUnsigned();
                Vector<int8,16> a = xp.vload<16>(xb + (int64) (sb * 16));
                Vector<uint8,16> ones = (qu ^ qu) | 1;

                Vector<int32,4> dv = qu.dotAccum(a, z4);
                Vector<int32,4> sv = ones.dotAccum(a, z4);
                int32 dot = dv[0] + dv[1] + dv[2] + dv[3];
                int32 asum = sv[0] + sv[1] + sv[2] + sv[3];
                int32 sc = (int32) packed[ro + (int64) (192 + sb)];

                Vector<int8,4> dvs = xp.vload<4>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));

                acc = acc + d * xs * (float32) (sc * (dot - 32 * asum));
                b = b + 2L;
            }
        }
        part[lane] = acc;
        Barrier.workgroup();
        uint32 s = 16;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = part[0];
        }
    }

    public static void q6kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        KernelStream s #= KernelStream.current();
        q6kQ8WaveMatVecKernel.launch(s, grid: [ur], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q6kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q6kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s #= KernelStream.current();
        s.sync();
        return;
    }

    /** {@link #q6kQ8WaveMatVecKernel} over HOST arrays. */
    public static void q6kQ8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>((uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q6kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }


    /**
     * Quantize activations into `Quant.q8kPack` form ON THE DEVICE — the
     * kernel that makes device residency possible (plan 10.2), and
     * llama.cpp's `quantize_row_q8_1_cuda` in this engine's block layout.
     *
     * One work item per 256-element block. That is a tiny grid — 16 blocks
     * for a 4096-wide activation — and deliberately so: it runs once per
     * DISTINCT activation, not once per projection, and it exists to
     * remove a host round trip rather than to be fast in itself.
     *
     * It must agree with the host packer BIT FOR BIT, because the two are
     * interchangeable by design and a test that only checked "close" would
     * let the device path drift into a second, slightly different
     * quantization that nothing compares against.
     */
    @Kernel
    public static void q8kPackKernel(KernelBuffer<int8> out,
            KernelBuffer<float32> x, uint32 blocks) {
        Shared<float32> amx = shared float32[32];
        Shared<int32> psum = shared int32[32];
        uint32 lane = KernelThread.x();
        uint32 blk = KernelThread.globalIdX() / 32;
        if (blk < blocks) {
            int64 b = (int64) blk;
            int64 xb = b * 256L;
            int64 ob = b * 320L;
            // Eight elements a lane, thirty-two lanes to a block. The first
            // version gave a whole block to ONE work item, which put 256
            // dependent global loads on a single lane and made the device
            // packer slower than the host packer it exists to replace.
            int64 e0 = xb + (int64) (lane * 8);

            float32 amax = 0.0f;
            int32 t = 0;
            while (t < 8) {
                float32 v = x[e0 + (int64) t];
                float32 av = v;
                // An `if`, not a ternary: a conditional EXPRESSION in a
                // kernel body silently skips the whole kernel (10.9).
                if (v < 0.0f) { av = 0.0f - v; }
                if (av > amax) { amax = av; }
                t = t + 1;
            }
            amx[lane] = amax;
            Barrier.workgroup();
            uint32 st = 16;
            while (st > 0) {
                if (lane < st) {
                    float32 o = amx[lane + st];
                    if (o > amx[lane]) { amx[lane] = o; }
                }
                Barrier.workgroup();
                st = st / 2;
            }
            float32 bmax = amx[0];
            // An all-zero block quantizes to all-zero with a zero scale; the
            // reciprocal has to be guarded or it is inf * 0.
            float32 inv = 0.0f;
            if (bmax > 0.0f) { inv = 127.0f / bmax; }

            int32 s = 0;
            int32 k = 0;
            while (k < 8) {
                float32 fv = x[e0 + (int64) k] * inv;
                int32 qi = (int32) Math.round(fv);
                out[ob + (int64) (lane * 8) + (int64) k] = (int8) qi;
                s = s + qi;
                k = k + 1;
            }
            psum[lane] = s;
            Barrier.workgroup();

            // A 32-element SUB-BLOCK is four lanes. The sums are integers,
            // so regrouping them across lanes is exact and the block stays
            // byte-identical to the host packer.
            if (lane < 8) {
                uint32 base = lane * 4;
                int32 tot = psum[base] + psum[base + 1]
                          + psum[base + 2] + psum[base + 3];
                int64 so = ob + 256L + (int64) (lane * 4);
                int32 b0 = tot & 255;
                int32 b1 = (tot >> 8) & 255;
                int32 b2 = (tot >> 16) & 255;
                int32 b3 = (tot >> 24) & 255;
                if (b0 > 127) { b0 = b0 - 256; }
                if (b1 > 127) { b1 = b1 - 256; }
                if (b2 > 127) { b2 = b2 - 256; }
                if (b3 > 127) { b3 = b3 - 256; }
                out[so] = (int8) b0;
                out[so + 1L] = (int8) b1;
                out[so + 2L] = (int8) b2;
                out[so + 3L] = (int8) b3;
            }
            if (lane == 0) {
                // The scale is bmax/127, so never negative — which is what
                // lets the kernels rebuild it with a masked shift.
                float32 dsc = bmax / 127.0f;
                int32 db = Cajeta.f32ToBits(dsc);
                int32 e1 = db & 255;
                int32 e2 = (db >> 8) & 255;
                int32 e3 = (db >> 16) & 255;
                int32 e4 = (db >> 24) & 255;
                if (e1 > 127) { e1 = e1 - 256; }
                if (e2 > 127) { e2 = e2 - 256; }
                if (e3 > 127) { e3 = e3 - 256; }
                if (e4 > 127) { e4 = e4 - 256; }
                out[ob + 288L] = (int8) e1;
                out[ob + 289L] = (int8) e2;
                out[ob + 290L] = (int8) e3;
                out[ob + 291L] = (int8) e4;
            }
        }
    }

    /** {@link #q8kPackKernel} over `n` activations already on the device. */
    public static void q8kPackLaunchNoSync(KernelBuffer<int8> out,
            KernelBuffer<float32> x, int64 n) {
        uint32 nb = (uint32) (n / 256L);
        KernelStream s #= KernelStream.current();
        // One workgroup of 32 lanes per block — the geometry the kernel
        // assumes, not a tunable.
        q8kPackKernel.launch(s, grid: [nb], block: [32])(out, x, nb);
        return;
    }

    public static void q8kPackLaunch(KernelBuffer<int8> out,
            KernelBuffer<float32> x, int64 n) {
        QuantKernel.q8kPackLaunchNoSync(out, x, n);
        KernelStream s #= KernelStream.current();
        s.sync();
        return;
    }

    /** {@link #q8kPackKernel} over HOST arrays — the shape a test can call
     *  to compare against {@link Quant#q8kPack}. */
    public static void q8kPackIntoDevice(float32[] x, int64 n, int8[] out) {
        KernelBuffer<float32> xb #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<int8> ob #= heap KernelBuffer<int8>(
            (uint64) Quant.q8kPackedBytes(n));
        xb.upload(x);
        QuantKernel.q8kPackLaunch(ob, xb, n);
        ob.download(out);
        return;
    }

    /**
     * `q4kMatVecKernel` over an INTERLEAVED weight (Quant.interleaveRows16).
     *
     * Byte for byte the same body — same loads, same widths, same order of
     * products and sums. The single difference is where a 16-byte chunk
     * lives: `chunkAt` maps a row-relative offset through the interleave so
     * the 64 lanes of a block read one contiguous run instead of 64 runs
     * 2304 bytes apart.
     *
     * Because the arithmetic is untouched, this is required to be
     * BIT-IDENTICAL to `q4kMatVecKernel` on the same weight, and that is
     * the test rather than a tolerance. A layout change that also changed
     * the numbers would mean the mapping is wrong, not that the numbers
     * moved.
     */
    @Kernel
    public static void q4kMatVecKernelIL(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff,
            int64 grp) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            // `grp` arrives as a PARAMETER rather than reading
            // ROWS_PER_BLOCK here: a kernel cannot read a static field
            // ("unsupported construct — field access"), and a duplicated
            // literal would be a second place for the interleave stride to
            // disagree with the launch block size it must equal.
            int64 gidx = i / grp;
            // Base of THIS lane's 16-byte chunk zero. Adding `(off/16)*16*grp`
            // walks to chunk `off/16` without leaving the lane's column.
            int64 rowBase = gidx * grp * rowBytes + (i - gidx * grp) * 16L;
            int64 stride = 16L * grp;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                // CHUNK INDICES IN CLOSED FORM — no division anywhere.
                //
                // The obvious spelling is `(byteOffset / 16) * stride`, and
                // it is a trap: `byteOffset` is int64, so that is a SIGNED
                // divide, which LLVM cannot reduce to a shift without
                // proving non-negativity and instead emits the
                // round-toward-zero correction on every load. In a kernel
                // measured at 63% of its own read roofline — i.e. ALU-bound
                // — 272 of those per row is not a rounding error, and the
                // first interleaved measurement was really measuring them.
                //
                // A block is 144 bytes = 9 chunks, so chunk indices are
                // exact small integers: header at 9b, and sub-block `sb`'s
                // two halves at 9b+1+2*(sb/2) and 9b+2+2*(sb/2).
                int64 cb = b * 9L;

                Vector<int8,16> hv = packed.vload<16>(rowBase + cb * stride);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                int64 xb = xOff + b * 256L;
                Vector<float32,8> tv = x.vload<8>(xb) * 0.0f;
                Vector<float32,8> uv = tv;
                tv[0] = d * (float32) (d0 & 63);
                tv[1] = d * (float32) (d1 & 63);
                tv[2] = d * (float32) (d2 & 63);
                tv[3] = d * (float32) (d3 & 63);
                tv[4] = d * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                tv[5] = d * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                tv[6] = d * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                tv[7] = d * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                uv[0] = dmin * (float32) (m0 & 63);
                uv[1] = dmin * (float32) (m1 & 63);
                uv[2] = dmin * (float32) (m2 & 63);
                uv[3] = dmin * (float32) (m3 & 63);
                uv[4] = dmin * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                uv[5] = dmin * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                uv[6] = dmin * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                uv[7] = dmin * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));

                int32 sb = 0;
                while (sb < 8) {
                    int64 ck = cb + 1L + 2L * (int64) (sb / 2);
                    Vector<int8,16> c0 = packed.vload<16>(
                        rowBase + ck * stride);
                    Vector<int8,16> c1 = packed.vload<16>(
                        rowBase + (ck + 1L) * stride);
                    Vector<int8,16> q0 = c0 & 15;
                    Vector<int8,16> q1 = c1 & 15;
                    if ((sb - (sb / 2) * 2) == 1) {
                        q0 = (c0 >> 4) & 15;
                        q1 = (c1 >> 4) & 15;
                    }
                    int64 xo = xb + (int64) (sb * 32);
                    Vector<int16,8> a0 = q0.widenLo();
                    Vector<int16,8> a1 = q0.widenHi();
                    Vector<int16,8> a2 = q1.widenLo();
                    Vector<int16,8> a3 = q1.widenHi();
                    Vector<float32,4> x0 = x.vload<4>(xo);
                    Vector<float32,4> x1 = x.vload<4>(xo + 4L);
                    Vector<float32,4> x2 = x.vload<4>(xo + 8L);
                    Vector<float32,4> x3 = x.vload<4>(xo + 12L);
                    Vector<float32,4> x4 = x.vload<4>(xo + 16L);
                    Vector<float32,4> x5 = x.vload<4>(xo + 20L);
                    Vector<float32,4> x6 = x.vload<4>(xo + 24L);
                    Vector<float32,4> x7 = x.vload<4>(xo + 28L);
                    Vector<float32,4> p = a0.widenLo().toF32() * x0;
                    p = p + a0.widenHi().toF32() * x1;
                    p = p + a1.widenLo().toF32() * x2;
                    p = p + a1.widenHi().toF32() * x3;
                    p = p + a2.widenLo().toF32() * x4;
                    p = p + a2.widenHi().toF32() * x5;
                    p = p + a3.widenLo().toF32() * x6;
                    p = p + a3.widenHi().toF32() * x7;
                    Vector<float32,4> sv = x0 + x1 + x2 + x3;
                    sv = sv + x4 + x5 + x6 + x7;
                    float32 qx = p[0] + p[1] + p[2] + p[3];
                    float32 sx = sv[0] + sv[1] + sv[2] + sv[3];
                    acc = acc + tv[sb] * qx - uv[sb] * sx;
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** {@link #q4kMatVecLaunch} over an interleaved weight. */
    public static void q4kILMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s #= KernelStream.current();
        q4kMatVecKernelIL.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 256L, xOff, yOff,
             (int64) QuantKernel.ROWS_PER_BLOCK);
        s.sync();
        return;
    }

    /**
     * ROOFLINE: read a row and do almost nothing with it.
     *
     * The mat-vecs peak around 109 GB/s on this part while llama.cpp does a
     * whole token at roughly 180, so either our kernel is leaving bandwidth
     * on the table or 109 IS what this access pattern can get. One arm
     * distinguishes them: same grid, same rows, same 16-byte loads, same
     * one-row-per-work-item decomposition — and one XOR per load instead of
     * the decode. XOR because it cannot overflow (cajeta traps on signed
     * overflow) and cannot be folded away: the accumulator depends on every
     * load, so no load can be removed.
     *
     * If this reads ~109 too, the DECOMPOSITION is the ceiling and no
     * amount of tuning the arithmetic will move it. If it reads much more,
     * the ceiling is inside the mat-vec body.
     */
    @Kernel
    public static void rowReadKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, uint32 rows, int64 rowBytes) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 base = (int64) gi * rowBytes;
            Vector<int8,16> acc = packed.vload<16>(base)
                ^ packed.vload<16>(base);
            int64 o = 0;
            while (o < rowBytes) {
                acc = acc ^ packed.vload<16>(base + o);
                o = o + 16L;
            }
            y[(int64) gi] = (float32) acc[0];
        }
    }

    /** {@link #rowReadKernel} at the mat-vecs' grid. */
    public static void rowReadLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, int64 rows, int64 rowBytes) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s #= KernelStream.current();
        rowReadKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, ur, rowBytes);
        s.sync();
        return;
    }

    /** {@link #q4kMatVecLaunch} for Q6_K — 210-byte blocks, same grid. */
    public static void q6kMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
