package dev.cajeta.llm.convert;

import cajeta.lang.String;

/** The `tokenizer.ggml.*` arrays a converted file carries (spec 8.6). */
public final class Vocab {
    public String[] tokens;
    public float32[] scores;
    public int32[] types;
    public int32 unk;
    public boolean addBos;
    public boolean addEos;

    public Vocab(int32 n) {
        this.tokens = heap String[n];
        this.scores = heap float32[n];
        this.types = heap int32[n];
        this.unk = 0 - 1;
        this.addBos = true;
        this.addEos = false;
    }
}
