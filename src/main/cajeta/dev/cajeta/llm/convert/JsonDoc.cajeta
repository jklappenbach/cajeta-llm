package dev.cajeta.llm.convert;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;
import cajeta.lang.String;

/** A parsed JSON file that keeps its bytes alive beside the tree. */
final class JsonDoc {
    int8[] raw;
    JsonValue v;

    JsonDoc(#int8[] raw, #JsonValue v) {
        this.raw #= raw;
        this.v #= v;
    }

    /** Parse `path`, or null when the file is missing or empty. */
    static #JsonDoc read(String path) {
        int8[] raw #= File.readAllBytes(path);
        if (raw == null) { return null; }
        int64 n = (int64) raw.count();
        if (n <= 0) { return null; }
        JsonValue v #= Json.parse(raw, n);
        JsonDoc d = heap JsonDoc(#raw, #v);
        return #d;
    }

    JsonObject root() {
        return this.v.object();
    }
}
