package dev.cajeta.llm;

/**
 * Where engine diagnostics go, registered by the host (spec 11.8.1).
 *
 * The callback runs on the ENGINE's thread, mid-generation (11.8.4):
 * take the record and return. Formatting, I/O, and forwarding belong on
 * the consumer's own thread, or they become latency on every token. The
 * record is valid only during the call and its string fields are
 * borrows — a consumer that buffers copies what it keeps (11.8.3).
 *
 * A callback that throws does not fail the turn (11.8.5): the engine
 * swallows the fault and generation continues.
 */
public interface DiagCallback {
    public void onRecord(DiagRecord r);
}
