package dev.cajeta.llm.bench;

import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.CooperativeMatrix;

/**
 * The MATRIX-CORE ceiling (plan 10.12.12), measured the same validated
 * way the `dotAccum` ceiling was: four independent accumulator chains so
 * this reports THROUGHPUT rather than latency, and the caller checks that
 * doubling the iteration count doubles the TIME.
 *
 * WHY IT DECIDES THE UNIT. Our `dotAccum` ceiling is 9.9 TMAC/s and
 * llama.cpp's prefill already achieves 9.3, so a PERFECT dotAccum kernel
 * only draws level — it cannot beat them. Matrix cores are the only way
 * past that, and gfx1151 is RDNA3.5, which has WMMA.
 *
 * The capability half of the question is answered at COMPILE time and
 * costs nothing to ask: a `note: [mma-tiering]` on a `(backend, dtype)`
 * means that pair fell to the portable software tile-matmul — correct
 * results, no matrix cores. Silence means native. Asking it in one probe
 * beats finding out in one rewrite.
 */
public class MmaProbe {

    /** f16 operands with an f32 accumulator — the pairing the skill names
     *  for AMD. */
    @Kernel
    public static void mmaF16Kernel(KernelBuffer<float32> out,
            KernelBuffer<float16> a, KernelBuffer<float16> b,
            uint32 iters) {
        uint32 id = KernelThread.globalIdX();
        CooperativeMatrix<float16,16,16,0> ma;
        ma.load(a, 0, 0, 16);
        CooperativeMatrix<float16,16,16,1> mb0;
        mb0.load(b, 0, 0, 16);
        CooperativeMatrix<float16,16,16,1> mb1;
        mb1.load(b, 256, 0, 16);
        CooperativeMatrix<float16,16,16,1> mb2;
        mb2.load(b, 512, 0, 16);
        CooperativeMatrix<float16,16,16,1> mb3;
        mb3.load(b, 768, 0, 16);
        CooperativeMatrix<float32,16,16,2> c0;
        c0.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> c1;
        c1.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> c2;
        c2.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> c3;
        c3.splat(0.0f);
        uint32 k = 0;
        while (k < iters) {
            c0.mma(ma, mb0);
            c1.mma(ma, mb1);
            c2.mma(ma, mb2);
            c3.mma(ma, mb3);
            k = k + 1;
        }
        // Four separate stores; folding them would need an accumulator
        // add the type does not offer, and the store is outside the loop.
        c0.store(out, 0, 0, 16);
        c1.store(out, 256, 0, 16);
        c2.store(out, 512, 0, 16);
        c3.store(out, 768, 0, 16);
    }

    /** int8 operands with an int32 accumulator — what a quantized GEMM
     *  would actually want. */
    @Kernel
    public static void mmaI8Kernel(KernelBuffer<int32> out,
            KernelBuffer<int8> a, KernelBuffer<int8> b, uint32 iters) {
        uint32 id = KernelThread.globalIdX();
        CooperativeMatrix<int8,16,16,0> ma;
        ma.load(a, 0, 0, 16);
        CooperativeMatrix<int8,16,16,1> mb0;
        mb0.load(b, 0, 0, 16);
        CooperativeMatrix<int8,16,16,1> mb1;
        mb1.load(b, 256, 0, 16);
        CooperativeMatrix<int8,16,16,1> mb2;
        mb2.load(b, 512, 0, 16);
        CooperativeMatrix<int8,16,16,1> mb3;
        mb3.load(b, 768, 0, 16);
        CooperativeMatrix<int32,16,16,2> c0;
        c0.splat(0);
        CooperativeMatrix<int32,16,16,2> c1;
        c1.splat(0);
        CooperativeMatrix<int32,16,16,2> c2;
        c2.splat(0);
        CooperativeMatrix<int32,16,16,2> c3;
        c3.splat(0);
        uint32 k = 0;
        while (k < iters) {
            c0.mma(ma, mb0);
            c1.mma(ma, mb1);
            c2.mma(ma, mb2);
            c3.mma(ma, mb3);
            k = k + 1;
        }
        c0.store(out, 0, 0, 16);
        c1.store(out, 256, 0, 16);
        c2.store(out, 512, 0, 16);
        c3.store(out, 768, 0, 16);
    }

    public static void run() {
        int64 groups = 8192L;
        int64 tile = 256L;
        KernelBuffer<float16> a #= heap KernelBuffer<float16>((uint64) tile);
        KernelBuffer<float16> b #= heap KernelBuffer<float16>(
            (uint64) (tile * 4L));
        KernelBuffer<float32> o #= heap KernelBuffer<float32>(
            (uint64) (tile * 4L));
        float16[] ah #= heap float16[tile];
        float16[] bh #= heap float16[tile * 4L];
        int64 i = 0;
        while (i < tile) { ah[i] = (float16) 1.0f; i = i + 1; }
        i = 0;
        while (i < tile * 4L) { bh[i] = (float16) 1.0f; i = i + 1; }
        a.upload(ah);
        b.upload(bh);

        KernelStream s #= KernelStream.current();
        mmaF16Kernel.launch(s, grid: [(uint32) groups], block: [32])
            (o, a, b, (uint32) 64);
        s.sync();
        int32 it = 512;
        while (it <= 2048) {
            int64 t0 = Clock.nanoTime();
            mmaF16Kernel.launch(s, grid: [(uint32) groups], block: [32])
                (o, a, b, (uint32) it);
            s.sync();
            float64 ms = (float64) (Clock.nanoTime() - t0) / 1000000.0;
            // One mma is a 16x16x16 tile FMA = 4096 MACs, done by the
            // whole wave; four chains per iteration.
            float64 macs = (float64) groups * (float64) it * 4.0 * 4096.0;
            System.stdout.println("f16 iters " + it + "  ms " + ms
                + "  TMAC/s " + (macs / (ms / 1000.0) / 1.0e12));
            it = it * 2;
        }

        KernelBuffer<int8> ai #= heap KernelBuffer<int8>((uint64) tile);
        KernelBuffer<int8> bi #= heap KernelBuffer<int8>(
            (uint64) (tile * 4L));
        KernelBuffer<int32> oi #= heap KernelBuffer<int32>(
            (uint64) (tile * 4L));
        int8[] aih #= heap int8[tile];
        int8[] bih #= heap int8[tile * 4L];
        i = 0;
        while (i < tile) { aih[i] = (int8) 1; i = i + 1; }
        i = 0;
        while (i < tile * 4L) { bih[i] = (int8) 1; i = i + 1; }
        ai.upload(aih);
        bi.upload(bih);
        mmaI8Kernel.launch(s, grid: [(uint32) groups], block: [32])
            (oi, ai, bi, (uint32) 64);
        s.sync();
        it = 512;
        while (it <= 2048) {
            int64 t0 = Clock.nanoTime();
            mmaI8Kernel.launch(s, grid: [(uint32) groups], block: [32])
                (oi, ai, bi, (uint32) it);
            s.sync();
            float64 ms = (float64) (Clock.nanoTime() - t0) / 1000000.0;
            float64 macs = (float64) groups * (float64) it * 4.0 * 4096.0;
            System.stdout.println("int8 iters " + it + "  ms " + ms
                + "  TMAC/s " + (macs / (ms / 1000.0) / 1.0e12));
            it = it * 2;
        }
        return;
    }
}
