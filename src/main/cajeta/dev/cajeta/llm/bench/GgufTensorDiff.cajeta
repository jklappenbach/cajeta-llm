package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.io.GgufFile;

/**
 * Byte-for-byte comparison of two GGUF files' tensors (codebook-quants
 * 4.3.1): every tensor of A whose name starts with the optional prefix
 * is looked up in B and compared by type, shape and stored bytes.
 *
 *   ggufdiff <a.gguf> <b.gguf> [name-prefix]
 */
public final class GgufTensorDiff {

    public static int32 run(String[] args) {
        if ((int32) args.count() < 2) {
            System.stdout.println("usage: ggufdiff <a.gguf> <b.gguf> "
                + "[name-prefix]");
            return 2;
        }
        String prefix = "";
        if ((int32) args.count() >= 3) { prefix = args[2]; }
        GgufFile a #= heap GgufFile(args[0]);
        GgufFile b #= heap GgufFile(args[1]);
        int32 n = (int32) a.tensorCount();
        int32 compared = 0;
        int32 same = 0;
        int32 i = 0;
        while (i < n) {
            String name = a.nameAt(i);
            if (!name.startsWith(prefix)) {
                i = i + 1;
                continue;
            }
            compared = compared + 1;
            if (!b.contains(name)) {
                System.stdout.println("MISSING  " + name);
                i = i + 1;
                continue;
            }
            int32 ta = a.typeOf(i);
            int32 tb = b.typeOfName(name);
            if (ta != tb) {
                System.stdout.println("TYPE     " + name + ": "
                    + GgufFile.typeName(ta) + " vs " + GgufFile.typeName(tb));
                i = i + 1;
                continue;
            }
            int8[] ra #= a.loadRaw(name);
            int8[] rb #= b.loadRaw(name);
            int64 na = (int64) ra.count();
            int64 nb = (int64) rb.count();
            if (na != nb) {
                System.stdout.println("SIZE     " + name + ": " + na
                    + " vs " + nb + " bytes");
                i = i + 1;
                continue;
            }
            int64 diff = 0;
            int64 first = 0L - 1L;
            int64 k = 0;
            while (k < na) {
                if (ra[k] != rb[k]) {
                    if (first < 0L) { first = k; }
                    diff = diff + 1;
                }
                k = k + 1;
            }
            if (diff == 0) {
                same = same + 1;
                System.stdout.println("same     " + name + " ("
                    + GgufFile.typeName(ta) + ", " + na + " bytes)");
            } else {
                System.stdout.println("DIFFERS  " + name + ": " + diff
                    + " of " + na + " bytes, first at " + first);
            }
            i = i + 1;
        }
        System.stdout.println("ggufdiff: " + same + " of " + compared
            + " tensors identical");
        a.close();
        b.close();
        if (same == compared) { return 0; }
        return 1;
    }
}
