package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.tok.Tokenizer;

/** Print OUR token ids for a prompt, to compare against the HF reference
 *  (tools/tok/gen_llama_bpe_fixture.py). */
public class TokProbe {
    public static void run(String[] args) {
        Checkpoint ck #= Checkpoint.open(args[0]);
        Tokenizer t #= ck.gguf().tokenizer();
        int32[] ids #= t.encode(args[1]);
        String out #= "";
        int32 i = 0;
        while (i < (int32) ids.count()) {
            if (i > 0) { out #= out + ","; }
            out #= out + ids[i];
            i = i + 1;
        }
        System.stdout.println("ours: " + out);
        ck.close();
        return;
    }
}
