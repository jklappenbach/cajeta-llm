package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import dev.cajeta.llm.io.Quant;

/**
 * Is the q8_K INTEGER path actually faster than the f32 one?
 *
 * `Quant.q4kMatVecIntoQ8` has been written and unrouted since Unit 3, with
 * the note "nothing routes here until it is measured faster" and a recorded
 * 26.0 ms against the f32 path's 24.2. That measurement predates the fix
 * that made `dotAccum` carry TWO signedness flags instead of one — before
 * it, the unsigned-weight x signed-activation shape could not reach
 * `vpdpbusd` at all, so what was timed was a fallback tier, not VNNI.
 *
 * So it is re-measured rather than re-argued, on one weight, alternating
 * arm order, with the disassembly checked separately for the instruction.
 * Accuracy is reported alongside, because these two arms do NOT compute the
 * same thing: quantizing the activations to int8 is an approximation, and a
 * speedup that costs precision is a trade to state, not a free win.
 */
public class Q8DotProbe {
    static final int32 ROWS = 4096;
    static final int32 COLS = 4096;
    static final int32 ITERS = 8;

    public static void run() {
        int64 bpr = (int64) (Q8DotProbe.COLS / 256);
        int64 nbytes = (int64) Q8DotProbe.ROWS * bpr * 144L;
        System.stdout.println("Q4_K [" + Q8DotProbe.ROWS + " x "
            + Q8DotProbe.COLS + "]  " + ((float64) nbytes / 1048576.0) + " MB");

        int8[] packed #= heap int8[nbytes];
        ScalingProbe.fillBlocks(packed, Quant.GG_Q4_K, 1);

        float32[] x #= heap float32[(int64) Q8DotProbe.COLS];
        int64 i = 0;
        while (i < (int64) Q8DotProbe.COLS) {
            x[i] = 0.05f * (float32) ((i % 13L) - 6L);
            i = i + 1;
        }
        float32[] yA #= heap float32[(int64) Q8DotProbe.ROWS];
        float32[] yB #= heap float32[(int64) Q8DotProbe.ROWS];

        int8[] xq #= heap int8[(int64) Q8DotProbe.COLS];
        float32[] xd #= heap float32[bpr];
        int32[] xbs #= heap int32[bpr * 16L];

        // Correctness/accuracy FIRST, before any timing.
        Quant.q4kMatVecInto(packed, (int64) Q8DotProbe.ROWS,
            (int64) Q8DotProbe.COLS, x, 0L, yA, 0L);
        Quant.q8kQuantize(x, 0L, (int64) Q8DotProbe.COLS, xq, xd, xbs);
        Quant.q4kMatVecIntoQ8(packed, (int64) Q8DotProbe.ROWS,
            (int64) Q8DotProbe.COLS, xq, xd, xbs, yB, 0L);
        float32 worst = 0.0f;
        float32 mag = 0.0f;
        i = 0;
        while (i < (int64) Q8DotProbe.ROWS) {
            float32 d = yA[i] - yB[i];
            if (d < 0.0f) { d = 0.0f - d; }
            if (d > worst) { worst = d; }
            float32 a = yA[i] < 0.0f ? 0.0f - yA[i] : yA[i];
            if (a > mag) { mag = a; }
            i = i + 1;
        }
        System.stdout.println("accuracy: worst abs diff " + worst
            + " against max |y| " + mag + "  (relative "
            + (mag > 0.0f ? worst / mag : 0.0f) + ")");
        if (mag == 0.0f) {
            System.stdout.println("BOTH ARMS ARE ZERO - timing means nothing");
        }

        // Timing, alternating arm order per round.
        int32 r = 0;
        while (r < 4) {
            boolean f32First = (r - (r / 2) * 2) == 0;
            float64 tA = 0.0;
            float64 tB = 0.0;
            if (f32First) {
                tA = Q8DotProbe.timeF32(packed, x, yA);
                tB = Q8DotProbe.timeQ8(packed, x, xq, xd, xbs, yB);
            } else {
                tB = Q8DotProbe.timeQ8(packed, x, xq, xd, xbs, yB);
                tA = Q8DotProbe.timeF32(packed, x, yA);
            }
            System.stdout.println("round " + r + (f32First ? " (f32 first)"
                : " (q8 first)") + "   f32 " + tA + " ms   q8 " + tB
                + " ms   speedup " + (tA / tB));
            r = r + 1;
        }
        return;
    }

    static float64 timeF32(int8[] packed, float32[] x, float32[] y) {
        int64 t0 = Clock.nanoTime();
        int32 k = 0;
        while (k < Q8DotProbe.ITERS) {
            Quant.q4kMatVecInto(packed, (int64) Q8DotProbe.ROWS,
                (int64) Q8DotProbe.COLS, x, 0L, y, 0L);
            k = k + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) Q8DotProbe.ITERS;
    }

    /** The q8 arm INCLUDES the quantize, because a caller pays it. It is
     *  amortized over the projections sharing an activation, but never
     *  free, and hiding it would flatter this arm. */
    static float64 timeQ8(int8[] packed, float32[] x, int8[] xq,
            float32[] xd, int32[] xbs, float32[] y) {
        int64 t0 = Clock.nanoTime();
        int32 k = 0;
        while (k < Q8DotProbe.ITERS) {
            Quant.q8kQuantize(x, 0L, (int64) Q8DotProbe.COLS, xq, xd, xbs);
            Quant.q4kMatVecIntoQ8(packed, (int64) Q8DotProbe.ROWS,
                (int64) Q8DotProbe.COLS, xq, xd, xbs, y, 0L);
            k = k + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) Q8DotProbe.ITERS;
    }
}
