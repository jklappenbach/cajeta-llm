package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Barrier;
import cajeta.xpu.BlockPadded;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import dev.cajeta.llm.io.GgufFile;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;

/**
 * Mechanism spike for the mmq-shaped tiled batch GEMM (the llama.cpp
 * `mul_mmq` port). The tile kernel needs five things the Vulkan backend
 * has never run together in this engine: byte-element LDS tiles
 * (Shared<uint8> / Shared<int8>), vload/vstore ON the shared tile, a
 * workgroup barrier between stage and compute, cross-lane reads of
 * staged data, and dotAccum over vectors loaded from shared. Ownership
 * rules here are measured-not-reasoned; so is backend support — this
 * probe proves the mechanism BEFORE the 300-line kernel is written on
 * top of it, so a lowering gap surfaces as one wrong lane in a 64-line
 * table instead of garbage logits.
 *
 * Stage 1: each of 64 lanes stages its own 32-byte row of w (unsigned)
 * and x (signed) into LDS with vstore, barriers, then computes the
 * integer dot of its NEIGHBOR's rows ((lane+1)%64) via vload from LDS +
 * dotAccum. Wrong values name the broken verb; a hang names the barrier.
 */
public final class MmqProbe {

    @Kernel
    public static void ldsDotKernel(KernelBuffer<int32> out,
            KernelBuffer<int8> w, KernelBuffer<int8> x) {
        Shared<uint8> sw = shared uint8[64 * 32];
        Shared<int8> sx = shared int8[64 * 32];
        uint32 lane = KernelThread.x();
        int64 ro = (int64) lane * 32L;
        sw.vstore(ro, w.vload<32>(ro).asUnsigned());
        sx.vstore(ro, x.vload<32>(ro));
        Barrier.workgroup();
        uint32 peer = (lane + 1) % 64;
        int64 po = (int64) peer * 32L;
        Vector<uint8,32> wv = sw.vload<32>(po);
        Vector<int8,32> xv = sx.vload<32>(po);
        Vector<int32,8> zv = out.vload<8>(0) * 0;
        Vector<int32,8> t = wv.dotAccum(xv, zv);
        out[(int64) lane] = t[0] + t[1] + t[2] + t[3]
            + t[4] + t[5] + t[6] + t[7];
    }

    static int64 checkLdsDot() {
        int32 n = 64 * 32;
        int8[] w #= heap int8[n];
        int8[] x #= heap int8[n];
        int32 i = 0;
        while (i < n) {
            w[i] = (int8) ((i * 7 + 3) % 15);        // 0..14, reads as uint8
            x[i] = (int8) ((i * 11 + 5) % 17 - 8);   // -8..8
            i = i + 1;
        }
        int32[] outH #= heap int32[64];
        KernelBuffer<int8> wD = heap KernelBuffer<int8>((uint64) n);
        KernelBuffer<int8> xD = heap KernelBuffer<int8>((uint64) n);
        KernelBuffer<int32> oD = heap KernelBuffer<int32>((uint64) 64);
        wD.upload(w);
        xD.upload(x);
        KernelStream s = QuantKernel.stream();
        ldsDotKernel.launch(s, grid: [1], block: [64])(oD, wD, xD);
        s.sync();
        oD.download(outH);
        int64 bad = 0;
        int32 lane = 0;
        while (lane < 64) {
            int32 peer = (lane + 1) % 64;
            int32 want = 0;
            int32 k = 0;
            while (k < 32) {
                want = want + (int32) w[peer * 32 + k] * (int32) x[peer * 32 + k];
                k = k + 1;
            }
            if (outH[lane] != want) {
                if (bad < 5L) {
                    System.stdout.println("  ldsDot[" + lane + "]: got "
                        + outH[lane] + " want " + want);
                }
                bad = bad + 1;
            }
            lane = lane + 1;
        }
        return bad;
    }

    /**
     * Stage 2 — the tiled kernel against the token-proven Batch kernel
     * at a real prefill shape. Both fold identical per-block float
     * terms in the same block order, so agreement should be essentially
     * exact; a loose match would itself be a finding. Then wall-clock
     * for each over `iters` launches.
     */
    static int64 checkMmq(int64 rows, int64 outDim, int64 cols) {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q4_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<int8> xpD #= heap KernelBuffer<int8>(
            (uint64) (rows * Quant.q8kPackedBytes(cols)));
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wD.upload(raw);
        xfD.upload(x);
        QuantKernel.q8kPackLaunch(xpD, xfD, rows * cols);
        KernelStream s = QuantKernel.stream();

        KernelBuffer<int32> wW #= wD.wordView();
        KernelBuffer<int32> xpW #= xpD.wordView();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
            outDim, cols);
        s.sync();
        QuantKernel.q4kQ8MmqLaunchNoSync(yB, wW, xpW, rows, outDim, cols);
        s.sync();

        float32[] a #= heap float32[rows * outDim];
        float32[] g #= heap float32[rows * outDim];
        yA.download(a);
        yB.download(g);
        int64 bad = 0;
        i = 0;
        while (i < rows * outDim) {
            float32 diff = a[i] - g[i];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            if (diff > mag * 0.001f + 0.001f) {
                if (bad < 5L) {
                    System.stdout.println("  mmq[" + (i / outDim) + ","
                        + (i % outDim) + "]: got " + g[i] + " want " + a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }

        int32 iters = 5;
        int64 t0 = Clock.nanoTime();
        int32 it = 0;
        while (it < iters) {
            QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
                outDim, cols);
            it = it + 1;
        }
        s.sync();
        float64 msA = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            QuantKernel.q4kQ8MmqLaunchNoSync(yB, wW, xpW, rows, outDim,
                cols);
            it = it + 1;
        }
        s.sync();
        float64 msB = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        float64 tmacs = (float64) (rows * outDim * cols) / 1.0e12;
        System.stdout.println("  batch " + msA + " ms ("
            + (tmacs / (msA / 1000.0)) + " TMAC/s)   mmq " + msB
            + " ms (" + (tmacs / (msB / 1000.0)) + " TMAC/s)");
        return bad;
    }

    /**
     * Stage 3 — the Q6 twin against the token-proven Q6 batch kernel,
     * through the padded copy. Same near-exact expectation as stage 2.
     */
    static int64 checkMmq6(int64 rows, int64 outDim, int64 cols) {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q6_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q6_K);
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<int8> xpD #= heap KernelBuffer<int8>(
            (uint64) (rows * Quant.q8kPackedBytes(cols)));
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wD.upload(raw);
        xfD.upload(x);
        QuantKernel.q8kPackLaunch(xpD, xfD, rows * cols);
        KernelStream s = QuantKernel.stream();

        KernelBuffer<int8> padD #= heap KernelBuffer<int8>(
            (uint64) (blocks * 212L));
        QuantKernel.q6kPadLaunch(padD, wD, blocks);
        KernelBuffer<int32> padW #= padD.wordView();
        KernelBuffer<int32> xpW #= xpD.wordView();

        QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
            outDim, cols);
        s.sync();
        QuantKernel.q6kQ8MmqLaunchNoSync(yB, padW, xpW, rows, outDim,
            cols);
        s.sync();

        float32[] a #= heap float32[rows * outDim];
        float32[] g #= heap float32[rows * outDim];
        yA.download(a);
        yB.download(g);
        int64 bad = 0;
        i = 0;
        while (i < rows * outDim) {
            float32 diff = a[i] - g[i];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            if (diff > mag * 0.001f + 0.001f) {
                if (bad < 5L) {
                    System.stdout.println("  mmq6[" + (i / outDim) + ","
                        + (i % outDim) + "]: got " + g[i] + " want " + a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }

        int32 iters = 5;
        int64 t0 = Clock.nanoTime();
        int32 it = 0;
        while (it < iters) {
            QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
                outDim, cols);
            it = it + 1;
        }
        s.sync();
        float64 msA = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            QuantKernel.q6kQ8MmqLaunchNoSync(yB, padW, xpW, rows, outDim,
                cols);
            it = it + 1;
        }
        s.sync();
        float64 msB = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        // The Q6 coop twin, correctness + rate (128-multiple dims only).
        float64 msQ = 0.0;
        if (rows % 128L == 0L && outDim % 128L == 0L) {
            KernelBuffer<float16> xhD #= heap KernelBuffer<float16>(
                (uint64) (rows * cols));
            f32ToF16Kernel.launch(s,
                grid: [(uint32) ((rows * cols + 63L) / 64L)], block: [64])
                (xhD, xfD, (uint32) (rows * cols));
            QuantKernel.q6kF16CoopLaunchNoSync(yB, padW, xhD, rows,
                outDim, cols);
            s.sync();
            yB.download(g);
            i = 0;
            int64 cbad = 0;
            while (i < rows * outDim) {
                float32 diff = a[i] - g[i];
                if (diff < 0.0f) { diff = 0.0f - diff; }
                float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
                if (diff > mag * 0.02f + 0.05f) { cbad = cbad + 1; }
                i = i + 1;
            }
            t0 = Clock.nanoTime();
            it = 0;
            while (it < iters) {
                QuantKernel.q6kF16CoopLaunchNoSync(yB, padW, xhD, rows,
                    outDim, cols);
                it = it + 1;
            }
            s.sync();
            msQ = (float64) (Clock.nanoTime() - t0) / 1000000.0
                / (float64) iters;
            System.stdout.println("  q6coop bad(2%+0.05): " + cbad);
        }
        float64 tmacs = (float64) (rows * outDim * cols) / 1.0e12;
        System.stdout.println("  q6batch " + msA + " ms ("
            + (tmacs / (msA / 1000.0)) + " TMAC/s)   q6mmq " + msB
            + " ms (" + (tmacs / (msB / 1000.0)) + " TMAC/s)   q6coop "
            + msQ + " ms (" + (tmacs / (msQ / 1000.0)) + " TMAC/s)");
        return bad;
    }

    /**
     * Stage 4 — the f16 COOPMAT road (llama.cpp's 0.43s architecture):
     * dequantize Q4_K per-tile into LDS as float16 (scales folded at
     * staging — no epilogue verbs, so the tiles stay on the NATIVE
     * KHR-coopmat tier), then a plain f16x f16 -> f32 mma. v0 is the
     * correctness shape: one wave per 16x16 output tile, scalar
     * dequant staging, activations pre-converted to f16. The f16
     * rounding of the dequantized weights means agreement with the
     * integer kernels is APPROXIMATE by design — the probe reports the
     * relative error distribution; llama.cpp's coopmat path makes the
     * same trade.
     */
    @Kernel
    public static void q4kF16CoopKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 rows, uint32 outDim, uint32 nColTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[16 * 256];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 to = wg % nColTiles;       // output-row tile (weights)
        uint32 tt = wg / nColTiles;       // token tile
        int64 rowWords = blocksPerRow * 36L;
        CooperativeMatrix<float32,16,16,2> acc;
        acc.splat(0.0f);
        int64 b = 0;
        while (b < blocksPerRow) {
            // Stage: 16 rows x 256 cols dequantized to f16. Lanes 0..15
            // each own one row; a lane walks its row's 8 nibble groups.
            if (lane < 16) {
                uint32 gRow = to * 16 + lane;
                int64 ro = (int64) gRow * rowWords + b * 36L;
                Vector<int32,4> hw = packed.vload<4>(ro);
                int32 h0 = hw[0];
                float32 d = GgufFile.halfBitsToF32(h0 & 65535);
                float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
                int32 hA = hw[1];
                int32 hB = hw[2];
                int32 hC = hw[3];
                int64 sb = (int64) lane * 256L;
                int32 g = 0;
                while (g < 4) {
                    // Raw group g's lo nibbles are quant group 2g and its
                    // hi nibbles group 2g+1; groups 0..3 use the d-byte
                    // scale form, 4..7 the k-mixed form (Q4_K header).
                    int32 i0 = 2 * g;
                    int32 i1 = 2 * g + 1;
                    int32 sLoRaw = 0;
                    int32 sHiRaw = 0;
                    int32 mLoRaw = 0;
                    int32 mHiRaw = 0;
                    if (g < 2) {
                        sLoRaw = (hA >> (8 * i0)) & 63;
                        sHiRaw = (hA >> (8 * i1)) & 63;
                        mLoRaw = (hB >> (8 * i0)) & 63;
                        mHiRaw = (hB >> (8 * i1)) & 63;
                    } else {
                        int32 j0 = i0 - 4;
                        int32 j1 = i1 - 4;
                        int32 kA = (hC >> (8 * j0)) & 255;
                        int32 kB2 = (hC >> (8 * j1)) & 255;
                        int32 dA = (hA >> (8 * j0)) & 255;
                        int32 dB2 = (hA >> (8 * j1)) & 255;
                        int32 mA = (hB >> (8 * j0)) & 255;
                        int32 mB2 = (hB >> (8 * j1)) & 255;
                        sLoRaw = (kA & 15) | ((dA >> 2) & 48);
                        sHiRaw = (kB2 & 15) | ((dB2 >> 2) & 48);
                        mLoRaw = (kA >> 4) | ((mA >> 2) & 48);
                        mHiRaw = (kB2 >> 4) | ((mB2 >> 2) & 48);
                    }
                    float32 scLo = d * (float32) sLoRaw;
                    float32 mnLo = dmin * (float32) mLoRaw;
                    float32 scHi = d * (float32) sHiRaw;
                    float32 mnHi = dmin * (float32) mHiRaw;
                    Vector<int32,8> qw = packed.vload<8>(
                        ro + 4L + (int64) (8 * g));
                    int32 e = 0;
                    while (e < 8) {
                        int32 w = qw[e];
                        int32 bb = 0;
                        while (bb < 4) {
                            int32 by = (w >> (8 * bb)) & 255;
                            int64 ci = (int64) (64 * g + 4 * e + bb);
                            sa[sb + ci] = (float16) (scLo
                                * (float32) (by & 15) - mnLo);
                            sa[sb + ci + 32L] = (float16) (scHi
                                * (float32) ((by >> 4) & 15) - mnHi);
                            bb = bb + 1;
                        }
                        e = e + 1;
                    }
                    g = g + 1;
                }
            }
            Barrier.workgroup();
            // 16 k-steps over the staged 256-column slab.
            int32 kt = 0;
            while (kt < 16) {
                CooperativeMatrix<float16,16,16,0> ta;
                CooperativeMatrix<float16,16,16,1> tb;
                ta.load(sa, (uint32) (16 * kt), 0, 256);
                // B pre-transposed on the host: xh is [cols x rows]
                // row-major, so the (k, t) tile loads row-major — no
                // layout=1 anywhere until its SPIR-V lowering is verified.
                tb.load(xh, (uint32) ((b * 256L + (int64) (16 * kt))
                    * (int64) rows + (int64) (tt * 16)), 0, rows);
                acc.mma(ta, tb);
                kt = kt + 1;
            }
            Barrier.workgroup();
            b = b + 1;
        }
        // Row-major store into yT [outDim x rows]; the host transposes.
        acc.store(y, (uint32) ((int64) (to * 16) * (int64) rows
            + (int64) (tt * 16)), 0, rows);
    }

    @Kernel
    public static void f32ToF16Kernel(KernelBuffer<float16> dst,
            KernelBuffer<float32> src, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            dst[(int64) i] = (float16) src[(int64) i];
        }
    }

    /** Stage 4 driver: correctness stats + wall-clock vs the mmq route. */
    static int64 checkCoopF16(int64 rows, int64 outDim, int64 cols) {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q4_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<int8> xpD #= heap KernelBuffer<int8>(
            (uint64) (rows * Quant.q8kPackedBytes(cols)));
        float32[] xT #= heap float32[rows * cols];
        i = 0;
        while (i < rows) {
            int64 k = 0;
            while (k < cols) {
                xT[k * rows + i] = x[i * cols + k];
                k = k + 1;
            }
            i = i + 1;
        }
        KernelBuffer<float32> xtD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<float16> xhD #= heap KernelBuffer<float16>(
            (uint64) (rows * cols));
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wD.upload(raw);
        xfD.upload(x);
        xtD.upload(xT);
        QuantKernel.q8kPackLaunch(xpD, xfD, rows * cols);
        KernelStream s = QuantKernel.stream();
        f32ToF16Kernel.launch(s,
            grid: [(uint32) ((rows * cols + 63L) / 64L)], block: [64])
            (xhD, xtD, (uint32) (rows * cols));
        s.sync();

        KernelBuffer<int32> wW #= wD.wordView();
        KernelBuffer<int32> xpW #= xpD.wordView();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
            outDim, cols);
        s.sync();
        int64 nCt = outDim / 16L;
        int64 nWg = nCt * (rows / 16L);
        q4kF16CoopKernel.launch(s, grid: [(uint32) nWg], block: [32])
            (yB, wW, xhD, (uint32) rows, (uint32) outDim, (uint32) nCt,
             cols / 256L);
        s.sync();

        float32[] a #= heap float32[rows * outDim];
        float32[] g #= heap float32[rows * outDim];
        yA.download(a);
        yB.download(g);
        int64 bad = 0;
        float64 worst = 0.0;
        i = 0;
        while (i < rows * outDim) {
            int64 tt2 = i / outDim;
            int64 oo = i % outDim;
            float32 gv = g[oo * rows + tt2];
            float32 diff = a[i] - gv;
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            float64 rel = (float64) diff / ((float64) mag + 1.0);
            if (rel > worst) { worst = rel; }
            if (diff > mag * 0.02f + 0.05f) {
                if (bad < 5L) {
                    System.stdout.println("  coop[" + tt2 + ","
                        + oo + "]: got " + gv + " want " + a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }
        System.stdout.println("  coopF16 worstRel(+1): " + worst);

        int32 iters = 5;
        int64 t0 = Clock.nanoTime();
        int32 it = 0;
        while (it < iters) {
            q4kF16CoopKernel.launch(s, grid: [(uint32) nWg], block: [32])
                (yB, wW, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nCt, cols / 256L);
            it = it + 1;
        }
        s.sync();
        float64 msC = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            QuantKernel.q4kQ8MmqLaunchNoSync(yB, wW, xpW, rows, outDim,
                cols);
            it = it + 1;
        }
        s.sync();
        float64 msM = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        float64 tmacs = (float64) (rows * outDim * cols) / 1.0e12;
        System.stdout.println("  coopF16 " + msC + " ms ("
            + (tmacs / (msC / 1000.0)) + " TMAC/s)   mmq " + msM
            + " ms (" + (tmacs / (msM / 1000.0)) + " TMAC/s)");
        return bad;
    }

    /**
     * Stage 6 — the v1 f16-coopmat GEMM, llama.cpp's mul_mm large config
     * verbatim (their 0.43 s prefill shape on this GPU): BM=128 weight
     * rows x BN=128 tokens per workgroup of 128 threads (4 wave32
     * subgroups), BK=32 k-slice per stage. Each subgroup owns a 64x64
     * quadrant = 4x4 fragments of 16x16x16 f16 mma with f32 accumulate.
     * Q4_K is dequantized to f16 AT STAGING with scales folded (one
     * thread per weight row, one scale group per BK step — their
     * trade: the 16-byte header re-read per step stays in L1). B loads
     * col-major from Shared and the accumulators store col-major
     * straight into y's [tokens x outDim] layout — both verified by
     * stage 5, so there is NO transpose anywhere. All dims must be
     * multiples of 128 (tokens padded by the caller; every weight shape
     * in the 8B is already a multiple: 1024/4096/14336/128256).
     */
    @Kernel
    public static void q4kF16CoopV1Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 40];
        Shared<float16> sb = shared float16[128 * 40];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 to = wg % nRowTiles;       // weight-row tile
        uint32 tt = wg / nRowTiles;       // token tile
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;            // weight quadrant
        uint32 warpC = sg / 2;            // token quadrant
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 blk = kb >> 3;
            int32 gq = (int32) (kb & 7L);
            // A: thread `lane` dequantizes weight row (to*128+lane)'s
            // 32-wide k-slice (scale group gq of superblock blk).
            int64 ro = ((int64) (to * 128 + lane)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 sBase = (int64) lane * 40L;
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 by = (w >> (8 * bi)) & 255;
                    int32 q = (by >> nib) & 15;
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            // B: thread `lane` copies token row (tt*128+lane)'s 32-wide
            // k-slice of the f16 activations.
            int64 xBase = ((int64) (tt * 128 + lane)) * cols + kb * 32L;
            // Vectorized f16 vload/vstore staging was MEASURED FLAT here
            // (5.17 vs 5.23 TMAC/s at K=4096, 4.58 vs 5.45 at K=14336,
            // 2026-08-25): B staging is not the constraint, and longer K
            // getting SLOWER points at per-iteration overhead (barriers)
            // rather than staging bandwidth. Keep the scalar copy.
            int32 jj = 0;
            while (jj < 32) {
                sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                jj = jj + 1;
            }
            Barrier.workgroup();
            // Two 16-deep mma steps over the staged 32-slice.
            int32 ks = 0;
            while (ks < 2) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 40 + ko;
                uint32 bb2 = (warpC * 64) * 40 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 40);
                t1.load(sa, ab + 640, 0, 40);
                t2.load(sa, ab + 1280, 0, 40);
                t3.load(sa, ab + 1920, 0, 40);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 40);
                u1.load(sb, bb2 + 640, 1, 40);
                u2.load(sb, bb2 + 1280, 1, 40);
                u3.load(sb, bb2 + 1920, 1, 40);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 1;
        }
        // Col-major store: fragment (r=weight, c=token) lands at
        // y[tokBase + c][rowBase + r] — y's native layout, no staging.
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }

    /** Stage 6 driver: exactness stats vs the dp4a batch reference and
     *  wall-clock vs the mmq kernel, natural (untransposed) layouts. */
    static int64 checkCoopV1(int64 rows, int64 outDim, int64 cols) {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q4_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        KernelBuffer<int8> xpD #= heap KernelBuffer<int8>(
            (uint64) (rows * Quant.q8kPackedBytes(cols)));
        KernelBuffer<float16> xhD #= heap KernelBuffer<float16>(
            (uint64) (rows * cols));
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        wD.upload(raw);
        xfD.upload(x);
        QuantKernel.q8kPackLaunch(xpD, xfD, rows * cols);
        KernelStream s = QuantKernel.stream();
        f32ToF16Kernel.launch(s,
            grid: [(uint32) ((rows * cols + 63L) / 64L)], block: [64])
            (xhD, xfD, (uint32) (rows * cols));
        s.sync();

        KernelBuffer<int32> wW #= wD.wordView();
        KernelBuffer<int32> xpW #= xpD.wordView();
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yA, wD, xpD, rows,
            outDim, cols);
        s.sync();
        int64 nRt = outDim / 128L;
        int64 nWg = nRt * (rows / 128L);
        q4kF16CoopV1Kernel.launch(s, grid: [(uint32) nWg], block: [128])
            (yB, wW, xhD, (uint32) rows, (uint32) outDim, (uint32) nRt,
             cols / 256L);
        s.sync();

        float32[] a #= heap float32[rows * outDim];
        float32[] g #= heap float32[rows * outDim];
        yA.download(a);
        yB.download(g);
        int64 bad = 0;
        float64 worst = 0.0;
        i = 0;
        while (i < rows * outDim) {
            float32 diff = a[i] - g[i];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            float64 rel = (float64) diff / ((float64) mag + 1.0);
            if (rel > worst) { worst = rel; }
            if (diff > mag * 0.02f + 0.05f) {
                if (bad < 5L) {
                    System.stdout.println("  coopV1[" + (i / outDim) + ","
                        + (i % outDim) + "]: got " + g[i] + " want "
                        + a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }
        System.stdout.println("  coopV1 worstRel(+1): " + worst);

        int32 iters = 5;
        int64 t0 = Clock.nanoTime();
        int32 it = 0;
        while (it < iters) {
            q4kF16CoopV1Kernel.launch(s, grid: [(uint32) nWg],
                block: [128])
                (yB, wW, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nRt, cols / 256L);
            it = it + 1;
        }
        s.sync();
        float64 msC = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        // SERIAL COLD rate: sync per launch, alternating two weight
        // buffers so every launch reads cold — the engine's dependency-
        // chained, stream-of-different-layers reality. (Sustained-load
        // clock sag and residency pressure were both probed and REFUTED
        // 2026-08-25; the engine's remaining 2x over these numbers was
        // FIRST-TOUCH page commit — see PackedResident's warm arm.)
        KernelBuffer<int8> wD2 #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        wD2.upload(raw);
        KernelBuffer<int32> wW2 #= wD2.wordView();
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            KernelBuffer<int32> wPick = wW;
            if (it % 2 == 1) { wPick = wW2; }
            q4kF16CoopV1Kernel.launch(s, grid: [(uint32) nWg],
                block: [128])
                (yB, wPick, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nRt, cols / 256L);
            s.sync();
            it = it + 1;
        }
        float64 msS = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        // mma CEILING (garbage output by construction, timing only).
        q4kF16CoopCeilKernel.launch(s, grid: [(uint32) nWg],
            block: [128])
            (yB, wW, xhD, (uint32) rows, (uint32) outDim, (uint32) nRt,
             cols / 256L);
        s.sync();
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            q4kF16CoopCeilKernel.launch(s, grid: [(uint32) nWg],
                block: [128])
                (yB, wW, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nRt, cols / 256L);
            it = it + 1;
        }
        s.sync();
        float64 msCe = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            QuantKernel.q4kQ8MmqLaunchNoSync(yB, wW, xpW, rows, outDim,
                cols);
            it = it + 1;
        }
        s.sync();
        float64 msM = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        float64 tmacs = (float64) (rows * outDim * cols) / 1.0e12;
        System.stdout.println("  coopV1 " + msC + " ms ("
            + (tmacs / (msC / 1000.0)) + " TMAC/s)   serialCold " + msS
            + " ms (" + (tmacs / (msS / 1000.0)) + " TMAC/s)   mmq "
            + msM + " ms (" + (tmacs / (msM / 1000.0)) + " TMAC/s)");
        System.stdout.println("  coopCEIL " + msCe + " ms ("
            + (tmacs / (msCe / 1000.0)) + " TMAC/s)");
        // V7 (V5+BK64, the SHIPPED shape): correctness + warm + cold.
        int64 v7bad = 0;
        {
            q4kF16CoopV7Kernel.launch(s, grid: [(uint32) nWg],
                block: [128])
                (yB, wW, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nRt, cols / 256L);
            s.sync();
            yB.download(g);
            i = 0;
            while (i < rows * outDim) {
                float32 diff = a[i] - g[i];
                if (diff < 0.0f) { diff = 0.0f - diff; }
                float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
                if (diff > mag * 0.02f + 0.05f) { v7bad = v7bad + 1; }
                i = i + 1;
            }
            t0 = Clock.nanoTime();
            it = 0;
            while (it < iters) {
                q4kF16CoopV7Kernel.launch(s, grid: [(uint32) nWg],
                    block: [128])
                    (yB, wW, xhD, (uint32) rows, (uint32) outDim,
                     (uint32) nRt, cols / 256L);
                it = it + 1;
            }
            s.sync();
            float64 msV7 = (float64) (Clock.nanoTime() - t0) / 1000000.0
                / (float64) iters;
            t0 = Clock.nanoTime();
            it = 0;
            while (it < iters) {
                KernelBuffer<int32> wPickI = wW;
                if (it % 2 == 1) { wPickI = wW2; }
                q4kF16CoopV7Kernel.launch(s, grid: [(uint32) nWg],
                    block: [128])
                    (yB, wPickI, xhD, (uint32) rows, (uint32) outDim,
                     (uint32) nRt, cols / 256L);
                s.sync();
                it = it + 1;
            }
            float64 msV7S = (float64) (Clock.nanoTime() - t0)
                / 1000000.0 / (float64) iters;
            System.stdout.println("  coopV7 bad " + v7bad + "  warm "
                + msV7 + " ms (" + (tmacs / (msV7 / 1000.0))
                + " TMAC/s)   serialCold " + msV7S + " ms ("
                + (tmacs / (msV7S / 1000.0)) + " TMAC/s)");
        }
        // V5 token-fastest order: correctness + warm + serial-cold.
        q4kF16CoopV5Kernel.launch(s, grid: [(uint32) nWg], block: [128])
            (yB, wW, xhD, (uint32) rows, (uint32) outDim, (uint32) nRt,
             cols / 256L);
        s.sync();
        yB.download(g);
        int64 v5bad = 0;
        i = 0;
        while (i < rows * outDim) {
            float32 diff = a[i] - g[i];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            if (diff > mag * 0.02f + 0.05f) { v5bad = v5bad + 1; }
            i = i + 1;
        }
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            q4kF16CoopV5Kernel.launch(s, grid: [(uint32) nWg],
                block: [128])
                (yB, wW, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nRt, cols / 256L);
            it = it + 1;
        }
        s.sync();
        float64 msV5 = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        t0 = Clock.nanoTime();
        it = 0;
        while (it < iters) {
            KernelBuffer<int32> wPickF = wW;
            if (it % 2 == 1) { wPickF = wW2; }
            q4kF16CoopV5Kernel.launch(s, grid: [(uint32) nWg],
                block: [128])
                (yB, wPickF, xhD, (uint32) rows, (uint32) outDim,
                 (uint32) nRt, cols / 256L);
            s.sync();
            it = it + 1;
        }
        float64 msV5S = (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) iters;
        System.stdout.println("  coopV5 bad " + v5bad + "  warm " + msV5
            + " ms (" + (tmacs / (msV5 / 1000.0)) + " TMAC/s)   serialCold "
            + msV5S + " ms (" + (tmacs / (msV5S / 1000.0)) + " TMAC/s)");
        return bad + v5bad + v7bad;
    }

    /**
     * Stage 7a — the mma CEILING: stage ONE tile, then run every
     * k-iteration's mma against it. Timing-only (output is garbage by
     * construction); barriers stay in the loop so nothing hoists.
     * Validate the instrument by shape: time must scale ~linearly with
     * cols (the k-loop trip count).
     */
    @Kernel
    public static void q4kF16CoopCeilKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 40];
        Shared<float16> sb = shared float16[128 * 40];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 to = wg % nRowTiles;
        uint32 tt = wg / nRowTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        // Stage tile 0 only, V1's scalar scheme.
        int64 ro = ((int64) (to * 128 + lane)) * rowWords;
        Vector<int32,4> hw = packed.vload<4>(ro);
        int32 h0 = hw[0];
        float32 d = GgufFile.halfBitsToF32(h0 & 65535);
        float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
        int32 sRaw = (hw[1]) & 63;
        int32 mRaw = (hw[2]) & 63;
        float32 sc = d * (float32) sRaw;
        float32 mn = dmin * (float32) mRaw;
        Vector<int32,8> qw = packed.vload<8>(ro + 4L);
        int64 sBase = (int64) lane * 40L;
        int32 e = 0;
        while (e < 8) {
            int32 w = qw[e];
            int32 bi = 0;
            while (bi < 4) {
                int32 by = (w >> (8 * bi)) & 255;
                sa[sBase + (int64) (4 * e + bi)] = (float16)
                    (sc * (float32) (by & 15) - mn);
                bi = bi + 1;
            }
            e = e + 1;
        }
        int64 xBase = ((int64) (tt * 128 + lane)) * cols;
        int32 jj = 0;
        while (jj < 32) {
            sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
            jj = jj + 1;
        }
        int64 kb = 0;
        while (kb < kBlocks) {
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 2) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 40 + ko;
                uint32 bb2 = (warpC * 64) * 40 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 40);
                t1.load(sa, ab + 640, 0, 40);
                t2.load(sa, ab + 1280, 0, 40);
                t3.load(sa, ab + 1920, 0, 40);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 40);
                u1.load(sb, bb2 + 640, 1, 40);
                u2.load(sb, bb2 + 1280, 1, 40);
                u3.load(sb, bb2 + 1920, 1, 40);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 1;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }




    // ── Staging-arc ledger (2026-08-25) — refuted variants kept as
    // prose so they are not retried. Baseline V1 5.2-5.4 TMAC/s,
    // no-load CEIL 10.4-11.0 (the kernel is DRAM-BANDWIDTH-bound):
    //   V2  thread-spread staging (llama.cpp's LOAD_VEC mapping):
    //       3.1-3.8 — 8x redundant header loads/ALU cost more than
    //       the cross-lane scatter ever did.
    //   V3  ping-pong LDS double-buffer: 3.4 — 40 KB halved
    //       occupancy and lost more than the barrier removal won.
    //   XL  BM256 amortization: flat — the wall is per-iteration
    //       stage latency + mma, and XL changed neither.
    //   V4  register prefetch: flat-to-mixed; V6 (V4+V5) confirmed
    //       prefetch also loses when combined with the order fix.
    //   W64 llama.cpp's 2-warp wave64 layout (via the runtime's
    //       "W64" entry-name subgroup contract — the contract WORKS
    //       and stays): 3.7-4.1 — both warps duplicate all 8
    //       A-fragment loads and RDNA3 issues wave64 WMMA twice.
    // What won and SHIPPED: V5 token-fastest order (+80% serialCold
    // at 4096^2, MALL reuse) and V7 BK64 (+17%/+48%, barriers).

    /**
     * Stage 7i — V7 = V5 + BK64: two 32-slices staged per barrier
     * pair (stride 72, LDS 36 KB, 4 mma k-steps), halving the barrier
     * count. V5 rationale: Four latency rearrangements (V2 spread, V3 ping-pong,
     * XL amortize, V4 prefetch) all measured flat-to-worse while CEIL
     * (no loads) doubles — the kernel is DRAM-BANDWIDTH-bound (~250
     * GB/s of traffic: weights re-read once per token tile). Row-
     * fastest order puts a weight slab's 4 token-tile reads ~a full
     * sweep apart, past MALL retention; token-fastest makes them
     * co-resident so 3 of 4 reads hit cache. Traffic, not latency.
     */
    @Kernel
    public static void q4kF16CoopV7Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        Shared<float16> sb = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
          int32 halfSel = 0;
          while (halfSel < 2) {
            int64 kbh = kb + (int64) halfSel;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + lane)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 sBase = (int64) lane * 72L + (int64) (32 * halfSel);
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 by = (w >> (8 * bi)) & 255;
                    int32 q = (by >> nib) & 15;
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            int64 xBase = ((int64) (tt * 128 + lane)) * cols
                + kbh * 32L;
            int32 jj = 0;
            while (jj < 32) {
                sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                jj = jj + 1;
            }
            halfSel = halfSel + 1;
          }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (warpC * 64) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                u2.load(sb, bb2 + 2304, 1, 72);
                u3.load(sb, bb2 + 3456, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }
    /**
     * Stage 7f — V5: TOKEN-FASTEST workgroup order, otherwise V1
     * verbatim. Four latency rearrangements (V2 spread, V3 ping-pong,
     * XL amortize, V4 prefetch) all measured flat-to-worse while CEIL
     * (no loads) doubles — the kernel is DRAM-BANDWIDTH-bound (~250
     * GB/s of traffic: weights re-read once per token tile). Row-
     * fastest order puts a weight slab's 4 token-tile reads ~a full
     * sweep apart, past MALL retention; token-fastest makes them
     * co-resident so 3 of 4 reads hit cache. Traffic, not latency.
     */
    @Kernel
    public static void q4kF16CoopV5Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 40];
        Shared<float16> sb = shared float16[128 * 40];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 blk = kb >> 3;
            int32 gq = (int32) (kb & 7L);
            int64 ro = ((int64) (to * 128 + lane)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 sBase = (int64) lane * 40L;
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 by = (w >> (8 * bi)) & 255;
                    int32 q = (by >> nib) & 15;
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            int64 xBase = ((int64) (tt * 128 + lane)) * cols + kb * 32L;
            int32 jj = 0;
            while (jj < 32) {
                sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                jj = jj + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 2) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 40 + ko;
                uint32 bb2 = (warpC * 64) * 40 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 40);
                t1.load(sa, ab + 640, 0, 40);
                t2.load(sa, ab + 1280, 0, 40);
                t3.load(sa, ab + 1920, 0, 40);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 40);
                u1.load(sb, bb2 + 640, 1, 40);
                u2.load(sb, bb2 + 1280, 1, 40);
                u3.load(sb, bb2 + 1920, 1, 40);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 1;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }



    /**
     * Stage 5 — coopmat layout=1 (column-major) SEMANTICS, the two
     * operations v0 sidestepped and llama.cpp's mul_mm depends on: a
     * col-major B load (from a buffer AND from Shared) and a col-major
     * accumulator store. Each check computes I x f(M) with integer-valued
     * f16s, so the expected result is EXACTLY M^T — any mis-lowering is a
     * hard mismatch, never a tolerance call.
     */
    @Kernel
    public static void coopLayoutProbeKernel(KernelBuffer<float32> y0,
            KernelBuffer<float32> y1, KernelBuffer<float32> y2,
            KernelBuffer<float16> m) {
        Shared<float16> si = shared float16[256];
        Shared<float16> sm = shared float16[256];
        uint32 lane = KernelThread.x();
        uint32 idx = lane;
        while (idx < 256) {
            float16 v = (float16) 0.0f;
            if (idx / 16 == idx % 16) {
                v = (float16) 1.0f;
            }
            si[(int64) idx] = v;
            sm[(int64) idx] = m[(int64) idx];
            idx = idx + 32;
        }
        Barrier.workgroup();
        CooperativeMatrix<float16,16,16,0> ta;
        ta.load(si, 0, 0, 16);
        // (a) col-major B load from a BUFFER: B = M^T, y0 = I x M^T.
        CooperativeMatrix<float16,16,16,1> tb0;
        tb0.load(m, 0, 1, 16);
        CooperativeMatrix<float32,16,16,2> a0;
        a0.splat(0.0f);
        a0.mma(ta, tb0);
        a0.store(y0, 0, 0, 16);
        // (b) col-major B load from SHARED: same expectation.
        CooperativeMatrix<float16,16,16,1> tb1;
        tb1.load(sm, 0, 1, 16);
        CooperativeMatrix<float32,16,16,2> a1;
        a1.splat(0.0f);
        a1.mma(ta, tb1);
        a1.store(y1, 0, 0, 16);
        // (c) col-major STORE: y2 = M stored col-major, read back = M^T.
        CooperativeMatrix<float16,16,16,1> tb2;
        tb2.load(m, 0, 0, 16);
        CooperativeMatrix<float32,16,16,2> a2;
        a2.splat(0.0f);
        a2.mma(ta, tb2);
        a2.store(y2, 0, 1, 16);
    }

    static int64 checkCoopLayout() {
        KernelStream s #= QuantKernel.stream();
        float32[] mh #= heap float32[256];
        int64 i = 0;
        while (i < 256L) {
            mh[i] = (float32) i;
            i = i + 1;
        }
        KernelBuffer<float32> mf #= heap KernelBuffer<float32>(
            (uint64) 256);
        mf.upload(mh);
        KernelBuffer<float16> m #= heap KernelBuffer<float16>(
            (uint64) 256);
        f32ToF16Kernel.launch(s, grid: [1], block: [256])(m, mf, 256);
        KernelBuffer<float32> y0 #= heap KernelBuffer<float32>(
            (uint64) 256);
        KernelBuffer<float32> y1 #= heap KernelBuffer<float32>(
            (uint64) 256);
        KernelBuffer<float32> y2 #= heap KernelBuffer<float32>(
            (uint64) 256);
        coopLayoutProbeKernel.launch(s, grid: [1], block: [32])(
            y0, y1, y2, m);
        s.sync();
        float32[] h0 #= heap float32[256];
        float32[] h1 #= heap float32[256];
        float32[] h2 #= heap float32[256];
        y0.download(h0);
        y1.download(h1);
        y2.download(h2);
        int64 bad = 0;
        int64 r = 0;
        while (r < 16L) {
            int64 c = 0;
            while (c < 16L) {
                float32 want = mh[c * 16L + r];
                if (h0[r * 16L + c] != want) { bad = bad + 1L; }
                if (h1[r * 16L + c] != want) { bad = bad + 2L; }
                if (h2[r * 16L + c] != want) { bad = bad + 4L; }
                c = c + 1L;
            }
            r = r + 1L;
        }
        return bad;
    }

    public static int32 run() {
        System.stdout.println("backend: " + Device.activeBackend());
        int64 b0 = MmqProbe.checkCoopLayout();
        System.stdout.println("stage5 coop layout=1 (bufLoad+1/shLoad+2/"
            + "store+4 per element): " + b0 + " (0 = all three verified)");
        int64 b1 = MmqProbe.checkLdsDot();
        System.stdout.println("stage1 lds vload/vstore/barrier/dotAccum: "
            + b1 + "/64 wrong");
        int64 b2 = MmqProbe.checkMmq(512L, 4096L, 4096L);
        System.stdout.println("stage2 mmq@512x4096x4096: " + b2
            + "/2097152 wrong");
        int64 b3 = MmqProbe.checkMmq6(512L, 1024L, 4096L);
        System.stdout.println("stage3 q6mmq@512x1024x4096: " + b3
            + "/524288 wrong");
        int64 b4 = MmqProbe.checkMmq6(512L, 4096L, 14336L);
        System.stdout.println("stage3b q6mmq@512x4096x14336: " + b4
            + "/2097152 wrong");
        MmqProbe.checkCoopF16(16L, 16L, 256L);
        int64 b5 = MmqProbe.checkCoopF16(512L, 4096L, 4096L);
        System.stdout.println("stage4 coopF16@512x4096x4096: " + b5
            + "/2097152 outside 2%+0.05");
        MmqProbe.checkCoopV1(128L, 128L, 256L);
        int64 b6 = MmqProbe.checkCoopV1(512L, 4096L, 4096L);
        System.stdout.println("stage6 coopV1@512x4096x4096: " + b6
            + "/2097152 outside 2%+0.05");
        int64 b7 = MmqProbe.checkCoopV1(512L, 4096L, 14336L);
        System.stdout.println("stage6b coopV1@512x4096x14336: " + b7
            + "/2097152 outside 2%+0.05");
        return (b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7) == 0L ? 0 : 1;
    }
}
