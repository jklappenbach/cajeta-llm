package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;

/**
 * ROWS PER LAUNCH — the GPU's launch-shape curve, measured in isolation.
 *
 * The end-to-end run said a 411 MB Q6_K weight streams at 9.9 GB/s in one
 * dispatch while the SAME kernel on a 46 MB weight reaches 90, and that
 * slicing the big one into 16 MiB pieces takes it to 104. That measurement
 * is real but confounded: every shape in a token shares one queue, one
 * cache and one driver, so changing the chunk rule changes the conditions
 * every other shape runs under. The sweep there came back non-monotonic,
 * which is what a confounded measurement looks like.
 *
 * Here there is ONE weight, resident, and one variable: how many output
 * rows a single dispatch covers. Total bytes read, total arithmetic and
 * the per-work-item access pattern are identical across every point on the
 * curve — only the grid size and the count of dispatches move.
 *
 * It also carries its own correctness control. A row slice is only a valid
 * optimization if the answer does not change, so the probe compares a
 * chunked pass against a whole-weight pass element by element and reports
 * the first mismatch. A speedup that changes the output is not a speedup.
 */
public class LaunchShapeProbe {
    static final int32 COLS = 4096;
    static final int32 ROWS = 131072;      // 420 MB of Q6_K, lm_head scale
    static final int32 REPS = 3;

    public static void run() {
        int64 bpr = (int64) (LaunchShapeProbe.COLS / 256) * 210L;
        int64 nbytes = (int64) LaunchShapeProbe.ROWS * bpr;
        System.stdout.println("Q6_K [" + LaunchShapeProbe.ROWS + " x "
            + LaunchShapeProbe.COLS + "]  " + ((float64) nbytes / 1048576.0)
            + " MB  rowBytes " + bpr);

        int8[] packed #= heap int8[nbytes];
        LaunchShapeProbe.fill(packed);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>((uint64) nbytes);
        pb.upload(packed);

        float32[] hx #= heap float32[(int64) LaunchShapeProbe.COLS];
        int64 i = 0;
        while (i < (int64) LaunchShapeProbe.COLS) {
            hx[i] = 0.01f * (float32) (i % 7L);
            i = i + 1;
        }
        KernelBuffer<float32> xb #= heap KernelBuffer<float32>(
            (uint64) LaunchShapeProbe.COLS);
        xb.upload(hx);
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>(
            (uint64) LaunchShapeProbe.ROWS);

        // ── correctness control, BEFORE any timing ──────────────────────
        float32[] whole #= heap float32[(int64) LaunchShapeProbe.ROWS];
        float32[] sliced #= heap float32[(int64) LaunchShapeProbe.ROWS];
        LaunchShapeProbe.pass(yb, pb, xb, (int64) LaunchShapeProbe.ROWS,
            (int64) LaunchShapeProbe.ROWS, bpr);
        yb.download(whole);
        LaunchShapeProbe.pass(yb, pb, xb, (int64) LaunchShapeProbe.ROWS,
            4096L, bpr);
        yb.download(sliced);
        int64 bad = -1L;
        i = 0;
        while (i < (int64) LaunchShapeProbe.ROWS) {
            if (whole[i] != sliced[i]) { bad = i; i = (int64) LaunchShapeProbe.ROWS; }
            else { i = i + 1; }
        }
        if (bad >= 0L) {
            System.stdout.println("SLICE MISMATCH at row " + bad + ": whole "
                + whole[bad] + " sliced " + sliced[bad]);
        } else {
            System.stdout.println("slice control: 131072/131072 rows "
                + "bit-identical (whole vs 4096-row slices)");
        }

        // ── the curve ───────────────────────────────────────────────────
        int64[] chunks #= heap int64[9];
        chunks[0] = 131072L; chunks[1] = 16384L; chunks[2] = 8192L;
        chunks[3] = 6144L;   chunks[4] = 5120L;  chunks[5] = 4096L;
        chunks[6] = 3072L;   chunks[7] = 2048L;  chunks[8] = 1024L;

        int64[] totals #= heap int64[2];
        totals[0] = (int64) LaunchShapeProbe.ROWS;     // 420 MB
        totals[1] = 14336L;                            // 46 MB, the ffn shape
        int64 ti = 0;
        while (ti < 2L) {
            int64 rows = totals[ti];
            System.stdout.println("");
            System.stdout.println("--- total rows " + rows + "  ("
                + ((float64) (rows * bpr) / 1048576.0) + " MB) ---");
            int64 ci = 0;
            while (ci < 9L) {
                int64 chunk = chunks[ci];
                if (chunk > rows) { chunk = rows; }
                // Alternate the direction of the repeat loop so a warming
                // or cooling trend cannot be read as a chunk-size effect.
                float64 a = LaunchShapeProbe.pass(yb, pb, xb, rows, chunk, bpr);
                float64 b = LaunchShapeProbe.pass(yb, pb, xb, rows, chunk, bpr);
                float64 c #= LaunchShapeProbe.pass(yb, pb, xb, rows, chunk, bpr);
                float64 ms = LaunchShapeProbe.med3(a, b, c);
                float64 mb = (float64) (rows * bpr) / 1048576.0;
                int64 nl = (rows + chunk - 1L) / chunk;
                System.stdout.println("  chunk " + chunk + " rows  x" + nl
                    + " launches  " + ms + " ms  "
                    + (mb / ms * 1000.0 / 1024.0) + " GB/s");
                ci = ci + 1;
            }
            ti = ti + 1;
        }

        // ── PLACEMENT CONTROL ───────────────────────────────────────────
        // The engine measures its 46 MB weights at ~90 GB/s in ONE dispatch;
        // the sweep above, reading the first 46 MB of a 420 MB allocation,
        // measures 21. The 420 MB case agrees between the two to within 1%,
        // so the discrepancy is specific to the small read — and the one
        // thing that differs is whether those bytes are their OWN allocation
        // or a slice of a much larger one. Same bytes, same kernel, same
        // grid: only the allocation they live in changes.
        System.stdout.println("");
        System.stdout.println("--- placement control: 14336 rows in a "
            + "DEDICATED allocation ---");
        int64 sb = 14336L * bpr;
        int8[] small #= heap int8[sb];
        int64 k = 0;
        while (k < sb) { small[k] = packed[k]; k = k + 1; }
        KernelBuffer<int8> sp #= heap KernelBuffer<int8>((uint64) sb);
        sp.upload(small);
        int64 cj = 0;
        while (cj < 9L) {
            int64 chunk = chunks[cj];
            if (chunk > 14336L) { chunk = 14336L; }
            float64 a2 = LaunchShapeProbe.pass(yb, sp, xb, 14336L, chunk, bpr);
            float64 b2 = LaunchShapeProbe.pass(yb, sp, xb, 14336L, chunk, bpr);
            float64 c2 = LaunchShapeProbe.pass(yb, sp, xb, 14336L, chunk, bpr);
            float64 ms2 = LaunchShapeProbe.med3(a2, b2, c2);
            float64 mb2 = (float64) sb / 1048576.0;
            System.stdout.println("  chunk " + chunk + " rows  x"
                + ((14336L + chunk - 1L) / chunk) + " launches  " + ms2
                + " ms  " + (mb2 / ms2 * 1000.0 / 1024.0) + " GB/s");
            cj = cj + 1;
        }
        return;
    }

    /** One full pass over `rows` output rows, in `chunk`-row dispatches. */
    static float64 pass(KernelBuffer<float32> y, KernelBuffer<int8> p,
            KernelBuffer<float32> x, int64 rows, int64 chunk, int64 bpr) {
        int64 t0 = Clock.nanoTime();
        int64 r0 = 0L;
        while (r0 < rows) {
            int64 nr = chunk;
            if (r0 + nr > rows) { nr = rows - r0; }
            KernelBuffer<int8> sub #= p.slice((uint64) (r0 * bpr),
                (uint64) (nr * bpr));
            QuantKernel.q6kMatVecLaunch(y, sub, x, nr,
                (int64) LaunchShapeProbe.COLS, 0L, r0);
            r0 = r0 + nr;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0;
    }

    static float64 med3(float64 a, float64 b, float64 c) {
        if (a > b) { float64 t = a; a = b; b = t; }
        if (b > c) { float64 t = b; b = c; c = t; }
        if (a > b) { float64 t = a; a = b; b = t; }
        return b;
    }

    /** Q6_K bytes with real, finite f16 block scales (ScalingProbe's shape
     *  — synthetic bytes give NaN scales and time nothing meaningful). */
    static void fill(int8[] p) {
        int64 n = (int64) p.count();
        int64 z = 0;
        while (z < n) {
            p[z] = (int8) ((z * 31L) % 251L);
            z = z + 1;
        }
        int64 bb = 210L;
        int64 nb = n / bb;
        int64 b = 0;
        while (b < nb) {
            int64 o = b * bb;
            p[o + 208L] = (int8) ((int32) (b % 16L));
            p[o + 209L] = (int8) 60;              // ~1.0 in f16
            b = b + 1;
        }
        return;
    }
}
