package dev.cajeta.llm.bench;

import cajeta.time.Clock;
import cajeta.lang.Integer;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;
import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.llm.model.MoeFfn;
import dev.cajeta.llm.tok.Tokenizer;

/** 28.3.1 — end-to-end MoE prefill + decode wall time (the 15.2 table
 *  shape). Usage: MoeBenchProbe <model.gguf> <nPrefill> <nDecode>
 *  [noroute]. The prompt is real text repeated to length, encoded with
 *  the model's own policy, so routing sees natural statistics. */
public class MoeBenchProbe {
    static void timers(String tag) {
        System.stdout.println("[" + tag + " gemm-ms: pack "
            + (Linear.batchPackNs() / 1000000L) + " upload "
            + (Linear.batchUploadNs() / 1000000L) + " launch "
            + (Linear.batchLaunchNs() / 1000000L) + " down "
            + (Linear.batchDownNs() / 1000000L) + " copy "
            + (Linear.batchCopyNs() / 1000000L) + " calls "
            + Linear.batchCalls() + "]");
        System.stdout.println("[" + tag + " pf-ms: prim "
            + (CausalLM.prefillPrimNs() / 1000000L) + " gemm "
            + (CausalLM.prefillGemmNs() / 1000000L) + " qkv "
            + (CausalLM.prefillGQkvNs() / 1000000L) + " o "
            + (CausalLM.prefillGONs() / 1000000L) + " mlp "
            + (CausalLM.prefillGMlpNs() / 1000000L) + " down "
            + (CausalLM.prefillGDownNs() / 1000000L) + " stage "
            + (CausalLM.prefillStageNs() / 1000000L) + " rope "
            + (CausalLM.prefillRopeNs() / 1000000L) + " attend "
            + (CausalLM.prefillAttendNs() / 1000000L) + " head "
            + (CausalLM.prefillHeadNs() / 1000000L) + " logits "
            + (CausalLM.prefillLogitsNs() / 1000000L) + "]");
        System.stdout.println("[" + tag + " fb-gemm ms g1 "
            + (MoeFfn.batchGemm1Ns() / 1000000L) + " g2 "
            + (MoeFfn.batchGemm2Ns() / 1000000L) + " tail "
            + (MoeFfn.batchTailNs() / 1000000L) + " pre "
            + (MoeFfn.batchPreNs() / 1000000L) + " (upl "
            + (MoeFfn.batchUplNs() / 1000000L) + " adm "
            + (MoeFfn.batchPreA() / 1000000L) + " edb "
            + (MoeFfn.batchPreB() / 1000000L) + "/" + MoeFfn.batchEdbAllocs() + " mmax "
            + (MoeFfn.batchPreC() / 1000000L) + " ebs "
            + (MoeFfn.batchPreD() / 1000000L) + ")]");
        System.stdout.println("[" + tag + " fb-route ms "
            + (MoeFfn.batchRouteNs() / 1000000L) + " (host-side "
            + (MoeFfn.batchRouteHostNs() / 1000000L) + ") dev "
            + MoeFfn.batchDevRoutes() + " host "
            + MoeFfn.batchHostRoutes() + " zero-sync "
            + MoeFfn.batchZeroSyncRoutes() + "]");
        MoeFfn.resetBatchTimers();
        CausalLM.resetPrefillTimers();
        System.stdout.println("[" + tag + " route-ms: deq "
            + (Linear.batchDeqNs() / 1000000L) + " wmma "
            + (Linear.batchWmmaNs() / 1000000L) + " q6 "
            + (Linear.batchQ6Ns() / 1000000L) + " fb "
            + (Linear.batchFbNs() / 1000000L) + "]");
        Linear.resetBatchTimers();
        return;
    }

    public static void run(String[] args) {
        String model = args[0];
        int32 nPre = Integer.parseInt(args[1]);
        int32 nDec = Integer.parseInt(args[2]);
        boolean resident = false;
        if ((int32) args.count() > 3 && args[3].equals("noroute")) {
            QuantKernel.setRoutingEnabled(false);
            System.stdout.println("[device routing OFF]");
        }
        boolean twice = false;
        if ((int32) args.count() > 3 && args[3].equals("twice")) {
            // Control arm: two prefills WITHOUT residency, so the
            // steady-state comparison is second-prefill vs
            // second-prefill — a first-vs-second compare confounds
            // allocator and cache state with the mechanism.
            twice = true;
        }
        if ((int32) args.count() > 3 && args[3].equals("capped")) {
            // moe-cache 4.1.1: the oversized regime FORCED — a budget
            // far below the model's expert payload, so admission stops
            // partway and the rest of the fleet runs windowed beside
            // the slots. Completion + an identical last token + the
            // counters showing BOTH kinds is the acceptance.
            ExpertBank.setResidencyBudget(2147483648L);
            resident = true;
            System.stdout.println("[expert residency CAPPED 2 GiB]");
        }
        if ((int32) args.count() > 3 && args[3].equals("resphase")) {
            // Triage: resident + GPU-inclusive sublayer attribution.
            ExpertBank.setResidencyBudget(1152921504606846976L);
            resident = true;
            CausalLM.setPhaseSync(true);
            CausalLM.setPfSync(true);
            MoeFfn.setPhaseSync(true);
            System.stdout.println("[expert residency ON + phase sync]");
        }
        if ((int32) args.count() > 3 && args[3].equals("resident")) {
            // moe-expert-cache 1.3.1: an explicit huge budget (the
            // measured DEFAULT is that plan's unit 4). Prefill runs
            // TWICE: the first admits, the second is the steady state
            // the acceptance row records.
            ExpertBank.setResidencyBudget(1152921504606846976L);
            resident = true;
            System.stdout.println("[expert residency ON]");
        }
        // Optional 5th arg "int8": the dense tensors take the widened
        // resident copy (EngineOptions.prefillWeights = "int8"), which
        // is what unlocks the multi-wave epi GEMM for the attention
        // projections; expert slots stay packed regardless.
        if ((int32) args.count() > 4 && args[4].equals("int8")) {
            Linear.setDeqPrefill(true);
            System.stdout.println("[prefill weights INT8]");
        }
        // Unit 50 A/B: "nofuse-router" / "nofuse-attn" / "nofuse" in any arg.
        int32 ai = 0;
        while (ai < (int32) args.count()) {
            if (args[ai].equals("nofuse-router") || args[ai].equals("nofuse")) {
                MoeFfn.setFusedRouter(false);
                System.stdout.println("[fused router OFF]");
            }
            if (args[ai].startsWith("fdchunk=")) {
                int32 c = Integer.parseInt(args[ai].substring(8, (int32) args[ai].count()));
                AttnKernel.setFlashDecodeChunk(c);
                System.stdout.println("[fdChunk " + c + "]");
            }
            if (args[ai].equals("nofuse-downtail") || args[ai].equals("nofuse")) {
                MoeFfn.setFusedDownTail(false);
            }
            if (args[ai].equals("nofuse-normrouter") || args[ai].equals("nofuse")) {
                MoeFfn.setFusedNormRouter(false);
            }
            if (args[ai].equals("nofuse-down") || args[ai].equals("nofuse")) {
                MoeFfn.setFusedDown(false);
                System.stdout.println("[fused down OFF]");
            }
            if (args[ai].equals("nofuse-attn") || args[ai].equals("nofuse")) {
                AttnKernel.setReducePack(false);
                System.stdout.println("[fused attn reduce OFF]");
            }
            ai = ai + 1;
        }
        // Unit 30 A/B: "nodiag" leaves no callback registered, so the
        // routing histogram (armed whenever anyone listens) stays off.
        boolean nodiag = false;
        ai = 0;
        while (ai < (int32) args.count()) {
            if (args[ai].equals("nodiag")) { nodiag = true; }
            ai = ai + 1;
        }
        if (!nodiag) { Diag.register(heap RouteSay()); }
        Checkpoint ck #= Checkpoint.open(model);
        Tokenizer tok #= ck.gguf().tokenizer();
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, nPre + nDec + 8, 1, 0);
        m.bind(ck, false);
        m.prewarmPrefillWeights();

        String para = "The quick brown fox jumps over the lazy dog "
            + "while the river runs down to the sea and the mountains "
            + "stand quietly in the morning light. ";
        String text #= "";
        int32[] ids #= tok.encodePrompt(para);
        while ((int32) ids.count() < nPre) {
            text #= text + para;
            int32[] more #= tok.encodePrompt(text);
            ids #= #more;
        }
        int32[] p = heap int32[nPre];
        int32 i = 0;
        while (i < nPre) {
            p[i] = ids[i];
            i = i + 1;
        }
        System.stdout.println("prefill " + nPre + " tokens...");
        Linear.resetBatchTimers();
        int64 t0 = Clock.nanoTime();
        int32 nxt = m.prefill(p, nPre);
        int64 t1 = Clock.nanoTime();
        float64 preMs = (float64) (t1 - t0) / 1000000.0;
        System.stdout.println("prefill: " + preMs + " ms total, "
            + (preMs / (float64) nPre) + " ms/tok");
        MoeBenchProbe.timers("first");
        if (twice) {
            m.resetSeq(0);
            int64 t0c = Clock.nanoTime();
            nxt = m.prefill(p, nPre);
            int64 t1c = Clock.nanoTime();
            float64 preC = (float64) (t1c - t0c) / 1000000.0;
            System.stdout.println("prefill second (windowed): " + preC
                + " ms total, " + (preC / (float64) nPre)
                + " ms/tok");
            MoeBenchProbe.timers("second");
        }
        if (resident) {
            System.stdout.println("[cold: admits "
                + ExpertBank.residencyAdmissions() + " ("
                + ExpertBank.residencyAdmissionBytes() + " B) hits "
                + ExpertBank.residencyHits() + " windowed "
                + ExpertBank.residencyWindowed() + "]");
            m.resetSeq(0);
            int64 t0b = Clock.nanoTime();
            nxt = m.prefill(p, nPre);
            int64 t1b = Clock.nanoTime();
            float64 preB = (float64) (t1b - t0b) / 1000000.0;
            System.stdout.println("prefill steady: " + preB
                + " ms total, " + (preB / (float64) nPre)
                + " ms/tok");
            MoeBenchProbe.timers("steady");
            System.stdout.println("[steady: admits "
                + ExpertBank.residencyAdmissions() + " hits "
                + ExpertBank.residencyHits() + " windowed "
                + ExpertBank.residencyWindowed() + "]");
        }

        int32[] one = heap int32[1];
        int32 g = 0;
        CausalLM.resetHostDecTimers();
        CausalLM.resetDecodeTimers();
        CausalLM.resetResidentTimers();
        MoeFfn.resetRowTimers();
        int64 h0 = ExpertBank.residencyHits();
        int64 t2 = Clock.nanoTime();
        while (g < nDec) {
            one[0] = nxt;
            nxt = m.stepSeq(0, one, 0, 1);
            g = g + 1;
        }
        int64 t3 = Clock.nanoTime();
        float64 decMs = (float64) (t3 - t2) / 1000000.0;
        System.stdout.println("decode: " + decMs + " ms for " + nDec
            + " tokens, " + (decMs / (float64) nDec) + " ms/tok, last "
            + nxt);
        System.stdout.println("[route-hist launches " + MoeFfn.routeHistLaunchCount() + "]");
        System.stdout.println("[dec-tail ms/tok: pre "
            + ((float64) CausalLM.decodePreNs() / 1000000.0 / (float64) nDec)
            + " norm "
            + ((float64) CausalLM.decodeNormNs() / 1000000.0 / (float64) nDec)
            + " sync "
            + ((float64) CausalLM.decodeSyncNs() / 1000000.0 / (float64) nDec)
            + " lmhead "
            + ((float64) CausalLM.decodeLmHeadNs() / 1000000.0 / (float64) nDec)
            + " toks " + CausalLM.decodeTokens() + "]");
        System.stdout.println("[res-host ms/tok: loop "
            + ((float64) CausalLM.residentLoopNs() / 1000000.0 / (float64) nDec)
            + " attn "
            + ((float64) CausalLM.residentAttnNs() / 1000000.0 / (float64) nDec)
            + " moe "
            + ((float64) CausalLM.residentMoeNs() / 1000000.0 / (float64) nDec) + "]");
        float64 dn = (float64) nDec;
        System.stdout.println("[dec-phase ms/tok: synckv "
            + ((float64) CausalLM.hostDecSyncKvNs() / 1000000.0 / dn)
            + " attn-proj "
            + ((float64) CausalLM.hostDecProjNs() / 1000000.0 / dn)
            + " attend "
            + ((float64) CausalLM.hostDecAttendNs() / 1000000.0 / dn)
            + " oproj "
            + ((float64) CausalLM.hostDecOProjNs() / 1000000.0 / dn)
            + " mlp "
            + ((float64) CausalLM.hostDecMlpNs() / 1000000.0 / dn)
            + " moe "
            + ((float64) CausalLM.hostDecMoeNs() / 1000000.0 / dn) + "]");
        System.stdout.println("[attn-phase ms/tok: norm "
            + ((float64) CausalLM.raNorm() / 1000000.0 / dn)
            + " proj " + ((float64) CausalLM.raProj() / 1000000.0 / dn)
            + " rope " + ((float64) CausalLM.raRope() / 1000000.0 / dn)
            + " attend " + ((float64) CausalLM.raAttn() / 1000000.0 / dn)
            + " out " + ((float64) CausalLM.raOut() / 1000000.0 / dn)
            + "]");
        System.stdout.println("[moe-glue ms/tok: pre "
            + ((float64) MoeFfn.rowPreNs() / 1000000.0 / dn)
            + " preA " + ((float64) MoeFfn.rowPreANs() / 1000000.0 / dn)
            + " preB " + ((float64) MoeFfn.rowPreBNs() / 1000000.0 / dn)
            + " post " + ((float64) MoeFfn.rowPostNs() / 1000000.0 / dn)
            + "]");
        System.stdout.println("[moe-phase ms/tok: route "
            + ((float64) MoeFfn.rowRouteNs() / 1000000.0 / dn)
            + " gateup "
            + ((float64) MoeFfn.rowGateUpNs() / 1000000.0 / dn)
            + " glu "
            + ((float64) MoeFfn.rowGluNs() / 1000000.0 / dn)
            + " down "
            + ((float64) MoeFfn.rowDownNs() / 1000000.0 / dn)
            + " comb "
            + ((float64) MoeFfn.rowCombNs() / 1000000.0 / dn)
            + " shared "
            + ((float64) MoeFfn.rowSharedNs() / 1000000.0 / dn)
            + " slot-launches/tok "
            + ((float64) (ExpertBank.residencyHits() - h0) / dn) + "]");
        Diag.register(null);
        return;
    }
}

/** 29.3.1 — the engine's own route record, printed: `prefill-mode
 *  batched` is the acceptance line, not a wall-clock inference. */
final class RouteSay implements DiagCallback {
    public RouteSay() { return; }
    public void onRecord(DiagRecord r) {
        if (!r.category.equals("prefill-mode")) { return; }
        System.stdout.println("[prefill-mode: " + r.name + " rows="
            + r.v0 + "]");
        return;
    }
}
