package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.ModelConfig;

/** Which route does a model take on this backend — the batched one on
 *  the prefill, then the ROW one on the decode steps that follow, whose
 *  refusal names the gate that turned it away. One record stream. */
public class DenseRouteProbe {
    public static void run(String[] args) {
        RouteTrace tr #= heap RouteTrace();
        Diag.register(tr);
        ExpertBank.setResidencyBudget(Device.memoryBytes() / 2L);
        Checkpoint ck #= Checkpoint.open(args[0]);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        int32[] p = heap int32[12];
        int32 i = 0;
        while (i < 12) {
            p[i] = 2 * i + 3;
            i = i + 1;
        }
        int32 t = m.prefill(p, 12);
        System.stdout.println("top " + t);
        int32[] one = heap int32[1];
        int32 g = 0;
        while (g < 2) {
            one[0] = t;
            t = m.stepSeq(0, one, 0, 1);
            g = g + 1;
        }
        System.stdout.println("after decode " + t);
        return;
    }
}
