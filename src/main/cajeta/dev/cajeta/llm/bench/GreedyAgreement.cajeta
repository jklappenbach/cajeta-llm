package dev.cajeta.llm.bench;

/**
 * The greedy-agreement accumulator of spec 12.3/13.22 (plan 15.2.3):
 * per-position token agreement between two greedy runs, logging the
 * top-2 logit gap at every divergence — the rate alone would pass a
 * systematic bug that flips one token in two hundred at non-tie
 * positions, so the tie clause carries the weight.
 */
public final class GreedyAgreement {
    int32 total;
    int32 agreed;
    float32[] gaps;      // gap at each divergence, in order
    int32[] positions;   // position of each divergence
    boolean[] runnerUp;  // whether each divergence took the reference's runner-up
    int32 divergedN;

    public GreedyAgreement(int32 maxDivergences) {
        this.total = 0;
        this.agreed = 0;
        this.gaps #= heap float32[maxDivergences];
        this.positions #= heap int32[maxDivergences];
        this.runnerUp #= heap boolean[maxDivergences];
        this.divergedN = 0;
    }

    /** One position: the two runs' tokens and the reference run's top-2
     *  logit gap at that position. */
    public void add(int32 position, int32 tokA, int32 tokB, float32 top2Gap) {
        this.total = this.total + 1;
        if (tokA == tokB) {
            this.agreed = this.agreed + 1;
        } else {
            this.gaps[this.divergedN] = top2Gap;
            this.positions[this.divergedN] = position;
            this.divergedN = this.divergedN + 1;
        }
    }

    public float64 agreementRate() {
        if (this.total == 0) {
            return 1.0;
        }
        return (float64) this.agreed / (float64) this.total;
    }

    public int32 divergences() {
        return this.divergedN;
    }

    public int32 divergencePosition(int32 i) {
        return this.positions[i];
    }

    public float32 divergenceGap(int32 i) {
        return this.gaps[i];
    }

    /** One position with the reference's runner-up token, so a divergence onto it can be a tie. */
    public void addAt(int32 position, int32 ref, int32 got, float32 top2Gap, int32 refSecond) {
        if (ref != got) { this.runnerUp[this.divergedN] = got == refSecond; }
        this.add(position, ref, got, top2Gap);
    }

    /** How many divergences took the reference's runner-up at a top-2 gap under `tieGap`. */
    public int32 ties(float32 tieGap) {
        int32 n = 0;
        int32 i = 0;
        while (i < this.divergedN) {
            if (this.runnerUp[i] && this.gaps[i] < tieGap) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    /** The tie-aware verdict (15.2.15.3.6.3): every divergence is a tie under `tieGap`, and
     *  there are at most one tie per 16 positions (one in a shorter run). */
    public boolean passesWithTies(float32 tieGap) {
        int32 t = this.ties(tieGap);
        if (t != this.divergedN) { return false; }
        int32 cap = this.total / 16;
        if (cap < 1) { cap = 1; }
        return t <= cap;
    }

    /** The 12.3 verdict: rate ≥ 0.99 AND every divergence at a top-2 gap
     *  under `tieGap` (1e-3 per 13.22). */
    public boolean passes(float64 minRate, float32 tieGap) {
        if (this.agreementRate() < minRate) {
            return false;
        }
        int32 i = 0;
        while (i < this.divergedN) {
            if (this.gaps[i] >= tieGap) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
}
