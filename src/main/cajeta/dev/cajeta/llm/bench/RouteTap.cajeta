package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;

/** Prints every route record the engine emits (`batch-route`,
 *  `moe-batch-route`, `prefill-mode`, `widen-refused`, `cols-probe`), so a
 *  bench says WHICH kernels its number stands on. */
public final class RouteTap implements DiagCallback {

    public RouteTap() { return; }

    public void onRecord(DiagRecord r) {
        if (r.category.equals("batch-route") || r.category.equals("moe-batch-route")
                || r.category.equals("prefill-mode") || r.category.equals("widen-refused")
                || r.category.equals("cols-probe") || r.category.equals("decode-batch")) {
            System.stdout.println("route\t" + r.category + "\t"
                + (r.name == null ? "-" : r.name) + "\t" + r.v0 + "\t" + r.v1
                + "\t" + r.v2 + "\t" + r.v3);
        }
        return;
    }
}
