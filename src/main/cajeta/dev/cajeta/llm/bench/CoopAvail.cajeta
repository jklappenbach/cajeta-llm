package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelManifest;

/** Which coop/tile kernels the active backend actually registered, and
 *  what each one's manifest reports.
 *
 *  Kept because a kernel that fails to lower does not raise -- it simply
 *  never registers, and a launch against it returns zeros. That failure
 *  is invisible from the timing side, where an absent kernel looks
 *  infinitely fast, so this is the probe that tells a fast arm from a
 *  missing one. Every timing probe beside it depends on that distinction. */
public final class CoopAvail {

    static void probe(String name) {
        boolean av = Device.kernelAvailable(name);
        String line = (av ? "AVAIL   " : "MISSING ") + name;
        KernelManifest m #= KernelManifest.of(name);
        if (m != null) {
            line = line + "  vgpr=" + m.vgpr().orElse(0 - 1)
                 + " lds=" + m.ldsStaticBytes().orElse(0 - 1)
                 + " spill=" + m.spillBytes().orElse(0 - 1)
                 + " wave=" + m.waveWidth().orElse(0 - 1);
        } else {
            line = line + "  (no manifest)";
        }
        System.stdout.println(line);
        return;
    }

    public static int32 run() {
        System.stdout.println("backend: " + Device.activeBackend());
        CoopAvail.probe("f16F16CoopX3Kernel");
        CoopAvail.probe("iq2sF16CoopN256Kernel");
        CoopAvail.probe("iq2sF16CoopN64Kernel");
        CoopAvail.probe("iq2sF16CoopX3Kernel");
        CoopAvail.probe("iq2xsF16CoopN256Kernel");
        CoopAvail.probe("iq2xsF16CoopN64Kernel");
        CoopAvail.probe("iq2xsF16CoopX3Kernel");
        CoopAvail.probe("iq2xxsF16CoopN256Kernel");
        CoopAvail.probe("iq2xxsF16CoopN64Kernel");
        CoopAvail.probe("iq2xxsF16CoopX3Kernel");
        CoopAvail.probe("iq3sF16CoopN256Kernel");
        CoopAvail.probe("iq3sF16CoopN64Kernel");
        CoopAvail.probe("iq3sF16CoopX3Kernel");
        CoopAvail.probe("iq3xxsF16CoopIdN64Kernel");
        CoopAvail.probe("iq3xxsF16CoopN256Kernel");
        CoopAvail.probe("iq3xxsF16CoopN64Kernel");
        CoopAvail.probe("iq3xxsF16CoopX3Kernel");
        CoopAvail.probe("iq4nlF16CoopIdN64Kernel");
        CoopAvail.probe("iq4nlF16CoopN64Kernel");
        CoopAvail.probe("iq4nlF16CoopX1Kernel");
        CoopAvail.probe("iq4nlF16CoopX3Kernel");
        CoopAvail.probe("iq4xsF16CoopX1Kernel");
        CoopAvail.probe("iq4xsF16CoopX3Kernel");
        CoopAvail.probe("mxfp4MatVecKernelCoop");
        CoopAvail.probe("mxfp4MatVecKernelCoopQ8");
        CoopAvail.probe("mxfp4MatVecKernelCoopQ8Surface");
        CoopAvail.probe("q2kF16CoopX1Kernel");
        CoopAvail.probe("q2kF16CoopX3Kernel");
        CoopAvail.probe("q3kF16CoopX1Kernel");
        CoopAvail.probe("q3kF16CoopX3Kernel");
        CoopAvail.probe("q40F16CoopX1Kernel");
        CoopAvail.probe("q40F16CoopX3Kernel");
        CoopAvail.probe("q41F16CoopX1Kernel");
        CoopAvail.probe("q41F16CoopX3Kernel");
        CoopAvail.probe("q4kF16CoopKernel");
        CoopAvail.probe("q4kF16CoopM64Kernel");
        CoopAvail.probe("q4kF16CoopN256GKernel");
        CoopAvail.probe("q4kF16CoopN256Kernel");
        CoopAvail.probe("q4kF16CoopX1Kernel");
        CoopAvail.probe("q4kF16CoopX3Kernel");
        CoopAvail.probe("q50F16CoopX1Kernel");
        CoopAvail.probe("q50F16CoopX3Kernel");
        CoopAvail.probe("q51F16CoopX1Kernel");
        CoopAvail.probe("q51F16CoopX3Kernel");
        CoopAvail.probe("q5kF16CoopX1Kernel");
        CoopAvail.probe("q5kF16CoopX3Kernel");
        CoopAvail.probe("q6kF16CoopKernel");
        CoopAvail.probe("q6kF16CoopM64Kernel");
        CoopAvail.probe("q6kF16CoopN256GKernel");
        CoopAvail.probe("q6kF16CoopN256Kernel");
        CoopAvail.probe("q6kF16CoopX1Kernel");
        CoopAvail.probe("q6kF16CoopX3Kernel");
        CoopAvail.probe("q80F16CoopX1Kernel");
        CoopAvail.probe("q80F16CoopX3Kernel");
        CoopAvail.probe("tq10F16CoopX1Kernel");
        CoopAvail.probe("tq10F16CoopX3Kernel");
        CoopAvail.probe("tq20F16CoopX1Kernel");
        CoopAvail.probe("tq20F16CoopX3Kernel");
        return 0;
    }
}
