package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.lang.String;

/**
 * The oracle map (xpu-kernel-adaptor plan 8.2.1, 8.3.2): one row per
 * shipped kernel naming its llama.cpp counterpart — the CUDA source file
 * and the kernel or op in it, `mmvq.cu:mul_mat_vec_q` — and the engine
 * shape it is judged at, or `NONE` with a note saying why there is no
 * counterpart. A NONE row is judged by roofline fraction alone (spec
 * §7.1), and that set is enumerable from the map, never inferred from a
 * missing row: `OracleMapTest` fails the suite on any registered shipped
 * kernel the map does not name.
 *
 * File: `census/oracle-map.tsv`, header `kernel family counterpart shape
 * note`, tab-separated, one kernel per row, no duplicates.
 */
public final class OracleMap {

    static final String HEADER = "kernel\tfamily\tcounterpart\tshape\tnote";

    String[] kernels;
    String[] families;
    String[] counterparts;
    String[] shapes;
    String[] notes;
    int32 n;

    public OracleMap(int32 capacity) {
        this.kernels #= heap String[capacity];
        this.families #= heap String[capacity];
        this.counterparts #= heap String[capacity];
        this.shapes #= heap String[capacity];
        this.notes #= heap String[capacity];
        this.n = 0;
    }

    public int32 count() { return this.n; }
    public String kernelAt(int32 i) { return this.kernels[i]; }
    public String familyAt(int32 i) { return this.families[i]; }
    public String counterpartAt(int32 i) { return this.counterparts[i]; }
    public String shapeAt(int32 i) { return this.shapes[i]; }
    public String noteAt(int32 i) { return this.notes[i]; }

    public boolean has(String kernel) {
        return this.indexOf(kernel) >= 0;
    }

    public int32 indexOf(String kernel) {
        int32 i = 0;
        while (i < this.n) {
            if (this.kernels[i].equals(kernel)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /** The kernels judged by roofline fraction alone (8.3.2). */
    public int32 noneCount() {
        int32 c = 0;
        int32 i = 0;
        while (i < this.n) {
            if (this.counterparts[i].equals("NONE")) { c = c + 1; }
            i = i + 1;
        }
        return c;
    }

    /** Byte index of the `idx`-th tab-separated field's start, or -1. */
    static int32 fieldStart(String line, int32 idx) {
        int32 pos = 0;
        int32 f = 0;
        while (f < idx) {
            int64 t = line.indexOfFrom("\t", (int64) pos);
            if (t < 0L) { return -1; }
            pos = (int32) t + 1;
            f = f + 1;
        }
        return pos;
    }

    static int32 fieldCount(String line) {
        int32 c = 1;
        int64 pos = 0;
        while (true) {
            int64 t = line.indexOfFrom("\t", pos);
            if (t < 0L) { return c; }
            c = c + 1;
            pos = t + 1L;
        }
    }

    static #String field(String line, int32 idx) {
        int32 s = OracleMap.fieldStart(line, idx);
        if (s < 0) { return #""; }
        int64 e = line.indexOfFrom("\t", (int64) s);
        if (e < 0L) { e = line.size(); }
        String out #= line.substring(s, (int32) e);
        return #out;
    }

    static #String lineAt(String text, int64 start, int64 end) {
        int64 e = end;
        if (e > start && text.byteAt((int32) (e - 1L)) == (int8) 13) { e = e - 1L; }
        String out #= text.substring((int32) start, (int32) e);
        return #out;
    }

    /**
     * Parses the file's text; null when the header is not the one above, a
     * row has other than five fields, or a kernel appears twice. A refusal
     * rather than a partial map: a partial map would pass the completeness
     * test for kernels it silently dropped.
     */
    public static #OracleMap parse(String text) {
        int64 len = text.size();
        // Count lines for the capacity.
        int32 lines = 0;
        int64 p = 0;
        while (p < len) {
            int64 nl = text.indexOfFrom("\n", p);
            if (nl < 0L) { nl = len; }
            lines = lines + 1;
            p = nl + 1L;
        }
        if (lines < 1) { return null; }
        OracleMap m #= heap OracleMap(lines);
        p = 0;
        int32 lineNo = 0;
        while (p < len) {
            int64 nl = text.indexOfFrom("\n", p);
            if (nl < 0L) { nl = len; }
            String line #= OracleMap.lineAt(text, p, nl);
            p = nl + 1L;
            if (lineNo == 0) {
                if (!line.equals(OracleMap.HEADER)) { return null; }
                lineNo = 1;
                continue;
            }
            lineNo = lineNo + 1;
            if (line.size() == 0L) { continue; }
            if (line.startsWith("#")) { continue; }
            if (OracleMap.fieldCount(line) != 5) { return null; }
            String k #= OracleMap.field(line, 0);
            if (k.size() == 0L) { return null; }
            if (m.has(k)) { return null; }
            m.kernels[m.n] #= k;
            m.families[m.n] #= OracleMap.field(line, 1);
            m.counterparts[m.n] #= OracleMap.field(line, 2);
            m.shapes[m.n] #= OracleMap.field(line, 3);
            m.notes[m.n] #= OracleMap.field(line, 4);
            m.n = m.n + 1;
        }
        return #m;
    }

    /** Reads and parses `path`; null when the file cannot be parsed. */
    public static #OracleMap load(String path) {
        int8[] raw #= File.readAllBytes(path);
        String text #= heap String(#raw, (int32) raw.count());
        OracleMap m #= OracleMap.parse(text);
        return #m;
    }
}
