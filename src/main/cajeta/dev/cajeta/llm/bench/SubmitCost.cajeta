package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.ArithmeticCharacter;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelManifest;
import cajeta.xpu.KernelResourceDescriptor;
import cajeta.xpu.KernelSubmission;
import cajeta.xpu.Scheduler;
import dev.cajeta.llm.io.WmmaKernel;

/** The host cost of one scheduler submission of the Q4_K prefill tile, in the
 *  shape mwSubmit sends it, against the same submission with no kernel named
 *  (xpu-tile-scheduling 1.1.6). Also the bare manifest lookup, cold and warm. */
public final class SubmitCost {

    static int64 lookups(String kernel, int32 n) {
        int64 t0 = Clock.nanoTime();
        int32 i = 0;
        while (i < n) {
            KernelManifest m = KernelManifest.of(kernel);
            if (m == null) { System.stdout.println("no manifest for " + kernel); return -1L; }
            i = i + 1;
        }
        return (Clock.nanoTime() - t0) / (int64) n;
    }

    static int64 block(boolean named, int32 n, KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int32> packedW, KernelBuffer<int8> xp) {
        int64 sink = 0L;
        int64 t0 = Clock.nanoTime();
        int32 i = 0;
        while (i < n) {
            if (named) {
                KernelResourceDescriptor d #= WmmaKernel.mwSubmit(WmmaKernel.MW_KERNEL,
                    y, packed, packedW, xp, 64, 256);
                sink = sink + (int64) d.ldsBytes + (int64) d.vgprCount;
            } else {
                KernelSubmission sub = heap KernelSubmission(64, 256);
                sub.character = ArithmeticCharacter.ComputeBound;
                sub.bind(y.handle());
                sub.bind(packed.handle());
                sub.bind(packedW.handle());
                sub.bind(xp.handle());
                KernelResourceDescriptor d #= Scheduler.submit(sub);
                sink = sink + (int64) d.ldsBytes + (int64) d.vgprCount;
            }
            i = i + 1;
        }
        int64 t1 = Clock.nanoTime();
        if (sink == 7L) { System.stdout.println("sink"); }
        return (t1 - t0) / (int64) n;
    }

    public static int32 run() {
        System.stdout.println("backend: " + Device.activeBackend());
        int64 c0 = Clock.nanoTime();
        KernelManifest mw = KernelManifest.of(WmmaKernel.MW_KERNEL);
        int64 c1 = Clock.nanoTime();
        KernelManifest id = KernelManifest.of(WmmaKernel.ID_WIDE_KERNEL);
        int64 c2 = Clock.nanoTime();
        if (mw == null || id == null) { System.stdout.println("missing manifest"); return 1; }
        System.stdout.println("cold of mw " + (c1 - c0) + " ns, id " + (c2 - c1) + " ns"
            + "  mw vgpr=" + mw.vgpr().orElse(0 - 1) + " lds=" + mw.ldsStaticBytes().orElse(0 - 1)
            + "  id vgpr=" + id.vgpr().orElse(0 - 1) + " lds=" + id.ldsStaticBytes().orElse(0 - 1));
        int32 n = 20000;
        int32 q = 0;
        while (q < 4) {
            System.stdout.println("row of mw " + SubmitCost.lookups(WmmaKernel.MW_KERNEL, n)
                + " id " + SubmitCost.lookups(WmmaKernel.ID_WIDE_KERNEL, n));
            q = q + 1;
        }
        KernelBuffer<float32> y = heap KernelBuffer<float32>((uint64) 4096);
        KernelBuffer<int8> packed = heap KernelBuffer<int8>((uint64) 4096);
        KernelBuffer<int32> packedW = heap KernelBuffer<int32>((uint64) 1024);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) 4096);
        SubmitCost.block(false, n, y, packed, packedW, xp);
        SubmitCost.block(true, n, y, packed, packedW, xp);
        int32 round = 0;
        while (round < 6) {
            boolean firstNamed = round % 2 == 1;
            int64 a = SubmitCost.block(firstNamed, n, y, packed, packedW, xp);
            int64 b = SubmitCost.block(!firstNamed, n, y, packed, packedW, xp);
            int64 c = SubmitCost.block(!firstNamed, n, y, packed, packedW, xp);
            int64 d = SubmitCost.block(firstNamed, n, y, packed, packedW, xp);
            String first = firstNamed ? "named" : "geometry";
            String second = firstNamed ? "geometry" : "named";
            System.stdout.println("row " + first + " " + a);
            System.stdout.println("row " + second + " " + b);
            System.stdout.println("row " + second + " " + c);
            System.stdout.println("row " + first + " " + d);
            round = round + 1;
        }
        return 0;
    }
}
