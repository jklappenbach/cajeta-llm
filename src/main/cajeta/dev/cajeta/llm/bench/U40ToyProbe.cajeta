package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.MoeFfn;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.ModelConfig;

/** unit 40 triage: toy zero-sync — decode 3 steps, then dump the
 *  device routing of one row against the host twin. */
public class U40ToyProbe {
    static #CausalLM mk() {
        Checkpoint ck #= Checkpoint.open(
            "src/test/fixtures/gguf/toy-routable-moe.gguf");
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();
        return #m;
    }

    static void gen(CausalLM m, String tag) {
        int32[] p = heap int32[8];
        int32 pi = 0;
        while (pi < 8) { p[pi] = (pi * 7 + 3) % 200; pi = pi + 1; }
        int32 n = m.prefill(p, 8);
        String o #= tag + " toks: " + n;
        int32[] one = heap int32[1];
        int32 g = 0;
        while (g < 6) {
            one[0] = n;
            n = m.stepSeq(0, one, 0, 1);
            o #= o + " " + n;
            g = g + 1;
        }
        System.stdout.println(o);
        return;
    }

    public static void run() {
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        Checkpoint ck #= Checkpoint.open(
            "src/test/fixtures/gguf/toy-routable-moe.gguf");
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();
        int32[] p = heap int32[8];
        int32 pi = 0;
        while (pi < 8) { p[pi] = (pi * 7 + 3) % 200; pi = pi + 1; }
        int32 n = m.prefill(p, 8);
        System.stdout.println("prefill tok " + n);
        int32[] one = heap int32[1];
        int32 g = 0;
        while (g < 3) {
            one[0] = n;
            n = m.stepSeq(0, one, 0, 1);
            System.stdout.println("step tok " + n);
            g = g + 1;
        }
        // Dump device routing state of layer 0.
        MoeFfn moe = m.moeAt(0);
        moe.dumpZeroSync();

        // Replicate the capped test's sequence.
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        CausalLM mf #= U40ToyProbe.mk();
        U40ToyProbe.gen(mf, "full");
        int64 full = ExpertBank.residencyUsedBytes();
        System.stdout.println("full bytes " + full);
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(full / 2L);
        CausalLM mc #= U40ToyProbe.mk();
        U40ToyProbe.gen(mc, "capped");
        System.stdout.println("capped hits " + ExpertBank.residencyHits()
            + " windowed " + ExpertBank.residencyWindowed());
        return;
    }
}
