package dev.cajeta.llm.bench;

import cajeta.lang.Integer;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.llm.tok.Tokenizer;

/** The spec 13.22 divergence instrument: prefill an explicit id list,
 *  print the top-8 next-token logits (id, logit, piece) — the gap at a
 *  greedy divergence is the evidence, never the token alone.
 *  Usage: GapProbe <model.gguf> <id,id,...> [noroute] */
public class GapProbe {
    public static void run(String[] args) {
        if ((int32) args.count() > 2 && args[2].equals("noroute")) {
            QuantKernel.setRoutingEnabled(false);
        }
        Checkpoint ck #= Checkpoint.open(args[0]);
        Tokenizer tok #= ck.gguf().tokenizer();
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 256, 1, 0);
        m.bind(ck, false);
        // Manual comma split over bytes (no String.split in the stdlib;
        // the spec is ASCII digits and commas).
        String spec = args[1];
        int8[] sb #= spec.toBytes();
        int32 sn = (int32) sb.count();
        int32 np = 1;
        int32 ci = 0;
        while (ci < sn) {
            if (sb[ci] == 44) {
                np = np + 1;
            }
            ci = ci + 1;
        }
        int32[] ids = heap int32[np];
        int32 i = 0;
        int32 st = 0;
        ci = 0;
        while (ci <= sn) {
            if (ci == sn || sb[ci] == 44) {
                String piece #= spec.substring(st, ci);
                ids[i] = Integer.parseInt(piece);
                i = i + 1;
                st = ci + 1;
            }
            ci = ci + 1;
        }
        int32 nxt = m.prefill(ids, np);
        System.stdout.println("argmax = " + nxt);
        Tensor<float32> lg = m.logits();
        float32[] lb = lg.hostBuffer();
        int64 lo = lg.hostBase();
        int32 v = (int32) lg.shape()[0];
        boolean[] taken = heap boolean[v];
        int32 k = 0;
        while (k < 8) {
            int32 best = 0 - 1;
            float32 bv = 0.0f;
            i = 0;
            while (i < v) {
                if (!taken[i] && (best < 0 || lb[lo + (int64) i] > bv)) {
                    best = i;
                    bv = lb[lo + (int64) i];
                }
                i = i + 1;
            }
            taken[best] = true;
            String t #= tok.tokenOf(best);
            System.stdout.println("  " + best + "  " + bv + "  '" + t
                + "'");
            k = k + 1;
        }
        return;
    }
}
