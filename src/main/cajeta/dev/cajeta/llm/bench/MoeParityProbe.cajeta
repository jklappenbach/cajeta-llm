package dev.cajeta.llm.bench;

import cajeta.lang.Integer;
import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.llm.tok.Tokenizer;

/**
 * The 27.3.1 greedy-parity instrument (the 20.1.6 shape): prefill a raw
 * prompt, greedy-decode N tokens through stepSeq, print ids and text.
 *
 * `noroute` disables the QuantKernel device routing first — the cpu
 * backend's q5kQ8WaveMatVecKernel faults intermittently at Mixtral's
 * [4096, 4096] attn_output (2026-08-31, fault addr 0x900030001), and
 * parity must measure the ENGINE, not race a kernel defect. The host
 * floor computes the same values through Quant's serial decoders.
 *
 * Usage: MoeParityProbe <model.gguf> <nTokens> [noroute] -- prompt is
 * fixed: "The capital of France is", encoded with the model's own bos
 * policy.
 */
public class MoeParityProbe {
    public static void run(String[] args) {
        String model = args[0];
        int32 nNew = Integer.parseInt(args[1]);
        if ((int32) args.count() > 2 && args[2].equals("noroute")) {
            QuantKernel.setRoutingEnabled(false);
            System.stdout.println("[device routing OFF - host floor]");
        }
        Checkpoint ck #= Checkpoint.open(model);
        Tokenizer tok #= ck.gguf().tokenizer();
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 256, 1, 0);
        m.bind(ck, false);
        int32[] pids #= tok.encodePrompt("The capital of France is");
        int32 np = (int32) pids.count();
        String ps #= "";
        int32 i = 0;
        while (i < np) {
            ps #= ps + pids[i] + " ";
            i = i + 1;
        }
        System.stdout.println("prompt ids: " + ps);
        int32[] gen = heap int32[nNew];
        int32[] one = heap int32[1];
        int32 nxt = m.prefill(pids, np);
        int32 g = 0;
        while (g < nNew) {
            gen[g] = nxt;
            g = g + 1;
            if (g >= nNew) {
                break;
            }
            one[0] = nxt;
            nxt = m.stepSeq(0, one, 0, 1);
        }
        String ids #= "";
        i = 0;
        while (i < g) {
            ids #= ids + gen[i] + " ";
            i = i + 1;
        }
        System.stdout.println("gen ids: " + ids);
        int8[] txt #= tok.decode(gen, g);
        String out = heap String(#txt, (int32) txt.count());
        System.stdout.println("text: [" + out + "]");
        return;
    }
}
