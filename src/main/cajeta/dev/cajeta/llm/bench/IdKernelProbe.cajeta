package dev.cajeta.llm.bench;

import cajeta.lang.Integer;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.llm.model.MoeFfn;
import dev.cajeta.llm.model.Prim;

/** unit 40 triage: the indirected kernel's effective read rate vs the
 *  wave twin's, same bank, same bytes. Usage: IdKernelProbe <gguf>. */
public class IdKernelProbe {
    public static void run(String[] args) {
        Checkpoint ck #= Checkpoint.open(args[0]);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 64, 1, 0);
        m.bind(ck, false);
        ExpertBank.setResidencyBudget(1152921504606846976L);
        MoeFfn moe = m.moeAt(0);
        ExpertBank gb = moe.gate();
        boolean ok = gb.ensureSlab();
        System.stdout.println("slab: " + ok + " rows " + gb.rows()
            + " cols " + gb.cols() + " experts " + gb.experts());
        int64 rows = (int64) gb.rows();
        int64 cols = (int64) gb.cols();
        int32 used = 8;
        // Staged activation: zeros are fine for a bandwidth probe.
        int64 xBlocks = cols / 256L;
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) (xBlocks * 320L));
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>(
            (uint64) cols);
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<int32> sel #= heap KernelBuffer<int32>((uint64) used);
        int32[] ids = heap int32[used];
        int32 i = 0;
        while (i < used) { ids[i] = i * 13 + 1; i = i + 1; }
        sel.upload(ids, (int64) used);
        KernelBuffer<float32> y #= heap KernelBuffer<float32>(
            (uint64) ((int64) used * rows));
        KernelStream s = QuantKernel.stream();
        s.sync();
        int64 bytesPer = (int64) used * rows * (cols / 256L) * 144L;

        // id-kernel: N launches, one sync.
        int32 N = 50;
        int64 t0 = Clock.nanoTime();
        i = 0;
        while (i < N) {
            gb.idLaunch(y, xp, sel, used, 0L);
            i = i + 1;
        }
        s.sync();
        int64 t1 = Clock.nanoTime();
        float64 gbps = (float64) (bytesPer * (int64) N)
            / ((float64) (t1 - t0));
        System.stdout.println("id-kernel: "
            + ((float64) (t1 - t0) / 1000000.0 / (float64) N)
            + " ms/launch-set  " + gbps + " GB/s");

        // Per-kernel GPU time for the whole zero-sync chain's pieces,
        // serialized (sync per phase), N=200 each, us/launch.
        MoeFfn moe0 = m.moeAt(0);
        ExpertBank ub = moe0.upBank();
        ExpertBank db = moe0.downBank();
        ub.ensureSlab();
        db.ensureSlab();
        int64 hid = cols;                 // 2048
        int64 wid = rows;                 // 768
        KernelBuffer<float32> logits #= heap KernelBuffer<float32>(128L);
        KernelBuffer<float32> wsel #= heap KernelBuffer<float32>(8L);
        KernelBuffer<float32> rw #= heap KernelBuffer<float32>(
            (uint64) (128L * hid));
        KernelBuffer<float32> gy2 #= heap KernelBuffer<float32>(
            (uint64) (8L * wid));
        KernelBuffer<float32> uy2 #= heap KernelBuffer<float32>(
            (uint64) (8L * wid));
        KernelBuffer<float32> dy2 #= heap KernelBuffer<float32>(
            (uint64) (8L * hid));
        KernelBuffer<int8> xpg #= heap KernelBuffer<int8>(
            (uint64) ((8L * wid / 256L) * 320L));
        int32 M = 200;
        int64 u0 = 0L;
        int64 u1 = 0L;

        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            QuantKernel.routerF32MatVecLaunchNoSync(logits, rw, xf,
                128L, hid);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("router  " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            QuantKernel.moeTopKLaunchNoSync(sel, wsel, logits, null,
                128L, 8L, true, 0.0f);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("topk    " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            QuantKernel.q8kPackLaunchNoSync(xp, xf, hid);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("packXn  " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            gb.idLaunch(gy2, xp, sel, 8, 0L);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("gate-id " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            Prim.gluDevice(gy2, uy2, 8L * wid, 0);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("glu     " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            QuantKernel.q8kPackLaunchNoSync(xpg, gy2, 8L * wid);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("packGy  " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            db.idLaunch(dy2, xpg, sel, 8, wid / 256L);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("down-id " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us  (ty "
            + db.packedType() + ")");
        u0 = Clock.nanoTime();
        i = 0;
        while (i < M) {
            QuantKernel.moeCombineLaunchNoSync(xf, dy2, wsel, 8L, hid);
            s.sync();
            i = i + 1;
        }
        System.stdout.println("combine " + ((float64) (Clock.nanoTime()
            - u0) / 1000.0 / (float64) M) + " us");

        // Unit 47 triage: down-bank read rate, back-to-back (one sync
        // per 50), on a Q4_K down layer and a Q6_K one — the shape
        // whose rows are three blocks long.
        int32 li = 0;
        int32 shown = 0;
        while (li < 48 && shown < 2) {
            ExpertBank dbl = m.moeAt(li).downBank();
            boolean want = (shown == 0 && dbl.packedType() == 12)
                || (shown == 1 && dbl.packedType() == 14);
            if (want) {
                dbl.ensureSlab();
                int64 dBytes = (int64) 8 * hid * (wid / 256L)
                    * (dbl.packedType() == 12 ? 144L : 210L);
                s.sync();
                t0 = Clock.nanoTime();
                i = 0;
                while (i < N) {
                    dbl.idLaunch(dy2, xpg, sel, 8, wid / 256L);
                    i = i + 1;
                }
                s.sync();
                t1 = Clock.nanoTime();
                System.stdout.println("down-id layer " + li + " ty "
                    + dbl.packedType() + ": "
                    + ((float64) (t1 - t0) / 1000.0 / (float64) N)
                    + " us/launch  "
                    + ((float64) (dBytes * (int64) N)
                        / (float64) (t1 - t0)) + " GB/s");
                shown = shown + 1;
            }
            li = li + 1;
        }
        // gate-id back-to-back for the same comparison.
        s.sync();
        t0 = Clock.nanoTime();
        i = 0;
        while (i < N) {
            gb.idLaunch(gy2, xp, sel, 8, 0L);
            i = i + 1;
        }
        s.sync();
        t1 = Clock.nanoTime();
        System.stdout.println("gate-id b2b: "
            + ((float64) (t1 - t0) / 1000.0 / (float64) N) + " us/launch  "
            + ((float64) (bytesPer * (int64) N) / (float64) (t1 - t0))
            + " GB/s");

        // wave twin: 8 per-expert launches per set on the SAME slab
        // bytes through slot slices, one sync at the end.
        t0 = Clock.nanoTime();
        i = 0;
        while (i < N) {
            int32 k = 0;
            while (k < used) {
                gb.slotWaveLaunch(ids[k], y, xp,
                    (int64) k * rows);
                k = k + 1;
            }
            i = i + 1;
        }
        s.sync();
        t1 = Clock.nanoTime();
        gbps = (float64) (bytesPer * (int64) N) / ((float64) (t1 - t0));
        System.stdout.println("wave twin: "
            + ((float64) (t1 - t0) / 1000000.0 / (float64) N)
            + " ms/launch-set  " + gbps + " GB/s");
        return;
    }
}
