package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.io.GgufFile;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.WmmaKernel;

/**
 * Epilogue-kernel diagnostic (epilogue plan U3): the Q4_K epi kernels vs
 * the batch kernel on WHICHEVER backend this binary was compiled for —
 * the tier discriminator. A disagreement that reproduces on the cpu
 * software tile is kernel logic; one that exists only on amdgpu is the
 * native epilogue lowering. Prints the first mismatch and the value
 * split at (token 1, row 0), the element the suite flags.
 */
public final class EpiProbe {

    static #int8[] tiled(int8[] raw, int64 reps) {
        int64 n = (int64) raw.count();
        int8[] out #= heap int8[n * reps];
        int64 r = 0;
        while (r < reps) {
            int64 i = 0;
            while (i < n) {
                out[r * n + i] = raw[i];
                i = i + 1;
            }
            r = r + 1;
        }
        return #out;
    }

    public static int32 run(String[] args) {
        int8[] one #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q4_k.bin");
        int8[] raw #= EpiProbe.tiled(one, 4L);
        int64 outDim = 16L;
        int64 cols = (((int64) raw.count() / 144L) / outDim) * 256L;
        int64 rows = 16L;
        float32[] x #= heap float32[rows * cols];
        int64 c #= 0;
        while (c < rows * cols) {
            x[c] = (float32) ((c % 11L) - 5L) * 0.375f;
            c = c + 1;
        }
        float32[] want #= heap float32[rows * outDim];
        float32[] gotStaged #= heap float32[rows * outDim];
        float32[] gotDeq #= heap float32[rows * outDim];
        WmmaKernel.compareEpiInto(raw, x, rows, outDim, cols, want,
            gotStaged, gotDeq);
        System.stdout.println("probe (1,0): batch " + want[16]
            + "  epiStaged " + gotStaged[16] + "  epiDeq " + gotDeq[16]);
        int64 n = rows * outDim;
        int64 k = 0;
        int32 bad = 0;
        while (k < n) {
            float32 a = want[k];
            float32 b = gotStaged[k];
            float32 diff = a - b;
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a < 0.0f ? 0.0f - a : a;
            if (diff > mag * 0.002f + 0.002f) {
                if (bad < 3) {
                    System.stdout.println("MISMATCH k=" + k + " (t="
                        + (k / outDim) + ",i=" + (k % outDim)
                        + "): batch " + a + " epi " + b);
                }
                bad = bad + 1;
            }
            k = k + 1;
        }
        // Per-token mismatch counts — the pattern is the diagnosis.
        int64 t = 0;
        while (t < rows) {
            int32 tb = 0;
            int64 i = 0;
            while (i < outDim) {
                float32 a2 = want[t * outDim + i];
                float32 b2 = gotStaged[t * outDim + i];
                float32 d2 = a2 - b2;
                if (d2 < 0.0f) { d2 = 0.0f - d2; }
                float32 m2 = a2 < 0.0f ? 0.0f - a2 : a2;
                if (d2 > m2 * 0.002f + 0.002f) { tb = tb + 1; }
                i = i + 1;
            }
            System.stdout.println("token " + t + ": " + tb + " bad");
            t = t + 1;
        }
        System.stdout.println(bad == 0 ? "EPIPROBE-AGREE"
            : ("EPIPROBE-DISAGREE " + bad));

        // Decompose: host-compute the dmin term for (t, i=0), t = 0..3,
        // and print the ACTUAL dmin the epi kernel applied (epi - main,
        // where main = batch - hostDmin). Which data the wrong value
        // matches names the bug.
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[rows * pb];
        int64 rr = 0;
        while (rr < rows) {
            Quant.q8kPack(x, rr * cols, cols, xph, rr * pb);
            rr = rr + 1;
        }
        int64 bpr = cols / 256L;
        int64 tt = 0;
        while (tt < 4L) {
            // hostDmin(t, 0) = -sum_b dmin_b0 * xs_t * sum_s mn * ps
            float32 hd = 0.0f;
            int64 bb = 0;
            while (bb < bpr) {
                int64 ro = 0L * (bpr * 144L) + bb * 144L;   // row i=0
                float32 dmin = GgufFile.halfBitsToF32(
                    ((int32) raw[ro + 2L] & 255)
                    | (((int32) raw[ro + 3L] & 255) << 8));
                int64 xb = tt * pb + bb * 320L;
                float32 xs = Cajeta.bitsToF32(
                    ((int32) xph[xb + 288L] & 255)
                    | (((int32) xph[xb + 289L] & 255) << 8)
                    | (((int32) xph[xb + 290L] & 255) << 16)
                    | (((int32) xph[xb + 291L] & 255) << 24));
                int32 dmins = 0;
                int32 s = 0;
                while (s < 8) {
                    int32 dq = (int32) raw[ro + 4L + (int64) (s % 4)] & 255;
                    int32 mq = (int32) raw[ro + 8L + (int64) (s % 4)] & 255;
                    int32 kq = (int32) raw[ro + 12L + (int64) (s % 4)] & 255;
                    int32 mn = 0;
                    if (s < 4) { mn = mq & 63; }
                    else { mn = (kq >> 4) | ((mq >> 2) & 48); }
                    int64 at = xb + 256L + (int64) (s * 4);
                    int32 ps = ((int32) xph[at] & 255)
                        | (((int32) xph[at + 1L] & 255) << 8)
                        | (((int32) xph[at + 2L] & 255) << 16)
                        | (((int32) xph[at + 3L]) << 24);
                    dmins = dmins + mn * ps;
                    s = s + 1;
                }
                hd = hd - dmin * xs * (float32) dmins;
                bb = bb + 1;
            }
            float32 mainT = want[tt * outDim] - hd;
            System.stdout.println("t=" + tt + " i=0: batch "
                + want[tt * outDim] + "  epi " + gotStaged[tt * outDim]
                + "  hostDmin " + hd + "  actualDmin "
                + (gotStaged[tt * outDim] - mainT));
            tt = tt + 1;
        }
        return 0;
    }
}
