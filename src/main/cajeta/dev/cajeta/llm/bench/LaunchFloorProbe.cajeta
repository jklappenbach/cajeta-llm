package dev.cajeta.llm.bench;

import cajeta.lang.System;
import cajeta.lang.String;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Prim;

/** unit 40 triage: the per-launch fixed floor — host submit cost and
 *  GPU inter-kernel bubble — measured with a 64-element kernel. */
public class LaunchFloorProbe {
    public static void run() {
        int64 n = 64L;
        KernelBuffer<float32> a #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> b #= heap KernelBuffer<float32>((uint64) n);
        KernelStream s = QuantKernel.stream();
        Prim.addDevice(a, b, n);
        s.sync();
        int32 N = 2000;
        int64 t0 = Clock.nanoTime();
        int32 i = 0;
        while (i < N) {
            Prim.addDevice(a, b, n);
            i = i + 1;
        }
        int64 t1 = Clock.nanoTime();
        s.sync();
        int64 t2 = Clock.nanoTime();
        System.stdout.println("same-kernel: submit " + ((float64) (t1 - t0)
            / 1000.0 / (float64) N) + " us/launch, drain "
            + ((float64) (t2 - t1) / 1000.0) + " us total, wall "
            + ((float64) (t2 - t0) / 1000.0 / (float64) N)
            + " us/launch");

        // Alternating four DIFFERENT kernels round-robin — the real
        // decode switches kernels every launch; if the switch costs,
        // the per-launch floor above is a best case that never occurs.
        KernelBuffer<float32> c #= heap KernelBuffer<float32>((uint64) n);
        Prim.rmsnormDevice(c, a, b, n, 0.00001f, 0);
        Prim.gluDevice(a, b, n, 0);
        Prim.axpbyDevice(a, b, 0.5f, 1.0f, n);
        s.sync();
        t0 = Clock.nanoTime();
        i = 0;
        while (i < N) {
            Prim.addDevice(a, b, n);
            Prim.rmsnormDevice(c, a, b, n, 0.00001f, 0);
            Prim.gluDevice(a, b, n, 0);
            Prim.axpbyDevice(a, b, 0.5f, 1.0f, n);
            i = i + 1;
        }
        t1 = Clock.nanoTime();
        s.sync();
        t2 = Clock.nanoTime();
        int64 L = (int64) N * 4L;
        System.stdout.println("alternating: submit " + ((float64) (t1 - t0)
            / 1000.0 / (float64) L) + " us/launch, drain "
            + ((float64) (t2 - t1) / 1000.0) + " us total, wall "
            + ((float64) (t2 - t0) / 1000.0 / (float64) L)
            + " us/launch");
        return;
    }
}
