package dev.cajeta.llm.bench;

import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.sched.Request;

/**
 * Minimal replica of EngineTest.engineLoadsGeneratesAndStreams for backend
 * triage: load the toy model through the engine facade, submit one prompt,
 * run to completion, print progress markers so a crash localizes.
 */
public final class EngineProbe {
    public static int32 run() {
        EngineOptions o #= heap EngineOptions("src/test/fixtures/gguf/toy.gguf");
        o.ctx = 64;
        o.maxSeqs = 2;
        o.blockTokens = 4;
        o.chunk = 8;
        System.stdout.println("probe: loading");
        LlmEngine e #= LlmEngine.load(#o);
        System.stdout.println("probe: loaded");
        SampleParams p #= heap SampleParams(0.0f, 0L);
        int32 id = e.submitText("hello world", #p, 6);
        System.stdout.println("probe: submitted");
        e.runAll(64);
        System.stdout.println("probe: ran");
        Request r = e.request(id);
        System.stdout.println("probe: done=" + (r.isDone() ? 1 : 0)
            + " generated=" + r.generatedCount());
        e.close();
        System.stdout.println("probe: closed");
        return 0;
    }
}
