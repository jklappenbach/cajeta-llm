package dev.cajeta.llm.bench;

import cajeta.lang.String;

/**
 * What {@link ParityTable#judge} says about one cajeta/llama.cpp pair
 * (xpu-kernel-adaptor spec §7.1). Either `refused` with a `reason`, or a
 * `ratio` (cajeta time over llama.cpp time at the same shape and
 * residency), `par` (ratio at or under 1.0), and the roofline fraction
 * of each leg beside it, so a tie at 40% of peak reads as a tie at 40%.
 */
public final class ParityVerdict {
    public boolean refused;
    public String reason;
    public float64 ratio;
    public boolean par;
    public float64 ofPeakCajeta;
    public float64 ofPeakLlama;

    public ParityVerdict() {
        this.refused = false;
        this.reason = "";
        this.ratio = 0.0;
        this.par = false;
        this.ofPeakCajeta = 0.0;
        this.ofPeakLlama = 0.0;
    }

    static #ParityVerdict refuse(String why) {
        ParityVerdict v #= heap ParityVerdict();
        v.refused = true;
        v.reason = "" + why;
        return #v;
    }
}
