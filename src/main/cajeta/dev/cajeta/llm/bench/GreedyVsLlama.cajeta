package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.sched.Request;

/**
 * Greedy token agreement against llama.cpp on the reference model
 * (xpu-kernel-adaptor plan 8.1.3; spec §7.1 "not par: correctness is
 * gated first"). `tools/parity/llama-greedy` writes llama.cpp's prompt
 * ids and its greedy walk with the top-2 logit gap at every position;
 * this loads the same GGUF through {@link LlmEngine} on the requested
 * device, submits THE SAME PROMPT IDS (so the tokenizers are out of the
 * comparison), decodes greedily, and feeds both walks to
 * {@link GreedyAgreement}.
 *
 * The verdict is spec 12.3's: rate at or above 0.99 and every divergence
 * at a top-2 gap under 1e-3 — a divergence where llama.cpp's own top two
 * were within f32 noise of each other is a tie, anything else is a
 * defect in one of the two engines and is named by position.
 *
 * A measurement instrument, not a selftest (it needs the 4.9 GB model).
 *
 *   GreedyVsLlama.run --model M.gguf --ref greedy.tsv --device cuda [--n 32]
 */
public class GreedyVsLlama {

    static int32 fieldStart(String line, int32 idx) {
        int32 pos = 0;
        int32 f = 0;
        while (f < idx) {
            int64 t = line.indexOfFrom("\t", (int64) pos);
            if (t < 0L) { return -1; }
            pos = (int32) t + 1;
            f = f + 1;
        }
        return pos;
    }

    static #String field(String line, int32 idx) {
        int32 s = GreedyVsLlama.fieldStart(line, idx);
        if (s < 0) { return #""; }
        int64 e = line.indexOfFrom("\t", (int64) s);
        if (e < 0L) { e = line.size(); }
        String out #= line.substring(s, (int32) e);
        return #out;
    }

    static int32 countCommas(String s) {
        int32 c = 0;
        int64 p = 0;
        while (true) {
            int64 t = s.indexOfFrom(",", p);
            if (t < 0L) { return c; }
            c = c + 1;
            p = t + 1L;
        }
    }

    public static int32 run(String[] args) {
        String model #= "";
        String ref #= "";
        String device #= "";
        int32 maxNew = 32;
        int32 i = 0;
        int32 n = (int32) args.count();
        while (i < n) {
            if (args[i].equals("--model") && i + 1 < n) { model #= "" + args[i + 1]; i = i + 2; }
            else if (args[i].equals("--ref") && i + 1 < n) { ref #= "" + args[i + 1]; i = i + 2; }
            else if (args[i].equals("--device") && i + 1 < n) { device #= "" + args[i + 1]; i = i + 2; }
            else if (args[i].equals("--n") && i + 1 < n) { maxNew = Integer.parseInt(args[i + 1]); i = i + 2; }
            else { i = i + 1; }
        }
        if (model.size() == 0L || ref.size() == 0L) {
            System.stdout.println("usage: GreedyVsLlama.run --model M.gguf --ref greedy.tsv"
                + " --device cuda [--n 32]");
            return 2;
        }

        // The reference walk.
        int8[] raw #= File.readAllBytes(ref);
        String text #= heap String(#raw, (int32) raw.count());
        int32[] promptIds = null;
        int32 promptN = 0;
        int32[] refIds #= heap int32[1024];
        float32[] refGaps #= heap float32[1024];
        int32 refN = 0;
        int64 p = 0;
        int64 len = text.size();
        while (p < len) {
            int64 nl = text.indexOfFrom("\n", p);
            if (nl < 0L) { nl = len; }
            String line #= text.substring((int32) p, (int32) nl);
            p = nl + 1L;
            if (line.startsWith("prompt-ids\t")) {
                promptN = Integer.parseInt(GreedyVsLlama.field(line, 1));
                String ids #= GreedyVsLlama.field(line, 2);
                promptIds #= heap int32[promptN];
                int32 k = 0;
                int64 q = 0;
                while (k < promptN) {
                    int64 c = ids.indexOfFrom(",", q);
                    if (c < 0L) { c = ids.size(); }
                    promptIds[k] = Integer.parseInt(ids.substring((int32) q, (int32) c));
                    q = c + 1L;
                    k = k + 1;
                }
            } else if (line.startsWith("greedy\t") && refN < 1024) {
                refIds[refN] = Integer.parseInt(GreedyVsLlama.field(line, 2));
                refGaps[refN] = (float32) Double.parseDouble(GreedyVsLlama.field(line, 3));
                refN = refN + 1;
            }
        }
        if (promptIds == null || refN == 0) {
            System.stdout.println("reference file carries no prompt-ids or greedy lines: " + ref);
            return 2;
        }
        System.stdout.println("reference: " + promptN + " prompt ids, " + refN
            + " greedy tokens from llama.cpp");

        // cajeta's walk on the same ids.
        EngineOptions o #= heap EngineOptions(model);
        o.ctx = 512;
        o.maxSeqs = 1;
        if (device.size() > 0L) { o.device = "" + device; }
        LlmEngine e #= LlmEngine.load(#o);
        System.stdout.println("engine: backend " + Device.activeBackend());
        SampleParams sp #= heap SampleParams(0.0f, 0L);
        int32 id = e.submitTokens(promptIds, promptN, maxNew, #sp);
        e.runAll(o.ctx * 4);
        Request r = e.request(id);
        int32 got = r.generatedCount();
        System.stdout.println("cajeta: " + got + " greedy tokens");

        GreedyAgreement ga #= heap GreedyAgreement(1024);
        int32 m = got;
        if (refN < m) { m = refN; }
        String cajetaIds #= "";
        String llamaIds #= "";
        int32 j = 0;
        while (j < m) {
            int32 c = r.generatedAt(j);
            ga.add(j, refIds[j], c, refGaps[j]);
            cajetaIds #= cajetaIds + (j > 0 ? "," : "") + c;
            llamaIds #= llamaIds + (j > 0 ? "," : "") + refIds[j];
            j = j + 1;
        }
        System.stdout.println("llama.cpp: " + llamaIds);
        System.stdout.println("cajeta:    " + cajetaIds);
        int32 d = 0;
        while (d < ga.divergences()) {
            int32 pos = ga.divergencePosition(d);
            System.stdout.println("  divergence at " + pos + ": llama.cpp " + refIds[pos]
                + " (top-2 gap " + ga.divergenceGap(d) + "), cajeta " + r.generatedAt(pos));
            d = d + 1;
        }
        // The positional rate alone misreads a single early divergence: the
        // two walks realign a token later and agree from there, and every
        // position after the shift counts as a divergence. So beside it: the
        // agreeing prefix, and how many of llama.cpp's remaining tokens
        // cajeta's remaining walk reproduces in order (a realigned match).
        int32 prefix = 0;
        while (prefix < m && r.generatedAt(prefix) == refIds[prefix]) {
            prefix = prefix + 1;
        }
        // Longest common subsequence of the two remainders, so a walk that
        // dropped or added a token and continued in step is read as such.
        int32 rest = m - prefix;
        int32[] lcs #= heap int32[(rest + 1) * (rest + 1)];
        int32 a = 0;
        while (a < (rest + 1) * (rest + 1)) { lcs[a] = 0; a = a + 1; }
        int32 li = 1;
        while (li <= rest) {
            int32 ci = 1;
            while (ci <= rest) {
                int32 here = li * (rest + 1) + ci;
                if (refIds[prefix + li - 1] == r.generatedAt(prefix + ci - 1)) {
                    lcs[here] = lcs[(li - 1) * (rest + 1) + (ci - 1)] + 1;
                } else {
                    int32 up = lcs[(li - 1) * (rest + 1) + ci];
                    int32 left = lcs[li * (rest + 1) + (ci - 1)];
                    lcs[here] = up > left ? up : left;
                }
                ci = ci + 1;
            }
            li = li + 1;
        }
        int32 realigned = lcs[rest * (rest + 1) + rest];
        float32 firstGap = 0.0f;
        if (prefix < m) { firstGap = refGaps[prefix]; }
        System.stdout.println("agreeing prefix " + prefix + " of " + m
            + "; first divergence at " + prefix + " with llama.cpp's top-2 gap "
            + firstGap + "; " + realigned + " of the remaining " + (m - prefix)
            + " llama.cpp tokens reproduced in order after it");
        boolean ok = ga.passes(0.99, 0.001f);
        System.stdout.println("greedy-agreement\t" + Device.activeBackend() + "\t"
            + m + "\t" + ga.agreementRate() + "\t" + ga.divergences() + "\t"
            + prefix + "\t" + firstGap + "\t" + realigned + "\t"
            + (ok ? "PASS" : "FAIL"));
        e.close();
        return ok ? 0 : 1;
    }
}
