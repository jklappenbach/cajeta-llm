package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.xpu.Device;

/**
 * The bench's memory figures for spec 12.11: the process's host peak (VmHWM) and the device's peak
 * use above the level at `start()`. On an AMD card the device side reads the driver's sysfs VRAM and
 * GTT counters, which need no device touch and count the runtime's context; elsewhere it asks the
 * driver's free memory, which touches the device at `start()` and so leaves out the context it creates.
 * Device-wide counters include other processes, and peaks are sampled where the caller calls `sample()`.
 */
public final class MemoryMeter {
    private String sysfs;
    private int64 idle;
    private int64 peak;
    private boolean known;

    public MemoryMeter() {
        this.sysfs = "";
        this.idle = 0L;
        this.peak = 0L;
        this.known = false;
        return;
    }

    /** Takes the idle level; touches the device only where no AMD sysfs counter exists. */
    public static #MemoryMeter start() {
        MemoryMeter m = heap MemoryMeter();
        int32 c = 0;
        while (c < 16) {
            String dir = "/sys/class/drm/card" + c + "/device/";
            Path p #= Path.of(dir + "mem_info_vram_used");
            if (p.exists()) {
                m.sysfs = "" + dir;
                break;
            }
            c = c + 1;
        }
        int64 used = m.usedBytes();
        if (used >= 0L) {
            m.idle = used;
            m.known = true;
        }
        return #m;
    }

    /** Records the device's current use if it is above the peak so far. */
    public void sample() {
        if (!this.known) { return; }
        int64 over = this.usedBytes() - this.idle;
        if (over > this.peak) { this.peak = over; }
        return;
    }

    /** Peak device use above idle in KiB, 0 on the cpu backend, -1 when this box cannot tell. */
    public int64 devicePeakKb() {
        if (Device.activeBackend().equals("cpu")) { return 0L; }
        if (!this.known) { return -1L; }
        return this.peak / 1024L;
    }

    /** Where the device figure comes from, for the report. */
    public #String source() {
        if (this.sysfs.byteLength() > 0) {
            String s = "amdgpu sysfs " + this.sysfs + " vram+gtt above idle";
            return #s;
        }
        if (this.known) {
            String d = "driver free memory, above the first device touch";
            return #d;
        }
        String n = "none";
        return #n;
    }

    /** The process's peak resident set (VmHWM) in KiB. */
    public static int64 hostPeakKb() {
        return MemoryMeter.statusKb("VmHWM:");
    }

    private int64 usedBytes() {
        if (this.sysfs.byteLength() > 0) {
            int64 v = MemoryMeter.readNumber(this.sysfs + "mem_info_vram_used");
            int64 g = MemoryMeter.readNumber(this.sysfs + "mem_info_gtt_used");
            if (v < 0L || g < 0L) { return -1L; }
            return v + g;
        }
        int64 free = Device.freeMemoryBytes();
        if (free <= 0L) { return -1L; }
        return Device.memoryBytes() - free;
    }

    private static int64 readNumber(String path) {
        File f #= File.open(path, OpenMode.READ);
        int8[] b #= heap int8[64];
        int64 n = f.read(b, 0, 64);
        f.close();
        int64 v = 0L;
        int64 i = 0L;
        boolean seen = false;
        while (i < n && b[i] >= 48 && b[i] <= 57) {
            v = v * 10L + (int64) (b[i] - 48);
            seen = true;
            i = i + 1L;
        }
        if (!seen) { return -1L; }
        return v;
    }

    private static int64 statusKb(String key) {
        File f #= File.open("/proc/self/status", OpenMode.READ);
        int8[] st #= heap int8[8192];
        int64 n = f.read(st, 0, 8192);
        f.close();
        int64 k = (int64) key.byteLength();
        int64 i = 0L;
        while (i + k < n) {
            boolean hit = i == 0L || st[i - 1L] == 10;
            int64 j = 0L;
            while (hit && j < k) {
                if (st[i + j] != key.byteAt((int32) j)) { hit = false; }
                j = j + 1L;
            }
            if (hit) {
                int64 p = i + k;
                int64 v = 0L;
                while (p < n && st[p] != 10) {
                    if (st[p] >= 48 && st[p] <= 57) { v = v * 10L + (int64) (st[p] - 48); }
                    p = p + 1L;
                }
                return v;
            }
            i = i + 1L;
        }
        return 0L;
    }
}
