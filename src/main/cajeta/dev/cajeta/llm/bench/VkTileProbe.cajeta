package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.WmmaKernel;
import dev.cajeta.llm.io.Quant;
import cajeta.io.file.File;

/**
 * Bisect of the shader-tier shared-tile WMMA miscompile (the KNOWN DEFECT
 * recorded 2026-08-25: the portable software tile computes live but WRONG
 * values under the SPIR-V backend while the SAME lowering is correct on
 * the cpu backend).
 *
 * The portable tile is a per-invocation Function-storage array walked with
 * computed indices — machinery source code cannot reach directly, so the
 * bisect uses the tile verbs themselves, smallest first:
 *
 *   stage 1  splat -> store          (accumulator write path only)
 *   stage 2  A x identity -> store   (isolates the A-tile load: result == A)
 *   stage 3  A x B -> store          (the full multiply loop)
 *
 * (A first cut tried an A-fragment load->store roundtrip as stage 2; the
 * AMDGPU control measured 239/256 wrong with a PERFECT stage 3 — storing a
 * non-accumulator fragment is not a defined tile op, so that stage tested
 * the probe, not the backend. A x identity reaches the same load path
 * through the defined accumulator store.)
 *
 * Whichever stage goes wrong first names the defective lowering; the
 * amdgpu native tier is the measured-good control.
 */
public final class VkTileProbe {

    @Kernel
    public static void tileSplatKernel(KernelBuffer<int32> c) {
        CooperativeMatrix<int32,16,16,2> mc;
        mc.splat(7);
        mc.store(c, 0, 0, 16);
    }

    @Kernel
    public static void tileMmaKernel(KernelBuffer<int32> c,
            KernelBuffer<int8> a, KernelBuffer<int8> b, uint32 depth) {
        CooperativeMatrix<int32,16,16,2> mc;
        mc.splat(0);
        CooperativeMatrix<int8,16,16,0> ma;
        CooperativeMatrix<int8,16,16,1> mb;
        ma.load(a, 0, 0, depth);
        mb.load(b, 0, 0, depth);
        mc.mma(ma, mb);
        mc.store(c, 0, 0, 16);
    }

    static int64 checkSplat() {
        int32[] cH #= heap int32[256];
        KernelBuffer<int32> cD = heap KernelBuffer<int32>((uint64) 256);
        KernelStream s = QuantKernel.stream();
        tileSplatKernel.launch(s, grid: [1], block: [32])(cD);
        s.sync();
        cD.download(cH);
        int64 bad = 0;
        int32 i = 0;
        while (i < 256) {
            if (cH[i] != 7) {
                if (bad < 3L) {
                    System.stdout.println("  splat[" + i + "]: got " + cH[i]
                        + " want 7");
                }
                bad = bad + 1;
            }
            i = i + 1;
        }
        return bad;
    }

    static int64 checkAxIdentity() {
        int8[] a #= heap int8[256];
        int8[] ident #= heap int8[256];
        int32 i = 0;
        while (i < 256) {
            a[i] = (int8) ((i * 7 + 3) % 17 - 8);
            ident[i] = (int8) 0;
            i = i + 1;
        }
        i = 0;
        while (i < 16) { ident[i * 16 + i] = (int8) 1; i = i + 1; }
        int32[] cH #= heap int32[256];
        KernelBuffer<int8> aD = heap KernelBuffer<int8>((uint64) 256);
        KernelBuffer<int8> iD = heap KernelBuffer<int8>((uint64) 256);
        KernelBuffer<int32> cD = heap KernelBuffer<int32>((uint64) 256);
        aD.upload(a);
        iD.upload(ident);
        KernelStream s = QuantKernel.stream();
        tileMmaKernel.launch(s, grid: [1], block: [32])(cD, aD, iD, (uint32) 16);
        s.sync();
        cD.download(cH);
        int64 bad = 0;
        i = 0;
        while (i < 256) {
            if (cH[i] != (int32) a[i]) {
                if (bad < 3L) {
                    System.stdout.println("  AxI[" + i + "]: got " + cH[i]
                        + " want " + (int32) a[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }
        return bad;
    }

    static int64 checkMma() {
        int32 dim = 16;
        int8[] a #= heap int8[dim * dim];
        int8[] b #= heap int8[dim * dim];
        int32 i = 0;
        while (i < dim * dim) {
            a[i] = (int8) ((i * 7 + 3) % 17 - 8);
            b[i] = (int8) ((i * 11 + 5) % 15 - 7);
            i = i + 1;
        }
        int32[] cH #= heap int32[dim * dim];
        KernelBuffer<int8> aD = heap KernelBuffer<int8>((uint64) (dim * dim));
        KernelBuffer<int8> bD = heap KernelBuffer<int8>((uint64) (dim * dim));
        KernelBuffer<int32> cD = heap KernelBuffer<int32>((uint64) (dim * dim));
        aD.upload(a);
        bD.upload(b);
        KernelStream s = QuantKernel.stream();
        tileMmaKernel.launch(s, grid: [1], block: [32])(cD, aD, bD, (uint32) 16);
        s.sync();
        cD.download(cH);
        int64 bad = 0;
        int32 r = 0;
        while (r < dim) {
            int32 cc = 0;
            while (cc < dim) {
                int32 want = 0;
                int32 k = 0;
                while (k < dim) {
                    want = want + (int32) a[r * dim + k] * (int32) b[k * dim + cc];
                    k = k + 1;
                }
                int32 got = cH[r * dim + cc];
                if (got != want) {
                    if (bad < 5L) {
                        System.stdout.println("  mma[" + r + "," + cc
                            + "]: got " + got + " want " + want);
                    }
                    bad = bad + 1;
                }
                cc = cc + 1;
            }
            r = r + 1;
        }
        return bad;
    }

    /** Stage 4 — the ENGINE-SCALE batch GEMM: q4kQ8BatchMatMulKernel at
     *  512 x 4096 x 4096 (a real prefill projection shape), first four
     *  token rows checked against the host integer mat-vec. The 16-row
     *  pair tests pass while the engine route emits garbage at 130 ms —
     *  physically too fast for the GEMM volume — so the question is
     *  whether the KERNEL drops work at scale or the ENGINE route does. */
    static int64 checkBatchAtScale() {
        int8[] fix #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/q4_k.bin");
        int64 bb = (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 512L;
        int64 outDim = 4096L;
        int64 cols = 4096L;
        int64 rowBytes = (cols / 256L) * bb;
        int8[] raw #= heap int8[outDim * rowBytes];
        int64 fixBlocks = (int64) fix.count() / bb;
        int64 blocks = outDim * (cols / 256L);
        int64 b = 0;
        while (b < blocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= VkTileProbe.activationsL(rows * cols);
        float32[] want #= heap float32[rows * outDim];
        float32[] got #= heap float32[rows * outDim];
        WmmaKernel.compareInto(raw, x, rows, outDim, cols, want, got);
        // Host truth on token rows 0..3 (batch output row r, col o at
        // r*outDim+o); q8k-quantized activations to match the kernel's read.
        float32[] xr #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) { xr[i] = x[i]; i = i + 1; }
        int64 zero = 0;
        i = 0;
        while (i < rows * outDim) {
            if (got[i] == 0.0f) { zero = zero + 1; }
            i = i + 1;
        }
        int64 bad = 0;
        int64 r = 0;
        while (r < 4L) {
            float32[] hostRow #= heap float32[outDim];
            Quant.q4kMatVecInto(raw, outDim, cols, xr, r * cols,
                hostRow, 0L);
            int64 o = 0;
            while (o < outDim) {
                float32 a = hostRow[o];
                float32 g = got[r * outDim + o];
                float32 diff = a - g;
                if (diff < 0.0f) { diff = 0.0f - diff; }
                float32 mag = a < 0.0f ? 0.0f - a : a;
                if (diff > mag * 0.02f + 0.02f) {
                    if (bad < 4L) {
                        System.stdout.println("  batch[" + r + "," + o
                            + "]: got " + g + " want " + a);
                    }
                    bad = bad + 1;
                }
                o = o + 1;
            }
            r = r + 1;
        }
        System.stdout.println("  scale zeroFrac: " + zero + "/"
            + (rows * outDim));
        return bad;
    }

    /**
     * Stage 5 — the context-loss bisect. The engine's batched prefill
     * loses the RADV context with 224 GEMMs in flight across two kernel
     * families and four shapes; in-engine localization by value probes
     * named "the first Q6 kernel" and was wrong twice. Here each family
     * runs ALONE at each engine shape, a print before every launch, a
     * sync after: the first line without its "ok" names the killer.
     * Values are irrelevant to a hang probe, so the weight/activation
     * buffers are whatever the allocator hands back.
     */
    static void s5(String name, int32 mode, int64 rows, int64 outDim,
            int64 cols) {
        System.stdout.println("stage5 " + name + ": " + rows + "x"
            + outDim + "x" + cols);
        int64 bb = (int64) Quant.blockBytes(
            mode == 2 ? Quant.GG_Q6_K : Quant.GG_Q4_K);
        int64 rowBytes = (cols / 256L) * bb;
        int64 pb = Quant.q8kPackedBytes(cols);
        KernelBuffer<int8> wDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowBytes));
        KernelBuffer<int8> xDev #= heap KernelBuffer<int8>(
            (uint64) (rows * pb));
        KernelBuffer<float32> yDev #= heap KernelBuffer<float32>(
            (uint64) (rows * outDim));
        KernelStream s = QuantKernel.stream();
        if (mode == 0) {
            QuantKernel.q4kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev,
                rows, outDim, cols);
        } else if (mode == 1) {
            KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
                (uint64) (outDim * cols));
            WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
            WmmaKernel.q4kWmmaDeqMwLaunch(yDev, wDev, deqDev, xDev, rows,
                outDim, cols);
        } else if (mode == 3) {   // widen alone
            KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
                (uint64) (outDim * cols));
            WmmaKernel.q4kWidenLaunch(deqDev, wDev, outDim, cols);
        } else if (mode == 4) {   // deqMw alone (deq contents are garbage)
            KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
                (uint64) (outDim * cols));
            WmmaKernel.q4kWmmaDeqMwLaunch(yDev, wDev, deqDev, xDev, rows,
                outDim, cols);
        } else if (mode == 5) {
            // Canary: sentinel-filled guard bands around y, one deqMw run,
            // then count scribbles outside [pad, pad+n). An OOB WRITE on the
            // first execution — landing in GPU-resident metadata the SECOND
            // dispatch consumes — is the standing hypothesis for
            // first-ok-second-dies (correct first-run values, robustness
            // does not save it).
            int64 pad = 262144L;
            int64 n = rows * outDim;
            KernelBuffer<float32> yBig #= heap KernelBuffer<float32>(
                (uint64) (n + pad * 2L));
            float32[] sent #= heap float32[n + pad * 2L];
            int64 q = 0;
            while (q < n + pad * 2L) { sent[q] = 12345.0f; q = q + 1; }
            yBig.upload(sent);
            KernelBuffer<float32> yView #= yBig.slice((uint64) pad,
                (uint64) n);
            KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
                (uint64) (outDim * cols));
            WmmaKernel.q4kWmmaDeqMwLaunch(yView, wDev, deqDev, xDev, rows,
                outDim, cols);
            s.sync();
            yBig.download(sent, n + pad * 2L);
            int64 loScr = 0;
            int64 hiScr = 0;
            int64 firstHi = 0L - 1L;
            int64 lastLo = 0L - 1L;
            q = 0;
            while (q < pad) {
                if (sent[q] != 12345.0f) { loScr = loScr + 1; lastLo = q; }
                q = q + 1;
            }
            q = pad + n;
            while (q < n + pad * 2L) {
                if (sent[q] != 12345.0f) {
                    hiScr = hiScr + 1;
                    if (firstHi < 0L) { firstHi = q - pad - n; }
                }
                q = q + 1;
            }
            System.stdout.println("  canary: lo " + loScr + " (last idx "
                + lastLo + " of pad " + pad + ")  hi " + hiScr
                + " (first at +" + firstHi + ")");
        } else {
            QuantKernel.q6kQ8BatchMatMulLaunchNoSync(yDev, wDev, xDev,
                rows, outDim, cols);
        }
        s.sync();
        System.stdout.println("  ok " + name);
        return;
    }

    static #float32[] activationsL(int64 n) {
        float32[] x #= heap float32[n];
        int64 i = 0;
        while (i < n) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.03125f;
            i = i + 1;
        }
        return #x;
    }

    public static int32 run() {
        System.stdout.println("backend: " + Device.activeBackend());
        int64 b1 = VkTileProbe.checkSplat();
        System.stdout.println("stage1 splat->store: " + b1 + "/256 wrong");
        int64 b2 = VkTileProbe.checkAxIdentity();
        System.stdout.println("stage2 A x identity: " + b2 + "/256 wrong");
        int64 b3 = VkTileProbe.checkMma();
        System.stdout.println("stage3 load->mma:    " + b3 + "/256 wrong");
        int64 b4 = VkTileProbe.checkBatchAtScale();
        System.stdout.println("stage4 batch@512x4096x4096: " + b4
            + "/16384 wrong (first 4 rows)");
        // Measured so far: the SECOND execution of q4kWmmaDeqMwKernel —
        // identical shape, same pipeline — loses the context (widen and the
        // dotAccum kernels are clean). Canary the output for an OOB write.
        VkTileProbe.s5("canary-qo", 5, 512L, 4096L, 4096L);
        VkTileProbe.s5("deqMwOnly-after-canary", 4, 512L, 4096L, 4096L);
        return (b1 + b2 + b3 + b4) == 0L ? 0 : 1;
    }
}
