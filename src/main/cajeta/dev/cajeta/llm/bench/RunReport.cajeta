package dev.cajeta.llm.bench;

import cajeta.lang.String;
import dev.cajeta.llm.sched.Scheduler;
import dev.cajeta.llm.store.BlockStore;

/**
 * The measurement report emitter (plan 15.2.5): every throughput number
 * travels with the §12.10 fields — model, quantization, backend, context
 * length, batch size, COMPILER MODE and LIVE-SET setting (Release and
 * Minimal differ in locking and bounds checking, so a number without
 * them is not comparable) — and a run that preempted also carries the
 * §12.16 fields: eviction count, bytes written to the store, and cache
 * hit rate (throughput on a warm prefix cache is not comparable to a
 * cold one). The emitter is deliberately dumb: callers fill what they
 * measured; render() refuses nothing but omits the §12.16 block only
 * when the run did not preempt.
 */
public final class RunReport {
    // §12.10 — identity of the measurement.
    public String model;
    public String quantization;
    public String backend;
    public int32 contextLength;
    public int32 batchSize;
    public String compilerMode;
    public String liveSet;
    // The measured numbers.
    public float64 decodeTps;
    public float64 prefillTps;
    public int64 residentKb;
    // §12.11 — host peak plus device above idle; deviceKb -1 when unmeasured.
    public int64 hostPeakKb;
    public int64 deviceKb;
    public String memorySource;
    // §12.16 — set when the run preempted.
    public boolean preempted;
    public int64 evictions;
    public int64 storeBytesWritten;
    public float64 cacheHitRate;

    public RunReport(String model, String quantization, String backend,
            int32 contextLength, int32 batchSize, String compilerMode,
            String liveSet) {
        this.model = "" + model;
        this.quantization = "" + quantization;
        this.backend = "" + backend;
        this.contextLength = contextLength;
        this.batchSize = batchSize;
        this.compilerMode = "" + compilerMode;
        this.liveSet = "" + liveSet;
        this.decodeTps = 0.0;
        this.prefillTps = 0.0;
        this.residentKb = 0;
        this.hostPeakKb = 0;
        this.deviceKb = 0;
        this.memorySource = "";
        this.preempted = false;
        this.evictions = 0;
        this.storeBytesWritten = 0;
        this.cacheHitRate = 0.0;
    }

    /** §12.16 wiring: fill the preemption block from a finished run.
     *  With a store attached an eviction IS a write (6.30), so the
     *  eviction count is the store's write count; hit rate is
     *  hits/(hits+misses), 0 when the store was never consulted. */
    public void recordStore(Scheduler sch, BlockStore s) {
        this.preempted = sch.preemptedCount() > 0;
        this.evictions = s.writes();
        this.storeBytesWritten = s.bytesWritten();
        int64 h = s.hits();
        int64 miss = s.misses();
        if (h + miss > (int64) 0) {
            this.cacheHitRate = (float64) h / (float64) (h + miss);
        } else {
            this.cacheHitRate = 0.0;
        }
        return;
    }

    /** §12.11: the resident figure is the host peak plus the device's use above idle;
     *  a device that could not be measured (`deviceKb` < 0) leaves it unknown. */
    public void recordMemory(int64 hostPeakKb, int64 deviceKb, String source) {
        this.hostPeakKb = hostPeakKb;
        this.deviceKb = deviceKb;
        this.memorySource = "" + source;
        if (deviceKb < 0L) {
            this.residentKb = -1L;
        } else {
            this.residentKb = hostPeakKb + deviceKb;
        }
        return;
    }

    public #String render() {
        String s = "model: " + this.model + "\n"
            + "quantization: " + this.quantization + "\n"
            + "backend: " + this.backend + "\n"
            + "contextLength: " + this.contextLength + "\n"
            + "batchSize: " + this.batchSize + "\n"
            + "compilerMode: " + this.compilerMode + "\n"
            + "liveSet: " + this.liveSet + "\n"
            + "decodeTps: " + this.decodeTps + "\n"
            + "prefillTps: " + this.prefillTps + "\n"
            + "residentKb: " + RunReport.kb(this.residentKb) + "\n";
        if (this.memorySource.byteLength() > 0) {
            s = s + "hostPeakKb: " + this.hostPeakKb + "\n"
                + "deviceKb: " + RunReport.kb(this.deviceKb) + "\n"
                + "memorySource: " + this.memorySource + "\n";
        }
        if (this.preempted) {
            s = s + "evictions: " + this.evictions + "\n"
                + "storeBytesWritten: " + this.storeBytesWritten + "\n"
                + "cacheHitRate: " + this.cacheHitRate + "\n";
        }
        return #s;
    }

    private static #String kb(int64 v) {
        if (v < 0L) {
            String u = "unknown";
            return #u;
        }
        String n = "" + v;
        return #n;
    }
}
