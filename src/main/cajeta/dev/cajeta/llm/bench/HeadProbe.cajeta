package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;
import dev.cajeta.llm.io.QuantKernel;

/** Unit 51 triage: the wave mat-vecs on the lm-head shape (151936 x
 *  2048), q6k vs q4k on synthetic bytes, back to back. */
public class HeadProbe {
    /** The small-launch DRAM rate: 16 distinct copies of the weight
     *  (more than the last-level cache holds) launched round-robin
     *  back to back, no sync inside, so every launch streams from
     *  DRAM as it does in a decode token. */
    static void shape(int64 rows, int64 cols, String tag) {
        int64 b4 = rows * (cols / 256L) * 144L;
        int32 copies = 16;
        int8[] h4 = heap int8[b4];
        int64 i = 0;
        while (i < b4) { h4[i] = (int8) ((i * 131L + 17L) % 256L); i = i + 1; }
        KernelBuffer<int8>[] ws = heap KernelBuffer<int8>[copies];
        int32 c = 0;
        while (c < copies) {
            ws[c] #= heap KernelBuffer<int8>((uint64) b4);
            ws[c].upload(h4, b4);
            c = c + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>((uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) rows);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32 N = 64;
        int64 t0 = Clock.nanoTime();
        i = 0;
        while (i < (int64) N) {
            QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, ws[(int32) (i % (int64) copies)],
                xp, rows, cols, 0L);
            i = i + 1;
        }
        s.sync();
        int64 tot = Clock.nanoTime() - t0;
        System.stdout.println(tag + " q4k wave " + rows + "x" + cols
            + " DRAM b2b: " + ((float64) tot / 1000.0 / (float64) N) + " us  "
            + ((float64) (b4 * (int64) N) / (float64) tot) + " GB/s");
        return;
    }

    /** Touch copy i (same stream), then the mat-vec on it: under the
     *  profiler, the mat-vec's own duration says whether the touch
     *  left the bytes in a cache it can hit. Every other launch is
     *  untouched, as the control. */
    static void touched(int64 rows, int64 cols) {
        int64 b4 = rows * (cols / 256L) * 144L;
        int32 copies = 16;
        int8[] h4 = heap int8[b4];
        int64 i = 0;
        while (i < b4) { h4[i] = (int8) ((i * 131L + 17L) % 256L); i = i + 1; }
        KernelBuffer<int8>[] ws = heap KernelBuffer<int8>[copies];
        int32 c = 0;
        while (c < copies) {
            ws[c] #= heap KernelBuffer<int8>((uint64) b4);
            ws[c].upload(h4, b4);
            c = c + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>((uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int32> sink #= heap KernelBuffer<int32>((uint64) 4);
        KernelStream s = QuantKernel.stream();
        s.sync();
        // Pattern per step: touch(c), matvec(other), matvec(c). If the
        // touched bytes survive an intervening 4.7 MB read, the cache
        // is the big one; if not, it was the L2.
        i = 0;
        while (i < 32L) {
            int32 ci = (int32) (i % (int64) copies);
            int32 co = (int32) ((i + 5L) % (int64) copies);
            QuantKernel.touchLinesMainNoSync(ws[ci], b4);
            QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, ws[co], xp, rows, cols, 0L);
            QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, ws[ci], xp, rows, cols, 0L);
            i = i + 1;
        }
        s.sync();
        System.stdout.println("touched-vs-not sequence done (read the profile)");
        return;
    }

    /** The DRAM read ceiling: every lane streams 16-byte vectors, a
     *  wave 512 contiguous bytes per load, eight loads in flight per
     *  lane (4 KB per wave), the whole buffer covered — no compute,
     *  no reduction, the sum steered never to hit `needle`. */
    @Kernel
    public static void streamReadKernel(KernelBuffer<int8> w, KernelBuffer<int32> sink,
            int64 bytes, int32 needle) {
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        int64 base = (int64) wave * 4096L + (int64) lane * 16L;
        if (base + 3584L + 16L <= bytes) {
            Vector<int8,16> v0 = w.vload<16>(base);
            Vector<int8,16> v1 = w.vload<16>(base + 512L);
            Vector<int8,16> v2 = w.vload<16>(base + 1024L);
            Vector<int8,16> v3 = w.vload<16>(base + 1536L);
            Vector<int8,16> v4 = w.vload<16>(base + 2048L);
            Vector<int8,16> v5 = w.vload<16>(base + 2560L);
            Vector<int8,16> v6 = w.vload<16>(base + 3072L);
            Vector<int8,16> v7 = w.vload<16>(base + 3584L);
            Vector<int8,16> x = v0 ^ v1 ^ v2 ^ v3 ^ v4 ^ v5 ^ v6 ^ v7;
            int32 acc = (int32) x[0] + (int32) x[5] + (int32) x[10] + (int32) x[15];
            if (acc == needle) { sink[0L] = acc; }
        }
    }

    static void ceiling(int64 bytes) {
        int8[] h = heap int8[bytes];
        int64 i = 0;
        while (i < bytes) { h[i] = (int8) ((i * 131L + 17L) % 256L); i = i + 1; }
        KernelBuffer<int8> w #= heap KernelBuffer<int8>((uint64) bytes);
        w.upload(h, bytes);
        KernelBuffer<int32> sink #= heap KernelBuffer<int32>((uint64) 4);
        KernelStream s = QuantKernel.stream();
        uint32 waves = (uint32) (bytes / 4096L);
        int32 N = 20;
        int32 rep = 0;
        while (rep < 3) {
            s.sync();
            int64 t0 = Clock.nanoTime();
            i = 0;
            while (i < (int64) N) {
                streamReadKernel.launch(s, grid: [waves], block: [32])(w, sink, bytes, 1234567);
                i = i + 1;
            }
            s.sync();
            int64 t1 = Clock.nanoTime();
            System.stdout.println("stream read " + (bytes / 1048576L) + " MB: "
                + ((float64) (t1 - t0) / 1000.0 / (float64) N) + " us  "
                + ((float64) (bytes * (int64) N) / (float64) (t1 - t0)) + " GB/s");
            rep = rep + 1;
        }
        return;
    }

    public static void run(String[] args) {
        if ((int32) args.count() > 0 && args[0].equals("ceiling")) {
            HeadProbe.ceiling(151936L * 8L * 210L);
            HeadProbe.ceiling(151936L * 8L * 144L);
            return;
        }
        if ((int32) args.count() > 0 && args[0].equals("touched")) {
            HeadProbe.touched(4096L, 2048L);
            return;
        }
        HeadProbe.shape(4096L, 2048L, "q-proj ");
        HeadProbe.shape(2048L, 4096L, "o-proj ");
        HeadProbe.shape(16384L, 2048L, "8x q   ");
        int64 rows = 151936L;
        int64 cols = 2048L;
        int64 b6 = rows * 8L * 210L;
        int64 b4 = rows * 8L * 144L;
        int8[] h6 = heap int8[b6];
        int8[] h4 = heap int8[b4];
        int64 i = 0;
        while (i < b6) { h6[i] = (int8) ((i * 131L + 17L) % 256L); i = i + 1; }
        i = 0;
        while (i < b4) { h4[i] = (int8) ((i * 131L + 17L) % 256L); i = i + 1; }
        KernelBuffer<int8> w6 #= heap KernelBuffer<int8>((uint64) b6);
        KernelBuffer<int8> w4 #= heap KernelBuffer<int8>((uint64) b4);
        w6.upload(h6, b6);
        w4.upload(h4, b4);
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>((uint64) (8L * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) rows);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32 N = 20;
        int32 rep = 0;
        while (rep < 2) {
            int64 t0 = Clock.nanoTime();
            i = 0;
            while (i < (int64) N) {
                QuantKernel.q6kQ8WaveMatVecLaunchNoSync(y, w6, xp, rows, cols, 0L);
                i = i + 1;
            }
            s.sync();
            int64 t1 = Clock.nanoTime();
            System.stdout.println("q6k wave lm-head: "
                + ((float64) (t1 - t0) / 1000.0 / (float64) N) + " us  "
                + ((float64) (b6 * (int64) N) / (float64) (t1 - t0)) + " GB/s");
            t0 = Clock.nanoTime();
            i = 0;
            while (i < (int64) N) {
                QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, w4, xp, rows, cols, 0L);
                i = i + 1;
            }
            s.sync();
            t1 = Clock.nanoTime();
            System.stdout.println("q4k wave lm-head: "
                + ((float64) (t1 - t0) / 1000.0 / (float64) N) + " us  "
                + ((float64) (b4 * (int64) N) / (float64) (t1 - t0)) + " GB/s");
            rep = rep + 1;
        }
        return;
    }
}
