package dev.cajeta.llm.bench;

import cajeta.lang.String;

/**
 * One measured leg of the parity harness (xpu-kernel-adaptor spec §7.1),
 * as the `leg-row` line either side prints:
 *
 * <pre>
 * leg-row  leg  backend  build  op  type  m  k  n  launches  pool_bytes
 *          l2_bytes  residency  tier  ns_per_launch  bytes_per_launch
 *          flops_per_launch  clock_scale
 * </pre>
 *
 * `leg` is `cajeta` or `llama.cpp`; `backend` is what the leg ran on
 * (cajeta's `Device.activeBackend()`, or llama.cpp's registry name, one
 * of CUDA, HIP, Vulkan, CPU); `build` is the commit the leg was built
 * from; `residency` is `cold`, `hot` or `unknown` from the pool against
 * L2; `tier` is the timer's tier word; `clock_scale` is the factor the
 * event clock ran fast by, already divided out. Every field a §7.1
 * comparison needs is on the line, so a row can be judged from the line
 * alone, months later, on another machine.
 */
public final class LegRow {
    public String leg;
    public String backend;
    public String build;
    public String op;
    public String type;
    public int64 m;
    public int64 k;
    public int64 n;
    public int64 launches;
    public int64 poolBytes;
    public int64 l2Bytes;
    public String residency;
    public String tier;
    public int64 nsPerLaunch;
    public int64 bytesPerLaunch;
    public float64 flopsPerLaunch;
    public float64 clockScale;

    public LegRow() {
        this.leg = "";
        this.backend = "";
        this.build = "";
        this.op = "";
        this.type = "";
        this.m = 0;
        this.k = 0;
        this.n = 0;
        this.launches = 0;
        this.poolBytes = 0;
        this.l2Bytes = 0;
        this.residency = "";
        this.tier = "";
        this.nsPerLaunch = 0;
        this.bytesPerLaunch = 0;
        this.flopsPerLaunch = 0.0;
        this.clockScale = 0.0;
    }

    /** `m x k x n` as the table prints a shape. */
    public #String shape() {
        String s #= "" + this.m + "x" + this.k + "x" + this.n;
        return #s;
    }

    /** The line this row came from, or would print as. */
    public #String line() {
        String s #= "leg-row\t" + this.leg + "\t" + this.backend + "\t"
            + this.build + "\t" + this.op + "\t" + this.type + "\t" + this.m
            + "\t" + this.k + "\t" + this.n + "\t" + this.launches + "\t"
            + this.poolBytes + "\t" + this.l2Bytes + "\t" + this.residency
            + "\t" + this.tier + "\t" + this.nsPerLaunch + "\t"
            + this.bytesPerLaunch + "\t" + this.flopsPerLaunch + "\t"
            + this.clockScale;
        return #s;
    }
}
