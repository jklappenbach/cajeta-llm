package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.ModelConfig;

/** unit 38 triage: which decode-mode each toy fixture reports. */
public class U38Probe {
    static #CausalLM mk(String fx) {
        Checkpoint ck #= Checkpoint.open(fx);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();
        return #m;
    }
    static void pair(String fx) {
        // resident vs forced-host: 8 decode tokens each.
        int32[] tr = heap int32[8];
        int32[] th = heap int32[8];
        U38Probe.seq(fx, tr);
        Linear.setDeviceResident(false);
        U38Probe.seq(fx, th);
        Linear.setDeviceResident(true);
        boolean same = true;
        int32 i = 0;
        String rs #= "";
        String hs #= "";
        while (i < 8) {
            if (tr[i] != th[i]) { same = false; }
            rs #= rs + " " + tr[i];
            hs #= hs + " " + th[i];
            i = i + 1;
        }
        System.stdout.println(fx + " same=" + same);
        System.stdout.println("  res:" + rs);
        System.stdout.println("  hst:" + hs);
        return;
    }
    static void seq(String fx, int32[] toks) {
        CausalLM m #= U38Probe.mk(fx);
        int32[] p = heap int32[8];
        int32 i = 0;
        while (i < 8) { p[i] = (i * 7 + 3) % 200; i = i + 1; }
        int32 n = m.prefill(p, 8);
        int32[] one = heap int32[1];
        int32 g = 0;
        while (g < 8) {
            one[0] = n;
            n = m.stepSeq(0, one, 0, 1);
            toks[g] = n;
            g = g + 1;
        }
        return;
    }
    static void one(String fx) {
        CausalLM m #= U38Probe.mk(fx);
        Say cap = heap Say();
        Diag.register(cap);
        int32[] p = heap int32[8];
        int32 i = 0;
        while (i < 8) { p[i] = (i * 7 + 3) % 200; i = i + 1; }
        int32 n = m.prefill(p, 8);
        int32[] one = heap int32[1];
        one[0] = n;
        n = m.stepSeq(0, one, 0, 1);
        Diag.register(null);
        System.stdout.println(fx + " -> saw=" + cap.saw + " mode="
            + cap.mode + " tok=" + n
            + " residentEnabled=" + Linear.residentEnabled());
        return;
    }
    public static void run() {
        U38Probe.one("src/test/fixtures/gguf/toy-routable-qk.gguf");
        U38Probe.one("src/test/fixtures/gguf/toy-moe.gguf");
        U38Probe.one("src/test/fixtures/gguf/toy-routable-moe.gguf");
        U38Probe.pair("src/test/fixtures/gguf/toy-moe.gguf");
        U38Probe.pair("src/test/fixtures/gguf/toy-routable-moe.gguf");
        U38Probe.pair("src/test/fixtures/gguf/toy-routable-qk.gguf");
        return;
    }
}

final class Say implements DiagCallback {
    public boolean saw;
    public String mode;
    public Say() { this.saw = false; this.mode #= ""; }
    public void onRecord(DiagRecord r) {
        if (!r.category.equals("decode-mode")) { return; }
        this.saw = true;
        int8[] b #= r.name.toBytes();
        String c = heap String(#b, r.name.byteLength());
        this.mode #= #c;
        return;
    }
}
