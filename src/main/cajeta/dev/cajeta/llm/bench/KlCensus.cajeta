package dev.cajeta.llm.bench;

import cajeta.lang.Cajeta;

/**
 * A route's distance from a reference route over teacher-forced positions
 * (cajeta-llm 15.2.15.3.6.1): mean and max softmax KL, and how often the two
 * agree on the top token, the figures llama-perplexity's --kl-divergence prints.
 */
public final class KlCensus {
    float64 klSum;
    float64 klMax;
    int32 same;
    int32 count;

    public KlCensus() {
        this.klSum = 0.0;
        this.klMax = 0.0;
        this.same = 0;
        this.count = 0;
    }

    /** One position: the reference logits row and the route's. */
    public void add(float32[] ref, float32[] got, int32 n) {
        float64 kl = Metrics.softmaxKl(ref, got, n);
        this.klSum = this.klSum + kl;
        if (kl > this.klMax) { this.klMax = kl; }
        if (Metrics.argmax(ref, n) == Metrics.argmax(got, n)) { this.same = this.same + 1; }
        this.count = this.count + 1;
    }

    public int32 positions() { return this.count; }

    public float64 meanKl() {
        if (this.count == 0) { return 0.0; }
        return this.klSum / (float64) this.count;
    }

    public float64 maxKl() { return this.klMax; }

    public float64 sameTopFraction() {
        if (this.count == 0) { return 0.0; }
        return (float64) this.same / (float64) this.count;
    }

    /** Writes `row[0, n)` little-endian into `b` at byte `off`. */
    public static void putRow(float32[] row, int32 n, int8[] b, int64 off) {
        int32 i = 0;
        while (i < n) {
            int32 v = Cajeta.f32ToBits(row[i]);
            int64 o = off + (int64) i * 4L;
            b[o] = (int8) (v & 255);
            b[o + 1L] = (int8) ((v >> 8) & 255);
            b[o + 2L] = (int8) ((v >> 16) & 255);
            b[o + 3L] = (int8) ((v >> 24) & 255);
            i = i + 1;
        }
    }

    /** Reads `n` floats written by {@link #putRow} from `b` at byte `off`. */
    public static void getRow(int8[] b, int64 off, float32[] row, int32 n) {
        int32 i = 0;
        while (i < n) {
            int64 o = off + (int64) i * 4L;
            int32 v = ((int32) b[o] & 255) | (((int32) b[o + 1L] & 255) << 8)
                | (((int32) b[o + 2L] & 255) << 16) | (((int32) b[o + 3L] & 255) << 24);
            row[i] = Cajeta.bitsToF32(v);
            i = i + 1;
        }
    }
}
