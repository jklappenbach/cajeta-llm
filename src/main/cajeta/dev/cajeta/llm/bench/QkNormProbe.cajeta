package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ModelConfig;

/** 29.1.2 attribution probe. Three arms over the SAME Q4_K bytes:
 *  batched-qk (routing on), per-row-qk (routing off), per-row-dense
 *  (routing off, the norm-free twin). Prints 1-cos so the interesting
 *  digits survive the 6-sig-fig println. */
public class QkNormProbe {
    static final String QK = "src/test/fixtures/gguf/toy-routable-qk.gguf";
    static final String DN = "src/test/fixtures/gguf/toy-routable.gguf";

    static #CausalLM mk(String fix) {
        Checkpoint ck #= Checkpoint.open(fix);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();
        return #m;
    }

    static #float32[] arm(String fix, boolean route) {
        QuantKernel.setRoutingEnabled(route);
        CausalLM m #= QkNormProbe.mk(fix);
        int32[] p = heap int32[12];
        int32 i = 0;
        while (i < 12) { p[i] = (i * 7 + 5) % 200; i = i + 1; }
        m.prefill(p, 12);
        int32 v = m.vocabSize();
        Tensor<float32> t = m.logits();
        float32[] hb = t.hostBuffer();
        int64 base = t.hostBase();
        float32[] out #= heap float32[v];
        i = 0;
        while (i < v) { out[i] = hb[base + (int64) i]; i = i + 1; }
        QuantKernel.setRoutingEnabled(true);
        return #out;
    }

    public static void run(String[] args) {
        float32[] qb #= QkNormProbe.arm(QkNormProbe.QK, true);
        float32[] qr #= QkNormProbe.arm(QkNormProbe.QK, false);
        float32[] dr #= QkNormProbe.arm(QkNormProbe.DN, false);
        int32 v = 256;
        System.stdout.println("batched-qk vs per-row-qk:  1-cos "
            + (1.0 - Metrics.cosine(qr, qb, v))
            + "  kl " + Metrics.softmaxKl(qr, qb, v)
            + "  top1 " + Metrics.argmax(qr, v)
            + "/" + Metrics.argmax(qb, v));
        System.stdout.println("per-row-qk vs per-row-dense:  1-cos "
            + (1.0 - Metrics.cosine(qr, dr, v))
            + "  kl " + Metrics.softmaxKl(qr, dr, v)
            + "  top1 " + Metrics.argmax(qr, v)
            + "/" + Metrics.argmax(dr, v));
        return;
    }
}
