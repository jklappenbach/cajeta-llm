package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.TcTile;

/** Sixteen back-to-back Q4_K tile launches at the engine's prefill
 *  problems, best of five brackets, in nanoseconds a launch. */
public class TilePace {
    static int64 pace(int64 rows, int64 out, int64 cols, uint32 accum) {
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        int8[] raw #= heap int8[nBlocks * 144L];
        int64 z = 0;
        int64 nb = (int64) raw.count();
        while (z < nb) { raw[z] = (int8) ((z * 31L + 35L) % 251L); z = z + 1; }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) nb);
        wD.upload(raw);
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) { x[i] = (float32) ((i % 97L) - 48L) * 0.01f; i = i + 1; }
        KernelBuffer<float32> xD #= heap KernelBuffer<float32>((uint64) (rows * cols));
        xD.upload(x);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>((uint64) (rows * Quant.q8kPackedBytes(cols)));
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) (rows * out));
        KernelStream s = QuantKernel.stream();
        QuantKernel.q8kPackRowsLaunchNoSync(xp, xD, rows, cols, cols);
        s.sync();
        int64 best = -1L;
        int32 round = 0;
        while (round < 6) {
            s.sync();
            int64 t0 = Clock.nanoTime();
            int32 k = 0;
            while (k < 16) {
                if (accum != 0) { TcTile.q4kQ8TcTileAccumNoSync(y, wD, xp, rows, out, cols); }
                else { TcTile.q4kQ8TcTileLaunchNoSync(y, wD, xp, rows, out, cols); }
                k = k + 1;
            }
            s.sync();
            int64 t = (Clock.nanoTime() - t0) / 16L;
            if (round > 0 && (best < 0L || t < best)) { best = t; }
            round = round + 1;
        }
        return best;
    }

    public static int32 run(String[] args) {
        int32 rep = 0;
        while (rep < 3) {
            System.stdout.println("pace\t512x1024x4096\t" + TilePace.pace(512L, 1024L, 4096L, (uint32) 0));
            System.stdout.println("pace\t512x4096x4096\t" + TilePace.pace(512L, 4096L, 4096L, (uint32) 0));
            System.stdout.println("pace\t512x4096x4096+=\t" + TilePace.pace(512L, 4096L, 4096L, (uint32) 1));
            System.stdout.println("pace\t512x28672x4096\t" + TilePace.pace(512L, 28672L, 4096L, (uint32) 0));
            System.stdout.println("pace\t512x4096x14336\t" + TilePace.pace(512L, 4096L, 14336L, (uint32) 0));
            rep = rep + 1;
        }
        return 0;
    }
}
