package dev.cajeta.llm.bench;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;

/**
 * ONE WAVE PER ROW against ONE WORK ITEM PER ROW (plan 11.1) — llama.cpp's
 * mmvq decomposition measured against ours, at the three row counts the
 * engine actually dispatches.
 *
 * 10.5's buckets say the launch phase is two problems: the 1024-row k/v
 * projections run at 42-67 GB/s because one item per row gives them 32
 * waves for 160 SIMDs, and the wide weights are already at the roofline.
 * A wave-cooperative decomposition should move the first a lot and the
 * second not at all — so the probe sweeps row count rather than reporting
 * one number, because a single wide-weight measurement would read as "no
 * change" and a single narrow one as a miracle.
 *
 * Correctness is checked BEFORE any timing, and to a tolerance rather than
 * bit-exactly: the row sum is regrouped across 32 lanes and float addition
 * is not associative, so an exact match would mean the decomposition did
 * not actually change.
 */
public class WaveProbe {
    static final int32 COLS = 4096;

    public static void run() {
        int64 cols = (int64) WaveProbe.COLS;
        int64 bpr = cols / 256L;
        int64 rowBytes = bpr * 144L;

        float32[] hx #= heap float32[cols];
        int64 i = 0;
        while (i < cols) {
            hx[i] = 0.02f * (float32) ((i % 11L) - 5L);
            i = i + 1;
        }
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(hx, 0L, cols, xp);
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>(
            (uint64) xp.count());
        xpb.upload(xp);

        int64[] rowSet #= heap int64[3];
        rowSet[0] = 1024L;
        rowSet[1] = 4096L;
        rowSet[2] = 14336L;

        int32 t = 0;
        while (t < 3) {
            int64 rows = rowSet[t];
            int64 nbytes = rows * rowBytes;
            int8[] packed #= heap int8[nbytes];
            ScalingProbe.fillBlocks(packed, Quant.GG_Q4_K, 3);
            KernelBuffer<int8> pb #= heap KernelBuffer<int8>((uint64) nbytes);
            pb.upload(packed);
            KernelBuffer<float32> ya #= heap KernelBuffer<float32>(
                (uint64) rows);
            KernelBuffer<float32> yb #= heap KernelBuffer<float32>(
                (uint64) rows);
            float32[] ha #= heap float32[rows];
            float32[] hb #= heap float32[rows];

            // Correctness first, and on EVERY row — a decomposition where
            // only lane 0 stores can drop or double rows, and a spot check
            // at row 0 would not see it.
            QuantKernel.q4kQ8PackedMatVecLaunch(ya, pb, xpb, rows, cols, 0L);
            QuantKernel.q4kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
            ya.download(ha);
            yb.download(hb);
            int64 bad = 0;
            float32 worst = 0.0f;
            int64 r = 0;
            while (r < rows) {
                float32 a = ha[r];
                float32 b = hb[r];
                float32 diff = a - b;
                if (diff < 0.0f) { diff = 0.0f - diff; }
                float32 mag = a < 0.0f ? 0.0f - a : a;
                if (diff > mag * 0.0001f + 0.0001f) { bad = bad + 1; }
                if (diff > worst) { worst = diff; }
                r = r + 1;
            }
            System.stdout.println("rows " + rows + "  mismatched " + bad
                + "/" + rows + "  worst abs diff " + worst
                + "   item[0] " + ha[0] + "  wave[0] " + hb[0]);

            // COLD weights. A repeat loop over one weight measures MALL,
            // not DRAM — the first version of this probe read 338 GB/s at
            // 14336 rows, which is twice the machine's roofline and was the
            // 32 MB cache answering. A decode never gets that: it touches
            // 96 different weights a token and every one is cold. So the
            // pool is sized past MALL and the arms cycle through it.
            int64 copies = 167772160L / nbytes + 1L;
            int64 poolBytes = copies * nbytes;
            int8[] big #= heap int8[poolBytes];
            ScalingProbe.fillBlocks(big, Quant.GG_Q4_K, 5);
            KernelBuffer<int8> pool #= heap KernelBuffer<int8>(
                (uint64) poolBytes);
            pool.upload(big);
            System.stdout.println("    pool " + copies + " x "
                + ((float64) nbytes / 1048576.0) + " MB = "
                + ((float64) poolBytes / 1048576.0) + " MB");

            float64 mb = (float64) nbytes / 1048576.0;
            WaveProbe.timeItem(ya, pool, xpb, rows, cols, copies);
            int32 k = 0;
            while (k < 2) {
                float64 ai = 0.0;
                float64 aw = 0.0;
                if (k == 0) {
                    ai = WaveProbe.timeItem(ya, pool, xpb, rows, cols, copies);
                    aw = WaveProbe.timeWave(yb, pool, xpb, rows, cols, copies);
                } else {
                    aw = WaveProbe.timeWave(yb, pool, xpb, rows, cols, copies);
                    ai = WaveProbe.timeItem(ya, pool, xpb, rows, cols, copies);
                }
                System.stdout.println("    round " + k
                    + "  item " + ai + " ms (" + (mb / ai * 1000.0 / 1024.0)
                    + " GB/s)   wave " + aw + " ms ("
                    + (mb / aw * 1000.0 / 1024.0) + " GB/s)");
                k = k + 1;
            }
            t = t + 1;
        }
        return;
    }

    static float64 timeItem(KernelBuffer<float32> y, KernelBuffer<int8> pool,
            KernelBuffer<int8> xp, int64 rows, int64 cols, int64 copies) {
        int64 rowBytes = (cols / 256L) * 144L;
        int64 wbytes = rows * rowBytes;
        int64 t0 = Clock.nanoTime();
        int64 k = 0;
        while (k < copies) {
            KernelBuffer<int8> w #= pool.slice((uint64) (k * wbytes),
                (uint64) wbytes);
            // Chunked at 9.1's optimum, which is how the engine dispatches
            // this arm — comparing against an unchunked launch would be
            // comparing against a known-bad geometry.
            int64 r0 = 0L;
            while (r0 < rows) {
                int64 nr = 5120L;
                if (r0 + nr > rows) { nr = rows - r0; }
                KernelBuffer<int8> sub #= w.slice(
                    (uint64) (r0 * rowBytes), (uint64) (nr * rowBytes));
                QuantKernel.q4kQ8PackedMatVecLaunch(y, sub, xp, nr, cols, r0);
                r0 = r0 + nr;
            }
            k = k + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) copies;
    }

    static float64 timeWave(KernelBuffer<float32> y, KernelBuffer<int8> pool,
            KernelBuffer<int8> xp, int64 rows, int64 cols, int64 copies) {
        int64 wbytes = rows * (cols / 256L) * 144L;
        int64 t0 = Clock.nanoTime();
        int64 k = 0;
        while (k < copies) {
            KernelBuffer<int8> w #= pool.slice((uint64) (k * wbytes),
                (uint64) wbytes);
            QuantKernel.q4kQ8WaveMatVecLaunch(y, w, xp, rows, cols, 0L);
            k = k + 1;
        }
        return (float64) (Clock.nanoTime() - t0) / 1000000.0
            / (float64) copies;
    }
}
