package dev.cajeta.llm;

import cajeta.lang.String;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.gen.TokenSink;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.llm.sched.Request;
import dev.cajeta.llm.sched.Scheduler;
import dev.cajeta.llm.store.BlockStore;
import dev.cajeta.llm.store.I64Codec;
import dev.cajeta.llm.tok.Tokenizer;
import cajeta.wire.Encoder;
import cajeta.xpu.Device;

/**
 * The library facade (spec 11.4/11.7; plan 19.2.2): load a model from
 * either weight format, submit prompts, stream tokens, read text back —
 * everything the CLI does, reachable without it. CONCURRENT submissions
 * batch through the ONE Unit-9 scheduler: the CLI is just one caller of
 * this API, never a separate single-sequence path (11.7).
 *
 * ```cajeta
 * EngineOptions o #= heap EngineOptions("model.gguf");
 * LlmEngine e #= LlmEngine.load(#o);
 * SampleParams p #= heap SampleParams(0.7f, 42L);
 * int32 id = e.submitText("The capital of France is", #p, 32);
 * e.runAll(4096);
 * String text #= e.textOf(id);
 * ```
 */
public final class LlmEngine {
    EngineOptions opts;
    CausalLM model;
    Scheduler sched;
    Tokenizer tok;
    // End-of-generation ids for THIS model: the GGUF's eos/eot/eom
    // metadata unioned with the vocab scan (Tokenizer.eogIds). Applied
    // as the DEFAULT stop set on every submit whose params carry none —
    // an engine whose default is "never stop" replayed the same answer
    // for 10000 tokens on the 72B (2026-08-26).
    int32[] eog;
    BlockStore store;
    Encoder<int64> storeEnc;

    LlmEngine() {
        this.opts = null;
        this.model = null;
        this.sched = null;
        this.tok = null;
        this.store = null;
        this.storeEnc = null;
    }

    /** Load per the options; GGUF brings config and tokenizer with it
     *  (spec 9.2/9.3); safetensors needs `config` and has no tokenizer
     *  unless one is attached later. */
    public static #LlmEngine load(#EngineOptions opts) {
        LlmEngine e = heap LlmEngine();
        e.opts #= opts;
        if (!e.opts.device.equals("")) {
            Device.force(e.opts.device);      // 11.2; absent → dispatcher order
        }
        // Prefill weight residency (10.12.16). Validated HERE, loudly: a
        // typo'd mode that silently fell back to packed would read as
        // "int8 bought nothing".
        if (e.opts.prefillWeights.equals("int8")) {
            Linear.setDeqPrefill(true);
        } else if (e.opts.prefillWeights.equals("packed")) {
            Linear.setDeqPrefill(false);
        } else {
            throw heap LlmException("engine: prefillWeights must be "
                + "\"packed\" or \"int8\", not \""
                + e.opts.prefillWeights + "\"");
        }
        Checkpoint ck #= Checkpoint.open(e.opts.model);
        ModelConfig cfg = null;
        if (ck.gguf() != null) {
            cfg #= ModelConfig.fromGguf(ck.gguf());
            e.tok #= ck.gguf().tokenizer();
            int64 me = ck.gguf().metaInt("tokenizer.ggml.eos_token_id",
                0L - 1L);
            int64 mt = ck.gguf().metaInt("tokenizer.ggml.eot_token_id",
                0L - 1L);
            int64 mm = ck.gguf().metaInt("tokenizer.ggml.eom_token_id",
                0L - 1L);
            e.eog #= LlmEngine.unionEog(e.tok, me, mt, mm);
        } else {
            String cfgPath = e.opts.config;
            if (cfgPath.equals("")) {
                throw heap LlmException("engine: a safetensors model "
                    + "needs --config (GGUF carries its own)");
            }
            cfg #= ModelConfig.parse(cfgPath);
        }
        cfg.blockTokens = e.opts.blockTokens;
        CausalLM m = heap CausalLM(#cfg, e.opts.ctx,
            e.opts.maxSeqs, 0);
        m.bind(ck, false);
        ck.close();
        // 23.2.3 — say what the device K/V will cost with every slot
        // resident, BEFORE the first session discovers it. Per-slot
        // planes make this linear in `maxSeqs`, which is a change from
        // when one plane set served the whole engine, so a maxSeqs that
        // used to be free is now a real commitment. Reported, not
        // enforced: there is no VRAM query on the `Device` surface to
        // turn it into a pre-flight rejection (the same gap that leaves
        // the geometry constants hard-coded in 20.1.x).
        if (Diag.on()) {
            Diag.say("device kv ceiling: "
                + (m.deviceKvCeilingBytes() / 1048576L) + " MiB ("
                + e.opts.maxSeqs + " slots x " + e.opts.ctx
                + " ctx), allocated per slot on first use");
        }
        m.prewarmPrefillWeights();
        // WARMUP (llama.cpp does the same at load, for the same reason,
        // measured 2026-08-25): the first prefill pays GPU page-commit
        // on every fresh device buffer plus each lazy weight-side build
        // — 1693 ms cold vs 800 ms steady on the 8B/vulkan. One
        // throwaway chunk-sized prefill and one decode step touch all
        // of it; resetSeq forgets the tokens but keeps the buffers.
        int32 wn = e.opts.chunk;
        if (wn > e.opts.ctx - 2) { wn = e.opts.ctx - 2; }
        if (wn > 0) {
            int32[] wtoks #= heap int32[wn];
            int32 wi = 0;
            while (wi < wn) { wtoks[wi] = 0; wi = wi + 1; }
            m.prefill(wtoks, wn);
            int32[] wone #= heap int32[1];
            wone[0] = 0;
            m.stepSeq(0, wone, 0, 1);
            m.resetSeq(0);
        }
        e.model #= m;
        Scheduler s = heap Scheduler(e.model, e.opts.chunk);
        e.sched #= s;
        if (e.tok != null) {
            e.sched.setTokenizer(e.tok);
        }
        if (!e.opts.kvStore.equals("")) {
            Encoder<int64> enc = heap I64Codec();
            e.storeEnc #= enc;
            BlockStore st = heap BlockStore(e.opts.kvStore,
                e.model.kvCache().blockPayloadBytes(),
                e.opts.kvStoreSize, e.storeEnc);
            e.store #= st;
            e.sched.attachStore(e.store, e.opts.model, "f32", "none");
        }
        return #e;
    }

    /** The scheduler — 11.7's seam, exposed for callers that drive steps
     *  themselves. Borrow. */
    public Scheduler scheduler() {
        return this.sched;
    }

    /** The bound model — a BORROW, for probes that must assert on the
     *  MECHANISM rather than on a wall-clock (23.1.2/23.1.3). */
    public CausalLM model() {
        return this.model;
    }

    public Tokenizer tokenizer() {
        return this.tok;
    }

    /** Streaming sink for every request (spec 8.8). Borrow. */
    public void setSink(TokenSink sink) {
        this.sched.setSink(sink);
    }

    /** Submit raw token ids. */
    /** The eos/eot metadata ids unioned with the vocab's known EOG
     *  texts, deduplicated. Static so a test can exercise it without a
     *  45 GB load. */
    static #int32[] unionEog(Tokenizer tok, int64 me, int64 mt, int64 mm) {
        int32[] scan = null;
        if (tok != null) {
            scan #= tok.eogIds();
        }
        int32 cap = 3;
        if (scan != null) {
            cap = cap + (int32) scan.count();
        }
        int32[] tmp #= heap int32[cap];
        int32 n = 0;
        int64[] meta #= heap int64[3];
        meta[0] = me;
        meta[1] = mt;
        meta[2] = mm;
        int32 i = 0;
        while (i < cap) {
            int32 cand = 0 - 1;
            if (i < 3) {
                if (meta[i] >= 0L) {
                    cand = (int32) meta[i];
                }
            } else {
                cand = scan[i - 3];
            }
            if (cand >= 0) {
                boolean dup = false;
                int32 j = 0;
                while (j < n) {
                    if (tmp[j] == cand) {
                        dup = true;
                    }
                    j = j + 1;
                }
                if (!dup) {
                    tmp[n] = cand;
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        int32[] out #= heap int32[n];
        i = 0;
        while (i < n) {
            out[i] = tmp[i];
            i = i + 1;
        }
        return #out;
    }

    /** This model's end-of-generation ids (View: interior borrow). */
    public int32[] eogTokens() {
        return this.eog;
    }

    public boolean isEog(int32 t) {
        if (this.eog == null) {
            return false;
        }
        int32 i = 0;
        while (i < (int32) this.eog.count()) {
            if (this.eog[i] == t) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /** Fill in the model's EOG set as the stop tokens when the caller
     *  set none. Explicit stopTokens are the caller's business and are
     *  never touched. */
    void defaultStops(SampleParams p) {
        if (p.stopTokens != null) {
            return;
        }
        if (this.eog == null || (int32) this.eog.count() == 0) {
            return;
        }
        int32 n = (int32) this.eog.count();
        int32[] st #= heap int32[n];
        int32 i = 0;
        while (i < n) {
            st[i] = this.eog[i];
            i = i + 1;
        }
        p.stopTokens #= st;
    }

    public int32 submitTokens(int32[] prompt, int32 promptLen, int32 maxNew,
            #SampleParams params) {
        this.defaultStops(params);
        return this.sched.submitSampled(prompt, promptLen, maxNew, #params);
    }

    /** Submit text through the model's tokenizer (GGUF-loaded engines). */
    public int32 submitText(String prompt, #SampleParams params,
            int32 maxNew) {
        if (this.tok == null) {
            throw heap LlmException("engine: no tokenizer - load a GGUF "
                + "or submit token ids");
        }
        // encodePrompt, not encode: a prompt carries whatever the model's
        // metadata says it does (BOS for Llama-3). Submitting raw ids
        // bypasses this deliberately — see submitTokens.
        int32[] ids #= this.tok.encodePrompt(prompt);
        this.defaultStops(params);
        return this.sched.submitSampled(ids, (int32) ids.count(), maxNew,
            #params);
    }

    /** Drive everything to completion (bounded). */
    public void runAll(int32 maxSteps) {
        this.sched.runAll(maxSteps);
    }

    public boolean stepOnce() {
        return this.sched.stepOnce();
    }

    public Request request(int32 id) {
        return this.sched.request(id);
    }

    /** The generated text of a finished request (needs the tokenizer). */
    public #String textOf(int32 id) {
        if (this.tok == null) {
            throw heap LlmException("engine: no tokenizer for detok");
        }
        Request r = this.sched.request(id);
        int32 n = r.generatedCount();
        int32[] ids #= heap int32[n];
        int32 i = 0;
        while (i < n) {
            ids[i] = r.generatedAt(i);
            i = i + 1;
        }
        int8[] bytes #= this.tok.decode(ids, n);
        String s = heap String(#bytes, (int32) bytes.count());
        return #s;
    }

    public void close() {
        if (this.store != null) {
            this.store.close();
        }
    }
}
