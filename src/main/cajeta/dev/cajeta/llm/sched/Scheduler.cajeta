package dev.cajeta.llm.sched;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import cajeta.time.Clock;
import cajeta.math.Tensor;
import cajeta.xpu.Device;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.gen.Sampler;
import dev.cajeta.llm.gen.TokenSink;
import dev.cajeta.llm.tok.Tokenizer;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.HostOps;
import dev.cajeta.llm.model.PagedKvCache;
import dev.cajeta.llm.store.BlockKeys;
import dev.cajeta.llm.store.BlockStore;

/**
 * The continuous-batching scheduler (plan Unit 9; spec 6.19–6.25,
 * 13.14, 13.15): iteration-level batch assembly over one step function.
 *
 * Every request advances by consuming its unconsumed tokens in chunks of
 * at most `chunk` through `CausalLM.stepSeq` — a prefilling
 * request has many unconsumed tokens, a decoding request exactly one, so
 * DECODE IS THE N=1 CHUNK of the same path (13.14) and long prompts
 * interleave with in-flight decodes by construction (6.21): each
 * iteration gives every running request one bounded item.
 *
 * Stated policies (6.22, 6.23):
 * - Admission (6.19): a request is admitted only when free blocks cover
 *   its whole uncached suffix PLUS one block per unwindowed layer of
 *   decode headroom — admitting churn is not progress.
 * - Preemption victim: the YOUNGEST running request (latest
 *   admission/resume stamp). Older work is never sacrificed for newer,
 *   which is what bounds every request's wait.
 * - Resume: preempted requests re-admit FIFO by preemption time and take
 *   priority over new admissions — combined with youngest-victim, no
 *   request starves (6.23). With no store (6.32), resume recomputes the
 *   prefix through the same chunked path; the Unit 11 store swaps in
 *   behind exactly this seam.
 */
public final class Scheduler {
    CausalLM model;   // borrowed; the caller keeps it alive
    int32 chunk;
    int32 maxSeqs;
    ArrayList<Request> reqs;
    int32[] slotReq;          // request id per slot, -1 free
    int32 admittedN;
    int32 preemptedN;
    int32 resumedN;
    int32 stamp;
    int32 steps;
    // Optional prefix block store (Unit 11; null = disabled, 6.32).
    BlockStore store;         // borrow; the caller keeps it alive
    String modelId;
    String modelDtype;
    String modelQuant;
    int8[] blockBuf;          // one payload scratch, allocated at attach
    int32 adoptedBlocksN;
    int32 prefillRowsN;       // rows actually computed (11.3.1)
    // Unit 14 — generation-loop attachments. Requests are stepped one at
    // a time, so ONE detok window scratch serves the whole batch.
    TokenSink sink;           // borrow; null = no streaming (8.8)
    Tokenizer tok;            // borrow; null = stop strings inert (8.7)
    int32[] tailIds;          // stop-string window scratch (16 ids)

    ChunkPolicy policy;
    int32 lastChunk;

    public Scheduler(CausalLM model, int32 chunk) {
        // 21.2.5: launch failures BEFORE this scheduler existed are not
        // its steps' to report.
        this.lfSeen = Device.launchFailures();
        this.model #= model;   // deliberate non-owning alias: `#=` records the borrow
        this.chunk = chunk;
        this.policy = heap ChunkPolicy(chunk, 150000000L, CausalLM.CHUNK_MAX);
        this.maxSeqs = model.maxSequences();
        this.reqs = heap ArrayList<Request>();
        this.slotReq = heap int32[this.maxSeqs];
        int32 i = 0;
        while (i < this.maxSeqs) {
            this.slotReq[i] = -1;
            i = i + 1;
        }
        this.admittedN = 0;
        this.preemptedN = 0;
        this.resumedN = 0;
        this.stamp = 0;
        this.steps = 0;
        this.store = null;
        this.modelId = null;
        this.modelDtype = null;
        this.modelQuant = null;
        this.blockBuf = null;
        this.adoptedBlocksN = 0;
        this.prefillRowsN = 0;
        this.sink = null;
        this.tok = null;
        this.tailIds #= heap int32[16];
        this.logitsHashSteps = 0;
    }

    /** Fingerprint each request's logits bit for bit for its first `steps` steps
     *  (`Request.logitsHashAt`); 0 turns it off. Those steps fetch the
     *  logits and run unpipelined, so this is an instrument, not a mode. */
    public void setLogitsHash(int32 steps) {
        this.logitsHashSteps = steps;
    }
    int32 logitsHashSteps;

    boolean hashesStep(Request r) {
        return this.logitsHashSteps > 0 && r.genCount < this.logitsHashSteps;
    }

    void recordLogitsHash(Request r) {
        int64 v = (int64) this.model.vocabSize();
        Tensor<float32> t = this.model.logits();
        if (r.logitsHashes == null) { r.logitsHashes = heap int64[this.logitsHashSteps]; }
        r.logitsHashes[r.logitsHashN] = HostOps.bitFingerprint(t.hostBuffer(), t.hostBase(), v);
        r.logitsHashN = r.logitsHashN + 1;
        return;
    }

    /** Streaming sink (spec 8.8): every emitted token is delivered within
     *  the step that produced it, before the next step begins. Borrow. */
    public void setSink(TokenSink sink) {
        this.sink #= sink;
    }

    /** Tokenizer for stop-string checks (spec 8.7) — without one, stop
     *  strings never fire. Borrow. */
    public void setTokenizer(Tokenizer tok) {
        this.tok #= tok;
    }

    /**
     * Attach the prefix block store (spec 6.16–6.18): preempted AND
     * completed sequences write their full blocks; admission adopts the
     * longest stored prefix before computing the rest. The identity
     * strings fold into every key (6.27). Without a store, preemption
     * falls back to recompute-on-resume with identical output (6.32).
     * v1 restriction: adoption engages only when every layer is
     * unwindowed (rings are cheap to recompute and are not stored).
     */
    public void attachStore(BlockStore store, String modelId, String dtype,
            String quant) {
        this.store #= store;
        this.modelId = "" + modelId;
        this.modelDtype = "" + dtype;
        this.modelQuant = "" + quant;
        this.blockBuf = heap int8[this.model.kvCache().blockPayloadBytes()];
    }

    public int32 adoptedBlocks() {
        return this.adoptedBlocksN;
    }

    /** Prompt/decode rows actually computed by the model (11.3.1). */
    public int32 prefillRowsExecuted() {
        return this.prefillRowsN;
    }

    /** Enqueue a request; returns its id. */
    public int32 submit(int32[] prompt, int32 promptLen, int32 maxNew) {
        Request r = heap Request(prompt, promptLen, maxNew);
        this.reqs.add(#r);
        this.reserveForSubmitted();
        return this.reqs.count() - 1;
    }

    /**
     * Grow the K/V pool for the live requests now — at submit, between
     * steps — rather than in the step that admits them (15.2.15.1.4).
     * Mapping 2 GiB of device memory costs ~30 ms and unmapping the old
     * pool ~30 ms more on the 4090 (WSL2), whatever the allocation count,
     * so a growth cannot be made cheap, only moved: measured inside the
     * admitting step it was 80 ms, the whole gap between the batched
     * prefill's pass and its bracket, and a stall for every running
     * sequence. Accepting the work pays it, as creating the context pays
     * for llama.cpp's cache. The pool doubles toward maxSeqs, so a wave of
     * submits grows it log2 times, not once a request; the step keeps its
     * own reserve as the backstop. Lazy still: one submitted sequence
     * reserves one slot (23.1.3). The scheduler is single-threaded, so no
     * step is in flight here.
     */
    void reserveForSubmitted() {
        int32 live = 0;
        int32 k = 0;
        while (k < this.reqs.count()) {
            if (this.reqs.get(k).state != Request.DONE) { live = live + 1; }
            k = k + 1;
        }
        if (live > this.maxSeqs) { live = this.maxSeqs; }
        int32 want = live;
        int32 have = this.model.kvPoolSlots();
        if (have > 0 && want > have) {
            int32 dbl = have * 2;
            if (dbl > this.maxSeqs) { dbl = this.maxSeqs; }
            if (dbl > want) { want = dbl; }
        }
        if (this.model.deviceKvReserveGrows(want)) {
            if (this.pipeInFlight) { this.finishPipe(); }
            this.finishBatchPipe();
            this.model.reserveDeviceKvSlots(want);
        }
        // The slots' planes and their chunk-sized prefill scratch, built
        // here rather than inside the pass that admits the sequences.
        this.model.prepareDeviceKvSlots(want, this.chunk);
        return;
    }

    /**
     * Enqueue a SAMPLED request (Unit 14): its own parameters and its own
     * RNG stream, so one sequence's seed never perturbs another's
     * (14.1.8). Temperature 0 reproduces the greedy path through the
     * sampler.
     */
    public int32 submitSampled(int32[] prompt, int32 promptLen, int32 maxNew,
            #SampleParams params) {
        Request r = heap Request(prompt, promptLen, maxNew);
        Sampler smp #= heap Sampler(#params, this.model.vocabSize());
        r.attachSampler(#smp);
        this.reqs.add(#r);
        this.reserveForSubmitted();
        return this.reqs.count() - 1;
    }

    public Request request(int32 id) {
        return this.reqs.get(id);
    }


    /**
     * Cancel a request (cabra spec §10.5): it is DONE with
     * FINISH_CANCEL, its generated count frozen where the last step
     * left it. A RUNNING request's blocks feed the prompt cache before
     * they free (the same path a completion takes — what was decoded
     * is still a valid prefix); a WAITING or PREEMPTED one simply never
     * admits again. Called between steps on the stepping thread, like
     * everything else here. Returns false for an id that was never
     * issued or is already DONE, so a caller can tell "too late" from
     * "cancelled" (§5.2.7: no neighbour is touched either way).
     */
    public boolean cancel(int32 id) {
        if (id < 0 || id >= this.reqs.count()) {
            return false;
        }
        Request r = this.reqs.get(id);
        if (r.state == Request.DONE) {
            return false;
        }
        if (r.state == Request.RUNNING) {
            if (Diag.on()) {
                this.model.emitRouteRecords(r.slot, id);
            }
            this.saveBlocks(r);
            this.model.releaseSeq(r.slot);
            this.slotReq[r.slot] = -1;
            r.slot = -1;
        }
        r.finishReason = Request.FINISH_CANCEL;
        r.state = Request.DONE;
        return true;
    }

    // ── counters (6.25) ─────────────────────────────────────────────────

    public int32 admittedCount() {
        return this.admittedN;
    }

    public int32 preemptedCount() {
        return this.preemptedN;
    }

    public int32 resumedCount() {
        return this.resumedN;
    }

    /** Requests waiting for a slot or for blocks (incl. preempted). */
    public int32 queuedCount() {
        int32 n = 0;
        int32 i = 0;
        while (i < this.reqs.count()) {
            int32 st = this.reqs.get(i).state;
            if (st == Request.WAITING || st == Request.PREEMPTED) {
                n = n + 1;
            }
            i = i + 1;
        }
        return n;
    }

    public int32 stepCount() {
        return this.steps;
    }

    // The launch-failure counter as of the last step boundary; anything
    // above it at the next boundary happened in that step's window.
    int64 lfSeen;

    /** The id of the only RUNNING request, or -1 when zero or several
     *  are — a failure inside a multi-session step has no single owner
     *  (21.2.5's attribution is the WINDOW, not a guess). */
    int32 soleRunning() {
        int32 found = 0 - 1;
        int32 i = 0;
        while (i < this.reqs.count()) {
            if (this.reqs.get(i).state == Request.RUNNING) {
                if (found >= 0) {
                    return 0 - 1;
                }
                found = i;
            }
            i = i + 1;
        }
        return found;
    }

    public boolean allDone() {
        int32 i = 0;
        while (i < this.reqs.count()) {
            if (this.reqs.get(i).state != Request.DONE) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // ── the iteration (6.20) ────────────────────────────────────────────

    /**
     * One scheduling iteration: admit what fits (resumes first), give
     * every running request one bounded item, emit tokens for requests
     * whose newest position was consumed, release completions, and admit
     * again so a completion's blocks serve a waiter within the SAME step
     * (6.24). Returns whether unfinished requests remain.
     */
    /** Host time the scheduler spends around the model per step (its own
     *  bookkeeping, admission, stop checks), summed; an instrument. */
    static int64 ownNs;
    public static int64 schedulerOwnNs() { return Scheduler.ownNs; }
    public static void resetSchedulerOwnNs() { Scheduler.ownNs = 0L; }

    /** Where the last stepOnce's wall went, ns: admission, the batching
     *  query, the model step(s), the rest (a bench probe, 1.8.3). */
    public static int64 traceAdmitNs;
    public static int64 traceBatchQNs;
    public static int64 traceModelNs;
    public static int64 traceTotalNs;
    /** The K/V pool reserve of the step (15.2.15.1.4): zero when nothing grew. */
    public static int64 traceReserveNs;

    public boolean stepOnce() {
        int64 tso = Clock.nanoTime();
        int64 tTrace0 = tso;
        this.steps = this.steps + 1;
        this.admitPhase();
        Scheduler.traceAdmitNs = Clock.nanoTime() - tTrace0;
        Scheduler.traceModelNs = 0L;
        // 21.2.5: who owns a launch failure surfacing this step. Taken
        // AFTER admission so a request admitted this step counts.
        int32 lfOwner = Diag.on() ? this.soleRunning() : (0 - 1);
        // A pipeline serves one sole running request; the moment it is not
        // sole (a second admission) or not running, its pending step is
        // finished here and the plain steps take over.
        if (this.pipeInFlight && this.soleRunning() != this.pipeReq) {
            this.finishPipe();
        }
        int32 live = 0;
        int32 k = 0;
        while (k < this.reqs.count()) {
            if (this.reqs.get(k).state != Request.DONE) { live = live + 1; }
            k = k + 1;
        }
        if (live > this.maxSeqs) { live = this.maxSeqs; }
        int64 tRs = Clock.nanoTime();
        if (this.model.deviceKvReserveGrows(live)) {
            if (this.pipeInFlight) { this.finishPipe(); }
            this.finishBatchPipe();
            this.model.reserveDeviceKvSlots(live);
        }
        Scheduler.traceReserveNs = Clock.nanoTime() - tRs;
        PagedKvCache cache = this.model.kvCache();
        int64 tBq = Clock.nanoTime();
        boolean batching = this.model.decodeBatchReady();
        Scheduler.traceBatchQNs = Clock.nanoTime() - tBq;
        int32 nb = 0;
        if (batching && this.bIdx == null) {
            this.bIdx = heap int32[CausalLM.DECODE_BATCH_MAX];
            this.bSeq = heap int32[CausalLM.DECODE_BATCH_MAX];
            this.bTok = heap int32[CausalLM.DECODE_BATCH_MAX];
            this.bOut = heap int32[CausalLM.DECODE_BATCH_MAX];
            this.bpIdx = heap int32[CausalLM.DECODE_BATCH_MAX];
            this.bpSeq = heap int32[CausalLM.DECODE_BATCH_MAX];
            this.bpTokOut = heap int32[CausalLM.DECODE_BATCH_MAX];
        }
        // Prompt chunks batch across requests where the resident prefill
        // and the device tail serve; greedy requests only, since the pass
        // keeps one set of logits (the decode batch's selectBatchLogits has
        // no prefill twin yet).
        boolean pBatching = this.model.prefillBatchReady();
        int32 np = 0;
        if (pBatching && this.pIdx == null) {
            this.pIdx = heap int32[(int64) this.maxSeqs];
            this.pSeq = heap int32[(int64) this.maxSeqs];
            this.pOff = heap int32[(int64) this.maxSeqs];
            this.pN = heap int32[(int64) this.maxSeqs];
            this.pOut = heap int32[(int64) this.maxSeqs];
        }
        boolean loaded = this.pipeInFlight;
        int32 prompts = 0;
        int32 j = 0;
        while (j < this.reqs.count()) {
            Request q = this.reqs.get(j);
            if (q.state == Request.RUNNING) {
                if (q.totalLen - q.cachedLen <= 1) { loaded = true; } else { prompts = prompts + 1; }
            }
            j = j + 1;
        }
        int32 cap = this.policy.chunkForShare(loaded, prompts);
        this.lastChunk = cap;
        int32 fullChunks = 0;
        boolean partial = false;
        int32 i = 0;
        while (i < this.reqs.count()) {
            Request r = this.reqs.get(i);
            if (r.state == Request.RUNNING) {
                int32 n = r.totalLen - r.cachedLen;
                if (n > cap) {
                    n = cap;
                }
                // Per-item headroom: preempt YOUNGER requests until this
                // item fits; if this request is itself the youngest, it
                // yields (preempts itself) instead (6.22).
                while (cache.blocksNeededFor(r.slot, n) > cache.freeBlocks()) {
                    int32 victim = this.youngestRunning();
                    if (victim < 0) {
                        throw heap LlmException(
                            "scheduler: no preemptable sequence");
                    }
                    this.preempt(victim);
                    if (victim == i) {
                        break;
                    }
                }
                if (r.state != Request.RUNNING) {
                    i = i + 1;
                    continue;
                }
                if (Diag.on()) {
                    Diag.emit("sched-step", i, null, (int64) this.steps,
                        (int64) r.slot, (int64) r.cachedLen, (int64) n,
                        (int64) r.totalLen,
                        (int64) cache.lengthOf(r.slot, 0));
                }
                // One greedy sequence in decode takes the pipeline before
                // the batch: a batch of one is the plain step with a sync.
                if (this.pipeFor(i, r, n)) {
                    Scheduler.ownNs = Scheduler.ownNs + (Clock.nanoTime() - tso);
                    this.stepPipelined(i, r);
                    tso = Clock.nanoTime();
                } else if (batching && (n == 1 || (n == 0 && this.bpHas(i)))) {
                    // A row in the batched pipeline: its position was consumed at
                    // queue time (n reads 0 here); the batch awaits it.
                    if (this.pipeInFlight) { this.finishPipe(); }
                    if (nb == CausalLM.DECODE_BATCH_MAX) {
                        this.runDecodeBatch(nb);
                        nb = 0;
                    }
                    this.bIdx[nb] = i;
                    nb = nb + 1;
                } else {
                    if (this.pipeInFlight) { this.finishPipe(); }
                    this.finishBatchPipe();
                    Scheduler.ownNs = Scheduler.ownNs + (Clock.nanoTime() - tso);
                    if (n > 1) {
                        if (n == cap) { fullChunks = fullChunks + 1; } else { partial = true; }
                    }
                    if (pBatching && n > 1 && np < this.maxSeqs
                            && (r.sampler == null || r.sampler.isGreedy())
                            && !this.hashesStep(r)) {
                        this.pIdx[(int64) np] = i;
                        this.pSeq[(int64) np] = r.slot;
                        this.pOff[(int64) np] = r.cachedLen;
                        this.pN[(int64) np] = n;
                        np = np + 1;
                        tso = Clock.nanoTime();
                    } else {
                    int64 tm0 = Clock.nanoTime();
                    int32 ret = this.model.stepSeq(r.slot, r.all, r.cachedLen, n);
                    tso = Clock.nanoTime();
                    Scheduler.traceModelNs = Scheduler.traceModelNs + (tso - tm0);
                    this.consume(i, r, ret, n);
                    }
                }
            }
            i = i + 1;
        }
        if (np > 0) { this.runPrefillBatch(np); }
        if (nb > 0) { this.runDecodeBatch(nb); }
        // Completions freed blocks: same-step admission (6.24).
        this.admitPhase();
        // 21.2.5: launch failures become records. The counter moving
        // since the last boundary means some dispatch in this window
        // never ran — the engine's output past that point is suspect,
        // and the HOST decides what to do about it (11.8.6). Delta
        // accounting (not a start-of-step snapshot) so a failure landing
        // BETWEEN steps still surfaces in the next step's record.
        if (Diag.on()) {
            int64 lfNow = Device.launchFailures();
            if (lfNow > this.lfSeen) {
                Diag.emit("launch-failure", lfOwner, null,
                    lfNow - this.lfSeen, (int64) this.steps,
                    0L, 0L, 0L, 0L);
            }
            this.lfSeen = lfNow;
        }
        if (fullChunks > 0 && !partial) {
            this.policy.observe(cap, loaded, (Clock.nanoTime() - tTrace0) / (int64) fullChunks);
        }
        boolean more = !this.allDone();
        Scheduler.ownNs = Scheduler.ownNs + (Clock.nanoTime() - tso);
        Scheduler.traceTotalNs = Clock.nanoTime() - tTrace0;
        // Where the step's wall time went (15.2.15.1.4): admission, the
        // K/V reserve, the model, the whole.
        if (Diag.on()) {
            Diag.emit("sched-phase", 0 - 1, null, (int64) this.steps,
                Scheduler.traceAdmitNs, Scheduler.traceReserveNs,
                Scheduler.traceModelNs, Scheduler.traceTotalNs, 0L);
        }
        return more;
    }

    /** The pause budget a step may take while other sequences decode (spec 13.14). */
    public void setChunkBudgetNs(int64 ns) { this.policy.setBudgetNs(ns); }

    /** The chunk cap the last step used. */
    public int32 lastChunk() { return this.lastChunk; }

    // ── 12.2.11: the pipelined greedy decode ───────────────────────────
    // One running request, greedy, in the decode regime: step N+1 is queued
    // on the device before step N's argmax is read, so the host's share of
    // a token (its own bookkeeping, the launches, the readback) overlaps
    // the device's. The device reads the next token from the slot the
    // previous argmax wrote (CausalLM.queueStep), so the host never has to
    // know a token before the step that consumes it is queued. Each
    // stepOnce in this regime: queue the SPECULATIVE next step, then wait
    // for the previous one and emit its token. A finish (EOS, stop string,
    // budget) leaves one queued step past the end; it is drained and its
    // position dies with the slot.
    boolean pipeInFlight;
    int32 pipeOut;          // the slot the in-flight step's argmax writes
    int32 pipeReq = 0 - 1;  // the request index the pipeline serves

    boolean pipeFor(int32 i, Request r, int32 n) {
        // In flight for this request: its position is already consumed (n
        // reads 0 here), and this step awaits it, speculating the next.
        if (this.pipeInFlight) { return this.pipeReq == i; }
        if (n != 1) { return false; }
        if (r.cachedLen != r.totalLen - 1) { return false; }
        if (r.sampler != null && !r.sampler.isGreedy()) { return false; }
        if (this.hashesStep(r)) { return false; }
        if (this.soleRunning() != i) { return false; }
        return this.model.pipelineReady(r.slot);
    }

    void stepPipelined(int32 i, Request r) {
        if (!this.pipeInFlight) {
            // The seed: the token to consume is known to the host.
            this.model.pipeSeed(0, r.all[r.totalLen - 1]);
            this.model.queueStep(r.slot, 0, 1);
            this.pipeInFlight = true;
            this.pipeOut = 1;
            this.pipeReq = i;
            r.cachedLen = r.cachedLen + 1;
            this.prefillRowsN = this.prefillRowsN + 1;
            return;
        }
        int32 inS = this.pipeOut;
        int32 outS = 1 - inS;
        // Speculate only when this token cannot be the last by budget and
        // the context has a position left; a stop the host cannot foresee
        // costs one queued step, drained below.
        boolean spec = r.genCount + 1 < r.maxNew
            && this.model.hasRoom(r.slot);
        if (spec) { this.model.queueStep(r.slot, inS, outS); }
        int32 tok = this.model.awaitStep(this.pipeOut);
        // The position was consumed when the step was queued: n = 0 here.
        this.consume(i, r, tok, 0);
        if (r.state != Request.RUNNING) {
            this.drainPipe();
            return;
        }
        if (spec) {
            this.pipeOut = outS;
            r.cachedLen = r.cachedLen + 1;
            this.prefillRowsN = this.prefillRowsN + 1;
        } else {
            this.pipeInFlight = false;
            this.pipeReq = 0 - 1;
        }
        return;
    }

    /** Finish the pipeline's pending step: await its argmax, emit the
     *  token, and take the plain steps from here. */
    void finishPipe() {
        if (!this.pipeInFlight) { return; }
        int32 i = this.pipeReq;
        this.pipeInFlight = false;
        this.pipeReq = 0 - 1;
        int32 tok = this.model.awaitStep(this.pipeOut);
        this.model.drainPipe();
        if (i >= 0 && i < this.reqs.count()) {
            Request r = this.reqs.get(i);
            if (r.state == Request.RUNNING) { this.consume(i, r, tok, 0); }
        }
        return;
    }

    /** A finished request's queued speculative step: let it end before the
     *  slot it reads is released, and forget the pipeline. */
    void drainPipe() {
        if (!this.pipeInFlight) { return; }
        this.model.drainPipe();
        this.pipeInFlight = false;
        this.pipeReq = 0 - 1;
        return;
    }

    /** Advance request `r` (index `i`) past `n` consumed tokens; `ret` is the model's argmax for its newest position. */
    void consume(int32 i, Request r, int32 ret, int32 n) {
        r.cachedLen = r.cachedLen + n;
        this.prefillRowsN = this.prefillRowsN + n;
        if (r.cachedLen == r.totalLen) {
            // The newest position was consumed: `ret` is the
            // model's argmax (interior chunks discard it). A
            // sampled request draws from the SAME logits instead
            // (they are still pooled from this stepSeq — requests
            // advance one at a time), with the penalty history
            // being its previously EMITTED tokens (8.5).
            // A greedy sampler's answer is `ret` already: the model's
            // argmax, taken on the device when the tail ran there. Fetching
            // the logits to scan them again on the host was 0.65 ms of a
            // 7 ms token (2026-09-30).
            int32 tok = ret;
            if (r.sampler != null && !r.sampler.isGreedy()) {
                tok = r.sampler.sample(this.model.logits(), r.all,
                    r.promptLen, r.genCount);
            }
            if (this.hashesStep(r)) { this.recordLogitsHash(r); }
            r.all[r.totalLen] = tok;
            r.totalLen = r.totalLen + 1;
            r.genCount = r.genCount + 1;
            // 8.8 — deliver before the next step begins.
            if (this.sink != null) {
                this.sink.onToken(i, tok);
            }
            // 8.7 — EOS, then stop strings, then the budget.
            int32 fin = Request.FINISH_NONE;
            if (r.sampler != null) {
                fin = this.stopReason(r);
            }
            if (fin == Request.FINISH_NONE
                    && r.genCount >= r.maxNew) {
                fin = Request.FINISH_BUDGET;
            }
            if (fin != Request.FINISH_NONE) {
                r.finishReason = fin;
                // Unit 30: the request's routing, as records,
                // while its slot still holds the counts.
                if (Diag.on()) {
                    this.model.emitRouteRecords(r.slot, i);
                }
                // A completed sequence's blocks feed the prompt
                // cache before they free (6.16's write, and what
                // makes 11.3.1's repeated-prefix win real).
                this.saveBlocks(r);
                this.model.releaseSeq(r.slot);
                this.slotReq[r.slot] = -1;
                r.slot = -1;
                r.state = Request.DONE;
            }
        }
        return;
    }

    /** Scratch for one batched decode step: request indices, slots, tokens, results. */
    int32[] bIdx;
    int32[] bSeq;
    int32[] bTok;
    int32[] bOut;
    // 15.2.12.3.9.5 — the batched pipeline: the set in flight (request indices and
    // slots), the buffer its argmaxes land in, and the tokens read back.
    boolean bpInFlight;
    int32 bpOut;
    int32 bpN;
    int32[] bpIdx;
    int32[] bpSeq;
    int32[] bpTokOut;
    // 15.2.15.1.4: the prompt chunks a step admits together, run as ONE
    // pass by CausalLM.stepPrefillBatch; pTok holds their tokens in order.
    int32[] pIdx;
    int32[] pSeq;
    int32[] pOff;
    int32[] pN;
    int32[] pOut;
    int32[] pTok;

    /** Run the collected decode rows as one step (xpu-kernel-adaptor 13B),
     *  dropping any a preemption stopped after it was collected. */
    /** The collected prompt chunks as one pass; a request preempted since
     *  it was collected is skipped (its blocks are gone; admission returns
     *  it), and one chunk alone is the plain step. */
    void runPrefillBatch(int32 np) {
        int32 m = 0;
        int32 total = 0;
        int32 k = 0;
        while (k < np) {
            Request r = this.reqs.get(this.pIdx[(int64) k]);
            if (r.state == Request.RUNNING && r.slot == this.pSeq[(int64) k]) {
                this.pIdx[(int64) m] = this.pIdx[(int64) k];
                this.pSeq[(int64) m] = r.slot;
                this.pN[(int64) m] = this.pN[(int64) k];
                total = total + this.pN[(int64) k];
                m = m + 1;
            }
            k = k + 1;
        }
        if (m == 0) { return; }
        if (this.pTok == null || (int64) this.pTok.count() < (int64) total) {
            this.pTok = heap int32[(int64) total];
        }
        int32 at = 0;
        k = 0;
        while (k < m) {
            Request r = this.reqs.get(this.pIdx[(int64) k]);
            int32 n = this.pN[(int64) k];
            int32 j = 0;
            while (j < n) {
                this.pTok[(int64) (at + j)] = r.all[(int64) (r.cachedLen + j)];
                j = j + 1;
            }
            this.pOff[(int64) k] = at;
            at = at + n;
            k = k + 1;
        }
        int64 tm0 = Clock.nanoTime();
        if (m == 1) {
            Request r1 = this.reqs.get(this.pIdx[0]);
            int32 ret = this.model.stepSeq(r1.slot, r1.all, r1.cachedLen, this.pN[0]);
            Scheduler.traceModelNs = Scheduler.traceModelNs + (Clock.nanoTime() - tm0);
            this.consume(this.pIdx[0], r1, ret, this.pN[0]);
            return;
        }
        this.model.stepPrefillBatch(this.pSeq, this.pTok, this.pOff, this.pN, m, this.pOut);
        Scheduler.traceModelNs = Scheduler.traceModelNs + (Clock.nanoTime() - tm0);
        k = 0;
        while (k < m) {
            Request rk = this.reqs.get(this.pIdx[(int64) k]);
            this.consume(this.pIdx[(int64) k], rk, this.pOut[(int64) k], this.pN[(int64) k]);
            k = k + 1;
        }
        return;
    }
    /** The running rows among `bIdx[0..nb)`, compacted in place with their slots and
     *  next tokens; returns the count. */
    int32 collectBatch(int32 nb) {
        int32 m = 0;
        int32 k = 0;
        while (k < nb) {
            Request r = this.reqs.get(this.bIdx[k]);
            if (r.state == Request.RUNNING && r.slot >= 0) {
                this.bIdx[m] = this.bIdx[k];
                this.bSeq[m] = r.slot;
                this.bTok[m] = r.all[r.cachedLen];
                m = m + 1;
            }
            k = k + 1;
        }
        return m;
    }

    /** Whether the compacted batch of `m` rows is the set the pipeline has in flight. */
    boolean bpSameSet(int32 m) {
        if (!this.bpInFlight || m != this.bpN) { return false; }
        int32 k = 0;
        while (k < m) {
            if (this.bIdx[k] != this.bpIdx[k] || this.bSeq[k] != this.bpSeq[k]) { return false; }
            k = k + 1;
        }
        return true;
    }

    /** Whether request `i` is a row of the batched step in flight. */
    boolean bpHas(int32 i) {
        if (!this.bpInFlight) { return false; }
        int32 k = 0;
        while (k < this.bpN) {
            if (this.bpIdx[k] == i) { return true; }
            k = k + 1;
        }
        return false;
    }

    /** Whether the batch of `m` rows can run one step ahead: the set in flight, or two
     *  or more greedy, unhashed rows each with one token to consume, the model's
     *  pipeline ready, and the single sequence pipeline idle. */
    boolean bpFor(int32 m) {
        if (this.bpInFlight) { return this.bpSameSet(m); }
        if (m < 2 || this.pipeInFlight) { return false; }
        int32 k = 0;
        while (k < m) {
            Request r = this.reqs.get(this.bIdx[k]);
            if (r.cachedLen != r.totalLen - 1) { return false; }
            if (r.sampler != null && !r.sampler.isGreedy()) { return false; }
            if (this.hashesStep(r)) { return false; }
            k = k + 1;
        }
        return this.model.batchPipelineReady();
    }

    /** Await the in-flight batched step and consume its tokens for the rows still
     *  running; a stopped row's speculative token is dropped. */
    void finishBatchPipe() {
        if (!this.bpInFlight) { return; }
        this.bpInFlight = false;
        this.model.awaitDecodeBatch(this.bpOut, this.bpN, this.bpTokOut);
        int32 k = 0;
        while (k < this.bpN) {
            int32 i = this.bpIdx[k];
            if (i >= 0 && i < this.reqs.count()) {
                Request r = this.reqs.get(i);
                if (r.state == Request.RUNNING && r.slot == this.bpSeq[k]) {
                    this.consume(i, r, this.bpTokOut[k], 0);
                }
            }
            k = k + 1;
        }
        return;
    }

    /** The batched step one step ahead (15.2.12.3.9.5): seed from the host's tokens,
     *  else queue the next step and await the one in flight. */
    void stepBatchPipelined(int32 m) {
        int32 k;
        if (!this.bpInFlight) {
            this.model.bpSeed(0, this.bTok, m);
            this.model.queueDecodeBatch(this.bSeq, m, 0, 1);
            this.bpInFlight = true;
            this.bpOut = 1;
            this.bpN = m;
            k = 0;
            while (k < m) {
                this.bpIdx[k] = this.bIdx[k];
                this.bpSeq[k] = this.bSeq[k];
                Request r = this.reqs.get(this.bIdx[k]);
                r.cachedLen = r.cachedLen + 1;
                this.prefillRowsN = this.prefillRowsN + 1;
                k = k + 1;
            }
            return;
        }
        int32 inS = this.bpOut;
        int32 outS = 1 - inS;
        // Speculate only when no row can be the last by budget and every row has a
        // position left; a stop the host cannot foresee costs the queued step's token.
        boolean spec = true;
        k = 0;
        while (k < m) {
            Request r = this.reqs.get(this.bIdx[k]);
            if (r.genCount + 1 >= r.maxNew || !this.model.hasRoom(r.slot)) { spec = false; }
            k = k + 1;
        }
        if (spec) { this.model.queueDecodeBatch(this.bSeq, m, inS, outS); }
        this.model.awaitDecodeBatch(this.bpOut, m, this.bOut);
        k = 0;
        while (k < m) {
            Request r = this.reqs.get(this.bIdx[k]);
            this.consume(this.bIdx[k], r, this.bOut[k], 0);
            k = k + 1;
        }
        if (!spec) {
            this.bpInFlight = false;
            return;
        }
        this.bpOut = outS;
        k = 0;
        while (k < m) {
            Request r = this.reqs.get(this.bIdx[k]);
            if (r.state == Request.RUNNING) {
                r.cachedLen = r.cachedLen + 1;
                this.prefillRowsN = this.prefillRowsN + 1;
            }
            k = k + 1;
        }
        return;
    }

    void runDecodeBatch(int32 nb) {
        int32 m = this.collectBatch(nb);
        if (this.bpInFlight && !this.bpSameSet(m)) {
            // The set changed (a finish, an admission): land the step in flight, then
            // read the rows again with the tokens it produced.
            this.finishBatchPipe();
            m = this.collectBatch(nb);
        }
        if (m == 0) { return; }
        if (this.bpFor(m)) {
            this.stepBatchPipelined(m);
            return;
        }
        int32 k = 0;
        if (m == 1) {
            Request r1 = this.reqs.get(this.bIdx[0]);
            int32 ret = this.model.stepSeq(r1.slot, r1.all, r1.cachedLen, 1);
            this.consume(this.bIdx[0], r1, ret, 1);
            return;
        }
        this.model.stepDecodeBatch(this.bSeq, this.bTok, m, this.bOut);
        k = 0;
        while (k < m) {
            Request rk = this.reqs.get(this.bIdx[k]);
            if (rk.sampler != null || this.hashesStep(rk)) { this.model.selectBatchLogits(k); }
            this.consume(this.bIdx[k], rk, this.bOut[k], 1);
            k = k + 1;
        }
        return;
    }

    /** Drive to completion, with a hard progress cap. */
    public void runAll(int32 maxSteps) {
        int32 s = 0;
        while (s < maxSteps) {
            if (!this.stepOnce()) {
                return;
            }
            s = s + 1;
        }
        throw heap LlmException("scheduler: not done after " + maxSteps
            + " steps");
    }

    // ── internals ───────────────────────────────────────────────────────

    /**
     * Which halting condition the newest token fired (spec 8.7): a stop
     * TOKEN is checked directly; stop STRINGS are searched in the decode
     * of a rolling 16-token window of the generated tail — per-token work
     * stays bounded (13.10's small constant: one decode buffer and one
     * candidate String per token), and a stop string spanning more than
     * 16 tokens is not a stop string.
     */
    int32 stopReason(Request r) {
        SampleParams sp = r.sampler.params();
        int32 last = r.all[r.totalLen - 1];
        if (sp.stopTokens != null) {
            int32 i = 0;
            while (i < (int32) sp.stopTokens.count()) {
                if (sp.stopTokens[i] == last) {
                    return Request.FINISH_EOS;
                }
                i = i + 1;
            }
        }
        if (sp.stops != null) {
            if (this.tok != null) {
                if (sp.stops.count() > 0) {
                    int32 w = r.genCount;
                    if (w > 16) {
                        w = 16;
                    }
                    int32 base = r.totalLen - w;
                    int32 i = 0;
                    while (i < w) {
                        this.tailIds[i] = r.all[base + i];
                        i = i + 1;
                    }
                    int8[] bytes #= this.tok.decode(this.tailIds, w);
                    int32 bn = (int32) bytes.count();
                    String txt #= heap String(#bytes, bn);
                    int32 si = 0;
                    while (si < sp.stops.count()) {
                        if (txt.indexOf(sp.stops.get(si)) >= 0L) {
                            return Request.FINISH_STOP;
                        }
                        si = si + 1;
                    }
                }
            }
        }
        return Request.FINISH_NONE;
    }

    void admitPhase() {
        PagedKvCache cache = this.model.kvCache();
        while (true) {
            // Resumes first, FIFO by preemption time; then new waiters,
            // FIFO by submission (6.23).
            int32 pick = -1;
            int32 bestPre = 2147483647;
            int32 i = 0;
            while (i < this.reqs.count()) {
                Request r = this.reqs.get(i);
                if (r.state == Request.PREEMPTED
                        && r.preemptStamp < bestPre) {
                    pick = i;
                    bestPre = r.preemptStamp;
                }
                i = i + 1;
            }
            boolean isResume = pick >= 0;
            if (pick < 0) {
                i = 0;
                while (i < this.reqs.count()) {
                    if (this.reqs.get(i).state == Request.WAITING) {
                        pick = i;
                        break;
                    }
                    i = i + 1;
                }
            }
            if (pick < 0) {
                return;
            }
            int32 slot = -1;
            i = 0;
            while (i < this.maxSeqs) {
                if (this.slotReq[i] < 0) {
                    slot = i;
                    break;
                }
                i = i + 1;
            }
            if (slot < 0) {
                return;
            }
            Request r = this.reqs.get(pick);
            // 6.19: the whole uncached suffix plus decode headroom.
            int32 bt = cache.blocksNeededFor(slot, r.totalLen)
                + cache.fullLayers();
            if (bt > cache.freeBlocks()) {
                return;
            }
            this.slotReq[slot] = pick;
            // Unit 30: a new occupant's routing starts from zero.
            if (Diag.on()) {
                this.model.clearRoutes(slot);
            }
            if (Diag.on()) {
                Diag.emit("sched-admit", pick,
                    isResume ? "resume" : "new", (int64) slot,
                    (int64) cache.lengthOf(slot, 0), 0L, 0L, 0L, 0L);
            }
            r.slot = slot;
            r.cachedLen = 0;
            r.state = Request.RUNNING;
            this.stamp = this.stamp + 1;
            r.stamp = this.stamp;
            if (isResume) {
                this.resumedN = this.resumedN + 1;
            } else {
                this.admittedN = this.admittedN + 1;
            }
            this.adoptPrefix(r);
        }
    }

    /**
     * Longest-prefix adoption (6.17, 6.18, 6.28): walk the request's
     * block-aligned chain keys until the first miss on ANY layer, then
     * import that run into the cache — the request's prefill starts at
     * the uncached suffix. A verification failure during import rolls the
     * sequence back to empty (corrupt bytes are never adopted, 6.31).
     */
    void adoptPrefix(Request r) {
        if (this.store == null) {
            return;
        }
        PagedKvCache cache = this.model.kvCache();
        if (cache.fullLayers() != this.model.layerCount()) {
            return;   // v1: rings are recomputed, not stored
        }
        int32 bt = cache.blockTokensN();
        int32 candidates = r.totalLen / bt;
        int32 layers = this.model.layerCount();
        // Probe: the longest run where EVERY layer's key is present.
        int32 run = 0;
        boolean stop = false;
        int32 bi = 0;
        while (bi < candidates && stop == false) {
            int32 l = 0;
            while (l < layers && stop == false) {
                if (this.store.contains(this.keyFor(r, l, bi)) == false) {
                    stop = true;
                }
                l = l + 1;
            }
            if (stop == false) {
                run = bi + 1;
            }
            bi = bi + 1;
        }
        // The newest position's LOGITS must be computed, not adopted:
        // always leave at least one token for the step loop to consume.
        while (run > 0 && run * bt >= r.totalLen) {
            run = run - 1;
        }
        if (run == 0) {
            return;
        }
        // Import: per block, all layers; any verified-read failure rolls
        // the whole adoption back (6.31).
        bi = 0;
        while (bi < run) {
            int32 l = 0;
            while (l < layers) {
                boolean ok = this.store.get(this.keyFor(r, l, bi),
                    this.blockBuf);
                if (ok) {
                    ok = cache.importBlock(r.slot, l, bi, this.blockBuf);
                }
                if (ok == false) {
                    cache.release(r.slot);
                    return;
                }
                l = l + 1;
            }
            this.adoptedBlocksN = this.adoptedBlocksN + 1;
            bi = bi + 1;
        }
        r.cachedLen = run * bt;
    }

    /** Chain key of block `bi` of layer `l` for request `r` (6.26). */
    int64 keyFor(Request r, int32 l, int32 bi) {
        int32 bt = this.model.kvCache().blockTokensN();
        int64 key = BlockKeys.seed(this.modelId, this.modelDtype,
            this.modelQuant, l);
        int32 b = 0;
        while (b <= bi) {
            key = BlockKeys.chain(key, r.all, b * bt, bt);
            b = b + 1;
        }
        return key;
    }

    /** Write `r`'s FULL cached blocks to the store (6.16). */
    void saveBlocks(Request r) {
        if (this.store == null) {
            return;
        }
        PagedKvCache cache = this.model.kvCache();
        if (cache.fullLayers() != this.model.layerCount()) {
            return;
        }
        int32 bt = cache.blockTokensN();
        int32 nb = r.cachedLen / bt;
        int32 layers = this.model.layerCount();
        int32 l = 0;
        while (l < layers) {
            int64 key = BlockKeys.seed(this.modelId, this.modelDtype,
                this.modelQuant, l);
            int32 bi = 0;
            while (bi < nb) {
                key = BlockKeys.chain(key, r.all, bi * bt, bt);
                cache.exportBlock(r.slot, l, bi, this.blockBuf);
                this.store.put(key, this.blockBuf);
                bi = bi + 1;
            }
            l = l + 1;
        }
    }

    int32 youngestRunning() {
        int32 best = -1;
        int32 bestStamp = -1;
        int32 i = 0;
        while (i < this.reqs.count()) {
            Request r = this.reqs.get(i);
            if (r.state == Request.RUNNING && r.stamp > bestStamp) {
                best = i;
                bestStamp = r.stamp;
            }
            i = i + 1;
        }
        return best;
    }

    void preempt(int32 id) {
        Request r = this.reqs.get(id);
        // With a store attached, eviction is a WRITE, not a discard
        // (spec 13.16); without one, resume recomputes (6.32).
        this.saveBlocks(r);
        this.model.releaseSeq(r.slot);
        this.slotReq[r.slot] = -1;
        r.slot = -1;
        r.cachedLen = 0;
        r.state = Request.PREEMPTED;
        this.stamp = this.stamp + 1;
        r.preemptStamp = this.stamp;
        this.preemptedN = this.preemptedN + 1;
    }
}
