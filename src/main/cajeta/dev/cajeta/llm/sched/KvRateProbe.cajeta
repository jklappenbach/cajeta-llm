package dev.cajeta.llm.sched;

/** What {@link KvRates} times: one transfer on a path, or a prefill from an empty sequence (kv-paging spec 4.2). */
public interface KvRateProbe {
    /** Nanoseconds for one transfer of `bytes` on `op` ({@link KvRates#H2D} and the other paths). */
    int64 transferNs(int32 op, int64 bytes);

    /** Nanoseconds to prefill `tokens` tokens from an empty sequence. */
    int64 prefillNs(int32 tokens);

    /** The longest prefill this probe can run. */
    int32 maxPrefill();
}
