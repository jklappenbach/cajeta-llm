package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;

/**
 * The hand-written 128x128 Q4_K tile (`TcTile.q4kQ8TcTileKernel`, four
 * warps of 32x64, 256 threads) as a member of the Q4_K tile family
 * (xpu-tile-shape-selection Unit 7). It is the family's default: the
 * template's own 128x128 instantiation, `QkTile<128, 128, 32, 64, 128>`,
 * lowers to an instruction-identical PTX that ptxas schedules 7-8% slower
 * at 255 registers (TilePace, sm_89, 2026-10-08), so this kernel stays
 * until the compiler reproduces the schedule.
 */
public final class Q4HandTile implements Q4TileShape {
    public Q4HandTile() {}

    public #String kernel() { return "q4kQ8TcTileKernel"; }
    public int32 tileM() { return 128; }
    public int32 tileN() { return 128; }
    public int32 threads() { return 256; }

    public boolean fits(int64 rows, int64 outDim, int64 cols) {
        return rows % 128L == 0L && outDim % 128L == 0L && cols % 256L == 0L
            && rows > 0L && outDim > 0L && cols > 0L;
    }

    public void launchAs(KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols,
            KernelBuffer<float32> part, int64 splits, uint32 accum) {
        TcTile.q4kQ8HandLaunch(y, packed, xp, rows, outDim, cols, part, splits, accum);
        return;
    }
}
