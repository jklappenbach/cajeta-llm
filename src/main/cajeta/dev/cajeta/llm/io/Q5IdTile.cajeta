package dev.cajeta.llm.io;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.TileOps;
import cajeta.xpu.Vector;
import cajeta.xpu.WaveVector;

/**
 * The Q5_K MoE Id GEMM as a family (cajeta-llm 15.2.15.4.2): the dense
 * Q5_K tensor-core tile ({@code Q5Tile}) over the expert chunk maps. A
 * workgroup of {@code 2 * TN} threads computes one TM-row chunk of a map
 * entry against a TN-row tile of the entry's expert, exactly as the dense
 * tile computes a TM-token x TN-row output tile: both operands staged
 * dequantized in shared memory a half block ahead of the mma, the
 * fifth-bit plane folded at staging, fragments by the matrix load. The
 * member reads the chunk map of its own row count (TM) and the count from
 * that map's meta slot; the rows of a chunk past the entry's end are
 * computed and never stored — a full 16-row fragment below the end lands
 * straight from the accumulator, the ragged one through a per-wave LDS
 * tile, guarded row by row.
 *
 * Before it a Q5_K bank's prefill GEMM was the multi-wave kernel
 * ({@code q5kWmmaIdMwKernel}): per-fragment global loads inside the mma
 * chain and a shared-memory round trip per B fragment, 536 us a gate/up
 * launch on Qwen3-Coder-30B-A3B at a 512-token prefill where this design
 * reads the same weight stream in 289 us and llama.cpp's mul_mat_q in 225
 * (IdGemmProbe, 2026-10-24).
 */
@Instantiate({Q5IdTile<64, 64, 32, 32, 128>, Q5IdTile<128, 128, 32, 64, 128>})
@Requires(TM == TN && (TM == 64 || TM == 128) && TM % WM == 0 && TN % WN == 0 && WM % 16 == 0
    && WN % 16 == 0 && (TM / WM) * (TN / WN) * 16 == TN && KS == 128 && (WN / 16) % 2 == 0)
public final class Q5IdTile<uint32 TM, uint32 TN, uint32 WM, uint32 WN, uint32 KS>
        implements IdShape {

    public Q5IdTile() { return; }

    public #String kernel() {
        return "Q5IdTile_" + TM + "_" + TN + "_" + WM + "_" + WN + "_" + KS + "_q5kId";
    }
    public int32 tileM() { return (int32) TM; }
    public int32 tileN() { return (int32) TN; }
    public int32 threads() { return (int32) (2 * TN); }
    public int32 chunkRows() { return (int32) TM; }

    /** Rows on the TN grid, whole 256-value blocks, a non-empty batch. */
    public boolean fits(int64 np, int64 outDim, int64 cols) {
        return np > 0L && outDim % (int64) TN == 0L && cols % 256L == 0L;
    }

    /** One launch over the batch's map of TM rows on the quant stream. */
    public void launch(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int32> slabW, IdBatch b, int64 outDim, int64 cols,
            int64 rowsPerExpert) {
        if (TM == 128) {
            this.launchMaps(y, slab, b.xp, b.e128, b.t128, b.m128, b.meta, b.n128Max,
                outDim, cols, rowsPerExpert);
            return;
        }
        this.launchMaps(y, slab, b.xp, b.e64, b.t64, b.m64, b.meta, b.n64Max,
            outDim, cols, rowsPerExpert);
        return;
    }

    /** One launch over a TM-row chunk map; `nChunksMax` bounds the grid and
     *  the map's meta slot holds the count. Requires outDim % TN == 0. */
    public void launchMaps(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int8> xp, KernelBuffer<int32> mapE, KernelBuffer<int32> mapT0,
            KernelBuffer<int32> mapM1, KernelBuffer<int32> meta, int64 nChunksMax,
            int64 outDim, int64 cols, int64 rowsPerExpert) {
        int64 tilesN = outDim / (int64) TN;
        KernelStream s = QuantKernel.stream();
        q5kId.launch(s, grid: [(uint32) (nChunksMax * tilesN)], block: [2 * TN])
            (y, slab, xp, mapE, mapT0, mapM1, meta, (uint32) outDim, (uint32) tilesN,
             cols / 256L, rowsPerExpert);
        return;
    }

    // The launch is a literal block of 2 * TN; the pin lets the register
    // allocator use what that block allows.
    @Occupancy(maxThreads = 2 * TN)
    @Kernel @FastMath
    @Unlowered(backend = {"vulkan"}, tracked = "xpu-tile-shape-selection 4.9.1", mayLower = true)
    public static void q5kId(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            KernelBuffer<int32> mapE, KernelBuffer<int32> mapT0,
            KernelBuffer<int32> mapM1, KernelBuffer<int32> meta,
            uint32 outDim, uint32 tilesN, int64 blocksPerRow, int64 rowsPerExpert) {
        Shared<int8> aT = shared int8[TM * 144];
        Shared<int8> bT = shared int8[TN * 144];
        Shared<float32> xsAll = shared float32[TM];
        Shared<float32> dAll = shared float32[TN];
        Shared<float32> rgAll = shared float32[TM * 8];
        Shared<int32> scAll = shared int32[TN * 8];
        Shared<float32> cgAll = shared float32[TN * 8];
        // Per-wave spill tile for the ragged tail's guarded store.
        Shared<float32> fs = shared float32[(TM / WM) * (TN / WN) * 256];

        uint32 tid = KernelThread.x();
        uint32 wid = tid / 32;
        uint32 lane = tid % 32;
        uint32 wg = KernelThread.globalIdX() / (2 * TN);
        uint32 mapIdx = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 i0 = tileI * TN;
        uint32 wr = wid / (TN / WN);
        uint32 wc = wid % (TN / WN);
        uint32 cw = i0 + WN * wc;
        // Staging roles: thread -> (column of the TN, which 32-byte nibble
        // group of the half-block), and the same pair as (token, panel role).
        uint32 sCol = tid >> 1;
        uint32 sH = tid & 1;
        // The chunk count lives on the device (the group kernel writes it);
        // the grid is an upper bound.
        uint32 nChunks = (uint32) meta[(int64) (TM / 128)];
        if (mapIdx < nChunks && i0 < outDim) {
            uint32 t0 = (uint32) mapT0[(int64) mapIdx];
            uint32 mEnd = (uint32) mapM1[(int64) mapIdx];
            uint32 tw = t0 + WM * wr;
            int64 rowBytes = blocksPerRow * 176L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 wOff = (int64) mapE[(int64) mapIdx] * rowsPerExpert * rowBytes;
            int64 sRo = wOff + (int64) (i0 + sCol) * rowBytes;
            int64 sXb = (int64) (t0 + sCol) * xRowBytes;
            // The activation chunks this thread copies: chunk c = tid + 2*TN*p
            // is token c/8, 16-byte part c%8 of the half's 128 bytes, so
            // eight consecutive threads read one token's 128 contiguous
            // bytes. The further three tokens are TM/4 rows on.
            uint32 aRow0 = tid >> 3;
            uint32 aPart = tid & 7;
            int64 aSrc0 = (int64) (t0 + aRow0) * xRowBytes + (int64) (16 * aPart);
            int64 xrP = (int64) (TM / 4) * xRowBytes;
            uint32 aDst0 = aRow0 * 144 + 16 * aPart;
            uint32 aDstP = (TM / 4) * 144;
            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1>[WN / 16] mb;
            CooperativeMatrix<int32,16,16,2>[WN / 16] mc;
            CooperativeMatrix<int32,16,16,2>[WM / 16][WN / 16] iacc;
            CooperativeMatrix<float32,16,16,2>[WM / 16][WN / 16] facc;
            for (uint32 i = 0; i < WM / 16; i = i + 1) {
                for (uint32 n = 0; n < WN / 16; n = n + 1) { facc[i][n].splat(0.0f); }
            }

            // The prefetch registers: the next half's activation chunks,
            // its weight nibbles, and at a block boundary the column
            // header (even threads) or the token's sums and scale (odd).
            Vector<int32,4> pa0 = xp.vload<16>(aSrc0).asWords();
            Vector<int32,4> pa1 = xp.vload<16>(aSrc0 + xrP).asWords();
            Vector<int32,4> pa2 = xp.vload<16>(aSrc0 + xrP + xrP).asWords();
            Vector<int32,4> pa3 = xp.vload<16>(aSrc0 + xrP + xrP + xrP).asWords();
            Vector<int32,4> pb0 = packed.vload<16>(sRo + 48L + (int64) (32 * sH)).asWords();
            Vector<int32,4> pb1 = packed.vload<16>(sRo + 64L + (int64) (32 * sH)).asWords();
            Vector<int32,4> pq0 = pb0;
            Vector<int32,4> pq1 = pb0;
            Vector<int32,1> px = xp.vload<4>(sXb + 288L).asWords();
            if (sH == 0) {
                pq0 = packed.vload<16>(sRo).asWords();
            } else {
                pq0 = xp.vload<16>(sXb + 256L).asWords();
                pq1 = xp.vload<16>(sXb + 272L).asWords();
            }

            uint32 nh = (uint32) blocksPerRow * 2;
            uint32 hh = 0;
            while (hh < nh) {
                uint32 H = hh & 1;
                Barrier.workgroup();
                // Store the prefetched half once every wave has read the last one.
                int64 aDst = (int64) aDst0;
                aT.vstore(aDst, pa0.asBytes());
                aT.vstore(aDst + (int64) aDstP, pa1.asBytes());
                aT.vstore(aDst + (int64) (2 * aDstP), pa2.asBytes());
                aT.vstore(aDst + (int64) (3 * aDstP), pa3.asBytes());
                {
                    // Nibble group sH of the half: low nibbles are k
                    // 64sH..64sH+31 of the staged half, high ones
                    // 64sH+32..64sH+63; sub-blocks j0 and j0 + 1, whose
                    // fifth bits are bits j0 and j0 + 1 of the plane bytes
                    // at +16, spread to bit 4 (Q5Tile).
                    int64 dst = (int64) (sCol * 144 + 64 * sH);
                    Vector<int32,4> w0 = pb0;
                    Vector<int32,4> w1 = pb1;
                    int32 j0 = (int32) (4 * H + 2 * sH);
                    int32 j1 = j0 + 1;
                    int64 cb = sRo + (int64) (hh >> 1) * 176L;
                    Vector<int32,4> ph0 = packed.vload<16>(cb + 16L).asWords();
                    Vector<int32,4> ph1 = packed.vload<16>(cb + 32L).asWords();
                    Vector<int32,4> f0 = ((ph0 >> j0) & 16843009) << 4;
                    Vector<int32,4> f1 = ((ph1 >> j0) & 16843009) << 4;
                    Vector<int32,4> g0 = ((ph0 >> j1) & 16843009) << 4;
                    Vector<int32,4> g1 = ((ph1 >> j1) & 16843009) << 4;
                    bT.vstore(dst, ((w0 & 252645135) | f0).asBytes());
                    bT.vstore(dst + 16L, ((w1 & 252645135) | f1).asBytes());
                    bT.vstore(dst + 32L, (((w0 >> 4) & 252645135) | g0).asBytes());
                    bT.vstore(dst + 48L, (((w1 >> 4) & 252645135) | g1).asBytes());
                }
                if (H == 0) {
                    if (sH == 0) {
                        Vector<int32,4> hw = pq0;
                        int32 h0 = hw[0];
                        int32 h1 = hw[1];
                        int32 h2 = hw[2];
                        int32 h3 = hw[3];
                        float32 dv = GgufFile.halfBitsToF32(h0 & 65535);
                        float32 dmv = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
                        int32 d0 = h1 & 255;
                        int32 d1 = (h1 >> 8) & 255;
                        int32 d2 = (h1 >> 16) & 255;
                        int32 d3 = (h1 >> 24) & 255;
                        int32 m0 = h2 & 255;
                        int32 m1 = (h2 >> 8) & 255;
                        int32 m2 = (h2 >> 16) & 255;
                        int32 m3 = (h2 >> 24) & 255;
                        int32 k0 = h3 & 255;
                        int32 k1 = (h3 >> 8) & 255;
                        int32 k2 = (h3 >> 16) & 255;
                        int32 k3 = (h3 >> 24) & 255;
                        uint32 cb = sCol * 8;
                        dAll[sCol] = dv;
                        scAll[cb] = d0 & 63;
                        scAll[cb + 1] = d1 & 63;
                        scAll[cb + 2] = d2 & 63;
                        scAll[cb + 3] = d3 & 63;
                        scAll[cb + 4] = (k0 & 15) | ((d0 >> 2) & 48);
                        scAll[cb + 5] = (k1 & 15) | ((d1 >> 2) & 48);
                        scAll[cb + 6] = (k2 & 15) | ((d2 >> 2) & 48);
                        scAll[cb + 7] = (k3 & 15) | ((d3 >> 2) & 48);
                        cgAll[cb] = 0.0f - dmv * (float32) (m0 & 63);
                        cgAll[cb + 1] = 0.0f - dmv * (float32) (m1 & 63);
                        cgAll[cb + 2] = 0.0f - dmv * (float32) (m2 & 63);
                        cgAll[cb + 3] = 0.0f - dmv * (float32) (m3 & 63);
                        cgAll[cb + 4] = 0.0f - dmv
                            * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                        cgAll[cb + 5] = 0.0f - dmv
                            * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                        cgAll[cb + 6] = 0.0f - dmv
                            * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                        cgAll[cb + 7] = 0.0f - dmv
                            * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));
                    } else {
                        Vector<int32,4> q0 = pq0;
                        Vector<int32,4> q1 = pq1;
                        Vector<int32,1> xw = px;
                        float32 xv = Cajeta.bitsToF32(xw[0]);
                        xsAll[sCol] = xv;
                        uint32 rb = (sCol >> 4) * 128 + (sCol & 15);
                        rgAll[rb] = xv * (float32) q0[0];
                        rgAll[rb + 16] = xv * (float32) q0[1];
                        rgAll[rb + 32] = xv * (float32) q0[2];
                        rgAll[rb + 48] = xv * (float32) q0[3];
                        rgAll[rb + 64] = xv * (float32) q1[0];
                        rgAll[rb + 80] = xv * (float32) q1[1];
                        rgAll[rb + 96] = xv * (float32) q1[2];
                        rgAll[rb + 112] = xv * (float32) q1[3];
                    }
                }
                // Prefetch the next half while this one computes.
                if (hh + 1 < nh) {
                    int64 nb = (int64) ((hh + 1) >> 1);
                    uint32 nH = (hh + 1) & 1;
                    int64 aS = aSrc0 + nb * 320L + (int64) (128 * nH);
                    pa0 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa1 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa2 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa3 = xp.vload<16>(aS).asWords();
                    int64 bS = sRo + nb * 176L + 48L + (int64) (64 * nH + 32 * sH);
                    pb0 = packed.vload<16>(bS).asWords();
                    pb1 = packed.vload<16>(bS + 16L).asWords();
                    if (nH == 0) {
                        if (sH == 0) {
                            pq0 = packed.vload<16>(sRo + nb * 176L).asWords();
                        } else {
                            int64 xb = sXb + nb * 320L;
                            pq0 = xp.vload<16>(xb + 256L).asWords();
                            pq1 = xp.vload<16>(xb + 272L).asWords();
                            px = xp.vload<4>(xb + 288L).asWords();
                        }
                    }
                }
                Barrier.workgroup();

                if (H == 0) {
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { iacc[i][n].splat(0); }
                    }
                }
                uint32 cBase = (WN * wc) * 8;
                uint32 aBuf = (WM * wr) * 144;
                uint32 bBuf = (WN * wc) * 144;
                uint32 jj = 0;
                while (jj < 4) {
                    uint32 j = 4 * H + jj;
                    uint32 kk = 32 * jj;
                    // The dense tile's order: the B fragments of the slab as a
                    // set before the mma set, the column scales once per slab
                    // for every row fragment, the rank-1 updates after them.
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].splat(0); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            mb[n].load(bT, bBuf + n * (16 * 144) + kk, 1, 144);
                        }
                        ma.load(aT, aBuf + i * (16 * 144) + kk, 0, 144);
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].mma(ma, mb[n]); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            mb[n].load(bT, bBuf + n * (16 * 144) + kk + 16, 1, 144);
                        }
                        ma.load(aT, aBuf + i * (16 * 144) + kk + 16, 0, 144);
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].mma(ma, mb[n]); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            TileOps.scaledAccumI32(mc[n], iacc[i][n], scAll, cBase + n * 128 + j, 8);
                        }
                    }
                    uint32 rbase = ((WM / 16) * 8 * wr + j) * 16;
                    for (uint32 n = 0; n + 3 < WN / 16; n = n + 4) {
                        WaveVector<float32, 16> cgA = WaveVector.ofSlice(cgAll, cBase + n * 128 + j, 8);
                        WaveVector<float32, 16> cgB = WaveVector.ofSlice(cgAll, cBase + n * 128 + 128 + j, 8);
                        WaveVector<float32, 16> cgC = WaveVector.ofSlice(cgAll, cBase + n * 128 + 256 + j, 8);
                        WaveVector<float32, 16> cgD = WaveVector.ofSlice(cgAll, cBase + n * 128 + 384 + j, 8);
                        for (uint32 i = 0; i < WM / 16; i = i + 1) {
                            facc[i][n].rank1Accum(rgAll[rbase + 128 * i], cgA);
                            facc[i][n + 1].rank1Accum(rgAll[rbase + 128 * i], cgB);
                            facc[i][n + 2].rank1Accum(rgAll[rbase + 128 * i], cgC);
                            facc[i][n + 3].rank1Accum(rgAll[rbase + 128 * i], cgD);
                        }
                    }
                    for (uint32 n = ((WN / 16) / 4) * 4; n + 1 < WN / 16; n = n + 2) {
                        WaveVector<float32, 16> cgA = WaveVector.ofSlice(cgAll, cBase + n * 128 + j, 8);
                        WaveVector<float32, 16> cgB = WaveVector.ofSlice(cgAll, cBase + n * 128 + 128 + j, 8);
                        for (uint32 i = 0; i < WM / 16; i = i + 1) {
                            facc[i][n].rank1Accum(rgAll[rbase + 128 * i], cgA);
                            facc[i][n + 1].rank1Accum(rgAll[rbase + 128 * i], cgB);
                        }
                    }
                    jj = jj + 1;
                }
                if (H == 1) {
                    uint32 dbase = WN * wc;
                    uint32 xbase = WM * wr;
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            WaveVector<float32, 16> dcv = WaveVector.ofSlice(dAll, dbase + 16 * n, 1);
                            iacc[i][n].scaledAccumInto(facc[i][n], xsAll[xbase + 16 * i], dcv);
                        }
                    }
                }
                hh = hh + 1;
            }

            // Stores: a row fragment wholly below the entry's end lands
            // straight from the accumulator; the ragged one spills to this
            // wave's LDS tile and copies guarded; rows past the end are the
            // next group's and never land.
            for (uint32 i = 0; i < WM / 16; i = i + 1) {
                uint32 tb = tw + 16 * i;
                if (tb < mEnd) {
                    if (tb + 16 <= mEnd) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            facc[i][n].store(y, (uint32) ((int64) tb * (int64) outDim
                                + (int64) (cw + 16 * n)), 0, outDim);
                        }
                    } else {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            facc[i][n].store(fs, wid * 256, 0, 16);
                            uint32 sa = lane;
                            while (sa < 256) {
                                if (tb + sa / 16 < mEnd) {
                                    y[(int64) (tb + sa / 16) * (int64) outDim
                                        + (int64) (cw + 16 * n + sa % 16)] = fs[wid * 256 + sa];
                                }
                                sa = sa + 32;
                            }
                        }
                    }
                }
            }
        }
    }
}
