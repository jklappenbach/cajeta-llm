package dev.cajeta.llm.io;

import cajeta.collection.ArrayList;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeProbe;
import cajeta.xpu.ShapeVerdict;

/**
 * Times one survivor of the Q4_K tile family's filter at the caller's
 * problem (xpu-tile-shape-selection §4): the shape's own launch over the
 * caller's weights and activations into a scratch output, with the split
 * count the route would take, synced before and after. ShapeChoice runs
 * the rounds and the interleaving; this answers one launch.
 */
public final class Q4ShapeProbe implements ShapeProbe {
    ShapeFilter f;
    KernelBuffer<int8> packed;
    KernelBuffer<int8> xp;
    KernelBuffer<float32> y;
    int64 rows;
    int64 outDim;
    int64 cols;

    public Q4ShapeProbe(^ShapeFilter f, ^KernelBuffer<int8> packed, ^KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        this.f = f;
        this.packed = packed;
        this.xp = xp;
        this.rows = rows;
        this.outDim = outDim;
        this.cols = cols;
        this.y #= heap KernelBuffer<float32>((uint64) (rows * outDim));
    }

    public int64 timeNanos(int32 i) {
        ShapeVerdict v = this.f.survivor(i);
        int32 idx = TcTile.shapeIndex(v.candidate.kernel);
        if (idx < 0) { return 0L; }
        Q4TileShape sh = TcTile.shapes().get(idx);
        int64 tm = (int64) sh.tileM();
        int64 tn = (int64) sh.tileN();
        int64 tilesN = this.outDim / tn;
        int64 tiles = (this.rows / tm) * tilesN;
        int64 nb = this.cols / 256L;
        int64 sp = TcTile.splitsFor(tiles, nb);
        TcTile.ensureScratch(tiles, sp, tm * tn);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int64 t0 = Clock.nanoTime();
        sh.launchAs(this.y, this.packed, this.xp, this.rows, this.outDim, this.cols,
            TcTile.part, sp, (uint32) 0);
        TcTile.fixupLaunch(this.y, this.rows, this.outDim, tilesN, sp, (uint32) 0, tm, tn);
        s.sync();
        return Clock.nanoTime() - t0;
    }
}
