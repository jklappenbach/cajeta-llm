package dev.cajeta.llm.io;

import cajeta.collection.HashMap;
import cajeta.io.file.MappedFile;
import cajeta.io.file.Path;
import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.math.Tensor;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.tok.Tokenizer;

/**
 * The 24-byte GGUF prelude — the fixed-offset region, which is exactly
 * what `view` is designed for (spec 13.12): declared little-endian wire
 * order, constant field offsets, zero-copy overlay. The KV stream and
 * tensor directory that follow are data-dependent (string lengths decide
 * every offset), so they take the cursor parser below — Views.md's own
 * line: offsets determined by the data need a parser.
 */
@LittleEndian
view GgufHeader {
    int32 magic;
    int32 version;
    int64 tensorCount;
    int64 kvCount;
}

/**
 * GGUF v3 reader (cajeta-llm plan Unit 16; spec 9.1–9.5, §10 preamble):
 * mmap the file, parse the metadata KV block and tensor directory, and
 * serve tensors dequantized to `float32` — the engine's compute dtype.
 * Storage types F32, F16, BF16 and Q8_0 load (16.1.2); every other ggml
 * type errors NAMING THE TYPE AND THE TENSOR (9.4) until Unit 18 wires
 * the k-quant family. Type dispatch is PER TENSOR, never per file (9.5):
 * a `Q4_K_M` file mixes Q6_K/Q5_K/Q4_K by tensor sensitivity.
 *
 * Metadata: scalar values are retained for every key; the arrays the
 * engine consumes (`tokenizer.ggml.tokens`/`scores`/`token_type`/
 * `merges`) are materialized, all other arrays are structurally skipped.
 * `tokenizer()` builds Unit 12's tokenizer from the embedded vocab with
 * no external file (9.2/16.1.4); `chatTemplate()` hands
 * `tokenizer.chat_template` to Unit 13's interpreter (7.11/16.1.5);
 * `ModelConfig.fromGguf` maps the hyperparameter keys (9.3/16.2.2).
 *
 * A model shipped as a SPLIT GGUF — `<base>-%05d-of-%05d.gguf`, declared
 * by `split.no` / `split.count` / `split.tensors.count` — presents the
 * same single surface as a one-file model: one name→tensor map, one
 * tensor count, transparent reads. Every shard is a complete GGUF with
 * its own prelude and its own tensor directory covering only its own
 * tensors; only shard 0 carries the model metadata, so opening a later
 * shard re-roots the KV parse at shard 0. Shard resolution lives here
 * rather than in `Checkpoint` because the split is described INSIDE the
 * file, not by a sidecar index — nothing above this class can know a
 * `.gguf` is split without parsing it.
 */
public final class GgufFile {
    // ggml type ids (ggml.h) — the four Unit-16 storage types.
    static final int32 T_F32 = 0;
    static final int32 T_F16 = 1;
    static final int32 T_Q8_0 = 8;
    static final int32 T_BF16 = 30;

    // Byte length of the "-00001-of-00004.gguf" tail.
    static final int32 SPLIT_TAIL = 20;

    String path;
    int64 nTensors;
    int64 nKv;
    int64 alignment;

    // Shards, in split order; a one-file model has exactly one. Every
    // tensor read resolves through the shard that owns it.
    int32 nShards;
    String[] shardPaths;
    MappedFile[] shardMaps;
    int64[] shardStart;     // per-shard payload base (aligned dataStart)

    // Scalars: parallel arrays by KV index. kind: 0 int (all int widths +
    // bool), 1 float (f32/f64), 2 string, 3 skipped-array, 4 kept-array.
    String[] kKeys;
    int32[] kKinds;
    int64[] kInts;
    float64[] kFloats;
    String[] kStrs;
    HashMap<String, int32> kIdx;

    // The retained arrays (dedicated fields — see the class doc).
    String[] tokTokens;
    float32[] tokScores;
    int32[] tokTypes;
    String[] tokMerges;
    int32 tokCount;
    int32 mergeCount;

    // Tensor directory.
    String[] tNames;
    int64[][] tShapes;      // TORCH order (reversed ggml ne)
    int32[] tTypes;
    int64[] tOffsets;       // relative to the OWNING shard's payload base
    int32[] tShard;         // which shard holds each tensor
    HashMap<String, int32> tIdx;

    int64 pos;              // parse cursor

    public GgufFile(String path) {
        this.path = "" + path;
        this.alignment = 32;
        this.nShards = 1;
        String root #= this.metadataShardOf(path);
        this.openRooted(root);
    }

    public void close() {
        int32 i = 0;
        while (i < this.nShards) {
            this.shardMaps[i].close();
            i = i + 1;
        }
    }

    // ── surface ─────────────────────────────────────────────────────────

    /** Tensors across EVERY shard. */
    public int64 tensorCount() {
        return this.nTensors;
    }

    /** How many files back this model — 1 unless it is a split GGUF. */
    public int32 shardCount() {
        return this.nShards;
    }

    /**
     * The file that actually holds `name` — the path a caller must map to
     * read at {@link #packedFileOffsetOf}. Identical to
     * {@link #filePath} for a one-file model.
     */
    public #String shardPathOf(String name) {
        int32 i = this.tensorIndexOf(name);
        if (i < 0) {
            throw heap LlmException("gguf: no tensor '" + name + "' in '"
                + this.path + "'");
        }
        String p #= "" + this.shardPaths[this.tShard[i]];
        return #p;
    }

    public int64 kvCount() {
        return this.nKv;
    }

    public boolean hasKey(String key) {
        return this.kIdx.containsKey(key);
    }

    /** Scalar string value, or null. Borrow of retained storage. */
    public String metaString(String key) {
        int32 i = this.indexOfKey(key);
        if (i < 0 || this.kKinds[i] != 2) {
            return null;
        }
        return this.kStrs[i];
    }

    public int64 metaInt(String key, int64 dflt) {
        int32 i = this.indexOfKey(key);
        if (i < 0 || this.kKinds[i] != 0) {
            return dflt;
        }
        return this.kInts[i];
    }

    public float64 metaFloat(String key, float64 dflt) {
        int32 i = this.indexOfKey(key);
        if (i < 0) {
            return dflt;
        }
        if (this.kKinds[i] == 1) {
            return this.kFloats[i];
        }
        if (this.kKinds[i] == 0) {
            return (float64) this.kInts[i];
        }
        return dflt;
    }

    public boolean contains(String name) {
        return this.tIdx.containsKey(name);
    }

    public int32 tensorIndexOf(String name) {
        if (!this.tIdx.containsKey(name)) {
            return -1;
        }
        return this.tIdx.get(name);
    }

    /** Directory name at `idx` — a borrow of interior storage. */
    public String nameAt(int32 idx) {
        return this.tNames[idx];
    }

    public int64[] shapeOf(int32 idx) {
        return this.tShapes[idx];
    }

    public int32 typeOf(int32 idx) {
        return this.tTypes[idx];
    }

    /** The embedded tokenizer (9.2/16.1.4) — no external file. */
    public #Tokenizer tokenizer() {
        String model = this.metaString("tokenizer.ggml.model");
        if (model == null || this.tokTokens == null) {
            throw heap LlmException("gguf: '" + this.path
                + "' embeds no tokenizer (tokenizer.ggml.model / tokens)");
        }
        String pre = this.metaString("tokenizer.ggml.pre");
        if (pre == null) {
            pre = "";
        }
        Tokenizer t #= Tokenizer.fromGgml(model, pre, this.tokTokens,
            this.tokScores, this.tokTypes, this.tokMerges);
        // The model's own prompt policy. Absent add_bos_token the default
        // is PER TOKENIZER TYPE, measured in llama-vocab.cpp (2026-08-31):
        // SPM defaults true; BPE defaults FALSE unless the pre family is
        // llama-bpe (llama3 et al.). The old blanket TRUE was llama.cpp's
        // behaviour only for those two cases and silently prepended a BOS
        // llama.cpp does not on qwen2-pre files that omit the key — the
        // Qwen1.5-MoE witness answers a different prompt with it (the
        // 27.1.4 divergence: '____' became ' 100%').
        int64 bos = this.metaInt("tokenizer.ggml.bos_token_id", -1L);
        int64 addDflt = 0L;
        if (model.equals("llama") || pre.equals("llama-bpe")
                || pre.equals("llama-v3") || pre.equals("llama3")) {
            addDflt = 1L;
        }
        boolean add = this.metaInt("tokenizer.ggml.add_bos_token",
            addDflt) != 0L;
        t.setBosPolicy(add, (int32) bos);
        return #t;
    }

    /** `tokenizer.chat_template`, or null — Unit 13's input (16.1.5). */
    public String chatTemplate() {
        return this.metaString("tokenizer.chat_template");
    }

    /**
     * Load tensor `name` dequantized to float32 — F32/F16/BF16 widen,
     * Q8_0 dequantizes per 32-block (spec §10: sub-byte and blocked
     * formats are STORAGE, arithmetic happens at f32). Anything else is
     * the 9.4 error, naming type and tensor.
     */
    /**
     * The ggml type of a tensor by NAME, or -1 when absent — the
     * dispatch key for keeping a quantized weight PACKED rather than
     * dequantizing it at load (spec §10).
     */
    public int32 typeOfName(String name) {
        int32 i = this.tensorIndexOf(name);
        if (i < 0) {
            return -1;
        }
        return this.tTypes[i];
    }

    /**
     * A tensor's shape by NAME in TORCH order (`[out, in]` for a
     * projection, `[vocab, dim]` for an embedding), or null when absent —
     * so a packed bind can verify orientation, not merely byte count.
     */
    public int64[] shapeOfName(String name) {
        int32 i = this.tensorIndexOf(name);
        if (i < 0) {
            return null;
        }
        return this.tShapes[i];
    }

    /**
     * The tensor's bytes EXACTLY as the file holds them — no decode. For
     * a block-quantized tensor these are the packed blocks the
     * dequantize-on-the-fly kernels consume directly (`Quant.q8MatVec`),
     * which is the point: decode is memory-bandwidth bound, so moving 1
     * byte per weight instead of 4 is the win, and the unpack rides in
     * registers where the block scale is already hot.
     */
    /**
     * Absolute FILE offset of a packed tensor's payload, validated
     * exactly as {@link #loadPacked} — the seam 15.19's lazy expert
     * slabs read through: the caller maps the same file and reads
     * expert strides on access, so an expert that never fires is a
     * page range never touched.
     */
    public int64 packedFileOffsetOf(String name) {
        int32 i = this.tensorIndexOf(name);
        if (i < 0) {
            throw heap LlmException("gguf: no tensor '" + name + "' in '"
                + this.path + "'");
        }
        if (!Quant.supported(this.tTypes[i])) {
            throw heap LlmException("gguf: tensor '" + name + "' is "
                + GgufFile.typeName(this.tTypes[i])
                + ", not a packed block type");
        }
        return this.shardStart[this.tShard[i]] + this.tOffsets[i];
    }

    /** The path this file was opened from (for a second mapping of
     *  the same bytes; the page cache is shared). Split models: this is
     *  the metadata shard — {@link #shardPathOf} names a tensor's own. */
    public #String filePath() {
        String p #= "" + this.path;
        return #p;
    }

    public #int8[] loadPacked(String name) {
        int32 i = this.tensorIndexOf(name);
        if (i < 0) {
            throw heap LlmException("gguf: no tensor '" + name + "' in '"
                + this.path + "'");
        }
        int32 ty = this.tTypes[i];
        if (!Quant.supported(ty)) {
            throw heap LlmException("gguf: tensor '" + name + "' is "
                + GgufFile.typeName(ty) + ", not a packed block type");
        }
        int64[] shp = this.tShapes[i];
        int64 n = 1;
        int32 d = 0;
        while (d < (int32) shp.count()) {
            n = n * shp[d];
            d = d + 1;
        }
        int64 be = (int64) Quant.blockElems(ty);
        if (n % be != 0L) {
            throw heap LlmException("gguf: " + GgufFile.typeName(ty)
                + " tensor '" + name + "' has " + n
                + " elements - not a " + be + "-block multiple");
        }
        int64 bytes = (n / be) * (int64) Quant.blockBytes(ty);
        int8[] raw #= heap int8[bytes];
        MappedFile m = this.shardMaps[this.tShard[i]];
        m.read(this.shardStart[this.tShard[i]] + this.tOffsets[i], raw, 0,
            bytes);
        return #raw;
    }

    public #Tensor<float32> loadF32(String name) {
        int32 i = this.tensorIndexOf(name);
        if (i < 0) {
            throw heap LlmException("gguf: no tensor '" + name + "' in '"
                + this.path + "'");
        }
        int32 ty = this.tTypes[i];
        int64[] shp = this.tShapes[i];
        int64 n = 1;
        int32 d = 0;
        while (d < (int32) shp.count()) {
            n = n * shp[d];
            d = d + 1;
        }
        int64[] shpCopy #= heap int64[shp.count()];
        d = 0;
        while (d < (int32) shp.count()) {
            shpCopy[d] = shp[d];
            d = d + 1;
        }
        Tensor<float32> t #= Tensor.zeros<float32>(shpCopy);
        MappedFile m = this.shardMaps[this.tShard[i]];
        int64 off = this.shardStart[this.tShard[i]] + this.tOffsets[i];
        if (ty == GgufFile.T_F32) {
            m.copyTo(off, t.hostAddress(), n * 4);
        } else if (ty == GgufFile.T_F16) {
            int8[] raw #= heap int8[n * 2];
            m.read(off, raw, 0, n * 2);
            int64 j = 0;
            while (j < n) {
                int32 h = ((int32) raw[j * 2] & 255)
                    | (((int32) raw[j * 2 + 1] & 255) << 8);
                t.flatSet(j, GgufFile.halfBitsToF32(h));
                j = j + 1;
            }
        } else if (ty == GgufFile.T_BF16) {
            int8[] raw #= heap int8[n * 2];
            m.read(off, raw, 0, n * 2);
            int64 j = 0;
            while (j < n) {
                int64 hi = ((int64) raw[j * 2] & 255L)
                    | (((int64) raw[j * 2 + 1] & 255L) << 8);
                t.flatSet(j, GgufFile.singleBits(hi << 16));
                j = j + 1;
            }
        } else if (Quant.supported(ty)) {
            // The whole block family routes through Quant (Unit 18):
            // per-TENSOR dispatch — a Q4_K_M file mixes Q4_K/Q5_K/Q6_K by
            // tensor sensitivity (spec 9.5).
            int64 be = (int64) Quant.blockElems(ty);
            if (n % be != 0L) {
                throw heap LlmException("gguf: " + GgufFile.typeName(ty)
                    + " tensor '" + name + "' has " + n
                    + " elements - not a " + be + "-block multiple");
            }
            int64 blocks = n / be;
            int64 bb = (int64) Quant.blockBytes(ty);
            int8[] raw #= heap int8[blocks * bb];
            m.read(off, raw, 0, blocks * bb);
            float32[] dq #= heap float32[n];
            Quant.dequantize(ty, raw, 0, blocks, dq, 0);
            int64 j = 0;
            while (j < n) {
                t.flatSet(j, dq[j]);
                j = j + 1;
            }
        } else {
            throw heap LlmException("gguf: tensor '" + name
                + "' has unsupported ggml type " + ty
                + " (" + GgufFile.typeName(ty) + "); supported: "
                + "F32, F16, BF16, Q4_0, Q8_0, Q2_K..Q6_K");
        }
        return #t;
    }

    // ── split resolution ────────────────────────────────────────────────

    /**
     * The shard whose KV block is the model's metadata. `gguf-split`
     * writes the full metadata into shard 0 and only the three `split.*`
     * keys into the rest (gguf-split.cpp:234-240), so opening a later
     * shard has to re-root. The FILENAME says which shard this is before
     * anything is parsed, and that file's own `split.count` confirms it.
     */
    #String metadataShardOf(String p) {
        int32 no = GgufFile.splitNoInName(p);
        if (no <= 0) {
            String same #= "" + p;
            return #same;
        }
        MappedFile probe #= heap MappedFile(p);
        this.readHeader(probe, p);
        int64[] meta #= heap int64[3];
        this.scanShardKvs(probe, meta);
        probe.close();
        int64 count = meta[2];
        if (count <= 1L) {
            String same #= "" + p;
            return #same;
        }
        int32 named = GgufFile.splitTotalInName(p);
        if (count != (int64) named) {
            throw heap LlmException("gguf: '" + p + "' declares split.count "
                + count + " but its name says " + named
                + " of them (<base>-%05d-of-%05d.gguf)");
        }
        String pre #= p.substring(0, p.byteLength() - GgufFile.SPLIT_TAIL);
        String s0 #= GgufFile.shardPathAt(pre, 0, named);
        Path q #= Path.of(s0);
        if (!q.exists()) {
            throw heap LlmException("gguf: '" + p + "' is shard "
                + (no + 1) + " of " + named
                + " and shard 1 of " + named + ", which carries the model"
                + " metadata, is missing - expected '" + s0 + "'; found "
                + GgufFile.shardsPresent(pre, named) + " of " + named
                + " shards. Refusing to load a truncated model.");
        }
        return #s0;
    }

    static int32 shardsPresent(String prefix, int32 ns) {
        int32 have = 0;
        int32 i = 0;
        while (i < ns) {
            String sp #= GgufFile.shardPathAt(prefix, i, ns);
            Path sq #= Path.of(sp);
            if (sq.exists()) {
                have = have + 1;
            }
            i = i + 1;
        }
        return have;
    }

    /** Parse `root`'s metadata, then fold in whatever shards it declares. */
    void openRooted(String root) {
        MappedFile m0 #= heap MappedFile(root);
        this.readHeader(m0, root);
        this.parseKvs(m0);
        int64 dir0 = this.pos;
        int64 count = this.metaInt("split.count", 1L);
        int32 ns = 1;
        if (count > 1L) {
            ns = (int32) count;
            int64 no = this.metaInt("split.no", 0L);
            if (no != 0L) {
                throw heap LlmException("gguf: '" + root
                    + "' carries the model metadata but declares split.no "
                    + no + "; expected 0");
            }
        }
        this.nShards = ns;
        this.shardPaths #= heap String[ns];
        this.shardMaps #= heap MappedFile[ns];
        this.shardStart #= heap int64[ns];
        this.shardPaths[0] #= "" + root;
        this.shardMaps[0] #= m0;
        if (ns > 1) {
            this.nameSiblings(root, ns);
        }
        this.buildDirectory(dir0);
    }

    /**
     * Fill in the sibling shard paths, refusing loudly when one is
     * absent: a model that silently loads 3 of 4 shards fails later, far
     * from the cause, as a missing tensor.
     */
    void nameSiblings(String root, int32 ns) {
        if (GgufFile.splitNoInName(root) != 0) {
            throw heap LlmException("gguf: '" + root + "' declares split.count "
                + ns + " but its name does not follow"
                + " <base>-%05d-of-%05d.gguf, so its sibling shards"
                + " cannot be derived");
        }
        String pre #= root.substring(0, root.byteLength()
            - GgufFile.SPLIT_TAIL);
        int32 have = GgufFile.shardsPresent(pre, ns);
        int32 i = 0;
        while (i < ns) {
            String sp #= GgufFile.shardPathAt(pre, i, ns);
            this.shardPaths[i] #= sp;
            i = i + 1;
        }
        if (have == ns) {
            return;
        }
        i = 0;
        while (i < ns) {
            Path sq #= Path.of(this.shardPaths[i]);
            if (!sq.exists()) {
                throw heap LlmException("gguf: '" + this.path + "' is a "
                    + ns + "-shard split model and shard " + (i + 1)
                    + " of " + ns + " is missing - expected '"
                    + this.shardPaths[i] + "'; found " + have + " of "
                    + ns + " shards. Refusing to load a truncated model.");
            }
            i = i + 1;
        }
    }

    /**
     * Read every shard's tensor directory into ONE name→tensor index.
     * Offsets stay relative to the owning shard's payload base, which each
     * shard aligns by its OWN `general.alignment` — the later shards carry
     * no metadata, so they take the 32-byte default.
     */
    void buildDirectory(int64 dir0) {
        int32 ns = this.nShards;
        int64[] counts #= heap int64[ns];
        counts[0] = this.nTensors;
        int32 i = 1;
        while (i < ns) {
            MappedFile mi #= heap MappedFile(this.shardPaths[i]);
            this.readHeader(mi, this.shardPaths[i]);
            counts[i] = this.nTensors;
            this.shardMaps[i] #= mi;
            i = i + 1;
        }
        int64 total = 0;
        i = 0;
        while (i < ns) {
            total = total + counts[i];
            i = i + 1;
        }
        int32 nt = (int32) total;
        this.tNames #= heap String[nt];
        this.tShapes #= heap int64[nt][];
        this.tTypes #= heap int32[nt];
        this.tOffsets #= heap int64[nt];
        this.tShard #= heap int32[nt];
        this.tIdx #= heap HashMap<String, int32>();

        int32 w = 0;
        i = 0;
        while (i < ns) {
            MappedFile m = this.shardMaps[i];
            int64 a = this.alignment;
            if (i == 0) {
                this.pos = dir0;
            } else {
                this.readHeader(m, this.shardPaths[i]);
                int64[] meta #= heap int64[3];
                this.scanShardKvs(m, meta);
                if (meta[0] != (int64) i) {
                    throw heap LlmException("gguf: shard '"
                        + this.shardPaths[i] + "' declares split.no "
                        + meta[0] + "; its name says " + i);
                }
                a = meta[1];
            }
            int64 j = 0;
            while (j < counts[i]) {
                this.readTensorInfo(m, w, i);
                w = w + 1;
                j = j + 1;
            }
            this.shardStart[i] = ((this.pos + a - 1) / a) * a;
            i = i + 1;
        }
        this.nTensors = total;
        int64 declared = this.metaInt("split.tensors.count", total);
        if (declared != total) {
            throw heap LlmException("gguf: '" + this.path + "' declares "
                + declared + " tensors across " + ns
                + " shards but their directories hold " + total);
        }
    }

    /** The 0-based shard index in `<base>-%05d-of-%05d.gguf`, else -1.
     *  The format is llama.cpp's SPLIT_PATH_FORMAT (llama.cpp:509). */
    static int32 splitNoInName(String p) {
        int32 n = p.byteLength();
        if (n <= GgufFile.SPLIT_TAIL) {
            return -1;
        }
        int32 at = n - GgufFile.SPLIT_TAIL;
        if (!p.endsWith(".gguf")) {
            return -1;
        }
        if (p.charAt(at) != (int8) 45 || p.charAt(at + 6) != (int8) 45
                || p.charAt(at + 7) != (int8) 111
                || p.charAt(at + 8) != (int8) 102
                || p.charAt(at + 9) != (int8) 45) {
            return -1;
        }
        int32 a = GgufFile.digits5(p, at + 1);
        int32 b = GgufFile.digits5(p, at + 10);
        if (a < 1 || b < 1) {
            return -1;
        }
        return a - 1;
    }

    /** The shard TOTAL in `<base>-%05d-of-%05d.gguf`, else -1. */
    static int32 splitTotalInName(String p) {
        if (GgufFile.splitNoInName(p) < 0) {
            return -1;
        }
        return GgufFile.digits5(p, p.byteLength() - GgufFile.SPLIT_TAIL + 10);
    }

    static int32 digits5(String p, int32 at) {
        int32 v = 0;
        int32 i = 0;
        while (i < 5) {
            int32 c = ((int32) p.charAt(at + i)) & 255;
            if (c < 48 || c > 57) {
                return -1;
            }
            v = v * 10 + (c - 48);
            i = i + 1;
        }
        return v;
    }

    static #String pad5(int32 v) {
        int8[] b #= heap int8[5];
        int32 x = v;
        int32 i = 4;
        while (i >= 0) {
            b[i] = (int8) (48 + (x % 10));
            x = x / 10;
            i = i - 1;
        }
        String s = heap String(#b, 5);
        return #s;
    }

    static #String shardPathAt(String prefix, int32 idx, int32 total) {
        String a #= GgufFile.pad5(idx + 1);
        String b #= GgufFile.pad5(total);
        String out = prefix + "-" + a + "-of-" + b + ".gguf";
        return #out;
    }

    // ── parsing internals ───────────────────────────────────────────────

    int32 indexOfKey(String key) {
        if (!this.kIdx.containsKey(key)) {
            return -1;
        }
        return this.kIdx.get(key);
    }

    /** The fixed prelude, through the view overlay (16.2.1). */
    void readHeader(MappedFile m, String p) {
        int64 fileLen = m.size();
        if (fileLen < 24) {
            throw heap LlmException("gguf: '" + p + "' is " + fileLen
                + " bytes - too short for the GGUF header");
        }
        int8[] hb #= heap int8[24];
        m.read(0, hb, 0, 24);
        GgufHeader h = GgufHeader(hb);
        if (h.magic != 0x46554747) {
            throw heap LlmException("gguf: '" + p
                + "' has magic " + h.magic + "; expected GGUF");
        }
        if (h.version != 3 && h.version != 2) {
            throw heap LlmException("gguf: '" + p + "' is version "
                + h.version + "; supported: 2, 3");
        }
        this.nTensors = h.tensorCount;
        this.nKv = h.kvCount;
        this.pos = 24;
    }

    void parseKvs(MappedFile m) {
        int32 nk = (int32) this.nKv;
        this.kKeys #= heap String[nk];
        this.kKinds #= heap int32[nk];
        this.kInts #= heap int64[nk];
        this.kFloats #= heap float64[nk];
        this.kStrs #= heap String[nk];
        this.kIdx #= heap HashMap<String, int32>();
        this.tokTokens = null;
        this.tokScores = null;
        this.tokTypes = null;
        this.tokMerges = null;
        this.tokCount = 0;
        this.mergeCount = 0;
        int32 i = 0;
        while (i < nk) {
            this.readKv(m, i);
            i = i + 1;
        }
        // general.alignment overrides the default 32.
        int32 ai = this.indexOfKey("general.alignment");
        if (ai >= 0) {
            if (this.kKinds[ai] == 0) {
                this.alignment = this.kInts[ai];
            }
        }
    }

    /**
     * Walk a KV block keeping only what a metadata-less shard can carry:
     * out[0] `split.no`, out[1] `general.alignment`, out[2] `split.count`.
     * Nothing is retained, so this never disturbs the metadata shard's
     * parsed state.
     */
    void scanShardKvs(MappedFile m, int64[] out) {
        out[0] = -1;
        out[1] = 32;
        out[2] = -1;
        int64 i = 0;
        while (i < this.nKv) {
            String key #= this.readStr(m);
            int32 vt = (int32) this.readU32(m);
            if (vt == 8) {
                int64 len = this.readU64(m);
                this.pos = this.pos + len;
            } else if (vt == 9) {
                this.skipArrayValue(m, key);
            } else if (vt == 6) {
                this.pos = this.pos + 4;
            } else if (vt == 12) {
                this.pos = this.pos + 8;
            } else if (GgufFile.scalarSize(vt) > 0) {
                int64 v = this.readScalarInt(m, vt);
                if (key.equals("split.no")) {
                    out[0] = v;
                } else if (key.equals("general.alignment")) {
                    out[1] = v;
                } else if (key.equals("split.count")) {
                    out[2] = v;
                }
            } else {
                throw heap LlmException("gguf: '" + this.path
                    + "' key '" + key + "' has unknown value type " + vt);
            }
            i = i + 1;
        }
    }

    void skipArrayValue(MappedFile m, String key) {
        int32 et = (int32) this.readU32(m);
        int64 count = this.readU64(m);
        if (et == 8) {
            int64 j = 0;
            while (j < count) {
                int64 len = this.readU64(m);
                this.pos = this.pos + len;
                j = j + 1;
            }
            return;
        }
        int64 sz = GgufFile.scalarSize(et);
        if (sz < 0) {
            throw heap LlmException("gguf: '" + this.path
                + "' key '" + key + "' is an array of type " + et
                + " - unsupported");
        }
        this.pos = this.pos + sz * count;
    }

    int64 readU32(MappedFile m) {
        int8[] b #= heap int8[4];
        m.read(this.pos, b, 0, 4);
        this.pos = this.pos + 4;
        return ((int64) b[0] & 255L) | (((int64) b[1] & 255L) << 8)
            | (((int64) b[2] & 255L) << 16) | (((int64) b[3] & 255L) << 24);
    }

    int64 readU64(MappedFile m) {
        int64 lo = this.readU32(m);
        int64 hi = this.readU32(m);
        return lo | (hi << 32);
    }

    #String readStr(MappedFile m) {
        int64 len = this.readU64(m);
        if (len < 0 || this.pos + len > m.size()) {
            throw heap LlmException("gguf: '" + this.path
                + "' declares a " + len + "-byte string at " + this.pos
                + " past the file end");
        }
        int8[] b #= heap int8[len];
        m.read(this.pos, b, 0, len);
        this.pos = this.pos + len;
        String s = heap String(#b, (int32) len);
        return #s;
    }

    float64 readF32Val(MappedFile m) {
        int64 bits = this.readU32(m);
        return (float64) GgufFile.singleBits(bits);
    }

    /**
     * f64 metadata values decode arithmetically too (same isel-abort
     * avoidance). 52-bit mantissas split into two exact halves.
     */
    float64 readF64Val(MappedFile m) {
        int64 bits = this.readU64(m);
        int32 sign = (int32) ((bits >> 63) & 1L);
        int32 exp = (int32) ((bits >> 52) & 2047L);
        int64 man = bits & 4503599627370495L;
        float64 mag;
        float64 frac = ((float64) (man >> 26)) / 67108864.0
            + ((float64) (man & 67108863L)) / 4503599627370496.0;
        if (exp == 0) {
            mag = frac * GgufFile.pow2(-1022);
        } else if (exp == 2047) {
            mag = 340000000000000000000000000000000000000.0;
        } else {
            mag = (1.0 + frac) * GgufFile.pow2(exp - 1023);
        }
        if (sign == 1) {
            mag = 0.0 - mag;
        }
        return mag;
    }

    /** Scalar value size by GGUF type id; -1 for string/array. */
    static int64 scalarSize(int32 ty) {
        if (ty == 0 || ty == 1 || ty == 7) { return 1; }   // u8 i8 bool
        if (ty == 2 || ty == 3) { return 2; }              // u16 i16
        if (ty == 4 || ty == 5 || ty == 6) { return 4; }   // u32 i32 f32
        if (ty == 10 || ty == 11 || ty == 12) { return 8; } // u64 i64 f64
        return -1;
    }

    int64 readScalarInt(MappedFile m, int32 ty) {
        int64 sz = GgufFile.scalarSize(ty);
        int8[] b #= heap int8[8];
        m.read(this.pos, b, 0, sz);
        this.pos = this.pos + sz;
        int64 v = 0;
        int64 j = 0;
        while (j < sz) {
            v = v | (((int64) b[j] & 255L) << (j * 8L));
            j = j + 1;
        }
        // Sign-extend the signed widths (i8/i16/i32; i64 is already full).
        if (ty == 1 && (v & 0x80L) != 0L) { v = v - 256L; }
        if (ty == 3 && (v & 0x8000L) != 0L) { v = v - 65536L; }
        if (ty == 5 && (v & 0x80000000L) != 0L) { v = v - 4294967296L; }
        return v;
    }

    void readKv(MappedFile m, int32 i) {
        String key #= this.readStr(m);
        int32 vt = (int32) this.readU32(m);
        this.kKinds[i] = 3;
        if (vt == 8) {                       // string
            String sv #= this.readStr(m);
            this.kKinds[i] = 2;
            this.kStrs[i] #= sv;
        } else if (vt == 6) {                // f32
            this.kKinds[i] = 1;
            this.kFloats[i] = this.readF32Val(m);
        } else if (vt == 12) {               // f64
            this.kKinds[i] = 1;
            this.kFloats[i] = this.readF64Val(m);
        } else if (GgufFile.scalarSize(vt) > 0) {
            this.kKinds[i] = 0;
            this.kInts[i] = this.readScalarInt(m, vt);
        } else if (vt == 9) {                // array
            this.readArrayValue(m, i, key);
        } else {
            throw heap LlmException("gguf: '" + this.path
                + "' key '" + key + "' has unknown value type " + vt);
        }
        this.kIdx.put("" + key, i);
        this.kKeys[i] #= key;
    }

    void readArrayValue(MappedFile m, int32 i, String key) {
        int32 et = (int32) this.readU32(m);
        int64 count = this.readU64(m);
        boolean isTokens = key.equals("tokenizer.ggml.tokens");
        boolean isMerges = key.equals("tokenizer.ggml.merges");
        boolean isScores = key.equals("tokenizer.ggml.scores");
        boolean isTypes = key.equals("tokenizer.ggml.token_type");
        if (et == 8) {                       // string elements
            if (isTokens || isMerges) {
                String[] arr #= heap String[(int32) count];
                int64 j = 0;
                while (j < count) {
                    String sv #= this.readStr(m);
                    arr[(int32) j] #= sv;
                    j = j + 1;
                }
                this.kKinds[i] = 4;
                if (isTokens) {
                    this.tokTokens #= arr;
                    this.tokCount = (int32) count;
                } else {
                    this.tokMerges #= arr;
                    this.mergeCount = (int32) count;
                }
            } else {
                int64 j = 0;
                while (j < count) {
                    int64 len = this.readU64(m);
                    this.pos = this.pos + len;
                    j = j + 1;
                }
            }
        } else if (et == 6 && isScores) {    // f32 scores
            float32[] sc #= heap float32[(int32) count];
            int64 j = 0;
            while (j < count) {
                sc[(int32) j] = (float32) this.readF32Val(m);
                j = j + 1;
            }
            this.kKinds[i] = 4;
            this.tokScores #= sc;
        } else if (et == 5 && isTypes) {     // i32 token types
            int32[] tt #= heap int32[(int32) count];
            int64 j = 0;
            while (j < count) {
                tt[(int32) j] = (int32) this.readScalarInt(m, 5);
                j = j + 1;
            }
            this.kKinds[i] = 4;
            this.tokTypes #= tt;
        } else {
            int64 sz = GgufFile.scalarSize(et);
            if (sz < 0) {
                throw heap LlmException("gguf: '" + this.path
                    + "' key '" + key + "' is an array of type " + et
                    + " - unsupported");
            }
            this.pos = this.pos + sz * count;
        }
    }

    void readTensorInfo(MappedFile m, int32 i, int32 shard) {
        String name #= this.readStr(m);
        int32 nd = (int32) this.readU32(m);
        if (nd < 1 || nd > 4) {
            throw heap LlmException("gguf: tensor '" + name + "' has "
                + nd + " dims; expected 1-4");
        }
        int64[] ne #= heap int64[nd];
        int32 d = 0;
        while (d < nd) {
            ne[d] = this.readU64(m);
            d = d + 1;
        }
        // ggml ne is fastest-first; the engine's torch shapes are the
        // reverse — identical byte layout, reversed labels.
        int64[] shp #= heap int64[nd];
        d = 0;
        while (d < nd) {
            shp[d] = ne[nd - 1 - d];
            d = d + 1;
        }
        this.tTypes[i] = (int32) this.readU32(m);
        this.tOffsets[i] = this.readU64(m);
        this.tShard[i] = shard;
        this.tIdx.put("" + name, i);
        this.tNames[i] #= name;
        this.tShapes[i] #= shp;
    }

    /**
     * IEEE 754 half bits → float32 (Q8_0 scales, F16 payloads) —
     * ARITHMETIC decode, not a bit reinterpretation: `Cajeta.bitsToF32`
     * aborts AOT emission today (specs/aot-bitcast-f32-isel-abort in the
     * cajeta repo; the JIT path is fine). Powers of two and the mantissa
     * quotient are exact in float64, so this loses nothing. Infinities
     * clamp to ±3.4e38 — GGUF weight payloads carry no infinities, and a
     * checkpoint that did would be corrupt anyway.
     */
    @Device
    static float32 halfBitsToF32(int32 h) {
        // Bit-layout rebase, not arithmetic: f16 and f32 share a sign bit and
        // a normalised mantissa, so the conversion is a shift and an exponent
        // bias change. The old arithmetic decode existed only because
        // Cajeta.bitsToF32 aborted AOT emission; that defect is fixed (the
        // intrinsics coerce their operands now), and pow2()'s repeated-squaring
        // loop measured 38% of the Q4_K mat-vec.
        int32 sign = (h >> 15) & 1;
        int32 exp = (h >> 10) & 31;
        int32 man = h & 1023;
        int64 bits;
        if (exp == 0) {
            if (man == 0) {
                bits = (int64) sign << 31;              // +/- zero
            } else {
                // Subnormal: normalise so the implicit leading 1 appears, and
                // pay for the exponent with the shift distance.
                int32 k = 9;
                while ((man & (1 << k)) == 0) { k = k - 1; }
                bits = ((int64) sign << 31)
                     | ((int64) (k + 103) << 23)
                     | (((int64) man << (23 - k)) & 8388607L);
            }
        } else if (exp == 31) {
            bits = ((int64) sign << 31) | (255L << 23) | ((int64) man << 13);
        } else {
            bits = ((int64) sign << 31)
                 | ((int64) (exp + 112) << 23)
                 | ((int64) man << 13);
        }
        return Cajeta.bitsToF32(bits);
    }

    /** 2^e for e in [-149, 127] by repeated squaring at float64 (exact). */
    static float64 pow2(int32 e) {
        float64 r = 1.0;
        int32 n = e;
        float64 b = 2.0;
        if (n < 0) {
            n = 0 - n;
            b = 0.5;
        }
        while (n > 0) {
            if ((n & 1) == 1) {
                r = r * b;
            }
            b = b * b;
            n = n >> 1;
        }
        return r;
    }

    /** IEEE 754 single bits → float32, same arithmetic-decode reason.
     *  Public: the parity instrument reads raw-f32 fixtures through it. */
    public static float32 singleBits(int64 bits) {
        int32 sign = (int32) ((bits >> 31) & 1L);
        int32 exp = (int32) ((bits >> 23) & 255L);
        int32 man = (int32) (bits & 8388607L);
        float64 mag;
        if (exp == 0) {
            mag = ((float64) man / 8388608.0) * GgufFile.pow2(-126);
        } else if (exp == 255) {
            mag = 340000000000000000000000000000000000000.0;
        } else {
            mag = (1.0 + (float64) man / 8388608.0) * GgufFile.pow2(exp - 127);
        }
        if (sign == 1) {
            mag = 0.0 - mag;
        }
        return (float32) mag;
    }

    /** ggml type name for diagnostics; public since prefill-routes 1.2.1
     *  (the `batch-refused` record names the format). */
    public static #String typeName(int32 ty) {
        if (ty == 0) { return #"f32"; }
        if (ty == 1) { return #"f16"; }
        if (ty == 2) { return #"q4_0"; }
        if (ty == 3) { return #"q4_1"; }
        if (ty == 6) { return #"q5_0"; }
        if (ty == 7) { return #"q5_1"; }
        if (ty == 8) { return #"q8_0"; }
        if (ty == 10) { return #"q2_k"; }
        if (ty == 11) { return #"q3_k"; }
        if (ty == 12) { return #"q4_k"; }
        if (ty == 13) { return #"q5_k"; }
        if (ty == 14) { return #"q6_k"; }
        if (ty == 16) { return #"iq2_xxs"; }
        if (ty == 20) { return #"iq4_nl"; }
        if (ty == 23) { return #"iq4_xs"; }
        if (ty == 34) { return #"tq1_0"; }
        if (ty == 35) { return #"tq2_0"; }
        if (ty == 30) { return #"bf16"; }
        if (ty == 39) { return #"mxfp4"; }
        String u = "type_" + ty;
        return #u;
    }
}
