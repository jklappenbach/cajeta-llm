package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelCap;

/**
 * The platform's availability registry, `cajeta.xpu.KernelCap`, under a name llm's
 * own KernelCap can import. The language has no import alias and does not resolve
 * a qualified type name in an expression, so llm's class of the same short name
 * reaches the registry's holds through this one. It lives outside llm's model
 * package because there the package's own KernelCap wins over this file's
 * single-type import (measured on v0.53.4).
 */
public final class KernelHolds {
    public KernelHolds() { return; }

    /** Close `name` on `backend` under `why`, the plan item that owns the defect. */
    public static void hold(String backend, String name, String why) {
        KernelCap.hold(backend, name, why);
    }

    /** Lift a {@link #hold}. */
    public static void release(String backend, String name) {
        KernelCap.release(backend, name);
    }

    /** Why `name` is held on the active backend, or "" when it is not. */
    public static String heldHere(String name) {
        return KernelCap.heldHere(name);
    }

    /** The tier the compiler recorded for `name`'s mma (see `cajeta.xpu.KernelCap`). */
    public static int32 mmaTier(String name) {
        return KernelCap.mmaTier(name);
    }
}
