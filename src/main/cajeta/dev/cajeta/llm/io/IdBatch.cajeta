package dev.cajeta.llm.io;

import cajeta.xpu.KernelBuffer;

/**
 * A MoE batch as the Id GEMM family's members read it (xpu-tile-shape-selection
 * §6, §7.15): the packed activations, the 64-row and 128-row chunk maps, the
 * meta slots holding both chunk counts, and the batch's expert rows. A view of
 * the route's buffers, which outlive it.
 */
public final class IdBatch {
    KernelBuffer<int8> xp;
    KernelBuffer<int32> e64;
    KernelBuffer<int32> t64;
    KernelBuffer<int32> m64;
    KernelBuffer<int32> e128;
    KernelBuffer<int32> t128;
    KernelBuffer<int32> m128;
    KernelBuffer<int32> meta;
    int64 n64Max;
    int64 n128Max;
    int64 np;
    int64 expertsN;

    public IdBatch(^KernelBuffer<int8> xp, ^KernelBuffer<int32> e64, ^KernelBuffer<int32> t64,
            ^KernelBuffer<int32> m64, ^KernelBuffer<int32> e128, ^KernelBuffer<int32> t128,
            ^KernelBuffer<int32> m128, ^KernelBuffer<int32> meta, int64 n64Max, int64 n128Max,
            int64 np, int64 expertsN) {
        this.xp = xp;
        this.e64 = e64;
        this.t64 = t64;
        this.m64 = m64;
        this.e128 = e128;
        this.t128 = t128;
        this.m128 = m128;
        this.meta = meta;
        this.n64Max = n64Max;
        this.n128Max = n128Max;
        this.np = np;
        this.expertsN = expertsN;
    }

    public int64 expertRows() { return this.np; }
    public int64 experts() { return this.expertsN; }

    /** The problem's M for the family's filter and memo: the 128-row chunk
     *  count rounded up to a power of two, in rows (spec §4, §7.12). */
    public int64 bucketRows() {
        int64 chunks = (this.np + 127L) / 128L;
        int64 p = 1L;
        while (p < chunks) { p = p * 2L; }
        return p * 128L;
    }
}
