package dev.cajeta.llm.io;

import cajeta.collection.ArrayList;
import cajeta.time.Clock;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelTimer;
import cajeta.xpu.ShapeChoice;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeProbe;

/** One Id problem's in-place choice (4.8.1.6): a sample is a whole layer's device time with one
 *  survivor, read after the last sample; as a probe it refuses until complete, then replays. */
public final class IdTrial implements ShapeProbe {
    int64 rows;
    int64 outDim;
    int64 cols;
    ShapeFilter f;
    int32 ns;
    int32 rounds;
    int64[] samples;
    int32[] taken;
    int32[] served;
    int32 placed = 0;
    int32 refusals = 0;
    int32 current = -1;
    boolean open = false;
    boolean deviceClock = false;
    boolean clockKnown = false;
    int64 hostT0 = 0L;
    ArrayList<KernelTimer> timers;
    int32[] owners;

    public IdTrial(int64 rows, int64 outDim, int64 cols, #ShapeFilter f) {
        this.rows = rows;
        this.outDim = outDim;
        this.cols = cols;
        this.f #= f;
        this.ns = f.survivorCount();
        this.rounds = ShapeChoice.rounds;
        if (this.rounds < 1) { this.rounds = 1; }
        int32 n = this.ns;
        if (n < 1) { n = 1; }
        this.samples #= heap int64[n * this.rounds];
        this.taken #= heap int32[n];
        this.served #= heap int32[n];
        this.owners #= heap int32[n * this.rounds];
        this.timers #= heap ArrayList<KernelTimer>();
    }

    public ShapeFilter filter() { return this.f; }

    public boolean isFor(int64 rows, int64 outDim, int64 cols) {
        return this.rows == rows && this.outDim == outDim && this.cols == cols;
    }

    /** The survivor the next sample runs: round r visits them all, starting r further along. */
    public int32 next() {
        int32 r = this.placed / this.ns;
        int32 j = this.placed % this.ns;
        return (j + r) % this.ns;
    }

    /** The survivor of the open sample, or -1. */
    public int32 current() { return this.current; }

    public boolean isOpen() { return this.open; }

    /** Starts a sample at `s`'s tail with the next survivor. */
    public void openSample(KernelStream s) {
        if (!this.clockKnown) {
            this.deviceClock = KernelTimer.tier() != KernelTimer.TIER_UNAVAILABLE;
            this.clockKnown = true;
        }
        this.current = this.next();
        if (this.deviceClock) {
            KernelTimer k #= KernelTimer.create();
            k.begin(s);
            this.timers.add(#k);
        } else {
            s.sync();
            this.hostT0 = Clock.nanoTime();
        }
        this.open = true;
    }

    /** Ends the open sample at `s`'s tail; a device sample is read later, by resolve. */
    public void closeSample(KernelStream s) {
        if (!this.open) { return; }
        if (this.deviceClock) {
            this.timers.get((int32) this.timers.count() - 1).end(s);
            this.owners[this.placed] = this.current;
            this.placed = this.placed + 1;
        } else {
            s.sync();
            this.keep(this.current, Clock.nanoTime() - this.hostT0);
        }
        this.open = false;
        this.current = -1;
    }

    /** Whether every survivor has its samples placed. */
    public boolean samplesDone() { return this.ns > 0 && this.placed >= this.ns * this.rounds; }

    /** Reads every device sample, waiting for the last one, and releases the timers. */
    public void resolve() {
        int32 n = (int32) this.timers.count();
        int32 p = 0;
        while (p < n) {
            KernelTimer k = this.timers.get(p);
            this.store(this.owners[p], k.elapsedNanos());
            k.destroy();
            p = p + 1;
        }
        this.timers.clear();
    }

    /** Releases the timers of an unfinished trial. */
    public void discard() {
        int32 n = (int32) this.timers.count();
        int32 p = 0;
        while (p < n) {
            this.timers.get(p).destroy();
            p = p + 1;
        }
        this.timers.clear();
    }

    /** The time of sample `k` of survivor `i`, for the route record. */
    public int64 sampleOf(int32 i, int32 k) { return this.samples[i * this.rounds + k]; }

    public int32 roundsEach() { return this.rounds; }

    /** Keeps a host-timed sample of survivor `i` and places it. */
    public void keep(int32 i, int64 nanos) {
        this.store(i, nanos);
        this.placed = this.placed + 1;
    }

    void store(int32 i, int64 nanos) {
        int32 k = this.taken[i];
        if (k < this.rounds) {
            this.samples[i * this.rounds + k] = nanos;
            this.taken[i] = k + 1;
        }
    }

    public boolean complete() { return this.samplesDone() && this.timers.count() == 0L; }

    /** How many times a choice asked this trial to time before it was complete. */
    public int32 asked() { return this.refusals; }

    public int64 timeNanos(int32 i) {
        if (!this.complete()) {
            this.refusals = this.refusals + 1;
            return 0L;
        }
        int32 k = this.served[i];
        if (k >= this.rounds) { k = this.rounds - 1; }
        this.served[i] = this.served[i] + 1;
        return this.samples[i * this.rounds + k];
    }
}
