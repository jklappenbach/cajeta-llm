package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;

/**
 * The hand-written 64-row Id kernel as a member of the Id family
 * (xpu-tile-shape-selection 2.6, 4.8.1.4.2): `q4kWmmaIdMwKernel` over the
 * 64-row chunk map, the shape of the template's 64-row member with the
 * activations fed from global memory instead of LDS. It stays listed until
 * timing retires it.
 */
public final class IdHandTile implements IdShape {
    public IdHandTile() { return; }

    public #String kernel() { return "q4kWmmaIdMwKernel"; }
    public int32 tileM() { return 64; }
    public int32 tileN() { return 128; }
    public int32 threads() { return WmmaKernel.mwLaunchBlock(); }
    public int32 chunkRows() { return 64; }

    public boolean fits(int64 np, int64 outDim, int64 cols) {
        return np > 0L && outDim % 128L == 0L && cols % 256L == 0L;
    }

    public void launch(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int32> slabW, IdBatch b, int64 outDim, int64 cols,
            int64 rowsPerExpert) {
        WmmaKernel.q4kWmmaIdMwLaunchNoSync(y, slab, slabW, b.xp, b.e64, b.t64, b.m64,
            b.meta, b.n64Max, outDim, cols, rowsPerExpert);
        return;
    }
}
