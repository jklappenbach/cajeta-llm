package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;

/**
 * The hand-written Id kernels as members of the Id family
 * (xpu-tile-shape-selection 2.6, 7.15): the 64-row kernel over the 64-row
 * chunk map, and the 128-row kernel over the 128-row map, each at its shape.
 */
public final class IdHandTile implements IdShape {
    int32 rows;

    /** `rows` is 64 for `q4kWmmaIdMwKernel`, 128 for `q4kWmmaIdMw8Kernel`. */
    public IdHandTile(int32 rows) { this.rows = rows; }

    public #String kernel() {
        if (this.rows == 64) { return "q4kWmmaIdMwKernel"; }
        return "q4kWmmaIdMw8Kernel";
    }
    public int32 tileM() { return this.rows; }
    public int32 tileN() { return 128; }
    public int32 threads() { return WmmaKernel.mwLaunchBlock(); }
    public int32 chunkRows() { return this.rows; }

    public boolean fits(int64 np, int64 outDim, int64 cols) {
        return np > 0L && outDim % 128L == 0L && cols % 256L == 0L;
    }

    public void launch(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int32> slabW, IdBatch b, int64 outDim, int64 cols,
            int64 rowsPerExpert) {
        if (this.rows == 64) {
            WmmaKernel.q4kWmmaIdMwLaunchNoSync(y, slab, slabW, b.xp, b.e64, b.t64, b.m64,
                b.meta, b.n64Max, outDim, cols, rowsPerExpert);
            return;
        }
        WmmaKernel.q4kWmmaIdMw8LaunchNoSync(y, slab, slabW, b.xp, b.e128, b.t128, b.m128,
            b.meta, b.n128Max, outDim, cols, rowsPerExpert);
        return;
    }
}
