package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;

/**
 * One listed member of the MoE Id GEMM family (xpu-tile-shape-selection
 * §7.15): its shape, the chunk map it reads and its launch over a batch.
 * The five members every family member answers come from {@link TileShape};
 * here `fits` covers a batch of `np` expert rows against a bank of `outDim`
 * rows and `cols` columns.
 */
public interface IdShape extends TileShape {
    /** Rows an entry of the chunk map this member reads: 64 or 128. */
    int32 chunkRows();
    /** One launch over the whole batch on the quant stream, into y. */
    void launch(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int32> slabW, IdBatch b, int64 outDim, int64 cols,
            int64 rowsPerExpert);
}
