package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;

/**
 * One listed shape of the Q4_K tensor-core tile family
 * (xpu-tile-shape-selection §2, §6): every instantiation of
 * {@link QkTile} is one, and {@link TcTile} keeps them as a list so the
 * route can ask the shape choice for the winner at its problem and launch
 * that one, without naming a shape itself.
 */
public interface Q4TileShape {
    /** The instantiation's registered kernel name: what the manifest,
     *  the census and {@code KernelCap.usable} call it. */
    #String kernel();
    int32 tileM();
    int32 tileN();
    int32 threads();
    /** Whether this shape covers the problem: tokens on the TM grid, rows
     *  on the TN grid, columns a whole number of 256-element blocks. */
    boolean fits(int64 rows, int64 outDim, int64 cols);
    /** One launch of the kernel over the whole problem on the caller's
     *  stream, `splits` workgroups a tile; the caller sizes `part` and
     *  runs the fixup. */
    void launchAs(KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols,
            KernelBuffer<float32> part, int64 splits, uint32 accum);
}
