package dev.cajeta.llm.io;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;

/**
 * One listed shape of a dense tensor-core tile family
 * (xpu-tile-shape-selection §2, §6): every instantiation of {@link QkTile},
 * {@link Q6Tile} and {@link MwTile} is one, and {@link TcTile} keeps them in
 * a {@link TileFamily} so the route can ask the shape choice for the winner
 * at its problem and launch that one, without naming a shape itself.
 * The five members every family member answers come from {@link TileShape}:
 * `kernel` is the instantiation's registered kernel name, what the manifest,
 * the census and {@code KernelCap.usable} call it, and `fits` covers the
 * problem with tokens on the TM grid, rows on the TN grid and columns a
 * whole number of 256-element blocks.
 */
public interface Q4TileShape extends TileShape {
    /** Whether the family splits K across workgroups (the tensor-core tiles
     *  do, the Mw GEMM does not). */
    boolean splitsK();
    /** One launch of the kernel over the whole problem on the caller's
     *  stream, `splits` workgroups a tile; the caller sizes `part` and
     *  runs the fixup. */
    void launchAs(KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols,
            KernelBuffer<float32> part, int64 splits, uint32 accum);
}
