package dev.cajeta.llm.io;

import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeProbe;
import cajeta.xpu.ShapeVerdict;

/**
 * Times one survivor of the Id family's filter over the caller's batch
 * (xpu-tile-shape-selection §4, §7.15). A sample is a single launch when the
 * batch is below one full 128-row chunk per expert on average, because the
 * engine runs such a batch once and pays the launch floor; above that it is
 * a burst of eight launches between two syncs, priced per launch, as the
 * dense probe does. Every launch writes the caller's own output, which the
 * chosen member writes again, so the probe needs no scratch.
 */
public final class IdShapeProbe implements ShapeProbe {
    TileFamily<IdShape> fam;
    ShapeFilter f;
    KernelBuffer<float32> y;
    KernelBuffer<int8> slab;
    KernelBuffer<int32> slabW;
    IdBatch b;
    int64 outDim;
    int64 cols;
    int64 rowsPerExpert;

    public IdShapeProbe(^TileFamily<IdShape> fam, ^KernelBuffer<float32> y,
            ^KernelBuffer<int8> slab, ^KernelBuffer<int32> slabW, ^IdBatch b, int64 outDim,
            int64 cols, int64 rowsPerExpert) {
        this.fam = fam;
        this.y = y;
        this.slab = slab;
        this.slabW = slabW;
        this.b = b;
        this.outDim = outDim;
        this.cols = cols;
        this.rowsPerExpert = rowsPerExpert;
    }

    public void bind(^ShapeFilter f) { this.f = f; }

    /** Launches a sample: one below a full chunk per expert, eight above. */
    int32 burst() {
        if (this.b.expertRows() < 128L * this.b.experts()) { return 1; }
        return 8;
    }

    public int64 timeNanos(int32 i) {
        ShapeVerdict v = this.f.survivor(i);
        int32 idx = this.fam.indexOf(v.candidate.kernel);
        if (idx < 0) { return 0L; }
        IdShape sh = this.fam.shapes().get(idx);
        KernelStream s = QuantKernel.stream();
        int32 n = this.burst();
        s.sync();
        int64 t0 = Clock.nanoTime();
        int32 k = 0;
        while (k < n) {
            sh.launch(this.y, this.slab, this.slabW, this.b, this.outDim, this.cols, this.rowsPerExpert);
            k = k + 1;
        }
        s.sync();
        return (Clock.nanoTime() - t0) / (int64) n;
    }
}
