package dev.cajeta.llm.io;

import cajeta.lang.String;
import dev.cajeta.llm.Diag;
import dev.cajeta.ml.kernels.tune.TileChoiceListener;

/**
 * The route tap's view of the kernel package's tile families: each settled choice
 * becomes a `tile-choice` record with the problem, the member, its margin over the
 * runner-up in per mille, and whether the store (1) or a timing here (0) decided it.
 * Every family llm lists borrows the one instance.
 */
public final class TileChoiceTap implements TileChoiceListener {
    static TileChoiceTap one;

    public TileChoiceTap() { return; }

    public static TileChoiceTap get() {
        if (TileChoiceTap.one == null) {
            TileChoiceTap.one #= heap TileChoiceTap();
        }
        return TileChoiceTap.one;
    }

    public void chose(String family, String kernel, int64 rows, int64 outDim, int64 cols,
            int32 marginPerMille, boolean cached, boolean timed) {
        Diag.emit("tile-choice", 0 - 1, kernel, rows, outDim, cols,
            (int64) marginPerMille, cached ? 1L : 0L, timed ? 1L : 0L);
    }
}
