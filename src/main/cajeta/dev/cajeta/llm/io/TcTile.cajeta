package dev.cajeta.llm.io;

import cajeta.collection.ArrayList;
import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.Device;
import cajeta.xpu.DeviceFacts;
import cajeta.xpu.KernelFacts;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.ShapeCandidate;
import cajeta.xpu.ShapeChoice;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeResult;
import cajeta.xpu.Shared;
import cajeta.xpu.TileOps;
import cajeta.xpu.Vector;
import cajeta.xpu.WaveVector;
import cajeta.xpu.XpuLaunchException;
import dev.cajeta.llm.Diag;

/**
 * The tensor-core prefill tile for Q4_K (xpu-kernel-adaptor 1.8.3): one
 * workgroup of eight waves computes a 128-token x 128-row output tile
 * over the whole K, reading the weight ONCE per workgroup into shared
 * memory as int8 straight from the packed nibbles, and the q8_K
 * activation stage into shared memory beside it.
 *
 * Why this and not the deq multi-wave GEMM it is shaped after
 * (WmmaKernel.q4kWmmaDeqMw8Kernel): that kernel loads its weight
 * fragments from a widened int8 copy in global memory, per wave, per
 * sub-block, so at 512 tokens every weight byte crosses L2 sixteen times
 * (four wave-rows a workgroup, four workgroups a column tile) and the
 * GEMM runs at the L2's rate, 100 TFLOPS on sm_89 where llama.cpp's MMQ
 * runs the same shape at 216 (test-backend-ops, 2026-10-01). Here the
 * eight waves share one staged tile, the weight bytes are the packed
 * ones (half the widened), and the widen launch is gone with its copy.
 * The arithmetic is the deq kernel's, verb for verb: the int8 mma over
 * each 32-k sub-block, the 6-bit scale folded as an integer
 * (scaledAccumI32), the min term as a rank-1 float per sub-block, the
 * block's d and the activation's scale applied once per 256-k block.
 *
 * The staging is the kernel's whole cost model, measured 2026-10-01: the
 * first cut staged the weight half-block with one byte load and two byte
 * stores per nibble pair (32 global byte loads and 64 bank-conflicted
 * shared byte stores a thread per half-block) and read its activation
 * fragments from global inside the mma loop, and it ran at 722 us for
 * 512x4096x14336 against the deq kernel's 610; dropping the staging
 * alone (wrong results, timing only) gave 519. So every byte now moves
 * sixteen at a time: a thread reads its column's 32 packed bytes as two
 * 16-byte vectors, splits the nibbles on 32-bit words (`w & 0x0F0F0F0F`
 * and `(w >> 4) & 0x0F0F0F0F`), and stores them as four 16-byte vectors;
 * the activation half-block is copied as 16-byte chunks the same way.
 * Both tiles are double-buffered and the next half's global reads are
 * issued into registers before the current half's mma loop, so the
 * loads' latency hides behind the tensor work and each half costs one
 * barrier. The panels (the token scales and sums, the column scales and
 * mins) are double-buffered too, per block, so a block boundary costs no
 * extra barrier.
 *
 * Shared memory: two 128x128 int8 half-block tiles for the weight and two
 * for the activation (stride 144 against bank conflicts, 72 KB) plus the
 * doubled panels (26 KB), 98 KB in all. That is over the 48 KB a launch
 * may take without opting in; the NVPTX lowering relocates the tiles into
 * the dynamic block and the runtime opts the function in. One workgroup a
 * multiprocessor, by shared memory and by the accumulators' registers.
 */
public final class TcTile {

    public TcTile() { return; }

    /** The Q4_K tile family's name in the shape store (xpu-tile-shape-selection §4). */
    public static final String Q4_FAMILY = "q4kTcTile";

    /** The default listed shape's registered kernel, the template's
     *  128x128 over 32x64 warp tiles: what the route's availability check
     *  and the census name. Every listed shape registers under its own
     *  `QkTile_*_q4kQ8`. */
    public static final String Q4_KERNEL = "QkTile_128_128_32_64_128_q4kQ8";

    // The family's listed shapes, one object per instantiation in
    // QkTile's @Instantiate list; a shape listed there and missing here is
    // what TcTileTest.q4kEveryListedShapeMatchesTheHost reports.
    static ArrayList<Q4TileShape> q4Shapes;
    static String shapeDir = "";
    // The recent choices, by problem: the store is asked once per problem.
    // A prefill layer cycles five problems (q, k/v, o, gate|up, down), so
    // a one-entry memo missed on every launch.
    static final int32 MEMO = 16;
    static int64[] memoRows;
    static int64[] memoOut;
    static int64[] memoCols;
    static int32[] memoIdx;
    static int32 memoNext = 0;
    // The choice the last launch used, for the route record.
    static int32 memoLast = -1;

    /** The shape store's directory (the engine's tune dir); "" keeps no cache. */
    public static void setShapeDir(String d) {
        TcTile.shapeDir #= d.clone();
        TcTile.forgetShapes();
    }

    /** Drop the remembered choice, so the next launch asks the store (and
     *  the family override) again. */
    public static void forgetShapes() {
        TcTile.memoRows #= heap int64[TcTile.MEMO];
        TcTile.memoOut #= heap int64[TcTile.MEMO];
        TcTile.memoCols #= heap int64[TcTile.MEMO];
        TcTile.memoIdx #= heap int32[TcTile.MEMO];
        int32 i = 0;
        while (i < TcTile.MEMO) {
            TcTile.memoRows[i] = -1L;
            TcTile.memoIdx[i] = -1;
            i = i + 1;
        }
        TcTile.memoNext = 0;
        TcTile.memoLast = -1;
    }

    /** Warm the family's choice at a problem outside any timing bracket:
     *  a cold choice times every listed shape, which a caller bracketing
     *  its own launch would read as the launch. */
    public static void prewarmQ4(KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        TcTile.q4ChooseIndex(packed, xp, rows, outDim, cols);
    }

    /** The registered kernel of the shape the last Q4_K launch ran, or ""
     *  before any; what the route record names. */
    public static #String lastQ4Kernel() {
        if (TcTile.memoLast < 0) { return ""; }
        return TcTile.shapes().get(TcTile.memoLast).kernel();
    }

    static ArrayList<Q4TileShape> shapes() {
        if (TcTile.q4Shapes == null) {
            TcTile.q4Shapes #= heap ArrayList<Q4TileShape>();
            // The template's 128x128 instantiation is the default member.
            // It assembles to the hand-written kernel's SASS exactly (the
            // rank-1 phase loads the four column-group vectors, then the
            // row factor, as that kernel did) and paces within 1% of it at
            // every engine problem (TilePace, sm_89, 2026-10-08), so the
            // hand-written kernel is gone (xpu-tile-shape-selection 4.7.2.3).
            TcTile.q4Shapes.add(#heap QkTile<128, 128, 32, 64, 128>());
            TcTile.q4Shapes.add(#heap QkTile<64, 64, 32, 32, 128>());
        }
        return TcTile.q4Shapes;
    }

    /** The index in {@link #shapes} of the shape registered as `name`, or -1. */
    static int32 shapeIndex(String name) {
        ArrayList<Q4TileShape> list = TcTile.shapes();
        int32 n = (int32) list.count();
        int32 i = 0;
        while (i < n) {
            String k #= list.get(i).kernel();
            if (k.equals(name)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /** Whether some listed shape covers the problem: tokens and rows on
     *  its grid, columns a whole number of 256-element blocks. */
    public static boolean fits(int64 rows, int64 outDim, int64 cols) {
        ArrayList<Q4TileShape> list = TcTile.shapes();
        int32 n = (int32) list.count();
        int32 i = 0;
        while (i < n) {
            if (list.get(i).fits(rows, outDim, cols)) { return true; }
            i = i + 1;
        }
        return false;
    }

    /**
     * The shape the family runs at this problem (xpu-tile-shape-selection
     * §3, §4, §6): the listed shapes that fit go through the feasibility
     * filter at the device's facts, and the choice times the survivors at
     * first use and remembers the winner under the device, the build and
     * the exact problem. An override on the family (`ShapeChoice.
     * setShapeOverride`) wins. No survivor is a refusal by name.
     */
    static int32 q4ChooseIndex(KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        ArrayList<Q4TileShape> list = TcTile.shapes();
        if (TcTile.memoRows == null) { TcTile.forgetShapes(); }
        int32 m = 0;
        while (m < TcTile.MEMO) {
            if (TcTile.memoIdx[m] >= 0 && TcTile.memoRows[m] == rows
                    && TcTile.memoOut[m] == outDim && TcTile.memoCols[m] == cols) {
                TcTile.memoLast = TcTile.memoIdx[m];
                return TcTile.memoLast;
            }
            m = m + 1;
        }
        ShapeFilter f #= heap ShapeFilter(TcTile.Q4_FAMILY, DeviceFacts.current(), rows, outDim, cols);
        int32 n = (int32) list.count();
        int32 i = 0;
        while (i < n) {
            Q4TileShape sh = list.get(i);
            if (sh.fits(rows, outDim, cols)) {
                String kn #= sh.kernel();
                KernelFacts kf #= KernelFacts.measured(kn, 0);
                f.consider(#heap ShapeCandidate(#kn, sh.tileM(), sh.tileN(), sh.threads(), 256, 8), #kf);
            }
            i = i + 1;
        }
        if (f.survivorCount() == 0) {
            String why #= f.refusal();
            throw heap XpuLaunchException(#why);
        }
        Q4ShapeProbe probe #= heap Q4ShapeProbe(f, packed, xp, rows, outDim, cols);
        ShapeResult r #= ShapeChoice.choose(TcTile.shapeDir, f, probe);
        if (r.survivor < 0) {
            String why #= r.refusal.clone();
            throw heap XpuLaunchException(#why);
        }
        // The choice record: the problem, the shape, its margin over the
        // runner-up in per mille, and whether it came from the store (1)
        // or was timed here (0). The route tap prints it.
        Diag.emit("tile-choice", 0 - 1, r.kernel, rows, outDim, cols,
            (int64) r.marginPerMille, r.fromCache ? 1L : 0L, r.timed ? 1L : 0L);
        int32 idx = TcTile.shapeIndex(r.kernel);
        if (idx < 0) {
            String why #= "the shape choice named " + r.kernel
                + ", which the Q4_K tile family does not list";
            throw heap XpuLaunchException(#why);
        }
        int32 slot = TcTile.memoNext;
        TcTile.memoNext = (TcTile.memoNext + 1) % TcTile.MEMO;
        TcTile.memoRows[slot] = rows;
        TcTile.memoOut[slot] = outDim;
        TcTile.memoCols[slot] = cols;
        TcTile.memoIdx[slot] = idx;
        TcTile.memoLast = idx;
        return idx;
    }

    /** Whether the Q6_K tile covers the shape: as {@link #fits}, and the
     *  resident (split) row's payload blocks 16-byte aligned, which the
     *  dword-padded scale prefix gives when the block count is a multiple
     *  of eight (every hidden size that is a multiple of 2048). */
    public static boolean fits6(int64 rows, int64 outDim, int64 cols) {
        return TcTile.fits(rows, outDim, cols) && (cols / 256L) % 8L == 0L;
    }

    /**
     * The Q6_K twin, over the RESIDENT (split) payload: a row is its
     * blocks' f16 scales back to back (dword-padded), then 208-byte
     * payloads of { ql[128], qh[64], scales[16] }. Same tiles, same
     * staging pipeline; what differs is the widen (a 6-bit value is a ql
     * nibble and two qh bits, biased by 32, assembled and sign-extended on
     * 32-bit words) and the scale granularity: Q6_K scales every 16
     * elements, so the integer fold runs per mma rather than per two, and
     * there is no min term. The scale panel holds a block's sixteen signed
     * scales per column.
     */
    @Occupancy(maxThreads = 256)
    @Kernel @FastMath
    @Unlowered(backend = {"amdgpu", "vulkan"}, tracked = "xpu-kernel-adaptor 1.8.3")
    public static void q6kQ8TcTileKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, uint32 rows,
            uint32 outDim, uint32 tilesN8, int64 blocksPerRow,
            KernelBuffer<float32> part, uint32 splits, uint32 accum) {
        Shared<int8> aT = shared int8[36864];
        Shared<int8> bT = shared int8[36864];
        Shared<float32> xsAll = shared float32[256];
        Shared<float32> dAll = shared float32[256];
        // scAll[buf*2048 + j*128 + col]: the block's sixteen scales per
        // column, scale-major so a warp's slice over sixteen columns is a
        // run of consecutive words. Column-major (col*16 + j) put the four
        // distinct columns a fragment reads sixteen words apart, one bank,
        // a 4-way conflict on each of the sixteen loads a k-step makes.
        Shared<int32> scAll = shared int32[4096];

        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wid = tid / 32;
        uint32 lane16 = lane % 16;
        uint32 wg = KernelThread.globalIdX() / 256;
        // Split-K: workgroups `tile * splits + split` share a tile, each
        // over its own run of blocksPerRow / splits blocks.
        uint32 tile = wg / splits;
        uint32 split = wg % splits;
        int64 nbs = blocksPerRow / (int64) splits;
        int64 bOff = (int64) split * nbs;
        uint32 tileT = tile / tilesN8;
        uint32 tileI8 = tile % tilesN8;
        uint32 t0 = tileT * 128;
        uint32 i0 = tileI8 * 128;
        uint32 wr = wid / 2;
        uint32 wc = wid % 2;
        uint32 tw = t0 + 32 * wr;
        uint32 cw = tileI8 * 128 + 64 * wc;
        uint32 sCol = tid >> 1;
        uint32 sH = tid & 1;
        int32 shq = 2 * (int32) sH;
        if (t0 < rows && i0 < outDim) {
            int64 prefix = ((blocksPerRow * 2L + 3L) / 4L) * 4L;
            int64 rowBytes = prefix + blocksPerRow * 208L;
            int64 xRowBytes = blocksPerRow * 320L;
            // This thread's column: its scale prefix and its first payload.
            int64 sRow = (int64) (i0 + sCol) * rowBytes + bOff * 2L;
            int64 sRo = (int64) (i0 + sCol) * rowBytes + prefix + bOff * 208L;
            int64 sXb = (int64) (t0 + sCol) * xRowBytes + bOff * 320L;
            uint32 aRow0 = tid >> 3;
            uint32 aPart = tid & 7;
            int64 aSrc0 = (int64) (t0 + aRow0) * xRowBytes + (int64) (16 * aPart)
                + bOff * 320L;
            int64 xr32 = 32L * xRowBytes;
            uint32 aDst0 = aRow0 * 144 + 16 * aPart;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,0> maB;
            CooperativeMatrix<int8,16,16,1> mbA;
            CooperativeMatrix<int8,16,16,1> mbB;
            CooperativeMatrix<int8,16,16,1> mbC;
            CooperativeMatrix<int8,16,16,1> mbD;
            CooperativeMatrix<int32,16,16,2> mc0;
            CooperativeMatrix<int32,16,16,2> mc1;
            CooperativeMatrix<int32,16,16,2> mc2;
            CooperativeMatrix<int32,16,16,2> mc3;
            CooperativeMatrix<int32,16,16,2> iacc0;
            CooperativeMatrix<int32,16,16,2> iacc1;
            CooperativeMatrix<int32,16,16,2> iacc2;
            CooperativeMatrix<int32,16,16,2> iacc3;
            CooperativeMatrix<int32,16,16,2> iacc4;
            CooperativeMatrix<int32,16,16,2> iacc5;
            CooperativeMatrix<int32,16,16,2> iacc6;
            CooperativeMatrix<int32,16,16,2> iacc7;
            CooperativeMatrix<float32,16,16,2> facc0;
            CooperativeMatrix<float32,16,16,2> facc1;
            CooperativeMatrix<float32,16,16,2> facc2;
            CooperativeMatrix<float32,16,16,2> facc3;
            CooperativeMatrix<float32,16,16,2> facc4;
            CooperativeMatrix<float32,16,16,2> facc5;
            CooperativeMatrix<float32,16,16,2> facc6;
            CooperativeMatrix<float32,16,16,2> facc7;
            // ACCUMULATE (1.8.3): `y += W x`, the residual add folded in.
            // Unsplit, the accumulators start from y's tile; split, they
            // start at zero and the fixup adds the partials to y.
            if (accum != 0 && splits == 1) {
                facc0.load(y, (uint32) ((int64) tw * (int64) outDim + (int64) cw), 0, outDim);
                facc1.load(y, (uint32) ((int64) tw * (int64) outDim + (int64) (cw + 16)), 0, outDim);
                facc2.load(y, (uint32) ((int64) tw * (int64) outDim + (int64) (cw + 32)), 0, outDim);
                facc3.load(y, (uint32) ((int64) tw * (int64) outDim + (int64) (cw + 48)), 0, outDim);
                facc4.load(y, (uint32) ((int64) (tw + 16) * (int64) outDim + (int64) cw), 0, outDim);
                facc5.load(y, (uint32) ((int64) (tw + 16) * (int64) outDim + (int64) (cw + 16)), 0, outDim);
                facc6.load(y, (uint32) ((int64) (tw + 16) * (int64) outDim + (int64) (cw + 32)), 0, outDim);
                facc7.load(y, (uint32) ((int64) (tw + 16) * (int64) outDim + (int64) (cw + 48)), 0, outDim);
            } else {
                facc0.splat(0.0f);
                facc1.splat(0.0f);
                facc2.splat(0.0f);
                facc3.splat(0.0f);
                facc4.splat(0.0f);
                facc5.splat(0.0f);
                facc6.splat(0.0f);
                facc7.splat(0.0f);
            }

            // Prefetch: the activation chunks, this thread's 32 ql bytes
            // (bytes 32sH.. of the half's 64) and the half's 32 qh bytes;
            // at a block boundary the column's sixteen scales (even
            // threads) or the token's scale (odd).
            Vector<int8,16> pa0 = xp.vload<16>(aSrc0);
            Vector<int8,16> pa1 = xp.vload<16>(aSrc0 + xr32);
            Vector<int8,16> pa2 = xp.vload<16>(aSrc0 + xr32 + xr32);
            Vector<int8,16> pa3 = xp.vload<16>(aSrc0 + xr32 + xr32 + xr32);
            Vector<int8,16> pl0 = packed.vload<16>(sRo + (int64) (32 * sH));
            Vector<int8,16> pl1 = packed.vload<16>(sRo + (int64) (32 * sH) + 16L);
            Vector<int8,16> ph0 = packed.vload<16>(sRo + 128L);
            Vector<int8,16> ph1 = packed.vload<16>(sRo + 144L);
            Vector<int8,16> psc = packed.vload<16>(sRo + 192L);
            Vector<int8,4> px = xp.vload<4>(sXb + 288L);
            int32 pd = ((int32) packed[sRow] & 255)
                | (((int32) packed[sRow + 1L] & 255) << 8);

            uint32 nh = (uint32) nbs * 2;
            uint32 hh = 0;
            while (hh < nh) {
                uint32 H = hh & 1;
                uint32 buf = H * 18432;
                uint32 pOff = (hh >> 1) & 1;
                int64 aDst = (int64) (buf + aDst0);
                aT.vstore(aDst, pa0);
                aT.vstore(aDst + 4608L, pa1);
                aT.vstore(aDst + 9216L, pa2);
                aT.vstore(aDst + 13824L, pa3);
                {
                    // k 32sH..32sH+31 from the low nibbles with qh bits
                    // 2sH..2sH+1, k 64+32sH.. from the high nibbles with
                    // bits 2sH+4..; both biased by 32 (Quant.q6kBlock).
                    int64 dst = (int64) (buf + sCol * 144 + 32 * sH);
                    Vector<int32,4> l0 = pl0.asWords();
                    Vector<int32,4> l1 = pl1.asWords();
                    Vector<int32,4> h0 = ph0.asWords() >> shq;
                    Vector<int32,4> h1 = ph1.asWords() >> shq;
                    Vector<int32,4> v0 = ((l0 & 252645135) | ((h0 & 50529027) << 4)) ^ 538976288;
                    Vector<int32,4> v1 = ((l1 & 252645135) | ((h1 & 50529027) << 4)) ^ 538976288;
                    Vector<int32,4> v2 = (((l0 >> 4) & 252645135) | (((h0 >> 4) & 50529027) << 4)) ^ 538976288;
                    Vector<int32,4> v3 = (((l1 >> 4) & 252645135) | (((h1 >> 4) & 50529027) << 4)) ^ 538976288;
                    v0 = v0 | ((v0 & 538976288) << 1) | ((v0 & 538976288) << 2);
                    v1 = v1 | ((v1 & 538976288) << 1) | ((v1 & 538976288) << 2);
                    v2 = v2 | ((v2 & 538976288) << 1) | ((v2 & 538976288) << 2);
                    v3 = v3 | ((v3 & 538976288) << 1) | ((v3 & 538976288) << 2);
                    bT.vstore(dst, v0.asBytes());
                    bT.vstore(dst + 16L, v1.asBytes());
                    bT.vstore(dst + 64L, v2.asBytes());
                    bT.vstore(dst + 80L, v3.asBytes());
                }
                if (H == 0) {
                    if (sH == 0) {
                        dAll[pOff * 128 + sCol] = GgufFile.halfBitsToF32(pd);
                        Vector<int32,4> sw = psc.asWords();
                        uint32 cb = pOff * 2048 + sCol;
                        int32 s0 = sw[0];
                        int32 s1 = sw[1];
                        int32 s2 = sw[2];
                        int32 s3 = sw[3];
                        scAll[cb] = (s0 << 24) >> 24;
                        scAll[cb + 128] = (s0 << 16) >> 24;
                        scAll[cb + 256] = (s0 << 8) >> 24;
                        scAll[cb + 384] = s0 >> 24;
                        scAll[cb + 512] = (s1 << 24) >> 24;
                        scAll[cb + 640] = (s1 << 16) >> 24;
                        scAll[cb + 768] = (s1 << 8) >> 24;
                        scAll[cb + 896] = s1 >> 24;
                        scAll[cb + 1024] = (s2 << 24) >> 24;
                        scAll[cb + 1152] = (s2 << 16) >> 24;
                        scAll[cb + 1280] = (s2 << 8) >> 24;
                        scAll[cb + 1408] = s2 >> 24;
                        scAll[cb + 1536] = (s3 << 24) >> 24;
                        scAll[cb + 1664] = (s3 << 16) >> 24;
                        scAll[cb + 1792] = (s3 << 8) >> 24;
                        scAll[cb + 1920] = s3 >> 24;
                    } else {
                        Vector<int32,1> xw = px.asWords();
                        xsAll[pOff * 128 + sCol] = Cajeta.bitsToF32(xw[0]);
                    }
                }
                if (hh + 1 < nh) {
                    int64 nb = (int64) ((hh + 1) >> 1);
                    uint32 nH = (hh + 1) & 1;
                    int64 aS = aSrc0 + nb * 320L + (int64) (128 * nH);
                    pa0 = xp.vload<16>(aS);
                    aS = aS + xr32;
                    pa1 = xp.vload<16>(aS);
                    aS = aS + xr32;
                    pa2 = xp.vload<16>(aS);
                    aS = aS + xr32;
                    pa3 = xp.vload<16>(aS);
                    int64 bS = sRo + nb * 208L;
                    pl0 = packed.vload<16>(bS + (int64) (64 * nH + 32 * sH));
                    pl1 = packed.vload<16>(bS + (int64) (64 * nH + 32 * sH) + 16L);
                    ph0 = packed.vload<16>(bS + 128L + (int64) (32 * nH));
                    ph1 = packed.vload<16>(bS + 144L + (int64) (32 * nH));
                    if (nH == 0) {
                        if (sH == 0) {
                            psc = packed.vload<16>(bS + 192L);
                            pd = ((int32) packed[sRow + nb * 2L] & 255)
                                | (((int32) packed[sRow + nb * 2L + 1L] & 255) << 8);
                        } else {
                            px = xp.vload<4>(sXb + nb * 320L + 288L);
                        }
                    }
                }
                Barrier.workgroup();

                if (H == 0) {
                    iacc0.splat(0);
                    iacc1.splat(0);
                    iacc2.splat(0);
                    iacc3.splat(0);
                    iacc4.splat(0);
                    iacc5.splat(0);
                    iacc6.splat(0);
                    iacc7.splat(0);
                }
                uint32 cBase = pOff * 2048 + 64 * wc;
                uint32 aBuf = buf + (32 * wr) * 144;
                uint32 bBuf = buf + (64 * wc) * 144;
                uint32 jj = 0;
                while (jj < 8) {
                    uint32 sj = cBase + (8 * H + jj) * 128;
                    uint32 kk = 16 * jj;
                    mbA.load(bT, bBuf + kk, 1, 144);
                    mbB.load(bT, bBuf + 16 * 144 + kk, 1, 144);
                    mbC.load(bT, bBuf + 32 * 144 + kk, 1, 144);
                    mbD.load(bT, bBuf + 48 * 144 + kk, 1, 144);
                    ma.load(aT, aBuf + kk, 0, 144);
                    mc0.splat(0);
                    mc1.splat(0);
                    mc2.splat(0);
                    mc3.splat(0);
                    mc0.mma(ma, mbA);
                    mc1.mma(ma, mbB);
                    mc2.mma(ma, mbC);
                    mc3.mma(ma, mbD);
                    TileOps.scaledAccumI32(mc0, iacc0, scAll, sj, 1);
                    TileOps.scaledAccumI32(mc1, iacc1, scAll, sj + 16, 1);
                    TileOps.scaledAccumI32(mc2, iacc2, scAll, sj + 32, 1);
                    TileOps.scaledAccumI32(mc3, iacc3, scAll, sj + 48, 1);
                    maB.load(aT, aBuf + 16 * 144 + kk, 0, 144);
                    mc0.splat(0);
                    mc1.splat(0);
                    mc2.splat(0);
                    mc3.splat(0);
                    mc0.mma(maB, mbA);
                    mc1.mma(maB, mbB);
                    mc2.mma(maB, mbC);
                    mc3.mma(maB, mbD);
                    TileOps.scaledAccumI32(mc0, iacc4, scAll, sj, 1);
                    TileOps.scaledAccumI32(mc1, iacc5, scAll, sj + 16, 1);
                    TileOps.scaledAccumI32(mc2, iacc6, scAll, sj + 32, 1);
                    TileOps.scaledAccumI32(mc3, iacc7, scAll, sj + 48, 1);
                    jj = jj + 1;
                }
                if (H == 1) {
                    uint32 dbase = pOff * 128 + 64 * wc;
                    uint32 xbase = pOff * 128 + 32 * wr;
                    WaveVector<float32, 16> dcv0 = WaveVector.ofSlice(dAll, dbase, 1);
                    WaveVector<float32, 16> dcv1 = WaveVector.ofSlice(dAll, dbase + 16, 1);
                    WaveVector<float32, 16> dcv2 = WaveVector.ofSlice(dAll, dbase + 32, 1);
                    WaveVector<float32, 16> dcv3 = WaveVector.ofSlice(dAll, dbase + 48, 1);
                    iacc0.scaledAccumInto(facc0, xsAll[xbase], dcv0);
                    iacc1.scaledAccumInto(facc1, xsAll[xbase], dcv1);
                    iacc2.scaledAccumInto(facc2, xsAll[xbase], dcv2);
                    iacc3.scaledAccumInto(facc3, xsAll[xbase], dcv3);
                    iacc4.scaledAccumInto(facc4, xsAll[xbase + 16], dcv0);
                    iacc5.scaledAccumInto(facc5, xsAll[xbase + 16], dcv1);
                    iacc6.scaledAccumInto(facc6, xsAll[xbase + 16], dcv2);
                    iacc7.scaledAccumInto(facc7, xsAll[xbase + 16], dcv3);
                }
                hh = hh + 1;
            }

            if (splits > 1) {
                // SPLIT-K: this workgroup's partial tile goes to its slot of
                // `part` (row-major 128x128); the fixup launch sums the
                // slots into y. A fold in this kernel (the last arriver
                // summing the others' slots) was measured 2026-10-01 to
                // cost the unsplit shapes 5% (289 to 305 us at
                // 512x4096x14336): the accumulators read under a loop
                // after the main loop changed the allocator's hand at
                // 255 registers. The partial store alone does not.
                uint32 pbase = (tile * splits + split) * 16384;
                uint32 pw = (32 * wr) * 128 + 64 * wc;
                facc0.store(part, pbase + pw, 0, 128);
                facc1.store(part, pbase + pw + 16, 0, 128);
                facc2.store(part, pbase + pw + 32, 0, 128);
                facc3.store(part, pbase + pw + 48, 0, 128);
                facc4.store(part, pbase + pw + 2048, 0, 128);
                facc5.store(part, pbase + pw + 2048 + 16, 0, 128);
                facc6.store(part, pbase + pw + 2048 + 32, 0, 128);
                facc7.store(part, pbase + pw + 2048 + 48, 0, 128);
                return;
            }
            facc0.store(y, (uint32) ((int64) tw * (int64) outDim
                + (int64) cw), 0, outDim);
            facc1.store(y, (uint32) ((int64) tw * (int64) outDim
                + (int64) (cw + 16)), 0, outDim);
            facc2.store(y, (uint32) ((int64) tw * (int64) outDim
                + (int64) (cw + 32)), 0, outDim);
            facc3.store(y, (uint32) ((int64) tw * (int64) outDim
                + (int64) (cw + 48)), 0, outDim);
            facc4.store(y, (uint32) ((int64) (tw + 16) * (int64) outDim
                + (int64) cw), 0, outDim);
            facc5.store(y, (uint32) ((int64) (tw + 16) * (int64) outDim
                + (int64) (cw + 16)), 0, outDim);
            facc6.store(y, (uint32) ((int64) (tw + 16) * (int64) outDim
                + (int64) (cw + 32)), 0, outDim);
            facc7.store(y, (uint32) ((int64) (tw + 16) * (int64) outDim
                + (int64) (cw + 48)), 0, outDim);
        }
    }

    /** The Q6_K GEMM in one launch over the resident (split) payload;
     *  the caller has checked {@link #fits6}. */
    public static void q6kQ8TcTileLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, int64 rows,
            int64 outDim, int64 cols) {
        TcTile.q6kQ8TcTileLaunchAs(y, packed, xp, rows, outDim, cols, (uint32) 0);
        return;
    }

    /** `y += W x`: the launch accumulates into `y`, so a residual add
     *  after the GEMM is the GEMM's own epilogue. */
    public static void q6kQ8TcTileAccumNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, int64 rows,
            int64 outDim, int64 cols) {
        TcTile.q6kQ8TcTileLaunchAs(y, packed, xp, rows, outDim, cols, (uint32) 1);
        return;
    }

    static void q6kQ8TcTileLaunchAs(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, int64 rows,
            int64 outDim, int64 cols, uint32 accum) {
        int64 tilesM8 = rows / 128L;
        int64 tilesN8 = outDim / 128L;
        int64 tiles = tilesM8 * tilesN8;
        int64 nb = cols / 256L;
        int64 sp = TcTile.splitsFor(tiles, nb);
        TcTile.ensureScratch(tiles, sp, 16384L);
        KernelStream s = QuantKernel.stream();
        q6kQ8TcTileKernel.launch(s,
            grid: [(uint32) (tiles * sp)], block: [256])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) tilesN8, nb, TcTile.part, (uint32) sp, accum);
        TcTile.fixupLaunch(y, rows, outDim, tilesN8, sp, accum, 128L, 128L);
        return;
    }

    /** The split-K fixup: y[t][c] is the sum over the splits of their
     *  partial tiles, one thread an element. */
    @Kernel
    public static void tcSplitFixupKernel(KernelBuffer<float32> y,
            KernelBuffer<float32> part, uint32 rows, uint32 outDim,
            uint32 tilesN8, uint32 splits, uint32 accum, uint32 tileShift) {
        // The tile is square and a power of two (every listed shape), so
        // its edge arrives as a shift: four runtime divisions an element
        // here cost the pp512 prefill about a millisecond (2026-10-08).
        uint32 e = KernelThread.globalIdX();
        uint32 total = rows * outDim;
        if (e < total) {
            uint32 t = e / outDim;
            uint32 c = e - t * outDim;
            uint32 mask = (1 << tileShift) - 1;
            uint32 tile = (t >> tileShift) * tilesN8 + (c >> tileShift);
            int64 slot = (int64) (1 << (2 * tileShift));
            int64 at = (int64) (tile * splits) * slot
                + (int64) (((t & mask) << tileShift) + (c & mask));
            float32 acc = 0.0f;
            if (accum != 0) { acc = y[(int64) e]; }
            uint32 sp = 0;
            while (sp < splits) {
                acc = acc + part[at + (int64) sp * slot];
                sp = sp + 1;
            }
            y[(int64) e] = acc;
        }
    }

    static void fixupLaunch(KernelBuffer<float32> y, int64 rows, int64 outDim,
            int64 tilesN8, int64 splits, uint32 accum, int64 tileM, int64 tileN) {
        if (splits <= 1L) { return; }
        TcTile.fixupLaunchAs(y, TcTile.part, rows, outDim, tilesN8, splits, accum, tileM, tileN);
        return;
    }

    /** The fixup over a caller's partials buffer: `splits` row-major
     *  128x128 tiles per output tile, summed into y. Public so the fixup
     *  is checked on its own where the tiles are not usable. */
    public static void fixupLaunchOver(KernelBuffer<float32> y,
            KernelBuffer<float32> partials, int64 rows, int64 outDim,
            int64 tilesN8, int64 splits) {
        TcTile.fixupLaunchAs(y, partials, rows, outDim, tilesN8, splits, (uint32) 0, 128L, 128L);
        return;
    }

    static void fixupLaunchAs(KernelBuffer<float32> y,
            KernelBuffer<float32> partials, int64 rows, int64 outDim,
            int64 tilesN8, int64 splits, uint32 accum, int64 tileM, int64 tileN) {
        int64 total = rows * outDim;
        KernelStream s = QuantKernel.stream();
        tcSplitFixupKernel.launch(s, grid: [(uint32) ((total + 255L) / 256L)],
            block: [256])
            (y, partials, (uint32) rows, (uint32) outDim, (uint32) tilesN8,
             (uint32) splits, accum, TcTile.tileShiftOf(tileM, tileN));
        return;
    }

    /** log2 of the tile edge; the fixup wants a square power-of-two tile,
     *  which every listed shape is (QkTile's @Requires pins TM == TN). */
    static uint32 tileShiftOf(int64 tileM, int64 tileN) {
        if (tileM != tileN || (tileM & (tileM - 1L)) != 0L) {
            String why #= "the split fixup wants a square power-of-two tile, not "
                + tileM + "x" + tileN;
            throw heap XpuLaunchException(#why);
        }
        uint32 sh = 0;
        while ((1L << sh) < tileM) { sh = sh + 1; }
        return sh;
    }

    // ── split-K ─────────────────────────────────────────────────────
    // A 128x128 tile grid narrower than the part leaves multiprocessors
    // idle: the 1024x4096 projections at 512 tokens are 32 workgroups
    // for 128 SMs, and measured 81 us against llama.cpp's 31 (which
    // balances with stream-K). Splitting K across workgroups fills the
    // part at the cost of one partial tile per split (64 KB, L2-resident
    // at these sizes) and a fixup launch that sums them: 45 us.
    static KernelBuffer<float32> part;
    static int64 partCap;
    static int64 splitOverride = 0L;

    /** Force the split count (the parity leg's `--splitk`); 0 measures. */
    public static void setSplitOverride(int64 v) { TcTile.splitOverride = v; }

    /** The split count for `tiles` workgroup tiles over `nb` blocks: the
     *  smallest divisor of `nb` (at most 8) that fills the part's
     *  multiprocessors, 1 when the grid already does. */
    public static int64 splitsFor(int64 tiles, int64 nb) {
        if (TcTile.splitOverride > 0L) {
            if (nb % TcTile.splitOverride == 0L) { return TcTile.splitOverride; }
            return 1L;
        }
        int64 sms = (int64) Device.multiprocessorCount();
        if (sms <= 0L) { sms = 128L; }
        if (tiles >= sms) { return 1L; }
        int64 sp = 1L;
        int64 cand = 2L;
        while (cand <= 8L) {
            if (nb % cand == 0L) {
                sp = cand;
                if (tiles * cand >= sms) { return cand; }
            }
            cand = cand + 1L;
        }
        return sp;
    }

    /** The partial tiles for a split launch, grown as needed (an in-flight
     *  launch may still read the old buffer, so the stream drains first). */
    static void ensureScratch(int64 tiles, int64 splits, int64 slot) {
        int64 need = splits > 1L ? tiles * splits * slot : 1L;
        if (TcTile.part == null || TcTile.partCap < need) {
            QuantKernel.stream().sync();
            TcTile.part #= heap KernelBuffer<float32>((uint64) need);
            TcTile.partCap = need;
        }
        return;
    }

    /** The whole GEMM in one launch: `y[token][row] = W[row] . x[token]`
     *  over `rows` tokens of the q8_K stage `xp` and `outDim` rows of the
     *  packed Q4_K weight; the caller has checked {@link #fits}. */
    public static void q4kQ8TcTileLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, int64 rows,
            int64 outDim, int64 cols) {
        TcTile.q4kQ8TcTileLaunchAs(y, packed, xp, rows, outDim, cols, (uint32) 0);
        return;
    }

    /** `y += W x`: the launch accumulates into `y`, so a residual add
     *  after the GEMM is the GEMM's own epilogue. */
    public static void q4kQ8TcTileAccumNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, int64 rows,
            int64 outDim, int64 cols) {
        TcTile.q4kQ8TcTileLaunchAs(y, packed, xp, rows, outDim, cols, (uint32) 1);
        return;
    }

    static void q4kQ8TcTileLaunchAs(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, int64 rows,
            int64 outDim, int64 cols, uint32 accum) {
        int32 idx = TcTile.q4ChooseIndex(packed, xp, rows, outDim, cols);
        Q4TileShape sh = TcTile.shapes().get(idx);
        int64 tm = (int64) sh.tileM();
        int64 tn = (int64) sh.tileN();
        int64 tilesN = outDim / tn;
        int64 tiles = (rows / tm) * tilesN;
        int64 nb = cols / 256L;
        int64 sp = TcTile.splitsFor(tiles, nb);
        TcTile.ensureScratch(tiles, sp, tm * tn);
        sh.launchAs(y, packed, xp, rows, outDim, cols, TcTile.part, sp, accum);
        TcTile.fixupLaunch(y, rows, outDim, tilesN, sp, accum, tm, tn);
        return;
    }
}
