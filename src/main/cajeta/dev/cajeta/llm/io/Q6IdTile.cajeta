package dev.cajeta.llm.io;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.TileOps;
import cajeta.xpu.Vector;
import cajeta.xpu.WaveVector;

/**
 * The Q6_K MoE Id GEMM as a family (cajeta-llm 15.2.15.4.2): the dense
 * Q6_K tensor-core tile ({@code Q6Tile}) over the expert chunk maps, as
 * {@code Q5IdTile} is Q5Tile's. A workgroup of {@code 2 * TN} threads
 * computes one TM-row chunk of a map entry against a TN-row tile of the
 * entry's expert: both operands staged in shared memory a half block
 * ahead of the mma, the six-bit widen at staging, the per-16 scale fold
 * per mma. The expert rows are the resident split payload Q6Tile reads (a
 * row's f16 scales, dword-padded, then 208-byte payloads), one expert's
 * rows after another. The member reads the chunk map of its own row count
 * (TM) and the count from that map's meta slot; the rows of a chunk past
 * the entry's end are computed and never stored.
 *
 * Before it a Q6_K bank's prefill GEMM was the multi-wave kernel
 * ({@code q6kWmmaIdMwKernel}), 483 us a down launch on
 * Qwen3-Coder-30B-A3B at a 512-token prefill, the design the Q5_K tile
 * replaced at half the time (IdGemmProbe, 2026-10-24).
 */
@Instantiate({Q6IdTile<64, 64, 32, 32, 128>, Q6IdTile<128, 128, 32, 64, 128>})
@Requires(TM == TN && (TM == 64 || TM == 128) && TM % WM == 0 && TN % WN == 0 && WM % 16 == 0
    && WN % 16 == 0 && (TM / WM) * (TN / WN) * 16 == TN && KS == 128)
public final class Q6IdTile<uint32 TM, uint32 TN, uint32 WM, uint32 WN, uint32 KS>
        implements IdShape {

    public Q6IdTile() { return; }

    public #String kernel() {
        return "Q6IdTile_" + TM + "_" + TN + "_" + WM + "_" + WN + "_" + KS + "_q6kId";
    }
    public int32 tileM() { return (int32) TM; }
    public int32 tileN() { return (int32) TN; }
    public int32 threads() { return (int32) (2 * TN); }
    public int32 chunkRows() { return (int32) TM; }

    /** Rows on the TN grid, whole 256-value blocks, a non-empty batch. */
    public boolean fits(int64 np, int64 outDim, int64 cols) {
        return np > 0L && outDim % (int64) TN == 0L && cols % 256L == 0L;
    }

    /** One launch over the batch's map of TM rows on the quant stream. */
    public void launch(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int32> slabW, IdBatch b, int64 outDim, int64 cols,
            int64 rowsPerExpert) {
        if (TM == 128) {
            this.launchMaps(y, slab, b.xp, b.e128, b.t128, b.m128, b.meta, b.n128Max,
                outDim, cols, rowsPerExpert);
            return;
        }
        this.launchMaps(y, slab, b.xp, b.e64, b.t64, b.m64, b.meta, b.n64Max,
            outDim, cols, rowsPerExpert);
        return;
    }

    /** One launch over a TM-row chunk map; `nChunksMax` bounds the grid and
     *  the map's meta slot holds the count. Requires outDim % TN == 0. */
    public void launchMaps(KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int8> xp, KernelBuffer<int32> mapE, KernelBuffer<int32> mapT0,
            KernelBuffer<int32> mapM1, KernelBuffer<int32> meta, int64 nChunksMax,
            int64 outDim, int64 cols, int64 rowsPerExpert) {
        int64 tilesN = outDim / (int64) TN;
        KernelStream s = QuantKernel.stream();
        q6kId.launch(s, grid: [(uint32) (nChunksMax * tilesN)], block: [2 * TN])
            (y, slab, xp, mapE, mapT0, mapM1, meta, (uint32) outDim, (uint32) tilesN,
             cols / 256L, rowsPerExpert);
        return;
    }

    // As Q6Tile.q6kQ8: a literal block of 2 * TN, single-buffered.
    @Occupancy(maxThreads = 2 * TN)
    @Kernel @FastMath
    @Unlowered(backend = {"vulkan"}, tracked = "xpu-tile-shape-selection 4.9.1", mayLower = true)
    public static void q6kId(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            KernelBuffer<int32> mapE, KernelBuffer<int32> mapT0,
            KernelBuffer<int32> mapM1, KernelBuffer<int32> meta,
            uint32 outDim, uint32 tilesN, int64 blocksPerRow, int64 rowsPerExpert) {
        Shared<int8> aT = shared int8[TM * 144];
        Shared<int8> bT = shared int8[TN * 144];
        Shared<float32> xsAll = shared float32[TM];
        Shared<float32> dAll = shared float32[TN];
        Shared<int32> scAll = shared int32[TN * 16];
        // Per-wave spill tile for the ragged tail's guarded store.
        Shared<float32> fs = shared float32[(TM / WM) * (TN / WN) * 256];

        uint32 tid = KernelThread.x();
        uint32 wid = tid / 32;
        uint32 lane = tid % 32;
        uint32 wg = KernelThread.globalIdX() / (2 * TN);
        uint32 mapIdx = wg / tilesN;
        uint32 tileI = wg % tilesN;
        uint32 i0 = tileI * TN;
        uint32 wr = wid / (TN / WN);
        uint32 wc = wid % (TN / WN);
        uint32 cw = i0 + WN * wc;
        uint32 sCol = tid >> 1;
        uint32 sH = tid & 1;
        int32 shq = 2 * (int32) sH;
        // The chunk count lives on the device (the group kernel writes it);
        // the grid is an upper bound.
        uint32 nChunks = (uint32) meta[(int64) (TM / 128)];
        if (mapIdx < nChunks && i0 < outDim) {
            uint32 t0 = (uint32) mapT0[(int64) mapIdx];
            uint32 mEnd = (uint32) mapM1[(int64) mapIdx];
            uint32 tw = t0 + WM * wr;
            int64 prefix = ((blocksPerRow * 2L + 3L) / 4L) * 4L;
            int64 rowBytes = prefix + blocksPerRow * 208L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 wOff = (int64) mapE[(int64) mapIdx] * rowsPerExpert * rowBytes;
            int64 sRow = wOff + (int64) (i0 + sCol) * rowBytes;
            int64 sRo = sRow + prefix;
            int64 sXb = (int64) (t0 + sCol) * xRowBytes;
            uint32 aRow0 = tid >> 3;
            uint32 aPart = tid & 7;
            int64 aSrc0 = (int64) (t0 + aRow0) * xRowBytes + (int64) (16 * aPart);
            int64 xrP = (int64) (TM / 4) * xRowBytes;
            uint32 aDst0 = aRow0 * 144 + 16 * aPart;
            uint32 aDstP = (TM / 4) * 144;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1>[WN / 16] mb;
            CooperativeMatrix<int32,16,16,2>[WN / 16] mc;
            CooperativeMatrix<int32,16,16,2>[WM / 16][WN / 16] iacc;
            CooperativeMatrix<float32,16,16,2>[WM / 16][WN / 16] facc;
            for (uint32 i = 0; i < WM / 16; i = i + 1) {
                for (uint32 n = 0; n < WN / 16; n = n + 1) { facc[i][n].splat(0.0f); }
            }

            Vector<int32,4> pa0 = xp.vload<16>(aSrc0).asWords();
            Vector<int32,4> pa1 = xp.vload<16>(aSrc0 + xrP).asWords();
            Vector<int32,4> pa2 = xp.vload<16>(aSrc0 + xrP + xrP).asWords();
            Vector<int32,4> pa3 = xp.vload<16>(aSrc0 + xrP + xrP + xrP).asWords();
            Vector<int32,4> pl0 = packed.vload<16>(sRo + (int64) (32 * sH)).asWords();
            Vector<int32,4> pl1 = packed.vload<16>(sRo + (int64) (32 * sH) + 16L).asWords();
            Vector<int32,4> ph0 = packed.vload<16>(sRo + 128L).asWords();
            Vector<int32,4> ph1 = packed.vload<16>(sRo + 144L).asWords();
            Vector<int32,4> psc = packed.vload<16>(sRo + 192L).asWords();
            Vector<int32,1> px = xp.vload<4>(sXb + 288L).asWords();
            int32 pd = ((int32) packed[sRow] & 255)
                | (((int32) packed[sRow + 1L] & 255) << 8);

            uint32 nh = (uint32) blocksPerRow * 2;
            uint32 hh = 0;
            while (hh < nh) {
                uint32 H = hh & 1;
                Barrier.workgroup();
                int64 aDst = (int64) aDst0;
                aT.vstore(aDst, pa0.asBytes());
                aT.vstore(aDst + (int64) aDstP, pa1.asBytes());
                aT.vstore(aDst + (int64) (2 * aDstP), pa2.asBytes());
                aT.vstore(aDst + (int64) (3 * aDstP), pa3.asBytes());
                {
                    // k 32sH..32sH+31 from the low nibbles with qh bits
                    // 2sH..2sH+1, k 64+32sH.. from the high nibbles with
                    // bits 2sH+4..; both biased by 32 (Quant.q6kBlock).
                    int64 dst = (int64) (sCol * 144 + 32 * sH);
                    Vector<int32,4> l0 = pl0;
                    Vector<int32,4> l1 = pl1;
                    Vector<int32,4> h0 = ph0 >> shq;
                    Vector<int32,4> h1 = ph1 >> shq;
                    Vector<int32,4> v0 = ((l0 & 252645135) | ((h0 & 50529027) << 4)) ^ 538976288;
                    Vector<int32,4> v1 = ((l1 & 252645135) | ((h1 & 50529027) << 4)) ^ 538976288;
                    Vector<int32,4> v2 = (((l0 >> 4) & 252645135) | (((h0 >> 4) & 50529027) << 4)) ^ 538976288;
                    Vector<int32,4> v3 = (((l1 >> 4) & 252645135) | (((h1 >> 4) & 50529027) << 4)) ^ 538976288;
                    v0 = v0 | ((v0 & 538976288) << 1) | ((v0 & 538976288) << 2);
                    v1 = v1 | ((v1 & 538976288) << 1) | ((v1 & 538976288) << 2);
                    v2 = v2 | ((v2 & 538976288) << 1) | ((v2 & 538976288) << 2);
                    v3 = v3 | ((v3 & 538976288) << 1) | ((v3 & 538976288) << 2);
                    bT.vstore(dst, v0.asBytes());
                    bT.vstore(dst + 16L, v1.asBytes());
                    bT.vstore(dst + 64L, v2.asBytes());
                    bT.vstore(dst + 80L, v3.asBytes());
                }
                if (H == 0) {
                    if (sH == 0) {
                        dAll[sCol] = GgufFile.halfBitsToF32(pd);
                        Vector<int32,4> sw = psc;
                        uint32 cb = sCol;
                        int32 s0 = sw[0];
                        int32 s1 = sw[1];
                        int32 s2 = sw[2];
                        int32 s3 = sw[3];
                        scAll[cb] = (s0 << 24) >> 24;
                        scAll[cb + TN] = (s0 << 16) >> 24;
                        scAll[cb + 2 * TN] = (s0 << 8) >> 24;
                        scAll[cb + 3 * TN] = s0 >> 24;
                        scAll[cb + 4 * TN] = (s1 << 24) >> 24;
                        scAll[cb + 5 * TN] = (s1 << 16) >> 24;
                        scAll[cb + 6 * TN] = (s1 << 8) >> 24;
                        scAll[cb + 7 * TN] = s1 >> 24;
                        scAll[cb + 8 * TN] = (s2 << 24) >> 24;
                        scAll[cb + 9 * TN] = (s2 << 16) >> 24;
                        scAll[cb + 10 * TN] = (s2 << 8) >> 24;
                        scAll[cb + 11 * TN] = s2 >> 24;
                        scAll[cb + 12 * TN] = (s3 << 24) >> 24;
                        scAll[cb + 13 * TN] = (s3 << 16) >> 24;
                        scAll[cb + 14 * TN] = (s3 << 8) >> 24;
                        scAll[cb + 15 * TN] = s3 >> 24;
                    } else {
                        Vector<int32,1> xw = px;
                        xsAll[sCol] = Cajeta.bitsToF32(xw[0]);
                    }
                }
                if (hh + 1 < nh) {
                    int64 nb = (int64) ((hh + 1) >> 1);
                    uint32 nH = (hh + 1) & 1;
                    int64 aS = aSrc0 + nb * 320L + (int64) (128 * nH);
                    pa0 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa1 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa2 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa3 = xp.vload<16>(aS).asWords();
                    int64 bS = sRo + nb * 208L;
                    pl0 = packed.vload<16>(bS + (int64) (64 * nH + 32 * sH)).asWords();
                    pl1 = packed.vload<16>(bS + (int64) (64 * nH + 32 * sH) + 16L).asWords();
                    ph0 = packed.vload<16>(bS + 128L + (int64) (32 * nH)).asWords();
                    ph1 = packed.vload<16>(bS + 144L + (int64) (32 * nH)).asWords();
                    if (nH == 0) {
                        if (sH == 0) {
                            psc = packed.vload<16>(bS + 192L).asWords();
                            pd = ((int32) packed[sRow + nb * 2L] & 255)
                                | (((int32) packed[sRow + nb * 2L + 1L] & 255) << 8);
                        } else {
                            px = xp.vload<4>(sXb + nb * 320L + 288L).asWords();
                        }
                    }
                }
                Barrier.workgroup();

                if (H == 0) {
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { iacc[i][n].splat(0); }
                    }
                }
                uint32 cBase = WN * wc;
                uint32 aBuf = (WM * wr) * 144;
                uint32 bBuf = (WN * wc) * 144;
                uint32 jj = 0;
                while (jj < 8) {
                    uint32 sj = cBase + (8 * H + jj) * TN;
                    uint32 kk = 16 * jj;
                    // The B fragments once per k-step for every row
                    // fragment, as the 128x128 kernel loads mbA..mbD
                    // before its two row fragments.
                    for (uint32 n = 0; n < WN / 16; n = n + 1) {
                        mb[n].load(bT, bBuf + n * (16 * 144) + kk, 1, 144);
                    }
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        ma.load(aT, aBuf + i * (16 * 144) + kk, 0, 144);
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].splat(0); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].mma(ma, mb[n]); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            TileOps.scaledAccumI32(mc[n], iacc[i][n], scAll, sj + 16 * n, 1);
                        }
                    }
                    jj = jj + 1;
                }
                if (H == 1) {
                    uint32 dbase = WN * wc;
                    uint32 xbase = WM * wr;
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            WaveVector<float32, 16> dcv = WaveVector.ofSlice(dAll, dbase + 16 * n, 1);
                            iacc[i][n].scaledAccumInto(facc[i][n], xsAll[xbase + 16 * i], dcv);
                        }
                    }
                }
                hh = hh + 1;
            }

            // Stores: a row fragment wholly below the entry's end lands
            // straight from the accumulator; the ragged one spills to this
            // wave's LDS tile and copies guarded; rows past the end are the
            // next group's and never land.
            for (uint32 i = 0; i < WM / 16; i = i + 1) {
                uint32 tb = tw + 16 * i;
                if (tb < mEnd) {
                    if (tb + 16 <= mEnd) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            facc[i][n].store(y, (uint32) ((int64) tb * (int64) outDim
                                + (int64) (cw + 16 * n)), 0, outDim);
                        }
                    } else {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            facc[i][n].store(fs, wid * 256, 0, 16);
                            uint32 sa = lane;
                            while (sa < 256) {
                                if (tb + sa / 16 < mEnd) {
                                    y[(int64) (tb + sa / 16) * (int64) outDim
                                        + (int64) (cw + 16 * n + sa % 16)] = fs[wid * 256 + sa];
                                }
                                sa = sa + 32;
                            }
                        }
                    }
                }
            }
        }
    }
}
