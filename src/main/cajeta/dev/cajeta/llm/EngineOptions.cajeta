package dev.cajeta.llm;

import cajeta.lang.String;

/**
 * Engine configuration (spec 11.2, 11.5, 11.6) — everything the CLI's
 * flags configure, reachable without the CLI (11.4). Field defaults are
 * the engine's documented defaults; `model` is required.
 */
public final class EngineOptions {
    /** `.gguf`, a `.safetensors` file, or a sharded index `.json`. */
    public String model;
    /** `config.json` path for safetensors models; ignored for GGUF
     *  (metadata populates the config — spec 9.3). Defaults to
     *  `config.json` beside the model when empty. */
    public String config;
    /** Context length (--ctx). */
    public int32 ctx;
    /** Scheduler slots (--max-seqs, spec 11.5). */
    public int32 maxSeqs;
    /** KV block tokens (--block-size). */
    public int32 blockTokens;
    /** Prefill chunk (--chunk, spec 13.14). */
    public int32 chunk;
    /** Backend name for Device.force (--device); empty = dispatcher order
     *  (spec 11.2). */
    public String device;
    /** Block-store path (--kv-store); empty = disabled — recompute on
     *  resume (spec 6.32, 11.6). */
    public String kvStore;
    /** Store size bound in bytes (--kv-store-size). */
    public int64 kvStoreSize;
    /** Prefill weight residency (spec 9.8.1, plan 10.12.16):
     *  `"packed"` (default) computes the batched prefill GEMM straight
     *  from the quantized blocks — per-tile dequant in LDS, zero extra
     *  bytes, the llama.cpp MMQ shape; `"int8"` widens each Q4_K weight
     *  ONCE into a resident `[outDim x cols]` int8 copy the matrix
     *  cores read directly (~2x that weight's bytes, prefill-only).
     *  Decode reads the packed copy in BOTH modes. */
    public String prefillWeights;
    /** MoE expert residency budget in bytes (moe-expert-cache spec
     *  3.2.1). 0 = residency OFF: every expert dispatch takes the
     *  windowed T0 path. The measured default derivation is that
     *  plan's unit 4; until it lands the default stays 0 so nothing
     *  changes behavior unconfigured. */
    public int64 moeResidencyBudget;

    public EngineOptions(String model) {
        this.model = "" + model;
        this.config = "";
        this.ctx = 4096;
        this.maxSeqs = 4;
        this.blockTokens = 16;
        this.chunk = 128;
        this.device = "";
        this.kvStore = "";
        this.kvStoreSize = 268435456L;
        this.prefillWeights = "packed";
        this.moeResidencyBudget = 0L;
    }
}
