package dev.cajeta.llm;

import cajeta.lang.String;
import cajeta.lang.System;

/**
 * A `DiagSink` that writes to stderr, for embedders that want the lines
 * and have nothing better to route them to (the `cajeta-llm` CLI behind
 * `--verbose`).
 *
 * stderr is the right choice HERE and the wrong choice as a default: the
 * difference is that installing this is an explicit request. Nobody who
 * did not ask for diagnostics gets them painted red in their console.
 * An embedder with a real logging backend should bridge `DiagSink` to it
 * instead — cabra sends these to `dev.cajeta.logging` at DEBUG.
 */
public final class StderrDiagSink implements DiagSink {

    public StderrDiagSink() { return; }

    public void line(String message) {
        System.stderr.println(message);
        return;
    }
}
