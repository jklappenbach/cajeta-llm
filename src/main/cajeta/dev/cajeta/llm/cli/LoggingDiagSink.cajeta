package dev.cajeta.llm.cli;

import cajeta.lang.String;
import dev.cajeta.llm.DiagSink;
import dev.cajeta.logging.Logger;

/**
 * Bridges the engine's `DiagSink` seam onto `dev.cajeta.logging`, for the
 * `cajeta-llm` CLI.
 *
 * DIAGNOSTICS NEED A CHANNEL OF THEIR OWN, and stderr is not it. That was
 * settled once already (Julian, 2026-08-27, recorded in `Diag`): stderr is
 * a SEVERITY channel, so IDEs and log collectors paint it red and alert on
 * it, and "we picked the batched kernel" gets laundered into "something
 * went wrong". A stderr sink was nevertheless wired in behind `--verbose`
 * on 2026-08-30 and walked straight back into that; this replaces it.
 *
 * The invariant it buys is worth more than the tidiness: with diagnostics
 * on their own channel, ANY output on stderr is now a real problem, so
 * stderr becomes a signal instead of a stream nobody reads.
 * `CliDiagTest.verboseWritesNothingToStderr` pins that.
 *
 * This lives in the `cli` package on purpose. The artifact depends on
 * `dev.cajeta.logging` (Julian's call, 2026-08-30), but the LIBRARY
 * packages still import no logging backend, so the rule `Diag` states —
 * a library must not choose a backend for its embedder — stays visibly
 * true in the code that embedders actually compile against.
 *
 * DEBUG, deliberately: these lines say which route a projection took —
 * tuning detail for whoever is measuring the engine, not news for whoever
 * is running it. At INFO they would appear in every default-configured
 * log and recreate the console noise the hook exists to stop.
 */
public final class LoggingDiagSink implements DiagSink {

    // OWNED: `Log.console` hands back a `#Logger` and the sink outlives
    // the call that built it, so a plain `=` would record a borrow of a
    // logger nobody else holds.
    Logger log;

    public LoggingDiagSink(#Logger l) {
        this.log #= l;
        return;
    }

    public void line(String message) {
        this.log.debug(message);
        return;
    }
}
