package dev.cajeta.llm.gen;

import cajeta.collection.ArrayList;
import cajeta.lang.String;

/**
 * Per-request sampling parameters (spec 8.1–8.7). One instance per
 * request — each sequence in a batch samples with its OWN parameters and
 * its own RNG stream seeded from `seed` (8.6, plan 14.1.8).
 *
 * Field semantics, matching the reference conventions:
 * - `temperature` 0 = greedy argmax (8.1); otherwise logits divide by it
 *   before softmax (8.2).
 * - `topK` 0 = off; otherwise sampling restricts to the k highest logits
 *   (8.3).
 * - `topP` ≤ 0 or ≥ 1 = off; otherwise the smallest set whose cumulative
 *   probability reaches p (8.4).
 * - `repeatPenalty` 1 = off; a previously EMITTED token's logit divides
 *   by it when positive and multiplies when negative (8.5) — the
 *   llama.cpp/HF convention.
 * - `stopTokens` — halting token ids (EOS family; 8.7). Owned.
 * - `stops` — halting strings, checked against a rolling detokenized
 *   window (8.7); needs `Scheduler.setTokenizer`. Owned.
 */
public final class SampleParams {
    public float32 temperature;
    public int32 topK;
    public float32 topP;
    public float32 repeatPenalty;
    public int64 seed;
    public int32[] stopTokens;
    public ArrayList<String> stops;

    public SampleParams(float32 temperature, int64 seed) {
        this.temperature = temperature;
        this.seed = seed;
        this.topK = 0;
        this.topP = 0.0f;
        this.repeatPenalty = 1.0f;
        this.stopTokens = null;
        this.stops = null;
    }
}
