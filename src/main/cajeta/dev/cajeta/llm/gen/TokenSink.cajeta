package dev.cajeta.llm.gen;

/**
 * The streaming callback (spec 8.8): every emitted token is delivered
 * here — within the scheduler step that produced it, before the next
 * step begins. `reqId` is the scheduler's request id, so one sink can
 * demultiplex a whole batch.
 */
public interface TokenSink {
    void onToken(int32 reqId, int32 token);
}
