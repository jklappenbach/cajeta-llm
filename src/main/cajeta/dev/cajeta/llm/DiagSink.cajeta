package dev.cajeta.llm;

import cajeta.lang.String;

/**
 * Where engine diagnostics go, chosen by the embedder (see `Diag`).
 *
 * One method, taking an already-formatted line. Deliberately not a
 * level/category API: the engine has exactly one class of diagnostic —
 * "which route did I take" — and inventing severities here would only
 * invite the engine to decide, on its embedder's behalf, that something
 * is an error.
 */
public interface DiagSink {
    public void line(String message);
}
