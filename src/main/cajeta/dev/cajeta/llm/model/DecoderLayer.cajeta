package dev.cajeta.llm.model;

import cajeta.lang.String;
import dev.cajeta.llm.io.Checkpoint;

/**
 * One pre-norm decoder block. Two norm layouts (spec 5.11):
 *
 * - Llama (two norms): `x += attn(inputLayernorm(x))`, then
 *   `x += mlp(postAttentionLayernorm(x))`.
 * - Gemma 3 (four norms): the post-norms apply to the SUBLAYER OUTPUT
 *   before the residual add —
 *   `x += postAttentionLayernorm(attn(inputLayernorm(x)))`, then
 *   `x += postFeedforwardLayernorm(mlp(preFeedforwardLayernorm(x)))`.
 *
 * Field names are the torch key segments; the two extra norms stay null
 * (and unnamed in the walk) unless the config declares them.
 */
public final class DecoderLayer extends InfModule {
    RMSNorm inputLayernorm;
    Attention selfAttn;
    RMSNorm postAttentionLayernorm;
    RMSNorm preFeedforwardLayernorm;   // null unless fourNorm
    RMSNorm postFeedforwardLayernorm;  // null unless fourNorm
    Mlp mlp;                           // null for an MoE layer
    MoeFfn moe;                        // null for a dense layer
    int32 layerIdx;
    /** 0 = SiLU (SwiGLU), 1 = gelu_pytorch_tanh (GeGLU) — spec 5.4. */
    int32 activation;
    /** 0 = Llama `·w`, 1 = Gemma `·(1+w)` — spec 5.12. */
    int32 normForm;
    boolean fourNorm;

    DecoderLayer(ModelConfig cfg, int32 layerIdx) {
        this.inputLayernorm = heap RMSNorm(cfg.hiddenSize, cfg.rmsNormEps);
        this.selfAttn = heap Attention(cfg, layerIdx);
        this.postAttentionLayernorm = heap RMSNorm(cfg.hiddenSize,
            cfg.rmsNormEps);
        if (cfg.fourNorm) {
            this.preFeedforwardLayernorm = heap RMSNorm(cfg.hiddenSize,
                cfg.rmsNormEps);
            this.postFeedforwardLayernorm = heap RMSNorm(cfg.hiddenSize,
                cfg.rmsNormEps);
        } else {
            this.preFeedforwardLayernorm = null;
            this.postFeedforwardLayernorm = null;
        }
        if (cfg.expertCount > 0) {
            // Spec 15.1: the FFN is a router plus expert banks; the
            // dense path stays untouched for dense models.
            this.mlp = null;
            this.moe = heap MoeFfn(cfg);
            this.moe.layerIdx = layerIdx;
        } else {
            this.mlp = heap Mlp(cfg.hiddenSize, cfg.intermediateSize);
            this.moe = null;
        }
        this.layerIdx = layerIdx;
        this.activation = cfg.activation;
        this.normForm = cfg.normForm;
        this.fourNorm = cfg.fourNorm;
    }

    void bind(Checkpoint ckpt, String prefix, boolean toDevice) {
        this.inputLayernorm.bind(ckpt, prefix + "input_layernorm.weight",
            toDevice);
        this.selfAttn.bind(ckpt, prefix + "self_attn.", toDevice);
        this.postAttentionLayernorm.bind(ckpt,
            prefix + "post_attention_layernorm.weight", toDevice);
        if (this.fourNorm) {
            this.preFeedforwardLayernorm.bind(ckpt,
                prefix + "pre_feedforward_layernorm.weight", toDevice);
            this.postFeedforwardLayernorm.bind(ckpt,
                prefix + "post_feedforward_layernorm.weight", toDevice);
        }
        if (this.moe != null) {
            // MoE tensors bind by their ggml names directly — the
            // merged slabs have no torch state_dict equivalent.
            this.moe.bind(ckpt, "blk." + this.layerIdx + ".", toDevice);
        } else {
            this.mlp.bind(ckpt, prefix + "mlp.", toDevice);
        }
    }
}
