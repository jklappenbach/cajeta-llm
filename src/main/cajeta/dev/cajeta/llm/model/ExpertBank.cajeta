package dev.cajeta.llm.model;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.Checkpoint;
import cajeta.io.file.MappedFile;
import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.WmmaKernel;

/**
 * One projection's bank of experts (spec 15.2): a merged rank-3 GGUF
 * slab held as ONE packed payload, each expert addressed as an offset
 * view — never copied out per expert. 15.3 is what makes the view
 * legal: the slab's inner dimension is a whole number of quant blocks,
 * so every expert's rows start on a block boundary and the existing
 * packed kernels can serve a per-expert GEMV through (slab, offset)
 * unchanged. A slab that breaks that is rejected with the dimension
 * named, never mis-sliced — the real Q4_K_M qwen2moe witness ships its
 * 1408-wide down projection as Q8_0 for exactly this reason.
 */
public final class ExpertBank {

    int32 expertsN;
    int32 rowsN;       // per-expert out dim
    int32 colsN;       // in dim (the slab's fastest dimension)
    int32 packedTy;
    MappedFile map;    // owned — this bank's own mapping (15.19:
                       // reads go through the page cache, so the
                       // OS is the eviction policy and a slab
                       // larger than RAM still binds and runs)
    int64 mapOff;      // absolute file offset of the slab payload
    int8[] eStage;     // one expert's staged bytes, [stride]
    // ── Unit 40 (spec 15.21.3): bank-slab residency. The WHOLE bank
    // binds as one device buffer — the granularity the indirected
    // dispatch reads — and per-expert slots become zero-copy SLICES of
    // it. One admission, one charge, one upload per bank. ──
    KernelBuffer<int8> slabDev;
    boolean slabRefused;
    int64 stride;      // bytes per expert
    int64[] touched;   // bytes served per expert (15.16's instrument)
    Linear winLin;     // unit 28: the device expert window (lazy)
    // moe-expert-cache T1 (spec 3.1/3.2): device-resident slots.
    // `slotOwn` owns the admitted Linears; `slots` is the borrow index
    // by expert (the layerArr pattern), null = not admitted.
    ArrayList<Linear> slotOwn;
    Linear[] slots;
    boolean[] refused;      // trial admission failed once; never retried
    int64[] slotCharge;     // budget bytes charged per admitted expert
    int64 residentB;
    int32 admittedN;

    // Process-wide residency state (spec 10.7: T1 assumes one MoE
    // model per process; the accessors keep the option open).
    // resBudget == 0 means residency is OFF and every dispatch takes
    // the T0 windowed path (spec 3.1.7).
    static int64 resBudget;
    static int64 resUsed;
    static int64 resAdmissions;
    static int64 resAdmissionBytes;
    static int64 resHits;
    static int64 resWindowed;

    public ExpertBank() {
        this.expertsN = 0;
        this.rowsN = 0;
        this.colsN = 0;
        this.packedTy = 0 - 1;
        this.map = null;
        this.mapOff = 0L;
        this.eStage = null;
        this.stride = 0L;
        this.touched = null;
        this.winLin = null;
        this.slotOwn = null;
        this.slots = null;
        this.refused = null;
        this.slotCharge = null;
        this.residentB = 0L;
        this.admittedN = 0;
        return;
    }

    public static void setResidencyBudget(int64 bytes) {
        ExpertBank.resBudget = bytes;
        return;
    }

    public static int64 residencyBudget() {
        return ExpertBank.resBudget;
    }

    public static int64 residencyUsedBytes() {
        return ExpertBank.resUsed;
    }

    public static int64 residencyAdmissions() {
        return ExpertBank.resAdmissions;
    }

    public static int64 residencyAdmissionBytes() {
        return ExpertBank.resAdmissionBytes;
    }

    public static int64 residencyHits() {
        return ExpertBank.resHits;
    }

    public static int64 residencyWindowed() {
        return ExpertBank.resWindowed;
    }

    /** Zero the residency counters and the global charge — a
     *  measurement seam for tests and probes. Live slots are NOT
     *  freed (dropping the model frees them), so reset only between
     *  models. */
    public static void resetResidency() {
        ExpertBank.resUsed = 0L;
        ExpertBank.resAdmissions = 0L;
        ExpertBank.resAdmissionBytes = 0L;
        ExpertBank.resHits = 0L;
        ExpertBank.resWindowed = 0L;
        return;
    }

    public boolean isAdmitted(int32 e) {
        if (this.slabDev != null) { return true; }
        if (this.slots == null) { return false; }
        return this.slots[e] != null;
    }

    /** The budget's charge for expert `e`'s slot. */
    public int64 slotBytesOf(int32 e) {
        if (this.slotCharge == null) { return 0L; }
        return this.slotCharge[e];
    }

    /** The device weight bytes the slot ACTUALLY holds — the 1.1.1
     *  audit's ground truth, counted beside each allocation. */
    public int64 slotDeviceBytes(int32 e) {
        if (!this.isAdmitted(e)) { return 0L; }
        return this.slots[e].devWeightBytes();
    }

    public int64 residentBytes() {
        return this.residentB;
    }

    public int32 admittedCount() {
        return this.admittedN;
    }

    /** Bind `name` as a rank-3 [experts, out, in] packed slab.
     *  `expectRows`/`expectCols` of 0 mean "derive from the slab" —
     *  qwen2moe ships no expert-width key, so deriving is the normal
     *  case, not a fallback. */
    public void bind(Checkpoint ckpt, String name, int32 experts,
            int32 expectRows, int32 expectCols) {
        int64[] shp = ckpt.shapeOf(name);
        if (shp == null || (int32) shp.count() != 3) {
            throw heap LlmException("moe: '" + name + "' has rank "
                + (shp == null ? 0 : (int32) shp.count())
                + "; expected a rank-3 merged expert slab "
                + "[experts, out, in]");
        }
        // TORCH order: [experts, out, in].
        if (shp[0] != (int64) experts) {
            throw heap LlmException("moe: '" + name + "' holds "
                + shp[0] + " experts; the config declares " + experts);
        }
        int32 rows = (int32) shp[1];
        int32 cols = (int32) shp[2];
        if (expectRows > 0 && rows != expectRows) {
            throw heap LlmException("moe: '" + name + "' expert out dim "
                + rows + " does not match the expected " + expectRows);
        }
        if (expectCols > 0 && cols != expectCols) {
            throw heap LlmException("moe: '" + name + "' expert in dim "
                + cols + " does not match the expected " + expectCols);
        }
        int32 pty = ckpt.packedTypeOf(name);
        if (pty < 0) {
            throw heap LlmException("moe: '" + name + "' is not a "
                + "supported packed quant type; expert slabs bind "
                + "packed (no witness ships float expert slabs)");
        }
        int32 be = Quant.blockElems(pty);
        if (cols % be != 0) {
            // 15.3: the reject arm. Naming the dimension is the point.
            throw heap LlmException("moe: '" + name + "' inner "
                + "dimension " + cols + " is not a whole number of "
                + be + "-element blocks (ggml type " + pty + "); an "
                + "expert slice cannot begin on a block boundary "
                + "(spec 15.3)");
        }
        // 15.19: NO copy — the slab binds as (mapping, offset) and
        // expert strides are read on access. loadPacked here would
        // materialize the whole slab at bind, which is exactly the
        // eager pass that turns a bigger-than-RAM MoE into "does not
        // start" (measured: loadPacked heap-copies via map.read).
        int64 fo = ckpt.packedFileOffsetOf(name);
        int64 rowBytes = ((int64) cols / (int64) be)
            * (int64) Quant.blockBytes(pty);
        int64 want = (int64) experts * (int64) rows * rowBytes;
        String fp #= ckpt.filePath();
        MappedFile mm #= heap MappedFile(fp);
        if (mm.size() < fo + want) {
            throw heap LlmException("moe: '" + name + "' payload wants "
                + want + " bytes at offset " + fo + " but '" + fp
                + "' holds " + mm.size());
        }
        this.map #= mm;
        this.mapOff = fo;
        this.eStage = heap int8[(int64) rows * rowBytes];
        this.packedTy = pty;
        this.expertsN = experts;
        this.rowsN = rows;
        this.colsN = cols;
        this.stride = (int64) rows * rowBytes;
        this.touched #= heap int64[experts];
        return;
    }

    /**
     * Expert `e`'s GEMV: y[yOff..yOff+rows) = W_e · x[xOff..xOff+cols),
     * decoded straight off the slab at e's offset — the ONLY path that
     * reads expert weights, which is what makes 15.16's byte count a
     * count of the mechanism rather than of a wall-clock.
     */
    public void matvecAt(int32 e, float32[] x, int64 xOff,
            float32[] y, int64 yOff) {
        // A T0 dispatch (moe-cache spec 8.1): the windowed counter
        // covers every non-slot serving — device window, host grouped
        // GEMM, host mat-vec — so the record's hit/fallback split is
        // honest on every backend, not only where the window exists.
        ExpertBank.resWindowed = ExpertBank.resWindowed + 1L;
        // Unit-37 workaround: test-profile codegen leaks ~16 B of
        // stack per vector-lane extract, restored only at the
        // decoder's RETURN — one call over a big expert ([1024 x
        // 8192] measured) walks off the guard page. Chunk the rows so
        // each decoder call's leak stays bounded; remove when the
        // compiler fix (plan unit 37) lands.
        int8[] es = this.stageExpert(e);
        int64 c = (int64) this.colsN;
        int64 blocksPerRow = c / (int64) Quant.blockElems(this.packedTy);
        int64 chunk = 1048576L / (blocksPerRow * 512L);
        if (chunk < 1L) {
            chunk = 1L;
        }
        int64 rowBytes = this.stride / (int64) this.rowsN;
        int64 r0 = 0L;
        while (r0 < (int64) this.rowsN) {
            int64 r = (int64) this.rowsN - r0;
            if (r > chunk) {
                r = chunk;
            }
            this.matvecRows(es, r0 * rowBytes, r, c, x, xOff,
                y, yOff + r0);
            r0 = r0 + r;
        }
        this.touched[e] = this.touched[e] + this.stride;
        return;
    }

    /** One bounded decoder call over `r` rows at `po` bytes into the
     *  staged expert. */
    void matvecRows(int8[] es, int64 po, int64 r, int64 c,
            float32[] x, int64 xOff, float32[] y, int64 yOff) {
        if (this.packedTy == Quant.GG_Q4_K) {
            Quant.q4kMatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q8_0) {
            Quant.q8MatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q6_K) {
            Quant.q6kMatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q5_K) {
            Quant.q5kMatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q2_K) {
            Quant.q2kMatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q3_K) {
            Quant.q3kMatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q4_0) {
            Quant.q40MatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else if (this.packedTy == Quant.GG_Q5_0) {
            Quant.q50MatVecIntoAt(es, po, r, c, x, xOff, y, yOff);
        } else {
            // A bare else would route a future format through another
            // format's tables — fluent wrong output (the Linear lesson).
            throw heap LlmException("moe: no host expert mat-vec for "
                + "packed type " + this.packedTy);
        }
        return;
    }

    /**
     * Expert `e`'s grouped GEMM (15.12): decode the expert's packed
     * bytes ONCE into `dq` ([rows x cols] f32, caller-owned staging),
     * then multiply the `m` gathered rows at `xs[xsOff…)` into
     * `ys[ysOff…)` ([m x rows], row-major). The counter increments one
     * stride regardless of `m` — and that is honest, not bookkeeping:
     * the packed bytes really are read exactly once, by the dequant
     * pass; the GEMM reads only `dq`.
     */
    public void gemmAt(int32 e, float32[] xs, int64 xsOff, int32 m,
            float32[] ys, int64 ysOff, float32[] dq) {
        // A T0 dispatch, same rule as matvecAt.
        ExpertBank.resWindowed = ExpertBank.resWindowed + 1L;
        int64 bb = (int64) Quant.blockBytes(this.packedTy);
        int8[] es = this.stageExpert(e);
        Quant.dequantize(this.packedTy, es, 0L,
            this.stride / bb, dq, 0L);
        this.touched[e] = this.touched[e] + this.stride;
        int64 r = (int64) this.rowsN;
        int64 c = (int64) this.colsN;
        int32 t = 0;
        while (t < m) {
            int64 xo = xsOff + (int64) t * c;
            int64 yo = ysOff + (int64) t * r;
            int64 i = 0;
            while (i < r) {
                float32 acc = 0.0f;
                int64 dqo = i * c;
                int64 j = 0;
                while (j < c) {
                    acc = acc + dq[dqo + j] * xs[xo + j];
                    j = j + 1;
                }
                ys[yo + i] = acc;
                i = i + 1;
            }
            t = t + 1;
        }
        return;
    }

    /** Can a group of `m` rows take the device GEMM for this bank?
     *  Lazily builds the expert-window Linear and asks the SAME
     *  predicate the dense batched path asks — which also honors
     *  QuantKernel's routing switch, so parity tests force the host
     *  arm the usual way. */
    boolean devRoutableFor(int32 m) {
        if (this.winLin == null) {
            this.winLin = heap Linear(this.colsN, this.rowsN);
            this.winLin.bindExpertWindow(this.packedTy, this.stride);
        }
        return this.winLin.isBatchRoutedFor((int64) m);
    }

    /**
     * Expert `e`'s grouped GEMM on the DEVICE (15.12/15.19): the
     * expert's bytes are staged into the stride-sized window — the
     * per-selected-expert-group upload 15.19 requires, never a slab —
     * and the batched route runs over the activations the caller
     * staged with Linear.stageBatch. Counts one stride at the same
     * seam as the host paths, and that is the read: the slab bytes are
     * touched exactly once, by the staging copy.
     */
    public void gemmDeviceAt(int32 e, int32 m, Tensor<float32> dst,
            int64 dstOff) {
        if (this.isAdmitted(e)) {
            Linear sl = this.slotFor(e);
            ExpertBank.resHits = ExpertBank.resHits + 1L;
            sl.matmulInto(m, dst, dstOff);
            // Reconcile AFTER every slot launch (plan 1.1.1): the
            // route depends on rows, and a new group shape may have
            // just bound a derived form the admission never charged.
            int64 now = sl.devWeightBytes();
            if (now != this.slotCharge[e]) {
                int64 d = now - this.slotCharge[e];
                this.slotCharge[e] = now;
                this.residentB = this.residentB + d;
                ExpertBank.resUsed = ExpertBank.resUsed + d;
                ExpertBank.resAdmissionBytes =
                    ExpertBank.resAdmissionBytes + d;
            }
            return;
        }
        boolean tryAdmit = ExpertBank.resBudget > 0L
            && ExpertBank.resUsed < ExpertBank.resBudget;
        if (tryAdmit && this.refused != null && this.refused[e]) {
            tryAdmit = false;
        }
        if (tryAdmit) {
            this.admitAndRun(e, m, dst, dstOff);
            return;
        }
        ExpertBank.resWindowed = ExpertBank.resWindowed + 1L;
        this.map.read(this.mapOff + (int64) e * this.stride,
            this.winLin.winStage, 0L, this.stride);
        this.winLin.stageExpertWindowStaged();
        this.touched[e] = this.touched[e] + this.stride;
        this.winLin.matmulInto(m, dst, dstOff);
        return;
    }

    /** TRIAL admission (plan 1.2.2): build the slot, run the dispatch
     *  on it, then charge the budget with what it ACTUALLY bound — no
     *  predicted sizes to drift from the route tree. Over budget, the
     *  slot is dropped and the expert marked refused, never retried:
     *  the one trial cost the same staging a windowed dispatch pays,
     *  plus a transient allocation (spec 3.1.3's decision, made
     *  exact). */
    /**
     * Bind the whole bank as ONE device slab (unit 40). Trial-admission
     * semantics at bank granularity: the charge is the full
     * experts x stride, refused permanently when the budget cannot
     * cover it (per-expert trial admission then continues to serve
     * exactly as before — the capped regime keeps its mixed shape).
     * Existing per-expert slots are dropped and their charges refunded:
     * the slab supersedes them, and future slots bind as zero-copy
     * slices of it so the batched GEMM route reads the same bytes the
     * indirected decode dispatch reads.
     */
    public boolean ensureSlab() {
        if (this.slabDev != null) { return true; }
        if (this.slabRefused) { return false; }
        if (this.map == null) { return false; }
        int64 charge = (int64) this.expertsN * this.stride;
        if (ExpertBank.resBudget <= 0L
                || ExpertBank.resUsed + charge > ExpertBank.resBudget) {
            this.slabRefused = true;
            return false;
        }
        // Refund the slots the slab supersedes (their buffers drop with
        // the list; derived-form charges went through slotCharge too).
        if (this.slots != null) {
            int32 e = 0;
            while (e < this.expertsN) {
                if (this.slots[e] != null) {
                    ExpertBank.resUsed =
                        ExpertBank.resUsed - this.slotCharge[e];
                    this.residentB = this.residentB - this.slotCharge[e];
                    this.slotCharge[e] = 0L;
                    this.slots[e] = null;
                    this.admittedN = this.admittedN - 1;
                }
                this.refused[e] = false;
                e = e + 1;
            }
            this.slotOwn = heap ArrayList<Linear>();
        }
        int8[] hostSlab #= heap int8[charge];
        this.map.read(this.mapOff, hostSlab, 0L, charge);
        this.slabDev #= heap KernelBuffer<int8>((uint64) charge);
        this.slabDev.upload(hostSlab, charge);
        this.residentB = this.residentB + charge;
        ExpertBank.resUsed = ExpertBank.resUsed + charge;
        ExpertBank.resAdmissions = ExpertBank.resAdmissions + 1L;
        ExpertBank.resAdmissionBytes =
            ExpertBank.resAdmissionBytes + charge;
        return true;
    }

    /** Whether the bank slab is bound (the zero-sync dispatch's gate). */
    public boolean slabReady() {
        return this.slabDev != null;
    }

    /** The slab's budget charge — 0 when unbound. Bank-granular
     *  accounting's counterpart to slotBytesOf (spec 15.21.3: the
     *  budget accounts at the granularity it binds). */
    public int64 slabBytes() {
        if (this.slabDev == null) { return 0L; }
        return (int64) this.expertsN * this.stride;
    }

    /** The bound slab (valid only when {@link #slabReady}). */
    KernelBuffer<int8> slab() {
        return this.slabDev;
    }

    /** Bench-only: the wave twin against one expert's slab slice —
     *  the id-kernel's control arm (same bytes, same staging). */
    public void slotWaveLaunch(int32 e, KernelBuffer<float32> y,
            KernelBuffer<int8> xp, int64 yOff) {
        KernelBuffer<int8> sliceV #= this.slabDev.slice(
            (uint64) ((int64) e * this.stride),
            (uint64) this.stride);
        QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, sliceV, xp,
            (int64) this.rowsN, (int64) this.colsN, yOff);
        return;
    }

    /**
     * Unit 41: the group GEMM that KEEPS its output on the device —
     * the batch route runs into the shared slot scratch and one stream
     * copy lands the group in the caller's layer buffer at `dstOff`
     * elements. Hits and charge reconcile exactly as gemmDeviceAt.
     * False = not admitted (the caller takes the whole-layer host
     * path — the capped regime's shape).
     */
    public boolean gemmKeepAt(int32 e, int32 m,
            KernelBuffer<float32> dst, int64 dstOff) {
        if (!this.isAdmitted(e)) { return false; }
        Linear sl = this.slotFor(e);
        ExpertBank.resHits = ExpertBank.resHits + 1L;
        // Rows padded to the WMMA tile (unit 41c): arbitrary group
        // sizes kept every expert GEMM on the dotAccum fallback
        // (fits() wants rows % 16). Pad rows compute garbage from
        // stale stage bytes and are never copied out; the caller
        // pre-grew the stage so the padded reads stay in capacity.
        int32 m16 = (m + 15) / 16 * 16;
        sl.matmulBatchKeep(m16);
        int64 n = (int64) m * (int64) this.rowsN;
        KernelBuffer<float32> dv #= dst.slice((uint64) dstOff,
            (uint64) n);
        QuantKernel.f32CopyLaunchNoSync(dv, sl.yBatch, n);
        int64 now = sl.devWeightBytes();
        if (now != this.slotCharge[e]) {
            int64 d = now - this.slotCharge[e];
            this.slotCharge[e] = now;
            this.residentB = this.residentB + d;
            ExpertBank.resUsed = ExpertBank.resUsed + d;
            ExpertBank.resAdmissionBytes =
                ExpertBank.resAdmissionBytes + d;
        }
        return true;
    }

    /**
     * Unit 41d: ONE indirected WMMA GEMM covers every expert group of
     * this bank — the mul_mat_id shape at batch width. `y` and `xp`
     * are group-major over the whole batch; the maps carry each
     * M-tile's (expert, row base, row end). Every covered group counts
     * its hit. False = no slab or no id GEMM for the format (caller
     * keeps the per-group path).
     */
    public boolean gemmIdBatch(KernelBuffer<float32> y,
            KernelBuffer<int8> xp, KernelBuffer<int32> mapE,
            KernelBuffer<int32> mapT0, KernelBuffer<int32> mapM1,
            int32 nTilesM, int32 groups) {
        if (this.slabDev == null) { return false; }
        if (this.packedTy == 12) {
            WmmaKernel.q4kWmmaIdEpiLaunchNoSync(y, this.slabDev, xp,
                mapE, mapT0, mapM1, (int64) nTilesM,
                (int64) this.rowsN, (int64) this.colsN,
                (int64) this.rowsN);
        } else if (this.packedTy == 14) {
            WmmaKernel.q6kWmmaIdEpiLaunchNoSync(y, this.slabDev, xp,
                mapE, mapT0, mapM1, (int64) nTilesM,
                (int64) this.rowsN, (int64) this.colsN,
                (int64) this.rowsN);
        } else {
            return false;
        }
        ExpertBank.resHits = ExpertBank.resHits + (int64) groups;
        return true;
    }

    /** Whether {@link #gemmIdBatch} can serve this bank. */
    public boolean idGemmReady() {
        if (this.slabDev == null) { return false; }
        return this.packedTy == 12 || this.packedTy == 14;
    }

    /** Whether an indirected id-kernel exists for this bank's format
     *  (Q4_K, Q6_K — the 30B witness's two expert formats). */
    public boolean idReady() {
        return this.packedTy == 12 || this.packedTy == 14;
    }

    /**
     * Unit 40: the indirected dispatch — ONE launch covers every
     * selected expert of this bank against the slab, ids read from the
     * DEVICE sel buffer. Every covered expert counts as a hit: with the
     * slab bound, a dispatch reads resident bytes by construction.
     */
    public boolean idLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> xp, KernelBuffer<int32> sel, int32 used,
            int64 xRowBlocks) {
        if (this.slabDev == null) { return false; }
        boolean ok = QuantKernel.idMatVecLaunchNoSync(this.packedTy, y,
            this.slabDev, xp, sel, used, (int64) this.rowsN,
            (int64) this.colsN, xRowBlocks);
        if (ok) {
            ExpertBank.resHits = ExpertBank.resHits + (int64) used;
        }
        return ok;
    }

    /**
     * The slot serving expert `e`, materializing a zero-copy slab
     * slice on demand — with the slab bound, EVERY expert is admitted
     * (isAdmitted says so) but its slot object is created lazily at
     * first use. Null only when nothing admits `e`.
     */
    Linear slotFor(int32 e) {
        if (this.slots != null && this.slots[e] != null) {
            return this.slots[e];
        }
        if (this.slabDev == null) { return null; }
        if (this.slots == null) {
            this.slotOwn = heap ArrayList<Linear>();
            this.slots = heap Linear[this.expertsN];
            this.refused #= heap boolean[this.expertsN];
            this.slotCharge #= heap int64[this.expertsN];
        }
        Linear sl = heap Linear(this.colsN, this.rowsN);
        KernelBuffer<int8> sliceV #= this.slabDev.slice(
            (uint64) ((int64) e * this.stride),
            (uint64) this.stride);
        sl.bindExpertSlice(this.packedTy, this.stride, #sliceV);
        this.slots[e] = sl;
        this.slotOwn.add(#sl);
        this.slotCharge[e] = sl.devWeightBytes();
        this.residentB = this.residentB + this.slotCharge[e];
        this.admittedN = this.admittedN + 1;
        ExpertBank.resUsed = ExpertBank.resUsed + this.slotCharge[e];
        return this.slots[e];
    }

    void admitAndRun(int32 e, int32 m, Tensor<float32> dst,
            int64 dstOff) {
        // Unit 40: the bank binds as a slab on FIRST TOUCH when the
        // budget covers it — one upload for the whole bank instead of
        // one per admitted expert, and the very buffer the indirected
        // decode dispatch reads. No-ops once bound or refused.
        this.ensureSlab();
        if (this.slots == null) {
            this.slotOwn = heap ArrayList<Linear>();
            this.slots = heap Linear[this.expertsN];
            this.refused #= heap boolean[this.expertsN];
            this.slotCharge #= heap int64[this.expertsN];
        }
        if (this.slabDev != null) {
            // Unit 40: the slot is a zero-copy VIEW of the bank slab —
            // no staging read, no upload, no charge of its own (the
            // slab already carries the bank's bytes on the budget).
            Linear sv = this.slotFor(e);
            sv.matmulInto(m, dst, dstOff);
            return;
        }
        Linear sl = heap Linear(this.colsN, this.rowsN);
        sl.bindExpertSlot(this.packedTy, this.stride);
        this.map.read(this.mapOff + (int64) e * this.stride,
            this.eStage, 0L, this.stride);
        sl.stageExpertSlot(this.eStage);
        this.touched[e] = this.touched[e] + this.stride;
        sl.matmulInto(m, dst, dstOff);
        int64 charge = sl.devWeightBytes();
        if (ExpertBank.resUsed + charge > ExpertBank.resBudget) {
            this.refused[e] = true;
            ExpertBank.resWindowed = ExpertBank.resWindowed + 1L;
            return;
        }
        this.slots[e] = sl;
        this.slotOwn.add(#sl);
        this.slotCharge[e] = charge;
        this.residentB = this.residentB + charge;
        this.admittedN = this.admittedN + 1;
        ExpertBank.resUsed = ExpertBank.resUsed + charge;
        ExpertBank.resAdmissions = ExpertBank.resAdmissions + 1L;
        ExpertBank.resAdmissionBytes =
            ExpertBank.resAdmissionBytes + charge;
        return;
    }

    /**
     * Decode mat-vec for expert `e` against its RESIDENT slot, on the
     * device (spec 3.3.1). Returns false when the expert is not
     * admitted or the slot has no device mat-vec route — the caller
     * takes the host path, which is the T0 floor and the mixed-step
     * rule (3.3.2): each expert takes its own arm. Touches no mapping
     * bytes; the charge is reconciled like every slot hit.
     */
    public boolean matvecDeviceAt(int32 e, float32[] x, int64 xOff,
            float32[] y, int64 yOff) {
        if (!this.isAdmitted(e)) { return false; }
        Linear sl = this.slotFor(e);
        if (!sl.deviceLaunchable()) { return false; }
        ExpertBank.resHits = ExpertBank.resHits + 1L;
        sl.matvecIntoDevice(x, xOff, y, yOff);
        int64 now = sl.devWeightBytes();
        if (now != this.slotCharge[e]) {
            int64 d = now - this.slotCharge[e];
            this.slotCharge[e] = now;
            this.residentB = this.residentB + d;
            ExpertBank.resUsed = ExpertBank.resUsed + d;
            ExpertBank.resAdmissionBytes =
                ExpertBank.resAdmissionBytes + d;
        }
        return true;
    }

    /**
     * Unit 39: the device-chain launch. The slot consumes the SHARED
     * staged activation (`Linear.stageDeviceActivation`) and leaves y
     * in its own device buffer (`outOf`), a stream launch with no
     * download — the crossing this replaces paid one per mat-vec.
     * False means not admitted or not launchable: the caller runs the
     * host mid-chain fallback (the mixed regime, 39.2.3).
     */
    public boolean matvecStagedKeepAt(int32 e) {
        if (!this.isAdmitted(e)) { return false; }
        Linear sl = this.slotFor(e);
        if (!sl.deviceLaunchable()) { return false; }
        ExpertBank.resHits = ExpertBank.resHits + 1L;
        sl.matvecStagedKeep();
        int64 now = sl.devWeightBytes();
        if (now != this.slotCharge[e]) {
            int64 d = now - this.slotCharge[e];
            this.slotCharge[e] = now;
            this.residentB = this.residentB + d;
            ExpertBank.resUsed = ExpertBank.resUsed + d;
            ExpertBank.resAdmissionBytes =
                ExpertBank.resAdmissionBytes + d;
        }
        return true;
    }

    /** Whether {@link #matvecStagedKeepAt} would serve expert `e`. */
    public boolean stagedKeepReady(int32 e) {
        if (!this.isAdmitted(e)) { return false; }
        Linear sl = this.slotFor(e);
        return sl != null && sl.deviceLaunchable();
    }

    /** Expert `e`'s device output buffer (valid after a staged-keep
     *  launch; sized outDim). */
    public KernelBuffer<float32> outOf(int32 e) {
        return this.slots[e].out();
    }

    /** Zero the per-expert byte counters (one measurement window). */
    public void resetTouched() {
        int32 e = 0;
        while (e < this.expertsN) {
            this.touched[e] = 0L;
            e = e + 1;
        }
        return;
    }

    /** Slab bytes served for expert `e` since the last reset. */
    public int64 touchedBytes(int32 e) {
        return this.touched[e];
    }

    public int32 experts() {
        return this.expertsN;
    }

    public int32 rows() {
        return this.rowsN;
    }

    public int32 cols() {
        return this.colsN;
    }

    public int32 packedType() {
        return this.packedTy;
    }

    /** Bytes from one expert's first block to the next expert's. */
    public int64 strideBytes() {
        return this.stride;
    }

    /** Expert `e`'s view: an offset into THE slab, nothing copied. */
    public int64 offsetBytes(int32 e) {
        return (int64) e * this.stride;
    }

    /** Read expert `e`'s stride through the mapping into the reused
     *  staging buffer — the ONE place slab bytes are read (15.16), and
     *  the mechanism that keeps residency at the touched working set
     *  (15.19): the page cache holds what was read, and the OS may
     *  drop it. */
    int8[] stageExpert(int32 e) {
        int64 got = this.map.read(this.mapOff + (int64) e * this.stride,
            this.eStage, 0L, this.stride);
        if (got != this.stride) {
            throw heap LlmException("moe: mapped read of expert " + e
                + " returned " + got + " of " + this.stride + " bytes");
        }
        return this.eStage;
    }

    /** Total slab bytes addressed (never held resident by this class —
     *  15.19's claim in a form a test can assert). */
    public int64 bytesHeld() {
        return (int64) this.expertsN * this.stride;
    }

    /** Device bytes this bank holds: ZERO until the first routed
     *  group builds the expert window, then exactly one stride —
     *  never a slab (15.19). */
    public int64 deviceWindowBytes() {
        return this.winLin == null ? 0L : this.stride;
    }
}
