package dev.cajeta.llm.model;

import cajeta.lang.Math;
import cajeta.time.Clock;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.Checkpoint;

/**
 * The MoE replacement for a layer's dense FFN (spec 15.1): a router
 * plus three expert banks, and — when the checkpoint ships one — a
 * dense shared expert with its own learned sigmoid gate (15.18,
 * qwen2moe's shape; qwen3moe declares its shared width as 0 and binds
 * none).
 *
 * Unit 26 scope: this BINDS. The sparse forward is plan unit 27, and
 * until it lands `CausalLM` refuses to forward an MoE model rather
 * than silently computing garbage through a dense path that no longer
 * exists.
 *
 * Binding is by ggml tensor names directly (`blk.N.ffn_gate_exps…`):
 * MoE checkpoints are GGUF-only (spec §15's scope), and the merged
 * slab names have no torch state_dict equivalent to map from.
 */
public final class MoeFfn extends InfModule {

    Linear router;             // ffn_gate_inp: [experts, hidden] f32
    int32 layerIdx;    // moe-cache unit 3: record attribution; -1 until set
    KernelBuffer<float32> crossDev;   // unit 39: mixed-regime eOut up-leg
    float32[] crossHost;              // unit 39: contiguous copy for upload

    // ── Unit 40: the zero-sync route's device state (lazy; decode
    // pays nothing until the slab path engages). ──
    KernelBuffer<float32> logitsDev;   // router logits, [E]
    KernelBuffer<float32> probsDev;    // top-k scratch, [E]
    KernelBuffer<int32> selDev;        // selected ids, [used]
    KernelBuffer<float32> wSelDev;     // combining weights, [used]
    KernelBuffer<float32> gyDev;       // gate outputs, [used x width]
    KernelBuffer<float32> uyDev;       // up outputs, [used x width]
    KernelBuffer<float32> dyDev;       // down outputs, [used x hidden]
    KernelBuffer<int8> xpXnDev;        // staged activation, per token
    KernelBuffer<int8> xpGyDev;        // staged GLU'd middle, [used rows]
    KernelBuffer<float32> routerWDev;  // router weight, f32 [in x E]
    boolean routerWUp;
    KernelBuffer<float32> lgBatchDev;  // unit 41: [rows x E] logits
    float32[] lgBatchH;                // host twin for the select
    KernelBuffer<float32> xRowsDev;    // unit 41: [rows x H] upload
    int64 lgBatchCap;                  // rows the pair is sized for
    float32[] xRowsH;                  // staging copy (pooled x bases)
    // ── Unit 41b: the fully device-resident batch FFN. ──
    int32[] rowSlotH;                  // pick k of row r -> group slot
    // ONE set for the whole process, not one per layer (unit 43):
    // layers run in stream order and every buffer here is dead once
    // the layer's output folds into the residual. Per-layer copies
    // measured 48 first-use allocations in the pass after admission
    // (229 ms of a 1206 ms pass) and held ~5 GB of device scratch for
    // the 30B. Re-use is safe because every writer is either a launch
    // on the one in-order stream (the unit-45 device-routed path) or
    // a host upload that follows routeBatchCore's drain (the host-
    // routed path); an upload on a path with no sync would race the
    // previous layer's queued readers.
    static KernelBuffer<int32> gRowDev;       // group slot -> source row
    static KernelBuffer<float32> gWDev;       // group slot -> combine weight
    static KernelBuffer<int32> rowSlotDev;
    static KernelBuffer<float32> bxDev;       // gathered rows, [np x hidden]
    static KernelBuffer<float32> bgDev;       // gate outputs, [np x width]
    static KernelBuffer<float32> buDev;       // up outputs, [np x width]
    static KernelBuffer<float32> beDev;       // down outputs, [np x hidden]
    static KernelBuffer<float32> obDev;       // combined output, [rows x hidden]
    static int64 devBatchCap;                 // np the buffers are sized for
    static int64 devBatchH;                   // ... and the hidden width
    static int64 devBatchW;                   // ... and the expert width
    static int32 devBatchE;                   // ... and the expert count
    // ── Unit 41d: the indirected one-launch-per-bank GEMM. ──
    static int32[] mapEH;
    static int32[] mapT0H;
    static int32[] mapM1H;
    static KernelBuffer<int32> mapEDev;
    static KernelBuffer<int32> mapT0Dev;
    static KernelBuffer<int32> mapM1Dev;
    // Unit 44: the 64-row-chunk maps for the multi-wave id-GEMM.
    static int32[] map64EH;
    static int32[] map64T0H;
    static int32[] map64M1H;
    static KernelBuffer<int32> map64EDev;
    static KernelBuffer<int32> map64T0Dev;
    static KernelBuffer<int32> map64M1Dev;
    // Unit 45: the device-routed batch — picks, weights and the chunk
    // count never come to the host.
    static KernelBuffer<int32> selAllDev;
    static KernelBuffer<float32> wAllDev;
    static KernelBuffer<int32> metaDev;
    static int32[] metaH;
    static int64 fbZeroSyncRoutes;   // batches routed fully on the device
    public static int64 batchZeroSyncRoutes() { return MoeFfn.fbZeroSyncRoutes; }
    static KernelBuffer<int8> xpBxDev;        // packed batch activations
    static KernelBuffer<int8> xpBgDev;        // packed GLU'd middle

    // ── forwardRow phase split (parity attribution, decode). ──
    static int64 mtRouteNs;    // router matvec + softmax + top-k
    static int64 mtGateUpNs;   // gate + up expert mat-vecs
    static int64 mtGluNs;      // host GLU fold
    static int64 mtDownNs;     // down expert mat-vecs
    static int64 mtCombNs;     // weighted accumulate into the row
    static int64 mtSharedNs;   // shared-expert sublayer
    static int64 mtPreNs;      // zero-sync: entry -> first launch stamp
    static int64 mtPostNs;     // zero-sync: after combine -> exit
    public static int64 rowPreNs()  { return MoeFfn.mtPreNs; }
    public static int64 rowPostNs() { return MoeFfn.mtPostNs; }
    static int64 fbGemm1Ns;    // 41d probe: gather+pack+gate+up (GPU-incl under phaseSync)
    static int64 fbGemm2Ns;    // 41d probe: glu+pack+down
    static int64 fbTailNs;     // 41d probe: scatter-combine
    static int64 fbPreNs;      // route end -> g1 stamp (ensure*, uploads)
    static int64 fbUplNs;      // ... of which the three map uploads
    static int64 fbPreA; static int64 fbPreB; static int64 fbPreC; static int64 fbPreD;
    static int64 fbEdbAllocs;
    public static int64 batchEdbAllocs() { return MoeFfn.fbEdbAllocs; }
    public static int64 batchPreA() { return MoeFfn.fbPreA; }
    public static int64 batchPreB() { return MoeFfn.fbPreB; }
    public static int64 batchPreC() { return MoeFfn.fbPreC; }
    public static int64 batchPreD() { return MoeFfn.fbPreD; }
    public static int64 batchUplNs()   { return MoeFfn.fbUplNs; }
    public static int64 batchPreNs()   { return MoeFfn.fbPreNs; }
    public static int64 batchGemm1Ns() { return MoeFfn.fbGemm1Ns; }
    public static int64 batchGemm2Ns() { return MoeFfn.fbGemm2Ns; }
    public static int64 batchTailNs()  { return MoeFfn.fbTailNs; }
    static int64 fbRouteNs;    // unit 41: forwardBatch routing span
    static int64 fbRouteHostNs;// ... its host part: after the sync
    static int64 fbDevRoutes;  // batched device router engagements
    static int64 fbHostRoutes; // per-row host fallbacks
    public static int64 batchRouteNs()   { return MoeFfn.fbRouteNs; }
    public static int64 batchRouteHostNs() { return MoeFfn.fbRouteHostNs; }
    /** Zeroes the forwardBatch phase timers (bench windows). */
    public static void resetBatchTimers() {
        MoeFfn.fbGemm1Ns = 0L;
        MoeFfn.fbGemm2Ns = 0L;
        MoeFfn.fbTailNs = 0L;
        MoeFfn.fbPreNs = 0L;
        MoeFfn.fbUplNs = 0L;
        MoeFfn.fbPreA = 0L; MoeFfn.fbPreB = 0L; MoeFfn.fbPreC = 0L; MoeFfn.fbPreD = 0L;
        MoeFfn.fbRouteNs = 0L;
        MoeFfn.fbRouteHostNs = 0L;
        return;
    }
    public static int64 batchDevRoutes() { return MoeFfn.fbDevRoutes; }
    public static int64 batchHostRoutes(){ return MoeFfn.fbHostRoutes; }
    static int64 mtPreANs;     // ... zeroSyncReady
    static int64 mtPreBNs;     // ... counter snapshots
    public static int64 rowPreANs() { return MoeFfn.mtPreANs; }
    public static int64 rowPreBNs() { return MoeFfn.mtPreBNs; }
    public static int64 rowRouteNs()  { return MoeFfn.mtRouteNs; }
    public static int64 rowGateUpNs() { return MoeFfn.mtGateUpNs; }
    public static int64 rowGluNs()    { return MoeFfn.mtGluNs; }
    public static int64 rowDownNs()   { return MoeFfn.mtDownNs; }
    public static int64 rowCombNs()   { return MoeFfn.mtCombNs; }
    public static int64 rowSharedNs() { return MoeFfn.mtSharedNs; }
    public static void resetRowTimers() {
        MoeFfn.mtPreNs = 0L;
        MoeFfn.mtPostNs = 0L;
        MoeFfn.mtPreANs = 0L;
        MoeFfn.mtPreBNs = 0L;
        MoeFfn.mtRouteNs = 0L;
        MoeFfn.mtGateUpNs = 0L;
        MoeFfn.mtGluNs = 0L;
        MoeFfn.mtDownNs = 0L;
        MoeFfn.mtCombNs = 0L;
        MoeFfn.mtSharedNs = 0L;
        return;
    }
    ExpertBank gateB;
    ExpertBank upB;
    ExpertBank downB;
    Linear sharedGateProj;     // null when the model has no shexp
    Linear sharedUpProj;
    Linear sharedDownProj;
    Tensor<float32> sharedGate; // ffn_gate_inp_shexp [hidden], or null

    int32 expertsN;
    int32 usedN;
    int32 gating;              // gguf enum: 1 softmax, 2 sigmoid
    boolean normTopk;          // renormalize top-k weights by sum
    float32 wScale;            // 0 = none
    int32 sharedW;             // shared expert width, 0 = none
    MoeScratch sc;             // NOT a parameter (plain class ref)
    int32 widthN;              // resolved at bind (config key or slab)
    int32 hidden;

    MoeFfn(ModelConfig cfg) {
        if (cfg.expertGating != 1) {
            // 15.4/15.13: sigmoid (2) and softmax-after-top-k (3)
            // exist in the key's enum but NO witness file carries
            // them; a wrong gating function is fluent wrong output,
            // so an unwitnessed value refuses instead of guessing.
            String nm = "" + cfg.expertGating;
            if (cfg.expertGating == 2) {
                nm = "sigmoid (2)";
            }
            throw heap LlmException("moe: expert_gating_func " + nm
                + " has no witness model; only softmax (1) is "
                + "implemented (spec 15.4; 15.13 defers the rest "
                + "until a witness exists)");
        }
        this.gating = cfg.expertGating;
        this.normTopk = cfg.expertNormTopk;
        this.wScale = cfg.expertScale;
        this.sharedW = 0;
        this.sc = null;
        this.expertsN = cfg.expertCount;
        this.usedN = cfg.expertUsedCount;
        this.widthN = cfg.expertFfn;   // 0 = derive from the slab
        this.hidden = cfg.hiddenSize;
        this.router = heap Linear(cfg.hiddenSize, cfg.expertCount);
        this.layerIdx = 0 - 1;
        this.gateB = heap ExpertBank();
        this.upB = heap ExpertBank();
        this.downB = heap ExpertBank();
        this.sharedGateProj = null;
        this.sharedUpProj = null;
        this.sharedDownProj = null;
        this.sharedGate = null;
        return;
    }

    /** `gp` is the layer's ggml prefix, `blk.<i>.`. */
    void bind(Checkpoint ckpt, String gp, boolean toDevice) {
        if (!ckpt.contains(gp + "ffn_gate_exps.weight")) {
            if (ckpt.contains(gp + "ffn_gate.0.weight")) {
                // 15.17: the pre-2024-04 llama.cpp layout, one tensor
                // per expert. Refused NAMING THE FIX — files in this
                // layout stopped being produced, and supporting both
                // would double every dispatch test.
                throw heap LlmException("moe: this checkpoint uses the "
                    + "legacy split-expert layout ('" + gp
                    + "ffn_gate.0.weight' — one tensor per expert, "
                    + "pre-2024-04 llama.cpp); use a merged-slab "
                    + "requant of the same model instead (e.g. "
                    + "mradermacher's builds carry the merged "
                    + "ffn_gate_exps form)");
            }
            throw heap LlmException("moe: '" + gp + "ffn_gate_exps."
                + "weight' is missing — the config declares "
                + this.expertsN + " experts but the checkpoint carries "
                + "no merged expert slab");
        }
        this.gateB.bind(ckpt, gp + "ffn_gate_exps.weight",
            this.expertsN, this.widthN, this.hidden);
        if (this.widthN == 0) {
            // qwen2moe ships no expert-width key: the slab is the
            // authority (measured on the witness, 2026-08-31).
            this.widthN = this.gateB.rows();
        }
        this.upB.bind(ckpt, gp + "ffn_up_exps.weight",
            this.expertsN, this.widthN, this.hidden);
        this.downB.bind(ckpt, gp + "ffn_down_exps.weight",
            this.expertsN, this.hidden, this.widthN);
        this.router.bind(ckpt, gp + "ffn_gate_inp.weight", false);

        if (ckpt.contains(gp + "ffn_gate_shexp.weight")) {
            // The shared expert's width comes from its own tensor —
            // there is no reliable key (qwen2moe reuses
            // feed_forward_length, qwen3moe writes 0).
            int64[] shp = ckpt.shapeOf(gp + "ffn_gate_shexp.weight");
            if (shp == null || (int32) shp.count() != 2) {
                throw heap LlmException("moe: '" + gp
                    + "ffn_gate_shexp.weight' is not rank 2");
            }
            int32 sw = (int32) shp[0];
            this.sharedW = sw;
            this.sharedGateProj = heap Linear(this.hidden, sw);
            this.sharedUpProj = heap Linear(this.hidden, sw);
            this.sharedDownProj = heap Linear(sw, this.hidden);
            this.sharedGateProj.bind(ckpt, gp + "ffn_gate_shexp.weight",
                toDevice);
            this.sharedUpProj.bind(ckpt, gp + "ffn_up_shexp.weight",
                toDevice);
            this.sharedDownProj.bind(ckpt, gp + "ffn_down_shexp.weight",
                toDevice);
            if (ckpt.contains(gp + "ffn_gate_inp_shexp.weight")) {
                Tensor<float32> g #= ckpt.loadF32(
                    gp + "ffn_gate_inp_shexp.weight");
                this.sharedGate #= g;
            }
        }
        this.sc = heap MoeScratch(this.expertsN, this.usedN,
            this.widthN, this.hidden, this.sharedW);
        return;
    }

    /**
     * Router selection for one activation row (15.5–15.8): logits
     * through the gating function over ALL experts, top-`used` by
     * gating probability (ties to the LOWER index, argsort's order),
     * combining weights the selected probabilities — renormalized by
     * their clamped sum when the arch says so (qwen3moe, Mixtral) and
     * NOT when it says not (qwen2moe), scaled only when the file
     * carries a scale. Semantics measured against llama.cpp's
     * build_moe_ffn, 2026-08-31.
     */
    public void routeInto(Tensor<float32> x, int64 xOff,
            int32[] selOut, float32[] wOut) {
        this.router.matvecInto(x, xOff, this.sc.logits, 0L);
        this.routeFromLogits(this.sc.logits.hostBuffer(),
            this.sc.logits.hostBase(), selOut, wOut);
        return;
    }

    /** The selection tail of {@link #routeInto} over one host logits
     *  row — shared by the per-row path and the batched device router
     *  (unit 41), so the two cannot drift. */
    void routeFromLogits(float32[] lb, int64 lo, int32[] selOut,
            float32[] wOut) {
        // Softmax over all experts (gating 1 — the ctor refused the
        // rest). Selection order is unchanged by the monotone map, but
        // the COMBINING WEIGHTS are these probabilities, so the full
        // softmax is load-bearing even without renormalization.
        float32 mx = lb[lo];
        int32 e = 1;
        while (e < this.expertsN) {
            if (lb[lo + (int64) e] > mx) {
                mx = lb[lo + (int64) e];
            }
            e = e + 1;
        }
        float32 sum = 0.0f;
        e = 0;
        while (e < this.expertsN) {
            float32 p = Math.exp(lb[lo + (int64) e] - mx);
            this.sc.probs[e] = p;
            sum = sum + p;
            e = e + 1;
        }
        e = 0;
        while (e < this.expertsN) {
            this.sc.probs[e] = this.sc.probs[e] / sum;
            e = e + 1;
        }
        // Top-k by probability, strict > so ties keep the lower index.
        int32 k = 0;
        while (k < this.usedN) {
            int32 best = 0 - 1;
            float32 bp = 0.0f;
            e = 0;
            while (e < this.expertsN) {
                if (this.sc.probs[e] >= 0.0f
                        && (best < 0 || this.sc.probs[e] > bp)) {
                    best = e;
                    bp = this.sc.probs[e];
                }
                e = e + 1;
            }
            selOut[k] = best;
            wOut[k] = bp;
            this.sc.probs[best] = 0.0f - 1.0f;   // taken
            k = k + 1;
        }
        if (this.normTopk) {
            float32 ws = 0.0f;
            k = 0;
            while (k < this.usedN) {
                ws = ws + wOut[k];
                k = k + 1;
            }
            // llama.cpp clamps the divisor at the smallest f16 normal.
            if (ws < 0.00006103515625f) {
                ws = 0.00006103515625f;
            }
            k = 0;
            while (k < this.usedN) {
                wOut[k] = wOut[k] / ws;
                k = k + 1;
            }
        }
        if (this.wScale != 0.0f && this.wScale != 1.0f) {
            k = 0;
            while (k < this.usedN) {
                wOut[k] = wOut[k] * this.wScale;
                k = k + 1;
            }
        }
        return;
    }

    /**
     * One token's MoE FFN on the host (15.9–15.11, 15.18):
     * `out = Σ_k w_k · down_k(act(gate_k(x)) · up_k(x))`, plus the gated
     * shared expert when the checkpoint ships one. Writes (does not
     * accumulate) `hidden` floats at `out[outOff]`. `act` is the layer's
     * GLU activation. Only the SELECTED experts' bank bytes are read —
     * that is 15.16's sparsity claim, and ExpertBank's counters at the
     * mat-vec seam are its instrument.
     */
    /**
     * Unit 41: routing for a whole prefill chunk in ONE device GEMM —
     * logits for every (row, expert) land in one download, and the
     * selection tail runs per row on the host through the exact code
     * the per-row path uses. The 512-row host loop this replaces was
     * ~70% of the steady prefill (512 x 48 scalar router mat-vecs).
     * False = caller keeps the per-row host loop (cpu backend, or the
     * router weights cannot device-arm).
     */
    boolean routeBatchInto(Tensor<float32> x, int32 rows,
            int32[] selAll, float32[] wAll) {
        if (!Linear.residentEnabled()) { return false; }
        // The exact-host control arms (tests) pin routing off; the
        // batched device router must honor the same switch.
        if (!QuantKernel.routingEnabled()) { return false; }
        this.ensureRouterDev();
        int64 en = (int64) this.expertsN;
        int64 h = (int64) this.hidden;
        if (this.lgBatchCap < (int64) rows) {
            this.lgBatchDev #= heap KernelBuffer<float32>(
                (uint64) ((int64) rows * en));
            this.lgBatchH #= heap float32[(int64) rows * en];
            this.xRowsDev #= heap KernelBuffer<float32>(
                (uint64) ((int64) rows * h));
            this.xRowsH #= heap float32[(int64) rows * h];
            this.lgBatchCap = (int64) rows;
        }
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase();
        // The chunk's rows are contiguous in `x`. Pooled tensors carry
        // a nonzero base and upload() has no offset form, so the rows
        // go through one staging copy (~1 ms per layer against the
        // ~90 ms of scalar routing this path replaces).
        if (xo == 0L) {
            this.xRowsDev.upload(xb, (int64) rows * h);
        } else {
            int64 n = (int64) rows * h;
            int64 ci = 0;
            while (ci < n) {
                this.xRowsH[ci] = xb[xo + ci];
                ci = ci + 1;
            }
            this.xRowsDev.upload(this.xRowsH, n);
        }
        this.routeBatchCore(this.xRowsDev, rows, selAll, wAll);
        return true;
    }

    /** The device half of {@link #routeBatchInto}, over rows already
     *  resident in `xDev` — the res arm routes straight off its normed
     *  activation buffer with no crossing at all (unit 41). Caller
     *  guarantees ensureRouterDev and the batch buffers. */
    void routeBatchCore(KernelBuffer<float32> xDev, int32 rows,
            int32[] selAll, float32[] wAll) {
        int64 en = (int64) this.expertsN;
        int64 h = (int64) this.hidden;
        QuantKernel.routerBatchF32LaunchNoSync(this.lgBatchDev,
            this.routerWDev, xDev, (int64) rows, en, h);
        KernelStream rs = QuantKernel.stream();
        rs.sync();
        int64 rh0 = Clock.nanoTime();
        this.lgBatchDev.download(this.lgBatchH, (int64) rows * en);
        int32 r = 0;
        while (r < rows) {
            this.routeFromLogits(this.lgBatchH, (int64) r * en,
                this.sc.sel, this.sc.w);
            int32 k = 0;
            while (k < this.usedN) {
                selAll[r * this.usedN + k] = this.sc.sel[k];
                wAll[r * this.usedN + k] = this.sc.w[k];
                k = k + 1;
            }
            r = r + 1;
        }
        MoeFfn.fbRouteHostNs = MoeFfn.fbRouteHostNs
            + (Clock.nanoTime() - rh0);
        return;
    }

    /**
     * Unit 39 (spec 15.21.2, the expert half): the expert chain never
     * leaves the device. Routing runs on the HOST from `x` — the
     * caller's crossing already downloaded the normed activation for
     * exactly this — and each selected expert then chains
     * stage(x) -> gate -> up -> GLU -> stage(g) -> down -> axpby as
     * NoSync stream launches against its slots, accumulating into
     * `acc` (beta=0 on the first write). Nothing crosses per expert;
     * the caller folds `acc` into the residual with one addDevice.
     *
     * The MIXED regime (39.2.3): an expert without a launchable slot
     * runs its mat-vecs on the host from `x` — the windowed path,
     * counted as such — and its eOut goes up once and joins the same
     * accumulation. The stream is drained before that upload: the
     * previous expert's queued launches may still be reading the
     * shared stage and the scratch buffer.
     *
     * Returns false — take the unit-38 whole-host crossing — when the
     * model has a shared expert (a host-only sublayer today, qwen2moe;
     * the 30B and the qwen3moe fixture have none).
     */
    boolean forwardRowResident(KernelBuffer<float32> xDev,
            Tensor<float32> x, int64 xOff, KernelBuffer<float32> acc,
            int32 act) {
        if (this.sharedW != 0) { return false; }
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        int64 tr0 = Clock.nanoTime();
        this.routeInto(x, xOff, this.sc.sel, this.sc.w);
        MoeFfn.mtRouteNs = MoeFfn.mtRouteNs + (Clock.nanoTime() - tr0);
        int64 hid = (int64) this.hidden;
        int64 wid = (int64) this.widthN;
        boolean first = true;
        int32 k = 0;
        while (k < this.usedN) {
            int32 e = this.sc.sel[k];
            float32 w = this.sc.w[k];
            int64 tg0 = Clock.nanoTime();
            if (this.gateB.stagedKeepReady(e)
                    && this.upB.stagedKeepReady(e)
                    && this.downB.stagedKeepReady(e)) {
                Linear.stageDeviceActivation(xDev, hid);
                this.gateB.matvecStagedKeepAt(e);
                this.upB.matvecStagedKeepAt(e);
                MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs
                    + (Clock.nanoTime() - tg0);
                int64 tgl0 = Clock.nanoTime();
                Prim.gluDevice(this.gateB.outOf(e), this.upB.outOf(e),
                    wid, act);
                MoeFfn.mtGluNs = MoeFfn.mtGluNs
                    + (Clock.nanoTime() - tgl0);
                int64 td0 = Clock.nanoTime();
                Linear.stageDeviceActivation(this.gateB.outOf(e), wid);
                this.downB.matvecStagedKeepAt(e);
                MoeFfn.mtDownNs = MoeFfn.mtDownNs
                    + (Clock.nanoTime() - td0);
                int64 tc0 = Clock.nanoTime();
                Prim.axpbyDevice(acc, this.downB.outOf(e), w,
                    first ? 0.0f : 1.0f, hid);
                MoeFfn.mtCombNs = MoeFfn.mtCombNs
                    + (Clock.nanoTime() - tc0);
            } else {
                // Host mid-chain: exactly the windowed forwardRow body
                // for this one expert, then one upload into the same
                // accumulation.
                float32[] xb = x.hostBuffer();
                int64 xo = x.hostBase() + xOff;
                float32[] gb = this.sc.g.hostBuffer();
                int64 go = this.sc.g.hostBase();
                float32[] eb = this.sc.eOut.hostBuffer();
                int64 eo = this.sc.eOut.hostBase();
                this.gateB.matvecAt(e, xb, xo, gb, go);
                this.upB.matvecAt(e, xb, xo,
                    this.sc.u.hostBuffer(), this.sc.u.hostBase());
                MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs
                    + (Clock.nanoTime() - tg0);
                int64 tgl0 = Clock.nanoTime();
                Prim.gluRowHost(this.sc.g, 0L, this.sc.u, 0L,
                    this.sc.g, 0L, this.widthN, act);
                MoeFfn.mtGluNs = MoeFfn.mtGluNs
                    + (Clock.nanoTime() - tgl0);
                int64 td0 = Clock.nanoTime();
                this.downB.matvecAt(e, gb, go, eb, eo);
                MoeFfn.mtDownNs = MoeFfn.mtDownNs
                    + (Clock.nanoTime() - td0);
                int64 tc0 = Clock.nanoTime();
                if (this.crossDev == null) {
                    this.crossDev #= heap KernelBuffer<float32>(
                        (uint64) hid);
                    this.crossHost #= heap float32[hid];
                }
                // Queued launches may still read the stage and the
                // scratch; the slow path pays the drain, not the fast
                // one.
                KernelStream cs = QuantKernel.stream();
                cs.sync();
                int64 ci = 0;
                while (ci < hid) {
                    this.crossHost[ci] = eb[eo + ci];
                    ci = ci + 1;
                }
                this.crossDev.upload(this.crossHost, hid);
                Prim.axpbyDevice(acc, this.crossDev, w,
                    first ? 0.0f : 1.0f, hid);
                MoeFfn.mtCombNs = MoeFfn.mtCombNs
                    + (Clock.nanoTime() - tc0);
            }
            first = false;
            k = k + 1;
        }
        this.emitCacheRecord("row", h0, w0, a0, b0);
        return true;
    }

    /** Probe: print the device routing buffers (bench triage). */
    public void dumpZeroSync() {
        if (this.logitsDev == null) {
            System.stdout.println("zero-sync never engaged");
            return;
        }
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32 en = this.expertsN;
        float32[] lg = heap float32[en];
        this.logitsDev.download(lg, (int64) en);
        int32[] ids = heap int32[this.usedN];
        this.selDev.download(ids, (int64) this.usedN);
        float32[] ww = heap float32[this.usedN];
        this.wSelDev.download(ww, (int64) this.usedN);
        String o #= "logits:";
        int32 i = 0;
        while (i < en) { o #= o + " " + lg[i]; i = i + 1; }
        System.stdout.println(o);
        o #= "sel/w:";
        i = 0;
        while (i < this.usedN) {
            o #= o + " " + ids[i] + ":" + ww[i];
            i = i + 1;
        }
        System.stdout.println(o);
        return;
    }

    /** Probe access to the gate bank (bench attribution only). */
    public ExpertBank gate() { return this.gateB; }

    // Bench: drain the stream before a phase stamp so the moe-phase
    // timers become GPU-inclusive (set via CausalLM.setPhaseSync).
    static boolean phaseSyncOn;
    public static void setPhaseSync(boolean on) {
        MoeFfn.phaseSyncOn = on;
    }
    static void phaseSync() {
        if (!MoeFfn.phaseSyncOn) { return; }
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * Upload the router weight, TRANSPOSED to [E, H] so the device
     * kernel's lanes stride a row coalesced (the import layout is
     * [in, out]). Once per layer. The first version of this ran
     * lazily on the FIRST DECODE TOKEN through Tensor.flatGet —
     * 48 x ~4.7 ms = ~225 ms of phantom decode time that measurement
     * attributed before reasoning found it; now it reads the raw host
     * buffer and forwardBatch arms it during prefill, where a
     * quarter-second disappears into the seconds a prefill costs.
     */
    void ensureRouterDev() {
        if (this.routerWUp) { return; }
        int64 hid = (int64) this.hidden;
        int64 en = (int64) this.expertsN;
        int64 n = hid * en;
        float32[] rw #= heap float32[n];
        Tensor<float32> rt = this.router.weight;
        float32[] rb = rt.hostBuffer();
        int64 rbase = rt.hostBase();
        int64 j = 0;
        while (j < hid) {
            int64 e = 0;
            while (e < en) {
                rw[e * hid + j] = rb[rbase + j * en + e];
                e = e + 1;
            }
            j = j + 1;
        }
        this.routerWDev #= heap KernelBuffer<float32>((uint64) n);
        this.routerWDev.upload(rw, n);
        this.routerWUp = true;
        return;
    }

    void ensureZeroSyncBufs() {
        if (this.logitsDev != null) { return; }
        int64 e = (int64) this.expertsN;
        int64 u = (int64) this.usedN;
        int64 wid = (int64) this.widthN;
        int64 hid = (int64) this.hidden;
        this.logitsDev #= heap KernelBuffer<float32>((uint64) e);
        this.probsDev #= heap KernelBuffer<float32>((uint64) e);
        this.selDev #= heap KernelBuffer<int32>((uint64) u);
        this.wSelDev #= heap KernelBuffer<float32>((uint64) u);
        this.gyDev #= heap KernelBuffer<float32>((uint64) (u * wid));
        this.uyDev #= heap KernelBuffer<float32>((uint64) (u * wid));
        this.dyDev #= heap KernelBuffer<float32>((uint64) (u * hid));
        this.xpXnDev #= heap KernelBuffer<int8>(
            (uint64) ((hid / 256L) * 320L));
        this.xpGyDev #= heap KernelBuffer<int8>(
            (uint64) ((u * wid / 256L) * 320L));
        return;
    }

    /** The zero-sync route's shape gate (cheap; the slab binds are the
     *  expensive half and latch their own refusal). */
    boolean zeroSyncReady() {
        if (this.sharedW != 0) { return false; }
        if (this.gating != 1) { return false; }
        if (this.hidden % 256 != 0) { return false; }
        if (this.widthN % 256 != 0) { return false; }
        if (!this.gateB.idReady() || !this.upB.idReady()
                || !this.downB.idReady()) {
            return false;
        }
        if (!this.gateB.ensureSlab() || !this.upB.ensureSlab()
                || !this.downB.ensureSlab()) {
            return false;
        }
        return true;
    }

    /**
     * Unit 40 (spec 15.21.2/15.21.3): the WHOLE MoE FFN as stream
     * launches — router mat-vec, softmax/top-k, one indirected launch
     * per bank against its slab, GLU and the weighted combine — with
     * sel/w living on the device and NOTHING crossing to the host. The
     * caller adds `acc` onto the residual; the token's only sync stays
     * the logits fetch at the tail. False = the caller keeps the
     * unit-39 chain (host routing through the crossing) or the
     * unit-38 whole-host crossing.
     */
    boolean forwardRowZeroSync(KernelBuffer<float32> xDev,
            KernelBuffer<float32> acc, int32 act) {
        int64 tpre0 = Clock.nanoTime();
        if (!this.zeroSyncReady()) { return false; }
        int64 tpa = Clock.nanoTime();
        MoeFfn.mtPreANs = MoeFfn.mtPreANs + (tpa - tpre0);
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        MoeFfn.mtPreBNs = MoeFfn.mtPreBNs + (Clock.nanoTime() - tpa);
        this.ensureZeroSyncBufs();
        int64 hid = (int64) this.hidden;
        int64 wid = (int64) this.widthN;
        this.ensureRouterDev();
        int64 tr0 = Clock.nanoTime();
        MoeFfn.mtPreNs = MoeFfn.mtPreNs + (tr0 - tpre0);
        QuantKernel.routerF32MatVecLaunchNoSync(this.logitsDev,
            this.routerWDev, xDev, (int64) this.expertsN, hid);
        QuantKernel.moeTopKLaunchNoSync(this.selDev, this.wSelDev,
            this.logitsDev, this.probsDev, (int64) this.expertsN,
            (int64) this.usedN, this.normTopk, this.wScale);
        MoeFfn.phaseSync();
        MoeFfn.mtRouteNs = MoeFfn.mtRouteNs + (Clock.nanoTime() - tr0);
        int64 tg0 = Clock.nanoTime();
        QuantKernel.q8kPackLaunchNoSync(this.xpXnDev, xDev, hid);
        // Unit 48: gate + up + GLU in one launch when both banks are
        // Q4_K slabs; the three-launch chain stays as the fallback.
        boolean fusedGu = ExpertBank.idGateUpGlu(this.gateB, this.upB,
            this.gyDev, this.xpXnDev, this.selDev, this.usedN, act);
        if (!fusedGu) {
            this.gateB.idLaunch(this.gyDev, this.xpXnDev, this.selDev,
                this.usedN, 0L);
            this.upB.idLaunch(this.uyDev, this.xpXnDev, this.selDev,
                this.usedN, 0L);
        }
        MoeFfn.phaseSync();
        MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs + (Clock.nanoTime() - tg0);
        int64 tgl0 = Clock.nanoTime();
        if (!fusedGu) {
            Prim.gluDevice(this.gyDev, this.uyDev,
                (int64) this.usedN * wid, act);
        }
        MoeFfn.phaseSync();
        MoeFfn.mtGluNs = MoeFfn.mtGluNs + (Clock.nanoTime() - tgl0);
        int64 td0 = Clock.nanoTime();
        QuantKernel.q8kPackLaunchNoSync(this.xpGyDev, this.gyDev,
            (int64) this.usedN * wid);
        this.downB.idLaunch(this.dyDev, this.xpGyDev, this.selDev,
            this.usedN, wid / 256L);
        MoeFfn.phaseSync();
        MoeFfn.mtDownNs = MoeFfn.mtDownNs + (Clock.nanoTime() - td0);
        int64 tc0 = Clock.nanoTime();
        // 41e: the residual add rides the combine — `acc` here is the
        // caller's RESIDUAL buffer, accumulated in place.
        QuantKernel.moeCombineAddLaunchNoSync(acc, this.dyDev,
            this.wSelDev, (int64) this.usedN, hid);
        MoeFfn.phaseSync();
        int64 tpost0 = Clock.nanoTime();
        MoeFfn.mtCombNs = MoeFfn.mtCombNs + (tpost0 - tc0);
        this.emitCacheRecord("row", h0, w0, a0, b0);
        MoeFfn.mtPostNs = MoeFfn.mtPostNs + (Clock.nanoTime() - tpost0);
        return true;
    }

    public void forwardRow(Tensor<float32> x, int64 xOff,
            Tensor<float32> out, int64 outOff, int32 act) {
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        int64 tr0 = Clock.nanoTime();
        this.routeInto(x, xOff, this.sc.sel, this.sc.w);
        MoeFfn.mtRouteNs = MoeFfn.mtRouteNs + (Clock.nanoTime() - tr0);
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase() + xOff;
        float32[] ob = out.hostBuffer();
        int64 oo = out.hostBase() + outOff;
        int64 j = 0;
        while (j < (int64) this.hidden) {
            ob[oo + j] = 0.0f;
            j = j + 1;
        }
        float32[] gb = this.sc.g.hostBuffer();
        int64 go = this.sc.g.hostBase();
        float32[] eb = this.sc.eOut.hostBuffer();
        int64 eo = this.sc.eOut.hostBase();
        int32 k = 0;
        while (k < this.usedN) {
            int32 e = this.sc.sel[k];
            int64 tg0 = Clock.nanoTime();
            // moe-cache 2.2.1: a RESIDENT expert's mat-vec launches on
            // the device against its slot; an un-admitted one keeps
            // the host path. Per expert, per bank (spec 3.3.2) — the
            // combination below is identical either way.
            if (!this.gateB.matvecDeviceAt(e, xb, xo, gb, go)) {
                this.gateB.matvecAt(e, xb, xo, gb, go);
            }
            if (!this.upB.matvecDeviceAt(e, xb, xo,
                    this.sc.u.hostBuffer(), this.sc.u.hostBase())) {
                this.upB.matvecAt(e, xb, xo,
                    this.sc.u.hostBuffer(), this.sc.u.hostBase());
            }
            int64 tgl0 = Clock.nanoTime();
            MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs + (tgl0 - tg0);
            Prim.gluRowHost(this.sc.g, 0L, this.sc.u, 0L, this.sc.g, 0L,
                this.widthN, act);
            int64 td0 = Clock.nanoTime();
            MoeFfn.mtGluNs = MoeFfn.mtGluNs + (td0 - tgl0);
            if (!this.downB.matvecDeviceAt(e, gb, go, eb, eo)) {
                this.downB.matvecAt(e, gb, go, eb, eo);
            }
            int64 tc0 = Clock.nanoTime();
            MoeFfn.mtDownNs = MoeFfn.mtDownNs + (tc0 - td0);
            float32 w = this.sc.w[k];
            j = 0;
            while (j < (int64) this.hidden) {
                ob[oo + j] = ob[oo + j] + w * eb[eo + j];
                j = j + 1;
            }
            MoeFfn.mtCombNs = MoeFfn.mtCombNs + (Clock.nanoTime() - tc0);
            k = k + 1;
        }
        int64 tsh0 = Clock.nanoTime();
        this.addSharedRow(x, xOff, ob, oo, act);
        MoeFfn.mtSharedNs = MoeFfn.mtSharedNs + (Clock.nanoTime() - tsh0);
        this.emitCacheRecord("row", h0, w0, a0, b0);
        return;
    }

    /**
     * 15.18: the dense shared expert for one row, ADDED into
     * `ob[oo…oo+hidden)`, gated by its own learned sigmoid when the
     * file carries the gate vector (qwen2moe; computed as sigma(g.x) —
     * llama.cpp spells the same value silu(z)/z). No-op when the model
     * binds no shared expert. Shared by the per-row and grouped paths.
     */
    void addSharedRow(Tensor<float32> x, int64 xOff, float32[] ob,
            int64 oo, int32 act) {
        if (this.sharedGateProj == null) {
            return;
        }
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase() + xOff;
        this.sharedGateProj.matvecInto(x, xOff, this.sc.shG, 0L);
        this.sharedUpProj.matvecInto(x, xOff, this.sc.shU, 0L);
        Prim.gluRowHost(this.sc.shG, 0L, this.sc.shU, 0L,
            this.sc.shG, 0L, this.sharedW, act);
        this.sharedDownProj.matvecInto(this.sc.shG, 0L,
            this.sc.shOut, 0L);
        float32 gs = 1.0f;
        int64 j = 0;
        if (this.sharedGate != null) {
            float32[] gv = this.sharedGate.hostBuffer();
            int64 gvo = this.sharedGate.hostBase();
            float32 z = 0.0f;
            j = 0;
            while (j < (int64) this.hidden) {
                z = z + gv[gvo + j] * xb[xo + j];
                j = j + 1;
            }
            gs = 1.0f / (1.0f + Math.exp(0.0f - z));
        }
        float32[] sb = this.sc.shOut.hostBuffer();
        int64 so = this.sc.shOut.hostBase();
        j = 0;
        while (j < (int64) this.hidden) {
            ob[oo + j] = ob[oo + j] + gs * sb[so + j];
            j = j + 1;
        }
        return;
    }

    /**
     * The grouped batch forward (15.12): route every row, group the
     * (row, expert, weight) picks by expert, and serve each selected
     * expert ONCE — dequantize its bank bytes one time and GEMM the
     * whole gathered group through them (`ExpertBank.gemmAt`), then
     * weighted-scatter the group outputs back to their rows. `x` and
     * `out` are row-major [rows x hidden] at host offset 0. The device
     * expert dispatch (28.2.1's coop route) hangs off this same
     * grouping; with routing off or unroutable banks the host GEMM
     * above is the whole story.
     */
    /** The counting sort of the rows*used picks into expert groups,
     *  shared by the host and device batch paths — and the inverse map
     *  (pick k of row r -> its group slot) the device scatter-combine
     *  reads. */
    void groupPicks(int32 rows) {
        int32 e = 0;
        while (e < this.expertsN) {
            this.sc.gCnt[e] = 0;
            e = e + 1;
        }
        int32 np = rows * this.usedN;
        if (this.rowSlotH == null
                || (int64) this.rowSlotH.count() < (int64) np) {
            this.rowSlotH #= heap int32[np];
        }
        int32 i = 0;
        while (i < np) {
            this.sc.gCnt[this.sc.selAll[i]] =
                this.sc.gCnt[this.sc.selAll[i]] + 1;
            i = i + 1;
        }
        this.sc.gOff[0] = 0;
        e = 0;
        while (e < this.expertsN) {
            this.sc.gOff[e + 1] = this.sc.gOff[e] + this.sc.gCnt[e];
            this.sc.gCur[e] = this.sc.gOff[e];
            e = e + 1;
        }
        i = 0;
        while (i < np) {
            int32 ex = this.sc.selAll[i];
            int32 slot = this.sc.gCur[ex];
            this.sc.gCur[ex] = slot + 1;
            this.sc.gRow[slot] = i / this.usedN;
            this.sc.gW[slot] = this.sc.wAll[i];
            this.rowSlotH[i] = slot;
            i = i + 1;
        }
        return;
    }

    /** One bank's id-GEMM: the multi-wave kernel where it applies,
     *  the epi-id kernel otherwise. */
    void idGemm(ExpertBank bank, KernelBuffer<float32> y,
            KernelBuffer<int8> xp, int32 nT, int32 nC, int32 groups) {
        if (bank.idMwReady()) {
            bank.gemmIdBatchMw(y, xp, MoeFfn.map64EDev, MoeFfn.map64T0Dev,
                MoeFfn.map64M1Dev, MoeFfn.metaDev, nC, groups);
        } else {
            bank.gemmIdBatch(y, xp, MoeFfn.mapEDev, MoeFfn.mapT0Dev,
                MoeFfn.mapM1Dev, nT, groups);
        }
        return;
    }

    void ensureDevBatch(int32 rows) {
        int64 np = (int64) rows * (int64) this.usedN;
        int64 wid = (int64) this.widthN;
        int64 h = (int64) this.hidden;
        if (MoeFfn.devBatchCap >= np && MoeFfn.devBatchH >= h
                && MoeFfn.devBatchW >= wid
                && MoeFfn.devBatchE >= this.expertsN) {
            return;
        }
        if (MoeFfn.devBatchCap > np) { np = MoeFfn.devBatchCap; }
        if (MoeFfn.devBatchH > h) { h = MoeFfn.devBatchH; }
        if (MoeFfn.devBatchW > wid) { wid = MoeFfn.devBatchW; }
        int32 en = this.expertsN;
        if (MoeFfn.devBatchE > en) { en = MoeFfn.devBatchE; }
        // A queued launch from the previous owner may still read the
        // old set.
        QuantKernel.stream().sync();
        MoeFfn.fbEdbAllocs = MoeFfn.fbEdbAllocs + 1L;
        // +64 rows of slack everywhere the id-GEMMs' padded tiles may
        // READ past the last group (their stores are guarded): the
        // multi-wave kernel's map strides 64.
        int64 npp = np + 64L;
        MoeFfn.gRowDev #= heap KernelBuffer<int32>((uint64) np);
        MoeFfn.gWDev #= heap KernelBuffer<float32>((uint64) np);
        MoeFfn.rowSlotDev #= heap KernelBuffer<int32>((uint64) np);
        MoeFfn.bxDev #= heap KernelBuffer<float32>((uint64) (npp * h));
        MoeFfn.bgDev #= heap KernelBuffer<float32>((uint64) (npp * wid));
        MoeFfn.buDev #= heap KernelBuffer<float32>((uint64) (npp * wid));
        MoeFfn.beDev #= heap KernelBuffer<float32>((uint64) (npp * h));
        MoeFfn.obDev #= heap KernelBuffer<float32>((uint64) (np * h));
        int32 tiles = (int32) (np / 16L) + en + 1;
        MoeFfn.mapEH #= heap int32[tiles];
        MoeFfn.mapT0H #= heap int32[tiles];
        MoeFfn.mapM1H #= heap int32[tiles];
        MoeFfn.mapEDev #= heap KernelBuffer<int32>((uint64) tiles);
        MoeFfn.mapT0Dev #= heap KernelBuffer<int32>((uint64) tiles);
        MoeFfn.mapM1Dev #= heap KernelBuffer<int32>((uint64) tiles);
        MoeFfn.map64EH #= heap int32[tiles];
        MoeFfn.map64T0H #= heap int32[tiles];
        MoeFfn.map64M1H #= heap int32[tiles];
        MoeFfn.map64EDev #= heap KernelBuffer<int32>((uint64) tiles);
        MoeFfn.map64T0Dev #= heap KernelBuffer<int32>((uint64) tiles);
        MoeFfn.map64M1Dev #= heap KernelBuffer<int32>((uint64) tiles);
        MoeFfn.selAllDev #= heap KernelBuffer<int32>((uint64) np);
        MoeFfn.wAllDev #= heap KernelBuffer<float32>((uint64) np);
        MoeFfn.metaDev #= heap KernelBuffer<int32>((uint64) 4);
        MoeFfn.metaH #= heap int32[4];
        MoeFfn.xpBxDev #= heap KernelBuffer<int8>(
            (uint64) ((npp * h / 256L) * 320L));
        MoeFfn.xpBgDev #= heap KernelBuffer<int8>(
            (uint64) ((npp * wid / 256L) * 320L));
        MoeFfn.devBatchCap = np;
        MoeFfn.devBatchH = h;
        MoeFfn.devBatchW = wid;
        MoeFfn.devBatchE = en;
        return;
    }

    /** The combined batch output when {@link #forwardBatchRes}
     *  returned true — [rows x hidden] on the device, valid until the
     *  next forward. */
    public KernelBuffer<float32> batchObDev() {
        return MoeFfn.obDev;
    }

    /**
     * Unit 41b (spec 15.21.4): the WHOLE batched MoE FFN on the device
     * against rows already resident in `xDev` — routing off the device
     * buffer, gather into group order, group GEMMs whose outputs stay
     * resident, one GLU over the packed middle, and a deterministic
     * per-row scatter-combine into {@link #batchObDev} for the caller
     * to add onto its residual. Host work shrinks to the selection
     * tail and the counting sort. False — caller runs the host
     * `forwardBatch` — when the backend has no device routing, routing
     * is pinned off, the model has a shared expert, or any selected
     * expert is not admitted (the capped regime keeps its shape).
     */
    public boolean forwardBatchRes(KernelBuffer<float32> xDev,
            int32 rows, int32 act) {
        if (!Linear.residentEnabled()) { return false; }
        if (!QuantKernel.routingEnabled()) { return false; }
        if (this.sharedW != 0) { return false; }
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        this.sc.ensureBatch(rows, this.usedN, this.expertsN,
            this.widthN, this.hidden);
        this.ensureRouterDev();
        int64 en = (int64) this.expertsN;
        int64 h = (int64) this.hidden;
        int64 wid = (int64) this.widthN;
        if (this.lgBatchCap < (int64) rows) {
            this.lgBatchDev #= heap KernelBuffer<float32>(
                (uint64) ((int64) rows * en));
            this.lgBatchH #= heap float32[(int64) rows * en];
            this.xRowsDev #= heap KernelBuffer<float32>(
                (uint64) ((int64) rows * h));
            this.xRowsH #= heap float32[(int64) rows * h];
            this.lgBatchCap = (int64) rows;
        }
        int64 fbr0 = Clock.nanoTime();
        int32 np = rows * this.usedN;
        // Unit 45: when every bank takes the multi-wave id-GEMM, the
        // whole layer is stream launches — router GEMM, batched
        // top-k, the one-workgroup counting sort that writes the
        // group maps and the chunk count, gather, pack, three GEMMs,
        // GLU, pack, scatter-combine. No sync, no download, no
        // upload; the host sees nothing until the logits.
        boolean zeroSync = Linear.wmmaOn && !Linear.backendIsVulkan()
            && this.gateB.idMwReady() && this.upB.idMwReady()
            && this.downB.idMwReady();
        if (zeroSync) {
            this.ensureDevBatch(rows);
            QuantKernel.routerBatchF32LaunchNoSync(this.lgBatchDev,
                this.routerWDev, xDev, (int64) rows, en, h);
            QuantKernel.moeTopKBatchLaunchNoSync(MoeFfn.selAllDev,
                MoeFfn.wAllDev, this.lgBatchDev, (int64) rows, en,
                (int64) this.usedN, this.normTopk, this.wScale);
            QuantKernel.moeGroupLaunchNoSync(MoeFfn.gRowDev, MoeFfn.gWDev,
                MoeFfn.rowSlotDev, MoeFfn.map64EDev, MoeFfn.map64T0Dev,
                MoeFfn.map64M1Dev, MoeFfn.metaDev, MoeFfn.selAllDev,
                MoeFfn.wAllDev, (int64) np, en, (int64) this.usedN);
            MoeFfn.fbDevRoutes = MoeFfn.fbDevRoutes + 1L;
            MoeFfn.fbZeroSyncRoutes = MoeFfn.fbZeroSyncRoutes + 1L;
            int64 fbrz = Clock.nanoTime();
            MoeFfn.fbRouteNs = MoeFfn.fbRouteNs + (fbrz - fbr0);
            int32 nCMax = np / 64 + this.expertsN;
            int64 fbg10 = Clock.nanoTime();
            MoeFfn.fbPreNs = MoeFfn.fbPreNs + (fbg10 - fbrz);
            QuantKernel.gatherRowsF32LaunchNoSync(MoeFfn.bxDev, xDev,
                MoeFfn.gRowDev, (int64) np, h);
            QuantKernel.q8kPackLaunchNoSync(MoeFfn.xpBxDev, MoeFfn.bxDev,
                (int64) np * h);
            // Every expert is resident by construction (the slabs), and
            // the host no longer knows which were selected: a launch
            // counts the bank.
            this.gateB.gemmIdBatchMw(MoeFfn.bgDev, MoeFfn.xpBxDev,
                MoeFfn.map64EDev, MoeFfn.map64T0Dev, MoeFfn.map64M1Dev,
                MoeFfn.metaDev, nCMax, this.expertsN);
            this.upB.gemmIdBatchMw(MoeFfn.buDev, MoeFfn.xpBxDev,
                MoeFfn.map64EDev, MoeFfn.map64T0Dev, MoeFfn.map64M1Dev,
                MoeFfn.metaDev, nCMax, this.expertsN);
            MoeFfn.phaseSync();
            MoeFfn.fbGemm1Ns = MoeFfn.fbGemm1Ns
                + (Clock.nanoTime() - fbg10);
            int64 fbg20 = Clock.nanoTime();
            Prim.gluDevice(MoeFfn.bgDev, MoeFfn.buDev, (int64) np * wid,
                act);
            QuantKernel.q8kPackLaunchNoSync(MoeFfn.xpBgDev, MoeFfn.bgDev,
                (int64) np * wid);
            this.downB.gemmIdBatchMw(MoeFfn.beDev, MoeFfn.xpBgDev,
                MoeFfn.map64EDev, MoeFfn.map64T0Dev, MoeFfn.map64M1Dev,
                MoeFfn.metaDev, nCMax, this.expertsN);
            MoeFfn.phaseSync();
            MoeFfn.fbGemm2Ns = MoeFfn.fbGemm2Ns
                + (Clock.nanoTime() - fbg20);
            int64 fbt0 = Clock.nanoTime();
            QuantKernel.moeScatterCombineLaunchNoSync(MoeFfn.obDev,
                MoeFfn.beDev, MoeFfn.rowSlotDev, MoeFfn.gWDev,
                (int64) rows, (int64) this.usedN, h);
            MoeFfn.phaseSync();
            MoeFfn.fbTailNs = MoeFfn.fbTailNs + (Clock.nanoTime() - fbt0);
            this.emitCacheRecord("batch", h0, w0, a0, b0);
            return true;
        }
        this.routeBatchCore(xDev, rows, this.sc.selAll, this.sc.wAll);
        MoeFfn.fbDevRoutes = MoeFfn.fbDevRoutes + 1L;
        int64 gp0 = Clock.nanoTime();
        this.groupPicks(rows);
        MoeFfn.fbRouteHostNs = MoeFfn.fbRouteHostNs
            + (Clock.nanoTime() - gp0);
        int64 fbr1 = Clock.nanoTime();
        MoeFfn.fbRouteNs = MoeFfn.fbRouteNs + (fbr1 - fbr0);
        // Every selected expert must serve from the device (slabs or
        // slices); one refusal sends the whole layer to the host path.
        int32 e = 0;
        while (e < this.expertsN) {
            if (this.sc.gCnt[e] > 0) {
                if (!this.gateB.isAdmitted(e)
                        || !this.upB.isAdmitted(e)
                        || !this.downB.isAdmitted(e)) {
                    return false;
                }
            }
            e = e + 1;
        }
        int64 fbp1 = Clock.nanoTime();
        MoeFfn.fbPreA = MoeFfn.fbPreA + (fbp1 - fbr1);
        this.ensureDevBatch(rows);
        int64 fbp2 = Clock.nanoTime();
        MoeFfn.fbPreB = MoeFfn.fbPreB + (fbp2 - fbp1);
        // Pre-grow the shared batch stage to the largest PADDED group
        // (gemmKeepAt pads rows to the WMMA tile): growth mid-loop
        // would invalidate a staged window under a queued GEMM.
        int32 mMax = 0;
        e = 0;
        while (e < this.expertsN) {
            int32 gm = this.sc.gOff[e + 1] - this.sc.gOff[e];
            if (gm > mMax) { mMax = gm; }
            e = e + 1;
        }
        int64 fbp3 = Clock.nanoTime();
        MoeFfn.fbPreC = MoeFfn.fbPreC + (fbp3 - fbp2);
        Linear.ensureBatchStage((mMax + 15) / 16 * 16, this.hidden);
        int64 fbu0 = Clock.nanoTime();
        MoeFfn.fbPreD = MoeFfn.fbPreD + (fbu0 - fbp3);
        MoeFfn.gRowDev.upload(this.sc.gRow, (int64) np);
        MoeFfn.gWDev.upload(this.sc.gW, (int64) np);
        MoeFfn.rowSlotDev.upload(this.rowSlotH, (int64) np);
        int64 fbg10 = Clock.nanoTime();
        MoeFfn.fbPreNs = MoeFfn.fbPreNs + (fbg10 - fbr1);
        MoeFfn.fbUplNs = MoeFfn.fbUplNs + (fbg10 - fbu0);
        QuantKernel.gatherRowsF32LaunchNoSync(MoeFfn.bxDev, xDev,
            MoeFfn.gRowDev, (int64) np, h);
        // Unit 41d: ONE indirected GEMM per bank when the slabs and
        // the WMMA id kernels are here — the mul_mat_id shape. The
        // per-group loop below stays as the fallback (vulkan, exotic
        // formats), and hundreds of serialized small GEMMs are exactly
        // what it costs.
        boolean idPath = Linear.wmmaOn && !Linear.backendIsVulkan()
            && this.gateB.idGemmReady() && this.upB.idGemmReady()
            && this.downB.idGemmReady();
        int32 nT = 0;
        int32 nC = 0;
        int32 groups = 0;
        // Unit 44: the multi-wave kernel takes 64-row chunk maps; the
        // epi-id kernels (q6k, or an outDim off the 128 grid) keep the
        // 16-row tile maps. A bank picks by idMwReady().
        boolean anyMw = this.gateB.idMwReady() || this.upB.idMwReady()
            || this.downB.idMwReady();
        boolean any16 = !this.gateB.idMwReady() || !this.upB.idMwReady()
            || !this.downB.idMwReady();
        if (idPath) {
            e = 0;
            while (e < this.expertsN) {
                int32 g0 = this.sc.gOff[e];
                int32 m = this.sc.gOff[e + 1] - g0;
                if (m > 0) {
                    groups = groups + 1;
                    int32 tw = 0;
                    while (tw * 16 < m) {
                        MoeFfn.mapEH[nT] = e;
                        MoeFfn.mapT0H[nT] = g0 + tw * 16;
                        MoeFfn.mapM1H[nT] = g0 + m;
                        nT = nT + 1;
                        tw = tw + 1;
                    }
                    tw = 0;
                    while (tw * 64 < m) {
                        MoeFfn.map64EH[nC] = e;
                        MoeFfn.map64T0H[nC] = g0 + tw * 64;
                        MoeFfn.map64M1H[nC] = g0 + m;
                        nC = nC + 1;
                        tw = tw + 1;
                    }
                }
                e = e + 1;
            }
            if (any16) {
                MoeFfn.mapEDev.upload(MoeFfn.mapEH, (int64) nT);
                MoeFfn.mapT0Dev.upload(MoeFfn.mapT0H, (int64) nT);
                MoeFfn.mapM1Dev.upload(MoeFfn.mapM1H, (int64) nT);
            }
            if (anyMw) {
                MoeFfn.map64EDev.upload(MoeFfn.map64EH, (int64) nC);
                MoeFfn.map64T0Dev.upload(MoeFfn.map64T0H, (int64) nC);
                MoeFfn.map64M1Dev.upload(MoeFfn.map64M1H, (int64) nC);
                MoeFfn.metaH[0] = nC;
                MoeFfn.metaDev.upload(MoeFfn.metaH, 1L);
            }
            QuantKernel.q8kPackLaunchNoSync(MoeFfn.xpBxDev, MoeFfn.bxDev,
                (int64) np * h);
            this.idGemm(this.gateB, MoeFfn.bgDev, MoeFfn.xpBxDev, nT, nC,
                groups);
            this.idGemm(this.upB, MoeFfn.buDev, MoeFfn.xpBxDev, nT, nC,
                groups);
            MoeFfn.phaseSync();
            MoeFfn.fbGemm1Ns = MoeFfn.fbGemm1Ns
                + (Clock.nanoTime() - fbg10);
        } else {
            e = 0;
            while (e < this.expertsN) {
                int32 g0 = this.sc.gOff[e];
                int32 m = this.sc.gOff[e + 1] - g0;
                if (m > 0) {
                    KernelBuffer<float32> gx #= MoeFfn.bxDev.slice(
                        (uint64) ((int64) g0 * h),
                        (uint64) ((int64) m * h));
                    Linear.stageBatchFromDevice(gx, m, this.hidden,
                        Linear.nextStageTag());
                    this.gateB.gemmKeepAt(e, m, MoeFfn.bgDev,
                        (int64) g0 * wid);
                    this.upB.gemmKeepAt(e, m, MoeFfn.buDev,
                        (int64) g0 * wid);
                }
                e = e + 1;
            }
        }
        int64 fbg20 = Clock.nanoTime();
        Prim.gluDevice(MoeFfn.bgDev, MoeFfn.buDev, (int64) np * wid, act);
        if (idPath) {
            QuantKernel.q8kPackLaunchNoSync(MoeFfn.xpBgDev, MoeFfn.bgDev,
                (int64) np * wid);
            this.idGemm(this.downB, MoeFfn.beDev, MoeFfn.xpBgDev, nT, nC,
                groups);
            MoeFfn.phaseSync();
            MoeFfn.fbGemm2Ns = MoeFfn.fbGemm2Ns
                + (Clock.nanoTime() - fbg20);
        } else {
            e = 0;
            while (e < this.expertsN) {
                int32 g0 = this.sc.gOff[e];
                int32 m = this.sc.gOff[e + 1] - g0;
                if (m > 0) {
                    KernelBuffer<float32> gg #= MoeFfn.bgDev.slice(
                        (uint64) ((int64) g0 * wid),
                        (uint64) ((int64) m * wid));
                    Linear.stageBatchFromDevice(gg, m, this.widthN,
                        Linear.nextStageTag());
                    this.downB.gemmKeepAt(e, m, MoeFfn.beDev,
                        (int64) g0 * h);
                }
                e = e + 1;
            }
        }
        int64 fbt0 = Clock.nanoTime();
        QuantKernel.moeScatterCombineLaunchNoSync(MoeFfn.obDev,
            MoeFfn.beDev, MoeFfn.rowSlotDev, MoeFfn.gWDev, (int64) rows,
            (int64) this.usedN, h);
        MoeFfn.phaseSync();
        MoeFfn.fbTailNs = MoeFfn.fbTailNs + (Clock.nanoTime() - fbt0);
        this.emitCacheRecord("batch", h0, w0, a0, b0);
        return true;
    }

    public void forwardBatch(Tensor<float32> x, Tensor<float32> out,
            int32 rows, int32 act) {
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        this.sc.ensureBatch(rows, this.usedN, this.expertsN,
            this.widthN, this.hidden);
        if (!this.routerWUp && this.sharedW == 0
                && this.gateB.slabReady() && this.upB.slabReady()
                && this.downB.slabReady()) {
            // Arm the decode's device router while we are already
            // inside a multi-second prefill (see ensureRouterDev).
            this.ensureRouterDev();
        }
        int64 h = (int64) this.hidden;
        int64 fbr0 = Clock.nanoTime();
        if (this.routeBatchInto(x, rows, this.sc.selAll,
                this.sc.wAll)) {
            MoeFfn.fbDevRoutes = MoeFfn.fbDevRoutes + 1L;
        } else {
            MoeFfn.fbHostRoutes = MoeFfn.fbHostRoutes + 1L;
            int32 r0 = 0;
            while (r0 < rows) {
                this.routeInto(x, (int64) r0 * h, this.sc.sel,
                    this.sc.w);
                int32 k = 0;
                while (k < this.usedN) {
                    this.sc.selAll[r0 * this.usedN + k] =
                        this.sc.sel[k];
                    this.sc.wAll[r0 * this.usedN + k] = this.sc.w[k];
                    k = k + 1;
                }
                r0 = r0 + 1;
            }
        }
        MoeFfn.fbRouteNs = MoeFfn.fbRouteNs + (Clock.nanoTime() - fbr0);
        float32[] ob = out.hostBuffer();
        int64 oo = out.hostBase();
        int64 zi = 0;
        while (zi < (int64) rows * h) {
            ob[oo + zi] = 0.0f;
            zi = zi + 1;
        }
        this.groupPicks(rows);
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase();
        float32[] bxb = this.sc.bx.hostBuffer();
        int64 bxo = this.sc.bx.hostBase();
        float32[] bgb = this.sc.bg.hostBuffer();
        int64 bgo = this.sc.bg.hostBase();
        float32[] bub = this.sc.bu.hostBuffer();
        int64 buo = this.sc.bu.hostBase();
        float32[] beb = this.sc.be.hostBuffer();
        int64 beo = this.sc.be.hostBase();
        int64 wN = (int64) this.widthN;
        int32 e = 0;
        while (e < this.expertsN) {
            int32 g0 = this.sc.gOff[e];
            int32 m = this.sc.gOff[e + 1] - g0;
            if (m > 0) {
                int32 t = 0;
                while (t < m) {
                    int64 src = xo
                        + (int64) this.sc.gRow[g0 + t] * h;
                    int64 dst = bxo + (int64) t * h;
                    int64 j = 0;
                    while (j < h) {
                        bxb[dst + j] = xb[src + j];
                        j = j + 1;
                    }
                    t = t + 1;
                }
                // The DEVICE expert dispatch (28.2.1): the same
                // grouping, with each bank's GEMM going through its
                // stride-sized expert window and the existing batched
                // route (coop on vulkan, dp4a elsewhere). Falls to the
                // host dequant GEMM per group when any bank cannot
                // route — same math, same counters, one variable.
                boolean dev = this.gateB.devRoutableFor(m)
                    && this.upB.devRoutableFor(m)
                    && this.downB.devRoutableFor(m);
                if (dev) {
                    Linear.stageBatch(this.sc.bx, 0L, m, this.hidden,
                        Linear.nextStageTag());
                    this.gateB.gemmDeviceAt(e, m, this.sc.bg, 0L);
                    this.upB.gemmDeviceAt(e, m, this.sc.bu, 0L);
                } else {
                    this.gateB.gemmAt(e, bxb, bxo, m, bgb, bgo,
                        this.sc.dq);
                    this.upB.gemmAt(e, bxb, bxo, m, bub, buo,
                        this.sc.dq);
                }
                t = 0;
                while (t < m) {
                    Prim.gluRowHost(this.sc.bg, (int64) t * wN,
                        this.sc.bu, (int64) t * wN,
                        this.sc.bg, (int64) t * wN, this.widthN, act);
                    t = t + 1;
                }
                if (dev) {
                    Linear.stageBatch(this.sc.bg, 0L, m, this.widthN,
                        Linear.nextStageTag());
                    this.downB.gemmDeviceAt(e, m, this.sc.be, 0L);
                } else {
                    this.downB.gemmAt(e, bgb, bgo, m, beb, beo,
                        this.sc.dq);
                }
                t = 0;
                while (t < m) {
                    float32 w = this.sc.gW[g0 + t];
                    int64 dst = oo
                        + (int64) this.sc.gRow[g0 + t] * h;
                    int64 src = beo + (int64) t * h;
                    int64 j = 0;
                    while (j < h) {
                        ob[dst + j] = ob[dst + j] + w * beb[src + j];
                        j = j + 1;
                    }
                    t = t + 1;
                }
            }
            e = e + 1;
        }
        int32 sr = 0;
        while (sr < rows) {
            this.addSharedRow(x, (int64) sr * h, ob,
                oo + (int64) sr * h, act);
            sr = sr + 1;
        }
        this.emitCacheRecord("batch", h0, w0, a0, b0);
        return;
    }

    /**
     * moe-expert-cache unit 3 (spec 8.1): ONE record per MoE layer
     * call — this layer's slot hits, windowed fallbacks, admissions
     * and admitted bytes for the call just made, plus this layer's
     * total resident bytes. The per-layer hit/fallback split cabra
     * renders IS the record stream keyed by v0. Emitted through the
     * unit-21 seam: with no callback registered `Diag.emit` builds
     * nothing, and the four counter snapshots around the call are
     * plain static reads. A dense model never reaches this method, so
     * a non-MoE run emits nothing (spec 9.1.5) without a guard.
     */
    void emitCacheRecord(String mode, int64 h0, int64 w0, int64 a0,
            int64 b0) {
        if (!Diag.on()) { return; }
        int64 res = this.gateB.residentBytes()
            + this.upB.residentBytes() + this.downB.residentBytes();
        Diag.emit("expert-cache", 0 - 1, mode, (int64) this.layerIdx,
            ExpertBank.residencyHits() - h0,
            ExpertBank.residencyWindowed() - w0,
            ExpertBank.residencyAdmissions() - a0,
            ExpertBank.residencyAdmissionBytes() - b0,
            res);
        return;
    }

    /** Zero every bank's per-expert byte counters (15.16's window). */
    public void resetTouched() {
        this.gateB.resetTouched();
        this.upB.resetTouched();
        this.downB.resetTouched();
        return;
    }

    /** Can a group of `m` rows take the device expert GEMMs on all
     *  three banks (28.1.2's gate)? Honors the routing switch. */
    public boolean deviceGroupedFor(int32 m) {
        return this.gateB.devRoutableFor(m)
            && this.upB.devRoutableFor(m)
            && this.downB.devRoutableFor(m);
    }

    public int32 experts() {
        return this.expertsN;
    }

    public int32 used() {
        return this.usedN;
    }

    /** The per-expert FFN width, resolved at bind. */
    public int32 width() {
        return this.widthN;
    }

    public ExpertBank gateBank() {
        return this.gateB;
    }

    public ExpertBank upBank() {
        return this.upB;
    }

    public ExpertBank downBank() {
        return this.downB;
    }

    public boolean hasShared() {
        return this.sharedGateProj != null;
    }

    /** 15.18: the shared expert's own learned sigmoid gate. */
    public boolean hasSharedGate() {
        return this.sharedGate != null;
    }
}
