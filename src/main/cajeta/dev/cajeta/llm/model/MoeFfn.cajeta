package dev.cajeta.llm.model;

import cajeta.lang.Math;
import cajeta.time.Clock;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.Checkpoint;

/**
 * The MoE replacement for a layer's dense FFN (spec 15.1): a router
 * plus three expert banks, and — when the checkpoint ships one — a
 * dense shared expert with its own learned sigmoid gate (15.18,
 * qwen2moe's shape; qwen3moe declares its shared width as 0 and binds
 * none).
 *
 * Unit 26 scope: this BINDS. The sparse forward is plan unit 27, and
 * until it lands `CausalLM` refuses to forward an MoE model rather
 * than silently computing garbage through a dense path that no longer
 * exists.
 *
 * Binding is by ggml tensor names directly (`blk.N.ffn_gate_exps…`):
 * MoE checkpoints are GGUF-only (spec §15's scope), and the merged
 * slab names have no torch state_dict equivalent to map from.
 */
public final class MoeFfn extends InfModule {

    Linear router;             // ffn_gate_inp: [experts, hidden] f32
    int32 layerIdx;    // moe-cache unit 3: record attribution; -1 until set
    KernelBuffer<float32> crossDev;   // unit 39: mixed-regime eOut up-leg
    float32[] crossHost;              // unit 39: contiguous copy for upload

    // ── Unit 40: the zero-sync route's device state (lazy; decode
    // pays nothing until the slab path engages). ──
    KernelBuffer<float32> logitsDev;   // router logits, [E]
    KernelBuffer<float32> probsDev;    // top-k scratch, [E]
    KernelBuffer<int32> selDev;        // selected ids, [used]
    KernelBuffer<float32> wSelDev;     // combining weights, [used]
    KernelBuffer<float32> gyDev;       // gate outputs, [used x width]
    KernelBuffer<float32> uyDev;       // up outputs, [used x width]
    KernelBuffer<float32> dyDev;       // down outputs, [used x hidden]
    KernelBuffer<int8> xpXnDev;        // staged activation, per token
    KernelBuffer<int8> xpGyDev;        // staged GLU'd middle, [used rows]
    KernelBuffer<float32> routerWDev;  // router weight, f32 [in x E]
    boolean routerWUp;

    // ── forwardRow phase split (parity attribution, decode). ──
    static int64 mtRouteNs;    // router matvec + softmax + top-k
    static int64 mtGateUpNs;   // gate + up expert mat-vecs
    static int64 mtGluNs;      // host GLU fold
    static int64 mtDownNs;     // down expert mat-vecs
    static int64 mtCombNs;     // weighted accumulate into the row
    static int64 mtSharedNs;   // shared-expert sublayer
    public static int64 rowRouteNs()  { return MoeFfn.mtRouteNs; }
    public static int64 rowGateUpNs() { return MoeFfn.mtGateUpNs; }
    public static int64 rowGluNs()    { return MoeFfn.mtGluNs; }
    public static int64 rowDownNs()   { return MoeFfn.mtDownNs; }
    public static int64 rowCombNs()   { return MoeFfn.mtCombNs; }
    public static int64 rowSharedNs() { return MoeFfn.mtSharedNs; }
    public static void resetRowTimers() {
        MoeFfn.mtRouteNs = 0L;
        MoeFfn.mtGateUpNs = 0L;
        MoeFfn.mtGluNs = 0L;
        MoeFfn.mtDownNs = 0L;
        MoeFfn.mtCombNs = 0L;
        MoeFfn.mtSharedNs = 0L;
        return;
    }
    ExpertBank gateB;
    ExpertBank upB;
    ExpertBank downB;
    Linear sharedGateProj;     // null when the model has no shexp
    Linear sharedUpProj;
    Linear sharedDownProj;
    Tensor<float32> sharedGate; // ffn_gate_inp_shexp [hidden], or null

    int32 expertsN;
    int32 usedN;
    int32 gating;              // gguf enum: 1 softmax, 2 sigmoid
    boolean normTopk;          // renormalize top-k weights by sum
    float32 wScale;            // 0 = none
    int32 sharedW;             // shared expert width, 0 = none
    MoeScratch sc;             // NOT a parameter (plain class ref)
    int32 widthN;              // resolved at bind (config key or slab)
    int32 hidden;

    MoeFfn(ModelConfig cfg) {
        if (cfg.expertGating != 1) {
            // 15.4/15.13: sigmoid (2) and softmax-after-top-k (3)
            // exist in the key's enum but NO witness file carries
            // them; a wrong gating function is fluent wrong output,
            // so an unwitnessed value refuses instead of guessing.
            String nm = "" + cfg.expertGating;
            if (cfg.expertGating == 2) {
                nm = "sigmoid (2)";
            }
            throw heap LlmException("moe: expert_gating_func " + nm
                + " has no witness model; only softmax (1) is "
                + "implemented (spec 15.4; 15.13 defers the rest "
                + "until a witness exists)");
        }
        this.gating = cfg.expertGating;
        this.normTopk = cfg.expertNormTopk;
        this.wScale = cfg.expertScale;
        this.sharedW = 0;
        this.sc = null;
        this.expertsN = cfg.expertCount;
        this.usedN = cfg.expertUsedCount;
        this.widthN = cfg.expertFfn;   // 0 = derive from the slab
        this.hidden = cfg.hiddenSize;
        this.router = heap Linear(cfg.hiddenSize, cfg.expertCount);
        this.layerIdx = 0 - 1;
        this.gateB = heap ExpertBank();
        this.upB = heap ExpertBank();
        this.downB = heap ExpertBank();
        this.sharedGateProj = null;
        this.sharedUpProj = null;
        this.sharedDownProj = null;
        this.sharedGate = null;
        return;
    }

    /** `gp` is the layer's ggml prefix, `blk.<i>.`. */
    void bind(Checkpoint ckpt, String gp, boolean toDevice) {
        if (!ckpt.contains(gp + "ffn_gate_exps.weight")) {
            if (ckpt.contains(gp + "ffn_gate.0.weight")) {
                // 15.17: the pre-2024-04 llama.cpp layout, one tensor
                // per expert. Refused NAMING THE FIX — files in this
                // layout stopped being produced, and supporting both
                // would double every dispatch test.
                throw heap LlmException("moe: this checkpoint uses the "
                    + "legacy split-expert layout ('" + gp
                    + "ffn_gate.0.weight' — one tensor per expert, "
                    + "pre-2024-04 llama.cpp); use a merged-slab "
                    + "requant of the same model instead (e.g. "
                    + "mradermacher's builds carry the merged "
                    + "ffn_gate_exps form)");
            }
            throw heap LlmException("moe: '" + gp + "ffn_gate_exps."
                + "weight' is missing — the config declares "
                + this.expertsN + " experts but the checkpoint carries "
                + "no merged expert slab");
        }
        this.gateB.bind(ckpt, gp + "ffn_gate_exps.weight",
            this.expertsN, this.widthN, this.hidden);
        if (this.widthN == 0) {
            // qwen2moe ships no expert-width key: the slab is the
            // authority (measured on the witness, 2026-08-31).
            this.widthN = this.gateB.rows();
        }
        this.upB.bind(ckpt, gp + "ffn_up_exps.weight",
            this.expertsN, this.widthN, this.hidden);
        this.downB.bind(ckpt, gp + "ffn_down_exps.weight",
            this.expertsN, this.hidden, this.widthN);
        this.router.bind(ckpt, gp + "ffn_gate_inp.weight", false);

        if (ckpt.contains(gp + "ffn_gate_shexp.weight")) {
            // The shared expert's width comes from its own tensor —
            // there is no reliable key (qwen2moe reuses
            // feed_forward_length, qwen3moe writes 0).
            int64[] shp = ckpt.shapeOf(gp + "ffn_gate_shexp.weight");
            if (shp == null || (int32) shp.count() != 2) {
                throw heap LlmException("moe: '" + gp
                    + "ffn_gate_shexp.weight' is not rank 2");
            }
            int32 sw = (int32) shp[0];
            this.sharedW = sw;
            this.sharedGateProj = heap Linear(this.hidden, sw);
            this.sharedUpProj = heap Linear(this.hidden, sw);
            this.sharedDownProj = heap Linear(sw, this.hidden);
            this.sharedGateProj.bind(ckpt, gp + "ffn_gate_shexp.weight",
                toDevice);
            this.sharedUpProj.bind(ckpt, gp + "ffn_up_shexp.weight",
                toDevice);
            this.sharedDownProj.bind(ckpt, gp + "ffn_down_shexp.weight",
                toDevice);
            if (ckpt.contains(gp + "ffn_gate_inp_shexp.weight")) {
                Tensor<float32> g #= ckpt.loadF32(
                    gp + "ffn_gate_inp_shexp.weight");
                this.sharedGate #= g;
            }
        }
        this.sc = heap MoeScratch(this.expertsN, this.usedN,
            this.widthN, this.hidden, this.sharedW);
        return;
    }

    /**
     * Router selection for one activation row (15.5–15.8): logits
     * through the gating function over ALL experts, top-`used` by
     * gating probability (ties to the LOWER index, argsort's order),
     * combining weights the selected probabilities — renormalized by
     * their clamped sum when the arch says so (qwen3moe, Mixtral) and
     * NOT when it says not (qwen2moe), scaled only when the file
     * carries a scale. Semantics measured against llama.cpp's
     * build_moe_ffn, 2026-08-31.
     */
    public void routeInto(Tensor<float32> x, int64 xOff,
            int32[] selOut, float32[] wOut) {
        this.router.matvecInto(x, xOff, this.sc.logits, 0L);
        float32[] lb = this.sc.logits.hostBuffer();
        int64 lo = this.sc.logits.hostBase();
        // Softmax over all experts (gating 1 — the ctor refused the
        // rest). Selection order is unchanged by the monotone map, but
        // the COMBINING WEIGHTS are these probabilities, so the full
        // softmax is load-bearing even without renormalization.
        float32 mx = lb[lo];
        int32 e = 1;
        while (e < this.expertsN) {
            if (lb[lo + (int64) e] > mx) {
                mx = lb[lo + (int64) e];
            }
            e = e + 1;
        }
        float32 sum = 0.0f;
        e = 0;
        while (e < this.expertsN) {
            float32 p = Math.exp(lb[lo + (int64) e] - mx);
            this.sc.probs[e] = p;
            sum = sum + p;
            e = e + 1;
        }
        e = 0;
        while (e < this.expertsN) {
            this.sc.probs[e] = this.sc.probs[e] / sum;
            e = e + 1;
        }
        // Top-k by probability, strict > so ties keep the lower index.
        int32 k = 0;
        while (k < this.usedN) {
            int32 best = 0 - 1;
            float32 bp = 0.0f;
            e = 0;
            while (e < this.expertsN) {
                if (this.sc.probs[e] >= 0.0f
                        && (best < 0 || this.sc.probs[e] > bp)) {
                    best = e;
                    bp = this.sc.probs[e];
                }
                e = e + 1;
            }
            selOut[k] = best;
            wOut[k] = bp;
            this.sc.probs[best] = 0.0f - 1.0f;   // taken
            k = k + 1;
        }
        if (this.normTopk) {
            float32 ws = 0.0f;
            k = 0;
            while (k < this.usedN) {
                ws = ws + wOut[k];
                k = k + 1;
            }
            // llama.cpp clamps the divisor at the smallest f16 normal.
            if (ws < 0.00006103515625f) {
                ws = 0.00006103515625f;
            }
            k = 0;
            while (k < this.usedN) {
                wOut[k] = wOut[k] / ws;
                k = k + 1;
            }
        }
        if (this.wScale != 0.0f && this.wScale != 1.0f) {
            k = 0;
            while (k < this.usedN) {
                wOut[k] = wOut[k] * this.wScale;
                k = k + 1;
            }
        }
        return;
    }

    /**
     * One token's MoE FFN on the host (15.9–15.11, 15.18):
     * `out = Σ_k w_k · down_k(act(gate_k(x)) · up_k(x))`, plus the gated
     * shared expert when the checkpoint ships one. Writes (does not
     * accumulate) `hidden` floats at `out[outOff]`. `act` is the layer's
     * GLU activation. Only the SELECTED experts' bank bytes are read —
     * that is 15.16's sparsity claim, and ExpertBank's counters at the
     * mat-vec seam are its instrument.
     */
    /**
     * Unit 39 (spec 15.21.2, the expert half): the expert chain never
     * leaves the device. Routing runs on the HOST from `x` — the
     * caller's crossing already downloaded the normed activation for
     * exactly this — and each selected expert then chains
     * stage(x) -> gate -> up -> GLU -> stage(g) -> down -> axpby as
     * NoSync stream launches against its slots, accumulating into
     * `acc` (beta=0 on the first write). Nothing crosses per expert;
     * the caller folds `acc` into the residual with one addDevice.
     *
     * The MIXED regime (39.2.3): an expert without a launchable slot
     * runs its mat-vecs on the host from `x` — the windowed path,
     * counted as such — and its eOut goes up once and joins the same
     * accumulation. The stream is drained before that upload: the
     * previous expert's queued launches may still be reading the
     * shared stage and the scratch buffer.
     *
     * Returns false — take the unit-38 whole-host crossing — when the
     * model has a shared expert (a host-only sublayer today, qwen2moe;
     * the 30B and the qwen3moe fixture have none).
     */
    boolean forwardRowResident(KernelBuffer<float32> xDev,
            Tensor<float32> x, int64 xOff, KernelBuffer<float32> acc,
            int32 act) {
        if (this.sharedW != 0) { return false; }
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        int64 tr0 = Clock.nanoTime();
        this.routeInto(x, xOff, this.sc.sel, this.sc.w);
        MoeFfn.mtRouteNs = MoeFfn.mtRouteNs + (Clock.nanoTime() - tr0);
        int64 hid = (int64) this.hidden;
        int64 wid = (int64) this.widthN;
        boolean first = true;
        int32 k = 0;
        while (k < this.usedN) {
            int32 e = this.sc.sel[k];
            float32 w = this.sc.w[k];
            int64 tg0 = Clock.nanoTime();
            if (this.gateB.stagedKeepReady(e)
                    && this.upB.stagedKeepReady(e)
                    && this.downB.stagedKeepReady(e)) {
                Linear.stageDeviceActivation(xDev, hid);
                this.gateB.matvecStagedKeepAt(e);
                this.upB.matvecStagedKeepAt(e);
                MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs
                    + (Clock.nanoTime() - tg0);
                int64 tgl0 = Clock.nanoTime();
                Prim.gluDevice(this.gateB.outOf(e), this.upB.outOf(e),
                    wid, act);
                MoeFfn.mtGluNs = MoeFfn.mtGluNs
                    + (Clock.nanoTime() - tgl0);
                int64 td0 = Clock.nanoTime();
                Linear.stageDeviceActivation(this.gateB.outOf(e), wid);
                this.downB.matvecStagedKeepAt(e);
                MoeFfn.mtDownNs = MoeFfn.mtDownNs
                    + (Clock.nanoTime() - td0);
                int64 tc0 = Clock.nanoTime();
                Prim.axpbyDevice(acc, this.downB.outOf(e), w,
                    first ? 0.0f : 1.0f, hid);
                MoeFfn.mtCombNs = MoeFfn.mtCombNs
                    + (Clock.nanoTime() - tc0);
            } else {
                // Host mid-chain: exactly the windowed forwardRow body
                // for this one expert, then one upload into the same
                // accumulation.
                float32[] xb = x.hostBuffer();
                int64 xo = x.hostBase() + xOff;
                float32[] gb = this.sc.g.hostBuffer();
                int64 go = this.sc.g.hostBase();
                float32[] eb = this.sc.eOut.hostBuffer();
                int64 eo = this.sc.eOut.hostBase();
                this.gateB.matvecAt(e, xb, xo, gb, go);
                this.upB.matvecAt(e, xb, xo,
                    this.sc.u.hostBuffer(), this.sc.u.hostBase());
                MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs
                    + (Clock.nanoTime() - tg0);
                int64 tgl0 = Clock.nanoTime();
                Prim.gluRowHost(this.sc.g, 0L, this.sc.u, 0L,
                    this.sc.g, 0L, this.widthN, act);
                MoeFfn.mtGluNs = MoeFfn.mtGluNs
                    + (Clock.nanoTime() - tgl0);
                int64 td0 = Clock.nanoTime();
                this.downB.matvecAt(e, gb, go, eb, eo);
                MoeFfn.mtDownNs = MoeFfn.mtDownNs
                    + (Clock.nanoTime() - td0);
                int64 tc0 = Clock.nanoTime();
                if (this.crossDev == null) {
                    this.crossDev #= heap KernelBuffer<float32>(
                        (uint64) hid);
                    this.crossHost #= heap float32[hid];
                }
                // Queued launches may still read the stage and the
                // scratch; the slow path pays the drain, not the fast
                // one.
                KernelStream cs = QuantKernel.stream();
                cs.sync();
                int64 ci = 0;
                while (ci < hid) {
                    this.crossHost[ci] = eb[eo + ci];
                    ci = ci + 1;
                }
                this.crossDev.upload(this.crossHost, hid);
                Prim.axpbyDevice(acc, this.crossDev, w,
                    first ? 0.0f : 1.0f, hid);
                MoeFfn.mtCombNs = MoeFfn.mtCombNs
                    + (Clock.nanoTime() - tc0);
            }
            first = false;
            k = k + 1;
        }
        this.emitCacheRecord("row", h0, w0, a0, b0);
        return true;
    }

    /** Probe: print the device routing buffers (bench triage). */
    public void dumpZeroSync() {
        if (this.logitsDev == null) {
            System.stdout.println("zero-sync never engaged");
            return;
        }
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32 en = this.expertsN;
        float32[] lg = heap float32[en];
        this.logitsDev.download(lg, (int64) en);
        int32[] ids = heap int32[this.usedN];
        this.selDev.download(ids, (int64) this.usedN);
        float32[] ww = heap float32[this.usedN];
        this.wSelDev.download(ww, (int64) this.usedN);
        String o #= "logits:";
        int32 i = 0;
        while (i < en) { o #= o + " " + lg[i]; i = i + 1; }
        System.stdout.println(o);
        o #= "sel/w:";
        i = 0;
        while (i < this.usedN) {
            o #= o + " " + ids[i] + ":" + ww[i];
            i = i + 1;
        }
        System.stdout.println(o);
        return;
    }

    /** Probe access to the gate bank (bench attribution only). */
    public ExpertBank gate() { return this.gateB; }

    void ensureZeroSyncBufs() {
        if (this.logitsDev != null) { return; }
        int64 e = (int64) this.expertsN;
        int64 u = (int64) this.usedN;
        int64 wid = (int64) this.widthN;
        int64 hid = (int64) this.hidden;
        this.logitsDev #= heap KernelBuffer<float32>((uint64) e);
        this.probsDev #= heap KernelBuffer<float32>((uint64) e);
        this.selDev #= heap KernelBuffer<int32>((uint64) u);
        this.wSelDev #= heap KernelBuffer<float32>((uint64) u);
        this.gyDev #= heap KernelBuffer<float32>((uint64) (u * wid));
        this.uyDev #= heap KernelBuffer<float32>((uint64) (u * wid));
        this.dyDev #= heap KernelBuffer<float32>((uint64) (u * hid));
        this.xpXnDev #= heap KernelBuffer<int8>(
            (uint64) ((hid / 256L) * 320L));
        this.xpGyDev #= heap KernelBuffer<int8>(
            (uint64) ((u * wid / 256L) * 320L));
        return;
    }

    /** The zero-sync route's shape gate (cheap; the slab binds are the
     *  expensive half and latch their own refusal). */
    boolean zeroSyncReady() {
        if (this.sharedW != 0) { return false; }
        if (this.gating != 1) { return false; }
        if (this.hidden % 256 != 0) { return false; }
        if (this.widthN % 256 != 0) { return false; }
        if (!this.gateB.idReady() || !this.upB.idReady()
                || !this.downB.idReady()) {
            return false;
        }
        if (!this.gateB.ensureSlab() || !this.upB.ensureSlab()
                || !this.downB.ensureSlab()) {
            return false;
        }
        return true;
    }

    /**
     * Unit 40 (spec 15.21.2/15.21.3): the WHOLE MoE FFN as stream
     * launches — router mat-vec, softmax/top-k, one indirected launch
     * per bank against its slab, GLU and the weighted combine — with
     * sel/w living on the device and NOTHING crossing to the host. The
     * caller adds `acc` onto the residual; the token's only sync stays
     * the logits fetch at the tail. False = the caller keeps the
     * unit-39 chain (host routing through the crossing) or the
     * unit-38 whole-host crossing.
     */
    boolean forwardRowZeroSync(KernelBuffer<float32> xDev,
            KernelBuffer<float32> acc, int32 act) {
        if (!this.zeroSyncReady()) { return false; }
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        this.ensureZeroSyncBufs();
        int64 hid = (int64) this.hidden;
        int64 wid = (int64) this.widthN;
        if (!this.routerWUp) {
            // The router is ~1 MB of f32; up once, read every token.
            // TRANSPOSED to [E, H] here so the kernel's lanes stride a
            // row coalesced — the import layout is [in, out].
            int64 en = (int64) this.expertsN;
            int64 n = hid * en;
            float32[] rw #= heap float32[n];
            Tensor<float32> rt = this.router.weight;
            int64 j = 0;
            while (j < hid) {
                int64 e = 0;
                while (e < en) {
                    rw[e * hid + j] = rt.flatGet(j * en + e);
                    e = e + 1;
                }
                j = j + 1;
            }
            this.routerWDev #= heap KernelBuffer<float32>((uint64) n);
            this.routerWDev.upload(rw, n);
            this.routerWUp = true;
        }
        int64 tr0 = Clock.nanoTime();
        QuantKernel.routerF32MatVecLaunchNoSync(this.logitsDev,
            this.routerWDev, xDev, (int64) this.expertsN, hid);
        QuantKernel.moeTopKLaunchNoSync(this.selDev, this.wSelDev,
            this.logitsDev, this.probsDev, (int64) this.expertsN,
            (int64) this.usedN, this.normTopk, this.wScale);
        MoeFfn.mtRouteNs = MoeFfn.mtRouteNs + (Clock.nanoTime() - tr0);
        int64 tg0 = Clock.nanoTime();
        QuantKernel.q8kPackLaunchNoSync(this.xpXnDev, xDev, hid);
        this.gateB.idLaunch(this.gyDev, this.xpXnDev, this.selDev,
            this.usedN, 0L);
        this.upB.idLaunch(this.uyDev, this.xpXnDev, this.selDev,
            this.usedN, 0L);
        MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs + (Clock.nanoTime() - tg0);
        int64 tgl0 = Clock.nanoTime();
        Prim.gluDevice(this.gyDev, this.uyDev,
            (int64) this.usedN * wid, act);
        MoeFfn.mtGluNs = MoeFfn.mtGluNs + (Clock.nanoTime() - tgl0);
        int64 td0 = Clock.nanoTime();
        QuantKernel.q8kPackLaunchNoSync(this.xpGyDev, this.gyDev,
            (int64) this.usedN * wid);
        this.downB.idLaunch(this.dyDev, this.xpGyDev, this.selDev,
            this.usedN, wid / 256L);
        MoeFfn.mtDownNs = MoeFfn.mtDownNs + (Clock.nanoTime() - td0);
        int64 tc0 = Clock.nanoTime();
        QuantKernel.moeCombineLaunchNoSync(acc, this.dyDev,
            this.wSelDev, (int64) this.usedN, hid);
        MoeFfn.mtCombNs = MoeFfn.mtCombNs + (Clock.nanoTime() - tc0);
        this.emitCacheRecord("row", h0, w0, a0, b0);
        return true;
    }

    public void forwardRow(Tensor<float32> x, int64 xOff,
            Tensor<float32> out, int64 outOff, int32 act) {
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        int64 tr0 = Clock.nanoTime();
        this.routeInto(x, xOff, this.sc.sel, this.sc.w);
        MoeFfn.mtRouteNs = MoeFfn.mtRouteNs + (Clock.nanoTime() - tr0);
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase() + xOff;
        float32[] ob = out.hostBuffer();
        int64 oo = out.hostBase() + outOff;
        int64 j = 0;
        while (j < (int64) this.hidden) {
            ob[oo + j] = 0.0f;
            j = j + 1;
        }
        float32[] gb = this.sc.g.hostBuffer();
        int64 go = this.sc.g.hostBase();
        float32[] eb = this.sc.eOut.hostBuffer();
        int64 eo = this.sc.eOut.hostBase();
        int32 k = 0;
        while (k < this.usedN) {
            int32 e = this.sc.sel[k];
            int64 tg0 = Clock.nanoTime();
            // moe-cache 2.2.1: a RESIDENT expert's mat-vec launches on
            // the device against its slot; an un-admitted one keeps
            // the host path. Per expert, per bank (spec 3.3.2) — the
            // combination below is identical either way.
            if (!this.gateB.matvecDeviceAt(e, xb, xo, gb, go)) {
                this.gateB.matvecAt(e, xb, xo, gb, go);
            }
            if (!this.upB.matvecDeviceAt(e, xb, xo,
                    this.sc.u.hostBuffer(), this.sc.u.hostBase())) {
                this.upB.matvecAt(e, xb, xo,
                    this.sc.u.hostBuffer(), this.sc.u.hostBase());
            }
            int64 tgl0 = Clock.nanoTime();
            MoeFfn.mtGateUpNs = MoeFfn.mtGateUpNs + (tgl0 - tg0);
            Prim.gluRowHost(this.sc.g, 0L, this.sc.u, 0L, this.sc.g, 0L,
                this.widthN, act);
            int64 td0 = Clock.nanoTime();
            MoeFfn.mtGluNs = MoeFfn.mtGluNs + (td0 - tgl0);
            if (!this.downB.matvecDeviceAt(e, gb, go, eb, eo)) {
                this.downB.matvecAt(e, gb, go, eb, eo);
            }
            int64 tc0 = Clock.nanoTime();
            MoeFfn.mtDownNs = MoeFfn.mtDownNs + (tc0 - td0);
            float32 w = this.sc.w[k];
            j = 0;
            while (j < (int64) this.hidden) {
                ob[oo + j] = ob[oo + j] + w * eb[eo + j];
                j = j + 1;
            }
            MoeFfn.mtCombNs = MoeFfn.mtCombNs + (Clock.nanoTime() - tc0);
            k = k + 1;
        }
        int64 tsh0 = Clock.nanoTime();
        this.addSharedRow(x, xOff, ob, oo, act);
        MoeFfn.mtSharedNs = MoeFfn.mtSharedNs + (Clock.nanoTime() - tsh0);
        this.emitCacheRecord("row", h0, w0, a0, b0);
        return;
    }

    /**
     * 15.18: the dense shared expert for one row, ADDED into
     * `ob[oo…oo+hidden)`, gated by its own learned sigmoid when the
     * file carries the gate vector (qwen2moe; computed as sigma(g.x) —
     * llama.cpp spells the same value silu(z)/z). No-op when the model
     * binds no shared expert. Shared by the per-row and grouped paths.
     */
    void addSharedRow(Tensor<float32> x, int64 xOff, float32[] ob,
            int64 oo, int32 act) {
        if (this.sharedGateProj == null) {
            return;
        }
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase() + xOff;
        this.sharedGateProj.matvecInto(x, xOff, this.sc.shG, 0L);
        this.sharedUpProj.matvecInto(x, xOff, this.sc.shU, 0L);
        Prim.gluRowHost(this.sc.shG, 0L, this.sc.shU, 0L,
            this.sc.shG, 0L, this.sharedW, act);
        this.sharedDownProj.matvecInto(this.sc.shG, 0L,
            this.sc.shOut, 0L);
        float32 gs = 1.0f;
        int64 j = 0;
        if (this.sharedGate != null) {
            float32[] gv = this.sharedGate.hostBuffer();
            int64 gvo = this.sharedGate.hostBase();
            float32 z = 0.0f;
            j = 0;
            while (j < (int64) this.hidden) {
                z = z + gv[gvo + j] * xb[xo + j];
                j = j + 1;
            }
            gs = 1.0f / (1.0f + Math.exp(0.0f - z));
        }
        float32[] sb = this.sc.shOut.hostBuffer();
        int64 so = this.sc.shOut.hostBase();
        j = 0;
        while (j < (int64) this.hidden) {
            ob[oo + j] = ob[oo + j] + gs * sb[so + j];
            j = j + 1;
        }
        return;
    }

    /**
     * The grouped batch forward (15.12): route every row, group the
     * (row, expert, weight) picks by expert, and serve each selected
     * expert ONCE — dequantize its bank bytes one time and GEMM the
     * whole gathered group through them (`ExpertBank.gemmAt`), then
     * weighted-scatter the group outputs back to their rows. `x` and
     * `out` are row-major [rows x hidden] at host offset 0. The device
     * expert dispatch (28.2.1's coop route) hangs off this same
     * grouping; with routing off or unroutable banks the host GEMM
     * above is the whole story.
     */
    public void forwardBatch(Tensor<float32> x, Tensor<float32> out,
            int32 rows, int32 act) {
        int64 h0 = ExpertBank.residencyHits();
        int64 w0 = ExpertBank.residencyWindowed();
        int64 a0 = ExpertBank.residencyAdmissions();
        int64 b0 = ExpertBank.residencyAdmissionBytes();
        this.sc.ensureBatch(rows, this.usedN, this.expertsN,
            this.widthN, this.hidden);
        int64 h = (int64) this.hidden;
        int32 r = 0;
        while (r < rows) {
            this.routeInto(x, (int64) r * h, this.sc.sel, this.sc.w);
            int32 k = 0;
            while (k < this.usedN) {
                this.sc.selAll[r * this.usedN + k] = this.sc.sel[k];
                this.sc.wAll[r * this.usedN + k] = this.sc.w[k];
                k = k + 1;
            }
            r = r + 1;
        }
        float32[] ob = out.hostBuffer();
        int64 oo = out.hostBase();
        int64 zi = 0;
        while (zi < (int64) rows * h) {
            ob[oo + zi] = 0.0f;
            zi = zi + 1;
        }
        // Group by expert: counting sort of the rows*used picks.
        int32 e = 0;
        while (e < this.expertsN) {
            this.sc.gCnt[e] = 0;
            e = e + 1;
        }
        int32 np = rows * this.usedN;
        int32 i = 0;
        while (i < np) {
            this.sc.gCnt[this.sc.selAll[i]] =
                this.sc.gCnt[this.sc.selAll[i]] + 1;
            i = i + 1;
        }
        this.sc.gOff[0] = 0;
        e = 0;
        while (e < this.expertsN) {
            this.sc.gOff[e + 1] = this.sc.gOff[e] + this.sc.gCnt[e];
            this.sc.gCur[e] = this.sc.gOff[e];
            e = e + 1;
        }
        i = 0;
        while (i < np) {
            int32 ex = this.sc.selAll[i];
            int32 slot = this.sc.gCur[ex];
            this.sc.gCur[ex] = slot + 1;
            this.sc.gRow[slot] = i / this.usedN;
            this.sc.gW[slot] = this.sc.wAll[i];
            i = i + 1;
        }
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase();
        float32[] bxb = this.sc.bx.hostBuffer();
        int64 bxo = this.sc.bx.hostBase();
        float32[] bgb = this.sc.bg.hostBuffer();
        int64 bgo = this.sc.bg.hostBase();
        float32[] bub = this.sc.bu.hostBuffer();
        int64 buo = this.sc.bu.hostBase();
        float32[] beb = this.sc.be.hostBuffer();
        int64 beo = this.sc.be.hostBase();
        int64 wN = (int64) this.widthN;
        e = 0;
        while (e < this.expertsN) {
            int32 g0 = this.sc.gOff[e];
            int32 m = this.sc.gOff[e + 1] - g0;
            if (m > 0) {
                int32 t = 0;
                while (t < m) {
                    int64 src = xo
                        + (int64) this.sc.gRow[g0 + t] * h;
                    int64 dst = bxo + (int64) t * h;
                    int64 j = 0;
                    while (j < h) {
                        bxb[dst + j] = xb[src + j];
                        j = j + 1;
                    }
                    t = t + 1;
                }
                // The DEVICE expert dispatch (28.2.1): the same
                // grouping, with each bank's GEMM going through its
                // stride-sized expert window and the existing batched
                // route (coop on vulkan, dp4a elsewhere). Falls to the
                // host dequant GEMM per group when any bank cannot
                // route — same math, same counters, one variable.
                boolean dev = this.gateB.devRoutableFor(m)
                    && this.upB.devRoutableFor(m)
                    && this.downB.devRoutableFor(m);
                if (dev) {
                    Linear.stageBatch(this.sc.bx, 0L, m, this.hidden,
                        Linear.nextStageTag());
                    this.gateB.gemmDeviceAt(e, m, this.sc.bg, 0L);
                    this.upB.gemmDeviceAt(e, m, this.sc.bu, 0L);
                } else {
                    this.gateB.gemmAt(e, bxb, bxo, m, bgb, bgo,
                        this.sc.dq);
                    this.upB.gemmAt(e, bxb, bxo, m, bub, buo,
                        this.sc.dq);
                }
                t = 0;
                while (t < m) {
                    Prim.gluRowHost(this.sc.bg, (int64) t * wN,
                        this.sc.bu, (int64) t * wN,
                        this.sc.bg, (int64) t * wN, this.widthN, act);
                    t = t + 1;
                }
                if (dev) {
                    Linear.stageBatch(this.sc.bg, 0L, m, this.widthN,
                        Linear.nextStageTag());
                    this.downB.gemmDeviceAt(e, m, this.sc.be, 0L);
                } else {
                    this.downB.gemmAt(e, bgb, bgo, m, beb, beo,
                        this.sc.dq);
                }
                t = 0;
                while (t < m) {
                    float32 w = this.sc.gW[g0 + t];
                    int64 dst = oo
                        + (int64) this.sc.gRow[g0 + t] * h;
                    int64 src = beo + (int64) t * h;
                    int64 j = 0;
                    while (j < h) {
                        ob[dst + j] = ob[dst + j] + w * beb[src + j];
                        j = j + 1;
                    }
                    t = t + 1;
                }
            }
            e = e + 1;
        }
        r = 0;
        while (r < rows) {
            this.addSharedRow(x, (int64) r * h, ob, oo + (int64) r * h,
                act);
            r = r + 1;
        }
        this.emitCacheRecord("batch", h0, w0, a0, b0);
        return;
    }

    /**
     * moe-expert-cache unit 3 (spec 8.1): ONE record per MoE layer
     * call — this layer's slot hits, windowed fallbacks, admissions
     * and admitted bytes for the call just made, plus this layer's
     * total resident bytes. The per-layer hit/fallback split cabra
     * renders IS the record stream keyed by v0. Emitted through the
     * unit-21 seam: with no callback registered `Diag.emit` builds
     * nothing, and the four counter snapshots around the call are
     * plain static reads. A dense model never reaches this method, so
     * a non-MoE run emits nothing (spec 9.1.5) without a guard.
     */
    void emitCacheRecord(String mode, int64 h0, int64 w0, int64 a0,
            int64 b0) {
        if (!Diag.on()) { return; }
        int64 res = this.gateB.residentBytes()
            + this.upB.residentBytes() + this.downB.residentBytes();
        Diag.emit("expert-cache", 0 - 1, mode, (int64) this.layerIdx,
            ExpertBank.residencyHits() - h0,
            ExpertBank.residencyWindowed() - w0,
            ExpertBank.residencyAdmissions() - a0,
            ExpertBank.residencyAdmissionBytes() - b0,
            res);
        return;
    }

    /** Zero every bank's per-expert byte counters (15.16's window). */
    public void resetTouched() {
        this.gateB.resetTouched();
        this.upB.resetTouched();
        this.downB.resetTouched();
        return;
    }

    /** Can a group of `m` rows take the device expert GEMMs on all
     *  three banks (28.1.2's gate)? Honors the routing switch. */
    public boolean deviceGroupedFor(int32 m) {
        return this.gateB.devRoutableFor(m)
            && this.upB.devRoutableFor(m)
            && this.downB.devRoutableFor(m);
    }

    public int32 experts() {
        return this.expertsN;
    }

    public int32 used() {
        return this.usedN;
    }

    /** The per-expert FFN width, resolved at bind. */
    public int32 width() {
        return this.widthN;
    }

    public ExpertBank gateBank() {
        return this.gateB;
    }

    public ExpertBank upBank() {
        return this.upB;
    }

    public ExpertBank downBank() {
        return this.downB;
    }

    public boolean hasShared() {
        return this.sharedGateProj != null;
    }

    /** 15.18: the shared expert's own learned sigmoid gate. */
    public boolean hasSharedGate() {
        return this.sharedGate != null;
    }
}
