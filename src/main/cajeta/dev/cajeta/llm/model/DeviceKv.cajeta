package dev.cajeta.llm.model;

import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.Diag;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.QuantKernel;

/**
 * Device-resident K/V for ONE decoding sequence, plus the scratch the
 * decode attend needs (plan 10.11.2).
 *
 * Each layer's planes are blocks of 64 positions read through a block
 * table (15.2.21.8.1): position `t` is at row `tab[base + t / 64] * 64 +
 * t % 64`, the kernels look it up through {@link KvPage#row}, and the host
 * keeps the same entries for the rows it writes. A pooled slot's table is
 * a {@link KvPool}'s: the shared one, or a one-slot pool of its own; a
 * windowed layer's ring names its blocks cyclically, so its table holds no
 * modulo either.
 *
 * The price is that the two copies can disagree, and the rule that keeps
 * them honest is explicit rather than clever: while `owns()` is true the
 * DEVICE planes are authoritative for positions `[hostLen, len)`, the
 * host cache's length has already been advanced to match, and the host
 * bytes for that range are stale. Anything that wants to read the host
 * cache calls {@link #writeback} first. `CausalLM` does exactly
 * that whenever a token takes the non-resident path.
 */
public final class DeviceKv {
    /** The planes are HALF (unit 57, spec 15.21.6): llama.cpp's default
     *  cache type, and half the bytes the decode flash kernel streams
     *  per layer. Every kernel that reads them widens on load; the host
     *  paged cache stays f32 and seed/writeback convert. */
    /** The pool holding this slot's planes and table: the shared one, a BORROW, or {@link #ownPool}. */
    KvPool pool;
    /** This slot's index in {@link #pool}. */
    int32 slotIx;
    /** Positions whose blocks this slot has ensured. */
    int32 ready;
    /** Per-layer RoPE frequencies. Per LAYER, not per model: `theta` and
     *  the scaling are layer state (spec §5 preamble), and sharing one
     *  buffer would be right for Llama and silently wrong elsewhere. */
    KernelBuffer<float32>[] invDev;
    /** `[nH x cap]` scores scratch, reused by every layer. */
    KernelBuffer<float32> scores;
    /** `[nH x headDim]` attention output, consumed by `o_proj` in place. */
    KernelBuffer<float32> aoDev;
    /** Host staging for seeding and writeback: `[cap x kvDim]`, one plane
     *  at a time — f32 for the paged cache's side, half for the plane's. */
    float32[] stageK;
    float32[] stageV;
    float16[] stageK16;
    float16[] stageV16;

    int32 cap;
    /** Rows each layer's planes hold: `cap` rounded up to a block, or a windowed layer's ring when that is shorter. */
    int32[] rows;
    /** Each layer's window; 0 attends every position. */
    int32[] win;
    /** The one-slot pool an owning slot holds its planes in; null for a slot of the shared pool. */
    KvPool ownPool;
    /** Layer `l`'s table base in the pool's table. */
    int32[] tbDev;
    int32 kvDim;
    int32 layers;
    int32 nH;
    int32 nKv;
    int32 hd;
    /** Positions present in the device planes. */
    int32 len;
    /** Positions the HOST cache holds real bytes for. `len - hostLen` is
     *  what a writeback owes. */
    int32 hostLen;
    /** Which sequence the planes hold; -1 when they hold nothing. */
    int32 seq;
    /** This slot's place in the shared {@link KvPool}; -1 when it owns its planes. */
    int32 poolSlot;

    static int32 ringSlack = 256;

    /** Positions a ring keeps beyond its window, so a prefill chunk of that many rows attends without losing keys. */
    public static void setRingSlack(int32 n) { DeviceKv.ringSlack = n; }

    /** Whether this configuration can take the device attend: `headDim <= 256` (the combine kernels' 128 lanes
     *  take two output dimensions each), and for a windowed layer the kernels its ring's prefill needs. */
    public static boolean supports(ModelConfig cfg) {
        if (cfg.headDim > 256) { return false; }
        if (cfg.headDim % 2 != 0) { return false; }
        if (cfg.numHeads % cfg.numKvHeads != 0) { return false; }
        int32 l = 0;
        while (l < cfg.numLayers) {
            if (cfg.windowForLayer(l) > 0) { return KernelCap.ringHere(); }
            l = l + 1;
        }
        return true;
    }

    /** Rows a layer of window `w` (0 for none) holds at capacity `cap`: whole blocks, and a ring of the window,
     *  one block and the slack when that is shorter. */
    public static int32 ringRows(int32 w, int32 cap) {
        int32 flat = KvPage.blocksFor(cap) * KvPage.BLOCK;
        if (w > 0) {
            int32 r = (KvPage.blocksFor(w) + 1 + KvPage.blocksFor(DeviceKv.ringSlack)) * KvPage.BLOCK;
            if (r < flat) { return r; }
        }
        return flat;
    }

    /** Rows layer `l`'s planes hold at capacity `cap`. */
    public static int32 planeRows(ModelConfig cfg, int32 cap, int32 l) {
        return DeviceKv.ringRows(cfg.windowForLayer(l), cap);
    }

    /** A pool for `cfg`'s layers at capacity `cap`, holding no slot. */
    public static #KvPool poolFor(ModelConfig cfg, int32 cap) {
        int32[] w #= heap int32[(int64) cfg.numLayers];
        int32 l = 0;
        while (l < cfg.numLayers) {
            w[(int64) l] = cfg.windowForLayer(l);
            l = l + 1;
        }
        KvPool p #= heap KvPool(cap, cfg.kvDim(), w);
        return #p;
    }

    /** Rows over every layer: what one slot's K planes hold. */
    public static int64 planeRowsAll(ModelConfig cfg, int32 cap) {
        int64 n = 0L;
        int32 l = 0;
        while (l < cfg.numLayers) {
            n = n + (int64) DeviceKv.planeRows(cfg, cap, l);
            l = l + 1;
        }
        return n;
    }

    /** True when some layer's planes are a ring shorter than the flat planes. */
    public static boolean ringed(ModelConfig cfg, int32 cap) {
        return DeviceKv.planeRowsAll(cfg, cap)
            < (int64) cfg.numLayers * (int64) (KvPage.blocksFor(cap) * KvPage.BLOCK);
    }

    /** Take slot `slot` of `pool`: each layer's rows from its kind, this slot's table regions, the buffers. */
    void setup(ModelConfig cfg, int32 cap, KvPool pool, int32 slot) {
        this.cap = cap;
        this.kvDim = cfg.kvDim();
        this.layers = cfg.numLayers;
        this.nH = cfg.numHeads;
        this.nKv = cfg.numKvHeads;
        this.hd = cfg.headDim;
        this.len = 0;
        this.hostLen = 0;
        this.seq = 0 - 1;
        this.rows #= heap int32[(int64) this.layers];
        this.win #= heap int32[(int64) this.layers];
        this.tbDev #= heap int32[(int64) this.layers];
        int32 l = 0;
        while (l < this.layers) {
            int32 kd = pool.kindOf(l);
            this.rows[(int64) l] = pool.rowsOf(kd);
            this.win[(int64) l] = cfg.windowForLayer(l);
            this.tbDev[(int64) l] = pool.tableBase(slot, kd);
            l = l + 1;
        }
        this.slotIx = slot;
        this.ready = 0;
        this.invDev #= heap KernelBuffer<float32>[(int64) this.layers];
        this.bindPool(pool);
        this.scores #= heap KernelBuffer<float32>(
            (uint64) ((int64) this.nH * (int64) cap));
        this.aoDev #= heap KernelBuffer<float32>(
            (uint64) ((int64) this.nH * (int64) this.hd));
        return;
    }

    /** The plane row holding position `p` of layer `li`, once its block is ensured. */
    public int32 rowOf(int32 li, int32 p) {
        return this.pool.entry(this.tbDev[(int64) li] + p / KvPage.BLOCK) * KvPage.BLOCK + p % KvPage.BLOCK;
    }

    /** Draw the blocks positions `[0, upTo)` fall in and upload the table if that changed it. */
    public void ensureRows(int32 upTo) {
        if (upTo <= this.ready) { return; }
        this.pool.ensureRows(this.slotIx, upTo);
        this.pool.flush();
        this.ready = upTo;
        return;
    }

    /** Layer `li`'s K buffer in the pool, a BORROW. */
    KernelBuffer<float16> kOf(int32 li) { return this.pool.kAll(li); }

    /** Layer `li`'s V buffer in the pool, a BORROW. */
    KernelBuffer<float16> vOf(int32 li) { return this.pool.vAll(li); }

    /** Layer `li`'s table base in {@link #table}. */
    public int32 tableBase(int32 li) { return this.tbDev[(int64) li]; }

    /** The block table the kernels read for this slot, a BORROW. */
    public KernelBuffer<int32> table() { return this.pool.table(); }

    /** Positions layer `li` keeps once `n` have been appended: its window's worth for a windowed layer. */
    int32 heldOf(int32 li, int32 n) {
        int32 w = this.win[(int64) li];
        if (w > 0 && n > w) { return w; }
        return n;
    }

    /** Forget everything the planes hold (warmup reset): the buffers
     *  stay allocated and touched; the next append starts at 0. */
    public void reset() {
        this.pool.release(this.slotIx);
        this.ready = 0;
        this.len = 0;
        this.hostLen = 0;
        this.seq = 0 - 1;
        return;
    }

    /** A slot that holds its planes in a one-slot pool of its own. */
    public DeviceKv(ModelConfig cfg, int32 cap) {
        this.ownPool #= DeviceKv.poolFor(cfg, cap);
        this.ownPool.ensureSlots(1);
        this.setup(cfg, cap, this.ownPool, 0);
        this.poolSlot = 0 - 1;
    }

    /** A slot whose planes are slot `slot` of `pool`, whose plane is `cap` positions. */
    public DeviceKv(ModelConfig cfg, int32 cap, KvPool pool, int32 slot) {
        this.setup(cfg, cap, pool, slot);
        this.poolSlot = slot;
    }

    /** Read planes and table through `pool` from now on: after it replaces this slot's pool. */
    public void bindPool(KvPool pool) {
        this.pool #= pool;
        return;
    }

    /** Layer `li`'s RoPE frequencies, a BORROW. */
    public KernelBuffer<float32> inv(int32 li) { return this.invDev[(int64) li]; }

    /** This slot's place in the shared pool, or -1 when it owns its planes. */
    public int32 poolSlot() { return this.poolSlot; }

    /** Allocate the host staging on first use; a device-only slot never needs it. */
    void ensureHostStage() {
        if (this.stageK != null) { return; }
        int64 plane = (int64) this.cap * (int64) this.kvDim;
        this.stageK #= heap float32[plane];
        this.stageV #= heap float32[plane];
        this.stageK16 #= heap float16[plane];
        this.stageV16 #= heap float16[plane];
        return;
    }

    /** Host staging bytes this slot holds. */
    public int64 hostStageBytes() {
        int64 n = 0L;
        if (this.stageK != null) { n = n + 8L * (int64) this.stageK.count(); }
        if (this.stageK16 != null) { n = n + 4L * (int64) this.stageK16.count(); }
        return n;
    }

    /** Upload each layer's RoPE frequencies once. */
    public void bindRope(DecoderModel model) {
        int32 l = 0;
        while (l < this.layers) {
            Attention a = model.layerArr[l].selfAttn;
            int64 n = (int64) a.ropeInv.count();
            this.invDev[(int64) l] #= heap KernelBuffer<float32>((uint64) n);
            this.invDev[(int64) l].upload(a.ropeInv);
            l = l + 1;
        }
        return;
    }

    /** True when the device planes hold positions the host cache does
     *  not. */
    public boolean owns() {
        return this.seq >= 0 && this.len > this.hostLen;
    }

    /**
     * Make the device planes hold exactly what `cache` holds for `seq`.
     * Called on the transition into device-resident decode — after
     * prefill, or after any token that took the host path.
     */
    public void seed(PagedKvCache cache, int32 seq) {
        int32 want = cache.lengthOf(seq, 0);
        if (want > this.cap) {
            throw heap LlmException("device kv: context " + want
                + " exceeds the allocated capacity " + this.cap);
        }
        this.ensureRows(want);
        int32 l = 0;
        while (l < this.layers) {
            int32 n = cache.lengthOf(seq, l);
            if (n > 0) {
                this.ensureHostStage();
                int32 held = this.heldOf(l, n);
                cache.copyRowsTo(seq, l, n - held, n, this.stageK, this.stageV);
                this.uploadRows(l, n - held, held);
            }
            l = l + 1;
        }
        this.seq = seq;
        this.len = want;
        this.hostLen = want;
        return;
    }

    /** True when the planes already hold `cache`'s state for `seq`. */
    public boolean isCurrentFor(PagedKvCache cache, int32 seq) {
        return this.seq == seq && this.hostLen == cache.lengthOf(seq, 0)
            && this.len >= this.hostLen;
    }

    /**
     * Copy the device-only positions back into the paged cache, so the
     * host path can run again. The reverse of {@link #seed}, and the only
     * thing that makes device authority safe.
     */
    public void writeback(PagedKvCache cache, int32 seq) {
        if (!this.owns()) { return; }
        KernelStream s = QuantKernel.stream();
        s.sync();
        this.copyOut(cache, seq, this.hostLen, this.len);
        this.hostLen = this.len;
        return;
    }

    /** Append positions `[from, to)` of every layer to `cache` from the planes, `to` being the planes' length; a
     *  ring gives the positions it still holds and the cache skips the rest. The caller has synced the stream. */
    public void copyOut(PagedKvCache cache, int32 seq, int32 from, int32 to) {
        this.ensureHostStage();
        int32 l = 0;
        while (l < this.layers) {
            int32 held = this.heldOf(l, to);
            int32 t = from;
            if (to - held > t) {
                t = to - held;
                cache.skipTo(seq, l, t);
            }
            this.downloadRows(l, to - held, held);
            while (t < to) {
                int64 off = (int64) (t - (to - held)) * (int64) this.kvDim;
                if (!cache.appendRowRaw(seq, l, this.stageK, off,
                        this.stageV, off, t)) {
                    throw heap LlmException("kv writeback: pool "
                        + "exhausted at layer " + l + " position " + t);
                }
                t = t + 1;
            }
            l = l + 1;
        }
        return;
    }

    // ── the per-layer decode tail ───────────────────────────────────────

    /** Rotate q and k in place at absolute position `p`. */
    public void rope(int32 li, KernelBuffer<float32> q, KernelBuffer<float32> k,
            int32 p) {
        if ((AttnKernel.skipForMeasurement() & 1) != 0) { return; }
        AttnKernel.ropeDecodeLaunchNoSync(q, this.invDev[(int64) li],
            this.nH, this.hd, p);
        AttnKernel.ropeDecodeLaunchNoSync(k, this.invDev[(int64) li],
            this.nKv, this.hd, p);
        return;
    }

    /**
     * Unit 48: QK-norm (when the weights are given), RoPE of q and k,
     * and the K/V append at position `p` — one launch. `qw`/`kw` null
     * = no norm. Requires hd <= 128 (a block owns a head); the caller
     * falls back to the separate verbs otherwise.
     */
    public boolean prep(int32 li, KernelBuffer<float32> q,
            KernelBuffer<float32> k, KernelBuffer<float32> v,
            KernelBuffer<float32> qw, KernelBuffer<float32> kw,
            float32 eps, int32 form, int32 p) {
        if (this.hd > 128 || this.hd % 2 != 0) { return false; }
        if (p >= this.cap) {
            throw heap LlmException("device kv: position " + p
                + " exceeds the allocated capacity " + this.cap);
        }
        if (AttnKernel.skipForMeasurement() != 0) { return false; }
        this.ensureRows(p + 1);
        boolean norm = qw != null;
        KernelBuffer<float32> qwv = qw;
        KernelBuffer<float32> kwv = kw;
        if (!norm) { qwv = this.invDev[(int64) li]; kwv = qwv; }
        AttnKernel.qkPrepLaunchNoSync(q, k, v, this.kOf(li),
            this.vOf(li), qwv, kwv, this.invDev[(int64) li],
            this.nH, this.nKv, this.hd, norm, eps, form, this.rowOf(li, p), p);
        return true;
    }

    /** Append the rotated K row and the V row at position `p`. */
    public void append(int32 li, KernelBuffer<float32> k, KernelBuffer<float32> v,
            int32 p) {
        if (p >= this.cap) {
            throw heap LlmException("device kv: position " + p
                + " exceeds the allocated capacity " + this.cap);
        }
        if ((AttnKernel.skipForMeasurement() & 2) != 0) { return; }
        this.ensureRows(p + 1);
        AttnKernel.kvAppendLaunchNoSync(this.kOf(li),
            this.vOf(li), k, v, this.kvDim, this.rowOf(li, p));
        return;
    }

    /** The first position layer `li` attends from at position `p`. */
    int32 loOf(int32 li, int32 p) { return p + 1 - this.heldOf(li, p + 1); }

    /** Attend over the positions layer `li` holds up to `p`, leaving the result in {@link #out}. */
    public void attend(int32 li, KernelBuffer<float32> q, int32 p, float32 scale) {
        int32 lo = this.loOf(li, p);
        AttnKernel.attendDecodeLaunchNoSync(this.aoDev, this.scores, q,
            this.kOf(li), this.vOf(li), this.pool.table(), this.tbDev[(int64) li], this.nH,
            this.nKv, this.hd, p + 1 - lo, lo, this.cap, scale);
        return;
    }

    /** Unit 50: attend leaving only the split partials (for the
     *  reduce + pack launch); false = shape not served. */
    public boolean attendPartials(int32 li, KernelBuffer<float32> q, int32 p,
            float32 scale) {
        int32 lo = this.loOf(li, p);
        return AttnKernel.attendDecodePartialsLaunchNoSync(q,
            this.kOf(li), this.vOf(li), this.pool.table(), this.tbDev[(int64) li], this.nH,
            this.nKv, this.hd, p + 1 - lo, lo, scale);
    }

    /** The attention output buffer — a BORROW, valid until the next
     *  attend overwrites it. */
    public KernelBuffer<float32> out() { return this.aoDev; }

    // ── prefill (plan 10.12.2) ──────────────────────────────────────────

    KernelBuffer<float32> preK;
    KernelBuffer<float32> preV;
    KernelBuffer<float32> preQ;
    KernelBuffer<float32> preOut;
    KernelBuffer<float32> preScores;
    int64 preScoresN;

    /** Device bytes of the prefill scores buffer (4 where no path reads it). */
    public int64 prefillScoresBytes() { return this.preScoresN * 4L; }
    float32[] preOutH;
    float32[] preQH;
    float32[] preKH;
    float32[] preVH;
    int32 preRows;

    /** Copy `n` elements from a tensor's window into a flat array. */
    static void gather(Tensor<float32> t, int64 n, float32[] out) {
        float32[] hb = t.hostBuffer();
        int64 base = t.hostBase();
        int64 i = 0;
        while (i < n) {
            out[i] = hb[base + i];
            i = i + 1;
        }
        return;
    }

    KernelBuffer<float32> winScores;
    int64 winScoresN;

    /** Scores for a windowed attend of `rows` rows where its route reads them; one float where it does not. */
    KernelBuffer<float32> windowScores(int32 rows) {
        int64 n = 1L;
        if (AttnKernel.windowScoresRead(this.nH, this.nKv, this.hd)) {
            n = (int64) rows * (int64) this.nH * (int64) this.cap;
        }
        if (this.winScoresN < n) {
            Diag.growth();
            this.winScores #= heap KernelBuffer<float32>((uint64) n);
            this.winScoresN = n;
        }
        return this.winScores;
    }

    /** Write `rows` K/V rows of layer `li` at positions `p0` on; a non-null `inv` rotates q and k on the way. */
    void place(int32 li, KernelBuffer<float32> q, KernelBuffer<float32> k, KernelBuffer<float32> v,
            KernelBuffer<float32> inv, KernelBuffer<int32> pos, int32 rows, int32 p0) {
        KernelBuffer<float16> kd = this.kOf(li);
        KernelBuffer<float16> vd = this.vOf(li);
        KernelBuffer<int32> tabDev = this.pool.table();
        int32 tb = this.tbDev[(int64) li];
        if (inv != null) {
            AttnKernel.ropeAppendRowsLaunchNoSync(q, k, v, kd, vd, tabDev, tb, inv, pos, rows, this.nH,
                this.nKv, this.hd, p0);
        } else {
            AttnKernel.kvAppendRangeLaunchNoSync(kd, vd, tabDev, tb, k, v, this.kvDim, p0, rows);
        }
        return;
    }

    /** Place and attend `rows` rows at positions `p0` on, the whole causal range or the layer's window. */
    void attendPiece(int32 li, KernelBuffer<float32> q, KernelBuffer<float32> k, KernelBuffer<float32> v,
            KernelBuffer<float32> inv, KernelBuffer<int32> pos, int32 rows, int32 p0, float32 scale,
            KernelBuffer<float32> out) {
        this.place(li, q, k, v, inv, pos, rows, p0);
        KernelBuffer<float16> kd = this.kOf(li);
        KernelBuffer<float16> vd = this.vOf(li);
        KernelBuffer<int32> tabDev = this.pool.table();
        int32 tb = this.tbDev[(int64) li];
        int32 w = this.win[(int64) li];
        if (w > 0 && p0 + rows > w) {
            AttnKernel.attendPrefillWindowLaunchNoSync(out, this.windowScores(rows), q, kd, vd, tabDev, tb, rows,
                this.nH, this.nKv, this.hd, p0, this.cap, scale, w);
            return;
        }
        AttnKernel.attendPrefillLaunchNoSync(out, this.preScores, q, kd, vd, tabDev, tb, rows, this.nH,
            this.nKv, this.hd, p0, this.cap, scale);
        return;
    }

    /** Place `rows` K/V rows at `startPos` and attend them into `out`; NoSync. A ring takes the chunk in pieces of
     *  at most the slack, so no piece overwrites a key an earlier row of it still reads. */
    void placeAndAttend(int32 li, KernelBuffer<float32> q, KernelBuffer<float32> k, KernelBuffer<float32> v,
            KernelBuffer<float32> inv, KernelBuffer<int32> pos, int32 rows, int32 startPos, float32 scale,
            KernelBuffer<float32> out) {
        if (startPos + rows > this.cap) {
            throw heap LlmException("device kv: positions " + startPos + " to " + (startPos + rows)
                + " exceed the allocated capacity " + this.cap);
        }
        this.ensureRows(startPos + rows);
        int32 step = rows;
        if (this.rows[(int64) li] < KvPage.blocksFor(this.cap) * KvPage.BLOCK && step > DeviceKv.ringSlack) {
            step = DeviceKv.ringSlack;
        }
        if (step >= rows) {
            this.attendPiece(li, q, k, v, inv, pos, rows, startPos, scale, out);
            return;
        }
        int64 qw = (int64) (this.nH * this.hd);
        int64 kw = (int64) this.kvDim;
        int32 done = 0;
        while (done < rows) {
            int32 n = rows - done;
            if (n > step) { n = step; }
            KernelBuffer<float32> qs #= q.slice((uint64) ((int64) done * qw), (uint64) ((int64) n * qw));
            KernelBuffer<float32> ks #= k.slice((uint64) ((int64) done * kw), (uint64) ((int64) n * kw));
            KernelBuffer<float32> vs #= v.slice((uint64) ((int64) done * kw), (uint64) ((int64) n * kw));
            KernelBuffer<float32> os #= out.slice((uint64) ((int64) done * qw), (uint64) ((int64) n * qw));
            if (pos != null) {
                KernelBuffer<int32> ps #= pos.slice((uint64) done, (uint64) n);
                this.attendPiece(li, qs, ks, vs, inv, ps, n, startPos + done, scale, os);
            } else {
                this.attendPiece(li, qs, ks, vs, inv, null, n, startPos + done, scale, os);
            }
            done = done + n;
        }
        return;
    }

    void ensurePrefill(int32 rows) {
        if (this.preRows >= rows) { return; }
        Diag.growth();
        int64 kvn = (int64) rows * (int64) this.kvDim;
        int64 qn = (int64) rows * (int64) (this.nH * this.hd);
        this.preK #= heap KernelBuffer<float32>((uint64) kvn);
        this.preV #= heap KernelBuffer<float32>((uint64) kvn);
        this.preQ #= heap KernelBuffer<float32>((uint64) qn);
        this.preOut #= heap KernelBuffer<float32>((uint64) qn);
        this.preOutH #= heap float32[qn];
        this.preQH #= heap float32[qn];
        this.preKH #= heap float32[kvn];
        this.preVH #= heap float32[kvn];
        // The online flash tile never reads scores; the two-pass tile and
        // the wave fallback do. One float where it is not read: rows x heads
        // x context floats was 268 MB a slot on an 8B at ctx 4096
        // (15.2.15.4).
        int64 scores = 1L;
        if (!AttnKernel.prefillOnlineServes(this.nH, this.nKv, this.hd)) {
            scores = (int64) rows * (int64) this.nH * (int64) this.cap;
        }
        this.preScores #= heap KernelBuffer<float32>((uint64) scores);
        this.preScoresN = scores;
        this.preRows = rows;
        return;
    }

    /**
     * The RESIDENT prefill attention (10.12.7.c): `q`, `k` and `v` are
     * DEVICE buffers the batched projections left in their `yBatch`,
     * already roped — no gathers, no uploads, no output download. The
     * return is a VIEW of `preOut` (interior state, plain return),
     * valid until the next prefill call; the caller packs the o
     * projection's input straight from it. NOSYNC (10.12.30): nothing
     * here is read by the host — the o pack consumes `preOut` on the
     * device, and the cache-authority k/v download is DEFERRED to one
     * post-loop pass reading the persistent planes — so the layer
     * loop never round-trips. A caller that must read k/v right after
     * (mid-sequence prefill) syncs on its own.
     */
    public KernelBuffer<float32> prefillAttendResident(int32 li,
            KernelBuffer<float32> q, KernelBuffer<float32> k,
            KernelBuffer<float32> v, int32 rows, int32 startPos,
            float32 scale) {
        this.ensurePrefill(rows);
        this.placeAndAttend(li, q, k, v, null, null, rows, startPos, scale, this.preOut);
        return this.preOut;
    }

    /** {@link #prefillAttendResident} with the RoPE of q and k folded
     *  into the append (1.8.3): `q` and `k` arrive unrotated, one
     *  ropeAppendRowsKernel launch rotates both and fills the planes,
     *  then the attend. */
    public KernelBuffer<float32> prefillAttendRopedResident(int32 li,
            KernelBuffer<float32> q, KernelBuffer<float32> k,
            KernelBuffer<float32> v, KernelBuffer<float32> invFreq,
            KernelBuffer<int32> pos, int32 rows, int32 startPos,
            float32 scale) {
        this.ensurePrefill(rows);
        this.placeAndAttend(li, q, k, v, invFreq, pos, rows, startPos, scale, this.preOut);
        return this.preOut;
    }

    /** {@link #prefillAttendResident} writing `rows` x nH*hd into `out`: a
     *  pass whose attention output several sequences share (15.2.15.1.4). */
    public void prefillAttendResidentInto(int32 li, KernelBuffer<float32> q,
            KernelBuffer<float32> k, KernelBuffer<float32> v, int32 rows,
            int32 startPos, float32 scale, KernelBuffer<float32> out) {
        this.ensurePrefill(rows);
        this.placeAndAttend(li, q, k, v, null, null, rows, startPos, scale, out);
        return;
    }

    /** {@link #prefillAttendRopedResident} writing into `out`. */
    public void prefillAttendRopedResidentInto(int32 li, KernelBuffer<float32> q,
            KernelBuffer<float32> k, KernelBuffer<float32> v,
            KernelBuffer<float32> invFreq, KernelBuffer<int32> pos, int32 rows,
            int32 startPos, float32 scale, KernelBuffer<float32> out) {
        this.ensurePrefill(rows);
        this.placeAndAttend(li, q, k, v, invFreq, pos, rows, startPos, scale, out);
        return;
    }

    /** The layer's persistent K plane — a view, half. */
    public KernelBuffer<float16> kPlane(int32 li) {
        return this.kOf(li);
    }

    /** The layer's persistent V plane — a view, half. */
    public KernelBuffer<float16> vPlane(int32 li) {
        return this.vOf(li);
    }

    /** Positions `from .. from + n` of layer `li` into {@link #stageK} and {@link #stageV} in position order,
     *  widened to f32, a block at a time. The caller has synced the stream. */
    void downloadRows(int32 li, int32 from, int32 n) {
        this.ensureHostStage();
        int64 kvd = (int64) this.kvDim;
        int32 p = from;
        while (p < from + n) {
            int32 c = KvPage.BLOCK - p % KvPage.BLOCK;
            if (c > from + n - p) { c = from + n - p; }
            uint64 at = (uint64) ((int64) this.rowOf(li, p) * kvd);
            uint64 cnt = (uint64) ((int64) c * kvd);
            int64 off = (int64) (p - from) * kvd;
            KernelBuffer<float16> kb #= this.kOf(li).slice(at, cnt);
            KernelBuffer<float16> vb #= this.vOf(li).slice(at, cnt);
            kb.downloadTo(this.stageK16, off, (int64) cnt);
            vb.downloadTo(this.stageV16, off, (int64) cnt);
            p = p + c;
        }
        int64 total = (int64) n * kvd;
        AttnKernel.widenHalf(this.stageK16, this.stageK, total);
        AttnKernel.widenHalf(this.stageV16, this.stageV, total);
        return;
    }

    /** Narrow {@link #stageK} and {@link #stageV}, positions `from .. from + n` in order, into layer `li`'s planes a
     *  block at a time. */
    void uploadRows(int32 li, int32 from, int32 n) {
        int64 kvd = (int64) this.kvDim;
        int64 total = (int64) n * kvd;
        int64 i = 0L;
        while (i < total) {
            this.stageK16[i] = (float16) this.stageK[i];
            this.stageV16[i] = (float16) this.stageV[i];
            i = i + 1L;
        }
        int32 p = from;
        while (p < from + n) {
            int32 c = KvPage.BLOCK - p % KvPage.BLOCK;
            if (c > from + n - p) { c = from + n - p; }
            uint64 at = (uint64) ((int64) this.rowOf(li, p) * kvd);
            uint64 cnt = (uint64) ((int64) c * kvd);
            int64 off = (int64) (p - from) * kvd;
            KernelBuffer<float16> kb #= this.kOf(li).slice(at, cnt);
            KernelBuffer<float16> vb #= this.vOf(li).slice(at, cnt);
            kb.uploadFrom(this.stageK16, off, (int64) cnt);
            vb.uploadFrom(this.stageV16, off, (int64) cnt);
            p = p + c;
        }
        return;
    }

    /** Positions `0 .. n / kvDim` of layer `li`, widened into `k` and `v` in position order. The caller has synced. */
    public void readPlanes(int32 li, float32[] k, float32[] v, int64 n) {
        this.downloadRows(li, 0, (int32) (n / (int64) this.kvDim));
        int64 i = 0L;
        while (i < n) {
            k[i] = this.stageK[i];
            v[i] = this.stageV[i];
            i = i + 1L;
        }
        return;
    }

    /** Layer `li`'s V row at position `p`, widened into `out` (the NaN sniffer's read). The caller has synced. */
    public void readVRow(int32 li, int32 p, float32[] out) {
        this.downloadRows(li, p, 1);
        int64 i = 0L;
        while (i < (int64) this.kvDim) {
            out[i] = this.stageV[i];
            i = i + 1L;
        }
        return;
    }

    /**
     * The whole prefill attention for one layer: place `rows` K/V rows
     * into the planes, then attend for all `rows` query rows at once.
     *
     * `q`, `k` and `v` are the host `[rows x ...]` tensors the batched
     * projections just filled, and `ao` receives the result. Everything
     * between is one upload, three launches and one download — where the
     * host floor is O(n^2) scalar work and measured 16.5 s of a 23.6 s
     * prefill at 512 tokens.
     */
    public void prefillAttend(int32 li, Tensor<float32> q, Tensor<float32> k,
            Tensor<float32> v, Tensor<float32> ao, int32 rows,
            int32 startPos, float32 scale) {
        this.ensurePrefill(rows);
        int64 kvn = (int64) rows * (int64) this.kvDim;
        int64 qn = (int64) rows * (int64) (this.nH * this.hd);
        // THROUGH A STAGING COPY, because `upload(host, count)` starts at
        // index 0 of the ARRAY and these tensors are arena slices with a
        // nonzero `hostBase`. Uploading `q.hostBuffer()` directly sends
        // whatever the arena put at the front — a plausible, wrong
        // answer: it decoded 13 1129 1129 1129 instead of 198 14196.
        DeviceKv.gather(k, kvn, this.preKH);
        DeviceKv.gather(v, kvn, this.preVH);
        DeviceKv.gather(q, qn, this.preQH);
        this.preK.upload(this.preKH, kvn);
        this.preV.upload(this.preVH, kvn);
        this.preQ.upload(this.preQH, qn);
        this.placeAndAttend(li, this.preQ, this.preK, this.preV, null, null, rows, startPos, scale, this.preOut);
        KernelStream s = QuantKernel.stream();
        s.sync();
        this.preOut.download(this.preOutH, qn);
        float32[] ob = ao.hostBuffer();
        int64 obase = ao.hostBase();
        int64 i = 0;
        while (i < qn) {
            ob[obase + i] = this.preOutH[i];
            i = i + 1;
        }
        return;
    }

    /** The planes already hold `len` positions for `seq`, written
     *  directly rather than seeded — what a batched prefill leaves
     *  behind. Both copies agree, so nothing is owed. */
    public void adopt(int32 seq, int32 len) {
        this.seq = seq;
        this.len = len;
        this.hostLen = len;
        return;
    }

    /**
     * Adopt with the host cache BEHIND (10.12.38 lazy authority): the
     * planes hold `[0, len)` but the paged cache only `[0, hostLen)`.
     * `owns()` is then true, and every host-path consumer already calls
     * {@link #writeback} (via `syncKvToHost`) before reading K/V bytes,
     * so the catch-up is paid ON DEMAND instead of on the prefill clock.
     * The profiler measured the eager pass at ~36 ms — 4 ms of plane
     * downloads and ~32 ms of per-row host appends — none of which the
     * resident decode path ever reads.
     */
    public void adoptLazy(int32 seq, int32 len, int32 hostLen) {
        this.seq = seq;
        this.len = len;
        this.hostLen = hostLen;
        return;
    }

    /**
     * Record that position `p` was appended on the device for every
     * layer.
     *
     * The host cache is deliberately left BEHIND rather than advanced:
     * its length and its bytes stay consistent with each other, and
     * {@link #writeback} catches it up in one pass. Advancing the length
     * without the bytes was the first shape and it is strictly worse —
     * any reader that trusted the length would get zeros, and there is no
     * way to make that fail loudly.
     *
     * What it defers is the pool draw. Blocks for these positions are
     * taken at writeback, not now, so a pool that fills in the meantime
     * turns a silent overwrite into a loud failure there.
     */
    public void notePosition(int32 p) {
        this.len = p + 1;
        return;
    }

    /** Positions held, device planes included. */
    public int32 length() { return this.len; }
}
