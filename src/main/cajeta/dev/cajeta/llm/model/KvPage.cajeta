package dev.cajeta.llm.model;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;

/** Block-table addressing of the device K/V planes (cajeta-llm 15.2.21.8.1): 64 positions a block. */
public final class KvPage {
    public static final int32 BLOCK = 64;
    static KernelBuffer<int32> ident;
    static int64 identN = 0L;

    public KvPage() { return; }

    /** Plane row holding position `t`: block `tab[base + t / 64]`, row `t % 64` within it. */
    @Device
    public static uint32 row(KernelBuffer<int32> tab, uint32 base, uint32 t) {
        return ((uint32) tab[(int64) (base + (t >> 6))] << 6) + (t & 63);
    }

    /** Blocks that hold `rows` positions. */
    public static int32 blocksFor(int32 rows) {
        return (rows + KvPage.BLOCK - 1) / KvPage.BLOCK;
    }

    /** A device table mapping block b to b for at least `rows` positions: flat planes, a BORROW. */
    public static KernelBuffer<int32> identity(int32 rows) {
        int64 n = (int64) KvPage.blocksFor(rows);
        if (n < 1L) { n = 1L; }
        if (KvPage.ident == null || KvPage.identN < n) {
            int64 m = n;
            if (m < 16384L) { m = 16384L; }
            if (KvPage.ident != null) {
                KernelStream s = QuantKernel.stream();
                s.sync();
            }
            int32[] h #= heap int32[m];
            int64 i = 0L;
            while (i < m) {
                h[i] = (int32) i;
                i = i + 1L;
            }
            KvPage.ident #= heap KernelBuffer<int32>((uint64) m);
            KvPage.ident.upload(h, m);
            KvPage.identN = m;
        }
        return KvPage.ident;
    }

    static boolean scrambled = false;

    /** Whether the host-array attends lay their planes out with the blocks reversed behind a spare (test knob). */
    public static void setScrambled(boolean on) { KvPage.scrambled = on; }

    public static boolean scrambledOn() { return KvPage.scrambled; }

    /** Table base the host-array attends pass: 3 when scrambled, else 0. */
    public static int32 testBase() {
        if (KvPage.scrambled) { return 3; }
        return 0;
    }

    /** Physical block of logical block `b` of `nb` in a test layout. */
    static int32 physOf(int32 b, int32 nb) {
        if (KvPage.scrambled) { return nb - b; }
        return b;
    }

    /** The table for a test layout of `nb` blocks, {@link #testBase} entries of junk first. */
    public static #KernelBuffer<int32> testTable(int32 nb) {
        int32 base = KvPage.testBase();
        int64 n = (int64) (base + nb);
        int32[] h #= heap int32[n];
        int32 i = 0;
        while (i < base) {
            h[(int64) i] = 999 - i;
            i = i + 1;
        }
        int32 b = 0;
        while (b < nb) {
            h[(int64) (base + b)] = KvPage.physOf(b, nb);
            b = b + 1;
        }
        KernelBuffer<int32> t #= heap KernelBuffer<int32>((uint64) n);
        t.upload(h, n);
        return #t;
    }

    /** Device planes holding `rows` rows of `flat`, `kvDim` wide, at the blocks a test layout of their count gives;
     *  a spare block reads as 1000 everywhere. */
    public static #KernelBuffer<float16> testPlane(float16[] flat, int32 rows, int64 kvDim) {
        int32 nb = KvPage.blocksFor(rows);
        int64 blk = (int64) KvPage.BLOCK * kvDim;
        int64 total = (int64) (nb + 1) * blk;
        float16[] h #= heap float16[total];
        int64 i = 0L;
        while (i < total) {
            h[i] = (float16) 1000.0f;
            i = i + 1L;
        }
        int64 r = 0L;
        while (r < (int64) rows) {
            int64 dst = (int64) KvPage.physOf((int32) (r / 64L), nb) * blk + (r % 64L) * kvDim;
            int64 j = 0L;
            while (j < kvDim) {
                h[dst + j] = flat[r * kvDim + j];
                j = j + 1L;
            }
            r = r + 1L;
        }
        KernelBuffer<float16> p #= heap KernelBuffer<float16>((uint64) total);
        p.upload(h, total);
        return #p;
    }
}
