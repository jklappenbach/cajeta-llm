package dev.cajeta.llm.model;

import cajeta.xpu.KernelBuffer;

/**
 * The segments of a multi-request prefill pass (cajeta-llm 15.2.15.1.4): one
 * sequence each, its rows contiguous in the pass. One holder so CausalLM gains
 * one reference field, not six: its hidden ownership word holds 64 bits and the
 * class carries 61 (see the field's comment in CausalLM).
 */
final class PrefillSegments {
    int32 n;
    int32[] seq;
    int32[] rows;
    int32[] start;
    int32[] out;
    /** The pass's attention output, every segment's rows at its offset. */
    KernelBuffer<float32> ao;
    int64 aoCap;

    PrefillSegments() { return; }
}
