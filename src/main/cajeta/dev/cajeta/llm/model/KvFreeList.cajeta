package dev.cajeta.llm.model;

/** A kind's free block ids, a stack: the id released last is drawn first (cajeta-llm 15.2.21.8.1.3). */
public final class KvFreeList {
    int32[] ids;
    int32 n;

    public KvFreeList() {
        this.ids #= heap int32[16L];
        this.n = 0;
    }

    /** Free ids held. */
    public int32 count() { return this.n; }

    /** Return `id` to the list. */
    public void push(int32 id) {
        if ((int64) this.n == this.ids.count()) {
            int32[] w #= heap int32[2L * this.ids.count()];
            int32 i = 0;
            while (i < this.n) { w[(int64) i] = this.ids[(int64) i]; i = i + 1; }
            this.ids #= w;
        }
        this.ids[(int64) this.n] = id;
        this.n = this.n + 1;
        return;
    }

    /** Take an id; -1 when none is free. */
    public int32 pop() {
        if (this.n == 0) { return 0 - 1; }
        this.n = this.n - 1;
        return this.ids[(int64) this.n];
    }

    /** Push ids `hi - 1` down to `lo`, so the next draws take `lo` first. */
    public void pushRange(int32 lo, int32 hi) {
        int32 id = hi - 1;
        while (id >= lo) {
            this.push(id);
            id = id - 1;
        }
        return;
    }
}
