package dev.cajeta.llm.model;

import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.Diag;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import dev.cajeta.llm.io.QuantKernel;

/**
 * The decode slots' K/V planes, one K and one V buffer per layer, and the block table every slot reads them
 * through (cajeta-llm 15.2.12.3.2.1, 15.2.21.8.1). A kernel handed the whole buffer and the table reaches every
 * slot, so the batch's attention is one launch. Slot s holds blocks `s * blocksPerSlot` on.
 */
@Unfused
public final class KvPool {
    KernelBuffer<float16>[] k;
    KernelBuffer<float16>[] v;
    int32 layers;
    int64 plane;
    int32 nSlots;
    int32 nGrowths;
    int32 bps;
    KernelBuffer<int32> tab;

    /** A pool of `layers` K and V buffers holding `cap` positions of `kvDim` a slot; holds no slot until
     *  {@link #ensureSlots}. */
    public KvPool(int32 layers, int32 cap, int32 kvDim) {
        this.layers = layers;
        this.bps = KvPage.blocksFor(cap);
        this.plane = (int64) this.bps * (int64) KvPage.BLOCK * (int64) kvDim;
        this.nSlots = 0;
        this.nGrowths = 0;
        this.k #= heap KernelBuffer<float16>[(int64) layers];
        this.v #= heap KernelBuffer<float16>[(int64) layers];
    }

    /** How many times the buffers were reallocated. */
    public int32 growths() { return this.nGrowths; }

    /** Slots the buffers hold. */
    public int32 slots() { return this.nSlots; }

    /** Halves a slot's plane takes. */
    public int64 planeElements() { return this.plane; }

    /** Blocks a slot holds, its table's length. */
    public int32 blocksPerSlot() { return this.bps; }

    /** The physical block of slot `slot`'s logical block `b`. */
    public int32 blockOf(int32 slot, int32 b) { return slot * this.bps + b; }

    /** Slot `slot`'s first entry in {@link #table}. */
    public int32 tableBase(int32 slot) { return slot * this.bps; }

    /** The block table of every slot: a BORROW, replaced by a growth. */
    public KernelBuffer<int32> table() { return this.tab; }

    /** Whether `n` slots fit one buffer under 2 GiB. */
    public boolean fits(int32 n) {
        return (int64) n * this.plane * 2L < (1L << 31);
    }

    /** Layer `li`'s K buffer, every slot: a BORROW, replaced by a growth. */
    public KernelBuffer<float16> kAll(int32 li) { return this.k[(int64) li]; }

    /** Layer `li`'s V buffer, every slot: a BORROW, replaced by a growth. */
    public KernelBuffer<float16> vAll(int32 li) { return this.v[(int64) li]; }

    /** Slot `slot`'s blocks in layer `li`'s K buffer, a view that a growth invalidates. */
    public #KernelBuffer<float16> kSlice(int32 li, int32 slot) {
        KernelBuffer<float16> s #= this.k[(int64) li].slice((uint64) ((int64) slot * this.plane), (uint64) this.plane);
        return #s;
    }

    /** Slot `slot`'s blocks in layer `li`'s V buffer, a view that a growth invalidates. */
    public #KernelBuffer<float16> vSlice(int32 li, int32 slot) {
        KernelBuffer<float16> s #= this.v[(int64) li].slice((uint64) ((int64) slot * this.plane), (uint64) this.plane);
        return #s;
    }

    /** A pool of this one's shape holding no slot. */
    public #KvPool emptyLike() {
        KvPool p #= heap KvPool(this.layers, this.bps * KvPage.BLOCK, (int32) (this.plane / ((int64) this.bps * 64L)));
        return #p;
    }

    /** Grow to at least `n` slots, copying the slots already held; every earlier slice is stale afterwards. */
    public void ensureSlots(int32 n) {
        if (n <= this.nSlots) { return; }
        Diag.growth();
        uint64 count = (uint64) ((int64) n * this.plane);
        int64 keep = (int64) this.nSlots * this.plane;
        int32 l = 0;
        while (l < this.layers) {
            KernelBuffer<float16> nk #= heap KernelBuffer<float16>(count);
            KernelBuffer<float16> nv #= heap KernelBuffer<float16>(count);
            if (keep > 0L) {
                KvPool.copyLaunchNoSync(nk, this.k[(int64) l], keep);
                KvPool.copyLaunchNoSync(nv, this.v[(int64) l], keep);
                KernelStream s = QuantKernel.stream();
                s.sync();
            }
            this.k[(int64) l] #= nk;
            this.v[(int64) l] #= nv;
            l = l + 1;
        }
        int64 te = (int64) n * (int64) this.bps;
        int32[] th #= heap int32[te];
        int64 i = 0L;
        while (i < te) {
            th[i] = (int32) i;
            i = i + 1L;
        }
        if (this.tab != null) {
            KernelStream s = QuantKernel.stream();
            s.sync();
        }
        this.tab #= heap KernelBuffer<int32>((uint64) te);
        this.tab.upload(th, te);
        this.nSlots = n;
        this.nGrowths = this.nGrowths + 1;
        return;
    }

    /** `dst[i] = src[i]` for i < n, grid-stride over `stride` threads. */
    @Kernel
    public static void copyF16Kernel(KernelBuffer<float16> dst, KernelBuffer<float16> src,
            uint32 n, uint32 stride) {
        uint32 i = KernelThread.globalIdX();
        while (i < n) {
            dst[(int64) i] = src[(int64) i];
            i = i + stride;
        }
    }

    static void copyLaunchNoSync(KernelBuffer<float16> dst, KernelBuffer<float16> src, int64 n) {
        int64 groups = (n + 255L) / 256L;
        if (groups > 4096L) { groups = 4096L; }
        KernelStream s = QuantKernel.stream();
        copyF16Kernel.launch(s, grid: [(uint32) groups], block: [256])
            (dst, src, (uint32) n, (uint32) (groups * 256L));
        return;
    }
}
