package dev.cajeta.llm.model;

import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.LlmException;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import dev.cajeta.llm.io.QuantKernel;

/**
 * The decode slots' K/V planes, one K and one V buffer per layer, and the block table every slot reads them
 * through (cajeta-llm 15.2.12.3.2.1, 15.2.21.8.1). A kernel handed the whole buffer and the table reaches every
 * slot, so the batch's attention is one launch. A kind is a distinct effective window; each (slot, kind) has a
 * table region of {@link #logicalBlocks} entries, filled as the slot's rows are ensured from the kind's free list;
 * a ring kind's entry b at or past its R blocks repeats entry b % R.
 */
@Unfused
public final class KvPool {
    KernelBuffer<float16>[] k;
    KernelBuffer<float16>[] v;
    int32 layers;
    int32 cap;
    int32 kvDim;
    int32 nLog;
    int32 nKinds;
    int32[] kindOfL;
    int32[] kWin;
    int32[] kBlocks;
    int32 nSlots;
    int32 nGrowths;
    KernelBuffer<int32> tab;
    int32[] th;
    int32[] logical;
    boolean[] gone;
    int32[] kCap;
    int32[] kHi;
    int64 nCopied;
    KvFreeList[] free;
    boolean dirty;
    int32 nBlockGrowths;
    static int64 budget = 0L;

    /** The most device bytes every pool's K and V may hold together; 0 sets no limit but free memory. */
    public static void setBudgetBytes(int64 n) { KvPool.budget = n; }

    /** Device bytes this pool's K and V buffers hold. */
    public int64 deviceBytes() {
        int64 n = 0L;
        int32 l = 0;
        while (l < this.layers) {
            n = n + (int64) this.kCap[(int64) this.kindOf(l)] * (int64) KvPage.BLOCK * (int64) this.kvDim * 4L;
            l = l + 1;
        }
        return n;
    }

    /** How many times a kind's buffers grew for blocks. */
    public int32 blockGrowths() { return this.nBlockGrowths; }

    /** Blocks kind `kd`'s buffers hold. */
    public int32 capacity(int32 kd) { return this.kCap[(int64) kd]; }

    /** Grow each kind so `n` sequences of `lens[i]` positions draw without growing: their blocks at most, exactly. */
    public void reserve(int32[] lens, int32 n) {
        int32 kd = 0;
        while (kd < this.nKinds) {
            int32 r = this.kBlocks[(int64) kd];
            int32 need = 0;
            int32 i = 0;
            while (i < n) {
                int32 len = lens[(int64) i];
                if (len > this.cap) { len = this.cap; }
                int32 nb = KvPage.blocksFor(len);
                if (nb > r) { nb = r; }
                need = need + nb;
                i = i + 1;
            }
            int32 most = this.kCap[(int64) kd] + this.growRoom(kd);
            if (need > most) { need = most; }
            if (need > this.kCap[(int64) kd]) { this.grow(kd, need - this.kCap[(int64) kd], true); }
            kd = kd + 1;
        }
        return;
    }

    /** Grow kind `kd`'s buffers by at least `need` blocks (exactly when `exact`, else doubling, up to what the slots
     *  can use), copying the blocks below the highest drawn, a sync per 256 MB of them; refused by name past the
     *  budget or free memory. */
    void grow(int32 kd, int32 need, boolean exact) {
        int32 had = this.kCap[(int64) kd];
        int32 want = had + need;
        if (!exact && had * 2 > want) { want = had * 2; }
        int32 most = this.nSlots * this.kBlocks[(int64) kd];
        if (want > most) { want = most; }
        int32 roomy = had + this.growRoom(kd);
        if (want > roomy && roomy >= had + need) { want = roomy; }
        if (want < had + need) {
            throw heap LlmException("kv pool: kind " + kd + " needs " + need + " blocks past its " + most);
        }
        int32 nl = 0;
        int32 l = 0;
        while (l < this.layers) {
            if (this.kindOf(l) == kd) { nl = nl + 1; }
            l = l + 1;
        }
        int64 add = (int64) (want - had) * (int64) KvPage.BLOCK * (int64) this.kvDim * 4L * (int64) nl;
        int64 held = this.deviceBytes();
        if (KvPool.budget > 0L && held + add > KvPool.budget) {
            throw heap LlmException("kv pool: growing kind " + kd + " (window " + this.kWin[(int64) kd] + ") to "
                + want + " blocks adds " + add + " bytes to " + held + ", past the budget of " + KvPool.budget);
        }
        int64 freeB = Device.freeMemoryBytes();
        if (freeB > 0L && add > freeB) {
            throw heap LlmException("kv pool: growing kind " + kd + " to " + want + " blocks adds " + add
                + " bytes; the device has " + freeB + " free");
        }
        Diag.growth();
        int64 blockHalves = (int64) KvPage.BLOCK * (int64) this.kvDim;
        int32 live = this.kHi[(int64) kd];
        this.nCopied = this.nCopied + (int64) live;
        int64 oldBytes = (int64) live * blockHalves * 4L;
        int64 batch = 1L;
        if (oldBytes > 0L) { batch = (268435456L + oldBytes - 1L) / oldBytes; }
        KernelBuffer<float16>[] old #= heap KernelBuffer<float16>[2L * batch];
        int64 nOld = 0L;
        KernelStream s = QuantKernel.stream();
        l = 0;
        while (l < this.layers) {
            if (this.kindOf(l) == kd) {
                KernelBuffer<float16> nk #= heap KernelBuffer<float16>((uint64) ((int64) want * blockHalves));
                KernelBuffer<float16> nv #= heap KernelBuffer<float16>((uint64) ((int64) want * blockHalves));
                if (live > 0) {
                    KvPool.copyLaunchNoSync(nk, this.k[(int64) l], (int64) live * blockHalves);
                    KvPool.copyLaunchNoSync(nv, this.v[(int64) l], (int64) live * blockHalves);
                }
                old[2L * nOld] #= this.k[(int64) l];
                old[2L * nOld + 1L] #= this.v[(int64) l];
                this.k[(int64) l] #= nk;
                this.v[(int64) l] #= nv;
                nOld = nOld + 1L;
                if (nOld == batch) {
                    s.sync();
                    old #= heap KernelBuffer<float16>[2L * batch];
                    nOld = 0L;
                }
            }
            l = l + 1;
        }
        s.sync();
        this.free[(int64) kd].pushRangeUnder(had, want);
        this.kCap[(int64) kd] = want;
        this.nBlockGrowths = this.nBlockGrowths + 1;
        return;
    }

    /** A pool of `layers` flat K and V buffers holding `cap` positions of `kvDim` a slot; holds no slot until
     *  {@link #ensureSlots}. */
    public KvPool(int32 layers, int32 cap, int32 kvDim) {
        int32[] w #= heap int32[(int64) layers];
        this.init(cap, kvDim, w);
    }

    /** A pool whose layer l attends a window of `windows[l]` (0 for none), at the ring sizes of
     *  {@link DeviceKv#ringRows}; `windows` is copied. */
    public KvPool(int32 cap, int32 kvDim, int32[] windows) {
        this.init(cap, kvDim, windows);
    }

    void init(int32 cap, int32 kvDim, int32[] windows) {
        this.layers = (int32) windows.count();
        this.cap = cap;
        this.kvDim = kvDim;
        this.nLog = KvPage.blocksFor(cap);
        this.nSlots = 0;
        this.nGrowths = 0;
        this.kindOfL #= heap int32[(int64) this.layers];
        this.kWin #= heap int32[(int64) this.layers];
        this.kBlocks #= heap int32[(int64) this.layers];
        this.nKinds = 0;
        int32 l = 0;
        while (l < this.layers) {
            int32 w = windows[(int64) l];
            if (w < 0 || w >= cap) { w = 0; }
            int32 kd = 0;
            while (kd < this.nKinds && this.kWin[(int64) kd] != w) { kd = kd + 1; }
            if (kd == this.nKinds) {
                this.kWin[(int64) kd] = w;
                this.kBlocks[(int64) kd] = DeviceKv.ringRows(w, cap) / KvPage.BLOCK;
                this.nKinds = this.nKinds + 1;
            }
            this.kindOfL[(int64) l] = kd;
            l = l + 1;
        }
        this.k #= heap KernelBuffer<float16>[(int64) this.layers];
        this.v #= heap KernelBuffer<float16>[(int64) this.layers];
        this.th #= heap int32[0L];
        this.logical #= heap int32[0L];
        this.gone #= heap boolean[0L];
        this.kCap #= heap int32[(int64) this.nKinds];
        this.kHi #= heap int32[(int64) this.nKinds];
        this.free #= heap KvFreeList[(int64) this.nKinds];
        int32 kd = 0;
        while (kd < this.nKinds) {
            this.free[(int64) kd] #= heap KvFreeList();
            kd = kd + 1;
        }
        this.dirty = false;
        return;
    }

    /** Blocks kind `kd` can still grow by: what its slots can use, within the budget and the device's free memory. */
    public int32 growRoom(int32 kd) {
        int32 room = this.nSlots * this.kBlocks[(int64) kd] - this.kCap[(int64) kd];
        int32 nl = 0;
        int32 l = 0;
        while (l < this.layers) {
            if (this.kindOf(l) == kd) { nl = nl + 1; }
            l = l + 1;
        }
        int64 per = (int64) KvPage.BLOCK * (int64) this.kvDim * 4L * (int64) nl;
        if (per <= 0L) { return room; }
        if (KvPool.budget > 0L) {
            int64 b = (KvPool.budget - this.deviceBytes()) / per;
            if (b < 0L) { b = 0L; }
            if (b < (int64) room) { room = (int32) b; }
        }
        int64 freeB = Device.freeMemoryBytes();
        if (freeB > 0L && freeB / per < (int64) room) { room = (int32) (freeB / per); }
        if (room < 0) { room = 0; }
        return room;
    }

    /** {@link #ensureRows}, or false with nothing drawn when some kind lacks the blocks even after growing within
     *  {@link #growRoom} (kv-paging 1). */
    public boolean tryEnsureRows(int32 slot, int32 upTo) {
        this.refuseEvicted(slot);
        int32 nb = KvPage.blocksFor(upTo);
        if (nb > this.nLog) {
            throw heap LlmException("kv pool: " + upTo + " positions exceed the capacity " + this.cap);
        }
        int32 kd = 0;
        while (kd < this.nKinds) {
            if (this.deficit(slot, kd, nb) > this.growRoom(kd)) { return false; }
            kd = kd + 1;
        }
        kd = 0;
        while (kd < this.nKinds) {
            int32 d = this.deficit(slot, kd, nb);
            if (d > 0) { this.grow(kd, d, false); }
            kd = kd + 1;
        }
        this.ensureRows(slot, upTo);
        return true;
    }

    /** Blocks kind `kd` lacks for `slot` to hold `nb` logical blocks, past its free list. */
    int32 deficit(int32 slot, int32 kd, int32 nb) {
        int32 r = this.kBlocks[(int64) kd];
        int32 have = this.logical[(int64) (slot * this.nKinds + kd)];
        int32 want = nb;
        if (want > r) { want = r; }
        if (have > r) { have = r; }
        int32 d = want - have - this.free[(int64) kd].count();
        if (d < 0) { d = 0; }
        return d;
    }

    /** Blocks the growths have copied, per kind: each growth copies those below the highest drawn. */
    public int64 copiedBlocks() { return this.nCopied; }

    /** How many times the buffers were reallocated. */
    public int32 growths() { return this.nGrowths; }

    /** Slots the buffers hold. */
    public int32 slots() { return this.nSlots; }

    /** Distinct effective windows over the layers. */
    public int32 kinds() { return this.nKinds; }

    /** Layer `li`'s kind. */
    public int32 kindOf(int32 li) { return this.kindOfL[(int64) li]; }

    /** Kind `kd`'s window, 0 when it attends every position. */
    public int32 windowOf(int32 kd) { return this.kWin[(int64) kd]; }

    /** Plane rows a slot holds for kind `kd`. */
    public int32 rowsOf(int32 kd) { return this.kBlocks[(int64) kd] * KvPage.BLOCK; }

    /** Entries of a (slot, kind) table region: the logical blocks of `cap` positions. */
    public int32 logicalBlocks() { return this.nLog; }

    /** Halves a slot's plane takes in layer `li`. */
    public int64 planeElements(int32 li) {
        return (int64) this.rowsOf(this.kindOf(li)) * (int64) this.kvDim;
    }

    /** Table entry `i`, as the host holds it: a block id, or stale where its slot has not ensured that block. */
    public int32 entry(int32 i) { return this.th[(int64) i]; }

    /** Logical blocks slot `slot` holds in kind `kd`. */
    public int32 drawn(int32 slot, int32 kd) { return this.logical[(int64) (slot * this.nKinds + kd)]; }

    /** Free blocks of kind `kd`. */
    public int32 freeBlocks(int32 kd) { return this.free[(int64) kd].count(); }

    /** Give slot `slot` the blocks its positions `[0, upTo)` fall in, from each kind's free list; a ring kind draws
     *  at most its R and repeats them. The table is uploaded at the next {@link #flush}. */
    public void ensureRows(int32 slot, int32 upTo) {
        this.refuseEvicted(slot);
        int32 nb = KvPage.blocksFor(upTo);
        if (nb > this.nLog) {
            throw heap LlmException("kv pool: " + upTo + " positions exceed the capacity " + this.cap);
        }
        int32 kd = 0;
        while (kd < this.nKinds) {
            int32 at = slot * this.nKinds + kd;
            int32 have = this.logical[(int64) at];
            if (nb > have) {
                int32 r = this.kBlocks[(int64) kd];
                int32 base = this.tableBase(slot, kd);
                int32 b = have;
                while (b < nb) {
                    if (b < r) {
                        int32 id = this.free[(int64) kd].pop();
                        if (id < 0) {
                            int32 upto = nb;
                            if (upto > r) { upto = r; }
                            this.grow(kd, upto - b, false);
                            id = this.free[(int64) kd].pop();
                        }
                        this.th[(int64) (base + b)] = id;
                        if (id >= this.kHi[(int64) kd]) { this.kHi[(int64) kd] = id + 1; }
                    } else {
                        this.th[(int64) (base + b)] = this.th[(int64) (base + b % r)];
                    }
                    b = b + 1;
                }
                this.logical[(int64) at] = nb;
                this.dirty = true;
            }
            kd = kd + 1;
        }
        return;
    }

    /** Return slot `slot`'s blocks to the free lists; its table region stays, stale, until it ensures rows again. */
    public void release(int32 slot) {
        if (slot < 0 || slot >= this.nSlots) { return; }
        int32 kd = 0;
        while (kd < this.nKinds) {
            int32 at = slot * this.nKinds + kd;
            int32 n = this.logical[(int64) at];
            int32 r = this.kBlocks[(int64) kd];
            if (n > r) { n = r; }
            int32 base = this.tableBase(slot, kd);
            int32 b = n - 1;
            while (b >= 0) {
                this.free[(int64) kd].push(this.th[(int64) (base + b)]);
                b = b - 1;
            }
            this.logical[(int64) at] = 0;
            kd = kd + 1;
        }
        this.gone[(int64) slot] = false;
        return;
    }

    /** Throws, naming the slot, when slot `slot` was evicted and not yet released: its rows are not resident. */
    public void refuseEvicted(int32 slot) {
        if (slot >= 0 && slot < this.nSlots && this.gone[(int64) slot]) {
            throw heap LlmException("kv pool: slot " + slot + " is evicted; restore or recompute it before a step");
        }
        return;
    }

    /** Whether slot `slot` was evicted and not yet released. */
    public boolean isEvicted(int32 slot) {
        return slot >= 0 && slot < this.nSlots && this.gone[(int64) slot];
    }

    /** Distinct blocks slot `slot` holds in kind `kd`: its drawn blocks, at most a ring's R (kv-paging 2.1). */
    public int32 unitBlocks(int32 slot, int32 kd) {
        int32 n = this.logical[(int64) (slot * this.nKinds + kd)];
        int32 r = this.kBlocks[(int64) kd];
        if (n > r) { n = r; }
        return n;
    }

    /** The block ids of slot `slot`'s unit, kind by kind in table order. */
    public #int32[] unitOf(int32 slot) {
        int32 total = 0;
        int32 kd = 0;
        while (kd < this.nKinds) { total = total + this.unitBlocks(slot, kd); kd = kd + 1; }
        int32[] ids #= heap int32[(int64) total];
        int32 at = 0;
        kd = 0;
        while (kd < this.nKinds) {
            int32 base = this.tableBase(slot, kd);
            int32 b = 0;
            while (b < this.unitBlocks(slot, kd)) {
                ids[(int64) at] = this.th[(int64) (base + b)];
                at = at + 1;
                b = b + 1;
            }
            kd = kd + 1;
        }
        return #ids;
    }

    /** Device bytes slot `slot`'s unit holds over every layer, K and V. */
    public int64 unitBytes(int32 slot) {
        int64 n = 0L;
        int32 l = 0;
        while (l < this.layers) {
            n = n + (int64) this.unitBlocks(slot, this.kindOf(l)) * (int64) KvPage.BLOCK * (int64) this.kvDim * 4L;
            l = l + 1;
        }
        return n;
    }

    /** Return slot `slot`'s whole unit to the free lists and mark it evicted, so a draw for it refuses until
     *  {@link #release}; returns the blocks freed. */
    public int32 evict(int32 slot) {
        if (slot < 0 || slot >= this.nSlots) { return 0; }
        int32 n = 0;
        int32 kd = 0;
        while (kd < this.nKinds) { n = n + this.unitBlocks(slot, kd); kd = kd + 1; }
        this.release(slot);
        this.gone[(int64) slot] = true;
        return n;
    }

    /** Upload the table if a draw changed it, after the stream drains so no step in flight reads it half written. */
    public void flush() {
        if (!this.dirty) { return; }
        KernelStream s = QuantKernel.stream();
        s.sync();
        this.tab.upload(this.th, this.th.count());
        this.dirty = false;
        return;
    }

    /** The first entry of slot `slot`'s kind-`kd` region in {@link #table}. */
    public int32 tableBase(int32 slot, int32 kd) { return (slot * this.nKinds + kd) * this.nLog; }

    /** The block table of every slot: a BORROW, replaced by a growth. */
    public KernelBuffer<int32> table() { return this.tab; }

    /** Whether `n` slots fit every layer's buffer under 2 GiB. */
    public boolean fits(int32 n) {
        int32 kd = 0;
        while (kd < this.nKinds) {
            int64 plane = (int64) this.rowsOf(kd) * (int64) this.kvDim;
            if ((int64) n * plane * 2L >= (1L << 31)) { return false; }
            kd = kd + 1;
        }
        return true;
    }

    /** Layer `li`'s K buffer, every slot: a BORROW, replaced by a growth. */
    public KernelBuffer<float16> kAll(int32 li) { return this.k[(int64) li]; }

    /** Layer `li`'s V buffer, every slot: a BORROW, replaced by a growth. */
    public KernelBuffer<float16> vAll(int32 li) { return this.v[(int64) li]; }

    /** Halves before slot `slot`'s first block in layer `li`'s buffers. */
    int64 sliceAt(int32 li, int32 slot) {
        int32 b0 = this.th[(int64) this.tableBase(slot, this.kindOf(li))];
        return (int64) b0 * (int64) KvPage.BLOCK * (int64) this.kvDim;
    }

    /** Slot `slot`'s plane in layer `li`'s K buffer, for a slot that drew its whole plane on a fresh pool (its blocks
     *  then run in order); a view that a growth invalidates. */
    public #KernelBuffer<float16> kSlice(int32 li, int32 slot) {
        int64 plane = this.planeElements(li);
        KernelBuffer<float16> s #= this.k[(int64) li].slice((uint64) this.sliceAt(li, slot), (uint64) plane);
        return #s;
    }

    /** {@link #kSlice} of layer `li`'s V buffer. */
    public #KernelBuffer<float16> vSlice(int32 li, int32 slot) {
        int64 plane = this.planeElements(li);
        KernelBuffer<float16> s #= this.v[(int64) li].slice((uint64) this.sliceAt(li, slot), (uint64) plane);
        return #s;
    }

    /** A pool of this one's shape, ring sizes included, holding no slot. */
    public #KvPool emptyLike() {
        int32[] w #= heap int32[(int64) this.layers];
        int32 l = 0;
        while (l < this.layers) {
            w[(int64) l] = this.kWin[(int64) this.kindOfL[(int64) l]];
            l = l + 1;
        }
        KvPool p #= heap KvPool(this.cap, this.kvDim, w);
        int32 kd = 0;
        while (kd < this.nKinds) {
            p.kBlocks[(int64) kd] = this.kBlocks[(int64) kd];
            kd = kd + 1;
        }
        return #p;
    }

    /** Grow to at least `n` slots' table regions, keeping every entry; blocks come as slots draw them. */
    public void ensureSlots(int32 n) {
        if (n <= this.nSlots) { return; }
        Diag.growth();
        int64 te = (int64) n * (int64) this.nKinds * (int64) this.nLog;
        int32[] nth #= heap int32[te];
        int64 i = 0L;
        while (i < this.th.count()) { nth[i] = this.th[i]; i = i + 1L; }
        this.th #= nth;
        int32[] nlg #= heap int32[(int64) (n * this.nKinds)];
        i = 0L;
        while (i < this.logical.count()) { nlg[i] = this.logical[i]; i = i + 1L; }
        this.logical #= nlg;
        boolean[] ng #= heap boolean[(int64) n];
        i = 0L;
        while (i < this.gone.count()) { ng[i] = this.gone[i]; i = i + 1L; }
        this.gone #= ng;
        if (this.tab != null) {
            KernelStream s = QuantKernel.stream();
            s.sync();
        }
        this.tab #= heap KernelBuffer<int32>((uint64) te);
        this.tab.upload(this.th, te);
        this.dirty = false;
        this.nSlots = n;
        this.nGrowths = this.nGrowths + 1;
        return;
    }

    /** `dst[i] = src[i]` for i < n, grid-stride over `stride` threads. */
    @Kernel
    public static void copyF16Kernel(KernelBuffer<float16> dst, KernelBuffer<float16> src,
            uint32 n, uint32 stride) {
        uint32 i = KernelThread.globalIdX();
        while (i < n) {
            dst[(int64) i] = src[(int64) i];
            i = i + stride;
        }
    }

    static void copyLaunchNoSync(KernelBuffer<float16> dst, KernelBuffer<float16> src, int64 n) {
        int64 groups = (n + 255L) / 256L;
        if (groups > 4096L) { groups = 4096L; }
        KernelStream s = QuantKernel.stream();
        copyF16Kernel.launch(s, grid: [(uint32) groups], block: [256])
            (dst, src, (uint32) n, (uint32) (groups * 256L));
        return;
    }
}
