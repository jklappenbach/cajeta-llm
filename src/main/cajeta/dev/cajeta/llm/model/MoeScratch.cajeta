package dev.cajeta.llm.model;

import cajeta.math.Tensor;

/**
 * The MoE forward's per-layer scratch, allocated once at bind so the
 * decode path stays zero-allocation (the 6.1.6 invariant). Deliberately
 * NOT an InfModule — the reflective parameter walk must not see scratch
 * as parameters (the ActivationPool rule), and MoeFfn holding this as a
 * plain class reference is exactly how the walk skips it.
 */
final class MoeScratch {
    Tensor<float32> logits;   // router logits, [experts]
    float32[] probs;          // gating probabilities, [experts]
    int32[] sel;              // selected expert ids, [used]
    float32[] w;              // combining weights, [used]
    Tensor<float32> g;        // expert gate activation, [width]
    Tensor<float32> u;        // expert up activation, [width]
    Tensor<float32> eOut;     // one expert's output, [hidden]
    Tensor<float32> shG;      // shared-expert gate, [sharedW] (or null)
    Tensor<float32> shU;      // shared-expert up, [sharedW] (or null)
    Tensor<float32> shOut;    // shared-expert output, [hidden] (or null)

    MoeScratch(int32 experts, int32 used, int32 width, int32 hidden,
            int32 sharedW) {
        int64[] s = heap int64[1];
        s[0] = (int64) experts;
        this.logits = Tensor.zeros<float32>(s);
        this.probs = heap float32[experts];
        this.sel = heap int32[used];
        this.w = heap float32[used];
        s[0] = (int64) width;
        this.g = Tensor.zeros<float32>(s);
        this.u = Tensor.zeros<float32>(s);
        s[0] = (int64) hidden;
        this.eOut = Tensor.zeros<float32>(s);
        this.shG = null;
        this.shU = null;
        this.shOut = null;
        if (sharedW > 0) {
            s[0] = (int64) sharedW;
            this.shG = Tensor.zeros<float32>(s);
            this.shU = Tensor.zeros<float32>(s);
            s[0] = (int64) hidden;
            this.shOut = Tensor.zeros<float32>(s);
        }
    }
}
