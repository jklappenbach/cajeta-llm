package dev.cajeta.llm.model;

import cajeta.xpu.Event;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.MemoryKind;

/**
 * The pipelined batched decode's device-side state (cajeta-llm 15.2.12.3.9.5): two
 * pinned token buffers of `rows` entries, the device gathering the next step's
 * embeddings from one while writing this step's argmaxes to the other (each row's
 * argmax writes its own entry, so there is no one-word view per row: a view at a
 * 4-byte offset is refused on a device that binds storage at 16), and an event per
 * buffer. One object, so the model's class stays
 * under the 64 reference fields the released toolchain handles.
 */
public final class BatchPipe {
    KernelBuffer<int32> tok0;
    KernelBuffer<int32> tok1;
    Event ev0;
    Event ev1;
    int32[] host;
    KernelBuffer<int32> tab0;      // the attention row table a step writes: one a slot, so a
    KernelBuffer<int32> tab1;      // host write never lands the step in flight

    public BatchPipe(int64 rows) {
        this.tab0 #= heap KernelBuffer<int32>((uint64) (4L * rows));
        this.tab1 #= heap KernelBuffer<int32>((uint64) (4L * rows));
        this.tok0 = heap KernelBuffer<int32>(0L, (uint64) rows);
        this.tok0.allocate(MemoryKind.Pinned);
        this.tok1 = heap KernelBuffer<int32>(0L, (uint64) rows);
        this.tok1.allocate(MemoryKind.Pinned);
        this.ev0 #= Event.create();
        this.ev1 #= Event.create();
        this.host = heap int32[rows];
    }

    /** Token buffer `slot` (0 or 1). */
    public KernelBuffer<int32> tok(int32 slot) {
        if (slot == 0) { return this.tok0; }
        return this.tok1;
    }

    /** The attention row table for the step whose argmaxes go to `slot`. */
    public KernelBuffer<int32> rowTab(int32 slot) {
        if (slot == 0) { return this.tab0; }
        return this.tab1;
    }

    /** The event that marks buffer `slot`'s argmaxes written. */
    public Event event(int32 slot) {
        if (slot == 0) { return this.ev0; }
        return this.ev1;
    }
}
