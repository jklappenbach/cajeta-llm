package dev.cajeta.llama.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llama.io.Checkpoint;
import cajeta.xpu.Device;
import dev.cajeta.llama.io.Quant;
import dev.cajeta.llama.io.QuantKernel;
import dev.cajeta.llama.model.Linear;
import cajeta.math.Tensor;
import cajeta.lang.String;

/**
 * threaded-forward-path plan 4.1 — `Linear.matvecInto` routed through the
 * Q4_K kernel.
 *
 * Unit 3 already settled the arithmetic: the kernel is bit-identical to
 * `Quant.q4kMatVecInto` over the same bytes. What is new here is the
 * PLUMBING — a weight uploaded once and kept resident, activations copied
 * in and out through fixed-size scratch, offsets that no longer reach the
 * kernel because the scratch is exactly one row wide. Those are the things
 * that can be wrong while the arithmetic stays right, so every test below
 * compares ROUTED against FORCED-SERIAL on the same `Linear`.
 *
 * The bar there is a TOLERANCE, and that is a correction. The file was
 * written when the kernel summed 16 lanes like `Quant.q4kMatVecInto` and
 * demanded bit-identity of the pair; the kernel went to 4 lanes for a 3.7x
 * (plan 6.3.3) and the two now reassociate the same products differently by
 * construction. Nothing caught the stale bar because this file called an
 * `assertClose` that was never defined, so it has not compiled — and none
 * of these tests has run — since commit 08b7bcd.
 *
 * Bit-identity is still the bar wherever the lane counts actually match:
 * `QuantKernelTest` holds each kernel against `q4kMatVecIntoLanes4`, and
 * the routed-vs-routed comparisons below (offsets, row slicing) are exact.
 *
 * The fixture is `toy-q4k.gguf` (tools/gguf/gen_q4k_linear_fixture.py): a
 * Q4_K tensor and a Q6_K tensor built from the REAL blocks already checked
 * in under kquant/, each with its gguf-py dequantized twin as F32, all
 * shaped [out=8, in=256]. Both formats in ONE file on purpose — that is
 * what a Q4_K_M ships.
 */
public class LinearKernelRouteTest {

    static final String Q4K = "src/test/fixtures/gguf/toy-q4k.gguf";
    static final String Q4K_NAME = "model.layers.0.mlp.down_proj.weight";
    static final String Q6K_NAME = "model.layers.0.self_attn.v_proj.weight";
    static final String TOY = "src/test/fixtures/gguf/toy.gguf";
    static final String Q8_NAME = "model.layers.0.mlp.down_proj.weight";

    public LinearKernelRouteTest() { return; }

    static #Tensor<float32> ramp(int64 n, int64 pad) {
        int64[] shp #= heap int64[1];
        shp[0] = n + pad;
        Tensor<float32> t #= Tensor.zeros<float32>(shp);
        int64 i = 0;
        while (i < n) {
            t.flatSet(i, (float32) ((i % 11L) - 5L) * 0.375f);
            i = i + 1;
        }
        return #t;
    }

    /**
     * The file's comparison bar, factored out.
     *
     * NOT NEW BEHAVIOUR — `q8WeightIsUnaffectedByTheQ4KRoute` has called
     * this since it was written and it was never defined, so this file has
     * not compiled since commit 08b7bcd and NONE of its routing tests have
     * ever run. A test that cannot compile fails exactly like a test that
     * does not exist.
     *
     * `exact` is what the surrounding tests demand of a kernel checked
     * against a serial reference over the same bytes in the same order:
     * bit-identity, not a tolerance. The tolerant branch exists for
     * comparisons that legitimately reassociate.
     */
    static void assertClose(float32 got, float32 want, boolean exact,
            String what) {
        if (exact) {
            if (got != want) {
                Assert.fail(what + ": got " + got + " want " + want
                    + " (bit-identity required)");
            }
            return;
        }
        float32 d = got - want;
        if (d < 0.0f) { d = 0.0f - d; }
        float32 scale = want < 0.0f ? 0.0f - want : want;
        if (d > 0.000001f + scale * 0.000001f) {
            Assert.fail(what + ": got " + got + " want " + want);
        }
        return;
    }

    static void assertLive(Tensor<float32> t, int64 n, String what) {
        int64 i = 0;
        while (i < n) {
            if (t.flatGet(i) != 0.0f) { return; }
            i = i + 1;
        }
        Assert.fail(what + ": every value is zero, which is what a kernel "
            + "that never ran produces");
    }

    /**
     * 4.1.1 — routed and serial agree bit for bit through `matvecInto`.
     *
     * Serial runs FIRST and routed SECOND, deliberately: the routed path
     * builds its resident device buffer on first use, so this ordering is
     * the one where a bad upload shows up.
     */
    @Test
    public void routedMatvecMatchesSerialForQ4K() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Assert.isTrue(lin.isPacked());
        Assert.equals((int64) Quant.GG_Q4_K, (int64) lin.packedType());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L,
            (int64) outDim);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, (int64) outDim);

        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, want, 0L);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, got, 0L);

        LinearKernelRouteTest.assertLive(want, (int64) outDim, "serial");
        LinearKernelRouteTest.assertLive(got, (int64) outDim, "routed");
        int64 o = 0;
        while (o < (int64) outDim) {
            // TOLERANCE, not bit-identity, and only for routed-vs-SERIAL:
            // the kernel sums 4 lanes wide and `Quant.q4kMatVecInto` sums 16,
            // so they reassociate the same products differently by design
            // (plan 6.3.3 — the 4-lane shape is 3.7x faster). Bit-identity
            // still holds where the lane counts match, and that is where it
            // is asserted: QuantKernelTest against `q4kMatVecIntoLanes4`,
            // and routed-vs-routed below.
            LinearKernelRouteTest.assertClose(got.flatGet(o),
                want.flatGet(o), false, "row " + o);
            o = o + 1;
        }
        ck.close();
    }

    /**
     * 4.1.1 — the resident weight survives repeated calls with DIFFERENT
     * activations.
     *
     * The upload happens once; everything after it reuses the buffer. A
     * scratch that is filled once and then reused stale, or a device
     * buffer uploaded from the wrong array, passes the single-call test
     * above and fails this one.
     */
    @Test
    public void routedMatvecIsCorrectOnRepeatedCallsWithNewActivations() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);

        int64[] ishp #= heap int64[1];
        ishp[0] = (int64) inDim;
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;

        int32 call = 0;
        while (call < 3) {
            Tensor<float32> src #= Tensor.zeros<float32>(ishp);
            int64 i = 0;
            while (i < (int64) inDim) {
                src.flatSet(i, (float32) ((i + (int64) call * 3L) % 13L - 6L)
                    * 0.25f);
                i = i + 1;
            }
            Tensor<float32> want #= Tensor.zeros<float32>(oshp);
            Tensor<float32> got #= Tensor.zeros<float32>(oshp);

            QuantKernel.setRoutingEnabled(false);
            lin.matvecInto(src, 0L, want, 0L);
            QuantKernel.setRoutingEnabled(true);
            lin.matvecInto(src, 0L, got, 0L);

            LinearKernelRouteTest.assertLive(got, (int64) outDim,
                "routed call " + call);
            int64 o = 0;
            while (o < (int64) outDim) {
                LinearKernelRouteTest.assertClose(got.flatGet(o),
                    want.flatGet(o), false, "call " + call + " row " + o);
                o = o + 1;
            }
            call = call + 1;
        }
        ck.close();
    }

    /**
     * 4.1.1 — non-zero `srcOff`/`dstOff` into larger tensors, and the
     * margins of `dst` left alone.
     *
     * The routed path copies one row's worth of activations through
     * fixed-size scratch, so the offsets never reach the kernel. That is a
     * reasonable design and an easy place to drop an offset entirely; a
     * routed path that ignored `dstOff` would still match on the values
     * and scribble over index 0.
     */
    @Test
    public void routedMatvecHonoursOffsets() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> flat #= Tensor.zeros<float32>(oshp);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, flat, 0L);
        LinearKernelRouteTest.assertLive(flat, (int64) outDim, "routed");

        // Same activations, shifted inside bigger tensors.
        int64[] bishp #= heap int64[1];
        bishp[0] = (int64) inDim + 8L;
        Tensor<float32> bigSrc #= Tensor.zeros<float32>(bishp);
        int64 i = 0;
        while (i < (int64) inDim) {
            bigSrc.flatSet(i + 5L, src.flatGet(i));
            i = i + 1;
        }
        int64[] boshp #= heap int64[1];
        boshp[0] = (int64) outDim + 4L;
        Tensor<float32> bigDst #= Tensor.zeros<float32>(boshp);
        lin.matvecInto(bigSrc, 5L, bigDst, 3L);

        int64 o = 0;
        while (o < (int64) outDim) {
            if (bigDst.flatGet(o + 3L) != flat.flatGet(o)) {
                Assert.fail("row " + o + " at offset: "
                    + bigDst.flatGet(o + 3L) + " vs flat " + flat.flatGet(o));
            }
            o = o + 1;
        }
        // Margins untouched.
        Assert.equals((int64) (bigDst.flatGet(0L) * 1000000.0f), 0L);
        Assert.equals((int64) (bigDst.flatGet(1L) * 1000000.0f), 0L);
        Assert.equals((int64) (bigDst.flatGet(2L) * 1000000.0f), 0L);
        Assert.equals(
            (int64) (bigDst.flatGet((int64) outDim + 3L) * 1000000.0f), 0L);
        ck.close();
    }

    /**
     * 6.1.2 — a Q4_K_M-shaped MIX: a Q4_K weight and a Q6_K weight bound
     * from one checkpoint, both routed, both matching serial.
     *
     * The mix is the normal case, not an edge case: a real Q4_K_M is
     * 74.4% Q4_K and 25.6% Q6_K by bytes (measured on
     * Meta-Llama-3.1-8B-Instruct-Q4_K_M), with `attn_v` and
     * `output.weight` carrying the Q6_K. Per-format tests each pass under
     * a dispatch that ignores the type; this one does not.
     */
    @Test
    public void q4kAndQ6kInOneCheckpointBothRouteCorrectly() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int32 pass = 0;
        while (pass < 2) {
            String nm = pass == 0 ? LinearKernelRouteTest.Q4K_NAME
                                  : LinearKernelRouteTest.Q6K_NAME;
            int32 wantTy = pass == 0 ? Quant.GG_Q4_K : Quant.GG_Q6_K;
            int64[] shp #= ck.shapeOf(nm);
            int32 outDim = (int32) shp[0];
            int32 inDim = (int32) shp[1];

            Linear lin #= heap Linear(inDim, outDim);
            lin.bind(ck, nm, false);
            Assert.isTrue(lin.isPacked());
            Assert.equals((int64) wantTy, (int64) lin.packedType());

            Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim,
                0L);
            int64[] oshp #= heap int64[1];
            oshp[0] = (int64) outDim;
            Tensor<float32> want #= Tensor.zeros<float32>(oshp);
            Tensor<float32> got #= Tensor.zeros<float32>(oshp);

            QuantKernel.setRoutingEnabled(false);
            lin.matvecInto(src, 0L, want, 0L);
            QuantKernel.setRoutingEnabled(true);
            lin.matvecInto(src, 0L, got, 0L);

            LinearKernelRouteTest.assertLive(want, (int64) outDim,
                "serial " + nm);
            LinearKernelRouteTest.assertLive(got, (int64) outDim,
                "routed " + nm);
            int64 o = 0;
            while (o < (int64) outDim) {
                LinearKernelRouteTest.assertClose(got.flatGet(o),
                    want.flatGet(o), false, nm + " row " + o);
                o = o + 1;
            }
            pass = pass + 1;
        }
        ck.close();
    }

    /**
     * 4.1.2 / 6.1.2 — a Q8_0 weight gives the SAME answer routed and
     * serial.
     *
     * This was the does-NOT-fire half while Q8_0 had no kernel: a dispatch
     * written as "packed → kernel" rather than per-TYPE would have fed
     * Q8_0 bytes to the Q4_K decoder. Q8_0 now has its own kernel, so the
     * test still catches exactly that mistake — as a wrong answer from the
     * wrong decoder rather than as an unexpected change.
     */
    @Test
    public void q8WeightIsUnaffectedByTheQ4KRoute() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.TOY);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q8_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q8_NAME, false);
        Assert.isTrue(lin.isPacked());
        Assert.equals((int64) Quant.GG_Q8_0, (int64) lin.packedType());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> off #= Tensor.zeros<float32>(oshp);
        Tensor<float32> on #= Tensor.zeros<float32>(oshp);

        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, off, 0L);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, on, 0L);

        LinearKernelRouteTest.assertLive(off, (int64) outDim, "q8 serial");
        int64 o = 0;
        while (o < (int64) outDim) {
            LinearKernelRouteTest.assertClose(on.flatGet(o),
                off.flatGet(o), true, "q8 row " + o);
            o = o + 1;
        }
        ck.close();
    }

    /**
     * A ROW-SLICED launch computes exactly what a whole-weight launch does.
     *
     * Splitting one dispatch into row slices is worth 1.74x on gfx1151 (98.8
     * to 56.7 ms/token) because the kernel's speed is set by its grid, not by
     * the weight's size. It is only worth anything if the answer is
     * unchanged, and the slice has two adjustments that can each be wrong on
     * their own: the packed buffer is re-based to the chunk's first row, and
     * `yOff` carries the chunk's offset into the output.
     *
     * The bar is bit-identity against BOTH the whole-weight route and the
     * serial reference, and the launch COUNT is asserted alongside the
     * values — 4 dispatches for 8 rows in chunks of 2, and 1 without. A test
     * that checked only the numbers would pass just as happily against a
     * build where chunking silently never engaged, which is the failure this
     * exists to catch.
     */
    @Test
    public void rowSlicedLaunchesMatchAWholeWeightLaunch() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Assert.isTrue(lin.isPacked());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> ser #= Tensor.zeros<float32>(oshp);
        Tensor<float32> whole #= Tensor.zeros<float32>(oshp);
        Tensor<float32> sliced #= Tensor.zeros<float32>(oshp);

        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, ser, 0L);

        QuantKernel.setRoutingEnabled(true);
        Linear.setLaunchChunkRows(0L);              // one dispatch
        Linear.resetLaunchCount();
        lin.matvecInto(src, 0L, whole, 0L);
        int64 nWhole = Linear.launchCount();

        Linear.setLaunchChunkRows(2L);              // 8 rows -> 4 dispatches
        Linear.resetLaunchCount();
        lin.matvecInto(src, 0L, sliced, 0L);
        int64 nSliced = Linear.launchCount();

        LinearKernelRouteTest.assertLive(whole, (int64) outDim, "whole");
        LinearKernelRouteTest.assertLive(sliced, (int64) outDim, "sliced");
        // The mechanism moved, and it moved by the amount the chunk size
        // implies -- not merely "more than one".
        Assert.equals(1L, nWhole);
        Assert.equals(((int64) outDim + 1L) / 2L, nSliced);

        int64 o = 0;
        while (o < (int64) outDim) {
            LinearKernelRouteTest.assertClose(sliced.flatGet(o),
                whole.flatGet(o), true, "sliced vs whole row " + o);
            // Against the SERIAL path the bar is a tolerance for the lane
            // reason above; against the whole-weight LAUNCH it is exact,
            // because that pair differs only in grid.
            LinearKernelRouteTest.assertClose(sliced.flatGet(o),
                ser.flatGet(o), false, "sliced vs serial row " + o);
            o = o + 1;
        }
        Linear.setLaunchChunkRows(0L);
        ck.close();
    }

    /**
     * A chunk size at or above the row count leaves ONE dispatch — the
     * does-not-fire half. Without it, "chunking is correct" and "chunking is
     * unreachable" look the same from the outside.
     */
    @Test
    public void aChunkLargerThanTheWeightIssuesASingleLaunch() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> y #= Tensor.zeros<float32>(oshp);

        QuantKernel.setRoutingEnabled(true);
        Linear.setLaunchChunkRows((int64) outDim * 4L);
        Linear.resetLaunchCount();
        lin.matvecInto(src, 0L, y, 0L);
        Assert.equals(1L, Linear.launchCount());
        LinearKernelRouteTest.assertLive(y, (int64) outDim, "oversized chunk");
        Linear.setLaunchChunkRows(0L);
        ck.close();
    }

    /**
     * The q8 INTEGER route through `Linear`, which is a different bar.
     *
     * Every test above pins the f32 route because it compares routed against
     * serial and expects agreement. This one selects the integer route and
     * expects DISAGREEMENT within a band: quantizing the activations to int8
     * is an approximation the serial path does not make. 1% of magnitude is
     * the band, and it is asserted from both sides — too far apart means the
     * route is wrong, exactly equal means the quantization never happened
     * and the test is vacuous.
     */
    @Test
    public void theQ8RouteAgreesWithSerialToAboutOnePercent() {
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Assert.isTrue(lin.isPacked());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> ser #= Tensor.zeros<float32>(oshp);
        Tensor<float32> q8 #= Tensor.zeros<float32>(oshp);

        Linear.setQ8Route(false);
        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, ser, 0L);

        Linear.setQ8Route(true);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, q8, 0L);

        LinearKernelRouteTest.assertLive(ser, (int64) outDim, "serial");
        LinearKernelRouteTest.assertLive(q8, (int64) outDim, "q8 route");
        boolean anyDiffer = false;
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 a = ser.flatGet(o);
            float32 b = q8.flatGet(o);
            if (a != b) { anyDiffer = true; }
            float32 d = b - a;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 m = a < 0.0f ? 0.0f - a : a;
            if (d > 0.01f * m + 0.001f) {
                Assert.fail("row " + o + ": q8 " + b + " is not within 1% of "
                    + "serial " + a);
            }
            o = o + 1;
        }
        if (!anyDiffer) {
            Assert.fail("the q8 route matched serial EXACTLY, so the "
                + "activation quantization did not happen");
        }
        Linear.setQ8Route(false);
        ck.close();
    }

    /**
     * A caller that opens no sharing window is never served from the stage.
     *
     * SAME tensor, SAME offset, DIFFERENT contents — the shape `xn` has from
     * one layer to the next, and the case a cache keyed on identity plus
     * offset gets wrong. The default has to be safe: this test says nothing
     * about sharing and must still see its own second activation.
     */
    @Test
    public void withoutASharingWindowEveryCallStagesItsOwnActivation() {
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Linear.setQ8Route(false);
        QuantKernel.setRoutingEnabled(true);

        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> yA #= Tensor.zeros<float32>(oshp);
        Tensor<float32> yB #= Tensor.zeros<float32>(oshp);

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        lin.matvecInto(src, 0L, yA, 0L);
        int64 i = 0;
        while (i < (int64) inDim) {
            src.flatSet(i, src.flatGet(i) * -2.0f);
            i = i + 1;
        }
        lin.matvecInto(src, 0L, yB, 0L);

        LinearKernelRouteTest.assertLive(yA, (int64) outDim, "first");
        LinearKernelRouteTest.assertLive(yB, (int64) outDim, "second");
        int64 o = 0;
        boolean differ = false;
        while (o < (int64) outDim) {
            if (yA.flatGet(o) != yB.flatGet(o)) { differ = true; }
            o = o + 1;
        }
        if (!differ) {
            Assert.fail("the second call returned the FIRST activation's "
                + "result - the stage served a stale entry");
        }
        ck.close();
    }

    /**
     * Inside a window, the SAME activation is staged once — and the answer is
     * still right. Both halves matter: the count proves the optimization
     * fires, and the values prove it did not change what is computed. A test
     * that checked only the values would pass against a build where sharing
     * silently never engaged.
     */
    @Test
    public void insideASharingWindowTheActivationIsStagedOnce() {
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Linear.setQ8Route(false);
        QuantKernel.setRoutingEnabled(true);

        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> yA #= Tensor.zeros<float32>(oshp);
        Tensor<float32> yB #= Tensor.zeros<float32>(oshp);
        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);

        Linear.resetStageCounts();
        Linear.beginSharedActivation();
        lin.matvecInto(src, 0L, yA, 0L);
        lin.matvecInto(src, 0L, yB, 0L);
        Linear.endSharedActivation();

        Assert.equals(1L, Linear.stageMisses());
        Assert.equals(1L, Linear.stageHits());
        int64 o = 0;
        while (o < (int64) outDim) {
            LinearKernelRouteTest.assertClose(yB.flatGet(o), yA.flatGet(o),
                true, "shared row " + o);
            o = o + 1;
        }
        LinearKernelRouteTest.assertLive(yA, (int64) outDim, "shared");
        ck.close();
    }

    /**
     * The does-NOT-fire half of the Q6_K wave route (plan 11.2): with the
     * switch ON it must be CLOSE to the exact route and must not EQUAL it.
     *
     * The route quantizes activations to q8_K, which is an approximation
     * the serial path does not make. Exact agreement would mean the route
     * is not being taken — and the test above, which pins the switch OFF,
     * would still pass in that case.
     */
    @Test
    public void theQ6kWaveRouteApproximatesRatherThanMatchesTheSerialPath() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        Linear.setQ8Route(true);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q6K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];
        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q6K_NAME, false);
        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> want #= Tensor.zeros<float32>(oshp);
        Tensor<float32> got #= Tensor.zeros<float32>(oshp);
        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, want, 0L);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, got, 0L);
        ck.close();
        int64 o = 0;
        int64 differing = 0;
        while (o < (int64) outDim) {
            float32 a = want.flatGet(o);
            float32 b = got.flatGet(o);
            float32 diff = a - b;
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a < 0.0f ? 0.0f - a : a;
            if (diff > mag * 0.01f + 0.001f) {
                Assert.fail("row " + o + ": routed " + b + " vs serial " + a
                    + " - further apart than q8_K quantization explains");
            }
            if (a != b) { differing = differing + 1; }
            o = o + 1;
        }
        if (differing == 0) {
            Assert.fail("the Q6_K wave route matched the serial path "
                + "EXACTLY - the activation quantization is not happening");
        }
    }

}
