        int8[] raw #= QuantKernelTest.tiled(one, 4L);
        int64 outDim = 16L;
        int64 cols = (((int64) raw.count() / 144L) / outDim) * 256L;
        int64 rows = 32L;
        float32[] x #= QuantKernelTest.activations(rows * cols);
        float32[] want #= heap float32[rows * outDim];
        float32[] got #= heap float32[rows * outDim];
        WmmaKernel.compareT2Into(raw, x, rows, outDim, cols, want, got);
        QuantKernelTest.assertEpiAgreement(want, got, rows, outDim,
            "T2 deq Q4_K");
    }

    /**
     * 10.12.21 second iteration — the N=4 output-tiled deq kernel (one
     * wave, FOUR output tiles, A fragments loaded once and reused
     * across all four) agrees with the batch kernel. outDim = 64 so a
     * workgroup's full output span is exercised: a kernel that reused
     * the wrong tile's scales or wrote a stripe at the wrong offset
     * passes narrower shapes and corrupts every real projection.
     */
