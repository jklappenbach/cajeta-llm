        int64 outDim = 64L;
        int64 cols = (((int64) raw.count() / 144L) / outDim) * 256L;
        int64 rows = 16L;
        float32[] x #= QuantKernelTest.activations(rows * cols);
        float32[] want #= heap float32[rows * outDim];
        float32[] got #= heap float32[rows * outDim];
        WmmaKernel.compareN4Into(raw, x, rows, outDim, cols, want, got);
        QuantKernelTest.assertEpiAgreement(want, got, rows, outDim,
            "N4 deq Q4_K");
    }

    /**
     * 10.12.21 FINAL — the multi-wave deq kernel (8 waves per
     * workgroup, register epilogue via the dual verb, per-lane header
     * registers, barrier-free K-loop) agrees with the batch kernel.
     * outDim = 128 so every wave slot of a workgroup computes a
     * distinct tile: a kernel that mapped wave ids to tiles wrongly
     * passes narrower shapes and corrupts every real projection.
     */
