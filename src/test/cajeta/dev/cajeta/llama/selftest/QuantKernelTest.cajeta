package dev.cajeta.llama.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llama.io.Quant;
import dev.cajeta.llama.io.QuantKernel;
import cajeta.io.file.File;
import cajeta.lang.String;

/**
 * threaded-forward-path plan 3.1 — the Q4_K mat-vec as an `@Kernel`,
 * against the serial reference it was lifted from.
 *
 * The bar is BIT-IDENTICAL, not a tolerance, and that is a deliberate
 * choice rather than an optimistic one: each kernel performs the same
 * float operations in the same order as the serial twin it is compared
 * against. A tolerance would hide exactly the class of bug these units
 * can introduce — a row computed twice, a row skipped, a sub-block paired
 * with the wrong scale — because all of those land close to the right
 * answer on smooth data.
 *
 * Q4_K's twin is `q4kMatVecIntoLanes4`, NOT the `q4kMatVecInto` the host
 * path uses. The two host forms compute the same thing in different
 * orders because the two settings want different vector widths (plan
 * 6.3.3): 16 lanes wins on the host, 4 lanes wins inside a kernel, where
 * the CPU backend vectorizes across work items. Keeping a same-order twin
 * is what lets the bar stay hard equality instead of softening to a
 * tolerance the moment the shapes diverged.
 *
 * Every test also asserts the answer is NON-ZERO. A kernel that fails to
 * lower does not fail the build: the launch finds nothing registered and
 * every output buffer reads back zero (plan 8.11). Comparing two things
 * that are both zero is how XpuScheduleTests came to pass while running
 * no kernel at all, and this suite will not repeat it.
 */
public class QuantKernelTest {

    static final String DIR = "src/test/fixtures/gguf/kquant/";

    public QuantKernelTest() { return; }

    /** Fails unless `v` has at least one non-zero entry — the guard against
     *  a silent no-op launch reading as agreement. */
    static void assertLive(float32[] v, String what) {
        int64 i = 0;
        while (i < (int64) v.count()) {
            if (v[i] != 0.0f) { return; }
            i = i + 1;
        }
        Assert.fail(what + ": every value is zero, which is what a kernel "
            + "that never ran produces");
    }

    /** Mixed signs and magnitudes: an all-positive x hides sign handling in
     *  the nibble widen, and a constant x hides lane misordering. */
    static #float32[] activations(int64 n) {
        float32[] x #= heap float32[n];
        int64 c = 0;
        while (c < n) {
            x[c] = (float32) ((c % 11L) - 5L) * 0.375f;
            c = c + 1;
        }
        return #x;
    }

    /** `reps` copies of the fixture's blocks, so a test can ask for more
     *  rows than the 8 blocks on disk. */
    static #int8[] tiled(int8[] raw, int64 reps) {
        int64 n = (int64) raw.count();
        int8[] out #= heap int8[n * reps];
        int64 r = 0;
        while (r < reps) {
            int64 i = 0;
            while (i < n) { out[r * n + i] = raw[i]; i = i + 1; }
            r = r + 1;
        }
        return #out;
    }

    /**
     * 3.1.1 — the kernel agrees with `q4kMatVecIntoLanes4` bit for bit on
     * the real Q4_K_M bytes.
     */
    @Test
    public void q4kKernelIsBitIdenticalToSerial() {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 2L;
        int64 cols = (blocks / rows) * 256L;
        float32[] x #= QuantKernelTest.activations(cols);

        float32[] want #= heap float32[rows];
        float32[] got #= heap float32[rows];
        Quant.q4kMatVecIntoLanes4(raw, rows, cols, x, 0L, want, 0L);
        QuantKernel.q4kMatVecIntoDevice(raw, rows, cols, x, 0L, got, 0L);

        QuantKernelTest.assertLive(want, "serial reference");
        QuantKernelTest.assertLive(got, "kernel");
        int64 r = 0;
        while (r < rows) {
            if (got[r] != want[r]) {
                Assert.fail("row " + r + ": kernel " + got[r]
                    + " vs serial " + want[r]);
            }
            r = r + 1;
        }
    }

    /**
     * 6.1.1 — every routed format is bit-identical to its own serial
     * reference, over the real blocks checked in under kquant/.
     *
     * Q6_K is the one that pays: 25.6% of a Q4_K_M file by bytes
     * (measured on Meta-Llama-3.1-8B-Instruct-Q4_K_M — 74.4% Q4_K, 25.6%
     * Q6_K, no Q5_K, no Q8_0), and it holds `attn_v` and `output.weight`,
     * so it runs for every token. With Q4_K routed and Q6_K serial,
     * Amdahl caps end-to-end at about 3x however well the Q4_K kernel
     * scales.
     */
    static void checkFormat(String name, int32 ty, int64 blockBytes,
            int64 blockElems) {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + name + ".bin");
        int64 blocks = (int64) raw.count() / blockBytes;
        int64 rows = 2L;
        int64 cols = (blocks / rows) * blockElems;
        float32[] x #= QuantKernelTest.activations(cols);

        float32[] want #= heap float32[rows];
        float32[] got #= heap float32[rows];
        if (ty == Quant.GG_Q5_K) {
            Quant.q5kMatVecInto(raw, rows, cols, x, 0L, want, 0L);
        } else if (ty == Quant.GG_Q6_K) {
            Quant.q6kMatVecInto(raw, rows, cols, x, 0L, want, 0L);
        } else {
            Quant.q8MatVecInto(raw, rows, cols, x, 0L, want, 0L);
        }
        QuantKernel.matVecIntoDevice(ty, raw, rows, cols, x, 0L, got, 0L);

        QuantKernelTest.assertLive(want, name + " serial reference");
        QuantKernelTest.assertLive(got, name + " kernel");
        int64 r = 0;
        while (r < rows) {
            if (got[r] != want[r]) {
                Assert.fail(name + " row " + r + ": kernel " + got[r]
                    + " vs serial " + want[r]);
            }
            r = r + 1;
        }
    }

    /**
     * 6.3.3 — the 4-lane oracle is tied to the SCALAR floor, so it cannot
     * drift away from what Q4_K means while still agreeing with the kernel.
     *
     * Without this, `q4kMatVecIntoLanes4` and `q4kMatVecKernel` could both
     * be wrong in the same way and 3.1.1 would still pass. A tolerance is
     * right here and hard equality would be wrong: the scalar floor sums
     * left to right over 256 elements and the vector form reduces four
     * lanes, so they cannot agree bit for bit and a test demanding it would
     * fail on correct code.
     */
    @Test
    public void lanes4OracleAgreesWithTheScalarFloor() {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 2L;
        int64 cols = (blocks / rows) * 256L;
        float32[] x #= QuantKernelTest.activations(cols);
        float32[] lanes4 #= heap float32[rows];
        float32[] floor #= heap float32[rows];
        Quant.q4kMatVecIntoLanes4(raw, rows, cols, x, 0L, lanes4, 0L);
        Quant.q4kMatVecIntoScalar(raw, rows, cols, x, 0L, floor, 0L);
        QuantKernelTest.assertLive(lanes4, "lanes4 oracle");
        int64 r = 0;
        while (r < rows) {
            float32 diff = lanes4[r] - floor[r];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = floor[r] < 0.0f ? 0.0f - floor[r] : floor[r];
            if (diff > mag * 1.0e-4f + 1.0e-3f) {
                Assert.fail("row " + r + ": lanes4 " + lanes4[r]
                    + " vs scalar floor " + floor[r]);
            }
            r = r + 1;
        }
    }

    @Test
    public void q6kKernelIsBitIdenticalToSerial() {
        QuantKernelTest.checkFormat("q6_k", Quant.GG_Q6_K, 210L, 256L);
    }

    @Test
    public void q5kKernelIsBitIdenticalToSerial() {
        QuantKernelTest.checkFormat("q5_k", Quant.GG_Q5_K, 176L, 256L);
    }

    @Test
    public void q8KernelIsBitIdenticalToSerial() {
        QuantKernelTest.checkFormat("q8_0", Quant.GG_Q8_0, 34L, 32L);
    }

    /**
     * 3.1.2 — 520 rows over a 64-wide block is 9 grid blocks with the last
     * one 56/64 masked off, and 9 blocks over the CPU backend's workers
     * divides evenly for no worker count it is likely to pick. A row
     * computed twice or skipped shows up as a mismatch at that row.
     */
    @Test
    public void q4kKernelCoversEveryRowWhenRowsDoNotFillTheGrid() {
        int8[] one #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 rows = 520L;
        int64 cols = 256L;                       // one block per row
        int64 blocksOnDisk = (int64) one.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int8[] raw #= QuantKernelTest.tiled(one, (rows + blocksOnDisk - 1L)
            / blocksOnDisk);
        float32[] x #= QuantKernelTest.activations(cols);

        float32[] want #= heap float32[rows];
        float32[] got #= heap float32[rows];
        Quant.q4kMatVecIntoLanes4(raw, rows, cols, x, 0L, want, 0L);
        QuantKernel.q4kMatVecIntoDevice(raw, rows, cols, x, 0L, got, 0L);

        QuantKernelTest.assertLive(got, "kernel");
        int64 r = 0;
        while (r < rows) {
            if (got[r] != want[r]) {
                Assert.fail("row " + r + " of " + rows + ": kernel "
                    + got[r] + " vs serial " + want[r]);
            }
            r = r + 1;
        }
    }

    /**
     * 3.1.3 — `kQuantMatVecHonoursOffsets`' guarantee through the kernel:
     * a non-zero `xOff`/`yOff` reads and writes the same values, shifted.
     */
    @Test
    public void q4kKernelHonoursOffsets() {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 2L;
        int64 cols = (blocks / rows) * 256L;
        float32[] x #= QuantKernelTest.activations(cols);

        float32[] flat #= heap float32[rows];
        QuantKernel.q4kMatVecIntoDevice(raw, rows, cols, x, 0L, flat, 0L);

        float32[] bigX #= heap float32[cols + 8L];
        int64 c = 0;
        while (c < cols) { bigX[c + 5L] = x[c]; c = c + 1; }
        float32[] bigY #= heap float32[rows + 4L];
        QuantKernel.q4kMatVecIntoDevice(raw, rows, cols, bigX, 5L, bigY, 3L);

        QuantKernelTest.assertLive(flat, "kernel at offset 0");
        int64 r = 0;
        while (r < rows) {
            if (bigY[r + 3L] != flat[r]) {
                Assert.fail("row " + r + " at offset: " + bigY[r + 3L]
                    + " vs flat " + flat[r]);
            }
            r = r + 1;
        }
        // The untouched margins must stay untouched — a yOff the kernel
        // ignored would still match above while scribbling at index 0.
        Assert.equals((int64) (bigY[0] * 1000000.0f), 0L);
        Assert.equals((int64) (bigY[rows + 3L] * 1000000.0f), 0L);
    }

    /**
     * 3.1.4 — a single-row grid, the serial-cutover shape: one work item,
     * one grid block, and the same answer as the full run's row 0.
     */
    @Test
    public void q4kKernelSingleRowGridMatchesTheFullGrid() {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 2L;
        int64 cols = (blocks / rows) * 256L;
        float32[] x #= QuantKernelTest.activations(cols);

        float32[] full #= heap float32[rows];
        QuantKernel.q4kMatVecIntoDevice(raw, rows, cols, x, 0L, full, 0L);

        float32[] one #= heap float32[1];
        QuantKernel.q4kMatVecIntoDevice(raw, 1L, cols, x, 0L, one, 0L);

        QuantKernelTest.assertLive(one, "single-row kernel");
        if (one[0] != full[0]) {
            Assert.fail("single-row grid " + one[0]
                + " vs full grid row 0 " + full[0]);
        }
    }

    /**
     * The q8_K INTEGER kernel against its host oracle, bit-identical.
     *
     * `Quant.q4kMatVecIntoQ8` is the reference here, NOT `q4kMatVecInto`:
     * the integer route quantizes the activations, so it does not compute
     * what the f32 route computes and holding it to that would be holding
     * it to the wrong thing. What must hold exactly is that moving the same
     * integer arithmetic into a kernel does not perturb it — and on x86 the
     * kernel now reaches `vpdpbusd` while the oracle may take a different
     * tier, which is precisely the pair worth pinning, since every tier is
     * specified to agree bit-for-bit.
     */
    @Test
    public void q4kQ8KernelIsBitIdenticalToItsIntegerOracle() {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 2L;
        int64 cols = (blocks / rows) * 256L;
        float32[] x #= QuantKernelTest.activations(cols);

        int8[] xq #= heap int8[cols];
        float32[] xd #= heap float32[cols / 256L];
        int32[] xbs #= heap int32[cols / 16L];
        Quant.q8kQuantize(x, 0L, cols, xq, xd, xbs);

        float32[] want #= heap float32[rows];
        float32[] got #= heap float32[rows];
        Quant.q4kMatVecIntoQ8(raw, rows, cols, xq, xd, xbs, want, 0L);
        QuantKernel.q4kQ8MatVecIntoDevice(raw, rows, cols, x, 0L, got, 0L);

        QuantKernelTest.assertLive(want, "integer oracle");
        QuantKernelTest.assertLive(got, "integer kernel");
        int64 r = 0;
        while (r < rows) {
            if (got[r] != want[r]) {
                Assert.fail("row " + r + ": kernel " + got[r]
                    + " vs integer oracle " + want[r]);
            }
            r = r + 1;
        }
    }

    /**
     * And it must NOT equal the f32 route — the does-not-fire half.
     *
     * The integer route's whole premise is that quantizing the activations
     * is an approximation worth 1.47x. If these two agreed exactly, either
     * the quantization is not happening or the test above is comparing
     * something to itself; both are failures that a bit-identity check
     * alone reads as success.
     */
    @Test
    public void theIntegerRouteIsCloseToButNotEqualToTheF32Route() {
        int8[] raw #= File.readAllBytes(QuantKernelTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count()
            / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 rows = 2L;
        int64 cols = (blocks / rows) * 256L;
        float32[] x #= QuantKernelTest.activations(cols);

        float32[] f32 #= heap float32[rows];
        float32[] q8 #= heap float32[rows];
        Quant.q4kMatVecInto(raw, rows, cols, x, 0L, f32, 0L);
        QuantKernel.q4kQ8MatVecIntoDevice(raw, rows, cols, x, 0L, q8, 0L);

        QuantKernelTest.assertLive(f32, "f32 route");
        QuantKernelTest.assertLive(q8, "integer route");
        boolean anyDiffer = false;
        int64 r = 0;
        while (r < rows) {
            if (q8[r] != f32[r]) { anyDiffer = true; }
            // Close, though: a 1% band on the magnitude catches a route that
            // is not merely re-rounded but wrong.
            float32 d = q8[r] - f32[r];
            if (d < 0.0f) { d = 0.0f - d; }
            float32 m = f32[r] < 0.0f ? 0.0f - f32[r] : f32[r];
            if (d > 0.01f * m + 0.001f) {
                Assert.fail("row " + r + ": integer " + q8[r]
                    + " is not close to f32 " + f32[r]);
            }
            r = r + 1;
        }
        if (!anyDiffer) {
            Assert.fail("the integer route matched the f32 route EXACTLY, "
                + "so the activation quantization did not happen");
        }
    }
}
