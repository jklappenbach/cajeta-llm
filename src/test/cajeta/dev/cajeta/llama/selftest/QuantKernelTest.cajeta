        float32[] want #= heap float32[rows * outDim];
        float32[] got #= heap float32[rows * outDim];
        WmmaKernel.compareMwInto(raw, x, rows, outDim, cols, want, got);
        QuantKernelTest.assertEpiAgreement(want, got, rows, outDim,
            "Mw deq Q4_K");
    }

    /**
     * 10.12.21 token blocking — the Mw4 kernel (FOUR token-tiles per
