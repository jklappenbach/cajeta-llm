package dev.cajeta.llama.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llama.EngineOptions;
import dev.cajeta.llama.LlamaEngine;
import dev.cajeta.llama.cli.CliArgs;
import dev.cajeta.llama.gen.SampleParams;
import dev.cajeta.llama.sched.Request;
import cajeta.lang.String;

/**
 * cajeta-llama plan Unit 19 TDD (19.1.1–19.1.7) — the CLI argument
 * mapping and the library facade, against the Unit-16 toy GGUF (which
 * carries its own tokenizer and template, so text-in/text-out runs with
 * no external file). The CLI itself is Main = parse + this same facade;
 * what needs proving is the MAPPING (every flag lands on EngineOptions /
 * SampleParams) and that the facade batches concurrent requests through
 * the ONE scheduler (11.7).
 */
public class EngineTest {

    static final String TOY = "src/test/fixtures/gguf/toy.gguf";

    public EngineTest() { return; }

    // ── 19.1.2/19.1.3/19.1.4/19.1.5 — every flag maps ───────────────────

    @Test
    public void everyFlagLandsOnItsField() {
        String[] a #= heap String[30];
        a[0] = "--model"; a[1] = "m.gguf";
        a[2] = "--prompt"; a[3] = "hi there";
        a[4] = "--ctx"; a[5] = "2048";
        a[6] = "-n"; a[7] = "17";
        a[8] = "--temp"; a[9] = "0.75";
        a[10] = "--top-k"; a[11] = "40";
        a[12] = "--top-p"; a[13] = "0.9";
        a[14] = "--seed"; a[15] = "12345";
        a[16] = "--repeat-penalty"; a[17] = "1.25";
        a[18] = "--max-seqs"; a[19] = "3";
        a[20] = "--block-size"; a[21] = "8";
        a[22] = "--chunk"; a[23] = "64";
        a[24] = "--device"; a[25] = "cpu";
        a[26] = "--kv-store"; a[27] = "tmp/engine_kv";
        a[28] = "--kv-store-size"; a[29] = "1048576";
        CliArgs c #= CliArgs.parse(a);
        Assert.equals("m.gguf", c.engine.model);
        Assert.equals("hi there", c.prompt);
        Assert.equals(2048L, (int64) c.engine.ctx);
        Assert.equals(17L, (int64) c.maxNew);
        Assert.isTrue(c.sampling.temperature > 0.74f);
        Assert.isTrue(c.sampling.temperature < 0.76f);
        Assert.equals(40L, (int64) c.sampling.topK);
        Assert.isTrue(c.sampling.topP > 0.89f);
        Assert.equals(12345L, c.sampling.seed);
        Assert.isTrue(c.sampling.repeatPenalty > 1.24f);
        Assert.equals(3L, (int64) c.engine.maxSeqs);
        Assert.equals(8L, (int64) c.engine.blockTokens);
        Assert.equals(64L, (int64) c.engine.chunk);
        Assert.equals("cpu", c.engine.device);
        Assert.equals("tmp/engine_kv", c.engine.kvStore);
        Assert.equals(1048576L, c.engine.kvStoreSize);
    }

    @Test
    public void noKvStoreWinsOverKvStore() {
        String[] a #= heap String[5];
        a[0] = "--model"; a[1] = "m.gguf";
        a[2] = "--kv-store"; a[3] = "tmp/x";
        a[4] = "--no-kv-store";
        CliArgs c #= CliArgs.parse(a);
        Assert.equals("", c.engine.kvStore);
        Assert.isTrue(c.noKvStore);
    }

    @Test
    public void missingModelAndUnknownFlagError() {
        String[] a #= heap String[2];
        a[0] = "--prompt"; a[1] = "x";
        Assert.assertThrows(() -> {
            CliArgs bad #= CliArgs.parse(a);
        });
        String[] b #= heap String[3];
        b[0] = "--model"; b[1] = "m"; b[2] = "--frobnicate";
        Assert.assertThrows(() -> {
            CliArgs bad2 #= CliArgs.parse(b);
        });
    }

    // ── 19.1.1/19.1.6 — the facade loads, generates, streams, detoks ───

    @Test
    public void engineLoadsGeneratesAndStreams() {
        EngineOptions o #= heap EngineOptions(EngineTest.TOY);
        o.ctx = 64;
        o.maxSeqs = 2;
        o.blockTokens = 4;
        o.chunk = 8;
        LlamaEngine e #= LlamaEngine.load(#o);
        CountingSink sink = heap CountingSink();
        e.setSink(sink);
        SampleParams p #= heap SampleParams(0.0f, 0L);
        int32 id = e.submitText("hello world", #p, 6);
        e.runAll(64);
        Request r = e.request(id);
        Assert.isTrue(r.isDone());
        Assert.equals(6L, (int64) r.generatedCount());
        Assert.equals(6L, (int64) sink.n);          // 8.8: one per token
        String text #= e.textOf(id);
        Assert.isTrue((int64) text.count() >= 0L);  // detok reachable (11.4)
        e.close();
    }

    // ── 19.1.7 — concurrent submissions batch through ONE scheduler ────

    @Test
    public void concurrentRequestsBatchInOneScheduler() {
        EngineOptions o #= heap EngineOptions(EngineTest.TOY);
        o.ctx = 64;
        o.maxSeqs = 2;
        o.blockTokens = 4;
        o.chunk = 8;
        LlamaEngine e #= LlamaEngine.load(#o);
        SampleParams pa #= heap SampleParams(0.0f, 0L);
        SampleParams pb #= heap SampleParams(0.0f, 0L);
        int32 ia = e.submitText("hello world", #pa, 5);
        int32 ib = e.submitText("the hello", #pb, 5);
        e.runAll(128);
        Assert.isTrue(e.request(ia).isDone());
        Assert.isTrue(e.request(ib).isDone());
        // One scheduler served both: its counters saw two admissions.
        Assert.equals(2L, (int64) e.scheduler().admittedCount());
        // And each got its own tokens (greedy on different prompts).
        Assert.equals(5L, (int64) e.request(ia).generatedCount());
        Assert.equals(5L, (int64) e.request(ib).generatedCount());
        e.close();
    }

    // ── 19.1.5 — the store flag changes nothing about the output ───────

    @Test
    public void kvStorePresenceLeavesOutputUnchanged() {
        int32[] withStore #= EngineTest.genTokens("tmp/engine_kv_a");
        int32[] without #= EngineTest.genTokens("");
        Assert.equals((int64) withStore.count(), (int64) without.count());
        int32 i = 0;
        while (i < (int32) withStore.count()) {
            Assert.equals((int64) without[i], (int64) withStore[i]);
            i = i + 1;
        }
    }

    static #int32[] genTokens(String kvStore) {
        EngineOptions o #= heap EngineOptions(EngineTest.TOY);
        o.ctx = 64;
        o.maxSeqs = 2;
        o.blockTokens = 4;
        o.chunk = 8;
        o.kvStore = "" + kvStore;
        LlamaEngine e #= LlamaEngine.load(#o);
        SampleParams p #= heap SampleParams(0.0f, 0L);
        int32 id = e.submitText("hello world", #p, 6);
        e.runAll(64);
        Request r = e.request(id);
        int32[] out #= heap int32[r.generatedCount()];
        int32 i = 0;
        while (i < r.generatedCount()) {
            out[i] = r.generatedAt(i);
            i = i + 1;
        }
        e.close();
        return #out;
    }
}

/** Counts streamed tokens (the 8.8 seam at the facade level). */
class CountingSink implements dev.cajeta.llama.gen.TokenSink {
    int32 n;

    CountingSink() {
        this.n = 0;
    }

    public void onToken(int32 reqId, int32 token) {
        this.n = this.n + 1;
        return;
    }
}
