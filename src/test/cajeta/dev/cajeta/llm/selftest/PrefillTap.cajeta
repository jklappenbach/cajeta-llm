package dev.cajeta.llm.selftest;

import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;
import cajeta.lang.String;

/** Records each diagnostic's category and name as it arrives, so a test
 *  can ask afterwards which route a launch announced. Named PrefillTap,
 *  not RouteCapture, because RouteRecordTest already defines a class by
 *  that name. */
public class PrefillTap implements DiagCallback {
    String[] cats;
    String[] names;
    public int32 n;

    public PrefillTap() {
        this.cats = heap String[512];
        this.names = heap String[512];
        this.n = 0;
    }

    public void onRecord(DiagRecord r) {
        if (this.n >= 512) { return; }
        int8[] cb #= r.category.toBytes();
        String c = heap String(#cb, r.category.byteLength());
        this.cats[this.n] #= c;
        if (r.name != null) {
            int8[] nb #= r.name.toBytes();
            String nm = heap String(#nb, r.name.byteLength());
            this.names[this.n] #= nm;
        } else {
            String lit = "-";
            int8[] db #= lit.toBytes();
            String dash = heap String(#db, lit.byteLength());
            this.names[this.n] #= dash;
        }
        this.n = this.n + 1;
        return;
    }

    public int32 countOf(String cat) {
        int32 c = 0;
        int32 i = 0;
        while (i < this.n) {
            if (this.cats[i].equals(cat)) { c = c + 1; }
            i = i + 1;
        }
        return c;
    }

    /** Some record in `cat` has exactly this name. */
    public boolean saw(String cat, String name) {
        int32 i = 0;
        while (i < this.n) {
            if (this.cats[i].equals(cat) && this.names[i].equals(name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /** Some record in `cat` has a name containing `part`. */
    public boolean sawContaining(String cat, String part) {
        int32 i = 0;
        while (i < this.n) {
            if (this.cats[i].equals(cat) && this.names[i].contains(part)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /** Some record in `cat` has a name starting with `prefix`. */
    public boolean sawStarting(String cat, String prefix) {
        int32 i = 0;
        while (i < this.n) {
            if (this.cats[i].equals(cat) && this.names[i].startsWith(prefix)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /** Every name in `cat`, bracketed, for a failure message. */
    public #String namesOf(String cat) {
        String out = "";
        int32 i = 0;
        while (i < this.n) {
            if (this.cats[i].equals(cat)) {
                out = out + "[" + this.names[i] + "]";
            }
            i = i + 1;
        }
        return #out;
    }
}
