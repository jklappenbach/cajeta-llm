package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;

/**
 * Which kernels had their OUTPUT compared against a reference.
 *
 * The census counts a launch as coverage, and a launch is not a check. On
 * 2026-09-27 kernels that lowered on cpu for the first time ran under
 * tests, registered as RAN, and answered wrong; only the tests that compared
 * their output against a host oracle noticed. A kernel that merely ran
 * proves it did not crash.
 *
 * A test that compares device output against a reference brackets the
 * computation it compares:
 *
 *     int64[] m #= ValueCheck.mark();
 *     ... launch, read back, assert against the reference ...
 *     ValueCheck.credit(m);
 *
 * `credit` is reached only when every assertion before it held, and it
 * credits every kernel that launched since `mark`, so a route that moves to
 * another kernel moves the credit with it and cannot leave a stale claim
 * behind. It credits nothing a test did not actually launch. Put `credit`
 * AFTER the last value assertion, never before it.
 *
 * KernelCensus reads `checks(name)`: a kernel that RAN with no credit is
 * RAN-UNCHECKED, which fails the suite unless it names the plan item that
 * will give it a check.
 */
public final class ValueCheck {

    /** Credits per registry index; grown when the registry grows. */
    static int64[] credits;

    public ValueCheck() { return; }

    /** Launch counts of every registered kernel, by registry index. */
    public static #int64[] mark() {
        int32 n = Device.registeredKernelCount();
        int64[] m #= heap int64[(int64) n];
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            m[(int64) i] = Device.kernelLaunchCount(name);
            i = i + 1;
        }
        return #m;
    }

    /**
     * Credit every kernel that launched since `m`, and return how many. Zero
     * is legal: a shared helper also runs on backends where the route stays
     * on the host, and the census, not this call, decides what is uncovered.
     */
    public static int32 credit(int64[] m) {
        int32 n = Device.registeredKernelCount();
        ValueCheck.ensure(n);
        int32 got = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            int64 before = 0L;
            if ((int64) i < m.count()) { before = m[(int64) i]; }
            if (Device.kernelLaunchCount(name) > before) {
                ValueCheck.credits[(int64) i] = ValueCheck.credits[(int64) i] + 1L;
                got = got + 1;
            }
            i = i + 1;
        }
        return got;
    }

    /** Checks credited to `name` in this process. */
    public static int64 checks(String name) {
        int32 n = Device.registeredKernelCount();
        ValueCheck.ensure(n);
        int32 i = 0;
        while (i < n) {
            String r #= Device.registeredKernel(i);
            if (r.equals(name)) { return ValueCheck.credits[(int64) i]; }
            i = i + 1;
        }
        return 0L;
    }

    static void ensure(int32 n) {
        if (ValueCheck.credits != null && ValueCheck.credits.count() >= (int64) n) { return; }
        int64[] grown #= heap int64[(int64) n];
        if (ValueCheck.credits != null) {
            int64 k = 0L;
            while (k < ValueCheck.credits.count()) {
                grown[k] = ValueCheck.credits[k];
                k = k + 1L;
            }
        }
        ValueCheck.credits #= grown;
        return;
    }
}
