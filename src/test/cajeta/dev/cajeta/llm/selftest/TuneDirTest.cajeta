package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.LlmEngine;
import cajeta.lang.String;
import cajeta.lang.System;

/**
 * cajeta-llm 15.2.12.2.1.1.1: tuned choices persist by default, in a per-user
 * cache keyed by device and build, so a box's first run decides and every
 * later run reproduces it. An explicit dir wins; "off" keeps no cache.
 */
public class TuneDirTest {

    public TuneDirTest() { return; }

    @Test
    public void theDefaultFollowsTheCacheHome() {
        Assert.equals("/x/cajeta-llm/tune", LlmEngine.tuneDirFrom(null, "/x", "/h", null));
        Assert.equals("/h/.cache/cajeta-llm/tune", LlmEngine.tuneDirFrom(null, null, "/h", null));
        Assert.equals("/h/.cache/cajeta-llm/tune", LlmEngine.tuneDirFrom("", "", "/h", ""));
        Assert.equals("C:/Users/p/AppData/Local/cajeta-llm/tune",
            LlmEngine.tuneDirFrom(null, null, null, "C:/Users/p/AppData/Local"));
        Assert.equals("", LlmEngine.tuneDirFrom(null, null, null, null));
    }

    @Test
    public void theEnvironmentOverrideWinsAndOffKeepsNoCache() {
        Assert.equals("/o", LlmEngine.tuneDirFrom("/o", "/x", "/h", null));
        Assert.equals("", LlmEngine.tuneDirFrom("off", "/x", "/h", null));
    }

    @Test
    public void anExplicitOptionWinsAndOffKeepsNoCache() {
        Assert.equals("/given", LlmEngine.resolveTuneDir("/given"));
        Assert.equals("", LlmEngine.resolveTuneDir("off"));
        String want #= LlmEngine.tuneDirFrom(System.env.get("CAJETA_LLM_TUNE_DIR"),
            System.env.get("XDG_CACHE_HOME"), System.env.get("HOME"), System.env.get("LOCALAPPDATA"));
        Assert.equals(want, LlmEngine.resolveTuneDir(""));
    }
}
