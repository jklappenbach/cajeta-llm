package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.ColsProbe;
import cajeta.xpu.ShapeChoice;

/**
 * cajeta-llm 15.2.12.2.1.1.2: a timed probe's verdict carries a tie margin,
 * so two kernels within the run-to-run noise do not trade places between
 * processes (a different kernel is a different accumulation order, and the
 * output differed between runs). A tie keeps the earlier variant.
 */
public class ProbeVerdictTest {

    public ProbeVerdictTest() { return; }

    @Test
    public void aClearWinnerIsTaken() {
        Assert.equals((int64) 1, (int64) QuantKernel.probeVerdict(90L, 100L, 0L - 1L));
        Assert.equals((int64) 2, (int64) QuantKernel.probeVerdict(100L, 90L, 0L - 1L));
        Assert.equals((int64) 3, (int64) QuantKernel.probeVerdict(100L, 100L, 90L));
        Assert.equals((int64) 3, (int64) QuantKernel.probeVerdict(90L, 100L, 80L));
    }

    @Test
    public void aTieKeepsTheEarlierVariant() {
        int64 m = (int64) ShapeChoice.tiePerMille;
        // prefetch inside the margin of plain: plain stays
        Assert.equals((int64) 2, (int64) QuantKernel.probeVerdict(1000L - m + 1L, 1000L, 0L - 1L));
        // exactly the margin wins
        Assert.equals((int64) 1, (int64) QuantKernel.probeVerdict(1000L - m, 1000L, 0L - 1L));
        // two-row inside the margin of the winner: the winner stays
        Assert.equals((int64) 1, (int64) QuantKernel.probeVerdict(900L, 1000L, 900L - 1L));
        Assert.equals((int64) 2, (int64) QuantKernel.probeVerdict(1000L, 1000L, 1000L - m + 1L));
        // equal times are a tie
        Assert.equals((int64) 2, (int64) QuantKernel.probeVerdict(100L, 100L, 100L));
    }

    @Test
    public void anUntimedArmNeverWins() {
        Assert.equals((int64) 2, (int64) QuantKernel.probeVerdict(0L - 1L, 100L, 0L - 1L));
        Assert.equals((int64) 2, (int64) QuantKernel.probeVerdict(0L, 100L, 0L));
    }

    @Test
    public void theColumnKernelPaysOnlyBeyondTheMargin() {
        int64 m = (int64) ShapeChoice.tiePerMille;
        Assert.isTrue(ColsProbe.colsPays(900L, 1000L));
        Assert.isTrue(ColsProbe.colsPays(1000L - m, 1000L));
        Assert.isFalse(ColsProbe.colsPays(1000L - m + 1L, 1000L));
        Assert.isFalse(ColsProbe.colsPays(1000L, 1000L));
        Assert.isFalse(ColsProbe.colsPays(1100L, 1000L));
        Assert.isFalse(ColsProbe.colsPays(0L, 1000L));
    }
}
