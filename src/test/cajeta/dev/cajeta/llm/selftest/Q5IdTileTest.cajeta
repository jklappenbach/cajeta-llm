package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.IdBatch;
import dev.cajeta.llm.io.IdShape;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.WmmaKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The Q5_K Id tile family (cajeta-llm 15.2.15.4.2): the dense Q5_K
 * tensor-core tile's design — both operands staged dequantized in shared
 * memory a half block ahead, fragments by the matrix load — over the MoE
 * chunk maps. Before it a Q5_K expert bank's prefill GEMM was the
 * multi-wave kernel, whose per-fragment global loads and shared-memory
 * round trips ran it at 536 us a gate/up launch on the 30B against the
 * dense tile's 289 us for the same weight stream (probe, 2026-10-24).
 *
 * Every listed member is held to the HOST dequantized GEMM over eight
 * ragged expert groups (5, 32, 48, 17, 128, 100, 156, 64 rows), and the
 * output rows past the batch, which a chunk's pad rows must never land
 * on, keep their sentinel.
 */
public class Q5IdTileTest {

    public Q5IdTileTest() { return; }

    static int32 E = 8;
    static int32 ROWS_E = 128;
    static int32 COLS = 512;
    static int32 NP = 550;

    static int32 gOff(int32 e) { return MoeIdMw8Test.gOff(e); }

    static boolean skip() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return true; }
        if (be.equals("vulkan")) { DeviceSkip.noRoute("packed WMMA id route", be); return true; }
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return true; }
        return false;
    }

    /** The Q5_K expert slab's bytes: expert-major, row-major, 176 bytes a
     *  block, finite half scales; the host oracle decodes the same bytes. */
    static #int8[] q5kSlabBytes() {
        int32 rowBytes = (Q5IdTileTest.COLS / 256) * 176;
        int64 total = (int64) Q5IdTileTest.E * (int64) Q5IdTileTest.ROWS_E * (int64) rowBytes;
        int8[] raw #= heap int8[total];
        int64 i = 0;
        while (i < total) {
            int64 blk = i / 176L;
            int64 off = i % 176L;
            if (off == 1L) {
                raw[i] = (int8) 44;
            } else if (off == 3L) {
                raw[i] = (int8) 40;
            } else if (off == 0L || off == 2L) {
                raw[i] = (int8) ((blk * 37L + off * 11L) % 256L);
            } else {
                raw[i] = (int8) ((i * 131L + 17L) % 256L);
            }
            i = i + 1;
        }
        return #raw;
    }

    /** y[t, r] = W_e[r, :] . x[t, :] over the dequantized Q5_K rows of the
     *  expert whose group holds token t; pad rows are not in it. */
    static #float32[] hostIdGemm(int8[] slab, float32[] xv) {
        int64 cols = (int64) Q5IdTileTest.COLS;
        int64 rows = (int64) Q5IdTileTest.ROWS_E;
        int64 bpr = cols / 256L;
        int64 rowBytes = bpr * 176L;
        int64 np = (int64) Q5IdTileTest.NP;
        float32[] want #= heap float32[np * rows];
        float32[] w #= heap float32[rows * cols];
        int32 e = 0;
        while (e < Q5IdTileTest.E) {
            int64 r = 0;
            while (r < rows) {
                int64 ro = ((int64) e * rows + r) * rowBytes;
                Quant.dequantize(Quant.GG_Q5_K, slab, ro, bpr, w, r * cols);
                r = r + 1;
            }
            int64 t = (int64) Q5IdTileTest.gOff(e);
            int64 tEnd = (int64) Q5IdTileTest.gOff(e + 1);
            while (t < tEnd) {
                r = 0;
                while (r < rows) {
                    float64 acc = 0.0;
                    int64 c = 0;
                    while (c < cols) {
                        acc = acc + (float64) w[r * cols + c] * (float64) xv[t * cols + c];
                        c = c + 1;
                    }
                    want[t * rows + r] = (float32) acc;
                    r = r + 1;
                }
                t = t + 1;
            }
            e = e + 1;
        }
        return #want;
    }

    /** One map entry per `stride`-row chunk of each group. */
    static int32 buildMaps(int32 stride, int32[] mE, int32[] mT0, int32[] mM1) {
        int32 nT = 0;
        int32 e = 0;
        while (e < Q5IdTileTest.E) {
            int32 g0 = Q5IdTileTest.gOff(e);
            int32 m = Q5IdTileTest.gOff(e + 1) - g0;
            int32 tw = 0;
            while (tw * stride < m) {
                mE[nT] = e;
                mT0[nT] = g0 + tw * stride;
                mM1[nT] = g0 + m;
                nT = nT + 1;
                tw = tw + 1;
            }
            e = e + 1;
        }
        return nT;
    }

    /** The batch as the family reads it: both chunk maps and their counts. */
    static #IdBatch batch(KernelBuffer<int8> xp, KernelBuffer<int32> e64, KernelBuffer<int32> t64,
            KernelBuffer<int32> m64, KernelBuffer<int32> e128, KernelBuffer<int32> t128,
            KernelBuffer<int32> m128, KernelBuffer<int32> meta, int32 n64, int32 n128) {
        int32 cap = Q5IdTileTest.NP / 64 + Q5IdTileTest.E + 1;
        int32[] mE = heap int32[cap];
        int32[] mT0 = heap int32[cap];
        int32[] mM1 = heap int32[cap];
        int32 c64 = Q5IdTileTest.buildMaps(64, mE, mT0, mM1);
        e64.upload(mE, (int64) c64);
        t64.upload(mT0, (int64) c64);
        m64.upload(mM1, (int64) c64);
        int32 c128 = Q5IdTileTest.buildMaps(128, mE, mT0, mM1);
        e128.upload(mE, (int64) c128);
        t128.upload(mT0, (int64) c128);
        m128.upload(mM1, (int64) c128);
        int32[] metaH = heap int32[4];
        metaH[0] = c64;
        metaH[1] = c128;
        meta.upload(metaH, 4L);
        IdBatch b #= heap IdBatch(xp, e64, t64, m64, e128, t128, m128, meta,
            (int64) c64, (int64) c128, (int64) Q5IdTileTest.NP, (int64) Q5IdTileTest.E);
        return #b;
    }

    @Test
    public void everyListedQ5IdMemberMatchesTheHost() {
        if (Q5IdTileTest.skip()) { return; }
        int32 n = (int32) WmmaKernel.id5Family().shapes().count();
        Assert.isTrue(n >= 2);
        int8[] raw #= Q5IdTileTest.q5kSlabBytes();
        float32[] xv #= MoeIdMw8Test.acts();
        float32[] want #= Q5IdTileTest.hostIdGemm(raw, xv);
        int64 total = (int64) raw.count();
        KernelBuffer<int8> slab #= heap KernelBuffer<int8>((uint64) (total + 4L));
        slab.upload(raw, total);
        KernelBuffer<int32> slabW #= slab.wordView();
        KernelBuffer<int8> xp #= MoeIdMw8Test.packActs();
        int32 cap = Q5IdTileTest.NP / 64 + Q5IdTileTest.E + 1;
        KernelBuffer<int32> e64 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> t64 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> m64 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> e128 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> t128 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> m128 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> meta #= heap KernelBuffer<int32>((uint64) 4);
        IdBatch b #= Q5IdTileTest.batch(xp, e64, t64, m64, e128, t128, m128, meta, 0, 0);
        int64 outDim = (int64) Q5IdTileTest.ROWS_E;
        int64 nOut = (int64) Q5IdTileTest.NP * outDim;
        int64 nAll = ((int64) Q5IdTileTest.NP + 128L) * outDim;
        float32[] sent = heap float32[nAll];
        float32[] got = heap float32[nAll];
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) nAll);
        int32 checked = 0;
        int32 i = 0;
        while (i < n) {
            IdShape sh = WmmaKernel.id5Family().shapes().get(i);
            String name #= sh.kernel();
            if (!KernelCap.usable(name)) {
                System.stdout.println("   " + name + " has no device code here");
                i = i + 1;
                continue;
            }
            int64 k = 0;
            while (k < nAll) { sent[k] = -7.0f; k = k + 1; }
            y.upload(sent, nAll);
            int64[] vc #= ValueCheck.mark();
            sh.launch(y, slab, slabW, b, outDim, (int64) Q5IdTileTest.COLS, outDim);
            QuantKernel.stream().sync();
            y.download(got, nAll);
            CensusReachTest.nearOnePercent(want, got, nOut,
                name + " vs the host Q5_K id GEMM at " + Q5IdTileTest.NP + " tokens");
            k = nOut;
            while (k < nAll) {
                if (got[k] != -7.0f) {
                    Assert.fail(name + " wrote pad row " + (k / outDim) + " (token count "
                        + Q5IdTileTest.NP + "): a chunk's rows past its group landed");
                    return;
                }
                k = k + 1;
            }
            ValueCheck.credit(vc);
            checked = checked + 1;
            i = i + 1;
        }
        if (checked == 0) {
            DeviceSkip.noKernel("Q5IdTile members", Device.activeBackend());
        }
    }

    /** The family serves the 30B's gate/up bank at a 512-token prefill
     *  (4096 expert rows, 768 out, 2048 cols) wherever a member lowers,
     *  and names its 64- and 128-row members over the two chunk maps. */
    @Test
    public void theQ5IdFamilyServesTheThirtyBShape() {
        if (Q5IdTileTest.skip()) { return; }
        int32 n = (int32) WmmaKernel.id5Family().shapes().count();
        boolean saw64 = false;
        boolean saw128 = false;
        boolean any = false;
        int32 i = 0;
        while (i < n) {
            IdShape sh = WmmaKernel.id5Family().shapes().get(i);
            if (sh.chunkRows() == 64) { saw64 = true; }
            if (sh.chunkRows() == 128) { saw128 = true; }
            String name #= sh.kernel();
            if (KernelCap.usable(name)) { any = true; }
            Assert.isTrue(sh.fits(4096L, 768L, 2048L));
            i = i + 1;
        }
        Assert.isTrue(saw64);
        Assert.isTrue(saw128);
        if (!any) { DeviceSkip.noKernel("Q5IdTile members", Device.activeBackend()); return; }
        Assert.isTrue(WmmaKernel.id5FamilyServes(4096L, 768L, 2048L));
        // An outDim off the 64 grid is nobody's.
        Assert.isFalse(WmmaKernel.id5FamilyServes(4096L, 800L, 2048L));
    }
}
