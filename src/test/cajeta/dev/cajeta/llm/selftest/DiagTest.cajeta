package dev.cajeta.llm.selftest;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.DiagSink;

/**
 * The engine's diagnostics must be SILENT unless an embedder asks for
 * them (Julian 2026-08-27: stderr reads as an error channel and alarms;
 * in a combined console it is noise).
 *
 * The important arm is the negative one. "Nothing was written" is the
 * behaviour that regresses invisibly — a stray print added later still
 * passes every functional test in the suite, and only shows up as a
 * complaint about console noise weeks afterwards. So `on()` is asserted
 * false at rest, and a sink installed afterwards is asserted to receive
 * nothing from the quiet period.
 */
public class DiagTest {

    /** Records what the engine emitted, so the test can assert on it. */
    static class Capture implements DiagSink {
        public ArrayList<String> lines;
        public Capture() {
            this.lines = heap ArrayList<String>();
        }
        public void line(String message) {
            int8[] b #= message.toBytes();
            String cp = heap String(#b, message.byteLength());
            this.lines.add(#cp);
            return;
        }
    }

    public DiagTest() { return; }

    /** DEFAULT: nothing is listening, and `say` writes nowhere. */
    @Test
    public void diagnosticsAreOffByDefault() {
        Diag.setSink(null);
        Assert.isFalse(Diag.on());
        // Must not throw, must not print: the no-sink path is the one
        // every embedder runs.
        Diag.say("this line must go nowhere");
        Assert.isFalse(Diag.on());
    }

    /** Installed: the embedder gets exactly what the engine emitted. */
    @Test
    public void anInstalledSinkReceivesTheLines() {
        Capture cap = heap Capture();
        Diag.setSink(cap);
        Assert.isTrue(Diag.on());
        Diag.say("batch-route: test out=1 in=2");
        Assert.equals(1L, (int64) cap.lines.count());
        Assert.equals("batch-route: test out=1 in=2", cap.lines.get(0));
        Diag.setSink(null);
        Assert.isFalse(Diag.on());
    }

    /** Removing the sink stops delivery — an embedder can turn it back
     *  off, and the quiet period really is quiet. */
    @Test
    public void clearingTheSinkStopsDelivery() {
        Capture cap = heap Capture();
        Diag.setSink(cap);
        Diag.say("first");
        Diag.setSink(null);
        Diag.say("second must not arrive");
        Assert.equals(1L, (int64) cap.lines.count());
        Assert.equals("first", cap.lines.get(0));
    }
}
