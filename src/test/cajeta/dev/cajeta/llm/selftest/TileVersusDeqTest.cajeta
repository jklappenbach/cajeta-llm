package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Linear;
import cajeta.math.Tensor;
import cajeta.xpu.Device;

/** cajeta-llm 15.2.16.2: under the auto policy the in-tile GEMM is routed only where it beats the int8 GEMM. */
public class TileVersusDeqTest {

    public TileVersusDeqTest() { return; }

    static final int32 ROWS = 256;

    /** Whether both arms can run here; skips by name when not. */
    static boolean bothArms() {
        if (!TcTileTest.matrixCoresHere("QkTile_64_64_32_32_128_q4kQ8")) { return false; }
        if (!Linear.q4TileUsable()) {
            DeviceSkip.tracked("backend " + Device.activeBackend()
                + " has no usable Q4_K tile member", "cajeta-llm 15.2.16.2.3");
            return false;
        }
        return true;
    }

    /** The batch route a Q4_K projection takes under auto with the tile-versus-int8 verdict pinned to `v`. */
    static #String routeUnderAuto(int32 v) {
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_Q4_K, "q4_k.bin");
        Tensor<float32> x #= LinearKernelRouteTest.ramp(
            (int64) ROWS * (int64) LinearKernelRouteTest.CI, 0L);
        Tensor<float32> y #= LinearKernelRouteTest.ramp(0L,
            (int64) ROWS * (int64) LinearKernelRouteTest.CO);
        QuantKernel.setRoutingEnabled(true);
        boolean tcWas = Linear.tcEnabled();
        boolean autoWas = Linear.deqAutoOn();
        Linear.setTc(true);
        Linear.setMatrixCoresPay(1);
        Linear.setDeqAuto(true);
        Linear.setTileBeatsDeq(v);
        Linear.stageBatch(x, 0L, ROWS, LinearKernelRouteTest.CI, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap tap = heap PrefillTap();
        Diag.register(tap);
        lin.matmulInto(ROWS, y, 0L);
        Diag.register(null);
        Linear.setTileBeatsDeq(0);
        Linear.setDeqAuto(autoWas);
        Linear.setMatrixCoresPay(0);
        Linear.setTc(tcWas);
        return tap.namesOf("batch-route");
    }

    /** FIRES: where the tile is measured faster, auto routes Q4_K to it. */
    @Test
    public void autoTakesTheTileWhereItIsFaster() {
        if (!TileVersusDeqTest.bothArms()) { return; }
        String r #= TileVersusDeqTest.routeUnderAuto(1);
        if (r.indexOf("[q4 tcTile]") < 0L) { Assert.fail("auto with the tile faster routed " + r); }
    }

    /** DOES NOT FIRE: where the int8 GEMM is measured faster, auto keeps it. */
    @Test
    public void autoKeepsTheInt8GemmWhereItIsFaster() {
        if (!TileVersusDeqTest.bothArms()) { return; }
        String r #= TileVersusDeqTest.routeUnderAuto(2);
        if (r.indexOf("[q4 tcTile]") >= 0L || r.indexOf("[q4 deq") < 0L) {
            Assert.fail("auto with the int8 GEMM faster routed " + r);
        }
    }

    /** The probe times both arms at the engine's chunk and records each. */
    @Test
    public void theProbeTimesBothArms() {
        if (!TileVersusDeqTest.bothArms()) { return; }
        Linear.setTileBeatsDeq(0);
        boolean v = Linear.tileBeatsDeq();
        Assert.isTrue(Linear.tileProbeTileNs() > 0L);
        Assert.isTrue(Linear.tileProbeDeqNs() > 0L);
        Assert.isTrue(v == (Linear.tileProbeTileNs() < Linear.tileProbeDeqNs()));
        Linear.setTileBeatsDeq(0);
    }
}
