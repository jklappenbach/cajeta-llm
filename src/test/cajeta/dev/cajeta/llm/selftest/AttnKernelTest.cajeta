    /** llm-cpu-parity 4.3.1.2: on cpu, GQA-4 hd-128 prefill takes attnPrefillCpuGqa4Kernel and matches the host floor
     *  at one row, a short chunk and a ragged long one, with and without history before the chunk. */
    @Test
    public void theCpuPrefillAttendMatchesTheHostAtHd128() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the cpu prefill attend is the cpu backend's"); return; }
        int32 nH = 8;
        int32 nKv = 2;
        int32 hd = 128;
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        int32[] rowsAt = [1, 9, 130];
        int32[] spAt = [0, 10, 300];
        int64[] vc #= ValueCheck.mark();
        int64 n0 = AttnKernel.cpuPrefillCalls();
        int32 ri = 0;
        while (ri < 3) {
            int32 si = 0;
            while (si < 3) {
                int32 rows = rowsAt[ri];
                int32 sp = spAt[si];
                int32 tMax = sp + rows;
                int64 kvDim = (int64) (nKv * hd);
                int64 qn = (int64) rows * (int64) (nH * hd);
                float32[] q #= AttnKernelTest.spread(qn, 101 + sp + rows);
                float32[] k #= AttnKernelTest.spread((int64) tMax * kvDim, 103);
                float32[] v #= AttnKernelTest.spread((int64) tMax * kvDim, 107);
                AttnKernel.roundHalf(k);
                AttnKernel.roundHalf(v);
                float32[] want #= heap float32[qn];
                AttnKernel.attendPrefillHost(want, q, k, v, rows, nH, nKv, hd, sp, scale);
                float32[] got #= heap float32[qn];
                AttnKernel.attendPrefillInto(got, q, k, v, rows, nH, nKv, hd, sp, scale);
                String what #= "cpu prefill attend rows " + rows + " sp " + sp;
                AttnKernelTest.assertLive(got, what);
                AttnKernelTest.assertClose(want, got, what);
                si = si + 1;
            }
            ri = ri + 1;
        }
        ValueCheck.credit(vc);
        if (AttnKernel.cpuPrefillCalls() - n0 != 9L) {
            Assert.fail("9 prefill attends ran " + (AttnKernel.cpuPrefillCalls() - n0) + " cpu kernel launches");
        }
    }

    /** llm-cpu-parity 4.3.1.6: on cpu, GQA-4 hd-128 decode takes attnDecodeCpuGqa4Kernel and matches the host floor
     *  from one position to a 513-position context. */
    @Test
    public void theCpuDecodeAttendMatchesTheHostFloor() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the cpu decode attend is the cpu backend's"); return; }
        int32 nH = 8;
        int32 nKv = 2;
        int32 hd = 128;
        int64 kvDim = (int64) (nKv * hd);
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        int32[] counts = [1, 3, 16, 100, 513];
        int64 before = AttnKernel.cpuDecodeCallCount();
        int64[] vc #= ValueCheck.mark();
        int32 ci = 0;
        while (ci < 5) {
            int32 count = counts[ci];
            float32[] q #= AttnKernelTest.spread((int64) (nH * hd), 13 + ci);
            float32[] k #= AttnKernelTest.spread((int64) count * kvDim, 15 + ci);
            float32[] v #= AttnKernelTest.spread((int64) count * kvDim, 19 + ci);
            AttnKernel.roundHalf(k);
            AttnKernel.roundHalf(v);
            float32[] want #= heap float32[(int64) (nH * hd)];
            AttnKernel.attendDecodeHost(want, q, k, v, nH, nKv, hd, count, scale);
            float32[] got #= heap float32[(int64) (nH * hd)];
            AttnKernel.attendDecodeInto(got, q, k, v, nH, nKv, hd, count, scale);
            String what #= "cpu decode attend count " + count;
            AttnKernelTest.assertLive(got, what);
            AttnKernelTest.assertClose(want, got, what);
            ci = ci + 1;
        }
        ValueCheck.credit(vc);
        if (AttnKernel.cpuDecodeCallCount() - before != 5L) {
            Assert.fail("5 decode attends ran " + (AttnKernel.cpuDecodeCallCount() - before) + " cpu kernel launches");
        }
    }
}
