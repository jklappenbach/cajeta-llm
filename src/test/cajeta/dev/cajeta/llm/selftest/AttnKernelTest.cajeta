    // ── Unit 6: the prefill kernels the default flags never reach ────────
    //
    // With the flash attend on (the default) the V2 score/combine pair and
    // the wave-per-position score kernel are registered and never launched,
    // so nothing checked them against the host. Each is a route the flags
    // can still select (`noattnv2`, `oldscore`), so each gets the floor.

    @Test
    public void theV2PrefillPairMatchesTheHostAtHd128WhenFlashIsOff() {
        boolean cpuWas = AttnKernel.cpuPrefillAttendOn();
        AttnKernel.setCpuPrefillAttend(false);
