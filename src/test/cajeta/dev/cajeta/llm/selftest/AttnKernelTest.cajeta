        int32 count = 129;
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        int64 kvDim = (int64) (nKv * hd);
        float32[] q #= AttnKernelTest.spread((int64) (nH * hd), 51);
        float32[] k #= AttnKernelTest.spread((int64) count * kvDim, 57);
        float32[] v #= AttnKernelTest.spread((int64) count * kvDim, 61);
        float32[] fused #= heap float32[(int64) (nH * hd)];
        AttnKernel.attendDecodeInto(fused, q, k, v, nH, nKv, hd, count,
            scale);
        AttnKernel.setFlashDecode(false);
        float32[] pair #= heap float32[(int64) (nH * hd)];
        AttnKernel.attendDecodeInto(pair, q, k, v, nH, nKv, hd, count,
            scale);
        AttnKernel.setFlashDecode(true);
        AttnKernelTest.assertLive(fused, "gqa1 fused decode");
        AttnKernelTest.assertLive(pair, "gqa1 two-kernel decode");
        AttnKernelTest.assertClose(pair, fused, "gqa1 fused vs two-kernel");
    }

    /** One tile-kernel case against the host floor and the wave-per-
     *  query kernel, at head dim 128. */
    static void tileCase(int32 rows, int32 nH, int32 nKv, int32 startPos,
            int32 seed, String what) {
        int32 hd = 128;
        int32 tMax = startPos + rows;
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        int64 kvDim = (int64) (nKv * hd);
        int64 qn = (int64) rows * (int64) (nH * hd);
        float32[] q #= AttnKernelTest.spread(qn, seed);
        float32[] k #= AttnKernelTest.spread((int64) tMax * kvDim, seed + 2);
        float32[] v #= AttnKernelTest.spread((int64) tMax * kvDim, seed + 4);
        AttnKernel.roundHalf(k);
        AttnKernel.roundHalf(v);
        float32[] want #= heap float32[qn];
        AttnKernel.attendPrefillHost(want, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        boolean tileWas = AttnKernel.prefillTileOn();
        boolean onlineWas = AttnKernel.prefillOnlineOn();
        // The online tile sits ahead of this one on the route (1.8.3).
        AttnKernel.setPrefillOnline(false);
        int64[] vc #= ValueCheck.mark();
        int32 paysWas = AttnKernel.prefillTilePaysState();
        AttnKernel.setPrefillTilePays(1);
        AttnKernel.setPrefillTile(true);
        float32[] got #= heap float32[qn];
        AttnKernel.attendPrefillInto(got, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        AttnKernel.setPrefillTilePays(paysWas);
        AttnKernel.setPrefillTile(false);
        float32[] ref #= heap float32[qn];
        AttnKernel.attendPrefillInto(ref, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        AttnKernel.setPrefillTile(tileWas);
        AttnKernel.setPrefillOnline(onlineWas);
        AttnKernelTest.assertLive(got, what);
        AttnKernelTest.assertClose(want, got, what + " vs host");
        AttnKernelTest.assertClose(ref, got, what + " vs wave kernel");
        ValueCheck.credit(vc);
    }

    /** The single-pass online tile (1.8.3) at the same shapes, to the
     *  same floor: ONE pass over the keys with the running max, the query
     *  residual kept, the probabilities in plain f16. FIRES: the kernel is
     *  the one launched (its count moves); the two-pass tile and the wave
     *  kernel stay the references. */
    static void onlineCase(int32 rows, int32 nH, int32 nKv, int32 startPos,
            int32 seed, String what) {
        int32 hd = 128;
        int32 tMax = startPos + rows;
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        int64 kvDim = (int64) (nKv * hd);
        int64 qn = (int64) rows * (int64) (nH * hd);
        float32[] q #= AttnKernelTest.spread(qn, seed);
        float32[] k #= AttnKernelTest.spread((int64) tMax * kvDim, seed + 2);
        float32[] v #= AttnKernelTest.spread((int64) tMax * kvDim, seed + 4);
        AttnKernel.roundHalf(k);
        AttnKernel.roundHalf(v);
        float32[] want #= heap float32[qn];
        AttnKernel.attendPrefillHost(want, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        boolean onlineWas = AttnKernel.prefillOnlineOn();
        boolean tileWas = AttnKernel.prefillTileOn();
        boolean f16Was = AttnKernel.prefillF16On();
        AttnKernel.setPrefillF16(false);
        int64[] vc #= ValueCheck.mark();
        int64 before = Device.kernelLaunchCount("attnFlashPrefillOnlineKernel");
        int32 paysWas = AttnKernel.prefillTilePaysState();
        AttnKernel.setPrefillTilePays(1);
        AttnKernel.setPrefillOnline(true);
        AttnKernel.setPrefillTile(true);
        float32[] got #= heap float32[qn];
        AttnKernel.attendPrefillInto(got, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        int64 after = Device.kernelLaunchCount("attnFlashPrefillOnlineKernel");
        AttnKernel.setPrefillTilePays(paysWas);
        AttnKernel.setPrefillOnline(false);
        float32[] ref #= heap float32[qn];
        AttnKernel.attendPrefillInto(ref, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        AttnKernel.setPrefillOnline(onlineWas);
        AttnKernel.setPrefillTile(tileWas);
        AttnKernel.setPrefillF16(f16Was);
        if (after <= before) {
            Assert.fail(what + ": the online kernel was not launched");
            return;
        }
        AttnKernelTest.assertLive(got, what);
        AttnKernelTest.assertClose(want, got, what + " vs host");
        AttnKernelTest.assertClose(ref, got, what + " vs two-pass tile");
        ValueCheck.credit(vc);
    }

    @Test
    public void thePrefillOnlineTileAgreesWithTheHostFloor() {
        boolean cpuWas = AttnKernel.cpuPrefillAttendOn();
        AttnKernel.setCpuPrefillAttend(false);
        try { this.thePrefillOnlineTileAgreesWithTheHostFloorBody(); } finally { AttnKernel.setCpuPrefillAttend(cpuWas); }
    }

    /** thePrefillOnlineTileAgreesWithTheHostFloor with the cpu prefill attend off, so the route it names is the one taken. */
    void thePrefillOnlineTileAgreesWithTheHostFloorBody() {
        AttnKernelTest.need("attnFlashPrefillOnlineKernel");
        AttnKernelTest.need("attnFlashPrefillTileKernel");
        AttnKernelTest.onlineCase(5, 16, 16, 0, 81, "online gqa1 5@0");
        AttnKernelTest.onlineCase(64, 16, 16, 0, 85, "online gqa1 64@0");
        AttnKernelTest.onlineCase(65, 16, 16, 0, 87, "online gqa1 65@0");
        AttnKernelTest.onlineCase(128, 16, 16, 0, 89, "online gqa1 128@0");
        AttnKernelTest.onlineCase(512, 16, 16, 0, 71, "online gqa1 512@0");
        AttnKernelTest.onlineCase(100, 16, 16, 1948, 73, "online gqa1 100@1948");
        AttnKernelTest.onlineCase(512, 32, 8, 0, 75, "online gqa4 512@0");
        AttnKernelTest.onlineCase(77, 32, 8, 1971, 77, "online gqa4 77@1971");
        AttnKernelTest.onlineCase(64, 32, 4, 448, 79, "online gqa8 64@448");
        AttnKernelTest.onlineCase(130, 32, 8, 0, 83, "online gqa4 130@0");
    }

    /** The f16 online prefill against the host floor, at llama.cpp's
     *  precision: the query and the probabilities round to f16 once (no
     *  residual pair). Measured on sm_89 at these shapes, the worst element
     *  sits 0.0004 off the floor (the residual kernel holds 0.1% + 0.0002);
     *  the bound is 0.2% of the element plus 0.0008, twice that. */
    static void f16Case(int32 rows, int32 nH, int32 nKv, int32 startPos,
            int32 seed, String what) {
        int32 hd = 128;
        int32 tMax = startPos + rows;
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        int64 kvDim = (int64) (nKv * hd);
        int64 qn = (int64) rows * (int64) (nH * hd);
        float32[] q #= AttnKernelTest.spread(qn, seed);
        float32[] k #= AttnKernelTest.spread((int64) tMax * kvDim, seed + 2);
        float32[] v #= AttnKernelTest.spread((int64) tMax * kvDim, seed + 4);
        AttnKernel.roundHalf(k);
        AttnKernel.roundHalf(v);
        float32[] want #= heap float32[qn];
        AttnKernel.attendPrefillHost(want, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        boolean onlineWas = AttnKernel.prefillOnlineOn();
        boolean tileWas = AttnKernel.prefillTileOn();
        boolean f16Was = AttnKernel.prefillF16On();
        int64[] vc #= ValueCheck.mark();
        int64 before = Device.kernelLaunchCount("attnFlashPrefillF16Kernel");
        int32 paysWas = AttnKernel.prefillTilePaysState();
        AttnKernel.setPrefillTilePays(1);
        AttnKernel.setPrefillOnline(true);
        AttnKernel.setPrefillTile(true);
        AttnKernel.setPrefillF16(true);
        float32[] got #= heap float32[qn];
        AttnKernel.attendPrefillInto(got, q, k, v, rows, nH, nKv, hd,
            startPos, scale);
        int64 after = Device.kernelLaunchCount("attnFlashPrefillF16Kernel");
        AttnKernel.setPrefillTilePays(paysWas);
        AttnKernel.setPrefillOnline(onlineWas);
        AttnKernel.setPrefillTile(tileWas);
        AttnKernel.setPrefillF16(f16Was);
        if (after <= before) {
            Assert.fail(what + ": the f16 kernel was not launched");
            return;
        }
        AttnKernelTest.assertLive(got, what);
        float32 worst = 0.0f;
        int64 i = 0;
        while (i < qn) {
            float32 d = want[i] - got[i];
            if (d < 0.0f) { d = 0.0f - d; }
            float32 mag = want[i] < 0.0f ? 0.0f - want[i] : want[i];
            float32 excess = d - (mag * 0.002f + 0.0008f);
            if (excess > 0.0f) {
                Assert.fail(what + " at " + i + ": device " + got[i]
                    + " vs host " + want[i] + " - past f16 rounding");
                return;
            }
            if (d > worst) { worst = d; }
            i = i + 1;
        }
        System.stdout.println("  " + what + ": worst |device - host| " + worst);
        ValueCheck.credit(vc);
    }

    /** The f16 kernel is the online route on its own: on gfx1151 the
     *  88 KB online kernel does not lower and the 45 KB f16 kernel does,
     *  and the route must not wait on the kernel it replaces. */
    @Test
    public void theF16TileServesWhereTheOnlineKernelDoesNot() {
        boolean cpuWas = AttnKernel.cpuPrefillAttendOn();
        AttnKernel.setCpuPrefillAttend(false);
        try { this.theF16TileServesWhereTheOnlineKernelDoesNotBody(); } finally { AttnKernel.setCpuPrefillAttend(cpuWas); }
    }

    /** theF16TileServesWhereTheOnlineKernelDoesNot with the cpu prefill attend off, so the route it names is the one taken. */
    void theF16TileServesWhereTheOnlineKernelDoesNotBody() {
        AttnKernelTest.need("attnFlashPrefillF16Kernel");
        int32 paysWas = AttnKernel.prefillTilePaysState();
        boolean onlineWas = AttnKernel.prefillOnlineOn();
        boolean tileWas = AttnKernel.prefillTileOn();
        boolean f16Was = AttnKernel.prefillF16On();
        AttnKernel.setPrefillTilePays(1);
        AttnKernel.setPrefillOnline(true);
        AttnKernel.setPrefillTile(true);
        AttnKernel.setPrefillF16(true);
        KernelCap.setOverride(KernelCap.K_FLASH_PREFILL_ONLINE, false);
        boolean served = AttnKernel.prefillOnlineServes(32, 8, 128);
        KernelCap.setOverride(KernelCap.K_FLASH_PREFILL_F16, false);
        boolean neither = AttnKernel.prefillOnlineServes(32, 8, 128);
        KernelCap.clearOverrides();
        AttnKernel.setPrefillTilePays(paysWas);
        AttnKernel.setPrefillOnline(onlineWas);
        AttnKernel.setPrefillTile(tileWas);
        AttnKernel.setPrefillF16(f16Was);
        if (!served) {
            Assert.fail("the online route does not serve on the f16 kernel alone");
            return;
        }
        if (neither) {
            Assert.fail("the online route serves with neither kernel");
            return;
        }
        KernelCap.setOverride(KernelCap.K_FLASH_PREFILL_ONLINE, false);
        AttnKernelTest.f16Case(130, 32, 8, 0, 91, "f16 without online 130@0");
        KernelCap.clearOverrides();
    }

