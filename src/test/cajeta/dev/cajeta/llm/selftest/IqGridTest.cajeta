package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.IqGrid;

/**
 * The ggml codebook tables (codebook-quants spec §4.1): every table in
 * `IqGrid` checksums to what `tmp/cbq/grids.c` printed from
 * ggml-common.h, its values are the alphabet the format promises, and
 * the packed forms are the byte tables repacked.
 */
public class IqGridTest {

    public IqGridTest() { return; }

    /** The generator's two position-weighted sums over the bytes. */
    static void check(String name, int8[] b, int64 want1, int64 want2) {
        int64 h1 = 7L;
        int64 h2 = 11L;
        int64 i = 0;
        while (i < (int64) b.count()) {
            int64 v = (int64) b[i] & 255L;
            h1 = (h1 * 1000003L + v + i) % 2147483647L;
            h2 = (h2 * 1000003L + v + i) % 2147483629L;
            i = i + 1;
        }
        if (h1 != want1 || h2 != want2) {
            Assert.fail(name + ": checksum " + h1 + " " + h2 + ", generator "
                + want1 + " " + want2);
        }
        return;
    }

    static #int8[] bytesOf64(int64[] t) {
        int8[] b #= heap int8[(int64) t.count() * 8L];
        int64 i = 0;
        while (i < (int64) t.count()) {
            int32 k = 0;
            while (k < 8) {
                b[i * 8L + (int64) k] = (int8) ((t[i] >> (8 * k)) & 255L);
                k = k + 1;
            }
            i = i + 1;
        }
        return #b;
    }

    static #int8[] bytesOf32(int32[] t) {
        int8[] b #= heap int8[(int64) t.count() * 4L];
        int64 i = 0;
        while (i < (int64) t.count()) {
            int32 k = 0;
            while (k < 4) {
                b[i * 4L + (int64) k] = (int8) ((t[i] >> (8 * k)) & 255);
                k = k + 1;
            }
            i = i + 1;
        }
        return #b;
    }

    static #int8[] bytesOf8(int32[] t) {
        int8[] b #= heap int8[(int64) t.count()];
        int64 i = 0;
        while (i < (int64) t.count()) {
            b[i] = (int8) t[i];
            i = i + 1;
        }
        return #b;
    }

    @Test
    public void everyTableChecksumsToTheGeneratorsValue() {
        Assert.equals(8L, (int64) IqGrid.kmask().count());
        Assert.equals(128L, (int64) IqGrid.ksigns().count());
        Assert.equals(256L, (int64) IqGrid.iq2xxs().count());
        Assert.equals(512L, (int64) IqGrid.iq2xs().count());
        Assert.equals(1024L, (int64) IqGrid.iq2s().count());
        Assert.equals(256L, (int64) IqGrid.iq3xxs().count());
        Assert.equals(512L, (int64) IqGrid.iq3s().count());
        Assert.equals(2048L, (int64) IqGrid.iq1s().count());
        Assert.equals(2048L, (int64) IqGrid.iq1sNibble().count());
        int8[] b0 #= IqGridTest.bytesOf8(IqGrid.kmask());
        IqGridTest.check("KMASK", b0, 2141516443L, 416302020L);
        int8[] b1 #= IqGridTest.bytesOf8(IqGrid.ksigns());
        IqGridTest.check("KSIGNS", b1, 930407700L, 245138894L);
        int8[] b2 #= IqGridTest.bytesOf64(IqGrid.iq2xxs());
        IqGridTest.check("IQ2XXS", b2, 1330938987L, 170904465L);
        int8[] b3 #= IqGridTest.bytesOf64(IqGrid.iq2xs());
        IqGridTest.check("IQ2XS", b3, 758708454L, 1244841055L);
        int8[] b4 #= IqGridTest.bytesOf64(IqGrid.iq2s());
        IqGridTest.check("IQ2S", b4, 1753173569L, 2036491575L);
        int8[] b5 #= IqGridTest.bytesOf32(IqGrid.iq3xxs());
        IqGridTest.check("IQ3XXS", b5, 1761255505L, 709255127L);
        int8[] b6 #= IqGridTest.bytesOf32(IqGrid.iq3s());
        IqGridTest.check("IQ3S", b6, 1360299370L, 1488961753L);
        int8[] b7 #= IqGridTest.bytesOf64(IqGrid.iq1s());
        IqGridTest.check("IQ1S", b7, 875415269L, 1767902686L);
        int8[] b8 #= IqGridTest.bytesOf32(IqGrid.iq1sNibble());
        IqGridTest.check("IQ1S_NIBBLE", b8, 283192522L, 1101788351L);
        int8[] b9 #= IqGridTest.bytesOf32(IqGrid.iq2xxs2b());
        IqGridTest.check("IQ2XXS_2B", b9, 940307328L, 291022588L);
        int8[] b10 #= IqGridTest.bytesOf32(IqGrid.iq2xs2b());
        IqGridTest.check("IQ2XS_2B", b10, 1253477924L, 1949202866L);
        int8[] b11 #= IqGridTest.bytesOf32(IqGrid.iq2s2b());
        IqGridTest.check("IQ2S_2B", b11, 1024104430L, 1366999701L);
    }

    /** IQ2 grid bytes are {8, 25, 43}; the two-bit form is that alphabet
     *  at index 0/1/2, value j at bits 2j. */
    static void checkIq2(String name, int64[] grid, int32[] packed) {
        int64 i = 0;
        while (i < (int64) grid.count()) {
            int32 v = 0;
            int32 j = 0;
            while (j < 8) {
                int32 b = (int32) ((grid[i] >> (8 * j)) & 255L);
                int32 l = 3;
                if (b == 8) { l = 0; }
                if (b == 25) { l = 1; }
                if (b == 43) { l = 2; }
                if (l == 3) {
                    Assert.fail(name + " entry " + i + " byte " + j + " is " + b);
                }
                v = v | (l << (2 * j));
                j = j + 1;
            }
            if (v != packed[i]) {
                Assert.fail(name + " entry " + i + ": two-bit form " + packed[i]
                    + " vs " + v);
            }
            i = i + 1;
        }
        return;
    }

    @Test
    public void theGridAlphabetsAndPackedFormsAgree() {
        IqGridTest.checkIq2("IQ2XXS", IqGrid.iq2xxs(), IqGrid.iq2xxs2b());
        IqGridTest.checkIq2("IQ2XS", IqGrid.iq2xs(), IqGrid.iq2xs2b());
        IqGridTest.checkIq2("IQ2S", IqGrid.iq2s(), IqGrid.iq2s2b());
        int64 i = 0;
        while (i < 256L) {
            int32 j = 0;
            while (j < 4) {
                int32 b = (IqGrid.iq3xxs()[i] >> (8 * j)) & 255;
                if (b < 4 || b > 62 || (b - 4) % 8 != 0 && b != 62) {
                    Assert.fail("IQ3XXS entry " + i + " byte " + j + " is " + b);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < 512L) {
            int32 j = 0;
            while (j < 4) {
                int32 b = (IqGrid.iq3s()[i] >> (8 * j)) & 255;
                if (b < 1 || b > 15 || b % 2 == 0) {
                    Assert.fail("IQ3S entry " + i + " byte " + j + " is " + b);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < 2048L) {
            int32 v = 0;
            int32 j = 0;
            while (j < 8) {
                int32 s = (int32) ((IqGrid.iq1s()[i] >> (8 * j)) & 255L);
                if (s > 127) { s = s - 256; }
                if (s < -1 || s > 1) {
                    Assert.fail("IQ1S entry " + i + " value " + j + " is " + s);
                }
                v = v | ((s + 1) << (4 * j));
                j = j + 1;
            }
            if (v != IqGrid.iq1sNibble()[i]) {
                Assert.fail("IQ1S_NIBBLE entry " + i + ": " + IqGrid.iq1sNibble()[i]
                    + " vs " + v);
            }
            i = i + 1;
        }
        int32 k = 0;
        while (k < 8) {
            Assert.equals(1 << k, IqGrid.kmask()[k]);
            k = k + 1;
        }
        // ksigns: bit 7 completes the parity of the low seven bits.
        k = 0;
        while (k < 128) {
            int32 s = IqGrid.ksigns()[k];
            Assert.equals(k, s & 127);
            int32 ones = 0;
            int32 t = 0;
            while (t < 8) { ones = ones + ((s >> t) & 1); t = t + 1; }
            Assert.equals(0, ones % 2);
            k = k + 1;
        }
    }
}
