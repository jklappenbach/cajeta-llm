package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The kernels built for one class of device (cajeta xpu-kernel-targets, Unit 8): a GPU wave
 * mat-vec is not a target on the cpu backend, and a cpu interleave kernel is not one on a GPU.
 */
public class KernelTargetsTest {

    public KernelTargetsTest() { return; }

    /** The backend's off-target kernels are listed, and each says why it is unavailable. */
    @Test
    public void theOffTargetKernelsAreListedWithTheirReason() {
        String be #= Device.activeBackend();
        if (be.equals("none")) {
            DeviceSkip.cannot("no XPU backend");
            return;
        }
        String off #= "q4kQ8WavePfMatVecKernel";
        String on #= "q5kQ8X8VecKernel";
        if (!be.equals("cpu")) {
            off #= "q50Q8X8VecKernel";
            on #= "q4kQ8WavePfMatVecKernel";
        }
        String why #= Device.kernelUnavailableReason(off);
        Assert.isTrue(why.equals("not a target"));
        Assert.isTrue(!Device.kernelAvailable(off));
        String here #= Device.kernelUnavailableReason(on);
        Assert.isTrue(!here.equals("not a target"));
        int32 n = Device.offTargetKernelCount();
        boolean listed = false;
        int32 i = 0;
        while (i < n) {
            String name #= Device.offTargetKernel(i);
            String r #= Device.kernelUnavailableReason(name);
            Assert.isTrue(r.equals("not a target"));
            if (name.equals(off)) { listed = true; }
            i = i + 1;
        }
        Assert.isTrue(listed);
    }
}
