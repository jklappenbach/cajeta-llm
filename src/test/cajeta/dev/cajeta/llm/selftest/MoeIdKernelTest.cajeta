package dev.cajeta.llm.selftest;

import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.MoeFfn;
import dev.cajeta.llm.model.Prim;

/**
 * cajeta-llm plan 40.1 — the zero-sync route's device kernels against
 * their host twins (spec 15.21.2, 15.21.3).
 *
 * Gate: `Linear.residentEnabled()` — the wave-geometry predicate. The
 * cpu backend runs these kernels wrong by design (plan 11.5) and is
 * where the HOST twins are already exercised by every routing test.
 */
public class MoeIdKernelTest {

    public MoeIdKernelTest() { return; }

    /** 40.1.1 — device softmax/top-k/renorm vs the host algorithm on
     *  synthetic logits: well-separated values (selection must match
     *  exactly), an exact TIE (the lower index must win on both
     *  sides), and the renorm arm. Weights carry a small tolerance —
     *  device exp and host exp may differ in the last ulp. */
    @Test
    public void deviceTopKMatchesHostRouting() {
        if (!Linear.residentEnabled()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 E = 128;
        int32 K = 8;
        float32[] lg = heap float32[E];
        int32 e = 0;
        while (e < E) {
            // 1/64-grid values, well separated, deterministic.
            lg[e] = (float32) ((e * 37 + 11) % 128) / 16.0f;
            e = e + 1;
        }
        // An exact tie at the top: experts 7 and 23 share the maximum.
        lg[7] = 9.5f;
        lg[23] = 9.5f;

        // HOST twin — the routeInto algorithm verbatim.
        float32[] probs = heap float32[E];
        float32 mx = lg[0];
        e = 1;
        while (e < E) {
            if (lg[e] > mx) { mx = lg[e]; }
            e = e + 1;
        }
        float32 sum = 0.0f;
        e = 0;
        while (e < E) {
            float32 p = Math.exp(lg[e] - mx);
            probs[e] = p;
            sum = sum + p;
            e = e + 1;
        }
        e = 0;
        while (e < E) { probs[e] = probs[e] / sum; e = e + 1; }
        int32[] hSel = heap int32[K];
        float32[] hW = heap float32[K];
        int32 k = 0;
        while (k < K) {
            int32 best = 0 - 1;
            float32 bp = 0.0f;
            e = 0;
            while (e < E) {
                if (probs[e] >= 0.0f && (best < 0 || probs[e] > bp)) {
                    best = e;
                    bp = probs[e];
                }
                e = e + 1;
            }
            hSel[k] = best;
            hW[k] = bp;
            probs[best] = 0.0f - 1.0f;
            k = k + 1;
        }
        float32 ws = 0.0f;
        k = 0;
        while (k < K) { ws = ws + hW[k]; k = k + 1; }
        if (ws < 0.00006103515625f) { ws = 0.00006103515625f; }
        k = 0;
        while (k < K) { hW[k] = hW[k] / ws; k = k + 1; }

        // DEVICE arm.
        KernelBuffer<float32> lgDev #= heap KernelBuffer<float32>(
            (uint64) E);
        lgDev.upload(lg, (int64) E);
        KernelBuffer<int32> selDev #= heap KernelBuffer<int32>(
            (uint64) K);
        KernelBuffer<float32> wDev #= heap KernelBuffer<float32>(
            (uint64) K);
        QuantKernel.moeTopKLaunchNoSync(selDev, wDev, lgDev, null,
            (int64) E, (int64) K, true, 0.0f);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32[] dSel = heap int32[K];
        float32[] dW = heap float32[K];
        selDev.download(dSel, (int64) K);
        wDev.download(dW, (int64) K);

        // The tie: 7 before 23, in the first two slots.
        Assert.equals(7L, (int64) dSel[0]);
        Assert.equals(23L, (int64) dSel[1]);
        k = 0;
        while (k < K) {
            Assert.equals((int64) hSel[k], (int64) dSel[k]);
            float64 d = (float64) hW[k] - (float64) dW[k];
            if (d < 0.0) { d = 0.0 - d; }
            Assert.isTrue(d < 0.000001);
            k = k + 1;
        }
    }

    /** 45.1.1 — the device counting sort vs the host groupPicks
     *  algorithm on synthetic picks: gRow/gW/rowSlot IDENTICAL (the
     *  order within a group is pick order on both sides), the 64-row
     *  chunk maps identical, and meta[0] the host's chunk count. The
     *  picks are skewed (one hot expert, several empty) so both the
     *  multi-chunk and the empty-group arms run. */
    @Test
    public void deviceGroupingMatchesHostCountingSort() {
        if (!Linear.residentEnabled()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 E = 128;
        int32 K = 8;
        int32 rows = 300;
        int32 np = rows * K;
        int32[] sel = heap int32[np];
        float32[] w = heap float32[np];
        int32 i = 0;
        while (i < np) {
            // Skewed: a third of the picks land on expert 5, none on
            // experts 100..127.
            int32 e = (i * 37 + 11) % 100;
            if (i % 3 == 0) { e = 5; }
            sel[i] = e;
            w[i] = (float32) ((i * 7) % 13) / 13.0f;
            i = i + 1;
        }
        // HOST twin — groupPicks verbatim.
        int32[] cnt = heap int32[E];
        int32[] off = heap int32[E + 1];
        int32[] cur = heap int32[E];
        int32[] hRow = heap int32[np];
        float32[] hW = heap float32[np];
        int32[] hSlot = heap int32[np];
        i = 0;
        while (i < np) { cnt[sel[i]] = cnt[sel[i]] + 1; i = i + 1; }
        int32 e2 = 0;
        int32 nC = 0;
        while (e2 < E) {
            off[e2 + 1] = off[e2] + cnt[e2];
            cur[e2] = off[e2];
            nC = nC + (cnt[e2] + 63) / 64;
            e2 = e2 + 1;
        }
        int32[] hE = heap int32[nC];
        int32[] hT0 = heap int32[nC];
        int32[] hM1 = heap int32[nC];
        int32 ci = 0;
        e2 = 0;
        while (e2 < E) {
            int32 tw = 0;
            while (tw * 64 < cnt[e2]) {
                hE[ci] = e2;
                hT0[ci] = off[e2] + tw * 64;
                hM1[ci] = off[e2] + cnt[e2];
                ci = ci + 1;
                tw = tw + 1;
            }
            e2 = e2 + 1;
        }
        i = 0;
        while (i < np) {
            int32 slot = cur[sel[i]];
            cur[sel[i]] = slot + 1;
            hRow[slot] = i / K;
            hW[slot] = w[i];
            hSlot[i] = slot;
            i = i + 1;
        }
        // DEVICE arm.
        KernelBuffer<int32> selDev #= heap KernelBuffer<int32>((uint64) np);
        KernelBuffer<float32> wDev #= heap KernelBuffer<float32>((uint64) np);
        selDev.upload(sel, (int64) np);
        wDev.upload(w, (int64) np);
        KernelBuffer<int32> gRow #= heap KernelBuffer<int32>((uint64) np);
        KernelBuffer<float32> gW #= heap KernelBuffer<float32>((uint64) np);
        KernelBuffer<int32> rowSlot #= heap KernelBuffer<int32>((uint64) np);
        int32 cap = np / 64 + E + 1;
        KernelBuffer<int32> mE #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> mT0 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> mM1 #= heap KernelBuffer<int32>((uint64) cap);
        KernelBuffer<int32> meta #= heap KernelBuffer<int32>((uint64) 4);
        QuantKernel.moeGroupLaunchNoSync(gRow, gW, rowSlot, mE, mT0, mM1,
            meta, selDev, wDev, (int64) np, (int64) E, (int64) K);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32[] dRow = heap int32[np];
        float32[] dW = heap float32[np];
        int32[] dSlot = heap int32[np];
        int32[] dMeta = heap int32[4];
        gRow.download(dRow, (int64) np);
        gW.download(dW, (int64) np);
        rowSlot.download(dSlot, (int64) np);
        meta.download(dMeta, 1L);
        Assert.equals((int64) nC, (int64) dMeta[0]);
        int32[] dE = heap int32[nC];
        int32[] dT0 = heap int32[nC];
        int32[] dM1 = heap int32[nC];
        mE.download(dE, (int64) nC);
        mT0.download(dT0, (int64) nC);
        mM1.download(dM1, (int64) nC);
        i = 0;
        while (i < np) {
            Assert.equals((int64) hRow[i], (int64) dRow[i]);
            Assert.isTrue(hW[i] == dW[i]);
            Assert.equals((int64) hSlot[i], (int64) dSlot[i]);
            i = i + 1;
        }
        ci = 0;
        while (ci < nC) {
            Assert.equals((int64) hE[ci], (int64) dE[ci]);
            Assert.equals((int64) hT0[ci], (int64) dT0[ci]);
            Assert.equals((int64) hM1[ci], (int64) dM1[ci]);
            ci = ci + 1;
        }
        // Vacuity: the hot expert really spans several chunks.
        Assert.isTrue((cnt[5] + 63) / 64 >= 2);
    }

    /** 45.1.2 — the batched top-k vs the per-row kernel on the same
     *  logits: identical picks and weights row for row (the per-row
     *  kernel is itself pinned to the host algorithm by 40.1.1). */
    @Test
    public void batchedTopKMatchesPerRowKernel() {
        if (!Linear.residentEnabled()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 E = 128;
        int32 K = 8;
        int32 rows = 37;
        float32[] lg = heap float32[rows * E];
        int32 i = 0;
        while (i < rows * E) {
            lg[i] = (float32) ((i * 37 + 11) % 128) / 16.0f
                + (float32) (i % 5) * 0.25f;
            i = i + 1;
        }
        // An exact tie inside row 3.
        lg[3 * E + 7] = 9.5f;
        lg[3 * E + 23] = 9.5f;
        KernelBuffer<float32> lgDev #= heap KernelBuffer<float32>(
            (uint64) (rows * E));
        lgDev.upload(lg, (int64) (rows * E));
        KernelBuffer<int32> selB #= heap KernelBuffer<int32>(
            (uint64) (rows * K));
        KernelBuffer<float32> wB #= heap KernelBuffer<float32>(
            (uint64) (rows * K));
        QuantKernel.moeTopKBatchLaunchNoSync(selB, wB, lgDev, (int64) rows,
            (int64) E, (int64) K, true, 0.0f);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int32[] dSel = heap int32[rows * K];
        float32[] dW = heap float32[rows * K];
        selB.download(dSel, (int64) (rows * K));
        wB.download(dW, (int64) (rows * K));
        int32 r = 0;
        while (r < rows) {
            KernelBuffer<float32> one #= lgDev.slice((uint64) (r * E),
                (uint64) E);
            KernelBuffer<int32> s1 #= heap KernelBuffer<int32>((uint64) K);
            KernelBuffer<float32> w1 #= heap KernelBuffer<float32>((uint64) K);
            QuantKernel.moeTopKLaunchNoSync(s1, w1, one, null, (int64) E,
                (int64) K, true, 0.0f);
            s.sync();
            int32[] rs = heap int32[K];
            float32[] rw = heap float32[K];
            s1.download(rs, (int64) K);
            w1.download(rw, (int64) K);
            int32 k = 0;
            while (k < K) {
                Assert.equals((int64) rs[k], (int64) dSel[r * K + k]);
                Assert.isTrue(rw[k] == dW[r * K + k]);
                k = k + 1;
            }
            r = r + 1;
        }
        // The tie in row 3: 7 before 23.
        Assert.equals(7L, (int64) dSel[3 * K]);
        Assert.equals(23L, (int64) dSel[3 * K + 1]);
    }

    /** 50.1.1 — router + top-k in one launch vs the two launches:
     *  identical logits, picks and weights, on synthetic router rows
     *  with an exact tie; TWICE in a row, so the ticket counter's
     *  reset is proven (a stale count would skip the selection on the
     *  second run). */
    @Test
    public void fusedRouterTopKMatchesTheTwoLaunches() {
        if (!Linear.residentEnabled()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 E = 128;
        int32 H = 2048;
        int32 K = 8;
        float32[] wr = heap float32[E * H];
        float32[] xh = heap float32[H];
        int32 i = 0;
        while (i < E * H) {
            wr[i] = (float32) (((i * 31) % 97) - 48) / 97.0f;
            i = i + 1;
        }
        // Rows 7 and 23 identical: an exact tie in the logits.
        i = 0;
        while (i < H) {
            wr[23 * H + i] = wr[7 * H + i];
            xh[i] = (float32) ((i % 17) - 8) / 8.0f;
            i = i + 1;
        }
        KernelBuffer<float32> wDev #= heap KernelBuffer<float32>(
            (uint64) (E * H));
        KernelBuffer<float32> x #= heap KernelBuffer<float32>((uint64) H);
        wDev.upload(wr, (int64) (E * H));
        x.upload(xh, (int64) H);
        KernelBuffer<float32> lg1 #= heap KernelBuffer<float32>((uint64) E);
        KernelBuffer<float32> lg2 #= heap KernelBuffer<float32>((uint64) E);
        KernelBuffer<int32> s1 #= heap KernelBuffer<int32>((uint64) K);
        KernelBuffer<int32> s2 #= heap KernelBuffer<int32>((uint64) K);
        KernelBuffer<float32> w1 #= heap KernelBuffer<float32>((uint64) K);
        KernelBuffer<float32> w2 #= heap KernelBuffer<float32>((uint64) K);
        KernelBuffer<int32> counter #= heap KernelBuffer<int32>((uint64) 4);
        int32[] z = heap int32[4];
        counter.upload(z, 4L);
        KernelStream s = QuantKernel.stream();
        int32 pass = 0;
        while (pass < 2) {
            QuantKernel.routerF32MatVecLaunchNoSync(lg1, wDev, x, (int64) E,
                (int64) H);
            QuantKernel.moeTopKLaunchNoSync(s1, w1, lg1, null, (int64) E,
                (int64) K, true, 0.0f);
            QuantKernel.routerTopKLaunchNoSync(s2, w2, lg2, wDev, x, counter,
                (int64) E, (int64) H, (int64) K, true, 0.0f);
            s.sync();
            float32[] a = heap float32[E];
            float32[] b = heap float32[E];
            lg1.download(a, (int64) E);
            lg2.download(b, (int64) E);
            i = 0;
            while (i < E) {
                Assert.isTrue(a[i] == b[i]);
                i = i + 1;
            }
            int32[] sa = heap int32[K];
            int32[] sb = heap int32[K];
            float32[] wa = heap float32[K];
            float32[] wb = heap float32[K];
            s1.download(sa, (int64) K);
            s2.download(sb, (int64) K);
            w1.download(wa, (int64) K);
            w2.download(wb, (int64) K);
            int32 k = 0;
            while (k < K) {
                Assert.equals((int64) sa[k], (int64) sb[k]);
                Assert.isTrue(wa[k] == wb[k]);
                k = k + 1;
            }
            // Zero the fused outputs so a skipped selection on pass 2
            // cannot pass on pass 1's values.
            int32[] zs = heap int32[K];
            float32[] zw = heap float32[K];
            s2.upload(zs, (int64) K);
            w2.upload(zw, (int64) K);
            pass = pass + 1;
        }
        int32[] cnt = heap int32[4];
        counter.download(cnt, 4L);
        Assert.equals(0L, (int64) cnt[0]);
    }

    /** 48.1.2 — the fused gate+up+GLU launch vs gate-id, up-id and the
     *  GLU kernel: each bank's dot is the id kernel's math and the GLU
     *  is the same formula on the same floats, so the middle must be
     *  BIT-identical. */
    @Test
    public void fusedGateUpGluMatchesTheChain() {
        if (!Linear.residentEnabled()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        CausalLM m #= ResidentMoeDecodeTest.mk();
        MoeFfn moe = m.moeAt(0);
        ExpertBank gb = moe.gate();
        ExpertBank ub = moe.upBank();
        Assert.isTrue(gb.ensureSlab());
        Assert.isTrue(ub.ensureSlab());
        int64 rows = (int64) gb.rows();
        int64 cols = (int64) gb.cols();
        int32 used = 2;
        int32[] ids = heap int32[used];
        ids[0] = 3;
        ids[1] = 0;
        float32[] xv = heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25) - 12) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>(
            (uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<int32> sel #= heap KernelBuffer<int32>(
            (uint64) used);
        sel.upload(ids, (int64) used);
        int64 n = (int64) used * rows;
        KernelBuffer<float32> gy #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> uy #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> fy #= heap KernelBuffer<float32>((uint64) n);
        Assert.isTrue(gb.idLaunch(gy, xp, sel, used, 0L));
        Assert.isTrue(ub.idLaunch(uy, xp, sel, used, 0L));
        Prim.gluDevice(gy, uy, n, 0);
        Assert.isTrue(ExpertBank.idGateUpGlu(gb, ub, fy, xp, sel, used, 0));
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[n];
        float32[] b = heap float32[n];
        gy.download(a, n);
        fy.download(b, n);
        int64 i = 0;
        int64 diff = 0L;
        boolean nz = false;
        while (i < n) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }

    /** 40.1.2 — the indirected launch vs per-expert wave launches on
     *  the SAME slab bytes and the SAME staged activation. The two
     *  decompositions run an identical per-row dot loop, so the
     *  outputs must be BIT-identical — `==`, not a tolerance. */
    @Test
    public void idMatVecMatchesPerExpertWaveLaunches() {
        if (!Linear.residentEnabled()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        CausalLM m #= ResidentMoeDecodeTest.mk();
        MoeFfn moe = m.moeAt(0);
        ExpertBank gb = moe.gate();
        Assert.isTrue(gb.ensureSlab());
        int64 rows = (int64) gb.rows();
        int64 cols = (int64) gb.cols();
        int32 used = 2;
        int32[] ids = heap int32[used];
        ids[0] = 3;
        ids[1] = 0;

        // A non-trivial staged activation.
        float32[] xv = heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25) - 12) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>(
            (uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);

        KernelBuffer<int32> sel #= heap KernelBuffer<int32>(
            (uint64) used);
        sel.upload(ids, (int64) used);
        KernelBuffer<float32> yId #= heap KernelBuffer<float32>(
            (uint64) ((int64) used * rows));
        KernelBuffer<float32> yWv #= heap KernelBuffer<float32>(
            (uint64) ((int64) used * rows));
        Assert.isTrue(gb.idLaunch(yId, xp, sel, used, 0L));
        int32 k = 0;
        while (k < used) {
            gb.slotWaveLaunch(ids[k], yWv, xp, (int64) k * rows);
            k = k + 1;
        }
        KernelStream s = QuantKernel.stream();
        s.sync();
        int64 n = (int64) used * rows;
        float32[] a = heap float32[n];
        float32[] b = heap float32[n];
        yId.download(a, n);
        yWv.download(b, n);
        int64 i = 0;
        int64 diff = 0L;
        while (i < n) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        // Vacuity: the outputs are not all zero.
        boolean nz = false;
        i = 0;
        while (i < n) {
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }
}
