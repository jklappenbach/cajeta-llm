package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.ColsProbe;
import dev.cajeta.llm.model.Linear;

/**
 * cajeta-llm 15.2.14.10.1: every GPU choice a load times has an EngineOptions field, so a deployment with one
 * fixed target pins it without code. `LlmEngine.applyPins` is what a load calls: a named value sets the choice so
 * nothing is timed, `"auto"` leaves it (and any pin a bench set before load) alone, and a misspelt value is refused
 * naming the field.
 */
public class EnginePinsTest {

    public EnginePinsTest() { return; }

    static void clearPins() {
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
        ColsProbe.setPays(Quant.GG_Q6_K, 0);
        ColsProbe.setPays(Quant.GG_Q5_K, 0);
        ColsProbe.setPays(Quant.GG_Q8_0, 0);
        ColsProbe.setPays(Quant.GG_Q2_K, 0);
        ColsProbe.setPays(Quant.GG_Q3_K, 0);
        QuantKernel.setQ4ColsPrefetch(0);
        QuantKernel.setQ6ColsPrefetch(0);
        QuantKernel.setQ4Prefetch(0);
        QuantKernel.setQ6Prefetch(0);
        QuantKernel.setColsSeg(0 - 1);
        Linear.setMatrixCoresPay(0);
        AttnKernel.setPrefillTilePays(0);
    }

    @Test
    public void namedValuesPinEveryChoice() {
        EnginePinsTest.clearPins();
        EngineOptions o = heap EngineOptions("m.gguf");
        o.colsPays = "off";
        o.colsVariant = "plain";
        o.mvPrefetch = "on";
        o.colsSeg = "separate";
        o.matrixCores = "off";
        o.attnTile = "on";
        LlmEngine.applyPins(o);
        Assert.equals(2L, (int64) ColsProbe.pinned(Quant.GG_Q4_K, 4));
        Assert.equals(2L, (int64) ColsProbe.pinned(Quant.GG_Q3_K, 2));
        Assert.equals(2L, (int64) QuantKernel.q4ColsVariant());
        Assert.equals(2L, (int64) QuantKernel.q6ColsVariant());
        Assert.isTrue(QuantKernel.q4PrefetchPays());
        Assert.isTrue(QuantKernel.q6PrefetchPays());
        Assert.equals(2L, (int64) QuantKernel.colsSegMode());
        Assert.isFalse(Linear.matrixCoresPay());
        Assert.equals(1L, (int64) AttnKernel.prefillTilePaysState());
        o.colsPays = "on";
        o.colsVariant = "two-row";
        o.mvPrefetch = "off";
        o.colsSeg = "probe";
        o.matrixCores = "on";
        o.attnTile = "off";
        LlmEngine.applyPins(o);
        Assert.equals(1L, (int64) ColsProbe.pinned(Quant.GG_Q6_K, 8));
        Assert.equals(3L, (int64) QuantKernel.q4ColsVariant());
        Assert.isFalse(QuantKernel.q4PrefetchPays());
        Assert.equals(0L, (int64) QuantKernel.colsSegMode());
        Assert.isTrue(Linear.matrixCoresPay());
        Assert.equals(2L, (int64) AttnKernel.prefillTilePaysState());
        EnginePinsTest.clearPins();
    }

    @Test
    public void autoLeavesAPinSetBeforeLoad() {
        EnginePinsTest.clearPins();
        QuantKernel.setQ4ColsPrefetch(3);
        QuantKernel.setColsSeg(1);
        EngineOptions o = heap EngineOptions("m.gguf");
        LlmEngine.applyPins(o);
        Assert.equals(3L, (int64) QuantKernel.q4ColsVariant());
        Assert.equals(1L, (int64) QuantKernel.colsSegMode());
        Assert.equals(0L, (int64) ColsProbe.pinned(Quant.GG_Q4_K, 4));
        EnginePinsTest.clearPins();
    }

    @Test
    public void aMisspeltValueIsRefusedByName() {
        EngineOptions o = heap EngineOptions("m.gguf");
        o.colsSeg = "fusd";
        String why = "";
        try {
            LlmEngine.applyPins(o);
        } catch (LlmException e) {
            why = "" + e.getMessage();
        }
        Assert.isTrue(why.indexOf("colsSeg") >= 0L);
        Assert.isTrue(why.indexOf("fusd") >= 0L);
        EnginePinsTest.clearPins();
    }
}
