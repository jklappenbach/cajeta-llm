package dev.cajeta.llm.selftest;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The B-column wave mat-vecs of batched decode (xpu-kernel-adaptor 13B): one
 * pass over the weights for up to eight sequences' activations. Every column
 * must be BIT-identical to the one-column kernel on the same activation, so
 * batching can never change a token, and the whole product is held to the
 * host's dequantized GEMM.
 */
public class WaveColsMatVecTest {

    public WaveColsMatVecTest() { return; }

    /** Both launchers of `ty` with the prefetch choice pinned to `pin` (1 = prefetch, 2 = plain), so each variant is checked here whatever the probe picks. */
    static void check(String kernel, String single, int32 ty, String fixture,
            int64 out, int64 cols, int32 pin) {
        QuantKernel.setQ4Prefetch(pin);
        QuantKernel.setQ6Prefetch(pin);
        QuantKernel.setQ4ColsPrefetch(pin);
        QuantKernel.setQ6ColsPrefetch(pin);
        WaveColsMatVecTest.checkPinned(kernel, single, ty, fixture, out, cols);
        QuantKernel.setQ4Prefetch(0);
        QuantKernel.setQ6Prefetch(0);
        QuantKernel.setQ4ColsPrefetch(0);
        QuantKernel.setQ6ColsPrefetch(0);
    }

    /** As {@link #checkPinned}, but a backend that lowers the one-column kernel must
     *  lower its Cols twin: a missing twin is a failure, not a skip (15.2.15.3 — without
     *  it a model carrying the format decodes its sequences one at a time). */
    static void checkRequired(String kernel, String single, int32 ty, String fixture,
            int64 out, int64 cols) {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(single)) { DeviceSkip.noKernel(single, be); return; }
        if (!KernelCap.usable(kernel)) {
            Assert.fail(single + " lowers on " + be + " but its Cols twin " + kernel
                + " does not: batched decode is refused for this format");
            return;
        }
        WaveColsMatVecTest.checkPinned(kernel, single, ty, fixture, out, cols);
    }

    static void checkPinned(String kernel, String single, int32 ty, String fixture,
            int64 out, int64 cols) {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        if (!KernelCap.usable(single)) { DeviceSkip.noKernel(single, be); return; }
        int64 ncMax = (int64) QuantKernel.WAVE_COLS_MAX;
        // Blocks per row in the FORMAT's block width: 256 for the k-quants, 32 for Q8_0.
        int64 bpr = cols / (int64) Quant.blockElems(ty);
        int64 nBlocks = out * bpr;
        int8[] raw #= CensusReachTest.tiled(ty, fixture, nBlocks);
        float32[] x #= heap float32[ncMax * cols];
        int64 i = 0;
        while (i < ncMax * cols) {
            x[i] = (float32) ((i * 37L + (i / cols) * 11L + 5L) % 67L - 33L) * 0.0625f;
            i = i + 1;
        }
        float32[] want #= CensusReachTest.hostGemm(ty, raw, nBlocks, x, ncMax, out, cols);
        int8[] dev #= raw;
        if (Quant.splitOn(ty)) {
            int8[] res #= heap int8[out * Quant.rowResidentBytes(ty, bpr)];
            Quant.splitInto(ty, raw, 0L, out, bpr, res, 0L);
            dev #= res;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) dev.count()));
        wD.upload(dev);
        int64[] vc #= ValueCheck.mark();
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, ncMax, cols);
        int64 pb = Quant.q8kPackedBytes(cols);
        float32[] one #= heap float32[ncMax * out];
        KernelBuffer<float32> yOne #= heap KernelBuffer<float32>((uint64) (ncMax * out));
        int64 c = 0;
        while (c < ncMax) {
            KernelBuffer<int8> xc #= xp.slice((uint64) (c * pb), (uint64) pb);
            if (ty == Quant.GG_Q4_K) {
                QuantKernel.q4kQ8WaveMatVecLaunchNoSync(yOne, wD, xc, out, cols, c * out);
            } else if (ty == Quant.GG_Q5_K) {
                QuantKernel.q5kQ8WaveMatVecLaunchNoSync(yOne, wD, xc, out, cols, c * out);
            } else if (ty == Quant.GG_Q8_0) {
                QuantKernel.q80Q8WaveMatVecLaunchNoSync(yOne, wD, xc, out, cols, c * out);
            } else if (ty == Quant.GG_Q2_K) {
                QuantKernel.q2kQ8WaveMatVecLaunchNoSync(yOne, wD, xc, out, cols, c * out);
            } else if (ty == Quant.GG_Q3_K) {
                QuantKernel.q3kQ8WaveMatVecLaunchNoSync(yOne, wD, xc, out, cols, c * out);
            } else {
                QuantKernel.q6kQ8WaveMatVecLaunchNoSync(yOne, wD, xc, out, cols, c * out);
            }
            c = c + 1;
        }
        QuantKernel.stream().sync();
        yOne.download(one);
        // The one-column reference itself against the host first, so a
        // disagreement below names the kernel that is wrong.
        CensusReachTest.nearOnePercent(want, one, ncMax * out,
            single + " (the one-column reference) at " + out + "x" + cols);
        int32[] widths #= heap int32[5];
        widths[0] = 1;
        widths[1] = 2;
        widths[2] = 3;
        widths[3] = 5;
        widths[4] = 8;
        float32[] got #= heap float32[ncMax * out];
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (ncMax * out));
        int32 wi = 0;
        while (wi < 5) {
            int32 nc = widths[wi];
            int64 k = 0;
            while (k < ncMax * out) { got[k] = -1.0f; k = k + 1; }
            yD.upload(got);
            if (ty == Quant.GG_Q4_K) {
                QuantKernel.q4kQ8WaveMatVecColsLaunchNoSync(yD, wD, xp, out, cols,
                    0L, nc, out, pb, false);
            } else if (ty == Quant.GG_Q5_K) {
                QuantKernel.q5kQ8WaveMatVecColsLaunchNoSync(yD, wD, xp, out, cols,
                    0L, nc, out, pb, false);
            } else if (ty == Quant.GG_Q8_0) {
                QuantKernel.q80Q8WaveMatVecColsLaunchNoSync(yD, wD, xp, out, cols,
                    0L, nc, out, pb, false);
            } else if (ty == Quant.GG_Q2_K) {
                QuantKernel.q2kQ8WaveMatVecColsLaunchNoSync(yD, wD, xp, out, cols,
                    0L, nc, out, pb, false);
            } else if (ty == Quant.GG_Q3_K) {
                QuantKernel.q3kQ8WaveMatVecColsLaunchNoSync(yD, wD, xp, out, cols,
                    0L, nc, out, pb, false);
            } else {
                QuantKernel.q6kQ8WaveMatVecColsLaunchNoSync(yD, wD, xp, out, cols,
                    0L, nc, out, pb, false);
            }
            QuantKernel.stream().sync();
            yD.download(got);
            k = 0;
            while (k < ncMax * out) {
                if (k < (int64) nc * out) {
                    if (Cajeta.f32ToBits(got[k]) != Cajeta.f32ToBits(one[k])) {
                        Assert.fail(kernel + " at " + nc + " columns: column "
                            + (k / out) + " row " + (k % out) + " is " + got[k]
                            + ", the one-column kernel gives " + one[k]);
                        return;
                    }
                } else if (got[k] != -1.0f) {
                    Assert.fail(kernel + " at " + nc + " columns wrote column "
                        + (k / out) + ", past the columns it was given");
                    return;
                }
                k = k + 1;
            }
            wi = wi + 1;
        }
        CensusReachTest.nearOnePercent(want, got, ncMax * out,
            kernel + " at " + out + "x" + cols);
        ValueCheck.credit(vc);
    }

    @Test
    public void q4kColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.check("q4kQ8WaveMatVecColsKernel", "q4kQ8WaveMatVecKernel",
            Quant.GG_Q4_K, "q4_k.bin", 96L, 4096L, 2);
    }

    /** 15.2.15.3: the four formats that had only the one-column wave route. */
    @Test
    public void q5kColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.checkRequired("q5kQ8WaveMatVecColsKernel", "q5kQ8WaveMatVecKernel",
            Quant.GG_Q5_K, "q5_k.bin", 96L, 4096L);
    }

    @Test
    public void q80ColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.checkRequired("q80Q8WaveMatVecColsKernel", "q80Q8WaveMatVecKernel",
            Quant.GG_Q8_0, "q8_0.bin", 96L, 4096L);
    }

    @Test
    public void q2kColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.checkRequired("q2kQ8WaveMatVecColsKernel", "q2kQ8WaveMatVecKernel",
            Quant.GG_Q2_K, "q2_k.bin", 96L, 4096L);
    }

    @Test
    public void q3kColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.checkRequired("q3kQ8WaveMatVecColsKernel", "q3kQ8WaveMatVecKernel",
            Quant.GG_Q3_K, "q3_k.bin", 96L, 4096L);
    }

    @Test
    public void q6kColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.check("q6kQ8WaveMatVecColsKernel", "q6kQ8WaveMatVecKernel",
            Quant.GG_Q6_K, "q6_k.bin", 96L, 4096L, 2);
    }

    @Test
    public void q4kPrefetchColumnsEqualThePrefetchOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.check("q4kQ8WavePfMatVecColsKernel", "q4kQ8WavePfMatVecKernel",
            Quant.GG_Q4_K, "q4_k.bin", 96L, 4096L, 1);
    }

    @Test
    public void q4kTwoRowColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.checkRows("q4kQ8WaveR2MatVecColsKernel", "q4kQ8WaveMatVecKernel",
            Quant.GG_Q4_K, "q4_k.bin");
    }

    @Test
    public void q6kTwoRowColumnsEqualTheOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.checkRows("q6kQ8WaveR2MatVecColsKernel", "q6kQ8WaveMatVecKernel",
            Quant.GG_Q6_K, "q6_k.bin");
    }

    /** The Cols launchers on the two-row variant, the one-column reference on the plain one. */
    static void checkRows(String kernel, String single, int32 ty, String fixture) {
        QuantKernel.setQ4Prefetch(2);
        QuantKernel.setQ6Prefetch(2);
        QuantKernel.setQ4ColsPrefetch(3);
        QuantKernel.setQ6ColsPrefetch(3);
        WaveColsMatVecTest.checkPinned(kernel, single, ty, fixture, 97L, 4096L);
        QuantKernel.setQ4Prefetch(0);
        QuantKernel.setQ6Prefetch(0);
        QuantKernel.setQ4ColsPrefetch(0);
        QuantKernel.setQ6ColsPrefetch(0);
    }

    @Test
    public void q6kPrefetchColumnsEqualThePrefetchOneColumnKernelAndTheHost() {
        WaveColsMatVecTest.check("q6kQ8WavePfMatVecColsKernel", "q6kQ8WavePfMatVecKernel",
            Quant.GG_Q6_K, "q6_k.bin", 96L, 4096L, 1);
    }
}
