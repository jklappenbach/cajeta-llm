package dev.cajeta.llm.selftest;

import cajeta.math.Tensor;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.model.HostOps;

/** HostOps.matvecRow is bit-identical to the column-walk it replaced: each output sums over the input in order
 *  (cajeta-llm 15.2.20.3.16). */
public class HostOpsMatvecTest {

    public HostOpsMatvecTest() { return; }

    static void check(int32 inDim, int32 outDim, int64 srcOff, int64 dstOff) {
        Tensor<float32> src #= AttentionTest.filled2(1, inDim + (int32) srcOff, 3);
        Tensor<float32> w #= AttentionTest.filled2(inDim, outDim, 11);
        Tensor<float32> dst #= AttentionTest.filled2(1, outDim + (int32) dstOff, 5);
        HostOps.matvecRow(src, srcOff, w, dst, dstOff, inDim, outDim);
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 acc = 0.0f;
            int64 i = 0;
            while (i < (int64) inDim) {
                acc = acc + src.flatGet(srcOff + i) * w.flatGet(i * (int64) outDim + o);
                i = i + 1;
            }
            Assert.isTrue(dst.flatGet(dstOff + o) == acc);
            o = o + 1;
        }
        int64 j = 0;
        while (j < dstOff) {
            Assert.isTrue(dst.flatGet(j) == 0.0625f * (float32) (((j + 5L) * 7L + 3L) % 15L) - 0.4375f);
            j = j + 1;
        }
    }

    @Test
    public void matvecRowMatchesTheOrderedColumnSum() {
        HostOpsMatvecTest.check(2048, 128, 0L, 0L);
        HostOpsMatvecTest.check(37, 61, 5L, 3L);
        HostOpsMatvecTest.check(1, 1, 0L, 0L);
    }
}
