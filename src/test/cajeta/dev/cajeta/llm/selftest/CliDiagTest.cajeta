package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.DiagRecord;
import dev.cajeta.llm.cli.LoggingDiagCallback;
import dev.cajeta.logging.CapturingAppender;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.Log;
import dev.cajeta.logging.Logger;

/**
 * The CLI's half of the `Diag` hook (Julian, 2026-08-30; records since
 * Unit 21).
 *
 * `--verbose` used to install a plain stderr sink. That was wrong twice
 * over: stderr is a SEVERITY channel, so route notes arrive painted red
 * and alerted on, and a private stream cannot be aggregated with whatever
 * the host application already writes. Diagnostics now arrive as RECORDS
 * (spec 11.8) and the CLI renders them onto `dev.cajeta.logging` at
 * DEBUG — except "launch-failure", which is an ERROR at any threshold: a
 * dispatch that never ran means output computed on garbage.
 *
 * `diagAndHostLinesLandInOneStream` is the arm that actually pins the
 * aggregation requirement, and it is the one that would otherwise rot
 * silently: `Log.console` delivers every line these other tests assert,
 * so a regression to it passes the happy path while quietly opening a
 * second stream that stops following the moment a file sink is
 * configured.
 */
public class CliDiagTest {

    public CliDiagTest() { return; }

    static #DiagRecord routeRecord() {
        DiagRecord r = heap DiagRecord();
        r.category #= "batch-route";
        r.name #= "q4k";
        r.v0 = 1L;
        r.v1 = 2L;
        return #= r;
    }

    /** A record handed to the callback reaches the logger, rendered. */
    @Test
    public void recordsReachTheLogger() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("llm.engine", Level.DEBUG, #cap);
        LoggingDiagCallback cb #= heap LoggingDiagCallback(#log);

        DiagRecord r #= CliDiagTest.routeRecord();
        cb.onRecord(r);

        Assert.equals(1L, (int64) cap.count());
        Assert.isTrue(cap.get(0).contains("batch-route: q4k out=1 in=2"));
    }

    /** Registered through `Diag`, the engine's own emissions arrive. */
    @Test
    public void diagEmitReachesTheLoggerOnceRegistered() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("llm.engine", Level.DEBUG, #cap);
        LoggingDiagCallback cb #= heap LoggingDiagCallback(#log);

        Diag.register(cb);
        Diag.emit("prefill-mode", 0 - 1, "batched", 8L,
            0L, 0L, 0L, 0L, 0L);
        Diag.register(null);

        Assert.equals(1L, (int64) cap.count());
        Assert.isTrue(cap.get(0).contains("prefill: batched"));
    }

    /**
     * Route records are DEBUG, so a logger thresholded at INFO drops
     * them. A bridge that logged at info/warn would put route-selection
     * detail in every default-configured log — the console noise the
     * hook exists to prevent — and every other test here would still
     * pass, because a level that is too LOUD still delivers.
     */
    @Test
    public void routeRecordsAreBelowInfo() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("llm.engine", Level.INFO, #cap);
        LoggingDiagCallback cb #= heap LoggingDiagCallback(#log);

        DiagRecord r #= CliDiagTest.routeRecord();
        cb.onRecord(r);

        Assert.equals(0L, (int64) cap.count());
    }

    /**
     * "launch-failure" is the exception: ERROR, so it clears an INFO
     * threshold that drops the route chatter. The one record class that
     * IS news gets the severity that says so (21.2.5 / 25.4).
     */
    @Test
    public void launchFailureRecordsAreErrors() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("llm.engine", Level.INFO, #cap);
        LoggingDiagCallback cb #= heap LoggingDiagCallback(#log);

        DiagRecord r = heap DiagRecord();
        r.category #= "launch-failure";
        r.session = 3;
        r.v0 = 2L;
        r.v1 = 17L;
        cb.onRecord(r);

        Assert.equals(1L, (int64) cap.count());
        Assert.isTrue(cap.get(0).contains("LAUNCH FAILURE"));
        Assert.isTrue(cap.get(0).contains("session 3"));
    }

    /**
     * AGGREGATION — the requirement, not a nicety. `Log.at` borrows the
     * process's DI encoder and appender, so the engine's diagnostics and
     * the host's own logs land in ONE stream. Under `--profile=test` that
     * shared appender is the injected `CapturingAppender`, so "did both
     * reach the same sink" is directly observable.
     */
    @Test
    public void diagAndHostLinesLandInOneStream() {
        CapturingAppender cap = CapturingAppender.__cajeta_inject();
        int32 before = cap.count();

        Logger log #= Log.at("llm.engine", Level.DEBUG);
        LoggingDiagCallback cb #= heap LoggingDiagCallback(#log);
        DiagRecord r #= CliDiagTest.routeRecord();
        cb.onRecord(r);

        Logger host #= Log.at("some.host.component", Level.DEBUG);
        host.debug("host line");

        Assert.equals((int64) (before + 2), (int64) cap.count());
    }

    /**
     * THE CONTROL, and the reason the test above is worth anything.
     *
     * `Log.console` builds a FRESH `ConsoleAppender` per call, so its
     * lines never reach the process stream — which is precisely the bug
     * that a delivery-only assertion cannot see, because a console logger
     * "works" and its output is visible on the terminal. If this ever
     * starts incrementing the shared appender, `Log.console` has been
     * changed to aggregate and the distinction this design rests on is
     * gone; if `diagAndHostLinesLandInOneStream` is ever satisfied by a
     * console logger, it was never testing aggregation.
     */
    @Test
    public void aConsoleLoggerDoesNotReachTheProcessStream() {
        CapturingAppender cap = CapturingAppender.__cajeta_inject();
        int32 before = cap.count();

        Logger own #= Log.console("llm.engine", Level.DEBUG);
        own.debug("this line goes to its own appender");

        Assert.equals((int64) before, (int64) cap.count());
    }
}
