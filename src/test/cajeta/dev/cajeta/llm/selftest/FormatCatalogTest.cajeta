package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.io.file.Path;
import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.GgufFile;
import dev.cajeta.llm.io.Quant;

/**
 * Loading and naming (codebook-quants spec §2): every id of the family
 * names itself, a refusal lists what is supported, a decoder that does
 * not exist is refused by name, and the fixture manifest is complete.
 */
public class FormatCatalogTest {

    static final String DIR = "src/test/fixtures/gguf/kquant/";

    public FormatCatalogTest() { return; }

    @Test
    public void everyIdOfTheFamilyNamesItself() {
        String[] want = ["iq2_xxs", "iq2_xs", "iq3_xxs", "iq1_s", "iq3_s",
            "iq2_s", "iq1_m", "tq1_0", "tq2_0"];
        int32[] ids = [16, 17, 18, 19, 21, 22, 29, 34, 35];
        int32 i = 0;
        while (i < 9) {
            String got #= GgufFile.typeName(ids[i]);
            if (!got.equals(want[i])) {
                Assert.fail("type " + ids[i] + " named " + got + ", want "
                    + want[i]);
            }
            i = i + 1;
        }
        String u #= GgufFile.typeName(41);
        Assert.isTrue(u.equals("type_41"));
    }

    @Test
    public void theRefusalListsEverySupportedType() {
        String list #= Quant.supportedNames();
        int32 ty = 0;
        while (ty < 64) {
            String nm #= GgufFile.typeName(ty);
            if (Quant.supported(ty) && !list.contains(nm)) {
                Assert.fail("supported " + nm + " missing from '" + list + "'");
            }
            if (!Quant.supported(ty) && ty > 1 && ty != 30 && list.contains(nm)) {
                Assert.fail("unsupported " + nm + " listed in '" + list + "'");
            }
            ty = ty + 1;
        }
        Assert.isTrue(list.contains("q4_0"));
        Assert.isTrue(list.contains("mxfp4"));
    }

    @Test
    public void aDecoderThatDoesNotExistIsRefusedByName() {
        int8[] raw #= heap int8[66];
        float32[] out #= heap float32[256];
        boolean threw = false;
        try {
            Quant.dequantize(16, raw, 0L, 1L, out, 0L);
        } catch (LlmException e) {
            threw = true;
            String m #= e.getMessage();
            if (!m.contains("iq2_xxs")) {
                Assert.fail("refusal does not name the type: " + m);
            }
        }
        Assert.isTrue(threw);
    }

    static int32 typeOf(String name) {
        if (name.equals("q4_0")) { return Quant.GG_Q4_0; }
        if (name.equals("q4_1")) { return Quant.GG_Q4_1; }
        if (name.equals("q5_0")) { return Quant.GG_Q5_0; }
        if (name.equals("q5_1")) { return Quant.GG_Q5_1; }
        if (name.equals("q8_0")) { return Quant.GG_Q8_0; }
        if (name.equals("q2_k")) { return Quant.GG_Q2_K; }
        if (name.equals("q3_k")) { return Quant.GG_Q3_K; }
        if (name.equals("q4_k")) { return Quant.GG_Q4_K; }
        if (name.equals("q5_k")) { return Quant.GG_Q5_K; }
        if (name.equals("q6_k")) { return Quant.GG_Q6_K; }
        if (name.equals("iq4_nl")) { return Quant.GG_IQ4_NL; }
        if (name.equals("iq4_xs")) { return Quant.GG_IQ4_XS; }
        if (name.equals("iq1_s")) { return 19; }
        if (name.equals("iq1_m")) { return 29; }
        if (name.equals("iq2_xxs")) { return 16; }
        if (name.equals("iq2_xs")) { return 17; }
        if (name.equals("iq2_s")) { return 22; }
        if (name.equals("iq3_xxs")) { return 18; }
        if (name.equals("iq3_s")) { return 21; }
        if (name.startsWith("tq1_0")) { return 34; }
        if (name.startsWith("tq2_0")) { return 35; }
        return -1;
    }

    /** Every `.bin` in the fixture directory has a manifest entry that
     *  states its ggml type and its byte count. */
    @Test
    public void theManifestCoversEveryFixture() {
        int8[] mb #= File.readAllBytes(FormatCatalogTest.DIR + "manifest.json");
        int32 mn = (int32) mb.count();
        String manifest #= heap String(#mb, mn);
        Path dir #= Path.of(FormatCatalogTest.DIR);
        ArrayList<Path> files #= dir.list();
        int32 seen = 0;
        int32 i = 0;
        while (i < (int32) files.count()) {
            String fn #= files.get(i).name();
            if (fn.endsWith(".bin")) {
                String name #= fn.substring(0, fn.byteLength() - 4);
                int32 ty = FormatCatalogTest.typeOf(name);
                if (ty < 0) { Assert.fail("fixture with no type: " + name); }
                int8[] raw #= File.readAllBytes(FormatCatalogTest.DIR + fn);
                String key = "\"" + name + "\": {\n  \"ggml_type\": " + ty
                    + ",\n  \"elements\": ";
                if (!manifest.contains(key)) {
                    Assert.fail("manifest lacks " + name + " as type " + ty);
                }
                String bytes = "\"bytes\": " + (int64) raw.count() + ",";
                if (!manifest.contains(bytes)) {
                    Assert.fail("manifest lacks " + name + "'s " + bytes);
                }
                seen = seen + 1;
            }
            i = i + 1;
        }
        Assert.isTrue(seen >= 23);
    }
}
