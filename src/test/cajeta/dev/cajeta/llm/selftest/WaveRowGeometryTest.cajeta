package dev.cajeta.llm.selftest;

import cajeta.lang.Optional;
import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import cajeta.xpu.Autotune;
import dev.cajeta.llm.io.QuantKernel;

/**
 * The rows-per-workgroup hint is per machine AND per build. A value
 * measured against kernels that no longer exist is worse than no value,
 * because it is invisible.
 */
public final class WaveRowGeometryTest {

    static final String DIR = "tmp/wavegeom";

    @Test
    public void aHintMeasuredAgainstTheCurrentBuildIsUsed() {
        Autotune.invalidate(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK);
        String bid #= QuantKernel.tuneBuildId();
        Autotune.rememberFor(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK, 2, bid);
        QuantKernel.setMatVecTuneDir(WaveRowGeometryTest.DIR);
        int32 got = QuantKernel.waveRowsPerBlock();
        QuantKernel.setMatVecTuneDir("");
        Autotune.invalidate(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK);
        if (got != 2) {
            Assert.fail("a hint for this build must be used, got " + got);
        }
        return;
    }

    @Test
    public void aHintMeasuredAgainstOtherKernelsIsDiscarded() {
        Autotune.invalidate(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK);
        String bid #= QuantKernel.tuneBuildId();
        String other #= bid + "-changed";
        Autotune.rememberFor(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK, 8, other);
        QuantKernel.setMatVecTuneDir(WaveRowGeometryTest.DIR);
        int32 got = QuantKernel.waveRowsPerBlock();
        QuantKernel.setMatVecTuneDir("");
        Autotune.invalidate(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK);
        if (got == 8) {
            Assert.fail("a hint from another build was trusted");
        }
        if (got != 1) {
            Assert.fail("the derived default must serve, got " + got);
        }
        return;
    }

    @Test
    public void withNoHintTheDerivedDefaultServes() {
        Autotune.invalidate(WaveRowGeometryTest.DIR,
            QuantKernel.MV_ROWS_PER_BLOCK);
        QuantKernel.setMatVecTuneDir(WaveRowGeometryTest.DIR);
        int32 got = QuantKernel.waveRowsPerBlock();
        QuantKernel.setMatVecTuneDir("");
        if (got != 1) {
            Assert.fail("no hint must give the derived default, got " + got);
        }
        return;
    }

    /** The id must be derived, so two calls in one build agree. */
    @Test
    public void theBuildIdIsStableWithinABuild() {
        String a #= QuantKernel.tuneBuildId();
        String b #= QuantKernel.tuneBuildId();
        if (!a.equals(b)) {
            Assert.fail("build id is not stable: " + a + " vs " + b);
        }
        if (a.byteLength() == 0L) {
            Assert.fail("build id must not be empty");
        }
        System.stdout.println("   tune build id: " + a);
        return;
    }
}
