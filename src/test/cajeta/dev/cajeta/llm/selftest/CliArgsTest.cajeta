package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.cli.CliArgs;

/**
 * `--verbose` is the CLI's half of the diagnostics hook (`Diag`): the
 * engine stays silent as a library, and the CLI is one embedder that
 * opts in on the user's behalf.
 *
 * The flag is a BARE toggle, which is the part worth pinning. Every
 * other flag in `parse` consumes the next argument, so writing this one
 * by copying its neighbour silently eats whatever follows it — and the
 * damage lands on the NEXT flag, not on `--verbose`, so the error message
 * blames the wrong thing. `verboseDoesNotConsumeTheFollowingArgument`
 * asserts the flag after it still parses.
 */
public class CliArgsTest {

    public CliArgsTest() { return; }

    /** Silent unless asked: the default every non-CLI embedder inherits. */
    @Test
    public void verboseDefaultsToOff() {
        String[] args = ["--model", "m.gguf"];
        CliArgs c #= CliArgs.parse(args);
        Assert.isFalse(c.verbose);
    }

    /** The flag is accepted at all — it used to throw "unknown flag". */
    @Test
    public void verboseTurnsOn() {
        String[] args = ["--model", "m.gguf", "--verbose"];
        CliArgs c #= CliArgs.parse(args);
        Assert.isTrue(c.verbose);
    }

    /** A bare toggle: it must not swallow the argument after it. */
    @Test
    public void verboseDoesNotConsumeTheFollowingArgument() {
        String[] args = ["--model", "m.gguf", "--verbose", "-n", "7"];
        CliArgs c #= CliArgs.parse(args);
        Assert.isTrue(c.verbose);
        Assert.equals(7L, (int64) c.maxNew);
    }

    /** Order must not matter — the toggle is position-independent. */
    @Test
    public void verboseWorksBeforeOtherFlags() {
        String[] args = ["--verbose", "--model", "m.gguf", "-n", "3"];
        CliArgs c #= CliArgs.parse(args);
        Assert.isTrue(c.verbose);
        Assert.equals(3L, (int64) c.maxNew);
    }
}
