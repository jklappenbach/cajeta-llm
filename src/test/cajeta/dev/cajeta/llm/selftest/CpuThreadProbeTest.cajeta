package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.io.file.Path;

/**
 * cajeta-llm 15.2.14.8: the cpu backend's thread count is measured on layer 0 at load, like the interleave width.
 * The candidates and the choice are pure functions; a remembered or explicit count skips the probe; the probe
 * leaves the worker cap at its answer and remembers it.
 */
public class CpuThreadProbeTest {

    /** 15.2.14.8.1 — the default is kept unless another count is at least 5% faster. */
    @Test
    public void theDefaultIsKeptInsideTheMargin() {
        int32[] n #= heap int32[3];
        int64[] t #= heap int64[3];
        n[0] = 8; n[1] = 16; n[2] = 32;
        t[0] = 1100L; t[1] = 1000L; t[2] = 960L;
        Assert.equals(16, Linear.cpuThreadChoice(n, t, 16));
        t[2] = 940L;
        Assert.equals(32, Linear.cpuThreadChoice(n, t, 16));
        t[0] = 900L;
        Assert.equals(8, Linear.cpuThreadChoice(n, t, 16));
    }

    /** 15.2.14.8.1 — a count never timed (0 or negative) is not chosen; an untimed default keeps the default. */
    @Test
    public void anUnmeasuredTimeIsIgnored() {
        int32[] n #= heap int32[3];
        int64[] t #= heap int64[3];
        n[0] = 8; n[1] = 16; n[2] = 32;
        t[0] = 0L; t[1] = 1000L; t[2] = 0L - 1L;
        Assert.equals(16, Linear.cpuThreadChoice(n, t, 16));
        t[0] = 500L; t[1] = 0L;
        Assert.equals(16, Linear.cpuThreadChoice(n, t, 16));
    }

    static void assertCandidates(int32 physical, int32 online, String want) {
        int32[] c #= Linear.cpuThreadCandidates(physical, online);
        String got = "";
        int32 i = 0;
        while (i < (int32) c.count()) {
            if (i > 0) { got = got + ","; }
            got = got + c[i];
            i = i + 1;
        }
        Assert.equals(want, got);
    }

    /** 15.2.14.8.1 — half, three quarters and all of the physical cores, never a core's second thread; ascending,
     *  no duplicates, inside [1, online]. */
    @Test
    public void theCandidatesDropDuplicatesAndStayInRange() {
        CpuThreadProbeTest.assertCandidates(16, 32, "8,12,16");
        CpuThreadProbeTest.assertCandidates(6, 12, "3,4,6");
        CpuThreadProbeTest.assertCandidates(8, 4, "2,3,4");
        CpuThreadProbeTest.assertCandidates(4, 4, "2,3,4");
        CpuThreadProbeTest.assertCandidates(2, 2, "1,2");
        CpuThreadProbeTest.assertCandidates(1, 1, "1");
    }

    static boolean cpuHere() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the thread count is the cpu backend's"); return false; }
        return true;
    }

    static void useStore() {
        Path dir #= Path.of("tmp/cpu-thread-probe-tune");
        dir.mkdirs();
        Linear.setTuneDir("tmp/cpu-thread-probe-tune");
        Linear.forgetStoredChoices();
    }

    static void dropStore() {
        Linear.forgetStoredChoices();
        Linear.setTuneDir("");
        Device.setCpuWorkerCap(0);
    }

    /** 15.2.14.8.1 — a remembered count is applied without a probe. */
    @Test
    public void aRememberedCountIsAppliedWithoutAProbe() {
        if (!CpuThreadProbeTest.cpuHere()) { return; }
        CpuThreadProbeTest.useStore();
        Assert.isFalse(Linear.cpuThreadsRemembered());
        Assert.equals(0, Linear.applyCpuThreads(0));
        Linear.rememberCpuThreads(3);
        boolean remembered = Linear.cpuThreadsRemembered();
        int32 applied = Linear.applyCpuThreads(0);
        int32 cap = Device.cpuWorkerCap();
        CpuThreadProbeTest.dropStore();
        Assert.isTrue(remembered);
        Assert.equals(3, applied);
        Assert.equals(3, cap);
    }

    /** 15.2.14.8.1 — an explicit count is applied and never stored. */
    @Test
    public void anExplicitCountSkipsTheProbeAndIsNotStored() {
        if (!CpuThreadProbeTest.cpuHere()) { return; }
        CpuThreadProbeTest.useStore();
        int32 applied = Linear.applyCpuThreads(5);
        int32 cap = Device.cpuWorkerCap();
        boolean remembered = Linear.cpuThreadsRemembered();
        CpuThreadProbeTest.dropStore();
        Assert.equals(5, applied);
        Assert.equals(5, cap);
        Assert.isFalse(remembered);
    }

    /** 15.2.14.8.1 — the stored count does not depend on the worker cap in force when it is written or read. */
    @Test
    public void theStoredCountIsFoundWhateverTheCap() {
        if (!CpuThreadProbeTest.cpuHere()) { return; }
        CpuThreadProbeTest.useStore();
        Device.setCpuWorkerCap(5);
        Linear.rememberCpuThreads(3);
        Device.setCpuWorkerCap(7);
        boolean remembered = Linear.cpuThreadsRemembered();
        Device.setCpuWorkerCap(0);
        int32 applied = Linear.applyCpuThreads(0);
        CpuThreadProbeTest.dropStore();
        Assert.isTrue(remembered);
        Assert.equals(3, applied);
    }

    static #EngineOptions opts(String tune) {
        EngineOptions o #= heap EngineOptions(RoutableFixtureTest.FIX);
        o.ctx = 128;
        o.maxSeqs = 1;
        o.blockTokens = 16;
        o.chunk = 64;
        o.tuneDir #= tune.clone();
        return #o;
    }

    /** 15.2.14.8.1 — a first load times real decode steps at every candidate, leaves the cap at its answer and
     *  remembers it; a second load applies the answer without timing. */
    @Test
    public void theEngineTimesDecodeAtEveryCandidateOnceAndThenRecallsIt() {
        if (!CpuThreadProbeTest.cpuHere()) { return; }
        CpuThreadProbeTest.useStore();
        Linear.setTuneDir("");
        PrefillTap cap1 = heap PrefillTap();
        Diag.register(cap1);
        LlmEngine e1 #= LlmEngine.load(#CpuThreadProbeTest.opts("tmp/cpu-thread-probe-tune"));
        Diag.register(null);
        int32 pick = Device.cpuWorkerCap();
        int32 timed = cap1.countOf("cpu-threads");
        int32 nc = Linear.cpuThreadCandidateCount();
        boolean allTimed = nc > 0;
        boolean amongThem = false;
        int32 i = 0;
        while (i < nc) {
            if (Linear.cpuThreadDecodeNs(i) <= 0L) { allTimed = false; }
            if (Linear.cpuThreadCandidate(i) == pick) { amongThem = true; }
            i = i + 1;
        }
        e1.close();
        PrefillTap cap2 = heap PrefillTap();
        Diag.register(cap2);
        LlmEngine e2 #= LlmEngine.load(#CpuThreadProbeTest.opts("tmp/cpu-thread-probe-tune"));
        Diag.register(null);
        int32 again = Device.cpuWorkerCap();
        int32 timedAgain = cap2.countOf("cpu-threads");
        e2.close();
        Linear.setTuneDir("tmp/cpu-thread-probe-tune");
        CpuThreadProbeTest.dropStore();
        Assert.equals(nc, timed);
        Assert.isTrue(allTimed);
        Assert.isTrue(amongThem);
        Assert.equals(0, timedAgain);
        Assert.equals(pick, again);
    }

    /** 15.2.14.8.1 — with no tune store the engine takes the physical cores and times nothing. */
    @Test
    public void withoutAStoreTheEngineTakesThePhysicalCoresUntimed() {
        if (!CpuThreadProbeTest.cpuHere()) { return; }
        Device.setCpuWorkerCap(0);
        int32 physical = Device.multiprocessorCount();
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        LlmEngine e #= LlmEngine.load(#CpuThreadProbeTest.opts("off"));
        Diag.register(null);
        int32 used = Device.multiprocessorCount();
        int32 timed = cap.countOf("cpu-threads");
        e.close();
        Assert.equals(0, timed);
        Assert.equals(physical, used);
    }
}
