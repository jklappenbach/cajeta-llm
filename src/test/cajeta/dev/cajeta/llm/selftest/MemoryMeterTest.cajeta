package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.bench.MemoryMeter;

/** cajeta-llm 15.2.16.4: the bench's host and device memory figures (spec 12.11). */
public class MemoryMeterTest {

    public MemoryMeterTest() { return; }

    /** The host figure is the peak: it keeps a freed 64 MB allocation's level, within the
     *  kernel's approximate RSS counters (4 MB). */
    @Test
    public void theHostFigureIsThePeakNotTheCurrentLevel() {
        int64 rss0 = SafetensorsTest.rssKb();
        int64 held = MemoryMeterTest.touchAndMeasure(64);
        if (held - rss0 < 60000L) {
            Assert.fail("the 64 MB did not show in RSS: " + rss0 + " -> " + held + " KiB");
            return;
        }
        int64 after = SafetensorsTest.rssKb();
        if (after >= held - 32768L) {
            Assert.fail("the freed 64 MB stayed resident (" + after + " KiB), so peak and current agree");
            return;
        }
        int64 peak = MemoryMeter.hostPeakKb();
        if (peak < held - 4096L) {
            Assert.fail("host peak " + peak + " KiB is below the " + held + " KiB held");
        }
    }

    /** A 256 MB device buffer raises the device figure by at least 240 MB; the cpu backend's stays 0. */
    @Test
    public void aDeviceBufferShowsInTheDeviceFigure() {
        MemoryMeter m #= MemoryMeter.start();
        KernelBuffer<int8> b #= heap KernelBuffer<int8>((uint64) 268435456L);
        m.sample();
        b.free();
        if (Device.activeBackend().equals("cpu")) {
            Assert.equals(0L, m.devicePeakKb());
            return;
        }
        if (m.devicePeakKb() < 0L) {
            DeviceSkip.cannot("this box reports no device memory for " + Device.activeBackend());
            return;
        }
        if (m.devicePeakKb() < 240L * 1024L) {
            Assert.fail("device figure " + m.devicePeakKb() + " KiB after a 256 MB buffer (" + m.source() + ")");
        }
    }

    /** RSS in KiB while `mb` MiB of freshly touched heap is live. */
    static int64 touchAndMeasure(int32 mb) {
        int64 n = (int64) mb * 1048576L;
        int8[] a #= heap int8[n];
        int64 i = 0L;
        while (i < n) {
            a[i] = 1;
            i = i + 4096L;
        }
        return SafetensorsTest.rssKb();
    }
}
