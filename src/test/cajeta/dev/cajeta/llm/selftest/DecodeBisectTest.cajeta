package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Linear;

/**
 * A bisection instrument, not a gate: the routable fixture's decode, host
 * against device, under each route toggle turned off in turn, so a backend
 * whose device decode disagrees with its host decode names the stage
 * without a rebuild per guess. Prints one line per arm; asserts only that
 * the all-on device arm agrees, which is what the parity suite asserts.
 */
public final class DecodeBisectTest {

    static int32 STEPS = 4;

    static void walk(CausalLM m, int32[] p, int32[] out) {
        int32 cur = m.prefill(p, 8);
        int32 g = 0;
        while (g < DecodeBisectTest.STEPS) {
            out[g] = cur;
            int32[] one = heap int32[1];
            one[0] = cur;
            cur = m.stepSeq(0, one, 0, 1);
            g = g + 1;
        }
        out[DecodeBisectTest.STEPS] = cur;
        return;
    }

    static int32 agree(int32[] a, int32[] b) {
        int32 n = 0;
        int32 i = 0;
        while (i <= DecodeBisectTest.STEPS) {
            if (a[i] == b[i]) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    static #String toks(int32[] a) {
        String s = "";
        int32 i = 0;
        while (i <= DecodeBisectTest.STEPS) {
            s = s + (i > 0 ? "," : "") + a[i];
            i = i + 1;
        }
        return #s.substring(0, s.byteLength());
    }

    static void arm(String name, int32[] p, int32[] host) {
        CausalLM m #= RoutableFixtureTest.mk(1);
        int32[] dev = heap int32[DecodeBisectTest.STEPS + 1];
        DecodeBisectTest.walk(m, p, dev);
        String dt #= DecodeBisectTest.toks(dev);
        System.stdout.println("  bisect " + name + ": agree "
            + DecodeBisectTest.agree(host, dev) + " of " + (DecodeBisectTest.STEPS + 1)
            + "  device " + dt);
        return;
    }

    @Test
    public void whichStageBreaksTheDeviceDecodeHere() {
        CausalLM probe #= RoutableFixtureTest.mk(1);
        if (!RoutableFixtureTest.deviceHere(probe)) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32[] p #= RoutableFixtureTest.promptOf(8, 3);
        QuantKernel.setRoutingEnabled(false);
        CausalLM h #= RoutableFixtureTest.mk(1);
        int32[] host = heap int32[DecodeBisectTest.STEPS + 1];
        DecodeBisectTest.walk(h, p, host);
        QuantKernel.setRoutingEnabled(true);
        String ht #= DecodeBisectTest.toks(host);
        System.stdout.println("  bisect host: " + ht + " on " + Device.activeBackend());

        DecodeBisectTest.arm("all on", p, host);
        AttnKernel.setFlashDecode(false);
        DecodeBisectTest.arm("flash decode off", p, host);
        AttnKernel.setFlashDecode(true);
        AttnKernel.setReducePack(false);
        DecodeBisectTest.arm("reduce pack off", p, host);
        AttnKernel.setReducePack(true);
        CausalLM.setFuseTail(false);
        DecodeBisectTest.arm("fuse tail off", p, host);
        CausalLM.setFuseTail(true);
        Linear.setFuse(false);
        DecodeBisectTest.arm("fuse off", p, host);
        Linear.setFuse(true);
        Linear.setFusedQkv(false);
        DecodeBisectTest.arm("fused qkv off", p, host);
        Linear.setFusedQkv(true);
        CausalLM.setDevAttn(false);
        DecodeBisectTest.arm("device attention off", p, host);
        CausalLM.setDevAttn(true);
        Linear.setDeviceResident(false);
        DecodeBisectTest.arm("device resident off", p, host);
        Linear.setDeviceResident(true);
        Linear.setWaveMatVec(false);
        DecodeBisectTest.arm("wave mat-vec off", p, host);
        Linear.setWaveMatVec(true);
        CausalLM.setDeviceArgmax(false);
        DecodeBisectTest.arm("device argmax off", p, host);
        CausalLM.setDeviceArgmax(true);
        CausalLM.setDeviceAttention(false);
        DecodeBisectTest.arm("device attention (causal) off", p, host);
        CausalLM.setDeviceAttention(true);
        CausalLM dev #= RoutableFixtureTest.mk(1);
        int32[] d = heap int32[DecodeBisectTest.STEPS + 1];
        DecodeBisectTest.walk(dev, p, d);
        Assert.equals((int64) (DecodeBisectTest.STEPS + 1),
            (int64) DecodeBisectTest.agree(host, d));
    }
}
