package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelManifest;
import dev.cajeta.llm.model.KernelCap;

/**
 * The kernel census gate (cajeta xpu-kernel-adaptor plan, Unit 6).
 *
 * A green suite says every assertion held. It does not say which kernels
 * the assertions were about: a route that picked another variant, a launch
 * the runtime refused, or a device arm that skipped all leave the pass
 * count where it was, and the kernel nobody reached reads as covered.
 * The runtime now keeps one number per kernel name, launches that were not
 * refused, and enumerates the registry the launch consults. This gate runs
 * after the suite and, for EVERY registered kernel on the active backend,
 * requires one of three things:
 *
 *   CHECKED  it launched under a test that then compared its output
 *            against a reference (ValueCheck.credit);
 *   RAN-UNCHECKED  it launched, and no test compared what it produced. A
 *            launch proves the kernel did not crash, not that it answered
 *            right: on 2026-09-27 cpu kernels RAN for the first time and
 *            answered wrong. This fails the suite unless the kernel is named
 *            in `unchecked` with the plan item that will give it a check;
 *   SKIP     it is named below with the plan item that will make it run,
 *            and it did NOT run (a named kernel that ran is STALE and fails,
 *            so the list cannot rot);
 *   PROBE    it is a measurement kernel (dev.cajeta.llm.bench, or the three
 *            roofline probes that live in QuantKernel), which the suite does
 *            not run and which is not a shipped kernel; listed so it stays
 *            visible, never counted as covered.
 *   EXTERNAL it is a cajeta stdlib kernel (cajeta.math.Ewise and friends)
 *            that this library links; cajeta's own suites gate it, and it is
 *            named one by one so a new stdlib kernel shows up UNCOVERED here
 *            until someone confirms it is theirs.
 *
 * Anything else is UNCOVERED and fails the suite. The gate also fails when
 * NOTHING ran, so an empty census cannot read as a clean one.
 */
public final class KernelCensus {

    public KernelCensus() { return; }

    /**
     * The plan item that retires a kernel's skip, or "" when the kernel is
     * expected to run. Keep this an explicit chain: it is meant to be read.
     */
    /**
     * MEASURED 2026-09-24, the cpu backend: the kernels that ran on cuda and
     * not here. 117 at first; 63 after the coop guards were lifted the same
     * day and 54 coop tiles ran on cpu and PASSED against the host oracle
     * (1.6.3: those guards were stale). One cause: the suites' device arms skip on cpu by
     * guard (`be.equals("cpu")` -> "[device-skip] ... has no coop kernel"),
     * which is plan item 1.6 — the inventory was 87 in-test skips across 19
     * suites on 2026-09-19. Since 4A the cpu backend LOWERS the coop kernels,
     * so most guards are stale. Each name here is SKIP on cpu under 1.6.4
     * until its guard lifts; the day a test reaches one, the entry is STALE
     * and this list shrinks. Not consulted on any other backend.
     *
     * EMPTY since 2026-09-30: the last twenty names (the packs, preps,
     * norms, rope, the flash decode reduce, the MoE group/scatter/combine
     * utilities, the id mat-vec, the router batch and the two F16 coop id
     * tiles) were reached the first cpu leg after the wave-32 kernels ran
     * at their declared width (12.2.7) and every one read STALE. The list
     * stays as the place a guarded cpu skip is recorded, should one return.
     */
    static final String CPU_GUARDED = "||";

    /**
     * `key` is `backend + ":" + name`, one parameter, because a
     * multi-parameter function cannot return a borrowed String (the compiler
     * cannot tell whose lifetime the literal would inherit).
     */
    static String tracked(String key) {
        int64 colon = key.indexOf(":");
        if (colon > 0L) {
            String wrong #= KernelCap.wrongHere(key.substring((int32) colon + 1, (int32) key.count()));
            if (wrong.count() > 0L) {
                return wrong + ": lowers here and is measured wrong (KernelCap.WRONG_HERE); "
                    + "closed to every route and test until the item closes";
            }
        }
        if (key.startsWith("cpu:")
                && KernelCensus.CPU_GUARDED.contains("|" + key.substring(4, (int32) key.count()) + "|")) {
            return "xpu-kernel-adaptor 1.6.4: the suite's device arms skip on cpu by "
                + "guard; lift it where the cpu backend lowers the kernel (4A), or "
                + "classify it 'the backend truly cannot' (1.6.3)";
        }
        if (key.equals("cpu:q6kScaleImageKernel")) {
            return "xpu-kernel-adaptor 4.2.1: reached only by MoeIdMw8Test."
                + "q6kWideWidenedIdAgreesWithThePackedChunkId, which skips on cpu "
                + "because q6kWmmaIdMwKernel (fromWords) does not lower there";
        }
        if (key.endsWith(":splitKernel")) {
            return "xpu-kernel-adaptor 6.4.1: the byte-wise split is unreachable, "
                + "every split format is dword-addressable (CensusReachTest pins "
                + "the sweep); remove it or give it a format";
        }
        if (key.endsWith(":q6kQ8IdMatVecKernel") || key.endsWith(":q6kQ8IdDownCombineKernel")) {
            return "xpu-kernel-adaptor 6.4.2: the Q6_K packed-chunk MoE id kernels "
                + "need a Q6_K expert-bank fixture; MoeIdKernelTest only builds Q4_K";
        }
        return "";
    }

    /**
     * The plan item that will give a kernel a value check, or "" when some
     * test must already compare its output. Consulted only for kernels that
     * RAN; a named kernel that is CHECKED is STALE and fails, as for skips.
     */
    static String unchecked(String key) {
        // Measured on the first complete censuses after the sweep (cpu and
        // cuda, 2026-09-28): these RAN with no test comparing their output
        // against a reference. Keyed per backend where the fact is per
        // backend: the batched routes have host-oracle brackets that run on
        // cuda and skip on cpu, so the same kernel is CHECKED there and not
        // here. Each entry leaves when a host-oracle bracket lands.
        // (xpu-kernel-adaptor 6.4.8)
        // q4kWmmaKernel and q6kWmmaEpiKernel left this list 2026-09-29: the
        // route tests that credit them run on cpu since the wave mat-vec
        // family lowers there (Unit 9).
        // q4kQ8BatchMatMulKernel (cpu) and q6kQ8BatchMatMulKernel (both) left
        // this list 2026-09-30: BatchGemmTest holds each to the host's
        // dequantized GEMM on every backend (xpu-kernel-adaptor 11.1.1).
        // addBiasRowsF32 and axpbyF32 (cpu) left this list 2026-09-30: the
        // batched-route tests run on cpu since packed activations became a
        // capability there (12.2.7). symWmmaDeqIdMw8Kernel (cpu) left it the
        // same day: closed by name (KernelCap.WRONG_HERE, 6.4.4), it no longer
        // runs there.
        // q4kWmmaIdMw8Kernel is held to the host by MoeIdMw8Test
        // .q4kWideIdMatchesTheHostDequantGemm on every backend (2026-09-30):
        // the resident MoE route launches it on cpu, where its comparison
        // against the chunk id kernel (fromWords) cannot run.
        if (key.endsWith(":q6kWmmaKernel") || key.endsWith(":q4kWmmaEpiKernel")
                || (key.endsWith(":q4kWmmaDeqKernel") && !key.equals("cpu:q4kWmmaDeqKernel"))
                || key.endsWith(":q4kWmmaDeqEpiKernel")
                || key.endsWith(":q4kWmmaDeqMw4Kernel") || key.endsWith(":q4kWmmaDeqN4Kernel")
                || key.endsWith(":q4kWmmaDeqT2Kernel")
                || key.endsWith(":q4kWmmaMwKernel")) {
            return "xpu-kernel-adaptor 6.4.8: the staged WMMA kernels are judged only "
                + "against the batch GEMMs";
        }
        // q4kWmmaIdEpiKernel and moeCombineAddKernel are CHECKED on cpu since
        // 2026-09-30: the resident route takes the epi id arm there (the
        // 64-row Mw kernel does not lower on cpu) under host-compared tests.
        // On cuda the route takes the Mw arm and they stay unchecked.
        if (key.endsWith(":q4kWmmaIdKernel") || key.endsWith(":q6kWmmaIdKernel")
                || key.equals("cuda:q4kWmmaIdEpiKernel") || key.endsWith(":q6kWmmaIdEpiKernel")
                || key.endsWith(":q6kWmmaIdMwKernel") || key.endsWith(":q6kScaleImageKernel")) {
            return "xpu-kernel-adaptor 6.4.8: the spill-id tiles are the oracle their "
                + "Epi and Mw variants are judged against, and have no host oracle";
        }
        if (key.endsWith(":rmsnormF32") || key.endsWith(":attendF16")
                || key.endsWith(":qkNormRowsF32") || key.equals("cuda:moeCombineAddKernel")
                || (key.equals("cpu:moeCombineAddKernel") && KernelCap.usable("q4kQ8IdDownCombineKernel"))
                || key.endsWith(":routeHistKernel")) {
            return "xpu-kernel-adaptor 6.4.8: a utility kernel reached only inside a "
                + "larger comparison whose bracket sits elsewhere; bracket it directly";
        }
        return "";
    }

    /**
     * Bench-probe kernels, declared in dev.cajeta.llm.bench and run by hand.
     * Named one by one, from `grep -A2 @Kernel src/main/.../bench`, so a new
     * probe kernel shows up UNCOVERED until someone adds it here on purpose.
     * `q4kF16CoopKernel` is NOT here: the bench redeclares that name, but it
     * is a shipped QuantKernel kernel and the suite must reach it.
     */
    static boolean probe(String name) {
        if (name.equals("coopLayoutProbeKernel")) { return true; }
        if (name.equals("f32MatVecKernel")) { return true; }
        if (name.equals("f32ToF16Kernel")) { return true; }
        if (name.equals("flatReadKernel")) { return true; }
        if (name.equals("ldsDotKernel")) { return true; }
        if (name.equals("mmaF16Kernel")) { return true; }
        if (name.equals("mmaI8Kernel")) { return true; }
        if (name.equals("q4kF16CoopC7Kernel")) { return true; }
        if (name.equals("q4kF16CoopCAKernel")) { return true; }
        if (name.equals("q4kF16CoopCBKernel")) { return true; }
        if (name.equals("q4kF16CoopCLKernel")) { return true; }
        if (name.equals("q4kF16CoopCeilKernel")) { return true; }
        if (name.equals("q4kF16CoopV1Kernel")) { return true; }
        if (name.equals("q4kF16CoopV7Kernel")) { return true; }
        if (name.equals("skewReadKernel")) { return true; }
        if (name.equals("streamReadKernel")) { return true; }
        if (name.equals("tileMmaKernel")) { return true; }
        if (name.equals("tileSplatKernel")) { return true; }
        if (name.equals("wideReadKernel")) { return true; }
        // The roofline and ceiling probes that live in QuantKernel itself:
        // pure dotAccum throughput, a bandwidth read of a row, and the
        // Unit 55 prefetch touch that only HeadProbe issues.
        if (name.equals("dotCeilingKernel")) { return true; }
        if (name.equals("rowReadKernel")) { return true; }
        if (name.equals("touchLinesKernel")) { return true; }
        return false;
    }

    /**
     * cajeta stdlib kernels this library links (cajeta.math.Ewise, the FFT,
     * the random generator, the xpu samples). Listed from
     * `grep -A3 @Kernel runtime/src/cajeta` on cajeta main, 2026-09-24.
     */
    static boolean external(String name) {
        if (name.equals("arithBf16") || name.equals("arithF16") || name.equals("arithF32")) { return true; }
        if (name.equals("bincountI32") || name.equals("bitonicStepF32")) { return true; }
        if (name.equals("copyRangeF32") || name.equals("cropBf16") || name.equals("cropF32")) { return true; }
        if (name.equals("fftStageF32") || name.equals("gatherF32") || name.equals("scatterF32")) { return true; }
        if (name.equals("matmulBf16") || name.equals("matmulBf16Wide") || name.equals("matmulF16")) { return true; }
        if (name.equals("matmulF32") || name.equals("matmulF64") || name.equals("matmulI8")) { return true; }
        if (name.equals("narrowF32ToBf16")) { return true; }
        if (name.equals("padBf16") || name.equals("padF16") || name.equals("padF32")) { return true; }
        if (name.equals("philoxUniformF32") || name.equals("rotate") || name.equals("saxpy")) { return true; }
        if (name.equals("reduceMaxF32") || name.equals("reduceMinF32")) { return true; }
        if (name.equals("reduceSumBf16") || name.equals("reduceSumF16") || name.equals("reduceSumF32")) { return true; }
        if (name.equals("reduceSumSqF32") || name.equals("scanStepF32")) { return true; }
        return false;
    }

    /** Prints the census and returns 0 when it holds, 1 when it does not. */
    public static int32 gate() {
        String backend #= Device.activeBackend();
        int32 n = Device.registeredKernelCount();
        int32 ran = 0;
        int32 checked = 0;
        int32 unverified = 0;
        int32 excused = 0;
        int32 skipped = 0;
        int32 probes = 0;
        int32 external = 0;
        int32 uncovered = 0;
        int32 stale = 0;
        int32 noManifest = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            int64 launches = Device.kernelLaunchCount(name);
            String key #= backend + ":" + name;
            String why #= KernelCensus.tracked(key);
            // The has-manifest column (plan 3.1.1, 4.3.2): a registered kernel
            // with no manifest on this backend lowered without describing
            // itself, so KernelManifest.of(name) -- and everything keyed on it,
            // tuneBuildId first -- answers null for it.
            KernelManifest m #= KernelManifest.of(name);
            String manifestCol = "manifest";
            if (m == null) {
                noManifest = noManifest + 1;
                manifestCol = "no-manifest";
            }
            String cls = "";
            if (launches > 0L) {
                if (why.count() > 0L) {
                    stale = stale + 1;
                    cls = "STALE-SKIP";
                    System.stdout.println("  STALE-SKIP " + name + " ran " + launches
                        + " time(s); drop its entry (" + why + ")");
                } else {
                    ran = ran + 1;
                    String owe #= KernelCensus.unchecked(key);
                    if (ValueCheck.checks(name) > 0L) {
                        checked = checked + 1;
                        cls = "CHECKED";
                        if (owe.count() > 0L) {
                            stale = stale + 1;
                            cls = "STALE-UNCHECKED";
                            System.stdout.println("  STALE-UNCHECKED " + name
                                + " is value-checked now; drop its entry (" + owe + ")");
                        }
                    } else if (owe.count() > 0L) {
                        excused = excused + 1;
                        cls = "RAN-UNCHECKED";
                        why #= owe;
                        System.stdout.println("  RAN-UNCHECKED " + name + ": " + owe);
                    } else {
                        unverified = unverified + 1;
                        cls = "RAN-UNCHECKED";
                        System.stdout.println("  RAN-UNCHECKED " + name + " launched " + launches
                            + " time(s) and no test compared its output against a reference");
                    }
                }
            } else if (why.count() > 0L) {
                skipped = skipped + 1;
                cls = "SKIP";
                System.stdout.println("  SKIP       " + name + ": " + why);
            } else if (KernelCensus.probe(name)) {
                probes = probes + 1;
                cls = "PROBE";
                System.stdout.println("  PROBE      " + name + " (measurement kernel, not a shipped kernel)");
            } else if (KernelCensus.external(name)) {
                external = external + 1;
                cls = "EXTERNAL";
                System.stdout.println("  EXTERNAL   " + name + " (cajeta stdlib; gated by cajeta's own suites)");
            } else {
                uncovered = uncovered + 1;
                cls = "UNCOVERED";
                System.stdout.println("  UNCOVERED  " + name);
            }
            // One machine-readable row per registered kernel (plan 3.2.2):
            // run-tests.sh collects these into build/census-<backend>.tsv.
            System.stdout.println("census-row\t" + backend + "\t" + name + "\t" + cls
                + "\t" + launches + "\t" + ValueCheck.checks(name) + "\t" + manifestCol + "\t" + why);
            i = i + 1;
        }
        System.stdout.println("kernel census (" + backend + "): registered " + n
            + ", ran " + ran + " (value-checked " + checked + ", unchecked and tracked " + excused
            + ", unchecked and untracked " + unverified + "), tracked skips " + skipped + ", probes " + probes
            + ", external " + external + ", uncovered " + uncovered
            + ", stale skips " + stale + ", without manifest " + noManifest);
        if (ran == 0) {
            System.stdout.println("KERNEL CENSUS: nothing ran on " + backend
                + " — an empty census is not a clean one");
            return 1;
        }
        if (uncovered > 0 || stale > 0 || unverified > 0) {
            System.stdout.println("KERNEL CENSUS: " + uncovered + " uncovered, " + unverified
                + " ran without a value check, " + stale
                + " stale entr(ies) on " + backend + " — failing the suite (Unit 6)");
            return 1;
        }
        return 0;
    }
}
