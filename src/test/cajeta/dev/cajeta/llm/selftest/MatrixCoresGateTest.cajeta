package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Linear;
import cajeta.lang.String;
import cajeta.math.Tensor;
import cajeta.xpu.Device;

/** cajeta-llm 15.2.14.1: a chunk that tiles takes a matrix-core route only where the matrix cores pay. */
public class MatrixCoresGateTest {

    public MatrixCoresGateTest() { return; }

    /** The batch route a `rows`-row chunk of a `ty` projection takes with matrixCoresPay pinned to `pay`. */
    static #String routeAt(int32 ty, String fixture, int32 pay, int32 rows) {
        Linear lin #= LinearKernelRouteTest.tiled(ty, fixture);
        Tensor<float32> x #= LinearKernelRouteTest.ramp(
            (int64) rows * (int64) LinearKernelRouteTest.CI, 0L);
        Tensor<float32> y #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * (int64) LinearKernelRouteTest.CO);
        QuantKernel.setRoutingEnabled(true);
        Linear.setMatrixCoresPay(pay);
        Linear.stageBatch(x, 0L, rows, LinearKernelRouteTest.CI, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap tap = heap PrefillTap();
        Diag.register(tap);
        lin.matmulInto(rows, y, 0L);
        Diag.register(null);
        Linear.setMatrixCoresPay(0);
        return tap.namesOf("batch-route");
    }

    /** Whether `r` names dotAccum and none of the `f` (q4 or q6) matrix-core routes. */
    static boolean dotAccumOnly(String r, String f) {
        if (r.indexOf("[dotAccum") < 0L) { return false; }
        if (r.indexOf("[" + f + " plain]") >= 0L || r.indexOf("[" + f + " epi]") >= 0L) { return false; }
        if (r.indexOf("[" + f + " deq") >= 0L || r.indexOf("[" + f + " mw]") >= 0L) { return false; }
        return r.indexOf("[" + f + " tcTile]") < 0L;
    }

    /** Vulkan never takes these routes, so neither arm says anything there. */
    static boolean routedHere() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return false; }
        if (be.equals("vulkan")) {
            DeviceSkip.tracked("vulkan takes no wmma or deq batch route", "cajeta-llm 15.2.14.1");
            return false;
        }
        return true;
    }

    /** FIRES: where the matrix cores do not pay, a 16- or 128-row Q4_K or Q6_K chunk takes dotAccum. */
    @Test
    public void aTilingChunkTakesDotAccumWhereMatrixCoresDoNotPay() {
        if (!MatrixCoresGateTest.routedHere()) { return; }
        int32 rows = 16;
        while (rows <= 128) {
            String r4 #= MatrixCoresGateTest.routeAt(Quant.GG_Q4_K, "q4_k.bin", 2, rows);
            if (!MatrixCoresGateTest.dotAccumOnly(r4, "q4")) {
                Assert.fail("q4_k at " + rows + " rows with no matrix-core pay routed " + r4);
            }
            String r6 #= MatrixCoresGateTest.routeAt(Quant.GG_Q6_K, "q6_k.bin", 2, rows);
            if (!MatrixCoresGateTest.dotAccumOnly(r6, "q6")) {
                Assert.fail("q6_k at " + rows + " rows with no matrix-core pay routed " + r6);
            }
            rows = rows + 112;
        }
    }

    /** DOES NOT FIRE: where the matrix cores pay, a 128-row Q4_K chunk keeps a matrix-core route. */
    @Test
    public void aTilingChunkKeepsTheMatrixCoreRouteWhereTheyPay() {
        if (!MatrixCoresGateTest.routedHere()) { return; }
        String r #= MatrixCoresGateTest.routeAt(Quant.GG_Q4_K, "q4_k.bin", 1, 128);
        if (r.indexOf("[dotAccum") >= 0L) {
            Assert.fail("q4_k at 128 rows with matrix-core pay routed " + r);
        }
    }
}
