package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.KernelCap;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;

/**
 * cajeta-llm 15.2.12.3.6: the Cols mat-vec sweep. Prints every shipped variant's device
 * time at the gate and 4096-row shapes, and the launch floor at a 64-row shape, so a
 * kernel change or a backend can be read against llama.cpp's mmvq in one run.
 */
public class ColsVariantSweepTest {

    public ColsVariantSweepTest() { return; }

    static boolean here() {
        if (!CensusReachTest.deviceHere()) { return false; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q4kQ8WaveR2MatVecColsKernel")) { DeviceSkip.noKernel("q4kQ8WaveR2MatVecColsKernel", be); return false; }
        return true;
    }

    @Test
    public void everyArmTimesAtTheGateAndSmallShapes() {
        if (!ColsVariantSweepTest.here()) { return; }
        int64[] g #= QuantKernel.probeColsTimes(Quant.GG_Q4_K, 14336L, 4096L, 4, 3);
        int64[] s #= QuantKernel.probeColsTimes(Quant.GG_Q4_K, 4096L, 4096L, 4, 3);
        int64[] kv #= QuantKernel.probeColsTimes(Quant.GG_Q4_K, 1024L, 4096L, 4, 2);
        int64[] f #= QuantKernel.probeColsTimes(Quant.GG_Q4_K, 64L, 4096L, 4, 2);
        System.stdout.println("  q4k cols arms us (prefetch, plain, two-row) at 14336x4096x4: "
            + (g[1] / 1000L) + " " + (g[2] / 1000L) + " " + (g[3] / 1000L)
            + "; at 4096x4096x4: " + (s[1] / 1000L) + " " + (s[2] / 1000L) + " " + (s[3] / 1000L)
            + "; at 1024x4096x4: " + (kv[1] / 1000L) + " " + (kv[2] / 1000L)
            + "; launch floor at 64x4096x4: " + (f[1] / 1000L) + " " + (f[2] / 1000L));
        int32 a = 1;
        while (a <= 3) {
            Assert.isTrue(g[a] > 0L);
            Assert.isTrue(s[a] > 0L);
            a = a + 1;
        }
        Assert.isTrue(kv[1] > 0L && kv[2] > 0L && f[1] > 0L && f[2] > 0L);
    }
}
