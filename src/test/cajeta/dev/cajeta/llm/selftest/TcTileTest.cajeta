package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Autotune;
import cajeta.xpu.KernelStream;
import cajeta.xpu.DeviceFacts;
import cajeta.xpu.KernelFacts;
import cajeta.xpu.ShapeCandidate;
import cajeta.xpu.ShapeFilter;
import dev.cajeta.llm.io.Q4ShapeProbe;
import cajeta.xpu.Device;
import cajeta.xpu.ShapeChoice;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.TcTile;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The tensor-core prefill tiles (xpu-kernel-adaptor 1.8.3): Q4_K weights
 * straight from the packed bytes, staged as int8 in shared memory once per
 * workgroup, against the q8_K activation stage, held to the HOST's
 * dequantized GEMM at the batch GEMMs' bar (1% relative, 0.01 absolute).
 * Two shapes: the smallest tile the kernel admits (128 tokens x 128 rows x
 * 256 k) and a ragged-in-every-dimension one (256 x 384 x 1024), so a
 * tile indexing that was right at one workgroup and wrong at the second
 * shows. Every token row live.
 */
public class TcTileTest {

    public TcTileTest() { return; }

    static void check(int64 rows, int64 out, int64 cols) {
        TcTileTest.checkAs(TcTile.Q4_KERNEL, rows, out, cols);
    }

    /** The Q4_K tile held to the host GEMM, with `kernel` the family member
     *  the launch is expected to take: the guard asks for THAT member, so a
     *  backend where the default member does not lower (gfx1151's 64 KB of
     *  LDS refuses the 128x128 one) still checks the members it registers.
     *  Guarding on the default left QkTile_64 UNCOVERED on hip (Proton,
     *  2026-10-09). */
    static void checkAs(String kernel, int64 rows, int64 out, int64 cols) {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        int8[] raw #= CensusReachTest.tiled(Quant.GG_Q4_K, "q4_k.bin", nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        float32[] want #= CensusReachTest.hostGemm(Quant.GG_Q4_K, raw, nBlocks, x, rows, out, cols);
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
        wD.upload(raw);
        int64[] vc #= ValueCheck.mark();
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        float32[] got #= heap float32[rows * out];
        yD.upload(got);
        Assert.isTrue(TcTile.fits(rows, out, cols));
        TcTile.q4kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
        QuantKernel.stream().sync();
        yD.download(got);
        int64 t = 0;
        while (t < rows) {
            boolean live = false;
            int64 i = 0;
            while (i < out) {
                if (got[t * out + i] != 0.0f) { live = true; }
                i = i + 1;
            }
            if (!live) {
                Assert.fail(kernel + " at " + rows + "x" + out + "x" + cols
                    + ": token row " + t + " is entirely zero");
                return;
            }
            t = t + 1;
        }
        CensusReachTest.nearOnePercent(want, got, rows * out,
            kernel + " at " + rows + "x" + out + "x" + cols);
        ValueCheck.credit(vc);
    }

    static void check6(int64 rows, int64 out, int64 cols) {
        TcTileTest.check6As(TcTile.Q6_KERNEL, rows, out, cols);
    }

    /** The Q6_K tile over the resident (split) payload, held to the host
     *  GEMM over the file blocks, with `kernel` the family member the launch
     *  is expected to take (as {@link #checkAs} for Q4_K). */
    static void check6As(String kernel, int64 rows, int64 out, int64 cols) {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        int8[] raw #= CensusReachTest.tiled(Quant.GG_Q6_K, "q6_k.bin", nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        float32[] want #= CensusReachTest.hostGemm(Quant.GG_Q6_K, raw, nBlocks, x, rows, out, cols);
        int8[] res #= heap int8[out * Quant.rowResidentBytes(Quant.GG_Q6_K, bpr)];
        Quant.splitInto(Quant.GG_Q6_K, raw, 0L, out, bpr, res, 0L);
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) res.count()));
        wD.upload(res);
        int64[] vc #= ValueCheck.mark();
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        float32[] got #= heap float32[rows * out];
        yD.upload(got);
        Assert.isTrue(TcTile.fits6(rows, out, cols));
        TcTile.q6kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
        QuantKernel.stream().sync();
        yD.download(got);
        int64 t = 0;
        while (t < rows) {
            boolean live = false;
            int64 i = 0;
            while (i < out) {
                if (got[t * out + i] != 0.0f) { live = true; }
                i = i + 1;
            }
            if (!live) {
                Assert.fail(kernel + " at " + rows + "x" + out + "x" + cols
                    + ": token row " + t + " is entirely zero");
                return;
            }
            t = t + 1;
        }
        CensusReachTest.nearOnePercent(want, got, rows * out,
            kernel + " at " + rows + "x" + out + "x" + cols);
        ValueCheck.credit(vc);
    }

    @Test
    public void q6kTcTileMatchesHostDequantAtOneTile() {
        TcTileTest.check6(128L, 128L, 2048L);
    }

    @Test
    public void q6kTcTileMatchesHostDequantAcrossTiles() {
        TcTileTest.check6(256L, 384L, 4096L);
    }

    @Test
    public void theQ6TileRefusesAnUnalignedBlockCount() {
        Assert.isFalse(TcTile.fits6(128L, 128L, 256L));
        Assert.isFalse(TcTile.fits6(128L, 128L, 1024L));
        Assert.isTrue(TcTile.fits6(512L, 4096L, 14336L));
        Assert.isTrue(TcTile.fits6(512L, 1024L, 4096L));
    }

    /** Split-K (1.8.3): a forced 4-way split of a shape that needs none
     *  lands the same product, so the partials, the arrival count and
     *  the last arriver's fold are exercised on a grid where every tile
     *  has four contributors; and the counters are left at zero, so a
     *  second split launch is right too. */
    static void checkSplit(int32 ty, int64 rows, int64 out, int64 cols) {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        String kn #= TcTile.Q6_KERNEL.clone();
        if (ty == Quant.GG_Q4_K) { kn #= TcTile.Q4_KERNEL.clone(); }
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(kn)) { DeviceSkip.noKernel(kn, be); return; }
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        String fx #= ty == Quant.GG_Q4_K ? "q4_k.bin" : "q6_k.bin";
        int8[] raw #= CensusReachTest.tiled(ty, fx, nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        float32[] want #= CensusReachTest.hostGemm(ty, raw, nBlocks, x, rows, out, cols);
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) 1);
        if (Quant.splitOn(ty)) {
            int8[] res #= heap int8[out * Quant.rowResidentBytes(ty, bpr)];
            Quant.splitInto(ty, raw, 0L, out, bpr, res, 0L);
            KernelBuffer<int8> wS #= heap KernelBuffer<int8>((uint64) ((int64) res.count()));
            wS.upload(res);
            wD #= wS;
        } else {
            KernelBuffer<int8> wR #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
            wR.upload(raw);
            wD #= wR;
        }
        int64[] vc #= ValueCheck.mark();
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        float32[] got #= heap float32[rows * out];
        TcTile.setSplitOverride(4L);
        int32 pass = 0;
        while (pass < 2) {
            yD.upload(got);
            if (ty == Quant.GG_Q4_K) {
                TcTile.q4kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
            } else {
                TcTile.q6kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
            }
            QuantKernel.stream().sync();
            yD.download(got);
            CensusReachTest.nearOnePercent(want, got, rows * out,
                kn + " split 4 at " + rows + "x" + out + "x" + cols + " pass " + pass);
            pass = pass + 1;
        }
        TcTile.setSplitOverride(0L);
        ValueCheck.credit(vc);
    }

    /** The ACCUMULATING launch (1.8.3): `y += W x` into a prefilled
     *  output, the residual add folded into the tile's epilogue. Held to
     *  the host GEMM plus the prefill at the batch GEMMs' bar, unsplit and
     *  under a forced 4-way split (where the fixup adds the partials to
     *  the prefill), twice each, so a launch that zeroed the output or
     *  added it twice shows. */
    static void checkAccum(int32 ty, int64 rows, int64 out, int64 cols, int64 split) {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        String kn #= TcTile.Q6_KERNEL.clone();
        if (ty == Quant.GG_Q4_K) { kn #= TcTile.Q4_KERNEL.clone(); }
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(kn)) { DeviceSkip.noKernel(kn, be); return; }
        if (!KernelCap.usable("tcSplitFixupKernel")) { DeviceSkip.noKernel("tcSplitFixupKernel", be); return; }
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        String fx #= ty == Quant.GG_Q4_K ? "q4_k.bin" : "q6_k.bin";
        int8[] raw #= CensusReachTest.tiled(ty, fx, nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        float32[] want #= CensusReachTest.hostGemm(ty, raw, nBlocks, x, rows, out, cols);
        float32[] pre #= heap float32[rows * out];
        int64 e = 0;
        while (e < rows * out) {
            pre[e] = 0.25f * (float32) ((e * 7L) % 13L) - 1.5f;
            want[e] = want[e] + pre[e];
            e = e + 1L;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) 1);
        if (Quant.splitOn(ty)) {
            int8[] res #= heap int8[out * Quant.rowResidentBytes(ty, bpr)];
            Quant.splitInto(ty, raw, 0L, out, bpr, res, 0L);
            KernelBuffer<int8> wS #= heap KernelBuffer<int8>((uint64) ((int64) res.count()));
            wS.upload(res);
            wD #= wS;
        } else {
            KernelBuffer<int8> wR #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
            wR.upload(raw);
            wD #= wR;
        }
        int64[] vc #= ValueCheck.mark();
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        float32[] got #= heap float32[rows * out];
        TcTile.setSplitOverride(split);
        int32 pass = 0;
        while (pass < 2) {
            yD.upload(pre);
            if (ty == Quant.GG_Q4_K) {
                TcTile.q4kQ8TcTileAccumNoSync(yD, wD, xp, rows, out, cols);
            } else {
                TcTile.q6kQ8TcTileAccumNoSync(yD, wD, xp, rows, out, cols);
            }
            QuantKernel.stream().sync();
            yD.download(got);
            CensusReachTest.nearOnePercent(want, got, rows * out,
                kn + " accumulating, split " + split + ", at " + rows + "x" + out
                + "x" + cols + " pass " + pass);
            pass = pass + 1;
        }
        TcTile.setSplitOverride(0L);
        ValueCheck.credit(vc);
    }

    @Test
    public void q4kTileAccumulatesIntoTheOutput() {
        TcTileTest.checkAccum(Quant.GG_Q4_K, 256L, 384L, 1024L, 1L);
    }

    @Test
    public void q4kTileAccumulatesIntoTheOutputUnderASplit() {
        TcTileTest.checkAccum(Quant.GG_Q4_K, 256L, 384L, 1024L, 4L);
    }

    @Test
    public void q6kTileAccumulatesIntoTheOutput() {
        TcTileTest.checkAccum(Quant.GG_Q6_K, 256L, 256L, 2048L, 1L);
    }

    @Test
    public void q6kTileAccumulatesIntoTheOutputUnderASplit() {
        TcTileTest.checkAccum(Quant.GG_Q6_K, 256L, 256L, 2048L, 4L);
    }

    /** At the engine's own shape (512 tokens, the 4096x14336 ffn_down),
     *  where the measured split is 1, forced splits of 2 and 4 agree with
     *  the unsplit launch to float rounding. The host GEMM at this size is
     *  too slow to be the oracle; the unsplit launch, held to the host at
     *  the shapes above, is. */
    @Test
    public void q4kSplitKAgreesWithTheUnsplitLaunchAtTheEngineShape() {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(TcTile.Q4_KERNEL)) { DeviceSkip.noKernel(TcTile.Q4_KERNEL, be); return; }
        if (!Linear.matrixCoresPay()) {
            DeviceSkip.tracked("the tile is the software tile on " + be
                + "; the engine shape is not run on it", "xpu-kernel-adaptor 1.8.3");
            return;
        }
        int64 rows = 512L;
        int64 out = 4096L;
        int64 cols = 14336L;
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        int8[] raw #= CensusReachTest.tiled(Quant.GG_Q4_K, "q4_k.bin", nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
        wD.upload(raw);
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        float32[] want #= heap float32[rows * out];
        float32[] got #= heap float32[rows * out];
        TcTile.setSplitOverride(1L);
        yD.upload(want);
        TcTile.q4kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
        QuantKernel.stream().sync();
        yD.download(want);
        int64 sp = 2L;
        while (sp <= 4L) {
            TcTile.setSplitOverride(sp);
            int32 pass = 0;
            while (pass < 3) {
                TcTile.q4kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
                pass = pass + 1;
            }
            QuantKernel.stream().sync();
            yD.download(got);
            int64 i = 0;
            while (i < rows * out) {
                float32 a = want[i];
                float32 b = got[i];
                float32 d = a - b;
                if (d < 0.0f) { d = 0.0f - d; }
                float32 m = a < 0.0f ? 0.0f - a : a;
                if (m < 1.0f) { m = 1.0f; }
                if (d / m > 0.0001f) {
                    TcTile.setSplitOverride(0L);
                    Assert.fail("split " + sp + " element " + i + ": " + b
                        + " vs unsplit " + a);
                    return;
                }
                i = i + 1;
            }
            sp = sp * 2L;
        }
        TcTile.setSplitOverride(0L);
    }

    /** The split-K fixup on its own, on every backend it lowers on: three
     *  partial 128x128 tiles per output tile over a 256x256 output, each
     *  slot a known ramp, summed into y. */
    @Test
    public void theSplitFixupSumsThePartialTiles() {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("tcSplitFixupKernel")) { DeviceSkip.noKernel("tcSplitFixupKernel", be); return; }
        int64 rows = 256L;
        int64 out = 256L;
        int64 tilesN8 = 2L;
        int64 splits = 3L;
        int64 tiles = 4L;
        int64 pn = tiles * splits * 16384L;
        float32[] hp #= heap float32[pn];
        int64 i = 0;
        while (i < pn) {
            hp[i] = (float32) ((i * 7L) % 101L) - 50.0f;
            i = i + 1;
        }
        KernelBuffer<float32> part #= heap KernelBuffer<float32>((uint64) pn);
        part.upload(hp);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        float32[] got #= heap float32[rows * out];
        int64[] vc #= ValueCheck.mark();
        TcTile.fixupLaunchOver(yD, part, rows, out, tilesN8, splits);
        QuantKernel.stream().sync();
        yD.download(got);
        int64 t = 0;
        while (t < rows) {
            int64 c = 0;
            while (c < out) {
                int64 tile = (t / 128L) * tilesN8 + c / 128L;
                int64 at = tile * splits * 16384L + (t % 128L) * 128L + (c % 128L);
                float32 want = hp[at] + hp[at + 16384L] + hp[at + 32768L];
                float32 g = got[t * out + c];
                if (g != want) {
                    Assert.fail("fixup at (" + t + "," + c + "): " + g + " vs " + want);
                    return;
                }
                c = c + 1;
            }
            t = t + 1;
        }
        ValueCheck.credit(vc);
    }

    @Test
    public void q4kSplitKLandsTheSameProduct() {
        TcTileTest.checkSplit(Quant.GG_Q4_K, 256L, 256L, 1024L);
    }

    @Test
    public void q6kSplitKLandsTheSameProduct() {
        TcTileTest.checkSplit(Quant.GG_Q6_K, 256L, 256L, 2048L);
    }

    @Test
    public void theSplitCountFillsThePartAndDividesTheBlocks() {
        TcTile.setSplitOverride(0L);
        int64 sms = (int64) Device.multiprocessorCount();
        if (sms <= 0L) { sms = 128L; }
        // A grid already as wide as the part splits nothing.
        Assert.equals(1L, TcTile.splitsFor(sms, 16L));
        Assert.equals(1L, TcTile.splitsFor(sms * 3L, 56L));
        // A narrow grid splits by a divisor of the block count, at most 8.
        int64 s32 = TcTile.splitsFor(32L, 16L);
        Assert.isTrue(16L % s32 == 0L);
        Assert.isTrue(s32 >= 1L && s32 <= 8L);
        if (sms > 32L) { Assert.isTrue(s32 > 1L); }
        Assert.isTrue(56L % TcTile.splitsFor(8L, 56L) == 0L);
        // A prime block count cannot split.
        Assert.equals(1L, TcTile.splitsFor(8L, 13L));
    }

    @Test
    public void q4kTcTileMatchesHostDequantAtOneTile() {
        TcTileTest.check(128L, 128L, 256L);
    }

    @Test
    public void q4kTcTileMatchesHostDequantAcrossTiles() {
        TcTileTest.check(256L, 384L, 1024L);
    }

    @Test
    public void theTileRefusesAShapeItCannotCover() {
        Assert.isFalse(TcTile.fits(100L, 128L, 256L));
        Assert.isFalse(TcTile.fits(128L, 100L, 256L));
        Assert.isFalse(TcTile.fits(128L, 128L, 300L));
        Assert.isTrue(TcTile.fits(512L, 14336L, 4096L));
    }

    /** xpu-tile-shape-selection 4.7.1.1: the Q4_K tile is a family,
     *  `QkTile<TM, TN, WM, WN, KS>` under `@Instantiate`, and every listed
     *  shape holds to the host oracle, unsplit and under a forced split.
     *  The shapes are found by their registered-name prefix, so a shape
     *  added to the list is checked without a test edit; the family's
     *  override picks each one through the same gate the route reads. */
    @Test
    public void q4kEveryListedShapeMatchesTheHost() {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        int32 n = Device.registeredKernelCount();
        int32 found = 0;
        int32 checked = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            if (name.startsWith("QkTile_") && name.endsWith("_q4kQ8")) {
                found = found + 1;
                // A member the device's facts prune is one no route launches
                // here: a tracked skip with the rule, not a launch (on
                // gfx1151 the 64x64 member is pruned, 2026-10-09).
                String why #= TcTile.q4PruneReason(name, 256L, 384L, 1024L);
                if (why.count() > 0L) {
                    System.stdout.println("  [device-skip] [tracked: xpu-tile-shape-selection 4.9.1] (skipped: "
                        + why + " on " + be + ")");
                } else {
                    ShapeChoice.setShapeOverride(TcTile.Q4_FAMILY, name);
                    TcTile.forgetShapes();
                    TcTileTest.checkAs(name, 256L, 384L, 1024L);
                    TcTile.setSplitOverride(4L);
                    TcTileTest.checkAs(name, 256L, 384L, 1024L);
                    TcTile.setSplitOverride(0L);
                    ShapeChoice.clearShapeOverride(TcTile.Q4_FAMILY);
                    TcTile.forgetShapes();
                    checked = checked + 1;
                }
            }
            i = i + 1;
        }
        if (found == 0) { Assert.fail("no QkTile_*_q4kQ8 instantiation is registered: the Q4_K tile is not a family yet"); }
        if (checked == 0) {
            DeviceSkip.tracked("every listed Q4_K member is pruned by the shape filter on " + be
                + " at 256x384x1024", "xpu-tile-shape-selection 4.9.1");
        }
    }

    /** The Q6_K tile as a family (xpu-tile-shape-selection 4.8.1): every
     *  registered `Q6Tile_*_q6kQ8` instantiation, forced through the
     *  family's override, matches the host unsplit and under a forced
     *  4-way split, at a problem every listed shape fits (Q6_K rows need a
     *  block count that is a multiple of eight, so 2048 columns). */
    @Test
    public void q6kEveryListedShapeMatchesTheHost() {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        int32 n = Device.registeredKernelCount();
        int32 found = 0;
        int32 checked = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            if (name.startsWith("Q6Tile_") && name.endsWith("_q6kQ8")) {
                found = found + 1;
                String why #= TcTile.q6PruneReason(name, 256L, 384L, 2048L);
                if (why.count() > 0L) {
                    System.stdout.println("  [device-skip] [tracked: xpu-tile-shape-selection 4.9.1] (skipped: "
                        + why + " on " + be + ")");
                } else {
                    ShapeChoice.setShapeOverride(TcTile.Q6_FAMILY, name);
                    TcTile.forgetShapes();
                    TcTileTest.check6As(name, 256L, 384L, 2048L);
                    TcTile.setSplitOverride(4L);
                    TcTileTest.check6As(name, 256L, 384L, 2048L);
                    TcTile.setSplitOverride(0L);
                    ShapeChoice.clearShapeOverride(TcTile.Q6_FAMILY);
                    TcTile.forgetShapes();
                    checked = checked + 1;
                }
            }
            i = i + 1;
        }
        if (found == 0) { Assert.fail("no Q6Tile_*_q6kQ8 instantiation is registered: the Q6_K tile is not a family yet"); }
        if (checked == 0) {
            DeviceSkip.tracked("every listed Q6_K member is pruned by the shape filter on " + be
                + " at 256x384x2048", "xpu-tile-shape-selection 4.9.1");
        }
    }

    /** A shape's cost the way a replayed prefill pays it: launches back to
     *  back on the stream, sixteen a bracket, the best of three brackets
     *  after a warm one. One launch a sync, which is what the choice's
     *  probe timed, adds a launch floor a split shape pays twice. */
    static int64 burstNanos(String kernel, KernelBuffer<float32> yD, KernelBuffer<int8> wD,
            KernelBuffer<int8> xp, int64 rows, int64 out, int64 cols) {
        ShapeChoice.setShapeOverride(TcTile.Q4_FAMILY, kernel);
        TcTile.forgetShapes();
        KernelStream s = QuantKernel.stream();
        int64 best = -1L;
        int32 round = 0;
        while (round < 4) {
            s.sync();
            int64 t0 = Clock.nanoTime();
            int32 k = 0;
            while (k < 16) {
                TcTile.q4kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
                k = k + 1;
            }
            s.sync();
            int64 t = (Clock.nanoTime() - t0) / 16L;
            if (round > 0 && (best < 0L || t < best)) { best = t; }
            round = round + 1;
        }
        ShapeChoice.clearShapeOverride(TcTile.Q4_FAMILY);
        TcTile.forgetShapes();
        return best;
    }

    static void chosenIsFastest(int64 rows, int64 out, int64 cols) {
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        int8[] raw #= CensusReachTest.tiled(Quant.GG_Q4_K, "q4_k.bin", nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
        wD.upload(raw);
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        int32 n = Device.registeredKernelCount();
        String bestName #= "";
        int64 bestT = -1L;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            if (name.startsWith("QkTile_") && name.endsWith("_q4kQ8")) {
                int64 t = TcTileTest.burstNanos(name, yD, wD, xp, rows, out, cols);
                System.stdout.println("  [shape-burst] " + rows + "x" + out + "x" + cols
                    + " " + name + " " + t + " ns a launch");
                if (bestT < 0L || t < bestT) { bestT = t; bestName #= name.clone(); }
            }
            i = i + 1;
        }
        // The choice, cold: no override, no memo, no remembered answer.
        TcTile.forgetShapes();
        Autotune.invalidate("", "shape." + TcTile.Q4_FAMILY + "." + rows + "x" + out + "x" + cols);
        TcTile.q4kQ8TcTileLaunchNoSync(yD, wD, xp, rows, out, cols);
        QuantKernel.stream().sync();
        String chosen #= TcTile.lastQ4Kernel();
        int64 chosenT = TcTileTest.burstNanos(chosen, yD, wD, xp, rows, out, cols);
        System.stdout.println("  [shape-burst] " + rows + "x" + out + "x" + cols
            + " chose " + chosen + " at " + chosenT + " ns; best " + bestName + " at " + bestT);
        if (chosenT * 1000L > bestT * 1030L) {
            Assert.fail("at " + rows + "x" + out + "x" + cols + " the choice named " + chosen
                + ", " + chosenT + " ns a launch in a burst, where " + bestName
                + " runs " + bestT + " ns: the probe's one launch a sync misread the shapes");
        }
    }

    /** tile-shape-selection 4.7.3.1: at the engine's own problems the shape
     *  the family chooses is the one a replayed prefill runs fastest, within
     *  the choice's own tie margin. On 2026-10-08 the probe chose 64x64 for
     *  the 1024-wide projections, where 128x128 split four ways is faster
     *  back to back, and pp512 read 2.5 ms slower than the single tile. */
    @Test
    public void q4kTheChosenShapeIsTheFastestInABurst() {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(TcTile.Q4_KERNEL)) { DeviceSkip.noKernel(TcTile.Q4_KERNEL, be); return; }
        TcTileTest.chosenIsFastest(512L, 1024L, 4096L);
        TcTileTest.chosenIsFastest(512L, 4096L, 4096L);
    }

    /** tile-shape-selection 4.7.3.1: the probe prices a shape the way the
     *  engine pays for it. One launch a sync adds the launch floor, which a
     *  split shape (two launches) pays twice and a replayed prefill never
     *  pays, so at the 1024-wide projection the probe read 128x128 split
     *  four ways at the price of 64x64 and flipped the choice between
     *  processes. The probe's per-launch price must sit within a fifth of
     *  a sixteen-launch burst's. */
    @Test
    public void q4kTheProbePricesAShapeAsTheEngineRunsIt() {
        if (!CensusReachTest.deviceHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        if (!KernelCap.usable(TcTile.Q4_KERNEL)) { DeviceSkip.noKernel(TcTile.Q4_KERNEL, be); return; }
        int64 rows = 512L;
        int64 out = 1024L;
        int64 cols = 4096L;
        int64 bpr = cols / 256L;
        int64 nBlocks = out * bpr;
        int8[] raw #= CensusReachTest.tiled(Quant.GG_Q4_K, "q4_k.bin", nBlocks);
        float32[] x #= CensusReachTest.ramp(rows * cols);
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
        wD.upload(raw);
        KernelBuffer<int8> xp #= CensusReachTest.packedActivations(x, rows, cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) (rows * out));
        int64 burst = TcTileTest.burstNanos(TcTile.Q4_KERNEL, yD, wD, xp, rows, out, cols);
        ShapeFilter f #= heap ShapeFilter(TcTile.Q4_FAMILY, DeviceFacts.current(), rows, out, cols);
        String kn #= TcTile.Q4_KERNEL.clone();
        KernelFacts kf #= KernelFacts.measured(kn, 0);
        f.consider(#heap ShapeCandidate(#kn, 128, 128, 256, 256, 8), #kf);
        if (f.survivorCount() != 1) {
            Assert.fail("the filter refused the default shape at " + rows + "x" + out + "x" + cols
                + ": " + f.refusal());
            return;
        }
        Q4ShapeProbe probe #= heap Q4ShapeProbe(TcTile.q4(), f, wD, xp, rows, out, cols);
        int64 priced = -1L;
        int32 round = 0;
        while (round < 6) {
            int64 t = probe.timeNanos(0);
            if (round > 0 && (priced < 0L || t < priced)) { priced = t; }
            round = round + 1;
        }
        System.stdout.println("  [shape-price] " + rows + "x" + out + "x" + cols + " "
            + TcTile.Q4_KERNEL + " probe " + priced + " ns a launch, burst " + burst);
        if (priced * 10L > burst * 12L) {
            Assert.fail("the probe prices " + TcTile.Q4_KERNEL + " at " + priced
                + " ns a launch where a burst runs it at " + burst
                + ": the launch floor is in the price");
        }
    }
}
