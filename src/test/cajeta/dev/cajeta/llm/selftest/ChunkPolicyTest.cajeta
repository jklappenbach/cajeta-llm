package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.sched.ChunkPolicy;

/** cajeta-llm 15.2.17: the prefill chunk adapts (spec 13.14). */
public class ChunkPolicyTest {

    public ChunkPolicyTest() { return; }

    static int64 ms(int64 n) { return n * 1000000L; }

    /** A pinned chunk is what `--chunk` gives tests: it never moves. */
    @Test
    public void aPinnedChunkNeverMoves() {
        ChunkPolicy p = heap ChunkPolicy(128, ChunkPolicyTest.ms(150L), 512);
        p.observe(128, false, ChunkPolicyTest.ms(10L));
        p.observe(128, true, ChunkPolicyTest.ms(900L));
        Assert.equals(128, p.chunkFor(false));
        Assert.equals(128, p.chunkFor(true));
    }

    /** Idle, it starts at 128 and tries the next size up while that pays. */
    @Test
    public void idleItGrowsWhileARowGetsCheaper() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        Assert.equals(128, p.chunkFor(false));
        p.observe(128, false, ChunkPolicyTest.ms(100L));
        Assert.equals(256, p.chunkFor(false));
        p.observe(256, false, ChunkPolicyTest.ms(160L));
        Assert.equals(512, p.chunkFor(false));
        p.observe(512, false, ChunkPolicyTest.ms(310L));
        Assert.equals(256, p.chunkFor(false));
    }

    /** Idle, a larger chunk that costs more a row is not kept. */
    @Test
    public void idleItKeepsTheCheaperRow() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        p.observe(128, false, ChunkPolicyTest.ms(100L));
        p.observe(256, false, ChunkPolicyTest.ms(210L));
        Assert.equals(128, p.chunkFor(false));
    }

    /** Under load, the chunk is the largest whose predicted step fits the budget. */
    @Test
    public void underLoadTheStepFitsTheBudget() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        p.observe(128, true, ChunkPolicyTest.ms(100L));
        Assert.equals(128, p.chunkFor(true));
        p.observe(128, true, ChunkPolicyTest.ms(200L));
        Assert.equals(64, p.chunkFor(true));
    }

    /** Under load, prompts prefilled in one step share the budget. */
    @Test
    public void underLoadPromptsInOneStepShareTheBudget() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        p.observe(128, true, ChunkPolicyTest.ms(100L));
        Assert.equals(128, p.chunkForShare(true, 1));
        Assert.equals(64, p.chunkForShare(true, 2));
    }

    /** Under load with no loaded step yet, idle steps predict. */
    @Test
    public void underLoadIdleStepsPredictUntilALoadedOneIsSeen() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        p.observe(256, false, ChunkPolicyTest.ms(120L));
        Assert.equals(256, p.chunkFor(true));
        p.observe(256, true, ChunkPolicyTest.ms(180L));
        Assert.equals(128, p.chunkFor(true));
    }

    /** Under load with nothing measured, only the smallest chunk is sure to fit. */
    @Test
    public void underLoadAnUnmeasuredPolicyStartsSmallest() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        Assert.equals(32, p.chunkFor(true));
        Assert.equals(128, p.chunkFor(false));
    }

    /** Under load, the smallest chunk still runs when even it is over budget. */
    @Test
    public void underLoadTheSmallestChunkIsTheFloor() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        p.observe(32, true, ChunkPolicyTest.ms(400L));
        Assert.equals(32, p.chunkFor(true));
    }

    /** A prompt's short last chunk is not a size the policy learns from. */
    @Test
    public void aPartialChunkIsNotLearned() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 512);
        p.observe(100, false, ChunkPolicyTest.ms(1L));
        Assert.equals(128, p.chunkFor(false));
    }

    /** The largest chunk is a cap, however cheap rows get. */
    @Test
    public void theMaximumChunkIsACap() {
        ChunkPolicy p = heap ChunkPolicy(0, ChunkPolicyTest.ms(150L), 256);
        p.observe(128, false, ChunkPolicyTest.ms(100L));
        p.observe(256, false, ChunkPolicyTest.ms(100L));
        Assert.equals(256, p.chunkFor(false));
        Assert.equals(256, p.chunkFor(true));
    }
}
