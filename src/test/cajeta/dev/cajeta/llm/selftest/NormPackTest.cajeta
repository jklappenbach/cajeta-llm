package dev.cajeta.llm.selftest;

import dev.cajeta.llm.model.KernelCap;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Prim;

/**
 * cajeta-llm plan 48.1 — the fused RMSNorm + Q8_K pack against the
 * norm launch followed by the pack launch: the f32 row and every
 * packed byte identical, at the 30B's width and the toy's, both norm
 * forms, and with an all-zero block (the guarded reciprocal).
 */
public class NormPackTest {

    public NormPackTest() { return; }

    static void needBackend() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        return;
    }

    /** Skips unless the fused kernel and both kernels it replaces lower
     *  here. */
    static void need(String fused, String first) {
        NormPackTest.needBackend();
        String be #= Device.activeBackend();
        if (!KernelCap.usable(fused)) { DeviceSkip.noKernel(fused, be); return; }
        if (!KernelCap.usable(first)) { DeviceSkip.noKernel(first, be); return; }
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return; }
        return;
    }

    static void run(int64 dim, int32 form, boolean zeroBlock) {
        float32[] hx = heap float32[dim];
        float32[] hw = heap float32[dim];
        int64 i = 0;
        while (i < dim) {
            hx[i] = (float32) (((i * 53L + 7L) % 211L) - 105L) / 9.0f;
            hw[i] = 1.0f + (float32) (i % 13) * 0.01f;
            if (zeroBlock && i >= 256L && i < 512L) { hx[i] = 0.0f; }
            i = i + 1;
        }
        KernelBuffer<float32> x #= heap KernelBuffer<float32>((uint64) dim);
        KernelBuffer<float32> w #= heap KernelBuffer<float32>((uint64) dim);
        x.upload(hx, dim);
        w.upload(hw, dim);
        int64 pb = (dim / 256L) * 320L;
        KernelBuffer<float32> o1 #= heap KernelBuffer<float32>((uint64) dim);
        KernelBuffer<float32> o2 #= heap KernelBuffer<float32>((uint64) dim);
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        float32 eps = 0.00001f;
        Prim.rmsnormDevice(o1, x, w, dim, eps, form);
        QuantKernel.q8kPackLaunchNoSync(p1, o1, dim);
        // The two launches are the reference and are checked on their own,
        // so only the fused kernel is credited.
        int64[] vc #= ValueCheck.mark();
        Assert.isTrue(Prim.rmsnormPackDevice(o2, p2, x, w, dim, eps, form));
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[dim];
        float32[] b = heap float32[dim];
        o1.download(a, dim);
        o2.download(b, dim);
        i = 0;
        while (i < dim) {
            if (a[i] != b[i]) {
                Assert.fail("normed row differs at " + i + ": " + a[i]
                    + " vs " + b[i]);
            }
            i = i + 1;
        }
        int8[] qa = heap int8[pb];
        int8[] qb = heap int8[pb];
        p1.download(qa, pb);
        p2.download(qb, pb);
        i = 0;
        boolean nz = false;
        while (i < pb) {
            // Bytes 292..319 of a block are padding neither kernel
            // writes; only the 292-byte payload is the contract.
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (qa[i] != qb[i]) {
                Assert.fail("packed byte differs at " + i + ": "
                    + (int32) qa[i] + " vs " + (int32) qb[i]);
            }
            if (qa[i] != (int8) 0) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
        ValueCheck.credit(vc);
    }

    /** 48.1.3 — the 30B's width, plain form. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt2048() {
        NormPackTest.need("rmsnormPackRowF32", "rmsnormRowF32");
        NormPackTest.run(2048L, 0, false);
    }

    /** 48.1.3 — the toy's width, the 1+w form, with a zero block. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt512WithZeroBlock() {
        NormPackTest.need("rmsnormPackRowF32", "rmsnormRowF32");
        NormPackTest.run(512L, 1, true);
    }

    /** The 8B's width — sixteen blocks, so each wave takes two. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt4096() {
        NormPackTest.need("rmsnormPackRowF32", "rmsnormRowF32");
        NormPackTest.run(4096L, 0, false);
    }

    /** The 8B's FFN width — fifty-six blocks over eight waves, an
     *  uneven last round, and a zero block in it. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt14336() {
        NormPackTest.need("rmsnormPackRowF32", "rmsnormRowF32");
        NormPackTest.run(14336L, 1, true);
    }

    static void runGlu(int64 n, int32 act) {
        float32[] hg = heap float32[n];
        float32[] hu = heap float32[n];
        int64 i = 0;
        while (i < n) {
            hg[i] = (float32) (((i * 37L + 11L) % 197L) - 98L) / 11.0f;
            hu[i] = (float32) (((i * 61L + 5L) % 173L) - 86L) / 13.0f;
            i = i + 1;
        }
        KernelBuffer<float32> g1 #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> g2 #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> u #= heap KernelBuffer<float32>((uint64) n);
        g1.upload(hg, n);
        g2.upload(hg, n);
        u.upload(hu, n);
        int64 pb = (n / 256L) * 320L;
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        Prim.gluDevice(g1, u, n, act);
        QuantKernel.q8kPackLaunchNoSync(p1, g1, n);
        // The two launches are the reference and are checked on their own,
        // so only the fused kernel is credited.
        int64[] vc #= ValueCheck.mark();
        Assert.isTrue(Prim.gluPackDevice(g2, p2, u, n, act));
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[n];
        float32[] b = heap float32[n];
        g1.download(a, n);
        g2.download(b, n);
        i = 0;
        while (i < n) {
            if (a[i] != b[i]) {
                Assert.fail("glu row differs at " + i + ": " + a[i]
                    + " vs " + b[i]);
            }
            i = i + 1;
        }
        int8[] qa = heap int8[pb];
        int8[] qb = heap int8[pb];
        p1.download(qa, pb);
        p2.download(qb, pb);
        i = 0;
        boolean nz = false;
        while (i < pb) {
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (qa[i] != qb[i]) {
                Assert.fail("glu packed byte differs at " + i + ": "
                    + (int32) qa[i] + " vs " + (int32) qb[i]);
            }
            if (qa[i] != (int8) 0) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
        ValueCheck.credit(vc);
    }

    /** The fused gate|up GLU packed straight to q8_K over `rows` rows of
     *  the concatenated projection output (1.8.3), against the fused GLU
     *  launch followed by the rows pack: every payload byte identical. */
    static void runFusedGluPack(int64 rows, int64 inter, int32 act) {
        int64 n = rows * 2L * inter;
        float32[] hs = heap float32[n];
        int64 i = 0;
        while (i < n) {
            hs[i] = (float32) (((i * 37L + 11L) % 197L) - 98L) / 11.0f;
            i = i + 1;
        }
        KernelBuffer<float32> src #= heap KernelBuffer<float32>((uint64) n);
        src.upload(hs, n);
        int64 pb = rows * (inter / 256L) * 320L;
        KernelBuffer<float32> o1 #= heap KernelBuffer<float32>((uint64) (rows * inter));
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        Prim.gluFusedDevice(o1, src, rows, inter, act);
        QuantKernel.q8kPackRowsLaunchNoSync(p1, o1, rows, inter, inter);
        int64[] vc #= ValueCheck.mark();
        Assert.isTrue(Prim.gluFusedPackDevice(p2, src, rows, inter, act));
        KernelStream s = QuantKernel.stream();
        s.sync();
        int8[] qa = heap int8[pb];
        int8[] qb = heap int8[pb];
        p1.download(qa, pb);
        p2.download(qb, pb);
        i = 0;
        boolean nz = false;
        while (i < pb) {
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (qa[i] != qb[i]) {
                Assert.fail("fused glu packed byte differs at " + i + ": "
                    + (int32) qa[i] + " vs " + (int32) qb[i]);
                return;
            }
            if (qa[i] != (int8) 0) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
        ValueCheck.credit(vc);
    }

    /** Three rows at the 8B's FFN width, silu: the row stride through the
     *  fused [rows x 2*inter] output. */
    @Test
    public void fusedGluPackOverRowsMatchesTheGluThenThePackAt14336() {
        NormPackTest.need("gluFusedPackF32", "gluFusedF32");
        NormPackTest.runFusedGluPack(3L, 14336L, 0);
    }

    /** Two rows, gelu-tanh, at the toy's width. */
    @Test
    public void fusedGluPackOverRowsMatchesTheGluThenThePackAt512Gelu() {
        NormPackTest.need("gluFusedPackF32", "gluFusedF32");
        NormPackTest.runFusedGluPack(2L, 512L, 1);
    }

    /** The fused norm-and-pack over rows (the prefill's use, 1.8.3): each
     *  row's pack equals the rows pack of the batch norm's output. */
    @Test
    public void fusedNormPackOverRowsMatchesTheNormThenThePack() {
        NormPackTest.need("rmsnormPackRowF32", "rmsnormRowsF32");
        int64 rows = 3L;
        int64 dim = 4096L;
        int64 n = rows * dim;
        float32[] hx = heap float32[n];
        float32[] hw = heap float32[dim];
        int64 i = 0;
        while (i < n) {
            hx[i] = (float32) (((i * 53L + 7L) % 211L) - 105L) / 9.0f;
            i = i + 1;
        }
        i = 0;
        while (i < dim) { hw[i] = 1.0f + (float32) (i % 13) * 0.01f; i = i + 1; }
        KernelBuffer<float32> x #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> w #= heap KernelBuffer<float32>((uint64) dim);
        x.upload(hx, n);
        w.upload(hw, dim);
        int64 pb = rows * (dim / 256L) * 320L;
        KernelBuffer<float32> o1 #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> o2 #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        float32 eps = 0.00001f;
        Prim.rmsnormBatchDevice(o1, x, w, rows, dim, eps, 0);
        QuantKernel.q8kPackRowsLaunchNoSync(p1, o1, rows, dim, dim);
        int64[] vc #= ValueCheck.mark();
        Assert.isTrue(Prim.rmsnormPackRowsDevice(o2, p2, x, w, rows, dim, eps, 0));
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[n];
        float32[] b = heap float32[n];
        o1.download(a, n);
        o2.download(b, n);
        i = 0;
        while (i < n) {
            float32 d = a[i] - b[i];
            if (d < 0.0f) { d = 0.0f - d; }
            float32 m = a[i] < 0.0f ? 0.0f - a[i] : a[i];
            if (d > m * 0.00001f + 0.000001f) {
                Assert.fail("normed row differs at " + i + ": " + a[i] + " vs " + b[i]);
                return;
            }
            i = i + 1;
        }
        int8[] qa = heap int8[pb];
        int8[] qb = heap int8[pb];
        p1.download(qa, pb);
        p2.download(qb, pb);
        i = 0;
        int64 off = 0L;
        while (i < pb) {
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (qa[i] != qb[i]) { off = off + 1L; }
            i = i + 1;
        }
        // The batch norm's sum of squares is not the fused kernel's tree,
        // so a quant may round the other way at a last bit: a handful of
        // bytes, never a block's worth.
        Assert.isTrue(off < 64L);
        ValueCheck.credit(vc);
    }

    /** The 8B's FFN width, silu. */
    @Test
    public void fusedGluPackMatchesTwoLaunchesAt14336() {
        NormPackTest.need("gluPackF32", "gluF32");
        NormPackTest.runGlu(14336L, 0);
    }

    /** The gelu-tanh form at the toy's width. */
    @Test
    public void fusedGluPackMatchesTwoLaunchesAt512Gelu() {
        NormPackTest.need("gluPackF32", "gluF32");
        NormPackTest.runGlu(512L, 1);
    }

    /** A row that is not a whole number of blocks is still declined,
     *  launching nothing. */
    @Test
    public void fusedNormPackDeclinesRaggedRows() {
        NormPackTest.needBackend();
        KernelBuffer<float32> x #= heap KernelBuffer<float32>((uint64) 4000);
        KernelBuffer<int8> p #= heap KernelBuffer<int8>((uint64) (16 * 320));
        Assert.isTrue(!Prim.rmsnormPackDevice(x, p, x, x, 4000L, 0.00001f, 0));
    }
}
