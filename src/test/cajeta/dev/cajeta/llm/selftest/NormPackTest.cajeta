package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Prim;

/**
 * cajeta-llm plan 48.1 — the fused RMSNorm + Q8_K pack against the
 * norm launch followed by the pack launch: the f32 row and every
 * packed byte identical, at the 30B's width and the toy's, both norm
 * forms, and with an all-zero block (the guarded reciprocal).
 */
public class NormPackTest {

    public NormPackTest() { return; }

    static boolean skip() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) {
            RoutableFixtureTest.saySkip();
            return true;
        }
        return false;
    }

    static void run(int64 dim, int32 form, boolean zeroBlock) {
        float32[] hx = heap float32[dim];
        float32[] hw = heap float32[dim];
        int64 i = 0;
        while (i < dim) {
            hx[i] = (float32) (((i * 53L + 7L) % 211L) - 105L) / 9.0f;
            hw[i] = 1.0f + (float32) (i % 13) * 0.01f;
            if (zeroBlock && i >= 256L && i < 512L) { hx[i] = 0.0f; }
            i = i + 1;
        }
        KernelBuffer<float32> x #= heap KernelBuffer<float32>((uint64) dim);
        KernelBuffer<float32> w #= heap KernelBuffer<float32>((uint64) dim);
        x.upload(hx, dim);
        w.upload(hw, dim);
        int64 pb = (dim / 256L) * 320L;
        KernelBuffer<float32> o1 #= heap KernelBuffer<float32>((uint64) dim);
        KernelBuffer<float32> o2 #= heap KernelBuffer<float32>((uint64) dim);
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        float32 eps = 0.00001f;
        Prim.rmsnormDevice(o1, x, w, dim, eps, form);
        QuantKernel.q8kPackLaunchNoSync(p1, o1, dim);
        Assert.isTrue(Prim.rmsnormPackDevice(o2, p2, x, w, dim, eps, form));
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[dim];
        float32[] b = heap float32[dim];
        o1.download(a, dim);
        o2.download(b, dim);
        i = 0;
        while (i < dim) {
            if (a[i] != b[i]) {
                Assert.fail("normed row differs at " + i + ": " + a[i]
                    + " vs " + b[i]);
            }
            i = i + 1;
        }
        int8[] qa = heap int8[pb];
        int8[] qb = heap int8[pb];
        p1.download(qa, pb);
        p2.download(qb, pb);
        i = 0;
        boolean nz = false;
        while (i < pb) {
            // Bytes 292..319 of a block are padding neither kernel
            // writes; only the 292-byte payload is the contract.
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (qa[i] != qb[i]) {
                Assert.fail("packed byte differs at " + i + ": "
                    + (int32) qa[i] + " vs " + (int32) qb[i]);
            }
            if (qa[i] != (int8) 0) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
    }

    /** 48.1.3 — the 30B's width, plain form. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt2048() {
        if (NormPackTest.skip()) { return; }
        NormPackTest.run(2048L, 0, false);
    }

    /** 48.1.3 — the toy's width, the 1+w form, with a zero block. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt512WithZeroBlock() {
        if (NormPackTest.skip()) { return; }
        NormPackTest.run(512L, 1, true);
    }

    /** The 8B's width — sixteen blocks, so each wave takes two. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt4096() {
        if (NormPackTest.skip()) { return; }
        NormPackTest.run(4096L, 0, false);
    }

    /** The 8B's FFN width — fifty-six blocks over eight waves, an
     *  uneven last round, and a zero block in it. */
    @Test
    public void fusedNormPackMatchesTwoLaunchesAt14336() {
        if (NormPackTest.skip()) { return; }
        NormPackTest.run(14336L, 1, true);
    }

    static void runGlu(int64 n, int32 act) {
        float32[] hg = heap float32[n];
        float32[] hu = heap float32[n];
        int64 i = 0;
        while (i < n) {
            hg[i] = (float32) (((i * 37L + 11L) % 197L) - 98L) / 11.0f;
            hu[i] = (float32) (((i * 61L + 5L) % 173L) - 86L) / 13.0f;
            i = i + 1;
        }
        KernelBuffer<float32> g1 #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> g2 #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> u #= heap KernelBuffer<float32>((uint64) n);
        g1.upload(hg, n);
        g2.upload(hg, n);
        u.upload(hu, n);
        int64 pb = (n / 256L) * 320L;
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        Prim.gluDevice(g1, u, n, act);
        QuantKernel.q8kPackLaunchNoSync(p1, g1, n);
        Assert.isTrue(Prim.gluPackDevice(g2, p2, u, n, act));
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[n];
        float32[] b = heap float32[n];
        g1.download(a, n);
        g2.download(b, n);
        i = 0;
        while (i < n) {
            if (a[i] != b[i]) {
                Assert.fail("glu row differs at " + i + ": " + a[i]
                    + " vs " + b[i]);
            }
            i = i + 1;
        }
        int8[] qa = heap int8[pb];
        int8[] qb = heap int8[pb];
        p1.download(qa, pb);
        p2.download(qb, pb);
        i = 0;
        boolean nz = false;
        while (i < pb) {
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (qa[i] != qb[i]) {
                Assert.fail("glu packed byte differs at " + i + ": "
                    + (int32) qa[i] + " vs " + (int32) qb[i]);
            }
            if (qa[i] != (int8) 0) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
    }

    /** The 8B's FFN width, silu. */
    @Test
    public void fusedGluPackMatchesTwoLaunchesAt14336() {
        if (NormPackTest.skip()) { return; }
        NormPackTest.runGlu(14336L, 0);
    }

    /** The gelu-tanh form at the toy's width. */
    @Test
    public void fusedGluPackMatchesTwoLaunchesAt512Gelu() {
        if (NormPackTest.skip()) { return; }
        NormPackTest.runGlu(512L, 1);
    }

    /** A row that is not a whole number of blocks is still declined,
     *  launching nothing. */
    @Test
    public void fusedNormPackDeclinesRaggedRows() {
        if (NormPackTest.skip()) { return; }
        KernelBuffer<float32> x #= heap KernelBuffer<float32>((uint64) 4000);
        KernelBuffer<int8> p #= heap KernelBuffer<int8>((uint64) (16 * 320));
        Assert.isTrue(!Prim.rmsnormPackDevice(x, p, x, x, 4000L, 0.00001f, 0));
    }
}
