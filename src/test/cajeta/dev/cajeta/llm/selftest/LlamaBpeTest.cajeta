package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.tok.Tokenizer;

/**
 * The `llama-bpe` pre-tokenizer (plan 15.1.14), checked against
 * tokenizations produced by the REAL Hugging Face tokenizer for
 * Meta-Llama-3.1-8B-Instruct (tools/tok/gen_llama_bpe_fixture.py).
 *
 * llama-bpe and qwen2 are the same byte-level BPE and differ in digit
 * grouping — `\p{N}{1,3}` against `\p{N}`. That is small and entirely
 * silent: accepting llama-bpe as qwen2 would tokenize every number
 * differently while looking fine on prose. The digit cases below are
 * chosen so the two rules cannot agree: under qwen2, "123" is three
 * pieces; under llama-bpe it is one.
 *
 * The fixture itself (src/test/fixtures/tok/llama_bpe.tsv, 20 cases from
 * the real HF tokenizer) needs the full Llama-3 vocabulary to replay, so
 * it drives a tools/ harness against the real GGUF rather than this
 * suite — these tests pin the RULE SELECTION, which is what a unit suite
 * can honestly check without a 4.9 GB fixture.
 */
public class LlamaBpeTest {

    public LlamaBpeTest() { return; }

    static final String FIXTURE = "src/test/fixtures/tok/llama_bpe.tsv";

    @Test
    public void digitRunsGroupUpToThree() {
        // The discriminator, independent of the fixture: llama-bpe absorbs
        // at most three digits per piece, qwen2 exactly one.
        Tokenizer t #= Tokenizer.fromGgml("gpt2", "llama-bpe",
            LlamaBpeTest.miniVocab(), LlamaBpeTest.miniScores(),
            LlamaBpeTest.miniTypes(), LlamaBpeTest.noMerges());
        Assert.equals(3L, (int64) t.digitRunForTest());

        Tokenizer q #= Tokenizer.fromGgml("gpt2", "qwen2",
            LlamaBpeTest.miniVocab(), LlamaBpeTest.miniScores(),
            LlamaBpeTest.miniTypes(), LlamaBpeTest.noMerges());
        Assert.equals(1L, (int64) q.digitRunForTest());
    }

    @Test
    public void unknownPreStillRejected() {
        // The gate must still FIRE for a pre-tokenizer we have not
        // implemented — accepting one silently is the failure mode.
        boolean threw = false;
        try {
            Tokenizer bad #= Tokenizer.fromGgml("gpt2", "deepseek-llm",
                LlamaBpeTest.miniVocab(), LlamaBpeTest.miniScores(),
                LlamaBpeTest.miniTypes(), LlamaBpeTest.noMerges());
        } catch (Throwable e) {
            threw = true;
        }
        Assert.isTrue(threw);
    }

    static #String[] miniVocab() {
        String[] v #= heap String[3];
        v[0] = "<unk>";
        v[1] = "a";
        v[2] = "1";
        return #v;
    }

    static #float32[] miniScores() {
        float32[] s #= heap float32[3];
        return #s;
    }

    static #int32[] miniTypes() {
        int32[] t #= heap int32[3];
        return #t;
    }

    static #String[] noMerges() {
        String[] m #= heap String[0];
        return #m;
    }

    // ── BOS policy (the " the" vs " Paris." bug) ────────────────────────

    /**
     * A prompt carries what the model's metadata says it carries.
     * Llama-3 GGUFs set `add_bos_token`, and llama.cpp prepends
     * <|begin_of_text|>; we did not, so greedy on "The capital of France
     * is" answered " the" instead of " Paris." — a silent behavioural
     * difference, not a crash.
     */
    @Test
    public void encodePromptPrependsBosWhenTheModelSaysSo() {
        Tokenizer t #= LlamaBpeTest.miniTokenizer();
        t.setBosPolicy(true, 2);
        Assert.isTrue(t.addsBos());
        int32[] raw #= t.encode("a");
        int32[] prompt #= t.encodePrompt("a");
        Assert.equals((int64) raw.count() + 1L, (int64) prompt.count());
        Assert.equals(2L, (int64) prompt[0]);
    }

    /** …and does NOT when it says not to. A policy that always fires is
     *  as wrong as one that never does. */
    @Test
    public void encodePromptOmitsBosWhenDisabled() {
        Tokenizer t #= LlamaBpeTest.miniTokenizer();
        t.setBosPolicy(false, 2);
        Assert.isFalse(t.addsBos());
        int32[] raw #= t.encode("a");
        int32[] prompt #= t.encodePrompt("a");
        Assert.equals((int64) raw.count(), (int64) prompt.count());
    }

    /** No bos id means no BOS, whatever the flag claims. */
    @Test
    public void encodePromptOmitsBosWithoutAnId() {
        Tokenizer t #= LlamaBpeTest.miniTokenizer();
        t.setBosPolicy(true, -1);
        Assert.isFalse(t.addsBos());
        int32[] raw #= t.encode("a");
        int32[] prompt #= t.encodePrompt("a");
        Assert.equals((int64) raw.count(), (int64) prompt.count());
    }

    /** encode() stays the RAW primitive — harnesses that supply their own
     *  ids (parity fixtures, chat templates emitting their own specials)
     *  must not silently acquire a BOS. */
    @Test
    public void rawEncodeNeverAddsBos() {
        Tokenizer t #= LlamaBpeTest.miniTokenizer();
        t.setBosPolicy(true, 2);
        int32[] raw #= t.encode("a");
        int32 i = 0;
        while (i < (int32) raw.count()) {
            Assert.isFalse(raw[i] == 2);
            i = i + 1;
        }
    }

    static #Tokenizer miniTokenizer() {
        return Tokenizer.fromGgml("gpt2", "llama-bpe",
            LlamaBpeTest.miniVocab(), LlamaBpeTest.miniScores(),
            LlamaBpeTest.miniTypes(), LlamaBpeTest.noMerges());
    }
}
