package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.lang.StringBuilder;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;

/**
 * The bit gate for the wave mat-vec family (xpu-kernel-adaptor 9.1.1,
 * wave-row-geometry 2.1.1): a kernel's output at wave 32 is `==` the
 * output it produced BEFORE its conversion to the Group surface, bit for
 * bit. The arithmetic of a conversion is unchanged, only the lane and row
 * derivation moves, so a tolerance would hide exactly the class of defect
 * the gate exists to catch: a row read from the wrong place is often
 * within a few percent of the right one on tiled fixtures.
 *
 * The table is `src/test/fixtures/wave/goldens-wave32.tsv`, one row per
 * (backend, kernel, tag, count): the IEEE-754 bits of every output value,
 * in order. Recorded ONCE, on the pre-conversion tree, when the marker
 * file `RECORD` sits beside the table (the run says so per row); every
 * later run compares. A kernel with no row FAILS, never skips: a gate that
 * can be bypassed by forgetting to record is not a gate.
 *
 * Only wave 32 compares. A different wave reduces in a different order and
 * is held to the calling test's tolerance bar instead; the fold on cpu
 * (wave 8 here) is validated by those bars, not by these bits.
 */
public final class WaveGolden {

    static final String PATH = "src/test/fixtures/wave/goldens-wave32.tsv";
    static final String MARKER = "src/test/fixtures/wave/RECORD";

    /** The table, prefixed with "\n" so "\n" + key + "\t" finds a row. */
    static String table;
    static boolean loaded;
    static boolean recording;

    public WaveGolden() { return; }

    static void load() {
        if (WaveGolden.loaded) { return; }
        WaveGolden.loaded = true;
        int8[] marker #= File.readAllBytes(WaveGolden.MARKER);
        WaveGolden.recording = marker != null;
        int8[] raw #= File.readAllBytes(WaveGolden.PATH);
        if (raw == null) {
            WaveGolden.table #= "\n";
            return;
        }
        String body #= heap String(#raw, (int32) raw.count());
        WaveGolden.table #= "\n" + body;
    }

    static #String key(String kernel, String tag, int64 n) {
        String be #= Device.activeBackend();
        String k #= be + "\t" + kernel + "\t" + tag + "\t" + n;
        return #k;
    }

    static #String bits(float32[] got, int64 n) {
        StringBuilder sb #= heap StringBuilder();
        int64 i = 0;
        while (i < n) {
            if (i > 0L) { sb.append(","); }
            sb.append("" + Cajeta.f32ToBits(got[i]));
            i = i + 1;
        }
        String s #= sb.toString();
        return #s;
    }

    /** The i-th comma-separated field of `csv`, or "" past the end. */
    static #String field(String csv, int64 i) {
        int64 from = 0;
        int64 k = 0;
        while (k < i) {
            int64 c = csv.indexOfFrom(",", from);
            if (c < 0L) { String none #= ""; return #none; }
            from = c + 1L;
            k = k + 1;
        }
        int64 end = csv.indexOfFrom(",", from);
        if (end < 0L) { end = (int64) csv.byteLength(); }
        String f #= csv.substring((int32) from, (int32) end);
        return #f;
    }

    static void save() {
        String body #= WaveGolden.table.substring(1, WaveGolden.table.byteLength());
        int8[] bytes #= body.toBytes();
        File.writeAllBytes(WaveGolden.PATH, bytes, (int64) bytes.count());
    }

    /**
     * Compare `got[0..n)` for `kernel` against its wave-32 golden, or
     * record it when the marker is present. Returns true when a comparison
     * happened (the caller may credit a value check on it), false when the
     * wave is not 32 or the row was recorded.
     */
    public static boolean check(String kernel, String tag, float32[] got, int64 n) {
        if (Device.waveSize() != 32) { return false; }
        return WaveGolden.checkPinned(kernel, tag, got, n);
    }

    /** As {@link #check}, for a kernel declaring `@Wave(width = 32)`, which runs at 32 on every backend. */
    public static boolean checkPinned(String kernel, String tag, float32[] got, int64 n) {
        WaveGolden.load();
        String k #= WaveGolden.key(kernel, tag, n);
        String v #= WaveGolden.bits(got, n);
        String needle #= "\n" + k + "\t";
        int64 at = WaveGolden.table.indexOf(needle);
        if (WaveGolden.recording) {
            String line #= k + "\t" + v + "\n";
            if (at < 0L) {
                WaveGolden.table #= WaveGolden.table + line;
            } else {
                int64 from = at + 1L;
                int64 end = WaveGolden.table.indexOfFrom("\n", from) + 1L;
                String head #= WaveGolden.table.substring(0, (int32) from);
                String tail #= WaveGolden.table.substring((int32) end,
                    WaveGolden.table.byteLength());
                WaveGolden.table #= head + line + tail;
            }
            WaveGolden.save();
            System.stdout.println("  [wave-golden] recorded " + kernel + " " + tag
                + " (" + n + " values)");
            return false;
        }
        if (at < 0L) {
            Assert.fail("no wave-32 golden for " + kernel + " tag " + tag + " n=" + n
                + " in " + WaveGolden.PATH + ": record it on the pre-conversion "
                + "tree (touch " + WaveGolden.MARKER + " and run once)");
            return false;
        }
        int64 from = at + (int64) needle.byteLength();
        int64 end = WaveGolden.table.indexOfFrom("\n", from);
        if (end < 0L) { end = (int64) WaveGolden.table.byteLength(); }
        String have #= WaveGolden.table.substring((int32) from, (int32) end);
        if (have.equals(v)) { return true; }
        int64 r = 0;
        while (r < n) {
            String want #= WaveGolden.field(have, r);
            String mine #= "" + Cajeta.f32ToBits(got[r]);
            if (!want.equals(mine)) {
                Assert.fail(kernel + " " + tag + ": row " + r + " is not bit-identical "
                    + "to the wave-32 golden: got " + got[r] + " (bits " + mine
                    + "), golden bits " + want);
                return false;
            }
            r = r + 1;
        }
        Assert.fail(kernel + " " + tag + ": output differs from the wave-32 golden "
            + "beyond row " + n);
        return false;
    }
}
