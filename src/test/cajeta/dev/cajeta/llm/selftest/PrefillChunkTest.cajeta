package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;

/**
 * prefill-routes 11.1 -- what a prefill step pays on the host besides
 * its launches, read from the `prefill-chunk` record: device builds of
 * weights met for the first time, buffer growth, and the K/V writeback
 * to the paged cache. On the shexp fixture: after the prewarm the
 * first step streams nothing; the chunks after it grow nothing; a
 * mid-sequence chunk writes no K/V back inside the layer loop.
 */
public class PrefillChunkTest {

    public PrefillChunkTest() { return; }

    static boolean skip() {
        String be #= Device.activeBackend();
        if (!be.equals("hip")) {
            DeviceSkip.tracked("backend " + be
                + " has no batched device prefill", "xpu-kernel-adaptor 7");
            return true;
        }
        return false;
    }

    static #PrefillTap steps() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        m.prewarmPrefillWeights();
        int32[] toks = heap int32[12];
        int32 i = 0;
        while (i < 12) { toks[i] = 3 + i * 7; i = i + 1; }
        PrefillTap tap = heap PrefillTap();
        Diag.register(tap);
        m.stepSeq(0, toks, 0, 4);
        m.stepSeq(0, toks, 4, 4);
        m.stepSeq(0, toks, 8, 4);
        Diag.register(null);
        return #tap;
    }

    @Test
    public void thePrewarmedFirstStepStreamsNoWeights() {
        if (PrefillChunkTest.skip()) { return; }
        PrefillTap tap #= PrefillChunkTest.steps();
        Assert.equals(3L, (int64) tap.countOf("prefill-chunk"));
        Assert.equals(4L, tap.valueOf("prefill-chunk", 0, 0));
        Assert.equals(0L, tap.valueOf("prefill-chunk", 0, 1));
        int64 lazy = tap.valueOf("prefill-chunk", 0, 2);
        if (lazy != 0L) {
            Assert.fail("the first step after prewarmPrefillWeights built "
                + "device weights for " + (lazy / 1000L) + " us");
        }
    }

    @Test
    public void theStepsAfterTheFirstGrowNothing() {
        if (PrefillChunkTest.skip()) { return; }
        PrefillTap tap #= PrefillChunkTest.steps();
        int32 j = 1;
        while (j < 3) {
            int64 lazy = tap.valueOf("prefill-chunk", j, 2);
            int64 grow = tap.valueOf("prefill-chunk", j, 3);
            if (lazy != 0L || grow != 0L) {
                Assert.fail("step " + j + " at position "
                    + tap.valueOf("prefill-chunk", j, 1) + ": lazy "
                    + (lazy / 1000L) + " us, grow " + (grow / 1000L) + " us");
            }
            j = j + 1;
        }
    }

    @Test
    public void aMidSequenceChunkWritesNoKvBackInsideTheLayerLoop() {
        if (PrefillChunkTest.skip()) { return; }
        PrefillTap tap #= PrefillChunkTest.steps();
        Assert.equals(4L, tap.valueOf("prefill-chunk", 1, 1));
        int64 kv = tap.valueOf("prefill-chunk", 1, 4);
        if (kv != 0L) {
            Assert.fail("the chunk at position 4 spent " + (kv / 1000L)
                + " us writing K/V back per layer");
        }
    }

    /** The rows one chunk carries. `steps()` drives three of them. */
    static final int32 CHUNK = 4;

    /**
     * The does NOT fire arm, and it runs on every backend including cpu.
     *
     * With kernel routing pinned off every projection refuses the batched
     * GEMM, `batchRoutedFor` says no, and the step takes the per row
     * path. No `prefill-chunk` record is emitted there. That is what
     * makes the record a signature of the batched route rather than of a
     * step in general, so a green run on a backend that quietly stopped
     * batching cannot look identical to a correct one.
     */
    @Test
    public void aPerRowPrefillEmitsNoChunkRecord() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        QuantKernel.setRoutingEnabled(false);
        PrefillTap tap = heap PrefillTap();
        Diag.register(tap);
        boolean routed = m.batchRoutedFor(PrefillChunkTest.CHUNK);
        int32[] toks = heap int32[PrefillChunkTest.CHUNK];
        int32 i = 0;
        while (i < PrefillChunkTest.CHUNK) {
            toks[i] = 3 + i * 7;
            i = i + 1;
        }
        m.stepSeq(0, toks, 0, PrefillChunkTest.CHUNK);
        Diag.register(null);
        // Routing goes back ON before the first assertion. An assertion
        // throws, and a throw with the routes still off would leave every
        // later test in this binary running on the host paths.
        QuantKernel.setRoutingEnabled(true);
        Assert.isTrue(!routed);
        Assert.equals(0L, (int64) tap.countOf("prefill-chunk"));
        Assert.isTrue(tap.saw("prefill-mode", "per-row"));
    }

    /**
     * The FIRES arm: where the batched route is taken the step emits one
     * `prefill-chunk` record per chunk and says `batched`.
     *
     * This is the measurement that retires the backend NAME gate this
     * suite used to carry. It asks the engine whether the route ran
     * instead of asking which vendor supplied the device.
     */
    @Test
    public void theChunkRecordIsEmittedWhereTheBatchedRouteIsTaken() {
        PrefillTap tap #= PrefillChunkTest.steps();
        if (!tap.saw("prefill-mode", "batched")) {
            Assert.fail("the moe fixture did not prefill batched on "
                + Device.activeBackend() + ", saw prefill-mode "
                + tap.namesOf("prefill-mode"));
        }
        Assert.equals(3L, (int64) tap.countOf("prefill-chunk"));
    }
}
