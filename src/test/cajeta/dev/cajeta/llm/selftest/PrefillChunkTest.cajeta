package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.KernelCap;

/**
 * prefill-routes 11.1 -- what a prefill step pays on the host besides
 * its launches, read from the `prefill-chunk` record: device builds of
 * weights met for the first time, buffer growth, and the K/V writeback
 * to the paged cache. On the shexp fixture: after the prewarm the
 * first step streams nothing; the chunks after it grow nothing; a
 * mid-sequence chunk writes no K/V back inside the layer loop.
 */
public class PrefillChunkTest {

    public PrefillChunkTest() { return; }

    /**
     * Does this backend take the BATCHED device prefill for the shexp
     * fixture?
     *
     * This used to skip unless the backend was named "hip", with the
     * reason "backend <be> has no batched device prefill". That reason
     * was never checked and on cuda it is false: the `prefill-chunk`
     * record these tests read is emitted inside `forwardRowsBatched`,
     * and DenseRouteProbe reports that path taken there (prefill-mode
     * batched, zero refusals). Three nvptx tests skipped for a claim
     * about a backend's name.
     *
     * So ask the predicate `forwardRowsBatched` itself checks, at the
     * chunk size `steps()` actually uses.
     */
    static boolean skip() {
        return PrefillChunkTest.skipUnlessBatched(false);
    }

    /**
     * As {@link #skip}, and for `needAttend` also requires the DEVICE
     * ATTEND.
     *
     * MEASURED on cpu 2026-09-25, once the batch gate stopped reading a
     * backend name and this suite started running there: the chunk at
     * position 4 spends a sub-microsecond writing K/V back inside the
     * layer loop, and the test that asserts it spends none went red.
     * That is not a defect, it is the test's invariant being narrower
     * than its gate. The writeback inside the layer loop is what the
     * DEVICE KV planes remove, and those stay shut on a backend without
     * the flash kernels, which is the cpu backend behaving correctly.
     * So the test that reads the K/V number asks for the attend too,
     * and the two that read the streaming and growth numbers do not.
     */
    static boolean skipUnlessBatched(boolean needAttend) {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        if (m.batchRoutedFor(4)
                && (!needAttend || KernelCap.attendHere())) {
            return false;
        }
        String miss #= RoutableFixtureTest.missingKernels();
        if (miss.count() > 0L) {
            DeviceSkip.tracked("the shexp fixture does not take the"
                + " batched device prefill here; kernels this backend"
                + " does not register: " + miss,
                "xpu-kernel-adaptor 4.2.1");
            return true;
        }
        DeviceSkip.noRoute("batched device prefill for the shexp fixture",
            Device.activeBackend());
        return true;
    }

    static #PrefillTap steps() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        m.prewarmPrefillWeights();
        int32[] toks = heap int32[12];
        int32 i = 0;
        while (i < 12) { toks[i] = 3 + i * 7; i = i + 1; }
        PrefillTap tap = heap PrefillTap();
        Diag.register(tap);
        m.stepSeq(0, toks, 0, 4);
        m.stepSeq(0, toks, 4, 4);
        m.stepSeq(0, toks, 8, 4);
        Diag.register(null);
        return #tap;
    }

    @Test
    public void thePrewarmedFirstStepStreamsNoWeights() {
        if (PrefillChunkTest.skip()) { return; }
        PrefillTap tap #= PrefillChunkTest.steps();
        Assert.equals(3L, (int64) tap.countOf("prefill-chunk"));
        Assert.equals(4L, tap.valueOf("prefill-chunk", 0, 0));
        Assert.equals(0L, tap.valueOf("prefill-chunk", 0, 1));
        int64 lazy = tap.valueOf("prefill-chunk", 0, 2);
        if (lazy != 0L) {
            Assert.fail("the first step after prewarmPrefillWeights built "
                + "device weights for " + (lazy / 1000L) + " us");
        }
    }

    @Test
    public void theStepsAfterTheFirstGrowNothing() {
        if (PrefillChunkTest.skip()) { return; }
        PrefillTap tap #= PrefillChunkTest.steps();
        int32 j = 1;
        while (j < 3) {
            int64 lazy = tap.valueOf("prefill-chunk", j, 2);
            int64 grow = tap.valueOf("prefill-chunk", j, 3);
            if (lazy != 0L || grow != 0L) {
                Assert.fail("step " + j + " at position "
                    + tap.valueOf("prefill-chunk", j, 1) + ": lazy "
                    + (lazy / 1000L) + " us, grow " + (grow / 1000L) + " us");
            }
            j = j + 1;
        }
    }

    @Test
    public void aMidSequenceChunkWritesNoKvBackInsideTheLayerLoop() {
        if (PrefillChunkTest.skipUnlessBatched(true)) { return; }
        PrefillTap tap #= PrefillChunkTest.steps();
        Assert.equals(4L, tap.valueOf("prefill-chunk", 1, 1));
        int64 kv = tap.valueOf("prefill-chunk", 1, 4);
        if (kv != 0L) {
            Assert.fail("the chunk at position 4 spent " + (kv / 1000L)
                + " us writing K/V back per layer");
        }
    }
}
