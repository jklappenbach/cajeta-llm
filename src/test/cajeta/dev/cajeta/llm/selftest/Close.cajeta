package dev.cajeta.llm.selftest;

/**
 * A bounded comparison of two float32 rows, for a test that compares one
 * summation order against another. A fused kernel and the two-launch chain
 * it replaces accumulate the same products in different orders; on nvptx
 * the orders coincide by construction, on cpu at the emulated 32-lane wave
 * they do not, and the fused GLU kernels differed from their chains in 63,
 * 64 and 128 rows by rounding alone while replaying bit-exact through the
 * reference interpreter (xpu-kernel-adaptor 4.2.1.12, 2026-10-07). A wrong
 * answer is 20 to 100x off; a reordered sum is a few ULPs. The bound is
 * `|a - b| <= rel * max(|a|, |b|) + abs`.
 */
public final class Close {
    private Close() {}

    /** Rows of `a` and `b` (the first `n`) outside the bound. */
    public static int64 rowsOutside(float32[] a, float32[] b, int64 n, float32 rel, float32 abs) {
        int64 out = 0L;
        int64 i = 0L;
        while (i < n) {
            float32 x = a[i];
            float32 y = b[i];
            float32 d = x - y;
            if (d < 0.0f) { d = -d; }
            float32 ax = x < 0.0f ? -x : x;
            float32 ay = y < 0.0f ? -y : y;
            float32 m = ax > ay ? ax : ay;
            if (d > rel * m + abs) { out = out + 1L; }
            i = i + 1L;
        }
        return out;
    }

    /** The largest `|a - b| / max(|a|, |b|)` over the first `n` rows, 0 when all agree. */
    public static float32 maxRel(float32[] a, float32[] b, int64 n) {
        float32 worst = 0.0f;
        int64 i = 0L;
        while (i < n) {
            float32 x = a[i];
            float32 y = b[i];
            float32 d = x - y;
            if (d < 0.0f) { d = -d; }
            float32 ax = x < 0.0f ? -x : x;
            float32 ay = y < 0.0f ? -y : y;
            float32 m = ax > ay ? ax : ay;
            if (m > 0.0f && d / m > worst) { worst = d / m; }
            i = i + 1L;
        }
        return worst;
    }
}
