package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Runner;
import cajeta.xpu.Device;

/**
 * Test entry: reflective discovery runs every `@Test` across the binary.
 * Returns 0 when all green, 1 on any failure.
 *
 * 25.4: a failed kernel launch fails the SUITE even when every test
 * assertion passed. Twice running (Unit 22's static-field alias, Unit
 * 25's staging corpse) the driver printed "launch FAILED" to stderr
 * while the suite printed all green — a dispatch that never ran means
 * something computed on garbage or leftovers, whatever the assertions
 * happened to check. The counter is process-wide
 * (Device.launchFailures), so this catches a failure in ANY test
 * without each test asserting the delta itself.
 */
public final class TestMain {
    public static int32 run() {
        int32 rc = Runner.runAll();
        int64 lf = Device.launchFailures();
        if (lf > 0L) {
            System.stdout.println("LAUNCH FAILURES: " + lf
                + " kernel dispatch(es) never ran — failing the suite (25.4)");
            if (rc == 0) { rc = 1; }
        }
        return rc;
    }
}
