package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.unit.Skip;

/**
 * The two kinds of device skip, and no third (cajeta xpu-kernel-adaptor
 * plan 1.6.3 to 1.6.5).
 *
 * A test that cannot run on this backend or this box says which of two
 * things is true, and the suite counts it as SKIPPED, never PASSED:
 *
 *   cannot   the backend or the box truly cannot: no XPU backend at all,
 *            a witness model that is not on disk, a wave width the kernel
 *            was not written for, a counter the driver does not expose.
 *            A fact about the world, stated.
 *   tracked  a defect wearing a skip's clothing: a kernel that does not
 *            lower here, or a route the table does not offer this backend
 *            though the kernel exists. Names the plan item that retires it.
 *
 * `run-tests.sh` fails the run on a `[device-skip]` line carrying neither
 * marker, so a new skip cannot arrive untracked. The old form printed a
 * note and RETURNED, counting a pass; both forms here throw through
 * `Skip.because`, so the `return` after a call is never reached.
 */
public final class DeviceSkip {

    public DeviceSkip() { return; }

    /** The backend or the box truly cannot; `what` says why. */
    public static void cannot(String what) {
        System.stdout.println("  [device-skip] [cannot] (skipped: " + what + ")");
        Skip.because(what);
    }

    /** A defect or a route gap; `item` is the plan line that retires it. */
    public static void tracked(String what, String item) {
        System.stdout.println("  [device-skip] [tracked: " + item + "] (skipped: "
            + what + ")");
        Skip.because(what);
    }

    /** The lowering gap: `kernel` has no device code on this backend. */
    public static void noKernel(String kernel, String backend) {
        DeviceSkip.tracked(kernel + " does not lower on " + backend,
            "xpu-kernel-adaptor 4.2.1");
    }

    /** The route gap: the table does not offer `route` on this backend. */
    public static void noRoute(String route, String backend) {
        DeviceSkip.tracked("no " + route + " on " + backend
            + " (the route table keys on the backend name)",
            "xpu-kernel-adaptor 7");
    }
}
