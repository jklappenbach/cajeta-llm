package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.Math;
import cajeta.lang.String;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/** cajeta-llm 15.2.21.2: Gemma 3's sparse `text_config` resolves to transformers' Gemma3TextConfig. */
public class Gemma3ConfigTest {

    /** gemma-3-4b-it's config.json without its vision tower, as shipped. */
    static #String fourB() {
        String s #= "{\"architectures\": [\"Gemma3ForConditionalGeneration\"], \"boi_token_index\": 255999, "
            + "\"eoi_token_index\": 256000, \"eos_token_id\": [1, 106], \"image_token_index\": 262144, "
            + "\"initializer_range\": 0.02, \"mm_tokens_per_image\": 256, \"model_type\": \"gemma3\", "
            + "\"text_config\": {\"hidden_size\": 2560, \"intermediate_size\": 10240, \"model_type\": \"gemma3_text\", "
            + "\"num_hidden_layers\": 34, \"rope_scaling\": {\"factor\": 8.0, \"rope_type\": \"linear\"}, "
            + "\"sliding_window\": 1024}, \"torch_dtype\": \"bfloat16\", \"transformers_version\": \"4.50.0.dev0\"}";
        return #s;
    }

    static #ModelConfig parsed(String leaf, String json) {
        String path #= "tmp/cajeta_llm_gemma3_" + leaf;
        int8[] b #= json.toBytes();
        File.writeAllBytes(path, b, (int64) b.count());
        ModelConfig c #= ModelConfig.parse(path);
        return #c;
    }

    @Test
    public void theFourBTextConfigTakesTransformersDefaults() {
        ModelConfig c #= Gemma3ConfigTest.parsed("4b.json", Gemma3ConfigTest.fourB());
        Assert.equals("Gemma3ForConditionalGeneration", c.architecture);
        Assert.equals(2560, c.hiddenSize);
        Assert.equals(10240, c.intermediateSize);
        Assert.equals(34, c.numLayers);
        Assert.equals(8, c.numHeads);
        Assert.equals(4, c.numKvHeads);
        Assert.equals(256, c.headDim);
        Assert.equals(262208, c.vocabSize);
        Assert.equals(131072, c.maxPositionEmbeddings);
        Assert.isTrue(Math.abs(c.rmsNormEps - 0.000001f) < 1.0e-12f);
        Assert.isTrue(c.tieWordEmbeddings);
        Assert.equals(1, c.activation);
        Assert.equals(1, c.normForm);
        Assert.isTrue(c.qkNorm);
        Assert.isTrue(c.fourNorm);
        Assert.isTrue(Math.abs(c.queryScale - 0.0625f) < 1.0e-9f);
        Assert.isTrue(Math.abs(c.embedScale - Math.sqrt(2560.0f)) < 1.0e-4f);
    }

    @Test
    public void globalLayersTakeTheScaledRopeAndLocalLayersTheirOwnBase() {
        ModelConfig c #= Gemma3ConfigTest.parsed("4b-rope.json", Gemma3ConfigTest.fourB());
        Assert.isTrue(c.ropeTheta == 1000000.0f);
        Assert.equals(1, c.ropeScalingType);
        Assert.isTrue(c.ropeScalingFactor == 8.0f);
        Assert.isTrue(c.ropeLocalTheta == 10000.0f);
    }

    @Test
    public void everySixthLayerIsGlobal() {
        ModelConfig c #= Gemma3ConfigTest.parsed("4b-windows.json", Gemma3ConfigTest.fourB());
        int32 l = 0;
        while (l < 34) {
            int32 want = ((l + 1) % 6 == 0) ? 0 : 1024;
            Assert.equals(want, c.windowForLayer(l));
            l = l + 1;
        }
    }

    @Test
    public void aFlatGemma3ForCausalLmConfigParsesTheSame() {
        ModelConfig c #= Gemma3ConfigTest.parsed("flat.json",
            "{\"architectures\": [\"Gemma3ForCausalLM\"], \"hidden_size\": 1152, \"intermediate_size\": 6912, "
            + "\"num_hidden_layers\": 26, \"num_attention_heads\": 4, \"num_key_value_heads\": 1, "
            + "\"head_dim\": 256, \"vocab_size\": 262144, \"sliding_window\": 512, \"sliding_window_pattern\": 6, "
            + "\"rope_theta\": 1000000.0, \"rope_local_base_freq\": 10000.0, \"rope_scaling\": null, "
            + "\"query_pre_attn_scalar\": 256, \"rms_norm_eps\": 1e-06, \"model_type\": \"gemma3_text\"}");
        Assert.equals(1152, c.hiddenSize);
        Assert.equals(1, c.numKvHeads);
        Assert.equals(0, c.ropeScalingType);
        Assert.isTrue(c.ropeLocalTheta == 10000.0f);
        Assert.equals(512, c.windowForLayer(0));
        Assert.equals(0, c.windowForLayer(5));
        Assert.isTrue(Math.abs(c.embedScale - Math.sqrt(1152.0f)) < 1.0e-4f);
    }

    @Test
    public void aMultimodalCheckpointResolvesItsTextStackByTheTextNames() {
        ToyModel t = heap ToyModel(4);
        t.add("language_model.model.embed_tokens.weight", 8L, 4L);
        t.add("language_model.model.layers.0.self_attn.q_norm.weight", 4L, 0L);
        t.add("vision_tower.vision_model.embeddings.patch_embedding.bias", 4L, 0L);
        t.add("model.norm.weight", 4L, 0L);
        String path #= "tmp/cajeta_llm_gemma3_mm.safetensors";
        ToyModel.writeWeights(path, t);
        Checkpoint c #= Checkpoint.open(path);
        Assert.isTrue(c.contains("model.embed_tokens.weight"));
        Assert.isTrue(c.contains("model.layers.0.self_attn.q_norm.weight"));
        Assert.isTrue(c.contains("model.norm.weight"));
        Assert.isTrue(!c.contains("language_model.model.embed_tokens.weight"));
        Assert.isTrue(c.contains("vision_tower.vision_model.embeddings.patch_embedding.bias"));
        Assert.equals(8L, c.shapeOf("model.embed_tokens.weight")[0]);
    }

    @Test
    public void aLlamaConfigKeepsOneRopeAndNoEmbeddingScale() {
        ModelConfig c #= Gemma3ConfigTest.parsed("llama.json",
            "{\"architectures\": [\"LlamaForCausalLM\"], \"hidden_size\": 64, \"intermediate_size\": 128, "
            + "\"num_hidden_layers\": 2, \"num_attention_heads\": 4, \"vocab_size\": 32, \"rope_theta\": 500000.0}");
        Assert.isTrue(c.ropeLocalTheta == 0.0f);
        Assert.isTrue(c.embedScale == 0.0f);
        Assert.equals(0, c.windowForLayer(1));
    }
}
