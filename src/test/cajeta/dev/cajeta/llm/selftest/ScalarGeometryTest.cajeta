    @Test
    public void iq4xsIsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("iq4xsMatVecKernel",
            ScalarGeometryTest.BY_TYPE, Quant.GG_IQ4_XS, "iq4_xs.bin");
