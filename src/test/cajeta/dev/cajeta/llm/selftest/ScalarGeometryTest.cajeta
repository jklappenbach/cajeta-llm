    @Test
    public void iq4nlIsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("iq4nlMatVecKernel",
            ScalarGeometryTest.BY_TYPE, Quant.GG_IQ4_NL, "iq4_nl.bin");
