    @Test
    public void q51IsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("q51MatVecKernel",
            ScalarGeometryTest.BY_TYPE, Quant.GG_Q5_1, "q5_1.bin");
