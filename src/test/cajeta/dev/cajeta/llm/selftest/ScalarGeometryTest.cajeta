package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The geometry gate for the scalar mat-vec family (xpu-kernel-adaptor Unit
 * 11). One work item is one whole row, addressed by its global id, so the
 * workgroup size is a SCHEDULING width and nothing else: the output must
 * be the same bits at every block the launcher may pass. That is what lets
 * the block be derived per device (11.2.1) and swept (11.1.2) without a
 * correctness question riding on the answer.
 *
 * 200 rows, no two alike, which no block of the sweep divides: the last
 * workgroup is ragged at 32, 64 and 128 and the only workgroup is ragged
 * at 256.
 */
public class ScalarGeometryTest {

    static final String DIR = "src/test/fixtures/gguf/kquant/";
    static final int64 ROWS = 200L;
    static final int64 COLS = 512L;

    public ScalarGeometryTest() { return; }

    static boolean sameBits(float32[] a, float32[] b, int64 n, String what) {
        int64 i = 0;
        while (i < n) {
            if (Cajeta.f32ToBits(a[i]) != Cajeta.f32ToBits(b[i])) {
                Assert.fail(what + ": row " + i + " reads " + b[i] + " against "
                    + a[i]);
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /** Which launcher `run` drives: the by-type f32 family, or one of the
     *  three with their own buffers. */
    static final int32 BY_TYPE = 0;
    static final int32 Q4K_Q8 = 1;
    static final int32 Q4K_Q8_PACKED = 2;
    static final int32 MXFP4_PLAIN = 3;

    static void run(int32 how, int32 ty, int8[] raw, float32[] x, float32[] out,
            int64 rows, int64 cols) {
        if (how == ScalarGeometryTest.Q4K_Q8) {
            QuantKernel.q4kQ8MatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else if (how == ScalarGeometryTest.Q4K_Q8_PACKED) {
            QuantKernel.q4kQ8PackedMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else if (how == ScalarGeometryTest.MXFP4_PLAIN) {
            KernelBuffer<int8> wD #= heap KernelBuffer<int8>((uint64) ((int64) raw.count()));
            wD.upload(raw);
            KernelBuffer<float32> xD #= heap KernelBuffer<float32>((uint64) cols);
            xD.upload(x);
            KernelBuffer<float32> yD #= heap KernelBuffer<float32>((uint64) rows);
            yD.upload(out);
            QuantKernel.mxfp4MatVecLaunchNoSync(yD, wD, xD, rows, cols, 0L, 0L);
            QuantKernel.stream().sync();
            yD.download(out);
        } else {
            QuantKernel.matVecIntoDevice(ty, raw, rows, cols, x, 0L, out, 0L);
        }
    }

    /**
     * 11.1.1 + 11.2.1: `kernel` answers the same bits at the derived block
     * and at every block of the sweep, and each launch took its geometry
     * from the family's one derivation.
     */
    static void acrossBlocks(String kernel, int32 how, int32 ty, String fixture) {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        int64 rows = ScalarGeometryTest.ROWS;
        int64 cols = ScalarGeometryTest.COLS;
        int64 bpr = cols / (int64) Quant.blockElems(ty);
        int8[] raw #= ty == Quant.GG_MXFP4
            ? Mxfp4Test.fillPacked(rows, bpr)
            : WaveGeometryTest.rowsOf(fixture, ty, rows, bpr);
        float32[] x #= QuantKernelTest.activations(cols);
        float32[] base #= heap float32[rows];
        int64[] vc #= ValueCheck.mark();
        QuantKernel.setScalarRowsPerBlock(0);
        int64 d0 = QuantKernel.scalarGridDerivations();
        int64 l0 = Device.kernelLaunchCount(kernel);
        ScalarGeometryTest.run(how, ty, raw, x, base, rows, cols);
        if (QuantKernel.scalarGridDerivations() != d0 + 1L) {
            Assert.fail(kernel + ": its launcher did not take the derived geometry ("
                + (QuantKernel.scalarGridDerivations() - d0) + " derivations for one "
                + "launch)");
            return;
        }
        if (Device.kernelLaunchCount(kernel) != l0 + 1L) {
            Assert.fail(kernel + ": the launch did not reach the kernel");
            return;
        }
        QuantKernelTest.assertLive(base, kernel + " at the derived block");
        int32[] blocks = [ 32, 64, 128, 256 ];
        boolean ok = true;
        int64 b = 0;
        while (b < 4L) {
            float32[] got #= heap float32[rows];
            QuantKernel.setScalarRowsPerBlock(blocks[b]);
            int32 used = QuantKernel.rowsPerBlock();
            ScalarGeometryTest.run(how, ty, raw, x, got, rows, cols);
            QuantKernel.setScalarRowsPerBlock(0);
            if (!ScalarGeometryTest.sameBits(base, got, rows,
                    kernel + " at block " + used + " (asked " + blocks[b] + ")")) {
                ok = false;
            }
            b = b + 1;
        }
        if (ok) { ValueCheck.credit(vc); }
    }

    @Test
    public void q4kIsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("q4kMatVecKernel",
            ScalarGeometryTest.BY_TYPE, Quant.GG_Q4_K, "q4_k.bin");
    }

    @Test
    public void q5kIsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("q5kMatVecKernel",
            ScalarGeometryTest.BY_TYPE, Quant.GG_Q5_K, "q5_k.bin");
    }

