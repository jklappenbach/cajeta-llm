    @Test
    public void mxfp4Fast3IsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("mxfp4MatVecKernelFast3",
            ScalarGeometryTest.BY_TYPE, Quant.GG_MXFP4, "");
    }

    @Test
    public void mxfp4IsTheSameBitsAtEveryBlock() {
        ScalarGeometryTest.acrossBlocks("mxfp4MatVecKernel",
            ScalarGeometryTest.MXFP4_PLAIN, Quant.GG_MXFP4, "");
