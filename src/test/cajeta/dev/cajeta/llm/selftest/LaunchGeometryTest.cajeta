package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import cajeta.xpu.Device;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Linear;
import cajeta.lang.String;
import cajeta.lang.System;

/**
 * device-geometry-parameterization 6.1 — the launch geometry is DERIVED from
 * the part it runs on, not carried from the one it was measured on.
 *
 * `Linear.TARGET_BLOCKS = 80` was measured on gfx1151 and its comment already
 * stated the law: "5120 rows / 64 rows per workgroup = 80 workgroups x 2
 * wave32 waves = 160 waves = exactly one per SIMD on this part's 40 CUs".
 * Everything in that sentence after "one per SIMD" is a fact about Strix Halo.
 * Frozen, it under-dispatched an RTX 4090 by 3.2x — 80 workgroups where the
 * same law asks for 256.
 *
 * These tests deliberately assert the LAW and not a number. A test that
 * hardcoded 256 would be the same mistake one machine later; a test that
 * hardcodes 80 is what let the constant travel in the first place. The
 * gfx1151 REPRODUCTION — that the law still yields exactly 80 on the part it
 * was measured on — is pinned GPU-free in the compiler, where a fixture can
 * stand in for a device this box does not have
 * (`XpuDeviceProfileTests.dispatchLawReproducesTheFrozenAmdConstant`).
 */
public class LaunchGeometryTest {

    /**
     * The law itself: every SIMD on the part gets exactly one block's worth
     * of waves. Stated as an identity over queried quantities, so it holds on
     * any device and pins nothing about this one.
     */
    @Test
    public void targetBlocksCoversEverySimdToItsWaveTarget() {
        int32 wave = Device.waveSize();
        if (wave <= 0) {
            // No queryable device. The contract there is the measured
            // fallback, and asserting THAT is the point — a fallback that
            // quietly became a derived-from-nothing number would be worse
            // than the frozen constant it replaced.
            Assert.equals((int64) 80, (int64) Linear.launchTargetBlocks());
            return;
        }
        int32 wavesPerBlock = (QuantKernel.rowsPerBlock() + wave - 1) / wave;
        // ONE WAVE PER SIMD WAS THE OLD LAW, and 6.3.2 measured it
        // under-filling by ~16%: the device reports how many waves per
        // SIMD it wants resident (`wavesPerSimdTarget`, 2 on gfx1151)
        // and the geometry surface answers
        // `simds * wavesPerSimdTarget / wavesPerBlock`. Asserting
        // simds/wavesPerBlock here outlived that change and failed at
        // 40 against 80 for a dispatch that is deliberately 2x
        // oversubscribed.
        //
        // The invariant that survives is the COVERAGE, not the count:
        // the launch must put `wavesPerSimdTarget` waves on every SIMD.
        // That still fails if targetBlocks stops following
        // dispatchBlocks, or if dispatchBlocks stops following the
        // device — it is not the tautology `expected = dispatchBlocks`.
        // 2026-09-19: this asserted EQUALITY and that is now the wrong
        // invariant. `dispatchBlocks` is a FLOOR, not a maximum -- its old
        // claim that throughput falls on both sides of the target was
        // measured on gfx1151 and is false on Ada, where the interleaved
        // Q4_K mat-vec climbs monotonically to 2.5x BEYOND this figure
        // (84.8 -> 260.4 -> 654.7 GB/s at 80 / 256 / 2048 workgroups).
        // So a tuned value is allowed to exceed the derivation, and a test
        // demanding equality would fail the machine that tuned correctly.
        //
        // What survives is coverage: the launch must put at least
        // `wavesPerSimdTarget` waves on every SIMD. That still fails if
        // targetBlocks stops following the device, and it is not the
        // tautology `expected = dispatchBlocks`.
        int32 blocks = Linear.launchTargetBlocks();
        int64 covered = (int64) blocks * (int64) wavesPerBlock;
        int64 want = (int64) Device.simdCount()
            * (int64) Device.wavesPerSimdTarget();
        System.stdout.println("   targetBlocks=" + blocks
            + " wavesPerBlock=" + wavesPerBlock
            + " covers " + covered + " of simds*target " + want);
        Assert.isTrue(covered >= want);
    }

    /** The row count is what the target workgroup count COVERS — the block
     *  count is the decision, the rows are its consequence. */
    @Test
    public void chunkRowsIsTheTargetBlockCountTimesTheBlockWidth() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) {
            // The CPU backend fans a launch across a worker pool and pays a
            // dispatch per chunk, so splitting buys nothing: chunking is off.
            Assert.equals(0L, Linear.launchChunkRows());
            return;
        }
        int64 expected = (int64) Linear.launchTargetBlocks()
            * (int64) QuantKernel.rowsPerBlock();
        Assert.equals(expected, Linear.launchChunkRows());
    }

    /**
     * The geometry surface answers, and answers consistently. A part whose
     * SIMD count is unknown would silently take the fallback branch above and
     * make that test vacuous, so assert the inputs exist separately.
     */
    @Test
    public void deviceReportsASimdPopulation() {
        if (Device.waveSize() <= 0) {
            return;   // no device; nothing to describe
        }
        Assert.isTrue(Device.multiprocessorCount() > 0);
        Assert.isTrue(Device.simdsPerMultiprocessor() > 0);
        Assert.equals(
            (int64) (Device.multiprocessorCount() * Device.simdsPerMultiprocessor()),
            (int64) Device.simdCount());
    }

    /**
     * The exhibit-2 invariant, in the language: a block's shared-memory
     * ceiling never exceeds its multiprocessor's budget, and a kernel sizing
     * a tile must read the FORMER. On RDNA the two are equal, which is why
     * reading the per-MP figure was right there by accident; on Ada the
     * per-block ceiling is roughly half, and a tile sized against the wrong
     * one fails inside ptxas rather than at the call site.
     */
    @Test
    public void perBlockSharedCeilingNeverExceedsThePerMpBudget() {
        int64 perBlock = Device.sharedBytesPerBlock();
        int64 perMp = Device.sharedBytesPerMultiprocessor();
        if (perBlock <= 0L || perMp <= 0L) {
            return;   // not reported; 0 is unknown, not a budget
        }
        Assert.isTrue(perBlock <= perMp);
    }

    /**
     * A MEASURED value beats a DERIVED one, which is the whole of spec
     * §1.4's third tier. `dispatchBlocks` cannot know where a part's
     * throughput saturates -- that depends on the cache hierarchy's
     * response to one kernel's access stride, and the curve is unimodal on
     * gfx1151 and monotonic on Ada -- so when the store holds an answer
     * measured on THIS machine, it wins outright.
     */
    @Test
    public void aTunedTargetBeatsTheDerivedOne() {
        int32 derived = Linear.launchTargetBlocks();
        Linear.setTunedTargetBlocks(derived * 4);
        Assert.equals((int64) (derived * 4),
            (int64) Linear.launchTargetBlocks());
        Linear.setTunedTargetBlocks(0);
        Assert.equals((int64) derived, (int64) Linear.launchTargetBlocks());
    }

    /**
     * Does NOT fire: with nothing tuned, the derived value stands exactly.
     * Without this the override could be implemented by always returning
     * something else, and the derivation -- which is still the right answer
     * on an untuned machine -- would be silently dead.
     */
    @Test
    public void anUntunedMachineKeepsTheDerivedTarget() {
        Linear.setTunedTargetBlocks(0);
        int32 wave = Device.waveSize();
        if (wave <= 0) {
            Assert.equals((int64) 80, (int64) Linear.launchTargetBlocks());
            return;
        }
        int32 wavesPerBlock = (QuantKernel.rowsPerBlock() + wave - 1) / wave;
        Assert.equals((int64) Device.dispatchBlocks(wavesPerBlock),
            (int64) Linear.launchTargetBlocks());
    }

    /** The chunk follows the target, so tuning the one moves the other --
     *  otherwise a tuned dispatch would be computed and then not used. */
    @Test
    public void theChunkFollowsTheTunedTarget() {
        Linear.setTunedTargetBlocks(0);
        int64 base = Linear.launchChunkRows();
        // VACUOUS ON CPU, deliberately said out loud: effectiveChunkRows
        // forces 0 on the cpu/none backends, so 0 == 0*2 would pass while
        // proving nothing. Skip rather than bank a green that is not a
        // measurement -- this test has teeth only on a device backend.
        if (base <= 0L) { return; }
        Linear.setTunedTargetBlocks(Linear.launchTargetBlocks() * 2);
        Assert.equals(base * 2L, Linear.launchChunkRows());
        Linear.setTunedTargetBlocks(0);
        Assert.equals(base, Linear.launchChunkRows());
    }
}
