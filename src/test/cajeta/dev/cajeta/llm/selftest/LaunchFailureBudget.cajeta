package dev.cajeta.llm.selftest;

/**
 * The 25.4 suite gate fails the run when `Device.launchFailures()` is
 * nonzero at exit — and 21.1.6 FORCES a failure on purpose, to prove it
 * becomes a record. A deliberate failure declares itself here, and
 * `TestMain` fails the suite only on failures above the declared
 * budget. The counter is monotonic by design (a test cannot quietly
 * absorb someone else's failure by resetting it); the budget is the
 * explicit, auditable allowance.
 */
public final class LaunchFailureBudget {

    static int64 exp;

    public LaunchFailureBudget() { return; }

    /** Declare `n` deliberate launch failures. Call BEFORE forcing. */
    public static void expect(int64 n) {
        LaunchFailureBudget.exp = LaunchFailureBudget.exp + n;
        return;
    }

    public static int64 expected() {
        return LaunchFailureBudget.exp;
    }
}
