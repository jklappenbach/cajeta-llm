package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.sched.Request;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * Batched prefill across requests (cajeta-llm 15.2.15.1.4): the prompts a
 * step admits together are prefilled in ONE pass over the weights, as the
 * decode rows already are. Measured 2026-10-24 on the 4090: four 512-token
 * prompts ran as four 37.5 ms passes with 11.6 ms of host between them,
 * where llama.cpp runs one 2048-row pass; the device rate per token was the
 * same. The pass must not change an answer: every sequence's greedy stream
 * is held equal to the same prompt prefilled alone.
 */
public class BatchPrefillTest {
    static final int32 SEQS = 4;
    static final int32 GEN = 8;

    public BatchPrefillTest() { return; }

    static #LlmEngine engine(int32 seqs) {
        EngineOptions o #= heap EngineOptions(RoutableFixtureTest.FIX);
        o.ctx = 128;
        o.maxSeqs = seqs;
        o.blockTokens = 16;
        o.chunk = 64;
        LlmEngine e #= LlmEngine.load(#o);
        return #e;
    }

    /** Records of `cat` whose field 0 is `rows` and whose field `flag` is 1. */
    static int32 countTimedAt(PrefillTap cap, String cat, int64 rows, int32 flag) {
        int32 n = 0;
        int32 j = 0;
        int32 total = cap.countOf(cat);
        while (j < total) {
            if (cap.valueOf(cat, j, 0) == rows && cap.valueOf(cat, j, flag) == 1L) {
                n = n + 1;
            }
            j = j + 1;
        }
        return n;
    }

    /** The tile shapes of the batch's row count (maxSeqs chunks) are chosen
     *  at load, so a pass over four full chunks times no shape on a token a
     *  user waits for (15.2.15.1.4). */
    @Test
    public void theBatchRowCountsTileShapesAreChosenAtLoad() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        PrefillTap load = heap PrefillTap();
        Diag.register(load);
        LlmEngine all #= BatchPrefillTest.engine(BatchPrefillTest.SEQS);
        int32 chunk = 64;
        int64 rows = (int64) (BatchPrefillTest.SEQS * chunk);
        Diag.register(null);
        // The mechanism: the engine says which row count it warmed.
        Assert.equals(rows, (int64) all.model().batchShapePrewarmRows());
        if (!all.model().decodeBatchReady()) {
            all.close();
            DeviceSkip.tracked("backend " + be + " does not route batched decode",
                "cajeta-llm 15.2.15.1.4");
            return;
        }
        // Four full chunks: a pass of exactly the warmed row count.
        PrefillTap run = heap PrefillTap();
        Diag.register(run);
        Linear.resetRouteSaid();
        int32 q = 0;
        while (q < BatchPrefillTest.SEQS) {
            int32[] p #= RoutableFixtureTest.promptOf(chunk, 5 + 11 * q);
            all.submitTokens(p, chunk, 4, #heap SampleParams(0.0f, (int64) (41 + q)));
            q = q + 1;
        }
        all.runAll(400);
        Diag.register(null);
        boolean tile = run.sawContaining("batch-route", "tcTile");
        int32 timedInRun = BatchPrefillTest.countTimedAt(run, "tile-choice", rows, 5);
        int32 chosenAtLoad = load.countOf("tile-choice");
        all.close();
        Assert.equals(1L, (int64) run.countOf("prefill-batch"));
        Assert.equals(rows, run.valueOf("prefill-batch", 0, 0));
        if (!tile) {
            DeviceSkip.tracked("the fixture does not take the tensor-core tile here",
                "cajeta-llm 15.2.15.1.4");
            return;
        }
        // Chosen at load (timed or served), never timed inside the pass.
        Assert.equals(0L, (int64) timedInRun);
        if (chosenAtLoad == 0) {
            Assert.fail("the tile was taken in the pass, but no shape was chosen at load");
        }
    }

    /** Every buffer the pass of maxSeqs chunks needs is sized at load or at
     *  submit, so the pass itself grows nothing: its record counts zero
     *  growths (15.2.15.1.4). */
    @Test
    public void theBatchRowCountsBuffersAreGrownBeforeThePass() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        LlmEngine all #= BatchPrefillTest.engine(BatchPrefillTest.SEQS);
        int32 chunk = 64;
        int64 rows = (int64) (BatchPrefillTest.SEQS * chunk);
        if (!all.model().decodeBatchReady()) {
            all.close();
            DeviceSkip.tracked("backend " + be + " does not route batched decode",
                "cajeta-llm 15.2.15.1.4");
            return;
        }
        PrefillTap run = heap PrefillTap();
        Diag.register(run);
        // Routes are said once a process; an earlier test may have said them.
        Linear.resetRouteSaid();
        int32 q = 0;
        while (q < BatchPrefillTest.SEQS) {
            int32[] p #= RoutableFixtureTest.promptOf(chunk, 5 + 11 * q);
            all.submitTokens(p, chunk, 4, #heap SampleParams(0.0f, (int64) (41 + q)));
            q = q + 1;
        }
        all.runAll(400);
        Diag.register(null);
        all.close();
        Assert.equals(1L, (int64) run.countOf("prefill-batch"));
        Assert.equals(rows, run.valueOf("prefill-batch", 0, 0));
        if (!run.sawContaining("batch-route", "tcTile")) {
            // The prewarm sizes the tile route's buffers; another route's
            // first-use growth is its own unit.
            DeviceSkip.tracked("the fixture does not take the tensor-core tile here",
                "cajeta-llm 15.2.15.1.4");
            return;
        }
        Assert.equals(0L, run.valueOf("prefill-batch", 0, 5));
    }

    /** FIRES: four prompts submitted together are prefilled as one pass — the
     *  engine says so (a `prefill-batch` record carrying the pass's rows and
     *  sequences) — and each stream equals its solo stream. */
    @Test
    public void fourPromptsPrefillInOnePassAndMatchTheirSoloStreams() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        LlmEngine all #= BatchPrefillTest.engine(BatchPrefillTest.SEQS);
        boolean ready = all.model().decodeBatchReady();
        if (!ready) {
            Diag.register(null);
            all.close();
            DeviceSkip.tracked("backend " + be + " does not route batched decode: "
                + cap.namesOf("decode-batch"), "cajeta-llm 15.2.15.1.4");
            return;
        }
        int32[] ids #= heap int32[BatchPrefillTest.SEQS];
        int32 totalRows = 0;
        int32 q = 0;
        while (q < BatchPrefillTest.SEQS) {
            int32 len = 20 + 3 * q;
            int32[] p #= RoutableFixtureTest.promptOf(len, 5 + 11 * q);
            ids[q] = all.submitTokens(p, len, BatchPrefillTest.GEN,
                #heap SampleParams(0.0f, (int64) (41 + q)));
            totalRows = totalRows + len;
            q = q + 1;
        }
        all.runAll(400);
        Diag.register(null);
        // The mechanism, not a timing: one record for the pass, naming every
        // prompt row and every sequence.
        Assert.equals(1L, (int64) cap.countOf("prefill-batch"));
        Assert.equals((int64) totalRows, cap.valueOf("prefill-batch", 0, 0));
        Assert.equals((int64) BatchPrefillTest.SEQS, cap.valueOf("prefill-batch", 0, 1));
        q = 0;
        while (q < BatchPrefillTest.SEQS) {
            LlmEngine one #= BatchPrefillTest.engine(1);
            int32 len = 20 + 3 * q;
            int32[] p #= RoutableFixtureTest.promptOf(len, 5 + 11 * q);
            int32 id = one.submitTokens(p, len, BatchPrefillTest.GEN,
                #heap SampleParams(0.0f, (int64) (41 + q)));
            one.runAll(400);
            Request solo = one.request(id);
            Request inBatch = all.request(ids[q]);
            Assert.equals((int64) BatchPrefillTest.GEN, (int64) inBatch.generatedCount());
            Assert.equals((int64) solo.generatedCount(), (int64) inBatch.generatedCount());
            int32 k = 0;
            while (k < solo.generatedCount()) {
                if (solo.generatedAt(k) != inBatch.generatedAt(k)) {
                    Assert.fail("sequence " + q + " token " + k + ": " + inBatch.generatedAt(k)
                        + " prefilled in the batch, " + solo.generatedAt(k) + " prefilled alone");
                }
                k = k + 1;
            }
            one.close();
            q = q + 1;
        }
        all.close();
    }
}
