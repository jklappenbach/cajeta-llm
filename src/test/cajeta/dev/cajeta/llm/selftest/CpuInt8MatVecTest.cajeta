    /** cajeta-llm 15.2.20.3.2: the padded Q5_0 interleave round-trips the file's rows and its pad blocks scale to zero. */
    @Test
    public void thePaddedQ50InterleaveRoundTripsAndScalesItsPadToZero() {
        int64 rows = 70L;
        int64 nb = 20L;
        int64 sbpr = 3L;
        int8[] raw #= WaveGeometryTest.rowsOf("q5_0.bin", Quant.GG_Q5_0, rows, nb);
        int8[] x #= heap int8[Quant.q50Interleave8Bytes(rows, sbpr)];
        Quant.q50Interleave8Pad(raw, 0L, rows, nb, x, 0L);
        int8[] back #= heap int8[raw.count()];
        Quant.q50Deinterleave8Pad(x, 0L, rows, nb, back, 0L);
        int64 j = 0;
        while (j < (int64) raw.count()) {
            if (back[j] != raw[j]) { Assert.fail("padded round trip byte " + j + ": " + back[j] + " vs " + raw[j]); }
            j = j + 1;
        }
        int64 g = 0;
        while (g < (rows + 7L) / 8L) {
            int64 wo = (g * sbpr + 2L) * 1408L;
            int64 k = 4L;
            while (k < 8L) {
                int64 lane = 0;
                while (lane < 8L) {
                    if (x[wo + 16L * k + lane * 2L] != 0 || x[wo + 16L * k + lane * 2L + 1L] != 0) {
                        Assert.fail("group " + g + " pad block " + k + " lane " + lane + ": scale is not zero");
                    }
                    lane = lane + 1L;
                }
                k = k + 1L;
            }
            g = g + 1L;
        }
    }

    /** cajeta-llm 15.2.20.3.3: on the cpu a weight with no cpu int8 kernel is refused the batched GEMMs, so it runs
     *  per row rather than a GPU GEMM as cpu blocks; an interleaved weight still batches. */
    @Test
    public void aCpuWeightWithNoCpuKernelIsRefusedTheGpuGemms() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the cpu backend's batch routing"); return; }
        Linear q40 #= LinearKernelRouteTest.tiledAt(Quant.GG_Q4_0, "q4_0.bin", 512, 128);
        q40.allowInterleave();
        String why = q40.batchRefusal(128L);
        if (why == null) { Assert.fail("Q4_0 on the cpu is batch-routed: a GPU GEMM would run as cpu blocks"); }
        if (!why.contains("cpu")) { Assert.fail("the refusal does not say the cpu has no kernel: " + why); }
        Linear q80 #= LinearKernelRouteTest.tiledAt(Quant.GG_Q8_0, "q8_0.bin", 512, 128);
        q80.allowInterleave();
        String ok = q80.batchRefusal(128L);
        if (ok != null) { Assert.fail("an interleaved Q8_0 weight was refused its cpu batch: " + ok); }
    }

