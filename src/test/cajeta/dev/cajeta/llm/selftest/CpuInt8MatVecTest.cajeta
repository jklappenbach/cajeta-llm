    /** cajeta-llm 15.2.20.3.16: the X8 id mat-vec (Q8_0, Q5_K, Q5_0, Q4_K) gives each selection its own expert's one-column output, bit for
     *  bit, against a shared column or one a selection, at whole and partial groups, writing nothing past its outputs. */
    @Test
    public void theX8IdMatVecIsEachSelectionsOwnLaunch() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the interleave is the cpu backend's"); return; }
        int64[] vc #= ValueCheck.mark();
        CpuInt8MatVecTest.idOf(Quant.GG_Q8_0, "q8_0.bin", 72L, true);
        CpuInt8MatVecTest.idOf(Quant.GG_Q8_0, "q8_0.bin", 70L, false);
        CpuInt8MatVecTest.idOf(Quant.GG_Q5_K, "q5_k.bin", 72L, false);
        CpuInt8MatVecTest.idOf(Quant.GG_Q5_K, "q5_k.bin", 70L, true);
        CpuInt8MatVecTest.idOf(Quant.GG_Q5_0, "q5_0.bin", 72L, false);
        CpuInt8MatVecTest.idOf(Quant.GG_Q5_0, "q5_0.bin", 70L, true);
        CpuInt8MatVecTest.idOf(Quant.GG_Q4_K, "q4_k.bin", 72L, true);
        CpuInt8MatVecTest.idOf(Quant.GG_Q4_K, "q4_k.bin", 70L, false);
        ValueCheck.credit(vc);
    }

    static void idOf(int32 ty, String fixture, int64 rows, boolean shared) {
        int64 experts = 5L;
        int64 cols = BPR * 256L;
        int64 bpr = CpuInt8MatVecTest.blocksOf(ty);
        int8[] raw #= WaveGeometryTest.rowsOf(fixture, ty, experts * rows, bpr);
        int64 rowBytes = (int64) raw.count() / (experts * rows);
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 q0 = ty == Quant.GG_Q8_0 ? 2L : ty == Quant.GG_Q5_0 ? 6L : ty == Quant.GG_Q4_K ? 16L : 48L;
        int64 qn = ty == Quant.GG_Q8_0 ? 32L : ty == Quant.GG_Q5_0 ? 16L : 128L;
        int64 blk = 0;
        while (blk < (int64) raw.count() / bb) {
            int64 e = blk * bb / (rows * rowBytes);
            int64 at = blk * bb + q0 + (blk + e) % qn;
            raw[at] = (int8) ((int32) raw[at] + (int32) e * 13);
            blk = blk + 1L;
        }
        int32[] sel = [3, 0, 3, 4];
        int64 used = 4L;
        float32[] x #= heap float32[used * cols];
        float32[] x0 #= QuantKernelTest.activationsVaried(cols);
        int64 i = 0;
        while (i < used * cols) { x[i] = x0[i % cols] * (1.0f + 0.25f * (float32) (i / cols)); i = i + 1L; }
        float32[] y #= heap float32[used * rows + 16L];
        i = 0;
        while (i < (int64) y.count()) { y[i] = 7.5f; i = i + 1L; }
        QuantKernel.x8IdVecIntoDevice(ty, raw, experts, rows, cols, sel, used, x, shared, y);
        int64 k = 0;
        while (k < used) {
            int8[] one #= heap int8[rows * rowBytes];
            int64 b = 0;
            while (b < rows * rowBytes) { one[b] = raw[(int64) sel[k] * rows * rowBytes + b]; b = b + 1L; }
            float32[] xk #= heap float32[cols];
            b = 0;
            while (b < cols) { xk[b] = x[(shared ? 0L : k * cols) + b]; b = b + 1L; }
            float32[] want #= heap float32[rows];
            CpuInt8MatVecTest.interleavedOf(ty, one, rows, cols, xk, 1L, want, false);
            int64 r = 0;
            while (r < rows) {
                if (y[k * rows + r] != want[r]) {
                    Assert.fail(fixture + " rows " + rows + " selection " + k + " row " + r + ": id " + y[k * rows + r]
                        + " vs its own launch " + want[r]);
                }
                r = r + 1L;
            }
            k = k + 1L;
        }
        i = used * rows;
        while (i < (int64) y.count()) {
            if (y[i] != 7.5f) { Assert.fail(fixture + " rows " + rows + " wrote slot " + i + " past its outputs"); }
            i = i + 1L;
        }
    }

    static void fusedAtModelShapes(int32 ty, String fixture) {
        int64 cols = 4096L;
        int64 bpr = ty == Quant.GG_Q8_0 ? cols / 32L : cols / 256L;
        int64[] rows = [4096L, 1024L, 1024L];
        int8[] ra #= WaveGeometryTest.rowsOf(fixture, ty, rows[0], bpr);
        int8[] rb #= WaveGeometryTest.rowsOf(fixture, ty, rows[1], bpr);
        int8[] rc #= WaveGeometryTest.rowsOf(fixture, ty, rows[2], bpr);
        float32[] x #= QuantKernelTest.activationsVaried(cols);
        float32[] ya #= heap float32[rows[0] + 16L];
        float32[] yb #= heap float32[rows[1] + 16L];
        float32[] yc #= heap float32[rows[2] + 16L];
        int32 m = 0;
        while (m < 3) {
            float32[] y = m == 0 ? ya : m == 1 ? yb : yc;
            int64 j = 0;
            while (j < (int64) y.count()) { y[j] = 7.5f; j = j + 1; }
            m = m + 1;
        }
        QuantKernel.x8Vec3IntoDevice(ty, ra, rows[0], rb, rows[1], rc, rows[2], cols, x, ya, yb, yc);
        m = 0;
        while (m < 3) {
            float32[] want #= heap float32[rows[m]];
            int8[] raw = m == 0 ? ra : m == 1 ? rb : rc;
            float32[] got = m == 0 ? ya : m == 1 ? yb : yc;
            CpuInt8MatVecTest.interleavedOf(ty, raw, rows[m], cols, x, 1L, want, false);
            int64 r = 0;
            while (r < rows[m] + 16L) {
                if (r >= rows[m]) {
                    if (got[r] != 7.5f) { Assert.fail(fixture + " weight " + m + " wrote slot " + r + " past its rows"); }
                } else if (got[r] != want[r]) {
                    Assert.fail(fixture + " weight " + m + " row " + r + ": fused " + got[r] + " vs its own launch " + want[r]);
                }
                r = r + 1;
            }
            m = m + 1;
        }
    }

    static void threeInOneOf(int32 ty, String fixture) {
        int64 cols = BPR * 256L;
        int64 bpr = CpuInt8MatVecTest.blocksOf(ty);
        int64[] rows = [70L, 13L, 40L];
        int8[] ra #= WaveGeometryTest.rowsOf(fixture, ty, rows[0], bpr);
        int8[] rb #= WaveGeometryTest.rowsOf(fixture, ty, rows[1], bpr);
        int8[] rc #= WaveGeometryTest.rowsOf(fixture, ty, rows[2], bpr);
        float32[] x #= QuantKernelTest.activationsVaried(cols);
        int64[] vc #= ValueCheck.mark();
        float32[] ya #= heap float32[rows[0]];
        float32[] yb #= heap float32[rows[1]];
        float32[] yc #= heap float32[rows[2]];
        QuantKernel.x8Vec3IntoDevice(ty, ra, rows[0], rb, rows[1], rc, rows[2], cols, x, ya, yb, yc);
        ValueCheck.credit(vc);
        int32 m = 0;
        while (m < 3) {
            float32[] want #= heap float32[rows[m]];
            int8[] raw = m == 0 ? ra : m == 1 ? rb : rc;
            float32[] got = m == 0 ? ya : m == 1 ? yb : yc;
            CpuInt8MatVecTest.interleavedOf(ty, raw, rows[m], cols, x, 1L, want, false);
            QuantKernelTest.assertLive(want, fixture + " weight " + m);
            int64 r = 0;
            while (r < rows[m]) {
                if (got[r] != want[r]) {
                    Assert.fail(fixture + " weight " + m + " row " + r + ": fused " + got[r] + " vs its own launch " + want[r]);
                }
                r = r + 1;
            }
            m = m + 1;
        }
    }

    static void threeInOne(int32 width) {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the interleave is the cpu backend's"); return; }
        int64 cols = BPR * 256L;
        int64[] rows = [70L, 13L, 40L];
        int8[] ra #= WaveGeometryTest.rowsOf("q4_k.bin", Quant.GG_Q4_K, rows[0], BPR);
        int8[] rb #= WaveGeometryTest.rowsOf("q4_k.bin", Quant.GG_Q4_K, rows[1], BPR);
        int8[] rc #= WaveGeometryTest.rowsOf("q4_k.bin", Quant.GG_Q4_K, rows[2], BPR);
        float32[] x #= QuantKernelTest.activationsVaried(cols);
        int64[] vc #= ValueCheck.mark();
        float32[] ya #= heap float32[rows[0]];
        float32[] yb #= heap float32[rows[1]];
        float32[] yc #= heap float32[rows[2]];
        if (width == 16) { QuantKernel.q4kQ8X16Vec3IntoDevice(ra, rows[0], rb, rows[1], rc, rows[2], cols, x, ya, yb, yc); }
        else { QuantKernel.q4kQ8X8Vec3IntoDevice(ra, rows[0], rb, rows[1], rc, rows[2], cols, x, ya, yb, yc); }
        ValueCheck.credit(vc);
        int32 m = 0;
        while (m < 3) {
            float32[] want #= heap float32[rows[m]];
            int8[] raw = m == 0 ? ra : m == 1 ? rb : rc;
            float32[] got = m == 0 ? ya : m == 1 ? yb : yc;
            if (width == 16) { QuantKernel.q4kQ8X16IntoDevice(raw, rows[m], cols, x, 1L, want, false); }
            else { QuantKernel.q4kQ8X8IntoDevice(raw, rows[m], cols, x, 1L, want, false); }
            QuantKernelTest.assertLive(want, "weight " + m);
            int64 r = 0;
            while (r < rows[m]) {
                if (got[r] != want[r]) {
                    Assert.fail("weight " + m + " row " + r + ": fused " + got[r] + " vs its own launch " + want[r]);
                }
                r = r + 1;
            }
            m = m + 1;
        }
    }
}
