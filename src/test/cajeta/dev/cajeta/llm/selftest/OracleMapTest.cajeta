package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.bench.OracleMap;

/**
 * xpu-kernel-adaptor plan 8.2.1 and 8.3.2: every shipped kernel is mapped
 * to its llama.cpp counterpart op, or named as having none, in
 * `census/oracle-map.tsv`. The set judged by roofline fraction alone is
 * the explicit NONE rows, never a missing row.
 *
 * Runs against the kernels registered on the ACTIVE backend, so on cpu it
 * checks the 212 that lower there and on cuda all 265; a kernel this
 * backend does not register is not this backend's business.
 */
public class OracleMapTest {

    public OracleMapTest() { return; }

    static final String PATH = "census/oracle-map.tsv";

    @Test
    public void everyShippedKernelOnThisBackendHasAnOracleRow() {
        OracleMap map #= OracleMap.load(OracleMapTest.PATH);
        Assert.isTrue(map.count() > 0);
        int32 n = Device.registeredKernelCount();
        int32 shipped = 0;
        int32 missing = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            if (KernelCensus.probe(name) || KernelCensus.external(name)) {
                i = i + 1;
                continue;
            }
            shipped = shipped + 1;
            if (!map.has(name)) {
                missing = missing + 1;
                System.stdout.println("  ORACLE-MAP missing: " + name);
            }
            i = i + 1;
        }
        System.stdout.println("  oracle map: " + map.count() + " rows, "
            + shipped + " shipped kernels on " + Device.activeBackend()
            + ", " + missing + " unmapped");
        Assert.isTrue(shipped > 0);
        Assert.isTrue(missing == 0);
    }

    @Test
    public void everyRowNamesACounterpartOrNoneWithAReason() {
        OracleMap map #= OracleMap.load(OracleMapTest.PATH);
        int32 none = 0;
        int32 i = 0;
        while (i < map.count()) {
            String kernel #= map.kernelAt(i);
            String counterpart #= map.counterpartAt(i);
            String family #= map.familyAt(i);
            Assert.isTrue(kernel.count() > 0L);
            Assert.isTrue(family.count() > 0L);
            Assert.isTrue(counterpart.count() > 0L);
            if (counterpart.equals("NONE")) {
                none = none + 1;
                // 8.3.2: a kernel judged by roofline alone says why it has
                // no counterpart, so the set is explicit, never inferred.
                Assert.isTrue(map.noteAt(i).count() > 0L);
            } else {
                // A counterpart names the llama.cpp CUDA source file and the
                // kernel or op in it: `mmvq.cu:mul_mat_vec_q`.
                Assert.isTrue(counterpart.contains(".cu:")
                    || counterpart.contains(".cpp:"));
            }
            i = i + 1;
        }
        // The NONE set is enumerable from the map alone.
        Assert.isTrue(map.noneCount() == none);
        Assert.isTrue(none > 0);
    }

    @Test
    public void aDuplicateOrMalformedRowIsRefused() {
        String dup #= "kernel\tfamily\tcounterpart\tshape\tnote\n"
            + "aKernel\twave\tmmvq.cu:mul_mat_vec_q\t4096x4096\t\n"
            + "aKernel\twave\tmmvq.cu:mul_mat_vec_q\t4096x4096\t\n";
        Assert.isTrue(OracleMap.parse(dup) == null);
        String shortRow #= "kernel\tfamily\tcounterpart\tshape\tnote\n"
            + "aKernel\twave\n";
        Assert.isTrue(OracleMap.parse(shortRow) == null);
        String ok #= "kernel\tfamily\tcounterpart\tshape\tnote\n"
            + "aKernel\twave\tmmvq.cu:mul_mat_vec_q\t4096x4096\t\n"
            + "bKernel\tutility\tNONE\t-\tfused epilogue, no ggml op\n";
        OracleMap m #= OracleMap.parse(ok);
        Assert.isTrue(m != null);
        Assert.isTrue(m.count() == 2);
        Assert.isTrue(m.has("aKernel"));
        Assert.isTrue(m.has("bKernel"));
        Assert.isFalse(m.has("cKernel"));
        Assert.isTrue(m.noneCount() == 1);
        Assert.equals("fused epilogue, no ggml op", m.noteAt(1));
    }
}
