package dev.cajeta.llm.selftest;

import cajeta.lang.Math;
import cajeta.lang.String;
import dev.cajeta.unit.AfterEach;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.bench.Metrics;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** cajeta-llm plan 15.2.21.5: gemma3 GGUF (tools/gguf/gen_gemma3_fixture.py) loads to the safetensors toy's answer. */
public class GemmaGgufTest {

    static final String FIX = "src/test/fixtures/gguf/toy-gemma3.gguf";
    static final String KEYS27B = "src/test/fixtures/gguf/toy-gemma3-27b.gguf";

    public GemmaGgufTest() { return; }

    @AfterEach
    public void restore() {
        Diag.register(null);
        QuantKernel.setRoutingEnabled(true);
        return;
    }

    static #ModelConfig cfgOf(String path) {
        Checkpoint ck #= Checkpoint.open(path);
        ModelConfig c #= ModelConfig.fromGguf(ck.gguf());
        ck.close();
        return #c;
    }

    static #CausalLM mkGguf() {
        Checkpoint ck #= Checkpoint.open(GemmaGgufTest.FIX);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();
        return #m;
    }

    @Test
    public void the27bKeysResolveAsLlamaCppReadsThem() {
        ModelConfig c #= GemmaGgufTest.cfgOf(GemmaGgufTest.KEYS27B);
        Assert.isTrue(c.architecture.equals("Gemma3ForCausalLM"));
        Assert.isTrue(c.fourNorm);
        Assert.isTrue(c.qkNorm);
        Assert.equals(0, c.normForm);
        Assert.equals(1, c.activation);
        Assert.equals(128, c.headDim);
        Assert.equals(262208, c.vocabSize);
        Assert.isTrue(Math.abs(c.queryScale - 1.0f / Math.sqrt(168.0f)) < 1.0e-7f);
        Assert.isTrue(Math.abs(c.embedScale - Math.sqrt(5376.0f)) < 1.0e-3f);
        Assert.isTrue(c.ropeTheta == 1000000.0f);
        Assert.isTrue(c.ropeLocalTheta == 10000.0f);
        Assert.equals(1, c.ropeScalingType);
        Assert.isTrue(c.ropeScalingFactor == 8.0f);
        Assert.equals(1024, c.windowForLayer(0));
        Assert.equals(1024, c.windowForLayer(4));
        Assert.equals(0, c.windowForLayer(5));
        Assert.equals(1024, c.windowForLayer(6));
        Assert.equals(0, c.windowForLayer(11));
        Assert.equals(1024, c.windowForLayer(61));
    }

    @Test
    public void theToyGgufConfigMatchesTheHfToyButForTheBakedNormShift() {
        FourNormDeviceTest.writeFixtures();
        ModelConfig g #= GemmaGgufTest.cfgOf(GemmaGgufTest.FIX);
        ModelConfig h #= ModelConfig.parse(FourNormDeviceTest.DIR + "/gemma.json");
        Assert.equals(h.hiddenSize, g.hiddenSize);
        Assert.equals(h.numHeads, g.numHeads);
        Assert.equals(h.numKvHeads, g.numKvHeads);
        Assert.equals(h.headDim, g.headDim);
        Assert.equals(h.vocabSize, g.vocabSize);
        Assert.isTrue(h.queryScale == g.queryScale);
        Assert.isTrue(h.embedScale == g.embedScale);
        Assert.isTrue(h.ropeTheta == g.ropeTheta);
        Assert.isTrue(h.ropeLocalTheta == g.ropeLocalTheta);
        Assert.isTrue(g.tieWordEmbeddings);
        Assert.equals(0, g.windowForLayer(0));
        Assert.equals(0, g.windowForLayer(1));
        Assert.equals(1, h.normForm);
        Assert.equals(0, g.normForm);
    }

    @Test
    public void theToyGgufAnswersAsTheSafetensorsToyOnTheHostPath() {
        int32 v = FourNormDeviceTest.V;
        QuantKernel.setRoutingEnabled(false);
        CausalLM st #= FourNormDeviceTest.mk(true, true);
        int32[] ts = heap int32[7];
        float32[] ps = heap float32[v];
        float32[] ls = heap float32[v];
        FourNormDeviceTest.gen(st, ts, ps, ls);
        CausalLM gg #= GemmaGgufTest.mkGguf();
        int32[] tg = heap int32[7];
        float32[] pg = heap float32[v];
        float32[] lg = heap float32[v];
        FourNormDeviceTest.gen(gg, tg, pg, lg);
        QuantKernel.setRoutingEnabled(true);
        float64 cos = Metrics.cosine(ps, pg, v);
        float64 kl = Metrics.softmaxKl(ps, pg, v);
        System.stdout.println("  15.2.21.5 gguf vs safetensors (host): prefill cosine " + cos + " kl " + kl);
        Assert.isTrue(cos >= 0.999999);
        Assert.isTrue(kl <= 1.0e-9);
        int32 t = 0;
        while (t < 7) {
            Assert.equals((int64) ts[t], (int64) tg[t]);
            t = t + 1;
        }
    }

    @Test
    public void theToyGgufPrefillsBatchedAndDecodesResidentToItsHostAnswer() {
        if (!FourNormDeviceTest.deviceHere()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 v = FourNormDeviceTest.V;
        CausalLM dev #= GemmaGgufTest.mkGguf();
        Assert.isTrue(dev.batchRoutedFor(8));
        Assert.isTrue(dev.deviceRoutable());
        int64[] vc #= ValueCheck.mark();
        int32[] td = heap int32[7];
        float32[] pd = heap float32[v];
        float32[] ld = heap float32[v];
        FourNormDeviceTest.gen(dev, td, pd, ld);
        QuantKernel.setRoutingEnabled(false);
        CausalLM host #= GemmaGgufTest.mkGguf();
        int32[] th = heap int32[7];
        float32[] ph = heap float32[v];
        float32[] lh = heap float32[v];
        FourNormDeviceTest.gen(host, th, ph, lh);
        QuantKernel.setRoutingEnabled(true);
        float64 klP = Metrics.softmaxKl(ph, pd, v);
        float64 klD = Metrics.softmaxKl(lh, ld, v);
        System.stdout.println("  15.2.21.5 gguf device vs host: prefill kl " + klP + " decode kl " + klD);
        Assert.isTrue(klP <= 1.0e-6);
        Assert.isTrue(klD <= 1.0e-6);
        int32 t = 0;
        while (t < 7) {
            Assert.equals((int64) th[t], (int64) td[t]);
            t = t + 1;
        }
        ValueCheck.credit(vc);
    }
}
