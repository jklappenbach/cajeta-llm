package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.Prim;

/**
 * 6.4.3 cause 3 — the codebook banks' indirected mat-vec against the
 * per-expert wave launches it replaces.
 *
 * The two decompositions run an identical per-row dot loop over the same
 * slab bytes and the same staged activation, so the outputs must be
 * BIT-identical — `==`, not a tolerance. Without these kernels a decode
 * step dispatched one launch per selected expert per projection, 384 a
 * token on the Qwen1.5-MoE against llama.cpp's ~72.
 */
public class MoeCodebookIdMatVecTest {

    public MoeCodebookIdMatVecTest() { return; }

    @Test
    public void iq3xxsIdMatVecMatchesThePerExpertWaveLaunches() {
        MoeCodebookIdMatVecTest.check(Quant.GG_IQ3_XXS, "iq3_xxs.bin");
    }

    @Test
    public void iq4nlIdMatVecMatchesThePerExpertWaveLaunches() {
        MoeCodebookIdMatVecTest.check(Quant.GG_IQ4_NL, "iq4_nl.bin");
    }

    @Test
    public void iq3xxsWaveLaunchAddsItsBias() {
        MoeCodebookIdMatVecTest.checkBias(Quant.GG_IQ3_XXS, "iq3_xxs.bin");
    }

    @Test
    public void iq4nlWaveLaunchAddsItsBias() {
        MoeCodebookIdMatVecTest.checkBias(Quant.GG_IQ4_NL, "iq4_nl.bin");
    }

    @Test
    public void iq3xxsQkvLaunchMatchesThreeBiasedLaunches() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ3_XXS;
        int64 rq = 128L;
        int64 rkv = 32L;
        int64 cols = 2048L;
        int64 resRow = Quant.rowResidentBytes(ty, cols / 256L);
        KernelBuffer<int8> wq #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 1L, rq, cols);
        KernelBuffer<int8> wk2 #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 2L, rkv, cols);
        KernelBuffer<int8> wk #= wk2.slice((uint64) (rkv * resRow),
            (uint64) (rkv * resRow));
        KernelBuffer<int8> wv3 #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 3L, rkv, cols);
        KernelBuffer<int8> wv #= wv3.slice((uint64) (2L * rkv * resRow),
            (uint64) (rkv * resRow));
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        float32[] bqh #= heap float32[rq];
        float32[] bkh #= heap float32[rkv];
        float32[] bvh #= heap float32[rkv];
        j = 0;
        while (j < rq) { bqh[j] = (float32) ((j % 7L) - 3L) * 0.5f; j = j + 1; }
        j = 0;
        while (j < rkv) {
            bkh[j] = (float32) ((j % 5L) - 2L) * 0.25f;
            bvh[j] = (float32) ((j % 3L) - 1L) * 0.75f;
            j = j + 1;
        }
        KernelBuffer<float32> bq #= heap KernelBuffer<float32>((uint64) rq);
        KernelBuffer<float32> bk #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> bv #= heap KernelBuffer<float32>((uint64) rkv);
        bq.upload(bqh, rq);
        bk.upload(bkh, rkv);
        bv.upload(bvh, rkv);
        KernelBuffer<float32> q1 #= heap KernelBuffer<float32>((uint64) rq);
        KernelBuffer<float32> k1 #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> v1 #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> q2 #= heap KernelBuffer<float32>((uint64) rq);
        KernelBuffer<float32> k2 #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> v2 #= heap KernelBuffer<float32>((uint64) rkv);
        QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(ty, q1, wq, xp, rq, cols, 0L, bq);
        QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(ty, k1, wk, xp, rkv, cols, 0L, bk);
        QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(ty, v1, wv, xp, rkv, cols, 0L, bv);
        QuantKernel.iq3xxsQkvWaveMatVecLaunchNoSync(q2, k2, v2, wq, wk, wv, xp,
            rq, rkv, cols, bq, bk, bv);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[rq];
        float32[] b #= heap float32[rq];
        int64 diff = 0L;
        boolean nz = false;
        q1.download(a, rq);
        q2.download(b, rq);
        int64 i = 0;
        while (i < rq) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        k1.download(a, rkv);
        k2.download(b, rkv);
        i = 0;
        while (i < rkv) { if (a[i] != b[i]) { diff = diff + 1L; } i = i + 1; }
        v1.download(a, rkv);
        v2.download(b, rkv);
        i = 0;
        while (i < rkv) { if (a[i] != b[i]) { diff = diff + 1L; } i = i + 1; }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
    }

    @Test
    public void iq3xxsGateUpGluPackMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ3_XXS;
        int64 E = 6L;
        int64 rows = 1408L;
        int64 rowsPad = 1536L;
        int64 nbRow = rowsPad / 256L;
        int64 cols = 2048L;
        int32 used = 3;
        int64 resRow = Quant.rowResidentBytes(ty, cols / 256L);
        KernelBuffer<int8> slabG #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", E, rows, cols);
        KernelBuffer<int8> slabU7 #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", E + 1L, rows, cols);
        KernelBuffer<int8> slabU #= slabU7.slice((uint64) (rows * resRow),
            (uint64) (E * rows * resRow));
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        int32[] ids #= heap int32[used];
        ids[0] = 4; ids[1] = 0; ids[2] = 3;
        KernelBuffer<int32> sel #= heap KernelBuffer<int32>((uint64) used);
        sel.upload(ids, (int64) used);
        int64 n = (int64) used * rows;
        int64 pb = (int64) used * nbRow * 320L;
        KernelBuffer<int32> counters #= heap KernelBuffer<int32>(
            (uint64) ((int64) used * nbRow));
        int32[] zc #= heap int32[(int64) used * nbRow];
        counters.upload(zc, (int64) used * nbRow);
        KernelStream s = QuantKernel.stream();
        int32 pass = 0;
        while (pass < 2) {
            KernelBuffer<float32> fy1 #= heap KernelBuffer<float32>((uint64) n);
            KernelBuffer<float32> fy2 #= heap KernelBuffer<float32>((uint64) n);
            KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
            KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
            int8[] zp #= heap int8[pb];
            p1.upload(zp, pb);
            p2.upload(zp, pb);
            QuantKernel.iq3xxsIdGateUpGluLaunchNoSync(fy1, slabG, slabU, xp,
                sel, used, rows, cols, 0);
            QuantKernel.q8kPackRowsLaunchNoSync(p1, fy1, (int64) used, rows,
                rowsPad);
            QuantKernel.iq3xxsIdGateUpGluPackLaunchNoSync(fy2, slabG, slabU,
                xp, sel, used, rows, cols, 0, p2, counters, nbRow);
            s.sync();
            float32[] a #= heap float32[n];
            float32[] b #= heap float32[n];
            fy1.download(a, n);
            fy2.download(b, n);
            j = 0;
            while (j < n) {
                if (a[j] != b[j]) {
                    Assert.fail("glu " + j + ": " + a[j] + " vs " + b[j]);
                }
                j = j + 1;
            }
            int8[] b1 #= heap int8[pb];
            int8[] b2 #= heap int8[pb];
            p1.download(b1, pb);
            p2.download(b2, pb);
            j = 0;
            while (j < pb) {
                if (b1[j] != b2[j]) {
                    Assert.fail("packed byte " + j + ": " + (int32) b1[j]
                        + " vs " + (int32) b2[j]);
                }
                j = j + 1;
            }
            pass = pass + 1;
        }
        int32[] cnt #= heap int32[(int64) used * nbRow];
        counters.download(cnt, (int64) used * nbRow);
        j = 0;
        while (j < (int64) used * nbRow) {
            Assert.equals(0L, (int64) cnt[j]);
            j = j + 1;
        }
    }

    @Test
    public void iq3xxsWaveGateUpGluPackGateMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ3_XXS;
        int64 rows = 512L;
        int64 cols = 2048L;
        int64 nb = rows / 256L;
        int64 resRow = Quant.rowResidentBytes(ty, cols / 256L);
        KernelBuffer<int8> slabG #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 1L, rows, cols);
        KernelBuffer<int8> slabU2 #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 2L, rows, cols);
        KernelBuffer<int8> slabU #= slabU2.slice((uint64) (rows * resRow),
            (uint64) (rows * resRow));
        float32[] xv #= heap float32[cols];
        float32[] gwv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            gwv[j] = (float32) ((j % 13L) - 6L) / 32.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<float32> gw #= heap KernelBuffer<float32>((uint64) cols);
        gw.upload(gwv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        int64 pb = nb * 320L;
        KernelBuffer<int32> counters #= heap KernelBuffer<int32>((uint64) nb);
        int32[] zc #= heap int32[nb];
        counters.upload(zc, nb);
        KernelStream s = QuantKernel.stream();
        int32 pass = 0;
        while (pass < 2) {
            KernelBuffer<float32> fy1 #= heap KernelBuffer<float32>((uint64) rows);
            KernelBuffer<float32> fy2 #= heap KernelBuffer<float32>((uint64) rows);
            KernelBuffer<float32> z1 #= heap KernelBuffer<float32>((uint64) 1);
            KernelBuffer<float32> z2 #= heap KernelBuffer<float32>((uint64) 1);
            KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
            KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
            int8[] zp #= heap int8[pb];
            p1.upload(zp, pb);
            p2.upload(zp, pb);
            QuantKernel.iq3xxsWaveGateUpGluLaunchNoSync(fy1, slabG, slabU, xp,
                rows, cols, 0);
            QuantKernel.q8kPackLaunchNoSync(p1, fy1, rows);
            QuantKernel.routerF32MatVecLaunchNoSync(z1, gw, xf, 1L, cols);
            QuantKernel.iq3xxsWaveGateUpGluPackGateLaunchNoSync(fy2, slabG,
                slabU, xp, rows, cols, 0, p2, counters, z2, gw, xf);
            s.sync();
            float32[] a #= heap float32[rows];
            float32[] b #= heap float32[rows];
            fy1.download(a, rows);
            fy2.download(b, rows);
            j = 0;
            while (j < rows) {
                if (a[j] != b[j]) {
                    Assert.fail("glu " + j + ": " + a[j] + " vs " + b[j]);
                }
                j = j + 1;
            }
            float32[] za #= heap float32[1];
            float32[] zb #= heap float32[1];
            z1.download(za, 1L);
            z2.download(zb, 1L);
            if (za[0] != zb[0]) {
                Assert.fail("gate logit " + za[0] + " vs " + zb[0]);
            }
            Assert.isTrue(za[0] != 0.0f);
            int8[] b1 #= heap int8[pb];
            int8[] b2 #= heap int8[pb];
            p1.download(b1, pb);
            p2.download(b2, pb);
            j = 0;
            while (j < pb) {
                if (b1[j] != b2[j]) {
                    Assert.fail("packed byte " + j + ": " + (int32) b1[j]
                        + " vs " + (int32) b2[j]);
                }
                j = j + 1;
            }
            pass = pass + 1;
        }
        int32[] cnt #= heap int32[nb];
        counters.download(cnt, nb);
        j = 0;
        while (j < nb) {
            Assert.equals(0L, (int64) cnt[j]);
            j = j + 1;
        }
    }

    @Test
    public void iq3xxsWaveGateUpGluMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ3_XXS;
        int64 rows = 64L;
        int64 cols = 2048L;
        int64 resRow = Quant.rowResidentBytes(ty, cols / 256L);
        KernelBuffer<int8> slabG #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 1L, rows, cols);
        KernelBuffer<int8> slabU2 #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_xxs.bin", 2L, rows, cols);
        KernelBuffer<int8> slabU #= slabU2.slice((uint64) (rows * resRow),
            (uint64) (rows * resRow));
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<float32> gy #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> uy #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> fy #= heap KernelBuffer<float32>((uint64) rows);
        QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, gy, slabG, xp, rows, cols, 0L);
        QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, uy, slabU, xp, rows, cols, 0L);
        Prim.gluDevice(gy, uy, rows, 0);
        QuantKernel.iq3xxsWaveGateUpGluLaunchNoSync(fy, slabG, slabU, xp, rows,
            cols, 0);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[rows];
        float32[] b #= heap float32[rows];
        gy.download(a, rows);
        fy.download(b, rows);
        int64 diff = 0L;
        boolean nz = false;
        int64 i = 0;
        while (i < rows) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
    }

    @Test
    public void iq2sIq3xxsQkvLaunchMatchesThreeBiasedLaunches() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int64 rq = 127L;
        int64 rkv = 33L;
        int64 cols = 2048L;
        int64 res2 = Quant.rowResidentBytes(Quant.GG_IQ2_S, cols / 256L);
        KernelBuffer<int8> wq #= MoeCodebookIdMatVecTest.slabOf(Quant.GG_IQ2_S,
            "iq2_s.bin", 1L, rq, cols);
        KernelBuffer<int8> wk2 #= MoeCodebookIdMatVecTest.slabOf(Quant.GG_IQ2_S,
            "iq2_s.bin", 2L, rkv, cols);
        KernelBuffer<int8> wk #= wk2.slice((uint64) (rkv * res2),
            (uint64) (rkv * res2));
        KernelBuffer<int8> wv #= MoeCodebookIdMatVecTest.slabOf(Quant.GG_IQ3_XXS,
            "iq3_xxs.bin", 1L, rkv, cols);
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        float32[] bqh #= heap float32[rq];
        float32[] bkh #= heap float32[rkv];
        float32[] bvh #= heap float32[rkv];
        j = 0;
        while (j < rq) { bqh[j] = (float32) ((j % 7L) - 3L) * 0.5f; j = j + 1; }
        j = 0;
        while (j < rkv) {
            bkh[j] = (float32) ((j % 5L) - 2L) * 0.25f;
            bvh[j] = (float32) ((j % 3L) - 1L) * 0.75f;
            j = j + 1;
        }
        KernelBuffer<float32> bq #= heap KernelBuffer<float32>((uint64) rq);
        KernelBuffer<float32> bk #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> bv #= heap KernelBuffer<float32>((uint64) rkv);
        bq.upload(bqh, rq);
        bk.upload(bkh, rkv);
        bv.upload(bvh, rkv);
        KernelBuffer<float32> q1 #= heap KernelBuffer<float32>((uint64) rq);
        KernelBuffer<float32> k1 #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> v1 #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> q2 #= heap KernelBuffer<float32>((uint64) rq);
        KernelBuffer<float32> k2 #= heap KernelBuffer<float32>((uint64) rkv);
        KernelBuffer<float32> v2 #= heap KernelBuffer<float32>((uint64) rkv);
        QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(Quant.GG_IQ2_S, q1, wq, xp,
            rq, cols, 0L, bq);
        QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(Quant.GG_IQ2_S, k1, wk, xp,
            rkv, cols, 0L, bk);
        QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(Quant.GG_IQ3_XXS, v1, wv, xp,
            rkv, cols, 0L, bv);
        QuantKernel.iq2sIq3xxsQkvWaveMatVecLaunchNoSync(q2, k2, v2, wq, wk, wv,
            xp, rq, rkv, cols, bq, bk, bv);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[rq];
        float32[] b #= heap float32[rq];
        int64 diff = 0L;
        boolean nz = false;
        q1.download(a, rq);
        q2.download(b, rq);
        int64 i = 0;
        while (i < rq) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        k1.download(a, rkv);
        k2.download(b, rkv);
        i = 0;
        while (i < rkv) { if (a[i] != b[i]) { diff = diff + 1L; } i = i + 1; }
        v1.download(a, rkv);
        v2.download(b, rkv);
        i = 0;
        while (i < rkv) { if (a[i] != b[i]) { diff = diff + 1L; } i = i + 1; }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
    }

    @Test
    public void iq2sWaveGateUpGluMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ2_S;
        int64 rows = 63L;
        int64 cols = 2048L;
        int64 resRow = Quant.rowResidentBytes(ty, cols / 256L);
        KernelBuffer<int8> slabG #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq2_s.bin", 1L, rows, cols);
        KernelBuffer<int8> slabU2 #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq2_s.bin", 2L, rows, cols);
        KernelBuffer<int8> slabU #= slabU2.slice((uint64) (rows * resRow),
            (uint64) (rows * resRow));
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        KernelBuffer<float32> gy #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> uy #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> fy #= heap KernelBuffer<float32>((uint64) rows);
        QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, gy, slabG, xp, rows, cols, 0L);
        QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, uy, slabU, xp, rows, cols, 0L);
        Prim.gluDevice(gy, uy, rows, 0);
        QuantKernel.iq2sWaveGateUpGluLaunchNoSync(fy, slabG, slabU, xp, rows,
            cols, 0);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[rows];
        float32[] b #= heap float32[rows];
        gy.download(a, rows);
        fy.download(b, rows);
        int64 diff = 0L;
        boolean nz = false;
        int64 i = 0;
        while (i < rows) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
    }

    @Test
    public void iq3sWaveAccumGatedMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ3_S;
        int64 rows = 64L;
        int64 cols = 2048L;
        KernelBuffer<int8> slab #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq3_s.bin", 1L, rows, cols);
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        float32[] seed #= heap float32[rows];
        j = 0;
        while (j < rows) {
            seed[j] = (float32) (j % 7L) * 0.5f - 1.0f;
            j = j + 1;
        }
        float32[] zv #= heap float32[1];
        zv[0] = 0.37f;
        KernelBuffer<float32> z #= heap KernelBuffer<float32>((uint64) 1);
        z.upload(zv, 1L);
        KernelBuffer<float32> dn #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> acc1 #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> acc2 #= heap KernelBuffer<float32>((uint64) rows);
        acc1.upload(seed, rows);
        acc2.upload(seed, rows);
        QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, dn, slab, xp, rows, cols, 0L);
        Prim.addSigmoidRowsDevice(acc1, dn, z, 1L, rows, true);
        QuantKernel.iqQ8WaveMatVecAccumGatedLaunchNoSync(ty, acc2, slab, xp,
            rows, cols, 0L, z);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[rows];
        float32[] b #= heap float32[rows];
        acc1.download(a, rows);
        acc2.download(b, rows);
        int64 diff = 0L;
        boolean moved = false;
        int64 i = 0;
        while (i < rows) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != seed[i]) { moved = true; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        Assert.isTrue(moved);
    }

    @Test
    public void iq3xxsGateUpGluMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
