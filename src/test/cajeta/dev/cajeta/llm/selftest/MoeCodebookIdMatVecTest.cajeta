        QuantKernel.iq3xxsIdGateUpGluLaunchNoSync(fy, slabG, slabU, xp, sel,
            used, rows, cols, 0);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[n];
        float32[] b #= heap float32[n];
        gy.download(a, n);
        fy.download(b, n);
        int64 diff = 0L;
        boolean nz = false;
        int64 i = 0;
        while (i < n) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (a[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
    }

    @Test
    public void iq4nlDownCombineTailMatchesTheChain() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int32 ty = Quant.GG_IQ4_NL;
        int64 E = 6L;
        int64 rows = 256L;
        int64 cols = 1408L;
        int64 colsPad = 1536L;
        int64 xrb = colsPad / 256L;
        int32 used = 4;
        KernelBuffer<int8> slab #= MoeCodebookIdMatVecTest.slabOf(ty,
            "iq4_nl.bin", E, rows, cols);
        float32[] xv #= heap float32[(int64) used * cols];
        int64 j = 0;
        while (j < (int64) used * cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>(
            (uint64) ((int64) used * cols));
        xf.upload(xv, (int64) used * cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((int64) used * xrb * 320L));
        QuantKernel.q8kPackRowsLaunchNoSync(xp, xf, (int64) used, cols, colsPad);
        int32[] ids #= heap int32[used];
        ids[0] = 4; ids[1] = 0; ids[2] = 3; ids[3] = 5;
        float32[] ws #= heap float32[used];
        ws[0] = 0.4f; ws[1] = 0.3f; ws[2] = 0.2f; ws[3] = 0.1f;
        KernelBuffer<int32> sel #= heap KernelBuffer<int32>((uint64) used);
        KernelBuffer<float32> wSel #= heap KernelBuffer<float32>((uint64) used);
        sel.upload(ids, (int64) used);
        wSel.upload(ws, (int64) used);
        float32[] seed #= heap float32[rows];
        float32[] nwh #= heap float32[rows];
        j = 0;
        while (j < rows) {
            seed[j] = (float32) (j % 7L) * 0.5f - 1.0f;
            nwh[j] = 0.8f + (float32) (j % 3L) * 0.1f;
            j = j + 1;
        }
        KernelBuffer<float32> nw #= heap KernelBuffer<float32>((uint64) rows);
        nw.upload(nwh, rows);
        int64 pb = (rows / 256L) * 320L;
        KernelBuffer<int32> counter #= heap KernelBuffer<int32>((uint64) 4);
        int32[] z #= heap int32[4];
        counter.upload(z, 4L);
        KernelStream s = QuantKernel.stream();
        int32 pass = 0;
        while (pass < 2) {
            KernelBuffer<float32> hs1 #= heap KernelBuffer<float32>((uint64) rows);
            KernelBuffer<float32> hs2 #= heap KernelBuffer<float32>((uint64) rows);
            hs1.upload(seed, rows);
            hs2.upload(seed, rows);
            KernelBuffer<float32> dy #= heap KernelBuffer<float32>(
                (uint64) ((int64) used * rows));
            KernelBuffer<float32> o1 #= heap KernelBuffer<float32>((uint64) rows);
            KernelBuffer<float32> o2 #= heap KernelBuffer<float32>((uint64) rows);
            KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
            KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
            int8[] zp #= heap int8[pb];
            p1.upload(zp, pb);
            p2.upload(zp, pb);
            Assert.isTrue(QuantKernel.idMatVecLaunchNoSync(ty, dy, slab, xp,
                sel, used, rows, cols, xrb));
            QuantKernel.moeCombineAddLaunchNoSync(hs1, dy, wSel, (int64) used, rows);
            Assert.isTrue(Prim.rmsnormPackDevice(o1, p1, hs1, nw, rows,
                0.00001f, 1));
            Assert.isTrue(QuantKernel.idDownCombineTailLaunchNoSync(ty, hs2,
                slab, xp, sel, wSel, used, rows, cols, xrb, o2, p2, nw, rows,
                0.00001f, 1, counter));
            s.sync();
            float32[] a #= heap float32[rows];
            float32[] b #= heap float32[rows];
            hs1.download(a, rows);
            hs2.download(b, rows);
            boolean moved = false;
            j = 0;
            while (j < rows) {
                if (a[j] != b[j]) {
                    Assert.fail("hs " + j + ": chain " + a[j] + " fused " + b[j]);
                }
                if (a[j] != seed[j]) { moved = true; }
                j = j + 1;
            }
            Assert.isTrue(moved);
            o1.download(a, rows);
            o2.download(b, rows);
            j = 0;
            while (j < rows) {
                if (a[j] != b[j]) {
                    Assert.fail("normed " + j + ": " + a[j] + " vs tail " + b[j]);
                }
                j = j + 1;
            }
            int8[] b1 #= heap int8[pb];
            int8[] b2 #= heap int8[pb];
            p1.download(b1, pb);
            p2.download(b2, pb);
            j = 0;
            while (j < pb) {
                if (b1[j] != b2[j]) {
                    Assert.fail("packed byte " + j + ": " + (int32) b1[j]
                        + " vs tail " + (int32) b2[j]);
                }
                j = j + 1;
            }
            pass = pass + 1;
        }
        int32[] cnt #= heap int32[4];
        counter.download(cnt, 4L);
        Assert.equals(0L, (int64) cnt[0]);
    }

    /** The bias-in-epilogue launch against the plain launch followed by
     *  `addBiasRowsDevice`: the same f32 add, so exact. */
    static void checkBias(int32 ty, String fixture) {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int64 rows = 64L;
        int64 cols = 2048L;
        KernelBuffer<int8> slab #= MoeCodebookIdMatVecTest.slabOf(ty,
            fixture, 1L, rows, cols);
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);
        float32[] bv #= heap float32[rows];
        int64 r = 0;
        while (r < rows) {
            bv[r] = (float32) ((r % 7L) - 3L) * 0.5f;
            r = r + 1;
        }
        KernelBuffer<float32> bias #= heap KernelBuffer<float32>((uint64) rows);
        bias.upload(bv, rows);
        KernelBuffer<float32> yA #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yB #= heap KernelBuffer<float32>((uint64) rows);
        if (ty == Quant.GG_IQ4_NL) {
            QuantKernel.iq4nlQ8WaveMatVecLaunchNoSync(yA, slab, xp, rows, cols, 0L);
            QuantKernel.iq4nlQ8WaveMatVecBiasLaunchNoSync(yB, slab, xp, rows,
                cols, 0L, bias);
        } else {
            QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, yA, slab, xp, rows, cols, 0L);
            QuantKernel.iqQ8WaveMatVecBiasLaunchNoSync(ty, yB, slab, xp, rows,
                cols, 0L, bias);
        }
        Prim.addBiasRowsDevice(yA, bias, 1L, rows);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[rows];
        float32[] b #= heap float32[rows];
        yA.download(a, rows);
        yB.download(b, rows);
        int64 diff = 0L;
        boolean nz = false;
        int64 i = 0;
        while (i < rows) {
            if (a[i] != b[i]) { diff = diff + 1L; }
            if (b[i] != 0.0f) { nz = true; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        Assert.isTrue(nz);
    }

    /** A slab of `E` experts, each `rows` x `cols` in the resident
     *  layout, from file blocks tiled cyclically.
     *
     *  The per-expert offset is in whole BLOCKS. Rotating resident bytes
     *  instead shifts the f16 scale field onto payload bytes and
     *  manufactures NaN scales, which read as a kernel disagreement
     *  because NaN never equals itself. */
    static #KernelBuffer<int8> slabOf(int32 ty, String fixture, int64 E,
            int64 rows, int64 cols) {
        int8[] src #= File.readAllBytes(
            "src/test/fixtures/gguf/kquant/" + fixture);
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 srcBlocks = (int64) src.count() / bb;
        int64 bpr = cols / (int64) Quant.blockElems(ty);
        int64 resRow = Quant.rowResidentBytes(ty, bpr);
        int64 slabBytes = E * rows * resRow;
        int8[] slabH #= heap int8[slabBytes];
        int8[] raw #= heap int8[rows * bpr * bb];
        int8[] one #= heap int8[rows * resRow];
        int64 e = 0;
        while (e < E) {
            int64 b = 0;
            while (b < rows * bpr) {
                int64 sb = (b + e * 7L) % srcBlocks;
                int64 q = 0;
                while (q < bb) {
                    raw[b * bb + q] = src[sb * bb + q];
                    q = q + 1;
                }
                b = b + 1;
            }
            Quant.splitInto(ty, raw, 0L, rows, bpr, one, 0L);
            int64 j = 0;
            while (j < rows * resRow) {
                slabH[e * rows * resRow + j] = one[j];
                j = j + 1;
            }
            e = e + 1;
        }
        KernelBuffer<int8> slab #= heap KernelBuffer<int8>(
            (uint64) (slabBytes + 4L));
        slab.upload(slabH, slabBytes);
        return #slab;
    }

    static void check(int32 ty, String fixture) {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        if (!Linear.residentEnabled()) { return; }
        int64 E = 6L;
        int64 rows = 64L;
        int64 cols = 2048L;
        int32 used = 3;
        KernelBuffer<int8> slab #= MoeCodebookIdMatVecTest.slabOf(ty,
            fixture, E, rows, cols);
        float32[] xv #= heap float32[cols];
        int64 j = 0;
        while (j < cols) {
            xv[j] = (float32) ((j % 25L) - 12L) / 64.0f;
            j = j + 1;
        }
        KernelBuffer<float32> xf #= heap KernelBuffer<float32>((uint64) cols);
        xf.upload(xv, cols);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) ((cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, cols);

        int32[] ids #= heap int32[used];
        ids[0] = 4;
        ids[1] = 0;
        ids[2] = 3;
        KernelBuffer<int32> sel #= heap KernelBuffer<int32>((uint64) used);
        sel.upload(ids, (int64) used);
        int64 n = (int64) used * rows;
        KernelBuffer<float32> yId #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> yWv #= heap KernelBuffer<float32>((uint64) n);

        boolean ok = QuantKernel.idMatVecLaunchNoSync(ty, yId, slab, xp,
            sel, used, rows, cols, 0L);
        if (!ok) {
            Assert.fail("ty=" + ty + ": no id mat-vec kernel");
        }
        int64 resRow = Quant.rowResidentBytes(ty,
            cols / (int64) Quant.blockElems(ty));
        int32 k = 0;
        while (k < used) {
            KernelBuffer<int8> ex #= slab.slice(
                (uint64) ((int64) ids[k] * rows * resRow),
                (uint64) (rows * resRow));
            if (ty == Quant.GG_IQ4_NL) {
                QuantKernel.iq4nlQ8WaveMatVecLaunchNoSync(yWv, ex, xp,
                    rows, cols, (int64) k * rows);
            } else {
                QuantKernel.iqQ8WaveMatVecLaunchNoSync(ty, yWv, ex, xp,
                    rows, cols, (int64) k * rows);
            }
            k = k + 1;
        }
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a #= heap float32[n];
        float32[] b #= heap float32[n];
        yId.download(a, n);
        yWv.download(b, n);
        int64 diff = 0L;
        int64 nan = 0L;
        boolean nz = false;
        int64 i = 0;
        while (i < n) {
            if (a[i] != b[i]) {
                if (diff < 4L) {
                    System.stdout.println("   ty=" + ty + " row " + i
                        + ": id " + a[i] + " wave " + b[i]);
                }
                diff = diff + 1L;
            }
            if (a[i] != 0.0f && a[i] == a[i]) { nz = true; }
            if (a[i] != a[i]) { nan = nan + 1L; }
            i = i + 1;
        }
        Assert.equals(0L, diff);
        // A NaN output compares unequal to itself, so it would read as a
        // kernel disagreement AND satisfy a bare non-zero check.
        Assert.equals(0L, nan);
        Assert.isTrue(nz);
        System.stdout.println("   ty=" + ty + " id == wave over " + n
            + " rows");
        return;
    }
}
