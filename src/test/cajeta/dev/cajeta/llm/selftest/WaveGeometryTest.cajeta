package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Device;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The geometry gate for the wave mat-vec family (xpu-kernel-adaptor Unit
 * 9, wave-row-geometry Unit 2). Sixty-four rows, no two alike, so a
 * kernel that reads a neighbouring row's bytes answers a different
 * number, and eight blocks per row for the K-quants (the fused kernels'
 * floor), sixty-four for Q8_0.
 *
 * 9.1.1: at wave 32 and one row per workgroup the output is bit-identical
 * to the output recorded before the conversion (`WaveGolden`).
 */
public class WaveGeometryTest {

    static final String DIR = "src/test/fixtures/gguf/kquant/";
    static final int64 ROWS = 64L;
    static final int64 COLS = 2048L;

    public WaveGeometryTest() { return; }

    /** `rows` rows of `blocksPerRow` blocks, cycled from the fixture with a
     *  rotation so no two rows are alike. */
    static #int8[] rowsOf(String fixture, int32 ty, int64 rows, int64 blocksPerRow) {
        int8[] fix #= File.readAllBytes(WaveGeometryTest.DIR + fixture);
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 fixBlocks = (int64) fix.count() / bb;
        Assert.isTrue(fixBlocks > 0L);
        int64 nBlocks = rows * blocksPerRow;
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = ((b * 7L + 3L) % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        return #raw;
    }

    static void run(int32 ty, int8[] raw, float32[] x, float32[] out,
            int64 rows, int64 cols) {
        if (ty == Quant.GG_Q2_K) {
            QuantKernel.q2kQ8WaveMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else if (ty == Quant.GG_Q3_K) {
            QuantKernel.q3kQ8WaveMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else if (ty == Quant.GG_Q4_K) {
            QuantKernel.q4kQ8WaveMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else if (ty == Quant.GG_Q5_K) {
            QuantKernel.q5kQ8WaveMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else if (ty == Quant.GG_Q6_K) {
            QuantKernel.q6kQ8WaveMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        } else {
            QuantKernel.q80Q8WaveMatVecIntoDevice(raw, rows, cols, x, 0L, out, 0L);
        }
    }

    static void golden(String kernel, int32 ty, String fixture) {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        int64 rows = WaveGeometryTest.ROWS;
        int64 cols = WaveGeometryTest.COLS;
        int64 bpr = cols / (int64) Quant.blockElems(ty);
        int8[] raw #= WaveGeometryTest.rowsOf(fixture, ty, rows, bpr);
        float32[] x #= QuantKernelTest.activations(cols);
        float32[] got #= heap float32[rows];
        int64[] vc #= ValueCheck.mark();
        QuantKernel.setWaveRowsPerBlock(1);
        WaveGeometryTest.run(ty, raw, x, got, rows, cols);
        QuantKernel.setWaveRowsPerBlock(0);
        QuantKernelTest.assertLive(got, kernel + " at one row per workgroup");
        if (WaveGolden.check(kernel, "r" + rows, got, rows)) {
            ValueCheck.credit(vc);
        }
    }

    @Test
    public void q2kOutputIsBitIdenticalToTheWave32Golden() {
        WaveGeometryTest.golden("q2kQ8WaveMatVecKernel", Quant.GG_Q2_K, "q2_k.bin");
    }

    @Test
    public void q3kOutputIsBitIdenticalToTheWave32Golden() {
        WaveGeometryTest.golden("q3kQ8WaveMatVecKernel", Quant.GG_Q3_K, "q3_k.bin");
    }

    @Test
    public void q4kOutputIsBitIdenticalToTheWave32Golden() {
        WaveGeometryTest.golden("q4kQ8WaveMatVecKernel", Quant.GG_Q4_K, "q4_k.bin");
    }

    @Test
    public void q5kOutputIsBitIdenticalToTheWave32Golden() {
        WaveGeometryTest.golden("q5kQ8WaveMatVecKernel", Quant.GG_Q5_K, "q5_k.bin");
    }

    @Test
    public void q6kOutputIsBitIdenticalToTheWave32Golden() {
        WaveGeometryTest.golden("q6kQ8WaveMatVecKernel", Quant.GG_Q6_K, "q6_k.bin");
    }

    @Test
    public void q80OutputIsBitIdenticalToTheWave32Golden() {
        WaveGeometryTest.golden("q80Q8WaveMatVecKernel", Quant.GG_Q8_0, "q8_0.bin");
    }

    /**
     * 9.1.2 (wave-row-geometry 2.1.2): rows per workgroup 2 and 4 are
     * bit-identical to 1. A row's arithmetic does not know how many waves
     * share its workgroup, so `==` on the bits, no tolerance.
     */
    static void rowsPerBlockInvariant(String kernel, int32 ty, String fixture) {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        int64 rows = WaveGeometryTest.ROWS;
        int64 cols = WaveGeometryTest.COLS;
        int64 bpr = cols / (int64) Quant.blockElems(ty);
        int8[] raw #= WaveGeometryTest.rowsOf(fixture, ty, rows, bpr);
        float32[] x #= QuantKernelTest.activations(cols);
        float32[] one #= heap float32[rows];
        float32[] two #= heap float32[rows];
        float32[] four #= heap float32[rows];
        QuantKernel.setWaveRowsPerBlock(1);
        WaveGeometryTest.run(ty, raw, x, one, rows, cols);
        QuantKernel.setWaveRowsPerBlock(2);
        WaveGeometryTest.run(ty, raw, x, two, rows, cols);
        QuantKernel.setWaveRowsPerBlock(4);
        WaveGeometryTest.run(ty, raw, x, four, rows, cols);
        QuantKernel.setWaveRowsPerBlock(0);
        QuantKernelTest.assertLive(one, kernel + " at one row per workgroup");
        int64 r = 0;
        while (r < rows) {
            if (Cajeta.f32ToBits(one[r]) != Cajeta.f32ToBits(two[r])) {
                Assert.fail(kernel + " row " + r + ": two rows per workgroup gives "
                    + two[r] + ", one gives " + one[r]);
            }
            if (Cajeta.f32ToBits(one[r]) != Cajeta.f32ToBits(four[r])) {
                Assert.fail(kernel + " row " + r + ": four rows per workgroup gives "
                    + four[r] + ", one gives " + one[r]);
            }
            r = r + 1;
        }
    }

    @Test
    public void q2kRowsPerWorkgroupTwoAndFourMatchOne() {
        WaveGeometryTest.rowsPerBlockInvariant("q2kQ8WaveMatVecKernel", Quant.GG_Q2_K, "q2_k.bin");
    }

    @Test
    public void q3kRowsPerWorkgroupTwoAndFourMatchOne() {
        WaveGeometryTest.rowsPerBlockInvariant("q3kQ8WaveMatVecKernel", Quant.GG_Q3_K, "q3_k.bin");
    }

    @Test
    public void q4kRowsPerWorkgroupTwoAndFourMatchOne() {
        WaveGeometryTest.rowsPerBlockInvariant("q4kQ8WaveMatVecKernel", Quant.GG_Q4_K, "q4_k.bin");
    }

    @Test
    public void q5kRowsPerWorkgroupTwoAndFourMatchOne() {
        WaveGeometryTest.rowsPerBlockInvariant("q5kQ8WaveMatVecKernel", Quant.GG_Q5_K, "q5_k.bin");
    }

    @Test
    public void q6kRowsPerWorkgroupTwoAndFourMatchOne() {
        WaveGeometryTest.rowsPerBlockInvariant("q6kQ8WaveMatVecKernel", Quant.GG_Q6_K, "q6_k.bin");
    }

    @Test
    public void q80RowsPerWorkgroupTwoAndFourMatchOne() {
        WaveGeometryTest.rowsPerBlockInvariant("q80Q8WaveMatVecKernel", Quant.GG_Q8_0, "q8_0.bin");
    }

    /**
     * 9.1.2: the converted launcher USED the derived geometry, asserted
     * through a counter rather than by reading the source: one launch, one
     * derivation through QuantKernel.waveGrid, one launch counted by the
     * runtime.
     */
    static void derives(String kernel, int32 ty, String fixture) {
        String be #= Device.activeBackend();
        if (!KernelCap.usable(kernel)) { DeviceSkip.noKernel(kernel, be); return; }
        int64 rows = 8L;
        int64 cols = WaveGeometryTest.COLS;
        int64 bpr = cols / (int64) Quant.blockElems(ty);
        int8[] raw #= WaveGeometryTest.rowsOf(fixture, ty, rows, bpr);
        float32[] x #= QuantKernelTest.activations(cols);
        float32[] out #= heap float32[rows];
        int64 derived = QuantKernel.waveGridDerivations();
        int64 launched = Device.kernelLaunchCount(kernel);
        WaveGeometryTest.run(ty, raw, x, out, rows, cols);
        Assert.equals(launched + 1L, Device.kernelLaunchCount(kernel));
        Assert.equals(derived + 1L, QuantKernel.waveGridDerivations());
    }

    @Test
    public void everyConvertedLauncherDerivesItsGeometry() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        WaveGeometryTest.derives("q2kQ8WaveMatVecKernel", Quant.GG_Q2_K, "q2_k.bin");
        WaveGeometryTest.derives("q3kQ8WaveMatVecKernel", Quant.GG_Q3_K, "q3_k.bin");
        WaveGeometryTest.derives("q5kQ8WaveMatVecKernel", Quant.GG_Q5_K, "q5_k.bin");
        WaveGeometryTest.derives("q80Q8WaveMatVecKernel", Quant.GG_Q8_0, "q8_0.bin");
        WaveGeometryTest.derives("q4kQ8WaveMatVecKernel", Quant.GG_Q4_K, "q4_k.bin");
        WaveGeometryTest.derives("q6kQ8WaveMatVecKernel", Quant.GG_Q6_K, "q6_k.bin");
    }
}
