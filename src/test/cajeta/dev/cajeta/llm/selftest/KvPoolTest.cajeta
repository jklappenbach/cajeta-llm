package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.model.DeviceKv;
import dev.cajeta.llm.model.KvPool;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.unit.AfterEach;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** cajeta-llm 15.2.12.3.2.1: decode slots' K/V planes are slices of one pool per layer, grown on demand without losing a byte. */
public class KvPoolTest {

    public KvPoolTest() { return; }

    @AfterEach
    public void restore() {
        DeviceKv.setRingSlack(256);
        KvPool.setBudgetBytes(0L);
        return;
    }

    static boolean device() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return false; }
        return true;
    }

    /** `n` halves unique to (layer, slot, plane kind). */
    static #float16[] pattern(int64 n, int32 li, int32 slot, int32 kind) {
        float16[] h #= heap float16[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float16) (float32) ((i % 97L) + 100L * (int64) slot + 1000L * (int64) li + 7L * (int64) kind);
            i = i + 1;
        }
        return #h;
    }

    /** Draws slot `slot`'s whole plane, so its blocks run in order on a fresh pool and {@link KvPool#kSlice} holds. */
    static void whole(KvPool p, int32 slot) {
        p.ensureRows(slot, p.logicalBlocks() * 64);
        p.flush();
    }

    static void write(KvPool p, int32 li, int32 slot) {
        KvPoolTest.whole(p, slot);
        float16[] k #= KvPoolTest.pattern(p.planeElements(li), li, slot, 0);
        float16[] v #= KvPoolTest.pattern(p.planeElements(li), li, slot, 1);
        KernelBuffer<float16> ks #= p.kSlice(li, slot);
        KernelBuffer<float16> vs #= p.vSlice(li, slot);
        ks.upload(k);
        vs.upload(v);
    }

    /** Fails naming the first element of (layer, slot) that lost its pattern. */
    static void holds(KvPool p, int32 li, int32 slot, String when) {
        int64 n = p.planeElements(li);
        float16[] k #= heap float16[n];
        float16[] v #= heap float16[n];
        KernelBuffer<float16> ks #= p.kSlice(li, slot);
        KernelBuffer<float16> vs #= p.vSlice(li, slot);
        ks.download(k);
        vs.download(v);
        float16[] wk #= KvPoolTest.pattern(n, li, slot, 0);
        float16[] wv #= KvPoolTest.pattern(n, li, slot, 1);
        int64 i = 0;
        while (i < n) {
            if ((float32) k[i] != (float32) wk[i] || (float32) v[i] != (float32) wv[i]) {
                Assert.fail(when + ": layer " + li + " slot " + slot + " element " + i
                    + " is k " + (float32) k[i] + " v " + (float32) v[i]
                    + ", wrote k " + (float32) wk[i] + " v " + (float32) wv[i]);
                return;
            }
            i = i + 1;
        }
    }

    @Test
    public void growingKeepsEveryByteOfTheEarlierSlots() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= heap KvPool(2, 64, 16);
        p.ensureSlots(1);
        KvPoolTest.write(p, 0, 0);
        KvPoolTest.write(p, 1, 0);
        int64[] vc #= ValueCheck.mark();
        p.ensureSlots(2);
        KvPoolTest.write(p, 0, 1);
        KvPoolTest.write(p, 1, 1);
        p.ensureSlots(3);
        Assert.equals(3L, (int64) p.slots());
        KvPoolTest.holds(p, 0, 0, "after growing to 3");
        KvPoolTest.holds(p, 1, 0, "after growing to 3");
        KvPoolTest.holds(p, 0, 1, "after growing to 3");
        KvPoolTest.holds(p, 1, 1, "after growing to 3");
        ValueCheck.credit(vc);
    }

    @Test
    public void aSlotsSliceTouchesOnlyThatSlot() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= heap KvPool(1, 64, 16);
        p.ensureSlots(3);
        KvPoolTest.write(p, 0, 0);
        KvPoolTest.write(p, 0, 2);
        KvPoolTest.write(p, 0, 1);
        KvPoolTest.holds(p, 0, 0, "after writing slot 1");
        KvPoolTest.holds(p, 0, 2, "after writing slot 1");
        Assert.equals(1, p.tableBase(1, 0));
        Assert.equals(1L, (int64) p.entry(p.tableBase(2, 0)));
        Assert.equals(2L, (int64) p.entry(p.tableBase(1, 0)));
    }

    /** Layers of window 8, none, 8, 100 and 600 at cap 512 and slack 64: three kinds, a window past the cap is none. */
    static #KvPool mixed() {
        DeviceKv.setRingSlack(64);
        int32[] w #= heap int32[5L];
        w[0L] = 8;
        w[1L] = 0;
        w[2L] = 8;
        w[3L] = 100;
        w[4L] = 600;
        KvPool p #= heap KvPool(512, 16, w);
        return #p;
    }

    /** 15.2.21.8.1.2.1: each layer's plane is its kind's size and every (slot, kind) has its own table region. */
    @Test
    public void ringedAndFlatKindsShareOnePool() {
        KvPool p #= KvPoolTest.mixed();
        Assert.equals(3L, (int64) p.kinds());
        Assert.equals((int64) p.kindOf(0), (int64) p.kindOf(2));
        Assert.equals((int64) p.kindOf(1), (int64) p.kindOf(4));
        Assert.equals(0L, (int64) p.windowOf(p.kindOf(1)));
        Assert.equals(192L, (int64) p.rowsOf(p.kindOf(0)));
        Assert.equals(512L, (int64) p.rowsOf(p.kindOf(1)));
        Assert.equals(256L, (int64) p.rowsOf(p.kindOf(3)));
        Assert.equals(192L * 16L, p.planeElements(2));
        Assert.equals(8L, (int64) p.logicalBlocks());
        Assert.equals((int64) ((1 * 3 + 2) * 8), (int64) p.tableBase(1, 2));
        Assert.isTrue(p.fits(1));
    }

    /** The table a growth uploads holds every drawn entry, and both kinds keep their rows. */
    @Test
    public void growingAMixedPoolKeepsBothKindsAndItsTable() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= KvPoolTest.mixed();
        p.ensureSlots(1);
        int32 l = 0;
        while (l < 5) { KvPoolTest.write(p, l, 0); l = l + 1; }
        int64[] vc #= ValueCheck.mark();
        p.ensureSlots(3);
        l = 0;
        while (l < 5) {
            KvPoolTest.write(p, l, 2);
            KvPoolTest.holds(p, l, 0, "after growing to 3");
            l = l + 1;
        }
        KvPoolTest.tableAgrees(p, 3);
        ValueCheck.credit(vc);
    }

    /** Fails unless the device table holds the host's entry at every drawn (slot, kind, block) of `slots` slots. */
    static void tableAgrees(KvPool p, int32 slots) {
        int64 te = (int64) slots * (int64) p.kinds() * (int64) p.logicalBlocks();
        int32[] th #= heap int32[te];
        KernelBuffer<int32> t = p.table();
        t.download(th);
        int32 slot = 0;
        while (slot < slots) {
            int32 kd = 0;
            while (kd < p.kinds()) {
                int32 b = 0;
                while (b < p.drawn(slot, kd)) {
                    int32 i = p.tableBase(slot, kd) + b;
                    Assert.equals((int64) p.entry(i), (int64) th[(int64) i]);
                    b = b + 1;
                }
                kd = kd + 1;
            }
            slot = slot + 1;
        }
    }

    /** 15.2.21.8.1.3.1: a slot draws a block a 64 positions as it grows, and a ring's entries past its R blocks repeat
     *  its first R. */
    @Test
    public void aSlotDrawsBlocksAsItGrows() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= KvPoolTest.mixed();
        p.ensureSlots(2);
        int32 kf = p.kindOf(1);
        int32 kr = p.kindOf(0);
        int32 kw = p.kindOf(3);
        Assert.equals(0L, (int64) p.freeBlocks(kf));
        p.ensureRows(0, 10);
        Assert.equals(1L, (int64) p.drawn(0, kf));
        Assert.equals(1L, (int64) p.drawn(0, kr));
        p.ensureRows(0, 70);
        Assert.equals(2L, (int64) p.drawn(0, kf));
        Assert.isTrue(p.entry(p.tableBase(0, kf)) != p.entry(p.tableBase(0, kf) + 1));
        p.ensureRows(0, 512);
        Assert.equals(8L, (int64) p.drawn(0, kf));
        Assert.equals(8L, (int64) p.drawn(0, kr));
        Assert.equals((int64) (p.capacity(kf) - 8), (int64) p.freeBlocks(kf));
        Assert.equals((int64) (p.capacity(kr) - 3), (int64) p.freeBlocks(kr));
        Assert.equals((int64) (p.capacity(kw) - 4), (int64) p.freeBlocks(kw));
        int32 b = 3;
        while (b < 8) {
            Assert.equals((int64) p.entry(p.tableBase(0, kr) + b % 3), (int64) p.entry(p.tableBase(0, kr) + b));
            Assert.equals((int64) p.entry(p.tableBase(0, kw) + b % 4), (int64) p.entry(p.tableBase(0, kw) + b));
            b = b + 1;
        }
        p.flush();
        KvPoolTest.tableAgrees(p, 2);
    }

    /** A released slot's blocks return to the free lists and are the next slot's draws. */
    @Test
    public void aReleasedSlotsBlocksGoToTheNextSlotToDraw() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= KvPoolTest.mixed();
        p.ensureSlots(2);
        int32 kf = p.kindOf(1);
        int32 kr = p.kindOf(0);
        p.ensureRows(0, 512);
        int32[] had #= heap int32[8L];
        int32 b = 0;
        while (b < 8) { had[(int64) b] = p.entry(p.tableBase(0, kf) + b); b = b + 1; }
        p.release(0);
        Assert.equals(0L, (int64) p.drawn(0, kf));
        Assert.equals((int64) p.capacity(kf), (int64) p.freeBlocks(kf));
        Assert.equals((int64) p.capacity(kr), (int64) p.freeBlocks(kr));
        int32 grew = p.blockGrowths();
        p.ensureRows(1, 512);
        Assert.equals((int64) grew, (int64) p.blockGrowths());
        b = 0;
        while (b < 8) {
            Assert.equals((int64) had[(int64) b], (int64) p.entry(p.tableBase(1, kf) + b));
            b = b + 1;
        }
        p.flush();
        KvPoolTest.tableAgrees(p, 2);
    }

    /** 15.2.21.8.1.3.2: a pool holds no block until a slot draws one, then exactly the blocks drawn; a growth when no
     *  block is free keeps every live block's rows. */
    @Test
    public void blocksGrowOnDemandAndKeepLiveRows() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= KvPoolTest.mixed();
        p.ensureSlots(2);
        Assert.equals(0L, p.deviceBytes());
        int32 l = 0;
        while (l < 5) { KvPoolTest.write(p, l, 0); l = l + 1; }
        Assert.equals((int64) (8 * 2 + 3 * 2 + 4) * 64L * 16L * 4L, p.deviceBytes());
        int32 grew = p.blockGrowths();
        int64[] vc #= ValueCheck.mark();
        p.ensureRows(1, 512);
        p.flush();
        Assert.isTrue(p.blockGrowths() > grew);
        l = 0;
        while (l < 5) {
            KvPoolTest.holds(p, l, 0, "after slot 1 grew the pool");
            l = l + 1;
        }
        KvPoolTest.tableAgrees(p, 2);
        ValueCheck.credit(vc);
    }

    /** Reserving for admitted lengths grows each kind once, exactly, so their draws grow nothing. */
    @Test
    public void aReserveForAdmittedLengthsLetsTheirDrawsGrowNothing() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= KvPoolTest.mixed();
        p.ensureSlots(2);
        int32[] lens #= heap int32[2L];
        lens[0L] = 512;
        lens[1L] = 70;
        p.reserve(lens, 2);
        Assert.equals((int64) (10 * 2 + 5 * 2 + 6) * 64L * 16L * 4L, p.deviceBytes());
        int32 grew = p.blockGrowths();
        p.ensureRows(0, 512);
        p.ensureRows(1, 70);
        Assert.equals((int64) grew, (int64) p.blockGrowths());
        p.flush();
        KvPoolTest.tableAgrees(p, 2);
    }

    /** A growth past the budget is refused by name and leaves the pool as it was. */
    @Test
    public void aGrowthPastTheBudgetIsRefused() {
        if (!KvPoolTest.device()) { return; }
        KvPool p #= KvPoolTest.mixed();
        p.ensureSlots(2);
        p.ensureRows(0, 64);
        int64 held = p.deviceBytes();
        KvPool.setBudgetBytes(held + 1L);
        boolean threw = false;
        String msg = "";
        try {
            p.ensureRows(0, 512);
        } catch (LlmException ex) {
            threw = true;
            msg #= ex.message.substring(0, ex.message.byteLength());
        }
        KvPool.setBudgetBytes(0L);
        Assert.isTrue(threw);
        Assert.isTrue(msg.indexOf("budget") >= 0L);
        Assert.equals(held, p.deviceBytes());
    }

    @Test
    public void aPoolPastTwoGibibytesIsRefused() {
        KvPool p #= heap KvPool(1, 1048576, 256);
        Assert.isTrue(p.fits(3));
        Assert.isTrue(!p.fits(5));
    }

    static #LlmEngine engine(int32 seqs) {
        EngineOptions o #= heap EngineOptions(RoutableFixtureTest.FIX);
        o.ctx = 128;
        o.maxSeqs = seqs;
        o.blockTokens = 16;
        o.chunk = 64;
        LlmEngine e #= LlmEngine.load(#o);
        return #e;
    }

    /** One sequence on a four-slot engine holds one slot, so a lone stream's memory is what it was; four hold four. */
    /** Engine load sets the process-wide prefill-weight policy; put it back for the tests after this one. */
    @Test
    public void slotsAreAllocatedOnlyForSequencesThatDecode() {
        if (!KvPoolTest.device()) { return; }
        boolean autoWas = Linear.deqAutoOn();
        boolean deqWas = Linear.deqPrefillOn();
        KvPoolTest.slotCounts();
        Linear.setDeqAuto(autoWas);
        Linear.setDeqPrefill(deqWas);
    }

    /** Four sequences submitted together grow the pool twice after load — the warm-up holds one slot, and the pool doubles toward maxSeqs at submit (2, then 4) — not once a sequence (15.2.15.1.1, 15.2.15.1.4). */
    @Test
    public void fourSequencesSubmittedTogetherGrowThePoolByDoubling() {
        if (!KvPoolTest.device()) { return; }
        boolean autoWas = Linear.deqAutoOn();
        boolean deqWas = Linear.deqPrefillOn();
        LlmEngine four #= KvPoolTest.engine(4);
        int32 atLoad = four.model().kvPoolGrowths();
        int32 q = 0;
        while (q < 4) {
            int32[] pq #= RoutableFixtureTest.promptOf(20 + 3 * q, 5 + 11 * q);
            four.submitTokens(pq, 20 + 3 * q, 8, #heap SampleParams(0.0f, (int64) (41 + q)));
            q = q + 1;
        }
        four.runAll(400);
        int32 slots = four.model().kvPoolSlots();
        int32 growths = four.model().kvPoolGrowths() - atLoad;
        boolean device = four.model().deviceKvSlotsActive() > 0;
        four.close();
        Linear.setDeqAuto(autoWas);
        Linear.setDeqPrefill(deqWas);
        if (!device) {
            DeviceSkip.tracked("the fixture decodes on the host here", "15.2.12.3.2.1");
            return;
        }
        Assert.equals(4L, (int64) slots);
        Assert.equals(2L, (int64) growths);
    }

    /** The pool holds a slot for every submitted sequence before the first step runs, so the step that admits them grows nothing (15.2.15.1.4): the reserve is part of accepting work, not of serving it. */
    @Test
    public void submittedSequencesReserveThePoolBeforeTheFirstStep() {
        if (!KvPoolTest.device()) { return; }
        boolean autoWas = Linear.deqAutoOn();
        boolean deqWas = Linear.deqPrefillOn();
        LlmEngine four #= KvPoolTest.engine(4);
        int32 q = 0;
        while (q < 4) {
            int32[] pq #= RoutableFixtureTest.promptOf(20 + 3 * q, 5 + 11 * q);
            four.submitTokens(pq, 20 + 3 * q, 8, #heap SampleParams(0.0f, (int64) (41 + q)));
            q = q + 1;
        }
        int32 slotsAtSubmit = four.model().kvPoolSlots();
        int32 growthsAtSubmit = four.model().kvPoolGrowths();
        four.stepOnce();
        int32 growthsAfterStep = four.model().kvPoolGrowths();
        four.runAll(400);
        boolean device = four.model().deviceKvSlotsActive() > 0;
        int32 growthsAtEnd = four.model().kvPoolGrowths();
        four.close();
        Linear.setDeqAuto(autoWas);
        Linear.setDeqPrefill(deqWas);
        if (!device) {
            DeviceSkip.tracked("the fixture decodes on the host here", "15.2.12.3.2.1");
            return;
        }
        Assert.equals(4L, (int64) slotsAtSubmit);
        Assert.equals((int64) growthsAtSubmit, (int64) growthsAfterStep);
        Assert.equals((int64) growthsAtSubmit, (int64) growthsAtEnd);
    }

    /** A slot's prefill scratch holds one float of scores where the online flash tile
     *  serves, which reads none: rows x heads x context floats was 268 MB a slot on an
     *  8B at ctx 4096 and 1.07 GB on a 30B-A3B's four slots (15.2.15.4). */
    @Test
    public void prefillScoresAreOneFloatWhereTheOnlineTileServes() {
        if (!KvPoolTest.device()) { return; }
        boolean autoWas = Linear.deqAutoOn();
        boolean deqWas = Linear.deqPrefillOn();
        LlmEngine one #= KvPoolTest.engine(4);
        int32[] p #= RoutableFixtureTest.promptOf(20, 5);
        one.submitTokens(p, 20, 8, #heap SampleParams(0.0f, 41L));
        one.runAll(200);
        boolean device = one.model().deviceKvSlotsActive() > 0;
        boolean online = one.model().prefillOnlineServes();
        int64 scores = one.model().prefillScoresBytesOf(0);
        one.close();
        Linear.setDeqAuto(autoWas);
        Linear.setDeqPrefill(deqWas);
        if (!device) {
            DeviceSkip.tracked("the fixture decodes on the host here", "15.2.12.3.2.1");
            return;
        }
        if (!online) {
            DeviceSkip.tracked("the online flash tile does not serve this fixture here", "cajeta-llm 15.2.15.4");
            return;
        }
        Assert.equals(4L, scores);
    }

    static void slotCounts() {
        LlmEngine one #= KvPoolTest.engine(4);
        int32[] p #= RoutableFixtureTest.promptOf(20, 5);
        one.submitTokens(p, 20, 8, #heap SampleParams(0.0f, 41L));
        one.runAll(200);
        if (one.model().deviceKvSlotsActive() == 0) {
            one.close();
            DeviceSkip.tracked("the fixture decodes on the host here", "15.2.12.3.2.1");
            return;
        }
        Assert.equals(1L, (int64) one.model().kvPoolSlots());
        one.close();
        LlmEngine four #= KvPoolTest.engine(4);
        int32 q = 0;
        while (q < 4) {
            int32[] pq #= RoutableFixtureTest.promptOf(20 + 3 * q, 5 + 11 * q);
            four.submitTokens(pq, 20 + 3 * q, 8, #heap SampleParams(0.0f, (int64) (41 + q)));
            q = q + 1;
        }
        four.runAll(400);
        Assert.equals(4L, (int64) four.model().kvPoolSlots());
        four.close();
    }
}
