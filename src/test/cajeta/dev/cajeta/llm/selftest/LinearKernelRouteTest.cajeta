package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.Diag;
import cajeta.io.file.File;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Linear;
import cajeta.math.Tensor;
import cajeta.lang.String;
import cajeta.lang.Cajeta;
import cajeta.time.Clock;
import cajeta.xpu.Autotune;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.EngineOptions;
import cajeta.io.file.Path;
import dev.cajeta.llm.io.WmmaKernel;
import cajeta.xpu.KernelManifest;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelResourceDescriptor;
import cajeta.lang.Optional;

/**
 * threaded-forward-path plan 4.1 — `Linear.matvecInto` routed through the
 * Q4_K kernel.
 *
 * Unit 3 already settled the arithmetic: the kernel is bit-identical to
 * `Quant.q4kMatVecInto` over the same bytes. What is new here is the
 * PLUMBING — a weight uploaded once and kept resident, activations copied
 * in and out through fixed-size scratch, offsets that no longer reach the
 * kernel because the scratch is exactly one row wide. Those are the things
 * that can be wrong while the arithmetic stays right, so every test below
 * compares ROUTED against FORCED-SERIAL on the same `Linear`.
 *
 * The bar there is a TOLERANCE, and that is a correction. The file was
 * written when the kernel summed 16 lanes like `Quant.q4kMatVecInto` and
 * demanded bit-identity of the pair; the kernel went to 4 lanes for a 3.7x
 * (plan 6.3.3) and the two now reassociate the same products differently by
 * construction. Nothing caught the stale bar because this file called an
 * `assertClose` that was never defined, so it has not compiled — and none
 * of these tests has run — since commit 08b7bcd.
 *
 * Bit-identity is still the bar wherever the lane counts actually match:
 * `QuantKernelTest` holds each kernel against `q4kMatVecIntoLanes4`, and
 * the routed-vs-routed comparisons below (offsets, row slicing) are exact.
 *
 * The fixture is `toy-q4k.gguf` (tools/gguf/gen_q4k_linear_fixture.py): a
 * Q4_K tensor and a Q6_K tensor built from the REAL blocks already checked
 * in under kquant/, each with its gguf-py dequantized twin as F32, all
 * shaped [out=8, in=256]. Both formats in ONE file on purpose — that is
 * what a Q4_K_M ships.
 */
public class LinearKernelRouteTest {

    static final String Q4K = "src/test/fixtures/gguf/toy-q4k.gguf";
    static final String Q4K_NAME = "model.layers.0.mlp.down_proj.weight";
    static final String Q6K_NAME = "model.layers.0.self_attn.v_proj.weight";
    static final String TOY = "src/test/fixtures/gguf/toy.gguf";
    static final String Q8_NAME = "model.layers.0.mlp.down_proj.weight";
    static final String KQ = "src/test/fixtures/gguf/kquant/";
    static final int32 CO = 128;     // outDim: one Mw8 / coop row tile
    static final int32 CI = 256;     // inDim: one k-quant super-block


    public LinearKernelRouteTest() { return; }

    static #Tensor<float32> ramp(int64 n, int64 pad) {
        int64[] shp #= heap int64[1];
        shp[0] = n + pad;
        Tensor<float32> t #= Tensor.zeros<float32>(shp);
        int64 i = 0;
        while (i < n) {
            t.flatSet(i, (float32) ((i % 11L) - 5L) * 0.375f);
            i = i + 1;
        }
        return #t;
    }

    /**
     * The file's comparison bar, factored out.
     *
     * NOT NEW BEHAVIOUR — `q8WeightIsUnaffectedByTheQ4KRoute` has called
     * this since it was written and it was never defined, so this file has
     * not compiled since commit 08b7bcd and NONE of its routing tests have
     * ever run. A test that cannot compile fails exactly like a test that
     * does not exist.
     *
     * `exact` is what the surrounding tests demand of a kernel checked
     * against a serial reference over the same bytes in the same order:
     * bit-identity, not a tolerance. The tolerant branch exists for
     * comparisons that legitimately reassociate.
     */
    static void assertClose(float32 got, float32 want, boolean exact,
            String what) {
        if (exact) {
            if (got != want) {
                Assert.fail(what + ": got " + got + " want " + want
                    + " (bit-identity required)");
            }
            return;
        }
        float32 d = got - want;
        if (d < 0.0f) { d = 0.0f - d; }
        float32 scale = want < 0.0f ? 0.0f - want : want;
        if (d > 0.000001f + scale * 0.000001f) {
            Assert.fail(what + ": got " + got + " want " + want);
        }
        return;
    }

    static void assertLive(Tensor<float32> t, int64 n, String what) {
        int64 i = 0;
        while (i < n) {
            if (t.flatGet(i) != 0.0f) { return; }
            i = i + 1;
        }
        Assert.fail(what + ": every value is zero, which is what a kernel "
            + "that never ran produces");
    }

    /**
     * 4.1.1 — routed and serial agree bit for bit through `matvecInto`.
     *
     * Serial runs FIRST and routed SECOND, deliberately: the routed path
     * builds its resident device buffer on first use, so this ordering is
     * the one where a bad upload shows up.
     */
    @Test
    public void routedMatvecMatchesSerialForQ4K() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Assert.isTrue(lin.isPacked());
        Assert.equals((int64) Quant.GG_Q4_K, (int64) lin.packedType());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L,
            (int64) outDim);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, (int64) outDim);

        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, want, 0L);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, got, 0L);

        LinearKernelRouteTest.assertLive(want, (int64) outDim, "serial");
        LinearKernelRouteTest.assertLive(got, (int64) outDim, "routed");
        int64 o = 0;
        while (o < (int64) outDim) {
            // TOLERANCE, not bit-identity, and only for routed-vs-SERIAL:
            // the kernel sums 4 lanes wide and `Quant.q4kMatVecInto` sums 16,
            // so they reassociate the same products differently by design
            // (plan 6.3.3 — the 4-lane shape is 3.7x faster). Bit-identity
            // still holds where the lane counts match, and that is where it
            // is asserted: QuantKernelTest against `q4kMatVecIntoLanes4`,
            // and routed-vs-routed below.
            LinearKernelRouteTest.assertClose(got.flatGet(o),
                want.flatGet(o), false, "row " + o);
            o = o + 1;
        }
        ck.close();
    }

    /**
     * 4.1.1 — the resident weight survives repeated calls with DIFFERENT
     * activations.
     *
     * The upload happens once; everything after it reuses the buffer. A
     * scratch that is filled once and then reused stale, or a device
     * buffer uploaded from the wrong array, passes the single-call test
     * above and fails this one.
     */
    @Test
    public void routedMatvecIsCorrectOnRepeatedCallsWithNewActivations() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);

        int64[] ishp #= heap int64[1];
        ishp[0] = (int64) inDim;
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;

        int32 call = 0;
        while (call < 3) {
            Tensor<float32> src #= Tensor.zeros<float32>(ishp);
            int64 i = 0;
            while (i < (int64) inDim) {
                src.flatSet(i, (float32) ((i + (int64) call * 3L) % 13L - 6L)
                    * 0.25f);
                i = i + 1;
            }
            Tensor<float32> want #= Tensor.zeros<float32>(oshp);
            Tensor<float32> got #= Tensor.zeros<float32>(oshp);

            QuantKernel.setRoutingEnabled(false);
            lin.matvecInto(src, 0L, want, 0L);
            QuantKernel.setRoutingEnabled(true);
            lin.matvecInto(src, 0L, got, 0L);

            LinearKernelRouteTest.assertLive(got, (int64) outDim,
                "routed call " + call);
            int64 o = 0;
            while (o < (int64) outDim) {
                LinearKernelRouteTest.assertClose(got.flatGet(o),
                    want.flatGet(o), false, "call " + call + " row " + o);
                o = o + 1;
            }
            call = call + 1;
        }
        ck.close();
    }

    /**
     * 4.1.1 — non-zero `srcOff`/`dstOff` into larger tensors, and the
     * margins of `dst` left alone.
     *
     * The routed path copies one row's worth of activations through
     * fixed-size scratch, so the offsets never reach the kernel. That is a
     * reasonable design and an easy place to drop an offset entirely; a
     * routed path that ignored `dstOff` would still match on the values
     * and scribble over index 0.
     */
    @Test
    public void routedMatvecHonoursOffsets() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> flat #= Tensor.zeros<float32>(oshp);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, flat, 0L);
        LinearKernelRouteTest.assertLive(flat, (int64) outDim, "routed");

        // Same activations, shifted inside bigger tensors.
        int64[] bishp #= heap int64[1];
        bishp[0] = (int64) inDim + 8L;
        Tensor<float32> bigSrc #= Tensor.zeros<float32>(bishp);
        int64 i = 0;
        while (i < (int64) inDim) {
            bigSrc.flatSet(i + 5L, src.flatGet(i));
            i = i + 1;
        }
        int64[] boshp #= heap int64[1];
        boshp[0] = (int64) outDim + 4L;
        Tensor<float32> bigDst #= Tensor.zeros<float32>(boshp);
        lin.matvecInto(bigSrc, 5L, bigDst, 3L);

        int64 o = 0;
        while (o < (int64) outDim) {
            if (bigDst.flatGet(o + 3L) != flat.flatGet(o)) {
                Assert.fail("row " + o + " at offset: "
                    + bigDst.flatGet(o + 3L) + " vs flat " + flat.flatGet(o));
            }
            o = o + 1;
        }
        // Margins untouched.
        Assert.equals((int64) (bigDst.flatGet(0L) * 1000000.0f), 0L);
        Assert.equals((int64) (bigDst.flatGet(1L) * 1000000.0f), 0L);
        Assert.equals((int64) (bigDst.flatGet(2L) * 1000000.0f), 0L);
        Assert.equals(
            (int64) (bigDst.flatGet((int64) outDim + 3L) * 1000000.0f), 0L);
        ck.close();
    }

    /**
     * 6.1.2 — a Q4_K_M-shaped MIX: a Q4_K weight and a Q6_K weight bound
     * from one checkpoint, both routed, both matching serial.
     *
     * The mix is the normal case, not an edge case: a real Q4_K_M is
     * 74.4% Q4_K and 25.6% Q6_K by bytes (measured on
     * Meta-Llama-3.1-8B-Instruct-Q4_K_M), with `attn_v` and
     * `output.weight` carrying the Q6_K. Per-format tests each pass under
     * a dispatch that ignores the type; this one does not.
     */
    @Test
    public void q4kAndQ6kInOneCheckpointBothRouteCorrectly() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int32 pass = 0;
        while (pass < 2) {
            String nm = pass == 0 ? LinearKernelRouteTest.Q4K_NAME
                                  : LinearKernelRouteTest.Q6K_NAME;
            int32 wantTy = pass == 0 ? Quant.GG_Q4_K : Quant.GG_Q6_K;
            int64[] shp #= ck.shapeOf(nm);
            int32 outDim = (int32) shp[0];
            int32 inDim = (int32) shp[1];

            Linear lin #= heap Linear(inDim, outDim);
            lin.bind(ck, nm, false);
            Assert.isTrue(lin.isPacked());
            Assert.equals((int64) wantTy, (int64) lin.packedType());

            Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim,
                0L);
            int64[] oshp #= heap int64[1];
            oshp[0] = (int64) outDim;
            Tensor<float32> want #= Tensor.zeros<float32>(oshp);
            Tensor<float32> got #= Tensor.zeros<float32>(oshp);

            QuantKernel.setRoutingEnabled(false);
            lin.matvecInto(src, 0L, want, 0L);
            QuantKernel.setRoutingEnabled(true);
            lin.matvecInto(src, 0L, got, 0L);

            LinearKernelRouteTest.assertLive(want, (int64) outDim,
                "serial " + nm);
            LinearKernelRouteTest.assertLive(got, (int64) outDim,
                "routed " + nm);
            int64 o = 0;
            while (o < (int64) outDim) {
                LinearKernelRouteTest.assertClose(got.flatGet(o),
                    want.flatGet(o), false, nm + " row " + o);
                o = o + 1;
            }
            pass = pass + 1;
        }
        ck.close();
    }

    /**
     * 4.1.2 / 6.1.2 — a Q8_0 weight gives the SAME answer routed and
     * serial.
     *
     * This was the does-NOT-fire half while Q8_0 had no kernel: a dispatch
     * written as "packed → kernel" rather than per-TYPE would have fed
     * Q8_0 bytes to the Q4_K decoder. Q8_0 now has its own kernel, so the
     * test still catches exactly that mistake — as a wrong answer from the
     * wrong decoder rather than as an unexpected change.
     */
    @Test
    public void q8WeightIsUnaffectedByTheQ4KRoute() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.TOY);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q8_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q8_NAME, false);
        Assert.isTrue(lin.isPacked());
        Assert.equals((int64) Quant.GG_Q8_0, (int64) lin.packedType());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> off #= Tensor.zeros<float32>(oshp);
        Tensor<float32> on #= Tensor.zeros<float32>(oshp);

        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, off, 0L);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, on, 0L);

        LinearKernelRouteTest.assertLive(off, (int64) outDim, "q8 serial");
        int64 o = 0;
        while (o < (int64) outDim) {
            LinearKernelRouteTest.assertClose(on.flatGet(o),
                off.flatGet(o), true, "q8 row " + o);
            o = o + 1;
        }
        ck.close();
    }

    /**
     * A ROW-SLICED launch computes exactly what a whole-weight launch does.
     *
     * Splitting one dispatch into row slices is worth 1.74x on gfx1151 (98.8
     * to 56.7 ms/token) because the kernel's speed is set by its grid, not by
     * the weight's size. It is only worth anything if the answer is
     * unchanged, and the slice has two adjustments that can each be wrong on
     * their own: the packed buffer is re-based to the chunk's first row, and
     * `yOff` carries the chunk's offset into the output.
     *
     * The bar is bit-identity against BOTH the whole-weight route and the
     * serial reference, and the launch COUNT is asserted alongside the
     * values — 4 dispatches for 8 rows in chunks of 2, and 1 without. A test
     * that checked only the numbers would pass just as happily against a
     * build where chunking silently never engaged, which is the failure this
     * exists to catch.
     */
    @Test
    public void rowSlicedLaunchesMatchAWholeWeightLaunch() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Assert.isTrue(lin.isPacked());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> ser #= Tensor.zeros<float32>(oshp);
        Tensor<float32> whole #= Tensor.zeros<float32>(oshp);
        Tensor<float32> sliced #= Tensor.zeros<float32>(oshp);

        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, ser, 0L);

        QuantKernel.setRoutingEnabled(true);
        Linear.setLaunchChunkRows(0L);              // one dispatch
        Linear.resetLaunchCount();
        lin.matvecInto(src, 0L, whole, 0L);
        int64 nWhole = Linear.launchCount();

        Linear.setLaunchChunkRows(2L);              // 8 rows -> 4 dispatches
        Linear.resetLaunchCount();
        lin.matvecInto(src, 0L, sliced, 0L);
        int64 nSliced = Linear.launchCount();

        LinearKernelRouteTest.assertLive(whole, (int64) outDim, "whole");
        LinearKernelRouteTest.assertLive(sliced, (int64) outDim, "sliced");
        // The mechanism moved, and it moved by the amount the chunk size
        // implies -- not merely "more than one".
        Assert.equals(1L, nWhole);
        Assert.equals(((int64) outDim + 1L) / 2L, nSliced);

        int64 o = 0;
        while (o < (int64) outDim) {
            LinearKernelRouteTest.assertClose(sliced.flatGet(o),
                whole.flatGet(o), true, "sliced vs whole row " + o);
            // Against the SERIAL path the bar is a tolerance for the lane
            // reason above; against the whole-weight LAUNCH it is exact,
            // because that pair differs only in grid.
            LinearKernelRouteTest.assertClose(sliced.flatGet(o),
                ser.flatGet(o), false, "sliced vs serial row " + o);
            o = o + 1;
        }
        Linear.setLaunchChunkRows(0L);
        ck.close();
    }

    /**
     * A chunk size at or above the row count leaves ONE dispatch — the
     * does-not-fire half. Without it, "chunking is correct" and "chunking is
     * unreachable" look the same from the outside.
     */
    @Test
    public void aChunkLargerThanTheWeightIssuesASingleLaunch() {
        // The f32 route, PINNED. These tests compare routed against serial
        // and the bar is numerical agreement; the q8 integer route
        // deliberately does not agree, because it quantizes the activations.
        // Leaving the choice to the backend default would make what these
        // assert depend on which machine ran them.
        Linear.setQ8Route(false);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> y #= Tensor.zeros<float32>(oshp);

        QuantKernel.setRoutingEnabled(true);
        Linear.setLaunchChunkRows((int64) outDim * 4L);
        Linear.resetLaunchCount();
        lin.matvecInto(src, 0L, y, 0L);
        Assert.equals(1L, Linear.launchCount());
        LinearKernelRouteTest.assertLive(y, (int64) outDim, "oversized chunk");
        Linear.setLaunchChunkRows(0L);
        ck.close();
    }

    /**
     * The q8 INTEGER route through `Linear`, which is a different bar.
     *
     * Every test above pins the f32 route because it compares routed against
     * serial and expects agreement. This one selects the integer route and
     * expects DISAGREEMENT within a band: quantizing the activations to int8
     * is an approximation the serial path does not make. 1% of magnitude is
     * the band, and it is asserted from both sides — too far apart means the
     * route is wrong, exactly equal means the quantization never happened
     * and the test is vacuous.
     */
    @Test
    public void theQ8RouteAgreesWithSerialToAboutOnePercent() {
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Assert.isTrue(lin.isPacked());

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> ser #= Tensor.zeros<float32>(oshp);
        Tensor<float32> q8 #= Tensor.zeros<float32>(oshp);

        Linear.setQ8Route(false);
        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, ser, 0L);

        Linear.setQ8Route(true);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, q8, 0L);

        LinearKernelRouteTest.assertLive(ser, (int64) outDim, "serial");
        LinearKernelRouteTest.assertLive(q8, (int64) outDim, "q8 route");
        boolean anyDiffer = false;
        int64 o = 0;
        while (o < (int64) outDim) {
            float32 a = ser.flatGet(o);
            float32 b = q8.flatGet(o);
            if (a != b) { anyDiffer = true; }
            float32 d = b - a;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 m = a < 0.0f ? 0.0f - a : a;
            if (d > 0.01f * m + 0.001f) {
                Assert.fail("row " + o + ": q8 " + b + " is not within 1% of "
                    + "serial " + a);
            }
            o = o + 1;
        }
        if (!anyDiffer) {
            Assert.fail("the q8 route matched serial EXACTLY, so the "
                + "activation quantization did not happen");
        }
        Linear.setQ8Route(false);
        ck.close();
    }

    /**
     * A caller that opens no sharing window is never served from the stage.
     *
     * SAME tensor, SAME offset, DIFFERENT contents — the shape `xn` has from
     * one layer to the next, and the case a cache keyed on identity plus
     * offset gets wrong. The default has to be safe: this test says nothing
     * about sharing and must still see its own second activation.
     */
    @Test
    public void withoutASharingWindowEveryCallStagesItsOwnActivation() {
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Linear.setQ8Route(false);
        QuantKernel.setRoutingEnabled(true);

        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> yA #= Tensor.zeros<float32>(oshp);
        Tensor<float32> yB #= Tensor.zeros<float32>(oshp);

        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        lin.matvecInto(src, 0L, yA, 0L);
        int64 i = 0;
        while (i < (int64) inDim) {
            src.flatSet(i, src.flatGet(i) * -2.0f);
            i = i + 1;
        }
        lin.matvecInto(src, 0L, yB, 0L);

        LinearKernelRouteTest.assertLive(yA, (int64) outDim, "first");
        LinearKernelRouteTest.assertLive(yB, (int64) outDim, "second");
        int64 o = 0;
        boolean differ = false;
        while (o < (int64) outDim) {
            if (yA.flatGet(o) != yB.flatGet(o)) { differ = true; }
            o = o + 1;
        }
        if (!differ) {
            Assert.fail("the second call returned the FIRST activation's "
                + "result - the stage served a stale entry");
        }
        ck.close();
    }

    /**
     * Inside a window, the SAME activation is staged once — and the answer is
     * still right. Both halves matter: the count proves the optimization
     * fires, and the values prove it did not change what is computed. A test
     * that checked only the values would pass against a build where sharing
     * silently never engaged.
     */
    @Test
    public void insideASharingWindowTheActivationIsStagedOnce() {
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q4K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];

        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q4K_NAME, false);
        Linear.setQ8Route(false);
        QuantKernel.setRoutingEnabled(true);

        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> yA #= Tensor.zeros<float32>(oshp);
        Tensor<float32> yB #= Tensor.zeros<float32>(oshp);
        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);

        Linear.resetStageCounts();
        Linear.beginSharedActivation();
        lin.matvecInto(src, 0L, yA, 0L);
        lin.matvecInto(src, 0L, yB, 0L);
        Linear.endSharedActivation();

        Assert.equals(1L, Linear.stageMisses());
        Assert.equals(1L, Linear.stageHits());
        int64 o = 0;
        while (o < (int64) outDim) {
            LinearKernelRouteTest.assertClose(yB.flatGet(o), yA.flatGet(o),
                true, "shared row " + o);
            o = o + 1;
        }
        LinearKernelRouteTest.assertLive(yA, (int64) outDim, "shared");
        ck.close();
    }

    /**
     * The does-NOT-fire half of the Q6_K wave route (plan 11.2): with the
     * switch ON it must be CLOSE to the exact route and must not EQUAL it.
     *
     * The route quantizes activations to q8_K, which is an approximation
     * the serial path does not make. Exact agreement would mean the route
     * is not being taken — and the test above, which pins the switch OFF,
     * would still pass in that case.
     */
    @Test
    public void theQ6kWaveRouteApproximatesRatherThanMatchesTheSerialPath() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        Linear.setQ8Route(true);
        Checkpoint ck #= Checkpoint.open(LinearKernelRouteTest.Q4K);
        int64[] shp #= ck.shapeOf(LinearKernelRouteTest.Q6K_NAME);
        int32 outDim = (int32) shp[0];
        int32 inDim = (int32) shp[1];
        Linear lin #= heap Linear(inDim, outDim);
        lin.bind(ck, LinearKernelRouteTest.Q6K_NAME, false);
        Tensor<float32> src #= LinearKernelRouteTest.ramp((int64) inDim, 0L);
        int64[] oshp #= heap int64[1];
        oshp[0] = (int64) outDim;
        Tensor<float32> want #= Tensor.zeros<float32>(oshp);
        Tensor<float32> got #= Tensor.zeros<float32>(oshp);
        QuantKernel.setRoutingEnabled(false);
        lin.matvecInto(src, 0L, want, 0L);
        QuantKernel.setRoutingEnabled(true);
        lin.matvecInto(src, 0L, got, 0L);
        ck.close();
        int64 o = 0;
        int64 differing = 0;
        while (o < (int64) outDim) {
            float32 a = want.flatGet(o);
            float32 b = got.flatGet(o);
            float32 diff = a - b;
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = a < 0.0f ? 0.0f - a : a;
            if (diff > mag * 0.01f + 0.001f) {
                Assert.fail("row " + o + ": routed " + b + " vs serial " + a
                    + " - further apart than q8_K quantization explains");
            }
            if (a != b) { differing = differing + 1; }
            o = o + 1;
        }
        if (differing == 0) {
            Assert.fail("the Q6_K wave route matched the serial path "
                + "EXACTLY - the activation quantization is not happening");
        }
    }

    // ── prefill-routes Unit 2: the batched route for every format ───────

    /** A `[CO x CI]` weight tiled from a kquant fixture's real blocks. */
    static #Linear tiled(int32 ty, String fixture) {
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 be = (int64) Quant.blockElems(ty);
        int64 nBlocks = (int64) LinearKernelRouteTest.CO
            * ((int64) LinearKernelRouteTest.CI / be);
        int8[] fix #= File.readAllBytes(LinearKernelRouteTest.KQ + fixture);
        int64 fixBlocks = (int64) fix.count() / bb;
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        Linear lin = heap Linear(LinearKernelRouteTest.CI,
            LinearKernelRouteTest.CO);
        lin.bindPacked(#raw, ty);
        return #lin;
    }

    /**
     * 9.2.4 — IQ4_NL at a 256-aligned width must take the f32 WAVE
     * mat-vec. `wavef` was gated on `!q8kDims`, which a type with no
     * INTEGER wave route answers no to just as surely as one that has
     * it, so IQ4_NL decoded item-per-row: 124 weight-GB/s against
     * Q4_0's 213 on a file of the same size and bit width.
     */
    @Test
    public void iq4nlTakesTheF32WaveRouteWhenTheIntegerRouteIsPinnedOff() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        Linear.setQ8Route(false);
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_IQ4_NL,
            "iq4_nl.bin");
        boolean f32 = lin.f32WaveRouted();
        Linear.setQ8Route(true);
        Assert.isTrue(f32);
    }

    /** 9.2.5 — and with the integer route ON it takes THAT, not the f32
     *  one: the q8_K activation quantization changes the answer, so it
     *  lives behind `q8Route` like every other route that does. */
    @Test
    public void iq4nlTakesTheIntegerWaveRouteAt256Width() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        Linear.setQ8Route(true);
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_IQ4_NL,
            "iq4_nl.bin");
        Assert.isTrue(lin.intWaveRouted());
        Assert.isTrue(!lin.f32WaveRouted());
    }

    /** The does-not-fire half: Q4_0 HAS an integer wave route at this
     *  width, so it must not take the f32 one — a guard that answered
     *  yes to everything would pass the case above on its own. */
    @Test
    public void q40TakesTheIntegerWaveRouteNotTheF32OneAt256Width() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        Linear.setQ8Route(true);
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_Q4_0,
            "q4_0.bin");
        Assert.isTrue(!lin.f32WaveRouted());
    }

    /** Batched `matmulInto` over `rows` ramp rows against the serial path
     *  row by row: `tol` relative, with a 0.01 absolute floor. */
    static void checkBatched(Linear lin, int32 rows, float64 tol,
            String what) {
        int64 ci = (int64) LinearKernelRouteTest.CI;
        int64 co = (int64) LinearKernelRouteTest.CO;
        Tensor<float32> x #= LinearKernelRouteTest.ramp((int64) rows * ci, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * co);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * co);
        QuantKernel.setRoutingEnabled(false);
        int64 r = 0;
        while (r < (int64) rows) {
            lin.matvecInto(x, r * ci, want, r * co);
            r = r + 1;
        }
        QuantKernel.setRoutingEnabled(true);
        Linear.stageBatch(x, 0L, rows, (int32) ci, Linear.nextStageTag());
        lin.matmulInto(rows, got, 0L);
        boolean live = false;
        int64 i = 0;
        while (i < (int64) rows * co) {
            float32 g = got.flatGet(i);
            float32 w = want.flatGet(i);
            if (g != 0.0f) { live = true; }
            float32 d = g - w;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 m = w < 0.0f ? 0.0f - w : w;
            if ((float64) d > (float64) m * tol + 0.01) {
                Assert.fail(what + " at " + i + ": batched " + g
                    + " vs serial " + w);
            }
            i = i + 1;
        }
        if (!live) {
            Assert.fail(what + ": every batched output is zero");
        }
        return;
    }

    static boolean coopHereOrSay() {
        if (CoopQuantGemmTest.coopHere()) { return true; }
        System.stdout.println("  [device-skip] (skipped: backend " + Device.activeBackend()
            + " has no coop kernel)");
        return false;
    }

    /** prefill-routes 2.1.2 — under `packed`, the formats without a native
     *  batch kernel batch through the coop f16 GEMM, and match serial. */
    @Test
    public void coopRouteBatchesTheFormatsWithoutANativeKernel() {
        if (!LinearKernelRouteTest.coopHereOrSay()) { return; }
        int32[] tys #= heap int32[4];
        tys[0] = Quant.GG_Q8_0;
        tys[1] = Quant.GG_Q2_K;
        tys[2] = Quant.GG_Q3_K;
        tys[3] = Quant.GG_Q5_K;
        String[] fx #= heap String[4];
        fx[0] = "q8_0.bin";
        fx[1] = "q2_k.bin";
        fx[2] = "q3_k.bin";
        fx[3] = "q5_k.bin";
        String[] nm #= heap String[4];
        nm[0] = "q8_0";
        nm[1] = "q2_k";
        nm[2] = "q3_k";
        nm[3] = "q5_k";
        Linear.setDeqPrefill(false);
        int32 f = 0;
        while (f < 4) {
            Linear lin #= LinearKernelRouteTest.tiled(tys[f], fx[f]);
            String why = lin.batchRefusal(128L);
            if (why != null) {
                Assert.fail(nm[f] + " refused at 128 rows: " + why);
            }
            Linear.resetRouteSaid();
            PrefillTap cap = heap PrefillTap();
            Diag.register(cap);
            LinearKernelRouteTest.checkBatched(lin, 128, 0.01, nm[f]);
            Diag.register(null);
            if (!cap.saw("batch-route", "coop " + nm[f])) {
                Assert.fail(nm[f] + ": expected the coop route, saw "
                    + cap.namesOf("batch-route"));
            }
            f = f + 1;
        }
        return;
    }

    /** prefill-routes 2.1.3 — Q4_K and Q6_K keep their native batch
     *  routes; the coop GEMM is not chosen where a native kernel exists. */
    @Test
    public void nativeBatchKernelsStillWinOverTheCoopRoute() {
        if (!LinearKernelRouteTest.coopHereOrSay()) { return; }
        if (Linear.backendIsVulkan()) {
            System.stdout.println("  (vulkan: the coop GEMM is every"
                + " format's batch route there; nothing to prefer)");
            return;
        }
        int32[] tys #= heap int32[2];
        tys[0] = Quant.GG_Q4_K;
        tys[1] = Quant.GG_Q6_K;
        String[] fx #= heap String[2];
        fx[0] = "q4_k.bin";
        fx[1] = "q6_k.bin";
        String[] nm #= heap String[2];
        nm[0] = "q4_k";
        nm[1] = "q6_k";
        Linear.setDeqPrefill(false);
        int32 f = 0;
        while (f < 2) {
            Linear lin #= LinearKernelRouteTest.tiled(tys[f], fx[f]);
            Assert.isFalse(lin.coopRoutedHere());
            String why = lin.batchRefusal(128L);
            if (why != null) {
                Assert.fail(nm[f] + " refused at 128 rows: " + why);
            }
            Linear.resetRouteSaid();
            PrefillTap cap = heap PrefillTap();
            Diag.register(cap);
            LinearKernelRouteTest.checkBatched(lin, 128, 0.01, nm[f]);
            Diag.register(null);
            if (cap.sawStarting("batch-route", "coop")) {
                Assert.fail(nm[f] + ": took the coop route: "
                    + cap.namesOf("batch-route"));
            }
            if (cap.countOf("batch-route") == 0) {
                Assert.fail(nm[f] + ": no batch route announced");
            }
            f = f + 1;
        }
        return;
    }

    /** prefill-routes 2.2.3 — under `int8`, a 72-row tail still takes the
     *  Mw8 deq GEMM: rows pad to the 128 tile, and pad rows never reach
     *  the caller. */
    @Test
    public void int8TailChunkIsPaddedOntoTheMw8Route() {
        // See EngineTest.int8PrefillWeightsStillSelectTheMw8Routes:
        // kernelAvailable is true on cpu and the ROUTE still is not,
        // so the guard has to ask the routing predicate.
        if (!Linear.waveMv()
                || !Device.kernelAvailable("q80WmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend()
                + " does not route the Mw8 prefill)");
            return;
        }
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_Q8_0, "q8_0.bin");
        Linear.setDeqPrefill(true);
        String why = lin.batchRefusal(72L);
        if (why != null) {
            Linear.setDeqPrefill(false);
            Assert.fail("q8_0 72-row tail refused: " + why);
        }
        Linear.resetRouteSaid();
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        LinearKernelRouteTest.checkBatched(lin, 72, 0.01, "q8_0 tail");
        Diag.register(null);
        Linear.setDeqPrefill(false);
        if (!cap.sawContaining("batch-route", "q8_0 deqMw8")) {
            Assert.fail("q8_0 tail: expected the Mw8 deq route, saw "
                + cap.namesOf("batch-route"));
        }
        return;
    }

    /**
     * prefill-routes 6.1.1 — the multi-wave PACKED Q4_K GEMM
     * (q4kWmmaMwKernel, the `q4 mw` route) is BIT-FOR-BIT identical to the
     * int8-deq multi-wave kernel (q4kWmmaDeqMw8Kernel, the `q4 deqMw8`
     * route) over the same weight and the same staged activation.
     *
     * Why deq-Mw8 and not the single-wave `q4 plain` kernel: the two
     * multi-wave kernels share the EXACT arithmetic — the same pre-folded
     * cf/cg (d*sc, -dmin*mn), the same rg (xs*ps), the same
     * `scaledAccumInto2S` register fold and accumulation order — and
     * differ ONLY in where the widened Q4_K nibbles come from (this
     * kernel widens them inline into LDS; deq-Mw8 reads them from the
     * pre-dequantized device copy). The widened int8 values are identical,
     * so the outputs must be EXACTLY equal, which makes this a direct
     * bit-gate on the inline widen — the only thing 6.2.1 changed. The
     * single-wave `q4 plain` kernel, by contrast, folds the scales in a
     * different f32 order (integer sc*mc cast to float, dmin subtracted
     * separately), so it is only tolerance-equal to either multi-wave
     * kernel, not bit-identical — see nativeBatchKernelsStillWinOverThe-
     * CoopRoute, which compares q4_k against serial with a tolerance.
     *
     * Device-gated; skipped where either kernel is unavailable or the
     * packed WMMA route is not taken (vulkan).
     */
    @Test
    public void multiWavePackedQ4kAgreesWithDeqMw8() {
        if (!Device.kernelAvailable("q4kWmmaMwKernel")
                || !Device.kernelAvailable("q4kWmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend()
                + " has no multi-wave Q4_K kernel pair)");
            return;
        }
        if (Linear.backendIsVulkan() || !Linear.waveMv()) {
            // Vulkan does not take the packed WMMA route, and neither
            // does cpu — where kernelAvailable says yes (every kernel
            // compiles portably there) but the route falls to
            // deqMw8Part. Ask waveMv, which is what the routing
            // actually consults.
            System.stdout.println("  [device-skip] (skipped: the packed WMMA route is"
                + " not taken on " + Device.activeBackend() + ")");
            return;
        }
        int32 rows = 256;
        int64 ci = (int64) LinearKernelRouteTest.CI;
        int64 co = (int64) LinearKernelRouteTest.CO;
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_Q4_K, "q4_k.bin");
        Linear.setQ4Epi(false);

        Tensor<float32> x #= LinearKernelRouteTest.ramp((int64) rows * ci, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * co);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * co);
        QuantKernel.setRoutingEnabled(true);

        // Reference: the int8-deq multi-wave kernel (q4 deqMw8 / Part).
        Linear.setQ4MwPacked(false);
        Linear.setDeqPrefill(true);
        Linear.stageBatch(x, 0L, rows, (int32) ci, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap refTap = heap PrefillTap();
        Diag.register(refTap);
        lin.matmulInto(rows, want, 0L);
        Diag.register(null);
        Linear.setDeqPrefill(false);
        if (!refTap.sawContaining("batch-route", "q4 deqMw8")) {
            Assert.fail("reference did not take the q4 deqMw8 route, saw "
                + refTap.namesOf("batch-route"));
        }

        // Under test: the multi-wave PACKED kernel (q4 mw), same weight,
        // same activation staged afresh (the q8_K pack is deterministic).
        Linear.setQ4MwPacked(true);
        Linear.stageBatch(x, 0L, rows, (int32) ci, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap mwTap = heap PrefillTap();
        Diag.register(mwTap);
        lin.matmulInto(rows, got, 0L);
        Diag.register(null);
        Linear.setQ4MwPacked(false);
        if (!mwTap.saw("batch-route", "q4 mw")) {
            Assert.fail("the multi-wave packed route was not taken, saw "
                + mwTap.namesOf("batch-route"));
        }

        LinearKernelRouteTest.assertLive(want, (int64) rows * co, "q4 deqMw8");
        LinearKernelRouteTest.assertLive(got, (int64) rows * co, "q4 mw");
        // The two kernels no longer share a summation order: the int8-deq
        // route folds each sub-block scale as an integer and converts once
        // per 256-k block, while the packed route still scales in float per
        // sub-block. They agree to float rounding, not to the bit.
        int64 i = 0;
        float32 worst = 0.0f;
        while (i < (int64) rows * co) {
            float32 a = want.flatGet(i);
            float32 b = got.flatGet(i);
            float32 d = a - b;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 s = a;
            if (s < 0.0f) { s = 0.0f - s; }
            if (s < 1.0f) { s = 1.0f; }
            float32 rel = d / s;
            if (rel > worst) { worst = rel; }
            if (rel > 0.00001f) {
                Assert.fail("element " + i + ": packed multi-wave " + b
                    + " vs int8-deq multi-wave " + a
                    + " - the two routes must agree to float rounding");
            }
            i = i + 1;
        }
        System.stdout.println("   packed vs int8-deq max rel diff " + worst);
        return;
    }

    /** 6.1.3: a partitioned launch fills whole rounds of the device —
     *  the slice is manifest residentGroupsPerCu x multiprocessorCount
     *  when the profile is readable, the measured 32 otherwise, and an
     *  explicit override wins over both. */
    @Test
    public void partitionSliceFollowsResidentCapacity() {
        WmmaKernel.setPartWgs(48L);
        int64 forced = WmmaKernel.sliceWgsFor("q4kWmmaMwKernel", 256L);
        WmmaKernel.resetPartWgs();
        if (forced != 48L) { Assert.fail("override ignored"); }
        int64 mw = WmmaKernel.sliceWgsFor("q4kWmmaMwKernel", 256L);
        int64 deq = WmmaKernel.sliceWgsFor("q4kWmmaDeqMw8Kernel", 256L);
        int64 mps = (int64) Device.multiprocessorCount();
        int64 rMw = WmmaKernel.residentGroupsPerMp("q4kWmmaMwKernel", 256L);
        int64 rDeq = WmmaKernel.residentGroupsPerMp("q4kWmmaDeqMw8Kernel", 256L);
        System.stdout.println("   slice mw=" + mw + " deq=" + deq
            + " mps=" + mps + " resident mw=" + rMw + " deq=" + rDeq);
        if (mps <= 0L) {
            if (mw != 32L || deq != 32L) { Assert.fail("no profile: slice must be 32"); }
            return;
        }
        if (mw != 3L * mps) { Assert.fail("mw slice is not three per multiprocessor"); }
        if (deq != 3L * mps) { Assert.fail("deq slice is not three per multiprocessor"); }
        if (mw != deq) { Assert.fail("the measured width does not vary by kernel"); }
        boolean gfx1151 = mps == 20L && Device.waveSize() == 32
            && Device.simdsPerMultiprocessor() == 8;
        if (gfx1151 && mw != 60L) {
            Assert.fail("gfx1151: the measured optimum is 60 for every format");
        }
        return;
    }

    /** 6.1.2 + 6.1.3: the launch block is eight device waves, and a
     *  submission with the buffers bound in parameter order is accepted by
     *  the seam with the manifest's access sets and the same geometry. */
    @Test
    public void packedMwSubmissionMatchesManifest() {
        int32 blk = WmmaKernel.mwLaunchBlock();
        int32 wave = Device.waveSize();
        if (wave > 0 && blk != 8 * wave) { Assert.fail("block is not eight waves"); }
        if (wave <= 0 && blk != 256) { Assert.fail("no device: block must be 256"); }
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) 16384);
        KernelBuffer<int8> packed #= heap KernelBuffer<int8>((uint64) 18432);
        KernelBuffer<int32> packedW #= heap KernelBuffer<int32>((uint64) 4608);
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>((uint64) 40960);
        KernelResourceDescriptor d #= WmmaKernel.mwSubmit(y, packed, packedW, xp, 4, blk);
        if (d.gridX != 4 || d.blockX != blk) { Assert.fail("descriptor geometry"); }
        System.stdout.println("   block=" + blk + " grid=" + d.gridX + " lds=" + d.ldsBytes + " waves=" + d.waveCount);
        return;
    }

    /** 6.2.3 gate: the batched Q6_K int8-deq 8-wave route agrees with its
     *  4-wave sibling (same widen, same epilogue verb) on a 256-row GEMM
     *  bit for bit (int8 MMA is exact and the fold order is shared); the
     *  max relative difference is printed for the record. */
    @Test
    public void multiWaveQ6kDeqMw8AgreesWithDeqMw4() {
        if (!Device.kernelAvailable("q6kWmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: no q6kWmmaDeqMw8Kernel on "
                + Device.activeBackend() + ")");
            return;
        }
        int32 rows = 256;
        int64 ci = (int64) LinearKernelRouteTest.CI;
        int64 co = (int64) LinearKernelRouteTest.CO;
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_Q6_K, "q6_k.bin");
        Tensor<float32> x #= LinearKernelRouteTest.ramp((int64) rows * ci, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L, (int64) rows * co);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, (int64) rows * co);
        QuantKernel.setRoutingEnabled(true);
        Linear.setDeqPrefill(true);

        Linear.setQ6Mw8(false);
        Linear.setQ6Mw4(true);
        Linear.stageBatch(x, 0L, rows, (int32) ci, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap refTap = heap PrefillTap();
        Diag.register(refTap);
        lin.matmulInto(rows, want, 0L);
        Diag.register(null);
        if (!refTap.sawContaining("batch-route", "q6 deqMw4")) {
            Assert.fail("reference did not take the q6 deqMw4 route, saw "
                + refTap.namesOf("batch-route"));
        }

        Linear.setQ6Mw4(true);
        Linear.setQ6Mw8(true);
        Linear.stageBatch(x, 0L, rows, (int32) ci, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap gotTap = heap PrefillTap();
        Diag.register(gotTap);
        lin.matmulInto(rows, got, 0L);
        Diag.register(null);
        Linear.setDeqPrefill(false);
        if (!gotTap.sawContaining("batch-route", "q6 deqMw8")) {
            Assert.fail("did not take the q6 deqMw8 route, saw "
                + gotTap.namesOf("batch-route"));
        }
        LinearKernelRouteTest.assertLive(want, (int64) rows * co, "deqMw4");
        LinearKernelRouteTest.assertLive(got, (int64) rows * co, "deqMw8");
        float32 worst = 0.0f;
        int64 o = 0;
        while (o < (int64) rows * co) {
            float32 a = got.flatGet(o);
            float32 w = want.flatGet(o);
            float32 d = a - w;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 s = w < 0.0f ? 0.0f - w : w;
            if (s < 1.0f) { s = 1.0f; }
            float32 r = d / s;
            if (r > worst) { worst = r; }
            if (r > 0.00001f) {
                Assert.fail("element " + o + ": q6 deqMw8 " + a
                    + " vs deqMw4 " + w);
            }
            o = o + 1;
        }
        System.stdout.println("   q6 deqMw8 vs deqMw4 max rel diff " + worst);
        return;
    }

    /** A fingerprint of one format's batched deq route: an order-sensitive
     *  fold of the output bits plus samples from both ends, so a re-tiling
     *  that permutes stores is caught as surely as one that changes values.
     *  Printed, not asserted — the gate is a diff of two runs. */
    static void deqMw8Fingerprint(int32 ty, String fixture, String tag) {
        int32 rows = 256;
        int64 ci = (int64) LinearKernelRouteTest.CI;
        int64 co = (int64) LinearKernelRouteTest.CO;
        Linear lin #= LinearKernelRouteTest.tiled(ty, fixture);
        Tensor<float32> x #= LinearKernelRouteTest.ramp((int64) rows * ci, 0L);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, (int64) rows * co);
        QuantKernel.setRoutingEnabled(true);
        Linear.setDeqPrefill(true);
        Linear.stageBatch(x, 0L, rows, (int32) ci, Linear.nextStageTag());
        Linear.resetRouteSaid();
        PrefillTap tap = heap PrefillTap();
        Diag.register(tap);
        lin.matmulInto(rows, got, 0L);
        Diag.register(null);
        Linear.setDeqPrefill(false);
        String route #= tap.namesOf("batch-route");
        LinearKernelRouteTest.assertLive(got, (int64) rows * co, tag);
        int64 n = (int64) rows * co;
        int64 h = 0L;
        int64 neg = 0L;
        int64 o = 0;
        while (o < n) {
            int32 bits = Cajeta.f32ToBits(got.flatGet(o));
            if (bits < 0) { neg = neg + 1L; }
            h = h + ((int64) (bits & 2147483647)) * (o + 1L);
            o = o + 1;
        }
        System.stdout.println("   " + tag + " route=" + route
            + " fold=" + h + " neg=" + neg
            + " v0=" + got.flatGet(0L)
            + " v1=" + got.flatGet(1L)
            + " vmid=" + got.flatGet(n / 2L)
            + " vlast=" + got.flatGet(n - 1L));
        return;
    }

    /** 6.2.4: the formats whose 8-wave deq GEMM has no sibling kernel to
     *  compare against — the fingerprint IS the reference. */
    @Test
    public void deqMw8FingerprintsAcrossFormats() {
        if (!Device.kernelAvailable("q2kWmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend() + " has no deq Mw8 kernels)");
            return;
        }
        LinearKernelRouteTest.deqMw8Fingerprint(Quant.GG_Q8_0, "q8_0.bin", "q8_0");
        LinearKernelRouteTest.deqMw8Fingerprint(Quant.GG_Q2_K, "q2_k.bin", "q2_k");
        LinearKernelRouteTest.deqMw8Fingerprint(Quant.GG_Q3_K, "q3_k.bin", "q3_k");
        LinearKernelRouteTest.deqMw8Fingerprint(Quant.GG_Q5_K, "q5_k.bin", "q5_k");
        LinearKernelRouteTest.deqMw8Fingerprint(Quant.GG_Q6_K, "q6_k.bin", "q6_k");
        LinearKernelRouteTest.deqMw8Fingerprint(Quant.GG_Q4_K, "q4_k.bin", "q4_k");
        return;
    }

    /** 6.2.5: the prefill-weight policy. "auto" is per FORMAT — the
     *  widened int8 GEMM on every k-quant but Q2_K, which keeps the packed
     *  cooperative GEMM — and the explicit modes still answer globally
     *  for every format. */
    @Test
    public void autoPrefillWeightsPolicyIsPerFormat() {
        Linear.setDeqAuto(true);
        if (!Linear.deqFor(Quant.GG_Q4_K)) { Assert.fail("auto: q4_k wants int8"); }
        if (!Linear.deqFor(Quant.GG_Q5_K)) { Assert.fail("auto: q5_k wants int8"); }
        if (!Linear.deqFor(Quant.GG_Q6_K)) { Assert.fail("auto: q6_k wants int8"); }
        if (!Linear.deqFor(Quant.GG_Q3_K)) { Assert.fail("auto: q3_k wants int8"); }
        if (Linear.deqFor(Quant.GG_Q2_K)) { Assert.fail("auto: q2_k wants packed"); }
        if (!Linear.deqFor(Quant.GG_Q8_0)) { Assert.fail("auto: q8_0 wants int8"); }
        Linear.setDeqAuto(false);
        Linear.setDeqPrefill(true);
        if (!Linear.deqFor(Quant.GG_Q2_K)) { Assert.fail("int8 mode is global"); }
        if (!Linear.deqFor(Quant.GG_Q8_0)) { Assert.fail("int8 mode is global"); }
        Linear.setDeqPrefill(false);
        if (Linear.deqFor(Quant.GG_Q4_K)) { Assert.fail("packed mode is global"); }
        if (Linear.deqFor(Quant.GG_Q6_K)) { Assert.fail("packed mode is global"); }
        System.stdout.println("   auto/int8/packed policies agree per format");
        return;
    }

    static final String M8B =
        "/home/julian/models/Meta-Llama-3.1-8B-Instruct-GGUF/"
        + "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf";

    static #String greedyOf(String model, int32 chunk, String prompt,
            int32 maxNew) {
        EngineOptions o #= heap EngineOptions(model);
        o.ctx = 1024;
        o.maxSeqs = 1;
        o.chunk = chunk;
        LlmEngine e #= LlmEngine.load(#o);
        SampleParams p #= heap SampleParams(0.0f, 0L);
        int32 id = e.submitText(prompt, #p, maxNew);
        e.runAll(4096);
        String t #= e.textOf(id);
        e.close();
        return #t;
    }

    /** 6.2.6: the prefill micro-batch is a BATCHING choice, not a
     *  numerical one — greedy output must not depend on it. The prompt
     *  spans several batches at 128 and one at 512, which is exactly the
     *  difference the default change makes. */
    @Test
    public void greedyOutputIsIndependentOfPrefillChunk() {
        Path mp #= Path.of(LinearKernelRouteTest.M8B);
        if (!mp.exists()) {
            System.stdout.println("  [device-skip] (skipped: 8B witness not on this box)");
            return;
        }
        String u = "The pipeline stages a tile of activations, folds the "
            + "block scales in the epilogue, and writes one row per lane. ";
        String prompt #= "Summarize the following note. " + u + u + u + u
            + u + u + u + u + u + u + u + u;
        String a #= LinearKernelRouteTest.greedyOf(LinearKernelRouteTest.M8B, 128, prompt, 24);
        String b #= LinearKernelRouteTest.greedyOf(LinearKernelRouteTest.M8B, 512, prompt, 24);
        if (!a.equals(b)) {
            Assert.fail("chunk changed the greedy output:\n  128: " + a
                + "\n  512: " + b);
        }
        System.stdout.println("   greedy output identical at chunk 128 and 512");
        return;
    }

    static int64 timePrefill(LlmEngine e, int32 n) {
        int32[] toks #= heap int32[n];
        int32 i = 0;
        while (i < n) { toks[i] = 1000 + i * 7; i = i + 1; }
        SampleParams p #= heap SampleParams(0.0f, 0L);
        int64 t0 = Clock.nanoTime();
        int32 id = e.submitTokens(toks, n, 1, #p);
        e.runAll(8192);
        return Clock.nanoTime() - t0;
    }

    /** 6.2.7: the partition width is DISCOVERED on this machine, not assumed.
     *  The derived rule (three slices per multiprocessor) is only what one
     *  part preferred; this times the candidates on the real prefill and
     *  keeps the winner, so a different device reaches its own answer. */
    @Test
    public void tunesThePartitionWidthOnThisDevice() {
        // THE BACKEND GATE, not just the witness. This tunes a DEVICE
        // launch width by timing sixteen 512-token prefills; on the cpu
        // backend that is sixteen CPU prefills of an 8B model and the
        // suite stops looking like it is running at all. Measured
        // 2026-09-14 during 5.1.1: no output for eight minutes, which
        // is how a missing guard presents.
        if (!Linear.waveMv()) {
            System.stdout.println("  [device-skip] (skipped: no device launch width to "
                + "tune on " + Device.activeBackend() + ")");
            return;
        }
        Path mp #= Path.of(LinearKernelRouteTest.M8B);
        if (!mp.exists()) {
            System.stdout.println("  [device-skip] (skipped: 8B witness not on this box)");
            return;
        }
        String dir = "tmp/u3/tune";
        EngineOptions o #= heap EngineOptions(LinearKernelRouteTest.M8B);
        o.ctx = 1024;
        o.maxSeqs = 1;
        o.chunk = 512;
        LlmEngine e #= LlmEngine.load(#o);

        int32[] cand #= heap int32[5];
        cand[0] = 40; cand[1] = 50; cand[2] = 60; cand[3] = 72; cand[4] = 80;
        // One throwaway prefill: the first candidate would otherwise pay every
        // first-touch cost in the engine and lose on that alone.
        LinearKernelRouteTest.timePrefill(e, 512);

        // One sample per candidate reads as a 60%% spread with no curve on a
        // busy box. Take the MIN of several, and alternate the direction of
        // travel each pass so a drifting machine cannot favour whichever end
        // it visited first.
        int64[] bestT #= heap int64[5];
        int32 pass = 0;
        while (pass < 3) {
            int32 k = 0;
            while (k < 5) {
                int32 idx = k;
                if (pass % 2 == 1) { idx = 4 - k; }
                WmmaKernel.setPartWgs((int64) cand[idx]);
                int64 t = LinearKernelRouteTest.timePrefill(e, 512);
                if (bestT[idx] == 0L || t < bestT[idx]) { bestT[idx] = t; }
                k = k + 1;
            }
            pass = pass + 1;
        }
        int64 best = 0L;
        int32 bestW = 0;
        int32 i = 0;
        while (i < 5) {
            System.stdout.println("   partWgs=" + cand[i]
                + " best of 3, prefill ms " + (bestT[i] / 1000000L));
            if (bestW == 0 || bestT[i] < best) { best = bestT[i]; bestW = cand[i]; }
            i = i + 1;
        }
        WmmaKernel.resetPartWgs();
        e.close();
        if (bestW <= 0) { Assert.fail("no candidate completed"); }
        Autotune.remember(dir, WmmaKernel.PART_WGS, bestW);
        Optional<int32> back = Autotune.recall(dir, WmmaKernel.PART_WGS);
        if (!back.isPresent()) { Assert.fail("tuned value did not persist"); }
        if (back.get() != bestW) { Assert.fail("tuned value round-tripped wrong"); }
        System.stdout.println("   tuned partWgs=" + bestW + " for "
            + Autotune.deviceKey());
        return;
    }

    static final String M8BQ2 =
        "/home/julian/models/Meta-Llama-3.1-8B-Instruct-GGUF/"
        + "Meta-Llama-3.1-8B-Instruct-Q2_K.gguf";

    /** 6.2.8: a decode fingerprint for Q2_K. The lane mapping of
     *  q2kQ8WaveMatVecKernel is a pure launch-geometry choice, so greedy
     *  output must not move when it changes. Printed, not asserted: the
     *  gate is a diff of two runs across the change. */
    @Test
    public void q2kGreedyDecodeFingerprint() {
        // A DEVICE fingerprint: the thing it pins is the lane mapping of
        // q2kQ8WaveMatVecKernel, which the cpu backend does not take. On
        // cpu it is 24 greedy tokens of an 8B for a number nobody
        // asserts, and it is where the cpu suite appeared to hang during
        // 5.1.1.
        if (!Linear.waveMv()) {
            System.stdout.println("  [device-skip] (skipped: no wave mat-vec to "
                + "fingerprint on " + Device.activeBackend() + ")");
            return;
        }
        Path mp #= Path.of(LinearKernelRouteTest.M8BQ2);
        if (!mp.exists()) {
            System.stdout.println("  [device-skip] (skipped: Q2_K witness not on this box)");
            return;
        }
        String t #= LinearKernelRouteTest.greedyOf(LinearKernelRouteTest.M8BQ2,
            512, "List three properties of a vector processor.", 24);
        System.stdout.println("   q2k-greedy[" + t + "]");
        return;
    }

    /** `tiled` at an arbitrary shape: the int8 deq routes divide `cols`
     *  by 256, and every shipped fixture is a whole multiple, so the
     *  remainder case needs a width the constants cannot express. */
    static #Linear tiledAt(int32 ty, String fixture, int32 ci, int32 co) {
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 be = (int64) Quant.blockElems(ty);
        int64 nBlocks = (int64) co * ((int64) ci / be);
        int8[] fix #= File.readAllBytes(LinearKernelRouteTest.KQ + fixture);
        int64 fixBlocks = (int64) fix.count() / bb;
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        Linear lin = heap Linear(ci, co);
        lin.bindPacked(#raw, ty);
        return #lin;
    }

    static void checkBatchedAt(Linear lin, int32 rows, int32 ci, int32 co,
            float64 tol, String what) {
        int64 ciL = (int64) ci;
        int64 coL = (int64) co;
        Tensor<float32> x #= LinearKernelRouteTest.ramp((int64) rows * ciL, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * coL);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L,
            (int64) rows * coL);
        QuantKernel.setRoutingEnabled(false);
        int64 r = 0;
        while (r < (int64) rows) {
            lin.matvecInto(x, r * ciL, want, r * coL);
            r = r + 1;
        }
        QuantKernel.setRoutingEnabled(true);
        Linear.stageBatch(x, 0L, rows, ci, Linear.nextStageTag());
        lin.matmulInto(rows, got, 0L);
        boolean live = false;
        int64 i = 0;
        while (i < (int64) rows * coL) {
            float32 g = got.flatGet(i);
            float32 w = want.flatGet(i);
            if (g != 0.0f) { live = true; }
            float32 d = g - w;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 m = w;
            if (m < 0.0f) { m = 0.0f - m; }
            if ((float64) d > (float64) m * tol + 0.01) {
                Assert.fail(what + " at " + i + ": batched " + g
                    + " vs serial " + w);
            }
            i = i + 1;
        }
        if (!live) {
            Assert.fail(what + ": every batched output is zero");
        }
        return;
    }

    /** A column count that is NOT a whole 256-element super-block. The
     *  Mw8 deq GEMMs derive `blocksPerRow` as `cols / 256`, which TRUNCATES
     *  — at 384 columns that silently drops the last 128 of every row and
     *  the batched answer is a short dot product. Qwen2.5-VL-72B is the
     *  first checkpoint that reaches it: its ffn_down is 29568 wide, and
     *  29568 = 115 * 256 + 128, so the Q8_0 half of those tensors routed
     *  here and lost a column group per row.
     *
     *  The bar is the per-row serial path on the same weight — whether the
     *  fix is a refusal back to coop or a tail-capable GEMM is an
     *  implementation choice, and this test does not care which. */
    @Test
    public void int8DeqIsExactWhenColumnsAreNotAWholeSuperBlock() {
        if (!Linear.waveMv()) {
            System.stdout.println("  [device-skip] (skipped: no batch GEMM on "
                + Device.activeBackend() + ")");
            return;
        }
        Linear lin #= LinearKernelRouteTest.tiledAt(Quant.GG_Q8_0,
            "q8_0.bin", 384, 128);
        Linear.setDeqPrefill(true);
        Linear.resetRouteSaid();
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        LinearKernelRouteTest.checkBatchedAt(lin, 128, 384, 128, 0.01,
            "q8_0 cols=384");
        Diag.register(null);
        Linear.setDeqPrefill(false);
        // The instrument, not the answer: a green here means nothing
        // unless SOME batched route actually ran on a 384-wide weight.
        // Name the route so a later change that quietly moves it shows
        // up as a diff rather than as a still-passing test.
        System.stdout.println("   cols=384 routes: "
            + cap.namesOf("batch-route"));
        return;
    }

    /** 7.3.2 — a legacy symmetric weight on the int8 Mw8 GEMM must equal
     *  the per-row serial path, and must be SEEN taking that route. Q4_0
     *  widens to [-8,7] and Q5_0 to [-16,15], both exactly, so the only
     *  error is the int8 GEMM's own float epilogue. */
    /** 7.3.1 — the widen, on its own, as an INTEGER identity. Comparing
     *  a routed GEMM against the serial path cannot answer "is the widen
     *  right": the batched path packs its activations to q8_K and the
     *  serial one does not, so every such comparison carries a float
     *  tolerance that a real indexing bug can hide under and that
     *  ordinary rounding can trip. Here both sides are int8 and the bar
     *  is equality. */
    void widenIsExact(int32 ty, String fixture, String name) {
        if (!Device.kernelAvailable("q80WmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: no device widen)");
            return;
        }
        int64 outDim = 32L;
        int64 cols = 512L;
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 bpr = cols / 256L;
        int64 nBlocks = outDim * (cols / 32L);
        int8[] fix #= File.readAllBytes(LinearKernelRouteTest.KQ + fixture);
        int64 fixBlocks = (int64) fix.count() / bb;
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        // Unit 9: the widen kernels read the RESIDENT layout (a row's
        // f16 scales, then its payloads), not the file blocks. Both
        // types here are split, so there is no alias to park.
        int8[] dev #= heap int8[outDim
            * Quant.rowResidentBytes(ty, cols / 32L)];
        Quant.splitInto(ty, raw, 0L, outDim, cols / 32L, dev, 0L);
        KernelBuffer<int8> pk #= heap KernelBuffer<int8>(
            (uint64) dev.count());
        pk.upload(dev);
        KernelBuffer<int8> dq #= heap KernelBuffer<int8>((uint64) (outDim * cols));
        if (ty == Quant.GG_Q5_0) {
            WmmaKernel.q50WidenLaunch(dq, pk, outDim, cols, cols);
        } else {
            WmmaKernel.q40WidenLaunch(dq, pk, outDim, cols, cols);
        }
        KernelStream s = QuantKernel.stream();
        s.sync();
        int8[] got #= heap int8[outDim * cols];
        dq.download(got);
        // The host twin of the same tile-major placement.
        int8[] want #= heap int8[outDim * cols];
        int64 tilesK = bpr * 16L;
        int64 ii = 0;
        while (ii < outDim) {
            int64 sb = 0;
            while (sb < bpr) {
                int64 e = 0;
                while (e < 256L) {
                    int64 blk = e / 32L;
                    int64 we = e % 32L;
                    int64 base = ii * (bpr * (bb * 8L)) + sb * (bb * 8L)
                        + blk * bb;
                    int64 lo = we % 16L;
                    int32 v = 0;
                    if (ty == Quant.GG_Q5_0) {
                        int32 qh = ((int32) raw[base + 2L] & 255)
                            | (((int32) raw[base + 3L] & 255) << 8)
                            | (((int32) raw[base + 4L] & 255) << 16)
                            | (((int32) raw[base + 5L] & 255) << 24);
                        int32 q = (int32) raw[base + 6L + lo] & 255;
                        if (we < 16L) {
                            v = ((q & 15) | (((qh >> (int32) lo) & 1) << 4)) - 16;
                        } else {
                            v = (((q >> 4) & 15)
                                | (((qh >> ((int32) lo + 16)) & 1) << 4)) - 16;
                        }
                    } else {
                        int32 q = (int32) raw[base + 2L + lo] & 255;
                        if (we < 16L) { v = (q & 15) - 8; }
                        else { v = ((q >> 4) & 15) - 8; }
                    }
                    int64 k = sb * 256L + e;
                    want[((ii / 16L) * tilesK + k / 16L) * 256L
                        + (ii % 16L) * 16L + (k % 16L)] = (int8) v;
                    e = e + 1;
                }
                sb = sb + 1;
            }
            ii = ii + 1;
        }
        int64 i = 0;
        int64 bad = 0;
        while (i < outDim * cols) {
            if (got[i] != want[i]) {
                if (bad < 6L) {
                    System.stdout.println("   " + name + " diff at "
                        + i + ": device " + (int32) got[i]
                        + " host " + (int32) want[i]);
                }
                bad = bad + 1;
            }
            i = i + 1;
        }
        if (bad != 0) {
            Assert.fail(name + " widen: " + bad + " of " + (outDim * cols)
                + " bytes differ");
        }
        System.stdout.println("   " + name + " widen exact over "
            + (outDim * cols) + " bytes");
        return;
    }

    @Test
    public void legacyWidensAreExact() {
        this.widenIsExact(Quant.GG_Q5_0, "q5_0.bin", "q5_0");
        this.widenIsExact(Quant.GG_Q4_0, "q4_0.bin", "q4_0");
        return;
    }

    /** The deviation the batched route shows against per-row serial,
     *  reported rather than asserted. The serial path multiplies FULL
     *  PRECISION activations; the batched one packs them to q8_K first,
     *  so a nonzero figure here is expected and only its SIZE separates
     *  activation rounding from an indexing bug. */
    void symDeqSpread(int32 ty, String fixture, String name) {
        if (!Device.kernelAvailable("q80WmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: no Mw8 deq kernel)");
            return;
        }
        int64 ci = (int64) LinearKernelRouteTest.CI;
        int64 co = (int64) LinearKernelRouteTest.CO;
        Linear lin #= LinearKernelRouteTest.tiled(ty, fixture);
        Tensor<float32> x #= LinearKernelRouteTest.ramp(128L * ci, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L, 128L * co);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, 128L * co);
        QuantKernel.setRoutingEnabled(false);
        int64 r = 0;
        while (r < 128L) {
            lin.matvecInto(x, r * ci, want, r * co);
            r = r + 1;
        }
        QuantKernel.setRoutingEnabled(true);
        Linear.setDeqPrefill(true);
        Linear.resetRouteSaid();
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        Linear.stageBatch(x, 0L, 128, (int32) ci, Linear.nextStageTag());
        lin.matmulInto(128, got, 0L);
        Diag.register(null);
        Linear.setDeqPrefill(false);
        float32 worst = 0.0f;
        float32 mag = 0.0f;
        int64 i = 0;
        while (i < 128L * co) {
            float32 g = got.flatGet(i);
            float32 w = want.flatGet(i);
            float32 d = g - w;
            if (d < 0.0f) { d = 0.0f - d; }
            if (d > worst) { worst = d; }
            float32 m = w;
            if (m < 0.0f) { m = 0.0f - m; }
            if (m > mag) { mag = m; }
            i = i + 1;
        }
        System.stdout.println("   " + name + " worstAbs=" + worst
            + " maxWant=" + mag + " routes=" + cap.namesOf("batch-route"));
        if (!cap.sawContaining("batch-route", name + " deqMw8")) {
            Assert.fail(name + ": expected the Mw8 deq route, saw "
                + cap.namesOf("batch-route"));
        }
        // The bar is relative to the tensor's RANGE, not to the element.
        // A per-element relative bar fails wherever the dot product
        // cancels to near zero, which is a property of the activation,
        // not of the kernel: measured 2026-09-13, all three formats sit
        // at 0.2-0.3% of range while q4_0's outputs are 26x larger than
        // q8_0's, so only q4_0 tripped an element-relative bar.
        if ((float64) worst > (float64) mag * 0.01) {
            Assert.fail(name + ": worst " + worst + " exceeds 1% of range "
                + mag);
        }
        if (mag == 0.0f) { Assert.fail(name + ": serial output is all zero"); }
        return;
    }

    @Test
    public void legacyFormatsTakeTheSymmetricDeqRoute() {
        this.symDeqSpread(Quant.GG_Q8_0, "q8_0.bin", "q8_0");
        this.symDeqSpread(Quant.GG_Q5_0, "q5_0.bin", "q5_0");
        this.symDeqSpread(Quant.GG_Q4_0, "q4_0.bin", "q4_0");
        return;
    }



    /** 7.4.1 — the remainder FAST PATH. 7.2 made a column count with a
     *  remainder correct by REFUSING it back to the coop GEMM; the
     *  padded widen and the row-aware activation pack must now keep it
     *  on the int8 deq route and still agree with the per-row serial
     *  path. cols=384 = 256 + 128 is the 72B's ffn_down remainder in
     *  miniature. */
    void padRemainderRoute(int32 ty, String fixture, String name) {
        if (!Device.kernelAvailable("q80WmmaDeqMw8Kernel")) {
            System.stdout.println("  [device-skip] (skipped: no Mw8 deq kernel)");
            return;
        }
        int64 ci = 384L;
        int64 co = 128L;
        Linear lin #= LinearKernelRouteTest.tiledAt(ty, fixture,
            (int32) ci, (int32) co);
        Tensor<float32> x #= LinearKernelRouteTest.ramp(128L * ci, 0L);
        Tensor<float32> want #= LinearKernelRouteTest.ramp(0L, 128L * co);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, 128L * co);
        QuantKernel.setRoutingEnabled(false);
        int64 r = 0;
        while (r < 128L) {
            lin.matvecInto(x, r * ci, want, r * co);
            r = r + 1;
        }
        QuantKernel.setRoutingEnabled(true);
        Linear.setDeqPrefill(true);
        Linear.resetRouteSaid();
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        Linear.stageBatch(x, 0L, 128, (int32) ci, Linear.nextStageTag());
        lin.matmulInto(128, got, 0L);
        Diag.register(null);
        Linear.setDeqPrefill(false);
        float32 worst = 0.0f;
        float32 mag = 0.0f;
        boolean live = false;
        int64 i = 0;
        while (i < 128L * co) {
            float32 g = got.flatGet(i);
            float32 w = want.flatGet(i);
            if (g != 0.0f) { live = true; }
            float32 d = g - w;
            if (d < 0.0f) { d = 0.0f - d; }
            if (d > worst) { worst = d; }
            float32 m = w;
            if (m < 0.0f) { m = 0.0f - m; }
            if (m > mag) { mag = m; }
            i = i + 1;
        }
        System.stdout.println("   " + name + " cols=384 worstAbs=" + worst
            + " maxWant=" + mag + " routes=" + cap.namesOf("batch-route"));
        if (!cap.sawContaining("batch-route", name + " deqMw8")) {
            Assert.fail(name + " cols=384: expected the Mw8 deq route, saw "
                + cap.namesOf("batch-route"));
        }
        if (!live) { Assert.fail(name + " cols=384: every output is zero"); }
        if (mag == 0.0f) {
            Assert.fail(name + " cols=384: serial output is all zero");
        }
        // The bar is the tensor's RANGE, as in legacyFormatsTakeThe-
        // SymmetricDeqRoute: the batched path packs its activations to
        // q8_K and the serial one does not, so an element-relative bar
        // fails wherever the dot product cancels to near zero.
        if ((float64) worst > (float64) mag * 0.01) {
            Assert.fail(name + " cols=384: worst " + worst
                + " exceeds 1% of range " + mag);
        }
        return;
    }

    @Test
    public void columnRemainderStaysOnTheDeqRoute() {
        this.padRemainderRoute(Quant.GG_Q8_0, "q8_0.bin", "q8_0");
        this.padRemainderRoute(Quant.GG_Q5_0, "q5_0.bin", "q5_0");
        this.padRemainderRoute(Quant.GG_Q4_0, "q4_0.bin", "q4_0");
        return;
    }
}
