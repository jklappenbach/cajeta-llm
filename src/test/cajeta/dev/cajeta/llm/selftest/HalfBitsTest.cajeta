package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.GgufFile;
import cajeta.lang.Cajeta;

/** cajeta-llm 15.2.12.3.9.6: GgufFile.halfBitsToF32Branchless, the branchless half decode of the wave mat-vecs, against GgufFile.halfBitsToF32 over every one of the 65536 half values, bit for bit. */
public class HalfBitsTest {

    public HalfBitsTest() { return; }

    @Test
    public void everyHalfValueDecodesBitForBit() {
        int32 h = 0;
        int32 bad = 0;
        int32 firstBad = 0 - 1;
        while (h < 65536) {
            int32 want = Cajeta.f32ToBits(GgufFile.halfBitsToF32(h));
            int32 got = Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(h));
            if (want != got) { bad = bad + 1; if (firstBad < 0) { firstBad = h; } }
            h = h + 1;
        }
        Assert.equals(0, bad);
        Assert.equals(0 - 1, firstBad);
    }

    /** The control: the same loop against a one-bit-off input must see a mismatch on every value. */
    @Test
    public void theComparisonSeesAOneBitDifference() {
        int32 h = 0;
        int32 same = 0;
        while (h < 65536) {
            int32 want = Cajeta.f32ToBits(GgufFile.halfBitsToF32(h));
            int32 got = Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(h ^ 1));
            if (want == got) { same = same + 1; }
            h = h + 1;
        }
        Assert.equals(0, same);
    }

    @Test
    public void theFourClassesAreCovered() {
        Assert.equals(0, Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(0)));                       // +0
        int32 negZero = 0 - 2147483647;
        negZero = negZero - 1;
        Assert.equals(negZero, Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(32768)));                      // -0
        Assert.equals(Cajeta.f32ToBits(5.9604645e-8f), Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(1)));   // smallest subnormal
        Assert.equals(Cajeta.f32ToBits(1.0f), Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(15360)));        // 1.0
        Assert.equals(Cajeta.f32ToBits(65504.0f), Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(31743)));    // max normal
        Assert.equals(255 << 23, Cajeta.f32ToBits(GgufFile.halfBitsToF32Branchless(31744)));                     // +inf
    }
}
