package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.EmbedKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.llm.sched.Request;
import dev.cajeta.llm.sched.Scheduler;

/**
 * The pipelined greedy decode (xpu-kernel-adaptor 12.2.11): a greedy
 * request through the scheduler emits the same tokens with step N+1 queued
 * before step N's argmax is read as with the synchronous step, and the
 * run really took the pipeline (CausalLM.pipelinedSteps moved). Both
 * arms: the pipeline fires on the routable fixture where the device
 * decodes the embedding row, and the control with the pipeline off walks
 * the same tokens without it.
 */
public final class PipelinedDecodeTest {

    public PipelinedDecodeTest() { return; }

    static #int32[] run(boolean piped, int32 maxNew, int32[] p, int32 promptLen) {
        CausalLM.setPipelined(piped);
        CausalLM m #= RoutableFixtureTest.mk(1);
        Scheduler s = heap Scheduler(m, 4);
        int32 a = s.submit(p, promptLen, maxNew);
        s.runAll(256);
        Request r = s.request(a);
        Assert.isTrue(r.isDone());
        int32[] out #= heap int32[maxNew];
        int32 i = 0;
        while (i < maxNew) {
            out[i] = r.generatedAt(i);
            i = i + 1;
        }
        CausalLM.setPipelined(true);
        return #out;
    }

    @Test
    public void aPipelinedGreedyRequestEmitsTheSynchronousTokens() {
        CausalLM probe #= RoutableFixtureTest.mk(1);
        if (!RoutableFixtureTest.deviceHere(probe)) {
            RoutableFixtureTest.saySkip();
            return;
        }
        if (!probe.pipelineReady(0)) {
            String be #= Device.activeBackend();
            int32 ty = probe.embeddingPackedType();
            String k #= EmbedKernel.kernelName(ty);
            if (k.count() > 0L && !KernelCap.usable(k)) {
                DeviceSkip.noKernel(k, be);
                return;
            }
            DeviceSkip.tracked("the pipelined decode is not offered on " + be
                + " for this fixture (embedding format " + ty + ")",
                "xpu-kernel-adaptor 12.2.11");
            return;
        }
        int32[] p #= RoutableFixtureTest.promptOf(8, 3);
        int32 maxNew = 12;
        int32[] want #= PipelinedDecodeTest.run(false, maxNew, p, 8);
        int64 before = CausalLM.pipelinedSteps();
        int32[] got #= PipelinedDecodeTest.run(true, maxNew, p, 8);
        int64 queued = CausalLM.pipelinedSteps() - before;
        // Every decode step after the prompt's argmax rides the pipeline:
        // maxNew - 1 consumed tokens, plus the one speculative step past the
        // budget is not queued (the scheduler sees the budget coming).
        if (queued < (int64) (maxNew - 1)) {
            Assert.fail("the pipeline queued " + queued + " steps of " + (maxNew - 1));
        }
        int32 i = 0;
        while (i < maxNew) {
            if (want[i] != got[i]) {
                Assert.fail("pipelined token " + i + " is " + got[i]
                    + " where the synchronous step gave " + want[i]);
            }
            i = i + 1;
        }
        System.stdout.println("  pipelined decode: " + queued + " queued steps, "
            + maxNew + " tokens agree");
    }
}
