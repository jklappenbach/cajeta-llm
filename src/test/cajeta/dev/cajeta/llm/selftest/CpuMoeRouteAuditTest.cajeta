package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.XpuLaunchException;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.bench.Metrics;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.MoeFfn;

/**
 * cajeta xpu-kernel-targets 8.1.4: on the cpu backend an MoE prefill of every expert format runs without a refused
 * launch and agrees with the host, with the expert banks resident so the batched device routes are open.
 */
public class CpuMoeRouteAuditTest {

    static final String DIR = "src/test/fixtures/gguf/";

    public CpuMoeRouteAuditTest() { return; }

    /** Four decode steps on fixed tokens: decode admits the experts, so a later prefill finds them resident. */
    static void decode(CausalLM m) {
        int32 i = 0;
        while (i < 4) { m.decodeStep(7 * i + 2); i = i + 1; }
    }

    /** Why the fixture's second prefill (8 tokens, 4 decode steps, 8 more) fails or disagrees with the host on this
     *  backend; null when it agrees. */
    static #String prefillGap(String fixture) {
        int32[] p = heap int32[8];
        int32 i = 0;
        while (i < 8) { p[i] = 3 * i + 5; i = i + 1; }
        int64 rb0 = ExpertBank.residencyBudget();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        ExpertBank.resetResidency();
        int64 dev0 = MoeFfn.batchDevRoutes();
        int64 host0 = MoeFfn.batchHostRoutes();
        int64[] vc #= ValueCheck.mark();
        CausalLM dm #= MoeForwardTest.bindPath(CpuMoeRouteAuditTest.DIR + fixture);
        int32 dTop = 0;
        PrefillTap tap = heap PrefillTap();
        try {
            dm.prefill(p, 8);
            CpuMoeRouteAuditTest.decode(dm);
            Diag.register(tap);
            dTop = dm.prefill(p, 8);
        } catch (XpuLaunchException e) {
            Diag.register(null);
            QuantKernel.setRoutingEnabled(true);
            ExpertBank.setResidencyBudget(rb0);
            ExpertBank.resetResidency();
            return fixture + ": the resident prefill launched a kernel the backend refuses: " + e.getMessage();
        }
        Diag.register(null);
        float32[] dl #= BackendParityTest.logitsOf(dm);
        String routes #= " (" + tap.namesOf("moe-batch-route") + "; device batch routes "
            + (MoeFfn.batchDevRoutes() - dev0) + ", host " + (MoeFfn.batchHostRoutes() - host0) + ")";
        System.stdout.println("   " + fixture + routes);
        QuantKernel.setRoutingEnabled(false);
        CausalLM hm #= MoeForwardTest.bindPath(CpuMoeRouteAuditTest.DIR + fixture);
        hm.prefill(p, 8);
        CpuMoeRouteAuditTest.decode(hm);
        int32 hTop = hm.prefill(p, 8);
        float32[] hl #= BackendParityTest.logitsOf(hm);
        QuantKernel.setRoutingEnabled(true);
        ExpertBank.setResidencyBudget(rb0);
        ExpertBank.resetResidency();
        int32 vocab = (int32) hl.count();
        float64 cos = Metrics.cosine(hl, dl, vocab);
        float64 kl = Metrics.softmaxKl(hl, dl, vocab);
        if (cos < 0.9999 || kl > 0.001 || hTop != dTop) {
            return fixture + ": the resident prefill disagrees with the host, cos " + cos + " kl " + kl + " top "
                + dTop + " vs " + hTop + routes;
        }
        ValueCheck.credit(vc);
        return null;
    }

    static void audit(String fixture) {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the cpu MoE route audit is the cpu backend's"); return; }
        String gap #= CpuMoeRouteAuditTest.prefillGap(fixture);
        if (gap != null) { Assert.fail(gap); }
    }

    /** Q4_K experts throughout. */
    @Test
    public void q4kExpertsPrefillOnTheCpu() { CpuMoeRouteAuditTest.audit("toy-moe.gguf"); }

    /** Q4_K gate and up over a Q8_0 down, as Qwen1.5-MoE ships. */
    @Test
    public void q80DownExpertsPrefillOnTheCpu() { CpuMoeRouteAuditTest.audit("toy-moe-q8exp.gguf"); }

    /** Q5_K experts throughout, as Qwen3-30B-A3B Q5_K_M ships them. */
    @Test
    public void q5kExpertsPrefillOnTheCpu() { CpuMoeRouteAuditTest.audit("toy-moe-q5kexp.gguf"); }

    /** Q6_K experts throughout. */
    @Test
    public void q6kExpertsPrefillOnTheCpu() { CpuMoeRouteAuditTest.audit("toy-moe-q6kexp.gguf"); }

    /** Q3_K experts throughout. */
    @Test
    public void q3kExpertsPrefillOnTheCpu() { CpuMoeRouteAuditTest.audit("toy-moe-q3kexp.gguf"); }

    /** Q2_K experts throughout. */
    @Test
    public void q2kExpertsPrefillOnTheCpu() { CpuMoeRouteAuditTest.audit("toy-moe-q2kexp.gguf"); }
}
