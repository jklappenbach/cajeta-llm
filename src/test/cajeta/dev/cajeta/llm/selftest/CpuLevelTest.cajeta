package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/** cpu-isa-variants 4.1.1: every cpu kernel resolves to the level this host runs at. */
public class CpuLevelTest {
    public CpuLevelTest() { return; }

    /**
     * A native build registers one copy per kernel at level `host` (100). A portable
     * build registers one per ISA level, and every kernel is built at every level
     * (spec Q3), so each resolves to exactly the host's level, which
     * CAJETA_XPU_CPU_LEVEL may have lowered.
     */
    @Test
    public void everyCpuKernelResolvesToTheHostsLevel() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("ISA levels are the cpu backend's"); return; }
        int32 host = Device.cpuLevel();
        int32 n = Device.registeredKernelCount();
        int32 leveled = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            int32 lvl = Device.cpuKernelLevel(name);
            if (lvl != 100) {
                Assert.isTrue(lvl >= 0);
                Assert.equals((int64) host, (int64) lvl);
                leveled = leveled + 1;
            }
            i = i + 1;
        }
        String forced #= System.env.get("CAJETA_XPU_CPU_LEVEL");
        if (forced != null && leveled > 0) {
            Assert.equals(forced, Device.cpuLevelName(host));
        }
        System.stdout.println("cpu level " + Device.cpuLevelName(host) + ": " + leveled + " leveled kernels of " + n);
        return;
    }
}
