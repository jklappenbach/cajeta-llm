package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.model.KernelCap;

/**
 * cajeta-ml-gpu 32.1.1: the chains this library hands the package's census gate are
 * well formed and carry every rule the old in-tree gate applied: a KernelCap.WRONG_HERE
 * kernel on this backend is tracked, and the bench probes are listed.
 */
public class CensusChainsTest {

    public CensusChainsTest() { return; }

    @Test
    public void everyChainIsDelimitedAndTheWrongHereKernelsAreTracked() {
        String tracked #= Census.trackedChain();
        String unchecked #= Census.uncheckedChain();
        String probes #= Census.probesChain();
        String external #= Census.externalChain();
        Assert.isTrue(tracked.startsWith("|") && tracked.endsWith("|"));
        Assert.isTrue(unchecked.startsWith("|") && unchecked.endsWith("|"));
        Assert.isTrue(probes.startsWith("|") && probes.endsWith("|"));
        Assert.isTrue(external.startsWith("|") && external.endsWith("|"));
        Assert.isTrue(!tracked.contains("||") || tracked.count() == 2L);
        String backend #= Device.activeBackend();
        int32 n = Device.registeredKernelCount();
        int32 wrong = 0;
        int32 probed = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            if (KernelCap.wrongHere(name).count() > 0L) {
                wrong = wrong + 1;
                Assert.isTrue(tracked.contains("|" + backend + ":" + name + "="));
            }
            if (name.equals("refusedBlockKernel")) {
                probed = probed + 1;
                Assert.isTrue(probes.contains("|refusedBlockKernel|"));
            }
            i = i + 1;
        }
        int32 off = Device.offTargetKernelCount();
        int32 j = 0;
        while (j < off) {
            String name #= Device.offTargetKernel(j);
            if (KernelCap.wrongHere(name).count() > 0L) {
                Assert.isTrue(tracked.contains("|" + backend + ":" + name + "="));
            }
            j = j + 1;
        }
        // The forcing kernel is in every build of this suite, so the probe list is never empty.
        Assert.isTrue(probed == 1);
        Assert.isTrue(wrong >= 0);
    }
}
