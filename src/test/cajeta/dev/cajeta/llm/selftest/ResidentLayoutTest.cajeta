package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.Linear;

/**
 * One resident layout for every packed format (codebook-quants spec §10):
 * per row, the block scales padded to a dword and then the row's
 * dword-clean payloads, at the file's row stride.
 */
public class ResidentLayoutTest {

    static final String DIR = "src/test/fixtures/gguf/kquant/";

    public ResidentLayoutTest() { return; }

    static #int32[] supportedTypes() {
        int32[] t #= heap int32[14];
        t[0] = Quant.GG_Q4_0;  t[1] = Quant.GG_Q4_1;  t[2] = Quant.GG_Q5_0;
        t[3] = Quant.GG_Q5_1;  t[4] = Quant.GG_Q8_0;  t[5] = Quant.GG_Q2_K;
        t[6] = Quant.GG_Q3_K;  t[7] = Quant.GG_Q4_K;  t[8] = Quant.GG_Q5_K;
        t[9] = Quant.GG_Q6_K;  t[10] = Quant.GG_IQ4_NL;
        t[11] = Quant.GG_IQ4_XS; t[12] = Quant.GG_MXFP4;
        t[13] = Quant.GG_F16;
        return #t;
    }

    static boolean alignedAsStored(int32 ty) {
        return ty == Quant.GG_F16 || ty == Quant.GG_Q4_1 || ty == Quant.GG_Q5_1
            || ty == Quant.GG_Q2_K || ty == Quant.GG_Q4_K
            || ty == Quant.GG_Q5_K || ty == Quant.GG_IQ4_XS;
    }

    /** Tile the fixture's blocks cyclically to `nBlocks`. */
    static #int8[] tiled(String fixture, int32 ty, int64 nBlocks) {
        int64 bb = (int64) Quant.blockBytes(ty);
        int8[] fix #= File.readAllBytes(ResidentLayoutTest.DIR + fixture);
        int64 fixBlocks = (int64) fix.count() / bb;
        Assert.isTrue(fixBlocks > 0L);
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        return #raw;
    }

    /** Every byte of a Q8_0 row-split image against the file blocks. */
    static void checkRowSplit(int8[] raw, int8[] out, int64 rows,
            int64 bpr, String what) {
        int64 prefix = Quant.rowPrefixBytes(Quant.GG_Q8_0, bpr);
        int64 rowBytes = Quant.rowResidentBytes(Quant.GG_Q8_0, bpr);
        int64 i = 0;
        while (i < rows) {
            int64 rb = i * rowBytes;
            int64 b = 0;
            while (b < bpr) {
                int64 blk = (i * bpr + b) * 34L;
                if (out[rb + b * 2L] != raw[blk]
                        || out[rb + b * 2L + 1L] != raw[blk + 1L]) {
                    Assert.fail(what + ": row " + i + " block " + b
                        + " scale bytes differ");
                }
                int64 j = 0;
                while (j < 32L) {
                    if (out[rb + prefix + b * 32L + j] != raw[blk + 2L + j]) {
                        Assert.fail(what + ": row " + i + " block " + b
                            + " byte " + j + ": " + out[rb + prefix + b * 32L + j]
                            + " vs file " + raw[blk + 2L + j]);
                    }
                    j = j + 1;
                }
                b = b + 1;
            }
            i = i + 1;
        }
        return;
    }

    @Test
    public void theLayoutTableIsAPermutationOfTheBlock() {
        int32[] tys #= ResidentLayoutTest.supportedTypes();
        int32 i = 0;
        while (i < 14) {
            int32 ty = tys[i];
            int32 pb = Quant.payloadBytes(ty);
            int32 sb = Quant.scaleBytes(ty);
            Assert.equals(Quant.blockBytes(ty), pb + sb);
            Assert.equals(0, pb % 4);
            if (ResidentLayoutTest.alignedAsStored(ty)) {
                Assert.equals(0, sb);
            } else if (ty == Quant.GG_MXFP4) {
                Assert.equals(1, sb);
            } else {
                Assert.equals(2, sb);
            }
            // Unit 9: the scale field sits at ONE END of the block —
            // the head for most, the tail for the ternary pair and for
            // Q3_K and Q6_K — so the payload either side of it stays
            // contiguous and the split is a permutation.
            int32 so = Quant.scaleOffset(ty);
            Assert.isTrue(so == 0 || so == Quant.blockBytes(ty) - sb);
            Assert.equals(0L, Quant.rowPrefixBytes(ty, 128L) % 4L);
            Assert.equals(0L, Quant.rowResidentBytes(ty, 128L) % 4L);
            i = i + 1;
        }
        Assert.equals(-1, Quant.payloadBytes(5));
        Assert.equals(-1, Quant.scaleBytes(5));
        // Q8_0: an even block count keeps the file's row stride; an odd
        // one pads the scale prefix by two bytes.
        Assert.equals(256L, Quant.rowPrefixBytes(Quant.GG_Q8_0, 128L));
        Assert.equals(128L * 34L, Quant.rowResidentBytes(Quant.GG_Q8_0, 128L));
        Assert.equals(8L, Quant.rowPrefixBytes(Quant.GG_Q8_0, 3L));
        Assert.equals(104L, Quant.rowResidentBytes(Quant.GG_Q8_0, 3L));
        // An unsplit format's resident row is its file row.
        Assert.equals(128L * 144L, Quant.rowResidentBytes(Quant.GG_Q4_K, 128L));
    }

    @Test
    public void theSplitIsAPermutationOfTheFileBytes() {
        int64 rows = 13L;
        int64 bpr = 317L;
        int8[] raw #= ResidentLayoutTest.tiled("q8_0.bin", Quant.GG_Q8_0,
            rows * bpr);
        int8[] out #= heap int8[rows * Quant.rowResidentBytes(Quant.GG_Q8_0,
            bpr)];
        Quant.splitInto(Quant.GG_Q8_0, raw, 0L, rows, bpr, out, 0L);
        ResidentLayoutTest.checkRowSplit(raw, out, rows, bpr, "host split");
    }

    /** The device split, in two chunks that do not end on a row. */
    @Test
    public void theSplitKernelMatchesTheHostSplit() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        int64 rows = 13L;
        int64 bpr = 317L;
        int64 nBlocks = rows * bpr;
        int8[] raw #= ResidentLayoutTest.tiled("q8_0.bin", Quant.GG_Q8_0,
            nBlocks);
        int64 resBytes = rows * Quant.rowResidentBytes(Quant.GG_Q8_0, bpr);
        KernelBuffer<int8> src #= heap KernelBuffer<int8>(
            (uint64) raw.count());
        src.upload(raw);
        KernelBuffer<int8> out #= heap KernelBuffer<int8>((uint64) resBytes);
        int64 first = 2000L;
        KernelBuffer<int8> s0 #= src.slice((uint64) 0, (uint64) (first * 34L));
        KernelBuffer<int8> s1 #= src.slice((uint64) (first * 34L),
            (uint64) ((nBlocks - first) * 34L));
        QuantKernel.splitLaunch(out, s0, first, 0L, Quant.GG_Q8_0, bpr);
        QuantKernel.splitLaunch(out, s1, nBlocks - first, first,
            Quant.GG_Q8_0, bpr);
        int8[] got #= heap int8[resBytes];
        out.download(got);
        ResidentLayoutTest.checkRowSplit(raw, got, rows, bpr, "device split");
    }

    /** 9.2.6 — the device split against the HOST split, byte for byte,
     *  for a head-scale type and a tail-scale one. Q8_0 above checks the
     *  layout by hand; this checks the two shapes the byte kernel served
     *  worst: an 18-byte block and a 210-byte one. */
    @Test
    public void theSplitKernelMatchesTheHostSplitForIq4nl() {
        ResidentLayoutTest.checkDeviceSplit(Quant.GG_IQ4_NL, "iq4_nl.bin",
            13L, 317L, 2000L);
    }

    /** The tail-scale shape: Q6_K keeps its f16 at the END of the block. */
    @Test
    public void theSplitKernelMatchesTheHostSplitForQ6k() {
        ResidentLayoutTest.checkDeviceSplit(Quant.GG_Q6_K, "q6_k.bin",
            7L, 53L, 200L);
    }

    /** 9.2.7 — a whole tensor is one row-aligned chunk, so its scale
     *  prefix takes the dword kernel, and the bytes still match the host
     *  split. Both shapes: an 18-byte block and a 210-byte one. */
    @Test
    public void theScaleSplitTakesTheDwordKernelOnARowAlignedChunk() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        int64 before = QuantKernel.scaleWordLaunchCount();
        ResidentLayoutTest.checkDeviceSplit(Quant.GG_IQ4_NL, "iq4_nl.bin",
            13L, 317L, 0L);
        ResidentLayoutTest.checkDeviceSplit(Quant.GG_Q6_K, "q6_k.bin",
            7L, 53L, 0L);
        int64 fired = QuantKernel.scaleWordLaunchCount() - before;
        if (fired != 2L) {
            Assert.fail("a row-aligned split took the dword scale kernel "
                + fired + " times, wanted 2");
        }
        return;
    }

    /** And it does NOT fire on a chunk that ends mid-row, because a
     *  prefix dword spans two blocks of the same row. */
    @Test
    public void theScaleSplitKeepsTheBlockKernelOnAChunkThatEndsMidRow() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        int64 before = QuantKernel.scaleWordLaunchCount();
        ResidentLayoutTest.checkDeviceSplit(Quant.GG_IQ4_NL, "iq4_nl.bin",
            13L, 317L, 2000L);
        int64 fired = QuantKernel.scaleWordLaunchCount() - before;
        if (fired != 0L) {
            Assert.fail("a mid-row chunk took the dword scale kernel "
                + fired + " times, wanted 0");
        }
        return;
    }

    static void checkDeviceSplit(int32 ty, String fixture, int64 rows,
            int64 bpr, int64 first) {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 nBlocks = rows * bpr;
        int8[] raw #= ResidentLayoutTest.tiled(fixture, ty, nBlocks);
        int64 resBytes = rows * Quant.rowResidentBytes(ty, bpr);
        int8[] want #= heap int8[resBytes];
        Quant.splitInto(ty, raw, 0L, rows, bpr, want, 0L);
        KernelBuffer<int8> src #= heap KernelBuffer<int8>(
            (uint64) raw.count());
        src.upload(raw);
        KernelBuffer<int8> out #= heap KernelBuffer<int8>((uint64) resBytes);
        if (first <= 0L) {
            QuantKernel.splitLaunch(out, src, nBlocks, 0L, ty, bpr);
        } else {
            KernelBuffer<int8> s0 #= src.slice((uint64) 0,
                (uint64) (first * bb));
            KernelBuffer<int8> s1 #= src.slice((uint64) (first * bb),
                (uint64) ((nBlocks - first) * bb));
            QuantKernel.splitLaunch(out, s0, first, 0L, ty, bpr);
            QuantKernel.splitLaunch(out, s1, nBlocks - first, first, ty, bpr);
        }
        int8[] got #= heap int8[resBytes];
        out.download(got);
        // The prefix is padded to a dword and NOTHING defines those
        // spare bytes — the host array is fresh heap and the device
        // buffer is whatever was there. Compare the two regions the
        // layout actually defines.
        int64 prefix = Quant.rowPrefixBytes(ty, bpr);
        int64 rowBytes = Quant.rowResidentBytes(ty, bpr);
        int64 scaled = bpr * (int64) Quant.scaleBytes(ty);
        int64 bad = 0;
        int64 r = 0;
        while (r < rows) {
            int64 rb = r * rowBytes;
            int64 i = 0;
            while (i < rowBytes) {
                if (i < scaled || i >= prefix) {
                    if (got[rb + i] != want[rb + i]) {
                        if (bad < 4L) {
                            System.stdout.println("   ty=" + ty
                                + " diff at " + (rb + i) + ": device "
                                + (int32) got[rb + i] + " host "
                                + (int32) want[rb + i]);
                        }
                        bad = bad + 1;
                    }
                }
                i = i + 1;
            }
            r = r + 1;
        }
        if (bad != 0) {
            Assert.fail("ty=" + ty + ": " + bad + " defined split bytes "
                + "differ");
        }
        System.stdout.println("   ty=" + ty + " split exact over "
            + resBytes + " bytes");
        return;
    }

    /**
     * A bound Q8_0 weight streams to the device through a bounded
     * staging chunk and lands in the row-split layout: resident bytes are
     * the file's, the coop view is the same buffer, and the bytes on the
     * device are the host split byte for byte.
     */
    @Test
    public void aBoundQ80WeightIsResidentInTheRowSplitLayout() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return; }
        int32 outDim = 64;
        int32 inDim = 4096;
        int64 bpr = (int64) inDim / 32L;
        int64 nBlocks = (int64) outDim * bpr;
        int8[] raw #= ResidentLayoutTest.tiled("q8_0.bin", Quant.GG_Q8_0,
            nBlocks);

        int64 keep = Linear.splitChunkBytes();
        // 700 blocks per chunk: the 8192-block tensor streams in twelve
        // chunks with a ragged last one.
        Linear.setSplitChunkBytes(700L * 34L + 17L);
        int64 chunks0 = Linear.splitChunkCount();
        Linear lin #= heap Linear(inDim, outDim);
        int8[] copy #= heap int8[raw.count()];
        int64 i = 0;
        while (i < (int64) raw.count()) { copy[i] = raw[i]; i = i + 1; }
        lin.bindPacked(#copy, Quant.GG_Q8_0);
        lin.ensureDevice();
        Linear.setSplitChunkBytes(keep);

        Assert.equals(12L, Linear.splitChunkCount() - chunks0);
        Assert.isTrue(Linear.splitStageBytes() >= 700L * 34L);
        Assert.equals(nBlocks * 34L, lin.devWeightBytes());
        lin.ensureCoopW();
        Assert.equals(nBlocks * 34L, lin.devWeightBytes());

        int8[] got #= heap int8[nBlocks * 34L];
        lin.payloadForTest().download(got);
        ResidentLayoutTest.checkRowSplit(raw, got, (int64) outDim, bpr,
            "resident");
    }
}
