package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Linear;

/** cajeta-llm 15.2.16.7: host staging that only host paths read is not held by a device prefill. */
public class HostStageTest {

    public HostStageTest() { return; }

    /** A device-resident prefill leaves its K/V slot without host staging. */
    @Test
    public void aDevicePrefillHoldsNoKvHostStaging() {
        CausalLM m #= RoutableFixtureTest.mk(1);
        if (!RoutableFixtureTest.deviceHere(m)) {
            RoutableFixtureTest.saySkipWhy(m);
            return;
        }
        int32[] p #= RoutableFixtureTest.promptOf(8, 3);
        m.prefill(p, 8);
        Assert.equals((int64) 1, (int64) m.deviceKvSlotsActive());
        Assert.equals(0L, m.deviceKvHostStageBytes());
    }

    /** With the device packing activations, the batch path holds no host pack buffer. */
    @Test
    public void aDevicePackedPrefillHoldsNoHostPack() {
        CausalLM m #= RoutableFixtureTest.mk(1);
        if (!RoutableFixtureTest.gemmHere(m) || !Linear.devicePackOn()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        Linear.resetBatchStageForTest();
        int32[] p #= RoutableFixtureTest.promptOf(8, 3);
        m.prefill(p, 8);
        Assert.equals(0L, Linear.batchHostPackBytes());
    }
}
