package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.io.TuneMode;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.model.ColsSegProbe;
import dev.cajeta.llm.model.KernelCap;
import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.ShapeChoice;

/**
 * cajeta-llm 15.2.12.3.7: whether one fused Cols launch over q|k|v (kind 0) or gate|up
 * (kind 1) beats the separate launches is a verdict of the device: measured on
 * gfx1151, hip gains 1.6% and Vulkan loses 3% from the same kernels. The probe times
 * both arms at the engine's shapes, applies the tie margin, and remembers the answer
 * per device, build and shape.
 */
public class ColsSegProbeTest {

    public ColsSegProbeTest() { return; }

    static boolean here() {
        if (!CensusReachTest.deviceHere()) { return false; }
        String be #= Device.activeBackend();
        if (be.equals("cpu")) {
            DeviceSkip.tracked("the cpu lowering of the fused Cols kernels computes NaN", "cajeta-llm 15.2.12.3.7.1");
            return false;
        }
        if (!KernelCap.usable("q4kQ8WaveMatVecColsSegPlainKernel")) { DeviceSkip.noKernel("q4kQ8WaveMatVecColsSegPlainKernel", be); return false; }
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return false; }
        return true;
    }

    /** FIRES: both arms are timed and checked against each other; the answer is stable. */
    @Test
    public void theProbeTimesBothArmsAndAnswers() {
        if (!ColsSegProbeTest.here()) { return; }
        ColsSegProbe.setTuneDir("");
        TuneMode.setUntimed(false);
        ColsSegProbe.setPays(0, 4, 0);
        int64 p0 = ColsSegProbe.probes();
        boolean a = ColsSegProbe.pays(0, 4, 256L, 64L, 64L, 1024L);
        Assert.equals(p0 + 1L, ColsSegProbe.probes());
        Assert.isTrue(ColsSegProbe.fusedNs() > 0L);
        Assert.isTrue(ColsSegProbe.separateNs() > 0L);
        Assert.isTrue(ColsSegProbe.lastRefused().count() == 0L);
        boolean b = ColsSegProbe.pays(0, 4, 256L, 64L, 64L, 1024L);
        Assert.equals(p0 + 1L, ColsSegProbe.probes());
        Assert.isTrue(a == b);
        // the other kind, two segments
        ColsSegProbe.setPays(1, 3, 0);
        ColsSegProbe.pays(1, 3, 512L, 512L, 0L, 1024L);
        Assert.equals(p0 + 2L, ColsSegProbe.probes());
        ColsSegProbe.setPays(0, 4, 0);
        ColsSegProbe.setPays(1, 3, 0);
    }

    /** The verdict carries the tie margin: fused only when it beats separate by it. */
    @Test
    public void theVerdictCarriesTheTieMargin() {
        int64 m = (int64) ShapeChoice.tiePerMille;
        Assert.isTrue(ColsSegProbe.segPays(900L, 1000L));
        Assert.isTrue(ColsSegProbe.segPays(1000L - m, 1000L));
        Assert.isFalse(ColsSegProbe.segPays(1000L - m + 1L, 1000L));
        Assert.isFalse(ColsSegProbe.segPays(1000L, 1000L));
        Assert.isFalse(ColsSegProbe.segPays(1100L, 1000L));
        Assert.isFalse(ColsSegProbe.segPays(0L, 1000L));
    }

    /** A pin answers without a probe; 0 asks again. */
    @Test
    public void aPinAnswersWithoutProbing() {
        if (!ColsSegProbeTest.here()) { return; }
        ColsSegProbe.setTuneDir("");
        int64 p0 = ColsSegProbe.probes();
        ColsSegProbe.setPays(0, 2, 1);
        Assert.isTrue(ColsSegProbe.pays(0, 2, 256L, 64L, 64L, 1024L));
        ColsSegProbe.setPays(0, 2, 2);
        Assert.isFalse(ColsSegProbe.pays(0, 2, 256L, 64L, 64L, 1024L));
        Assert.equals(p0, ColsSegProbe.probes());
        ColsSegProbe.setPays(0, 2, 0);
    }

    /** The verdict is remembered per device and build in the tune dir. */
    @Test
    public void theVerdictIsRememberedPerDeviceAndBuild() {
        if (!ColsSegProbeTest.here()) { return; }
        Path dir #= Path.of("tmp/colsseg-probe-tune");
        dir.mkdirs();
        ColsSegProbe.setTuneDir("tmp/colsseg-probe-tune");
        ColsSegProbe.setPays(1, 2, 0);
        ColsSegProbe.forgetStored(1, 2, 512L, 512L, 0L, 1024L);
        int64 p0 = ColsSegProbe.probes();
        boolean a = ColsSegProbe.pays(1, 2, 512L, 512L, 0L, 1024L);
        Assert.equals(p0 + 1L, ColsSegProbe.probes());
        ColsSegProbe.setPays(1, 2, 0);
        boolean b = ColsSegProbe.pays(1, 2, 512L, 512L, 0L, 1024L);
        Assert.equals(p0 + 1L, ColsSegProbe.probes());
        Assert.isTrue(a == b);
        ColsSegProbe.setPays(1, 2, 0);
        ColsSegProbe.setBuildIdForTest("other-build");
        ColsSegProbe.pays(1, 2, 512L, 512L, 0L, 1024L);
        ColsSegProbe.setBuildIdForTest("");
        Assert.equals(p0 + 2L, ColsSegProbe.probes());
        ColsSegProbe.setTuneDir("");
        ColsSegProbe.setPays(1, 2, 0);
    }
}
