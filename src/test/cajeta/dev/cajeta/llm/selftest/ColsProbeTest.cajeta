package dev.cajeta.llm.selftest;

import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.model.ColsProbe;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * The column mat-vec probe (xpu-kernel-adaptor 13.1.1 to 13.1.4): whether
 * one pass of the column kernel over a weight serves B decode rows cheaper
 * than B single-row wave mat-vecs is MEASURED on the device, per format,
 * each candidate held to the host mat-vec before its time counts, and the
 * verdict is remembered per device under the kernels' manifest
 * fingerprint. On sm_89 the Q4_K column kernel loses at 8 rows and the
 * Q6_K one wins (2026-10-01), which is why the batched decode was flat
 * there and scaled on gfx1151: the roofline cannot tell, the probe can.
 */
public class ColsProbeTest {

    public ColsProbeTest() { return; }

    static boolean here(int32 ty) {
        if (!CensusReachTest.deviceHere()) { return false; }
        String be #= Device.activeBackend();
        String ck #= ColsProbe.colsKernel(ty);
        String wk #= ColsProbe.waveKernel(ty);
        if (!KernelCap.usable(ck)) { DeviceSkip.noKernel(ck, be); return false; }
        if (!KernelCap.usable(wk)) { DeviceSkip.noKernel(wk, be); return false; }
        if (!KernelCap.usable("q8kPackKernel")) { DeviceSkip.noKernel("q8kPackKernel", be); return false; }
        return true;
    }

    /** FIRES: the probe measures both candidates, checks each against the
     *  host, and answers; the answer is stable across a second ask. */
    @Test
    public void theProbeMeasuresAndChecksBothCandidates() {
        if (!ColsProbeTest.here(Quant.GG_Q4_K)) { return; }
        ColsProbe.setTuneDir("");
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
        int64 p0 = ColsProbe.probes();
        int64 c0 = ColsProbe.checks();
        boolean a = ColsProbe.pays(Quant.GG_Q4_K);
        Assert.equals(p0 + 1L, ColsProbe.probes());
        // Two candidates, each held to the host mat-vec at every row.
        Assert.equals(c0 + 2L, ColsProbe.checks());
        boolean b = ColsProbe.pays(Quant.GG_Q4_K);
        Assert.equals(p0 + 1L, ColsProbe.probes());
        Assert.isTrue(a == b);
        System.stdout.println("  cols probe q4_K: pays=" + a + " cols "
            + ColsProbe.colsNs() + " ns, " + ColsProbe.rows() + " wave launches "
            + ColsProbe.waveNs() + " ns; refused '" + ColsProbe.lastRefused()
            + "' mismatch at " + ColsProbe.mismatchAt() + " want "
            + ColsProbe.mismatchWant() + " got " + ColsProbe.mismatchGot());
        Assert.isTrue(ColsProbe.lastRefused().count() == 0L);
    }

    /** DOES NOT FIRE: a candidate whose output fails the host check is not
     *  selected however fast it was (13.1.2). The seam corrupts the column
     *  kernel's output before the check. */
    @Test
    public void aCandidateThatFailsTheCheckIsNotSelected() {
        if (!ColsProbeTest.here(Quant.GG_Q6_K)) { return; }
        ColsProbe.setTuneDir("");
        ColsProbe.setPays(Quant.GG_Q6_K, 0);
        ColsProbe.setPoisonCols(true);
        boolean a = ColsProbe.pays(Quant.GG_Q6_K);
        ColsProbe.setPoisonCols(false);
        Assert.isFalse(a);
        Assert.isTrue(ColsProbe.lastRefused().count() > 0L);
        ColsProbe.setPays(Quant.GG_Q6_K, 0);
    }

    /** The store: a second process-like ask recalls the verdict without
     *  measuring, and a verdict written against other kernel code is
     *  discarded and measured again (13.1.4). */
    @Test
    public void theVerdictIsRememberedPerDeviceAndBuild() {
        if (!ColsProbeTest.here(Quant.GG_Q4_K)) { return; }
        Path dir #= Path.of("tmp/cols-probe-tune");
        dir.mkdirs();
        ColsProbe.setTuneDir("tmp/cols-probe-tune");
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
        ColsProbe.forgetStored(Quant.GG_Q4_K);
        int64 p0 = ColsProbe.probes();
        boolean a = ColsProbe.pays(Quant.GG_Q4_K);
        Assert.equals(p0 + 1L, ColsProbe.probes());
        // Forget the in-process verdict only: the store must answer.
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
        boolean b = ColsProbe.pays(Quant.GG_Q4_K);
        Assert.equals(p0 + 1L, ColsProbe.probes());
        Assert.isTrue(a == b);
        // Other kernel code: the stored verdict is not trusted.
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
        ColsProbe.setBuildIdForTest("other-build");
        ColsProbe.pays(Quant.GG_Q4_K);
        ColsProbe.setBuildIdForTest("");
        Assert.equals(p0 + 2L, ColsProbe.probes());
        ColsProbe.setTuneDir("");
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
    }

    /** FIRES: the verdict is taken at the WIDTH the engine runs, not at the
     *  batch ceiling. Measured 2026-10-24 on the 4090: at 8 columns the
     *  two-row Q4_K column kernel is a near tie with 8 single rows and the
     *  host-timed probe said no, so a 4-sequence decode ran four single-row
     *  launches per projection (768 a step, 7.75 ms) where one 4-column
     *  launch costs the same as one row (gate 34.8 us against 4 x 36). Each
     *  width is its own verdict, remembered per width. */
    @Test
    public void theVerdictIsTakenAtTheWidthAsked() {
        if (!ColsProbeTest.here(Quant.GG_Q4_K)) { return; }
        ColsProbe.setTuneDir("");
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
        int64 p0 = ColsProbe.probes();
        boolean four = ColsProbe.pays(Quant.GG_Q4_K, 4);
        Assert.equals(4, ColsProbe.lastCols());
        Assert.equals(p0 + 1L, ColsProbe.probes());
        boolean eight = ColsProbe.pays(Quant.GG_Q4_K, 8);
        Assert.equals(8, ColsProbe.lastCols());
        Assert.equals(p0 + 2L, ColsProbe.probes());
        ColsProbe.pays(Quant.GG_Q4_K, 4);
        Assert.equals(p0 + 2L, ColsProbe.probes());
        System.stdout.println("cols-probe q4_K at 4 columns pays=" + four + " ("
            + ColsProbe.colsNs() + " ns cols); at 8 pays=" + eight);
        ColsProbe.setPays(Quant.GG_Q4_K, 0);
    }

    /** FIRES: prewarm measures every width a decode batch can take, so no
     *  token a user waits for pays for a probe (13.2.1). */
    @Test
    public void prewarmMeasuresEveryBatchWidth() {
        if (!ColsProbeTest.here(Quant.GG_Q6_K)) { return; }
        ColsProbe.setTuneDir("");
        ColsProbe.setPays(Quant.GG_Q6_K, 0);
        int64 p0 = ColsProbe.probes();
        ColsProbe.prewarm(Quant.GG_Q6_K);
        Assert.equals(p0 + (int64) (ColsProbe.rows() - 1), ColsProbe.probes());
        ColsProbe.prewarm(Quant.GG_Q6_K);
        Assert.equals(p0 + (int64) (ColsProbe.rows() - 1), ColsProbe.probes());
        ColsProbe.setPays(Quant.GG_Q6_K, 0);
    }
}
