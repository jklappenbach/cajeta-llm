        CoopQuantGemmTest.checkShape(Quant.GG_Q4_K, "q4_k.bin", 64L,
            CoopQuantGemmTest.OUT, CoopQuantGemmTest.COLS);
        CoopQuantGemmTest.expectReached("q4kF16CoopM64Kernel", before);
    }
