package dev.cajeta.llm.selftest;

import cajeta.io.file.File;
import cajeta.error.RecoverableException;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.WmmaKernel;

/**
 * The batched (prefill) coop GEMM, for EVERY quantization the engine
 * supports — not just the Q4_K/Q6_K pair it shipped with.
 *
 * The compute half of that kernel is format-blind: it multiplies f16
 * tiles out of LDS, so a new format is a staging body plus, where ggml's
 * block stride is not a multiple of four, a one-time device repack. That
 * is exactly the shape of bug this suite exists to catch — a scale paired
 * with the wrong sub-block, a nibble taken from the wrong half, a repack
 * that shifts the payload by the wrong number of bytes. All of those land
 * order-100% wrong, which is why a 1% relative bar is enough and a
 * tolerance is not hiding anything.
 *
 * Every arm also asserts the result is NON-ZERO. A kernel that fails to
 * lower does not fail the build — the launch finds nothing registered and
 * the output buffer reads back zeros — and comparing two zeros is how a
 * device suite comes to pass while running no device code at all.
 */
public class CoopQuantGemmTest {

    static final String DIR = "src/test/fixtures/gguf/kquant/";
    static final int64 ROWS = 128L;      // tokens: one BM/BN tile
    static final int64 OUT = 128L;       // output rows: one row tile
    static final int64 COLS = 256L;      // K: one 256-block per row

    public CoopQuantGemmTest() { return; }

    /** True when this backend actually lowers the coop kernels. Guarding
     *  on ONE of them is safe because they share every construct. */
    static boolean coopHere() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) { return false; }
        return Device.kernelAvailable("q4kF16CoopX3Kernel");
    }

    /**
     * Run the coop GEMM for `ty` over weights tiled from that format's
     * fixture blocks, and compare against dequantize-then-multiply on the
     * host.
     */
    static void checkFormat(int32 ty, String fixture) {
        CoopQuantGemmTest.checkFormatAt(ty, fixture,
            CoopQuantGemmTest.COLS);
    }

    /** The dword view the coop GEMM reads: the split payload or the
     *  repacked copy in `padD`, else the file blocks in place. */
    static #KernelBuffer<int32> coopView(int32 ty, KernelBuffer<int8> wD,
            KernelBuffer<int8> padD) {
        if (Quant.splitOn(ty) || QuantKernel.coopNeedsRepack(ty)) {
            return padD.wordView();
        }
        return wD.wordView();
    }

    /**
     * As {@link #checkFormat} but at an explicit width — the legacy
     * 32-element formats also run at cols % 256 != 0 (their compute tile
     * needs only cols % 64 == 0), which is the width class Qwen-72B's
     * ffn_down lives in (29568 % 256 == 128). 1152 has the same residue.
     */
    /**
     * The general shape: `rows` tokens against `out` output rows over `cols`.
     * The Auto router picks a kernel from this shape, so the shape IS the
     * choice of kernel: cols above 8192 is the X1 tile, rows below 128 the
     * M64 tile, an `out` that is not a multiple of 128 the block-128 tile.
     */
    static void checkShape(int32 ty, String fixture, int64 rows, int64 out,
            int64 cols) {
        CoopQuantGemmTest.checkShapeVia(ty, fixture, rows, out, cols, false);
    }

    /** `direct128`: launch the block-128 tile by name instead of the router. */
    static void checkShapeVia(int32 ty, String fixture, int64 rows, int64 out,
            int64 cols, boolean direct128) {
        if (!CoopQuantGemmTest.coopHere()) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend() + " has no coop kernel)");
            return;
        }
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 be = (int64) Quant.blockElems(ty);
        int64 blocksPerRow = cols / be;
        int64 nBlocks = out * blocksPerRow;

        int8[] fix #= File.readAllBytes(CoopQuantGemmTest.DIR + fixture);
        int64 fixBlocks = (int64) fix.count() / bb;
        Assert.isTrue(fixBlocks > 0L);
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }

        // Mixed signs and magnitudes: an all-positive x hides sign
        // handling in the widen, a constant x hides lane misordering.
        float32[] x #= heap float32[rows
            * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.0625f;
            i = i + 1;
        }

        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (nBlocks * bb));
        wD.upload(raw);
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        xfD.upload(x);
        KernelBuffer<float16> xhD #= heap KernelBuffer<float16>(
            (uint64) (rows * cols));
        QuantKernel.f32ToF16LaunchNoSync(xhD, xfD,
            rows * cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>(
            (uint64) (rows * out));
        KernelStream s = QuantKernel.stream();
        s.sync();

        // The same two-step Linear.ensureCoopW performs: repack when the
        // ggml block stride is not dword-addressable, then take the word
        // view the kernel indexes.
        int64 dw = (int64) QuantKernel.coopBlockWords(ty);
        int64 padBytes = nBlocks * dw * 4L;
        if (Quant.splitOn(ty)) {
            padBytes = out
                * Quant.rowResidentBytes(ty, blocksPerRow);
        }
        KernelBuffer<int8> padD #= heap KernelBuffer<int8>((uint64) padBytes);
        if (Quant.splitOn(ty)) {
            QuantKernel.splitLaunch(padD, wD, nBlocks, 0L, ty, blocksPerRow);
        } else if (QuantKernel.coopNeedsRepack(ty)) {
            if (ty == Quant.GG_Q3_K || ty == Quant.GG_Q6_K) {
                QuantKernel.blockPadLaunch(padD, wD, nBlocks, (int32) bb,
                    (int32) (dw * 4L));
            } else {
                QuantKernel.blockRepack2Launch(padD, wD, nBlocks,
                    (int32) bb, (int32) (dw * 4L));
            }
        }
        KernelBuffer<int32> wW #= CoopQuantGemmTest.coopView(ty, wD, padD);

        if (direct128 && ty == Quant.GG_Q4_K) {
            QuantKernel.q4kF16CoopLaunchNoSync(yD, wW, xhD, rows, out, cols);
        } else if (direct128 && ty == Quant.GG_Q6_K) {
            QuantKernel.q6kF16CoopLaunchNoSync(yD, wW, xhD, rows, out, cols);
        } else {
            QuantKernel.coopBatchLaunchNoSync(ty, yD, wW, xhD,
                rows, out,
                cols);
        }
        s.sync();
        float32[] got #= heap float32[rows
            * out];
        yD.download(got);

        float32[] w #= heap float32[nBlocks * be];
        Quant.dequantize(ty, raw, 0L, nBlocks, w, 0L);

        boolean live = false;
        int64 worstAt = -1L;
        float64 worst = 0.0;
        float32 worstGot = 0.0f;
        float32 worstWant = 0.0f;
        int64 t = 0;
        while (t < rows) {
            int64 o = 0;
            while (o < out) {
                float32 acc = 0.0f;
                int64 k = 0;
                while (k < cols) {
                    acc = acc + w[o * cols + k]
                        * x[t * cols + k];
                    k = k + 1;
                }
                float32 g = got[t * out + o];
                if (g != 0.0f) { live = true; }
                float32 diff = acc - g;
                if (diff < 0.0f) { diff = 0.0f - diff; }
                float32 mag = acc < 0.0f ? 0.0f - acc : acc;
                float64 rel = (float64) diff
                    / ((float64) mag * 0.01 + 0.01);
                if (rel > worst) {
                    worst = rel;
                    worstAt = t * out + o;
                    worstGot = g;
                    worstWant = acc;
                }
                o = o + 1;
            }
            t = t + 1;
        }
        // The f16 staging rounds the weights, so the bar is 1% relative
        // plus an absolute floor — three orders of magnitude above the
        // rounding and three below any indexing slip.
        if (worst > 1.0) {
            Assert.fail("coop GEMM ty=" + ty + " at ["
                + (worstAt / out) + ","
                + (worstAt % out) + "]: kernel "
                + worstGot + " vs host dequant-and-multiply " + worstWant);
        }
        if (!live) {
            Assert.fail("coop GEMM ty=" + ty + ": every output is zero, "
                + "which is what a kernel that never ran produces");
        }
    }

    static void checkFormatAt(int32 ty, String fixture, int64 cols) {
        CoopQuantGemmTest.checkShape(ty, fixture, CoopQuantGemmTest.ROWS,
            CoopQuantGemmTest.OUT, cols);
    }

    /**
     * Unit 6 of the xpu-kernel-adaptor plan: a test that claims to reach a
     * kernel proves it from the runtime's launch census, so a route that
     * quietly picked another variant cannot pass as coverage.
     */
    static void expectReached(String kernel, int64 before) {
        if (!CoopQuantGemmTest.coopHere()) { return; }
        int64 now = Device.kernelLaunchCount(kernel);
        if (now <= before) {
            Assert.fail("the route did not reach " + kernel + " (launch count "
                + before + " -> " + now + ")");
        }
    }

    /** K above 8192 routes to the X1 tile on every format's Auto launcher. */
    static void checkX1(int32 ty, String fixture, String kernel) {
        int64 before = Device.kernelLaunchCount(kernel);
        CoopQuantGemmTest.checkShape(ty, fixture, CoopQuantGemmTest.ROWS,
            CoopQuantGemmTest.OUT, 8448L);
        CoopQuantGemmTest.expectReached(kernel, before);
    }

    /**
     * The BN=256 pair, which the shipped auto route does NOT dispatch:
     * X1/X3 replaced it on 2026-08-26 after it lost 55-70%. It stayed in
     * the tree as a probe arm, and on the Q6 side it had no launch site
     * at all, so it was unreachable, ungated, and — being unbounded —
     * capped at 192 VGPRs and spilling into its own k-loop.
     *
     * `useGlobalB` picks the twin that reads B straight from global
     * instead of staging it through LDS. Both must agree with
     * dequantize-then-multiply on exactly the bar the shipped route
     * meets; a retired kernel that is still compiled and still launchable
     * is still a kernel, and an unchecked one is how a wrong answer waits.
     *
     * ROWS is 256 here, not the suite's 128: these kernels tile tokens by
     * 256 and a 128-token launch computes `nTokTiles = 0`.
     */
    /**
     * 6.4.3's halved token tile, through the AUTO launcher at 192 rows —
     * a multiple of 64 and not of 128, which is the shape an MoE expert
     * batch has and the only one that reaches the N64 kernel. Checks the
     * gate and the kernel together, against dequantize-then-multiply.
     */
    static void checkN64(int32 ty, String fixture) {
        CoopQuantGemmTest.checkTile(ty, fixture, 192L, false);
    }

    static void checkN256(int32 ty, String fixture, boolean useGlobalB) {
        CoopQuantGemmTest.checkTile(ty, fixture, 256L, useGlobalB);
        return;
    }

    static void checkTile(int32 ty, String fixture, int64 rows,
            boolean useGlobalB) {
        if (!CoopQuantGemmTest.coopHere()) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend() + " has no coop kernel)");
            return;
        }
        int64 cols = CoopQuantGemmTest.COLS;
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 be = (int64) Quant.blockElems(ty);
        int64 blocksPerRow = cols / be;
        int64 nBlocks = CoopQuantGemmTest.OUT * blocksPerRow;

        int8[] fix #= File.readAllBytes(CoopQuantGemmTest.DIR + fixture);
        int64 fixBlocks = (int64) fix.count() / bb;
        Assert.isTrue(fixBlocks > 0L);
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }
        float32[] x #= heap float32[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            x[i] = (float32) ((i * 31L + 7L) % 61L - 30L) * 0.0625f;
            i = i + 1;
        }
        KernelBuffer<int8> wD #= heap KernelBuffer<int8>(
            (uint64) (nBlocks * bb));
        wD.upload(raw);
        KernelBuffer<float32> xfD #= heap KernelBuffer<float32>(
            (uint64) (rows * cols));
        xfD.upload(x);
        KernelBuffer<float16> xhD #= heap KernelBuffer<float16>(
            (uint64) (rows * cols));
        QuantKernel.f32ToF16LaunchNoSync(xhD, xfD, rows * cols);
        KernelBuffer<float32> yD #= heap KernelBuffer<float32>(
            (uint64) (rows * CoopQuantGemmTest.OUT));
        KernelStream s = QuantKernel.stream();
        s.sync();

        int64 dw = (int64) QuantKernel.coopBlockWords(ty);
        int64 padBytes = nBlocks * dw * 4L;
        if (Quant.splitOn(ty)) {
            padBytes = CoopQuantGemmTest.OUT
                * Quant.rowResidentBytes(ty, blocksPerRow);
        }
        KernelBuffer<int8> padD #= heap KernelBuffer<int8>((uint64) padBytes);
        if (Quant.splitOn(ty)) {
            QuantKernel.splitLaunch(padD, wD, nBlocks, 0L, ty, blocksPerRow);
        } else if (QuantKernel.coopNeedsRepack(ty)) {
            if (ty == Quant.GG_Q3_K || ty == Quant.GG_Q6_K) {
                QuantKernel.blockPadLaunch(padD, wD, nBlocks, (int32) bb,
                    (int32) (dw * 4L));
            } else {
                QuantKernel.blockRepack2Launch(padD, wD, nBlocks,
                    (int32) bb, (int32) (dw * 4L));
            }
        }
        KernelBuffer<int32> wW #= CoopQuantGemmTest.coopView(ty, wD, padD);

        // The codebook launcher serves the IQ family only; IQ4_NL and
        // Q6_K are `splitOn` too but have their own kernels, so they are
        // matched by TYPE before the layout predicate.
        if (ty == Quant.GG_IQ4_NL) {
            QuantKernel.iq4nlF16CoopAutoLaunchNoSync(yD, wW, xhD, rows,
                CoopQuantGemmTest.OUT, cols);
        } else if (ty == Quant.GG_Q6_K) {
            if (useGlobalB) {
                QuantKernel.q6kF16CoopN256GLaunch(yD, wW, xhD, rows,
                    CoopQuantGemmTest.OUT, cols);
            } else {
                QuantKernel.q6kF16CoopN256Launch(yD, wW, xhD, rows,
                    CoopQuantGemmTest.OUT, cols);
            }
        } else if (Quant.splitOn(ty)) {
            QuantKernel.iqF16CoopAutoLaunchNoSync(ty, yD, wW, xhD, rows,
                CoopQuantGemmTest.OUT, cols);
        } else {
            if (useGlobalB) {
                QuantKernel.q4kF16CoopN256GLaunch(yD, wW, xhD, rows,
                    CoopQuantGemmTest.OUT, cols);
            } else {
                QuantKernel.q4kF16CoopN256Launch(yD, wW, xhD, rows,
                    CoopQuantGemmTest.OUT, cols);
            }
        }
        s.sync();
        float32[] got #= heap float32[rows * CoopQuantGemmTest.OUT];
        yD.download(got);

        float32[] w #= heap float32[nBlocks * be];
        Quant.dequantize(ty, raw, 0L, nBlocks, w, 0L);

        boolean live = false;
        float64 worst = 0.0;
        int64 worstAt = -1L;
        float32 worstGot = 0.0f;
        float32 worstWant = 0.0f;
        int64 t = 0;
        while (t < rows) {
            int64 o = 0;
            while (o < CoopQuantGemmTest.OUT) {
                float32 acc = 0.0f;
                int64 k = 0;
                while (k < cols) {
                    acc = acc + w[o * cols + k] * x[t * cols + k];
                    k = k + 1;
                }
                float32 g = got[t * CoopQuantGemmTest.OUT + o];
                if (g != 0.0f) { live = true; }
                float32 diff = acc - g;
                if (diff < 0.0f) { diff = 0.0f - diff; }
                float32 mag = acc < 0.0f ? 0.0f - acc : acc;
                float64 rel = (float64) diff
                    / ((float64) mag * 0.01 + 0.01);
                if (rel > worst) {
                    worst = rel;
                    worstAt = t * CoopQuantGemmTest.OUT + o;
                    worstGot = g;
                    worstWant = acc;
                }
                o = o + 1;
            }
            t = t + 1;
        }
        String nm = "N256";
        if (useGlobalB) { nm = "N256G"; }
        if (worst > 1.0) {
            Assert.fail("coop " + nm + " ty=" + ty + " at ["
                + (worstAt / CoopQuantGemmTest.OUT) + ","
                + (worstAt % CoopQuantGemmTest.OUT) + "]: kernel "
                + worstGot + " vs host dequant-and-multiply " + worstWant);
        }
        if (!live) {
            Assert.fail("coop " + nm + " ty=" + ty + ": every output is "
                + "zero, which is what a kernel that never ran produces");
        }
        System.stdout.println("   " + nm + " ty=" + ty + " worst rel "
            + worst);
    }

    @Test
    public void coopN256Q6KMatchesHost() {
        CoopQuantGemmTest.checkN256(Quant.GG_Q6_K, "q6_k.bin", false);
    }

    @Test
    public void coopN256GlobalBQ6KMatchesHost() {
        CoopQuantGemmTest.checkN256(Quant.GG_Q6_K, "q6_k.bin", true);
    }

    @Test
    public void coopN256Q4KMatchesHost() {
        CoopQuantGemmTest.checkN256(Quant.GG_Q4_K, "q4_k.bin", false);
    }

    @Test
    public void coopN256GlobalBQ4KMatchesHost() {
        CoopQuantGemmTest.checkN256(Quant.GG_Q4_K, "q4_k.bin", true);
    }

    @Test
    public void coopGemmQ4KMatchesHost() {
        CoopQuantGemmTest.checkFormat(Quant.GG_Q4_K, "q4_k.bin");
    }

    @Test
    public void coopGemmQ6KMatchesHost() {
        CoopQuantGemmTest.checkFormat(Quant.GG_Q6_K, "q6_k.bin");
    }

    /**
     * 7.4.X — the shared int8 widen in ISOLATION. Both Q6_K deq GEMMs
     * (Mw4 and Mw8) read the buffer q6kWiden produces; the coop GEMM
     * decodes the packed weights directly and does not. So a widen that
     * lowers wrong on a backend makes BOTH deq GEMMs wrong while the coop
     * GEMM stays right — exactly the shape of the deqMw4/deqMw8 CPU
     * divergence. This pins the widen against a host oracle over the SAME
     * split bytes, so a mismatch localizes the fault to the widen
     * lowering itself rather than to a downstream reader.
     */
    @Test
    public void q6kWidenMatchesHost() {
        if (!Device.kernelAvailable("q6kWidenKernel")) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend() + " has no q6kWidenKernel)");
            return;
        }
        int32 ty = Quant.GG_Q6_K;
        int64 cols = CoopQuantGemmTest.COLS;
        int64 outDim = CoopQuantGemmTest.OUT;
        int64 bb = (int64) Quant.blockBytes(ty);
        int64 be = (int64) Quant.blockElems(ty);
        int64 bpr = cols / be;
        int64 nBlocks = outDim * bpr;

        int8[] fix #= File.readAllBytes(CoopQuantGemmTest.DIR + "q6_k.bin");
        int64 fixBlocks = (int64) fix.count() / bb;
        Assert.isTrue(fixBlocks > 0L);
        int8[] raw #= heap int8[nBlocks * bb];
        int64 b = 0;
        while (b < nBlocks) {
            int64 src = (b % fixBlocks) * bb;
            int64 dst = b * bb;
            int64 j = 0;
            while (j < bb) { raw[dst + j] = fix[src + j]; j = j + 1; }
            b = b + 1;
        }

        int64 rowRes = Quant.rowResidentBytes(ty, bpr);
        int8[] resH #= heap int8[outDim * rowRes];
        Quant.splitInto(ty, raw, 0L, outDim, bpr, resH, 0L);

        KernelBuffer<int8> packed #= heap KernelBuffer<int8>(
            (uint64) (outDim * rowRes));
        packed.upload(resH);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (outDim * cols));
        WmmaKernel.q6kWidenLaunch(deqDev, packed, outDim, cols);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int8[] deq #= heap int8[outDim * cols];
        deqDev.download(deq, outDim * cols);

        // Host oracle: the exact q6kWidenKernel decode and tile-major
        // placement, over the SAME resH bytes the kernel read.
        int8[] ref #= heap int8[outDim * cols];
        int64 pfx = ((bpr * 2L + 3L) / 4L) * 4L;
        int64 tilesK = bpr * 16L;
        int64 ii = 0;
        while (ii < outDim) {
            int64 rowBase = ii * (pfx + bpr * 208L) + pfx;
            int64 tI = ii / 16L;
            int64 iIn = ii % 16L;
            int64 bl = 0;
            while (bl < bpr) {
                int64 base = rowBase + bl * 208L;
                int64 byteIdx = 0;
                while (byteIdx < 128L) {
                    int32 qlb = (int32) resH[base + byteIdx] & 255;
                    int64 h = byteIdx / 64L;
                    int64 l64 = byteIdx % 64L;
                    int32 qhb = (int32) resH[base + 128L + 32L * h
                        + (l64 % 32L)] & 255;
                    int32 sh = (int32) (2L * (l64 / 32L));
                    int32 vLo = ((qlb & 15) | (((qhb >> sh) & 3) << 4)) - 32;
                    int32 vHi = (((qlb >> 4) & 15)
                        | (((qhb >> (sh + 4)) & 3) << 4)) - 32;
                    int64 kLo = bl * 256L + (128L * h + l64);
                    int64 kHi = kLo + 64L;
                    ref[(tI * tilesK + kLo / 16L) * 256L
                        + iIn * 16L + (kLo % 16L)] = (int8) vLo;
                    ref[(tI * tilesK + kHi / 16L) * 256L
                        + iIn * 16L + (kHi % 16L)] = (int8) vHi;
                    byteIdx = byteIdx + 1L;
                }
                bl = bl + 1L;
            }
            ii = ii + 1L;
        }

        int64 bad = 0L;
        int64 firstAt = -1L;
        int64 i = 0;
        while (i < outDim * cols) {
            if (deq[i] != ref[i]) {
                if (firstAt < 0L) { firstAt = i; }
                bad = bad + 1L;
            }
            i = i + 1L;
        }
        if (bad != 0L) {
            Assert.fail("q6kWiden ty=q6_k: " + bad + " of "
                + (outDim * cols) + " widened bytes differ from host oracle;"
                + " first at " + firstAt + " kernel="
                + (int64) deq[firstAt] + " host=" + (int64) ref[firstAt]);
        }
        System.stdout.println("   q6kWiden matches host oracle on "
            + Device.activeBackend() + " (" + (outDim * cols) + " bytes)");
        return;
    }

    @Test
    public void coopGemmQ5KMatchesHost() {
        CoopQuantGemmTest.checkFormat(Quant.GG_Q5_K, "q5_k.bin");
    }

    @Test
    public void coopGemmQ3KMatchesHost() {
        CoopQuantGemmTest.checkFormat(Quant.GG_Q3_K, "q3_k.bin");
    }

    @Test
    public void coopGemmQ2KMatchesHost() {
        CoopQuantGemmTest.checkFormat(Quant.GG_Q2_K, "q2_k.bin");
    }

    @Test
    public void coopGemmQ80MatchesHost() {
