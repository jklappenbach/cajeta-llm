    // A shape no tile computes whole is REFUSED, never answered in part.
    @Test
    public void theCoopRouterRefusesAnOutputWidthNoTileComputesWhole() {
        if (!CoopQuantGemmTest.coopHere()) {
            System.stdout.println("  [device-skip] (skipped: backend "
                + Device.activeBackend() + " has no coop kernel)");
            return;
        }
        boolean refused = false;
        try {
            CoopQuantGemmTest.checkShape(Quant.GG_Q4_K, "q4_k.bin",
                CoopQuantGemmTest.ROWS, 8200L, CoopQuantGemmTest.COLS);
        } catch (RecoverableException e) {
            refused = true;
        }
        Assert.isTrue(refused);
    }

