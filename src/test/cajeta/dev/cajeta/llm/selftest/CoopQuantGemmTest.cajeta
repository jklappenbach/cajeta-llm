    /**
     * The width predicate, both halves. The k-quants' superblock IS 256
     * elements, so a router that offered them 1152 would hand the staging
     * a fractional superblock — refusal is the correct behaviour and this
     * pins it, while the legacy formats accept exactly down to the
     * compute tile's BK=64.
     */
    @Test
    public void coopWidthGateSplitsByBlockStructure() {
        // legacy: 64 is the floor, 32 is below it
        Assert.isTrue(QuantKernel.coopColsOk(Quant.GG_Q8_0, 1152L));
        Assert.isTrue(QuantKernel.coopColsOk(Quant.GG_Q5_0, 29568L));
        Assert.isTrue(QuantKernel.coopColsOk(Quant.GG_Q4_0, 64L));
        Assert.isFalse(QuantKernel.coopColsOk(Quant.GG_Q8_0, 96L));
        // k-quants: 256 or nothing
        Assert.isTrue(QuantKernel.coopColsOk(Quant.GG_Q4_K, 8192L));
        Assert.isFalse(QuantKernel.coopColsOk(Quant.GG_Q4_K, 29568L));
        Assert.isFalse(QuantKernel.coopColsOk(Quant.GG_Q5_K, 1152L));
        Assert.isFalse(QuantKernel.coopColsOk(Quant.GG_Q6_K, 1152L));
        // unsupported type: false at any width
        Assert.isTrue(QuantKernel.coopColsOk(Quant.GG_F16, 1152L));
        Assert.isFalse(QuantKernel.coopColsOk(5, 8192L));
    }

    /**
     * The invariant that ties the three moving parts together: a format
     * needs a device repack EXACTLY when ggml's block stride is not a
     * multiple of four, and the device stride is never smaller than the
     * ggml one. A wrong `coopBlockWords` entry silently shifts every
     * block of a tensor, so it is checked as arithmetic here rather than
     * left to whichever format happens to be in the model under test.
     */
    @Test
    public void deviceBlockStridesAgreeWithGgmls() {
        int32[] tys #= heap int32[8];
        tys[0] = Quant.GG_Q4_0;
        tys[1] = Quant.GG_Q5_0;
        tys[2] = Quant.GG_Q8_0;
        tys[3] = Quant.GG_Q2_K;
        tys[4] = Quant.GG_Q3_K;
        tys[5] = Quant.GG_Q4_K;
        tys[6] = Quant.GG_Q5_K;
        tys[7] = Quant.GG_Q6_K;
        int32 i = 0;
        while (i < 8) {
            int32 ty = tys[i];
            Assert.isTrue(QuantKernel.coopSupports(ty));
            int32 gg = Quant.blockBytes(ty);
            int32 devBytes = QuantKernel.coopBlockWords(ty) * 4;
            if (Quant.splitOn(ty)) {
                // Split formats: the GEMM reads the payload at its file
                // bytes and nothing is repacked.
                Assert.equals(Quant.payloadBytes(ty), devBytes);
                Assert.isFalse(QuantKernel.coopNeedsRepack(ty));
            } else {
                Assert.isTrue(devBytes >= gg);
                Assert.isTrue(devBytes - gg < 4);
                boolean aligned = gg % 4 == 0;
                // Aligned formats are read in place; the rest are repacked.
                Assert.equals(!aligned, QuantKernel.coopNeedsRepack(ty));
            }
            i = i + 1;
        }
    }

    /**
     * The half that asserts the check does NOT fire: an unsupported type
     * must be reported, never routed through another format's decoder.
     * F16 (ggml type 1) is a real type the engine does not pack.
     */
    @Test
    public void anUnsupportedTypeIsRefusedNotDecoded() {
        Assert.isFalse(QuantKernel.coopSupports(5));
        Assert.equals(0, QuantKernel.coopBlockWords(5));
        if (!CoopQuantGemmTest.coopHere()) { return; }
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) 16);
        KernelBuffer<int32> w #= heap KernelBuffer<int32>((uint64) 16);
        KernelBuffer<float16> x #= heap KernelBuffer<float16>((uint64) 16);
        boolean threw = false;
        try {
            QuantKernel.coopBatchLaunchNoSync(5, y, w, x, 128L, 128L,
                256L);
        } catch (Throwable e) {
            threw = true;
            String m #= e.getMessage();
            Assert.isTrue(m.contains("5"));
        }
        Assert.isTrue(threw);
    }

    // ── Unit 6: the shapes the engine dispatches that no test used to ─────
    //
    // The 8B model's ffn_down has K=14336, and every Auto router sends
    // K > 8192 to its X1 tile; the suite only ever used K=256 and K=1152, so
    // every X1 kernel was registered and never launched. 8448 is the
    // smallest K above the switch that every block size divides.

