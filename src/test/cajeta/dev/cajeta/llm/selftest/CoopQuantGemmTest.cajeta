    // An output width that is not a multiple of 128 but is one of 64: the
    // router takes the 64-row tile whatever the tile count. It used to take
    // the block-128 tile past 64 tiles, which computes whole tiles only and
    // left rows 8192..8255 of this very shape ZERO (measured 2026-09-24).
    @Test
    public void coopGemmQ4KAtOut8256TakesM64AndMatchesEveryRow() {
        int64 before = Device.kernelLaunchCount("q4kF16CoopM64Kernel");
        CoopQuantGemmTest.checkShape(Quant.GG_Q4_K, "q4_k.bin",
            CoopQuantGemmTest.ROWS, 8256L, CoopQuantGemmTest.COLS);
        CoopQuantGemmTest.expectReached("q4kF16CoopM64Kernel", before);
    }
