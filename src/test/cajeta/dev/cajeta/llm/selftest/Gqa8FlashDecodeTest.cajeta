package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.Checkpoint;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.ModelConfig;

/**
 * cajeta-llm plan 40 — the GQA x8 flash decode attend (spec 15.21.1's
 * shape coverage). Every other routable fixture is GQA x4, the ratio
 * the original flash gate required; the 30B is x8 (32 q heads / 4 kv),
 * and before this kernel its decode attend silently took the scalar
 * two-kernel path — measured at 108 us/layer of the token where the
 * flash shape costs ~25.
 *
 * The engagement assertion is the FIRES-check (project method 5): the
 * flash-decode call counter must ADVANCE during the x8 decode, so a
 * regressed gate cannot pass by falling back to the scalar path whose
 * output is also correct.
 */
public class Gqa8FlashDecodeTest {

    static final String FIX =
        "src/test/fixtures/gguf/toy-routable-gqa8.gguf";

    public Gqa8FlashDecodeTest() { return; }

    static #CausalLM mk() {
        Checkpoint ck #= Checkpoint.open(Gqa8FlashDecodeTest.FIX);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        CausalLM m #= heap CausalLM(#cfg, 128, 1, 0);
        m.bind(ck, false);
        ck.close();
        return #m;
    }

    /** The fixture's contract: the x8 ratio, hd 128. */
    @Test
    public void fixtureDeclaresTheGqa8Shape() {
        Checkpoint ck #= Checkpoint.open(Gqa8FlashDecodeTest.FIX);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        ck.close();
        Assert.equals(8L, (int64) cfg.numHeads);
        Assert.equals(1L, (int64) cfg.numKvHeads);
        Assert.equals(128L, (int64) cfg.headDim);
    }

    /** Resident x8 decode ENGAGES the flash kernel (counter advances)
     *  and matches the forced-host arm token-for-token. */
    /** 50.1.2 — reduce + pack in one launch vs the two-launch pair
     *  followed by the pack: the packed payload BYTE-identical (the
     *  reduce is the reduce kernel's math, not FastMath, and the pack
     *  the pack kernel's), at a 32-split context. */
    @Test
    public void reducePackMatchesReduceThenPack() {
        if (!ResidentMoeDecodeTest.residentHere()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 nKv = 4;
        int32 nH = 32;
        int32 hd = 128;
        int32 count = 540;
        int32 cap = 600;
        int64 kvd = (int64) (nKv * hd);
        int64 qd = (int64) (nH * hd);
        float32[] hq = heap float32[qd];
        float32[] hk = heap float32[(int64) cap * kvd];
        float32[] hv = heap float32[(int64) cap * kvd];
        int64 i = 0;
        while (i < qd) {
            hq[i] = (float32) (((i * 7L) % 41L) - 20L) / 64.0f;
            i = i + 1;
        }
        i = 0;
        while (i < (int64) cap * kvd) {
            hk[i] = (float32) (((i * 13L + 5L) % 37L) - 18L) / 32.0f;
            hv[i] = (float32) (((i * 11L + 3L) % 29L) - 14L) / 16.0f;
            i = i + 1;
        }
        KernelBuffer<float32> q #= heap KernelBuffer<float32>((uint64) qd);
        KernelBuffer<float32> k #= heap KernelBuffer<float32>((uint64) ((int64) cap * kvd));
        KernelBuffer<float32> v #= heap KernelBuffer<float32>((uint64) ((int64) cap * kvd));
        q.upload(hq, qd);
        k.upload(hk, (int64) cap * kvd);
        v.upload(hv, (int64) cap * kvd);
        KernelBuffer<float32> o1 #= heap KernelBuffer<float32>((uint64) qd);
        int64 pb = (qd / 256L) * 320L;
        KernelBuffer<int8> p1 #= heap KernelBuffer<int8>((uint64) pb);
        KernelBuffer<int8> p2 #= heap KernelBuffer<int8>((uint64) pb);
        AttnKernel.attendDecodePairLaunchNoSync(o1, q, k, v, nH, nKv, hd,
            count, 0, cap, 0.0883883f);
        QuantKernel.q8kPackLaunchNoSync(p1, o1, qd);
        Assert.isTrue(AttnKernel.attendDecodePartialsLaunchNoSync(q, k, v,
            nH, nKv, hd, count, 0, 0.0883883f));
        AttnKernel.reducePackLaunchNoSync(p2, nH);
        KernelStream s = QuantKernel.stream();
        s.sync();
        int8[] a = heap int8[pb];
        int8[] b = heap int8[pb];
        p1.download(a, pb);
        p2.download(b, pb);
        boolean nz = false;
        i = 0;
        while (i < pb) {
            if (i % 320L >= 292L) { i = i + 1; continue; }
            if (a[i] != b[i]) {
                Assert.fail("packed byte differs at " + i + ": " + (int32) a[i]
                    + " vs " + (int32) b[i]);
            }
            if (a[i] != (int8) 0) { nz = true; }
            i = i + 1;
        }
        Assert.isTrue(nz);
    }

    @Test
    public void gqa8FlashDecodeEngagesAndMatchesHost() {
        if (!ResidentMoeDecodeTest.residentHere()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32[] p #= RoutableFixtureTest.promptOf(8, 3);

        // Host arm (residency off for the decode steps).
        CausalLM mh #= Gqa8FlashDecodeTest.mk();
        int32[] th = heap int32[6];
        int32 nh = mh.prefill(p, 8);
        int32 hp = nh;
        Linear.setDeviceResident(false);
        int32[] one = heap int32[1];
        int32 g = 0;
        while (g < 5) {
            one[0] = nh;
            nh = mh.stepSeq(0, one, 0, 1);
            th[g] = nh;
            g = g + 1;
        }
        Linear.setDeviceResident(true);

        // Resident arm — the flash-decode counter must move.
        CausalLM mr #= Gqa8FlashDecodeTest.mk();
        int32 nr = mr.prefill(p, 8);
        Assert.equals((int64) hp, (int64) nr);
        int64 fd0 = AttnKernel.flashDecodeCalls();
        int32[] tr = heap int32[6];
        g = 0;
        int32 cur = nr;
        while (g < 5) {
            one[0] = cur;
            cur = mr.stepSeq(0, one, 0, 1);
            tr[g] = cur;
            g = g + 1;
        }
        int64 fdN = AttnKernel.flashDecodeCalls() - fd0;
        System.stdout.println("  gqa8 flash-decode calls: " + fdN);
        Assert.isTrue(fdN > 0L);
        g = 0;
        while (g < 5) {
            Assert.equals((int64) th[g], (int64) tr[g]);
            g = g + 1;
        }
    }
}
