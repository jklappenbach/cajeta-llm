package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.GgufFile;
import cajeta.lang.String;
import cajeta.lang.Cajeta;
import cajeta.io.file.File;
import cajeta.io.file.Path;

/**
 * MXFP4 quant format (Unit 32, plan units 1-2).
 *
 * These exercise the format through Quant's PUBLIC surface only —
 * geometry (§2) and dequantization (§3) — with hand-computed expected
 * values, so they stand alone without a llama.cpp fixture. The
 * real-tensor bit-exact witness (§6) and the matvec kernels (§4) land
 * in later units.
 *
 * MXFP4 block = 17 bytes: byte 0 is the E8M0 scale, bytes 1..16 are 16
 * packed bytes of two E2M1 nibbles each. The low nibble of byte j maps
 * to element j, the high nibble to element j+16 (llama.cpp's ordering).
 * E2M1 values: {0,1,2,3,4,6,8,12, 0,-1,-2,-3,-4,-6,-8,-12}.
 */
public class Mxfp4Test {

    public Mxfp4Test() { return; }

    /** Store `v`'s low 8 bits at `a[i]` — a runtime narrowing cast wraps
     *  silently, so byte values above 127 need no awkward constants. */
    static void setByte(int8[] a, int64 i, int32 v) {
        a[i] = (int8) v;
    }

    /** Exact float equality (these are exact dyadic values — no
     *  tolerance is wanted, and Assert has no float overload). */
    static void eqF(float32 expected, float32 actual, String what) {
        if (expected != actual) {
            Assert.fail(what);
        }
    }

    // ── Unit 1: format geometry (spec §2) ──────────────────────────────

    @Test
    public void geometryMatchesTheMxfp4Block() {
        Assert.isTrue(Quant.supported(Quant.GG_MXFP4));
        Assert.equals(32L, (int64) Quant.blockElems(Quant.GG_MXFP4));
        Assert.equals(17L, (int64) Quant.blockBytes(Quant.GG_MXFP4));
    }

    @Test
    public void widthGateAcceptsMultiplesOf32Only() {
        Assert.isTrue(Quant.colsOk(Quant.GG_MXFP4, 32L));
        Assert.isTrue(Quant.colsOk(Quant.GG_MXFP4, 64L));
        Assert.isTrue(Quant.colsOk(Quant.GG_MXFP4, 2880L));   // x32, not x256
        Assert.isFalse(Quant.colsOk(Quant.GG_MXFP4, 33L));
        Assert.isFalse(Quant.colsOk(Quant.GG_MXFP4, 0L));
    }

    // ── Unit 2: dequantization (spec §3) ───────────────────────────────

    /** Build one MXFP4 block with scale byte `e` and the first two qs
     *  bytes set; the rest zero. Returns the 17-byte block. */
    static #int8[] block(int32 e, int32 qs0, int32 qs1) {
        int8[] raw #= heap int8[17];
        Mxfp4Test.setByte(raw, 0L, e);
        Mxfp4Test.setByte(raw, 1L, qs0);
        Mxfp4Test.setByte(raw, 2L, qs1);
        return #raw;
    }

    @Test
    public void dequantMapsNibblesToTheTwoHalvesWithUnitScale() {
        // e = 128 -> scale 2^(128-128) = 1.0
        // qs[0]=0x21: lo=1 (val 1) -> elem 0; hi=2 (val 2) -> elem 16
        // qs[1]=0x7F: lo=15 (val -12) -> elem 1; hi=7 (val 12) -> elem 17
        int8[] raw #= Mxfp4Test.block(128, 0x21, 0x7F);
        float32[] out #= heap float32[32];
        Quant.dequantize(Quant.GG_MXFP4, raw, 0L, 1L, out, 0L);

        Mxfp4Test.eqF(1.0f, out[0], "elem0 lo nibble");
        Mxfp4Test.eqF(2.0f, out[16], "elem16 hi nibble");
        Mxfp4Test.eqF(-12.0f, out[1], "elem1 lo nibble (neg)");
        Mxfp4Test.eqF(12.0f, out[17], "elem17 hi nibble");
        // Untouched nibbles decode to 0.
        Mxfp4Test.eqF(0.0f, out[2], "elem2 zero");
        Mxfp4Test.eqF(0.0f, out[31], "elem31 zero");
    }

    @Test
    public void scaleIsAPowerOfTwoInTheExponentByte() {
        // e = 129 -> scale 2.0, so the same nibbles double.
        int8[] raw #= Mxfp4Test.block(129, 0x21, 0x7F);
        float32[] out #= heap float32[32];
        Quant.dequantize(Quant.GG_MXFP4, raw, 0L, 1L, out, 0L);
        Mxfp4Test.eqF(2.0f, out[0], "elem0 x2");    // 1 * 2
        Mxfp4Test.eqF(4.0f, out[16], "elem16 x2");  // 2 * 2
        Mxfp4Test.eqF(-24.0f, out[1], "elem1 x2");  // -12 * 2
        Mxfp4Test.eqF(24.0f, out[17], "elem17 x2"); // 12 * 2
    }

    @Test
    public void denormalScalesForExponentBelowTwoKeepTheDoublingRatio() {
        // e=0 -> 2^-128, e=1 -> 2^-127; both subnormal but exactly
        // representable, and e=1 is exactly twice e=0.
        int8[] b0 #= Mxfp4Test.block(0, 0x01, 0x00);   // lo=1 (val 1)
        int8[] b1 #= Mxfp4Test.block(1, 0x01, 0x00);
        float32[] o0 #= heap float32[32];
        float32[] o1 #= heap float32[32];
        Quant.dequantize(Quant.GG_MXFP4, b0, 0L, 1L, o0, 0L);
        Quant.dequantize(Quant.GG_MXFP4, b1, 0L, 1L, o1, 0L);
        Assert.isTrue(o0[0] > 0.0f);
        Assert.isTrue(o1[0] > 0.0f);
        Mxfp4Test.eqF(o1[0], o0[0] * 2.0f, "e=1 is twice e=0");
    }

    // ── Unit 3: CPU packed matvec, fp32 scalar reference (spec §4) ──────

    /** Fill `rows*bpr` MXFP4 blocks: scale byte bounded to e in 127..130
     *  (scales 0.5..4, so accumulation can't overflow) and qs bytes to a
     *  deterministic varied pattern that exercises every nibble incl.
     *  negatives. */
    static #int8[] fillPacked(int64 rows, int64 bpr) {
        int64 totalBlocks = rows * bpr;
        int8[] packed #= heap int8[totalBlocks * 17L];
        int64 blk = 0;
        while (blk < totalBlocks) {
            int64 base = blk * 17L;
            Mxfp4Test.setByte(packed, base, 127 + (int32) (blk & 3L));
            int32 j = 1;
            while (j < 17) {
                int32 v = (int32) (((blk * 17L + (int64) j) * 7L + 3L) & 255L);
                Mxfp4Test.setByte(packed, base + (int64) j, v);
                j = j + 1;
            }
            blk = blk + 1;
        }
        return #packed;
    }

    /** The kernel must equal dequantize-then-dense, bit for bit. Both walk
     *  elements 0..cols-1 in order, so the float accumulation matches. */
    static void checkMatvec(int64 rows, int64 cols) {
        int64 bpr = cols / 32L;
        int8[] packed #= Mxfp4Test.fillPacked(rows, bpr);

        float32[] x #= heap float32[cols];
        int64 c = 0;
        while (c < cols) {
            x[c] = (float32) ((c % 5L) - 2L) * 0.5f + 0.25f;   // never 0
            c = c + 1;
        }

        // Reference: dequantize each row, dense dot in 0..cols-1 order.
        float32[] ref #= heap float32[rows];
        float32[] deq #= heap float32[cols];
        int64 i = 0;
        while (i < rows) {
            Quant.dequantize(Quant.GG_MXFP4, packed, i * bpr * 17L, bpr,
                deq, 0L);
            float32 acc = 0.0f;
            int64 k = 0;
            while (k < cols) { acc = acc + deq[k] * x[k]; k = k + 1; }
            ref[i] = acc;
            i = i + 1;
        }

        float32[] got #= heap float32[rows];
        Quant.mxfp4MatVecIntoScalar(packed, rows, cols, x, 0L, got, 0L);

        int64 r = 0;
        while (r < rows) {
            Mxfp4Test.eqF(ref[r], got[r], "matvec row bit-exact");
            r = r + 1;
        }
    }

    @Test
    public void scalarMatvecIsBitExactVsDequantThenDense() {
        Mxfp4Test.checkMatvec(2L, 64L);   // multi-block; x32 not x256
        Mxfp4Test.checkMatvec(3L, 32L);   // single block per row
        Mxfp4Test.checkMatvec(1L, 96L);   // three blocks
    }

    // ── Unit 6: real-tensor witness vs llama.cpp (spec §6) ──────────────
    //
    // The fixture src/test/fixtures/mxfp4/mxfp4_ref.bin was extracted once
    // from a real gpt-oss-20b MXFP4 tensor (blk.0.ffn_down_exps.weight)
    // with llama.cpp's OWN dequantize_row_mxfp4 as the oracle (the extract
    // tool lives in the plan's Unit 6). Layout (little-endian): int32 ne0,
    // int32 nBlocks, nBlocks*17 raw bytes, nBlocks*32 float32 reference.
    // This proves cajeta's dequant is bit-exact on REAL data (real scales,
    // real nibble patterns), not just on hand-built blocks.

    static final String FIXTURE = "src/test/fixtures/mxfp4/mxfp4_ref.bin";

    static int32 u8At(int8[] a, int64 off) { return (int32) a[off] & 255; }

    static int32 i32le(int8[] a, int64 off) {
        return Mxfp4Test.u8At(a, off)
            | (Mxfp4Test.u8At(a, off + 1L) << 8)
            | (Mxfp4Test.u8At(a, off + 2L) << 16)
            | (Mxfp4Test.u8At(a, off + 3L) << 24);
    }

    static float32 f32le(int8[] a, int64 off) {
        int64 bits = (int64) Mxfp4Test.u8At(a, off)
            | ((int64) Mxfp4Test.u8At(a, off + 1L) << 8)
            | ((int64) Mxfp4Test.u8At(a, off + 2L) << 16)
            | ((int64) Mxfp4Test.u8At(a, off + 3L) << 24);
        return Cajeta.bitsToF32(bits);
    }

    @Test
    public void dequantOfRealTensorMatchesLlamaCppBitExact() {
        int8[] fx #= File.readAllBytes(Mxfp4Test.FIXTURE);
        Assert.isTrue(fx != null);
        int32 nBlocks = Mxfp4Test.i32le(fx, 4L);
        Assert.isTrue(nBlocks > 0);
        int64 rawOff = 8L;
        int64 refOff = rawOff + (int64) nBlocks * 17L;
        int64 nElem = (int64) nBlocks * 32L;

        // cajeta dequant straight out of the fixture's raw region.
        float32[] out #= heap float32[nElem];
        Quant.dequantize(Quant.GG_MXFP4, fx, rawOff, (int64) nBlocks, out, 0L);

        int64 k = 0;
        while (k < nElem) {
            float32 want = Mxfp4Test.f32le(fx, refOff + k * 4L);
            Mxfp4Test.eqF(want, out[k], "real-tensor dequant bit-exact");
            k = k + 1;
        }
    }

    // ── Unit 5: GgufFile recognizes MXFP4 on the real model (spec §2.1) ──
    //
    // Env-gated: the 11 GB gpt-oss-20b file is not a repo fixture, so this
    // runs only where the model is present (local dev) and skips on CI.
    // The UNCONDITIONAL proof of the read/dequant path is the witness
    // above on the checked-in fixture; this adds the GgufFile locator.

    static final String OSS =
        "/home/julian/.lmstudio/models/lmstudio-community/"
        + "gpt-oss-20b-GGUF/gpt-oss-20b-MXFP4.gguf";

    @Test
    public void ggufLoaderRecognizesMxfp4TensorType() {
        if (!Path.of(Mxfp4Test.OSS).exists()) {
            return;   // model absent (CI) — the witness covers the real path
        }
        GgufFile g #= heap GgufFile(Mxfp4Test.OSS);
        int32 ty = g.typeOfName("blk.0.ffn_down_exps.weight");
        Assert.equals(39L, (int64) ty);
        Assert.isTrue(Quant.supported(ty));
        Assert.equals(17L, (int64) Quant.blockBytes(ty));
    }
}
