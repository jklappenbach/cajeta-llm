package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.Prim;

/**
 * cajeta-llm plan 48.1 — the fused decode prep (QK-norm + RoPE + K/V
 * append in one launch) against the four separate launches it
 * replaces: q, k, the K plane row and the V plane row BIT-identical,
 * with and without the norm. The GQA x8 shape of the 30B (32 q heads,
 * 4 kv heads, hd 128) and a smaller odd one.
 */
public class QkPrepTest {

    public QkPrepTest() { return; }

    static boolean skip() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none")) {
            RoutableFixtureTest.saySkip();
            return true;
        }
        return false;
    }

    static #KernelBuffer<float32> fill(int64 n, int32 seed) {
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float32) (((i * 37L + (int64) seed) % 101L) - 50L)
                / 17.0f;
            i = i + 1;
        }
        KernelBuffer<float32> b #= heap KernelBuffer<float32>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static void same(KernelBuffer<float32> a, KernelBuffer<float32> b,
            int64 n, String what) {
        float32[] ha = heap float32[n];
        float32[] hb = heap float32[n];
        a.download(ha, n);
        b.download(hb, n);
        int64 i = 0;
        while (i < n) {
            if (ha[i] != hb[i]) {
                Assert.fail(what + " differs at " + i + ": " + ha[i]
                    + " vs " + hb[i]);
            }
            i = i + 1;
        }
    }

    static void run(int32 nH, int32 nKv, int32 hd, boolean norm) {
        int64 qd = (int64) (nH * hd);
        int64 kvd = (int64) (nKv * hd);
        int32 cap = 16;
        int32 p = 11;
        KernelBuffer<float32> q1 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k1 #= QkPrepTest.fill(kvd, 2);
        KernelBuffer<float32> v1 #= QkPrepTest.fill(kvd, 3);
        KernelBuffer<float32> q2 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k2 #= QkPrepTest.fill(kvd, 2);
        KernelBuffer<float32> v2 #= QkPrepTest.fill(kvd, 3);
        KernelBuffer<float32> qw #= QkPrepTest.fill((int64) hd, 4);
        KernelBuffer<float32> kw #= QkPrepTest.fill((int64) hd, 5);
        KernelBuffer<float32> inv #= QkPrepTest.fill((int64) (hd / 2), 6);
        KernelBuffer<float32> kp1 #= QkPrepTest.fill(kvd * (int64) cap, 7);
        KernelBuffer<float32> vp1 #= QkPrepTest.fill(kvd * (int64) cap, 8);
        KernelBuffer<float32> kp2 #= QkPrepTest.fill(kvd * (int64) cap, 7);
        KernelBuffer<float32> vp2 #= QkPrepTest.fill(kvd * (int64) cap, 8);
        float32 eps = 0.000001f;
        // The separate verbs.
        if (norm) {
            Prim.qkNormDevice(q1, k1, qw, kw, (int64) nH, (int64) nKv,
                (int64) hd, eps, 0);
        }
        AttnKernel.ropeDecodeLaunchNoSync(q1, inv, nH, hd, p);
        AttnKernel.ropeDecodeLaunchNoSync(k1, inv, nKv, hd, p);
        AttnKernel.kvAppendLaunchNoSync(kp1, vp1, k1, v1, (int32) kvd, p);
        // The fused one.
        AttnKernel.qkPrepLaunchNoSync(q2, k2, v2, kp2, vp2, qw, kw, inv,
            nH, nKv, hd, norm, eps, 0, p, p);
        KernelStream s = QuantKernel.stream();
        s.sync();
        QkPrepTest.same(q1, q2, qd, "q");
        QkPrepTest.same(k1, k2, kvd, "k");
        QkPrepTest.same(kp1, kp2, kvd * (int64) cap, "K plane");
        QkPrepTest.same(vp1, vp2, kvd * (int64) cap, "V plane");
        // Vacuity: the prep really changed q (rope is not identity at
        // p = 11) and wrote the plane row.
        float32[] hq = heap float32[qd];
        q2.download(hq, qd);
        KernelBuffer<float32> q0 #= QkPrepTest.fill(qd, 1);
        float32[] h0 = heap float32[qd];
        q0.download(h0, qd);
        boolean moved = false;
        int64 i = 0;
        while (i < qd) {
            if (hq[i] != h0[i]) { moved = true; }
            i = i + 1;
        }
        Assert.isTrue(moved);
    }

    /** 48.1.1 — the 30B's GQA x8 shape, with the norm. */
    @Test
    public void fusedPrepMatchesSeparateLaunchesWithNorm() {
        if (QkPrepTest.skip()) { return; }
        QkPrepTest.run(32, 4, 128, true);
    }

    /** 48.1.1 — without the norm (a model without QK-norm). */
    @Test
    public void fusedPrepMatchesSeparateLaunchesWithoutNorm() {
        if (QkPrepTest.skip()) { return; }
        QkPrepTest.run(32, 4, 128, false);
    }

    /** 48.1.1 — a head dim below the block width. */
    @Test
    public void fusedPrepMatchesOnASmallerHead() {
        if (QkPrepTest.skip()) { return; }
        QkPrepTest.run(6, 2, 64, true);
    }
}
