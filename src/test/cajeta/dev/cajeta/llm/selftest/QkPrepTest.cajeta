package dev.cajeta.llm.selftest;

import dev.cajeta.llm.model.KernelCap;
import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.Prim;

/**
 * cajeta-llm plan 48.1 — the fused decode prep (QK-norm + RoPE + K/V
 * append in one launch) against the four separate launches it
 * replaces: q, k, the K plane row and the V plane row to 1e-6
 * relative (the norm's reduction order differs; everything else is
 * the same arithmetic), with and without the norm. The GQA x8 shape of the 30B (32 q heads,
 * 4 kv heads, hd 128) and a smaller odd one.
 */
public class QkPrepTest {

    public QkPrepTest() { return; }

    /** Skips unless the fused prep and the separate verbs it is compared
     *  against all lower here. */
    static void need(boolean norm) {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCap.usable("qkPrepKernel")) { DeviceSkip.noKernel("qkPrepKernel", be); return; }
        if (!KernelCap.usable("ropeDecodeKernel")) { DeviceSkip.noKernel("ropeDecodeKernel", be); return; }
        if (!KernelCap.usable("kvAppendKernel")) { DeviceSkip.noKernel("kvAppendKernel", be); return; }
        if (norm && !KernelCap.usable("qkNormRowsF32")) { DeviceSkip.noKernel("qkNormRowsF32", be); return; }
        return;
    }

    static #KernelBuffer<float32> fill(int64 n, int32 seed) {
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float32) (((i * 37L + (int64) seed) % 101L) - 50L)
                / 17.0f;
            i = i + 1;
        }
        KernelBuffer<float32> b #= heap KernelBuffer<float32>((uint64) n);
        b.upload(h, n);
        return #b;
    }

    static #KernelBuffer<float16> fillHalf(int64 n, int32 seed) {
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            h[i] = (float32) (((i * 37L + (int64) seed) % 101L) - 50L)
                / 17.0f;
            i = i + 1;
        }
        float16[] hh #= AttnKernel.halfOf(h, n);
        KernelBuffer<float16> b #= heap KernelBuffer<float16>((uint64) n);
        b.upload(hh, n);
        return #b;
    }

    /** The planes are half (unit 57): the two sides round the same f32
     *  math, so they agree except where a last-bit f32 difference
     *  straddles a half rounding boundary — one half ulp, 2^-11. */
    static void sameHalf(KernelBuffer<float16> a, KernelBuffer<float16> b,
            int64 n, String what) {
        float16[] ha = heap float16[n];
        float16[] hb = heap float16[n];
        a.download(ha, n);
        b.download(hb, n);
        int64 i = 0;
        while (i < n) {
            float32 x = (float32) ha[i];
            float32 y = (float32) hb[i];
            float32 d = x - y;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 mag = x < 0.0f ? 0.0f - x : x;
            if (d > mag * 0.001f + 0.0001f) {
                Assert.fail(what + " differs at " + i + ": " + x
                    + " vs " + y);
            }
            i = i + 1;
        }
    }

    static void same(KernelBuffer<float32> a, KernelBuffer<float32> b,
            int64 n, String what) {
        float32[] ha = heap float32[n];
        float32[] hb = heap float32[n];
        a.download(ha, n);
        b.download(hb, n);
        int64 i = 0;
        while (i < n) {
            // The fused norm sums four wave partials where the separate
            // kernel runs a 256-thread tree: the scale can differ in the
            // last bit, so the bar is 1e-6 relative, not `==`.
            float32 d = ha[i] - hb[i];
            if (d < 0.0f) { d = 0.0f - d; }
            float32 mag = ha[i] < 0.0f ? 0.0f - ha[i] : ha[i];
            if (d > mag * 0.000001f + 0.0000001f) {
                Assert.fail(what + " differs at " + i + ": " + ha[i]
                    + " vs " + hb[i]);
            }
            i = i + 1;
        }
    }

    static void run(int32 nH, int32 nKv, int32 hd, boolean norm) {
        int64 qd = (int64) (nH * hd);
        int64 kvd = (int64) (nKv * hd);
        int32 cap = 16;
        int32 p = 11;
        KernelBuffer<float32> q1 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k1 #= QkPrepTest.fill(kvd, 2);
        KernelBuffer<float32> v1 #= QkPrepTest.fill(kvd, 3);
        KernelBuffer<float32> q2 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k2 #= QkPrepTest.fill(kvd, 2);
        KernelBuffer<float32> v2 #= QkPrepTest.fill(kvd, 3);
        KernelBuffer<float32> qw #= QkPrepTest.fill((int64) hd, 4);
        KernelBuffer<float32> kw #= QkPrepTest.fill((int64) hd, 5);
        KernelBuffer<float32> inv #= QkPrepTest.fill((int64) (hd / 2), 6);
        KernelBuffer<float16> kp1 #= QkPrepTest.fillHalf(kvd * (int64) cap, 7);
        KernelBuffer<float16> vp1 #= QkPrepTest.fillHalf(kvd * (int64) cap, 8);
        KernelBuffer<float16> kp2 #= QkPrepTest.fillHalf(kvd * (int64) cap, 7);
        KernelBuffer<float16> vp2 #= QkPrepTest.fillHalf(kvd * (int64) cap, 8);
        float32 eps = 0.000001f;
        // The separate verbs.
        if (norm) {
            Prim.qkNormDevice(q1, k1, qw, kw, (int64) nH, (int64) nKv,
                (int64) hd, eps, 0);
        }
        AttnKernel.ropeDecodeLaunchNoSync(q1, inv, nH, hd, p);
        AttnKernel.ropeDecodeLaunchNoSync(k1, inv, nKv, hd, p);
        AttnKernel.kvAppendLaunchNoSync(kp1, vp1, k1, v1, (int32) kvd, p);
        // The fused one. The separate verbs are the reference and are
        // checked on their own, so only the fused kernel is credited.
        int64[] vc #= ValueCheck.mark();
        AttnKernel.qkPrepLaunchNoSync(q2, k2, v2, kp2, vp2, qw, kw, inv,
            nH, nKv, hd, norm, eps, 0, p, p);
        KernelStream s = QuantKernel.stream();
        s.sync();
        QkPrepTest.same(q1, q2, qd, "q");
        QkPrepTest.same(k1, k2, kvd, "k");
        QkPrepTest.sameHalf(kp1, kp2, kvd * (int64) cap, "K plane");
        QkPrepTest.sameHalf(vp1, vp2, kvd * (int64) cap, "V plane");
        // Vacuity: the prep really changed q (rope is not identity at
        // p = 11) and wrote the plane row.
        float32[] hq = heap float32[qd];
        q2.download(hq, qd);
        KernelBuffer<float32> q0 #= QkPrepTest.fill(qd, 1);
        float32[] h0 = heap float32[qd];
        q0.download(h0, qd);
        boolean moved = false;
        int64 i = 0;
        while (i < qd) {
            if (hq[i] != h0[i]) { moved = true; }
            i = i + 1;
        }
        Assert.isTrue(moved);
        ValueCheck.credit(vc);
    }

    /** 48.1.1 — the 30B's GQA x8 shape, with the norm. */
    @Test
    public void fusedPrepMatchesSeparateLaunchesWithNorm() {
        QkPrepTest.need(true);
        QkPrepTest.run(32, 4, 128, true);
    }

    /** 48.1.1 — without the norm (a model without QK-norm). */
    @Test
    public void fusedPrepMatchesSeparateLaunchesWithoutNorm() {
        QkPrepTest.need(false);
        QkPrepTest.run(32, 4, 128, false);
    }

    /** 48.1.1 — a head dim below the block width. */
    @Test
    public void fusedPrepMatchesOnASmallerHead() {
        QkPrepTest.need(true);
        QkPrepTest.run(6, 2, 64, true);
    }

    /** The PREFILL twin (1.8.3): RoPE of q and k over `rows` rows and the
     *  K/V range append in ONE launch, against the two batched ropes and
     *  the range append it replaces. The same rotation per element, so
     *  q and k agree to the same bar as the decode prep and the planes to
     *  half rounding. `from` is the first plane row, so a mid-sequence
     *  chunk lands where the range append puts it. */
    static void runRows(int32 nH, int32 nKv, int32 hd, int32 rows, int32 from) {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCap.usable("ropeAppendRowsKernel")) { DeviceSkip.noKernel("ropeAppendRowsKernel", be); return; }
        if (!KernelCap.usable("ropeF32")) { DeviceSkip.noKernel("ropeF32", be); return; }
        if (!KernelCap.usable("kvAppendRangeKernel")) { DeviceSkip.noKernel("kvAppendRangeKernel", be); return; }
        int64 qd = (int64) rows * (int64) (nH * hd);
        int64 kvd = (int64) (nKv * hd);
        int64 kvn = (int64) rows * kvd;
        int32 cap = from + rows + 3;
        KernelBuffer<float32> q1 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k1 #= QkPrepTest.fill(kvn, 2);
        KernelBuffer<float32> v1 #= QkPrepTest.fill(kvn, 3);
        KernelBuffer<float32> q2 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k2 #= QkPrepTest.fill(kvn, 2);
        KernelBuffer<float32> v2 #= QkPrepTest.fill(kvn, 3);
        KernelBuffer<float32> inv #= QkPrepTest.fill((int64) (hd / 2), 6);
        int32[] ph = heap int32[(int64) rows];
        int32 r = 0;
        while (r < rows) { ph[(int64) r] = from + r; r = r + 1; }
        KernelBuffer<int32> pos #= heap KernelBuffer<int32>((uint64) rows);
        pos.upload(ph, (int64) rows);
        KernelBuffer<float16> kp1 #= QkPrepTest.fillHalf(kvd * (int64) cap, 7);
        KernelBuffer<float16> vp1 #= QkPrepTest.fillHalf(kvd * (int64) cap, 8);
        KernelBuffer<float16> kp2 #= QkPrepTest.fillHalf(kvd * (int64) cap, 7);
        KernelBuffer<float16> vp2 #= QkPrepTest.fillHalf(kvd * (int64) cap, 8);
        // The separate verbs, held to a host rotation and a host append
        // first, so the reference the fused launch is compared with is
        // itself checked (and the census credits ropeF32 and the range
        // append here).
        int64[] vr #= ValueCheck.mark();
        Prim.ropeBatchDevice(q1, inv, pos, (int64) rows, nH, hd);
        Prim.ropeBatchDevice(k1, inv, pos, (int64) rows, nKv, hd);
        AttnKernel.kvAppendRangeLaunchNoSync(kp1, vp1, k1, v1, (int32) kvd,
            from, rows);
        QuantKernel.stream().sync();
        QkPrepTest.againstHost(q1, k1, v1, kp1, vp1, inv, rows, nH, nKv, hd, from, cap);
        ValueCheck.credit(vr);
        int64[] vc #= ValueCheck.mark();
        AttnKernel.ropeAppendRowsLaunchNoSync(q2, k2, v2, kp2, vp2, inv, pos,
            rows, nH, nKv, hd, from);
        KernelStream s = QuantKernel.stream();
        s.sync();
        QkPrepTest.same(q1, q2, qd, "q");
        QkPrepTest.same(k1, k2, kvn, "k");
        QkPrepTest.sameHalf(kp1, kp2, kvd * (int64) cap, "K plane");
        QkPrepTest.sameHalf(vp1, vp2, kvd * (int64) cap, "V plane");
        // Vacuity: the launch rotated q, and the K plane's first appended
        // row is no longer the fill.
        float32[] hq = heap float32[qd];
        q2.download(hq, qd);
        KernelBuffer<float32> q0 #= QkPrepTest.fill(qd, 1);
        float32[] h0 = heap float32[qd];
        q0.download(h0, qd);
        int64 moved = 0L;
        int64 i = 0;
        while (i < qd) {
            if (hq[i] != h0[i]) { moved = moved + 1L; }
            i = i + 1;
        }
        Assert.isTrue(moved > qd / 4L);
        KernelBuffer<float16> kp0 #= QkPrepTest.fillHalf(kvd * (int64) cap, 7);
        float16[] a = heap float16[kvd * (int64) cap];
        float16[] b = heap float16[kvd * (int64) cap];
        kp0.download(a, kvd * (int64) cap);
        kp2.download(b, kvd * (int64) cap);
        int64 rowMoved = 0L;
        int64 j = (int64) from * kvd;
        while (j < (int64) (from + 1) * kvd) {
            if ((float32) a[j] != (float32) b[j]) { rowMoved = rowMoved + 1L; }
            j = j + 1;
        }
        Assert.isTrue(rowMoved > kvd / 4L);
        ValueCheck.credit(vc);
    }

    /** ropeF32 and the range append against the host: rotate the fill
     *  of q and k on the host with the same formula, compare the device
     *  q and k to 1e-4 relative (the device's cos and sin are not the
     *  host's to the last bit), and the planes' appended rows to the
     *  host k and v rounded to half. */
    static void againstHost(KernelBuffer<float32> qD, KernelBuffer<float32> kD,
            KernelBuffer<float32> vD, KernelBuffer<float16> kpD,
            KernelBuffer<float16> vpD, KernelBuffer<float32> invD, int32 rows,
            int32 nH, int32 nKv, int32 hd, int32 from, int32 cap) {
        int32 half = hd / 2;
        float32[] inv = heap float32[(int64) half];
        invD.download(inv, (int64) half);
        int64 qd = (int64) rows * (int64) (nH * hd);
        int64 kvd = (int64) (nKv * hd);
        int64 kvn = (int64) rows * kvd;
        KernelBuffer<float32> q0 #= QkPrepTest.fill(qd, 1);
        KernelBuffer<float32> k0 #= QkPrepTest.fill(kvn, 2);
        float32[] qh = heap float32[qd];
        float32[] kh = heap float32[kvn];
        float32[] vh = heap float32[kvn];
        q0.download(qh, qd);
        k0.download(kh, kvn);
        vD.download(vh, kvn);
        QkPrepTest.hostRope(qh, rows, nH, hd, from, inv);
        QkPrepTest.hostRope(kh, rows, nKv, hd, from, inv);
        float32[] qg = heap float32[qd];
        float32[] kg = heap float32[kvn];
        qD.download(qg, qd);
        kD.download(kg, kvn);
        QkPrepTest.near(qh, qg, qd, "ropeF32 q against the host");
        QkPrepTest.near(kh, kg, kvn, "ropeF32 k against the host");
        int64 pn = kvd * (int64) cap;
        float16[] kp = heap float16[pn];
        float16[] vp = heap float16[pn];
        kpD.download(kp, pn);
        vpD.download(vp, pn);
        int64 i = 0;
        while (i < kvn) {
            int64 o = (int64) from * kvd + i;
            float32 wk = (float32) ((float16) kh[i]);
            float32 wv = (float32) ((float16) vh[i]);
            float32 dk = (float32) kp[o] - wk;
            float32 dv = (float32) vp[o] - wv;
            if (dk < 0.0f) { dk = 0.0f - dk; }
            if (dv < 0.0f) { dv = 0.0f - dv; }
            float32 mk = wk < 0.0f ? 0.0f - wk : wk;
            if (dk > mk * 0.001f + 0.001f || dv != 0.0f) {
                Assert.fail("the range append differs from the host at plane element "
                    + o + ": K " + (float32) kp[o] + " vs " + wk + ", V "
                    + (float32) vp[o] + " vs " + wv);
                return;
            }
            i = i + 1;
        }
    }

    static void hostRope(float32[] t, int32 rows, int32 nHeads, int32 hd,
            int32 from, float32[] inv) {
        int32 half = hd / 2;
        int32 r = 0;
        while (r < rows) {
            int32 h = 0;
            while (h < nHeads) {
                int64 base = (int64) r * (int64) (nHeads * hd) + (int64) (h * hd);
                int32 d = 0;
                while (d < half) {
                    float32 ang = (float32) (from + r) * inv[(int64) d];
                    float32 c = Math.cos(ang);
                    float32 sn = Math.sin(ang);
                    float32 a = t[base + (int64) d];
                    float32 b = t[base + (int64) (d + half)];
                    t[base + (int64) d] = a * c - b * sn;
                    t[base + (int64) (d + half)] = a * sn + b * c;
                    d = d + 1;
                }
                h = h + 1;
            }
            r = r + 1;
        }
        return;
    }

    static void near(float32[] want, float32[] got, int64 n, String what) {
        int64 i = 0;
        while (i < n) {
            float32 d = want[i] - got[i];
            if (d < 0.0f) { d = 0.0f - d; }
            float32 mag = want[i] < 0.0f ? 0.0f - want[i] : want[i];
            if (d > mag * 0.0001f + 0.0001f) {
                Assert.fail(what + " differs at " + i + ": " + got[i]
                    + " vs " + want[i]);
                return;
            }
            i = i + 1;
        }
        return;
    }

    @Test
    public void prefillRopeAppendMatchesSeparateLaunchesAtLlamaGqa() {
        QkPrepTest.runRows(32, 8, 128, 64, 0);
    }

    @Test
    public void prefillRopeAppendMatchesSeparateLaunchesMidSequence() {
        QkPrepTest.runRows(6, 2, 64, 37, 5);
    }
}
