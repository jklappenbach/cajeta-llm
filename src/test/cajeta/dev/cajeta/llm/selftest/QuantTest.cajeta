    /** 15.1.16 — Q8_0 vectorized kernel vs its scalar floor. */
    @Test
    public void q8SimdMatVecAgreesWithScalarFloor() {
        int8[] raw #= File.readAllBytes(QuantTest.DIR + "q8_0.bin");
        int64 blocks = (int64) raw.count() / (int64) Quant.blockBytes(Quant.GG_Q8_0);
        int64 n = blocks * 32L;
        int64 rows = 2L;
        int64 cols = n / rows;
        float32[] x #= heap float32[cols];
        int64 c = 0;
        while (c < cols) { x[c] = (float32) ((c % 11L) - 5L) * 0.375f; c = c + 1; }
        float32[] simd #= heap float32[rows];
        float32[] ref #= heap float32[rows];
        Quant.q8MatVecInto(raw, rows, cols, x, 0L, simd, 0L);
        Quant.q8MatVecIntoScalar(raw, rows, cols, x, 0L, ref, 0L);
        int64 r = 0;
        while (r < rows) {
            float32 diff = simd[r] - ref[r];
            if (diff < 0.0f) { diff = 0.0f - diff; }
            float32 mag = ref[r] < 0.0f ? 0.0f - ref[r] : ref[r];
            if (diff > mag * 1.0e-4f + 1.0e-3f) {
                Assert.fail("row " + r + ": simd " + simd[r] + " vs scalar "
                    + ref[r] + " differ by " + diff);
            }
            r = r + 1;
        }
    }

    /** Offsets: the forward path multiplies windows of larger arena
     *  buffers, so the -Into forms must honour xOff/yOff. */
    @Test
    public void kQuantMatVecHonoursOffsets() {
        int8[] raw #= File.readAllBytes(QuantTest.DIR + "q4_k.bin");
        int64 blocks = (int64) raw.count() / (int64) Quant.blockBytes(Quant.GG_Q4_K);
        int64 n = blocks * 256L;
        int64 rows = 2L;
        int64 cols = n / rows;

        float32[] x #= heap float32[cols];
        int64 c = 0;
        while (c < cols) { x[c] = (float32) ((c % 7L) - 3L) * 0.25f; c = c + 1; }
        float32[] flat #= heap float32[rows];
        Quant.q4kMatVec(raw, rows, cols, x, flat);

        // Same data, shifted inside bigger buffers.
        float32[] bigX #= heap float32[cols + 8L];
        c = 0;
        while (c < cols) { bigX[c + 5L] = x[c]; c = c + 1; }
        float32[] bigY #= heap float32[rows + 4L];
        Quant.q4kMatVecInto(raw, rows, cols, bigX, 5L, bigY, 3L);

        int64 r = 0;
        while (r < rows) {
            Assert.equals((int64) (flat[r] * 1000000.0f),
                (int64) (bigY[r + 3L] * 1000000.0f));
            r = r + 1;
        }
    }
}
