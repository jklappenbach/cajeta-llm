package dev.cajeta.llm.selftest;

import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/**
 * cajeta-llm 15.2.14.6.2: the decode's split reduce + q8 pack on the cpu backend takes a work item a pack block;
 * every payload byte equals the 256-lane kernel's.
 */
public class ReducePackCpuTest {

    public ReducePackCpuTest() { return; }

    static boolean cpuHere() {
        String be #= Device.activeBackend();
        if (!be.equals("cpu")) { DeviceSkip.cannot("the row form is the cpu backend's"); return false; }
        if (!KernelCap.usable("attnReducePackQ8CpuKernel")) { DeviceSkip.noKernel("attnReducePackQ8CpuKernel", be); return false; }
        return true;
    }

    static #int8[] pack(float32[] h, int32 nH, int32 splits, boolean cpuForm) {
        int64 n = (int64) nH * (int64) splits * 130L;
        KernelBuffer<float32> part #= heap KernelBuffer<float32>((uint64) n);
        part.upload(h, n);
        int64 pb = (int64) (nH / 2) * 320L;
        int8[] z = heap int8[pb];
        KernelBuffer<int8> packed #= heap KernelBuffer<int8>((uint64) pb);
        packed.upload(z, pb);
        AttnKernel.setCpuReducePack(cpuForm);
        AttnKernel.reducePackFromLaunchNoSync(packed, part, nH, splits);
        QuantKernel.stream().sync();
        AttnKernel.setCpuReducePack(true);
        int8[] got = heap int8[pb];
        packed.download(got, pb);
        return #got;
    }

    static void same(float32[] h, int32 nH, int32 splits) {
        int8[] a #= ReducePackCpuTest.pack(h, nH, splits, false);
        int8[] b #= ReducePackCpuTest.pack(h, nH, splits, true);
        int64 pb = (int64) (nH / 2) * 320L;
        boolean nz = false;
        int64 i = 0;
        while (i < pb) {
            if (i % 320L < 292L) {
                if (a[i] != b[i]) {
                    Assert.fail("splits " + splits + ": packed byte " + i + " is " + (int32) b[i]
                        + ", the kernel's " + (int32) a[i]);
                    return;
                }
                if (a[i] != (int8) 0) { nz = true; }
            }
            i = i + 1;
        }
        Assert.isTrue(nz);
    }

    static #float32[] partials(int32 nH, int32 splits) {
        int64 n = (int64) nH * (int64) splits * 130L;
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            int64 slot = i % 130L;
            int64 seg = i / 130L;
            if (slot < 128L) {
                h[i] = (float32) (((i * 37L + 11L) % 197L) - 98L) / 7.0f;
            } else if (slot == 128L) {
                h[i] = (float32) ((seg * 7L) % 11L) * 0.37f - 1.9f;
            } else if (seg % 7L == 3L && seg % (int64) splits != 0L) {
                h[i] = 0.0f;
            } else {
                h[i] = 0.5f + (float32) ((seg * 5L) % 9L) * 0.31f;
            }
            i = i + 1;
        }
        return #h;
    }

    /** Every split count the decode takes, odd and short ones included, with empty splits skipped. */
    @Test
    public void theRowFormMatchesTheKernelAtEverySplitCount() {
        if (!ReducePackCpuTest.cpuHere()) { return; }
        int32[] counts #= heap int32[6];
        counts[0] = 1; counts[1] = 3; counts[2] = 4; counts[3] = 8; counts[4] = 13; counts[5] = 64;
        int32 c = 0;
        while (c < 6) {
            float32[] h #= ReducePackCpuTest.partials(32, counts[c]);
            ReducePackCpuTest.same(h, 32, counts[c]);
            c = c + 1;
        }
    }

    /** Quants at exact halves round away from zero, as the kernel's Math.round does. */
    @Test
    public void exactHalvesRoundAsTheKernelDoes() {
        if (!ReducePackCpuTest.cpuHere()) { return; }
        int32 nH = 8;
        int64 n = (int64) nH * 130L;
        float32[] h = heap float32[n];
        int64 i = 0;
        while (i < n) {
            int64 slot = i % 130L;
            if (slot < 128L) {
                h[i] = (float32) ((i % 11L) - 5L) + 0.5f;
                if (slot == 0L) { h[i] = 127.0f; }
            } else if (slot == 128L) {
                h[i] = 0.0f;
            } else {
                h[i] = 1.0f;
            }
            i = i + 1;
        }
        ReducePackCpuTest.same(h, nH, 1);
    }

    /** cajeta-llm 15.2.20.3.16.15.2: the decode attend with the reduce + pack in its tail writes the attend then the
     *  reduce-pack launch's bytes into the staged activation, GQA-4 and GQA-8, twice so the counters re-arm. */
    @Test
    public void theFusedDecodePackIsTheAttendThenTheReducePack() {
        if (!ReducePackCpuTest.cpuHere()) { return; }
        String be #= Device.activeBackend();
        if (!KernelCap.usable("attnDecodePackCpuGqaKernel")) { DeviceSkip.noKernel("attnDecodePackCpuGqaKernel", be); return; }
        int64[] vc #= ValueCheck.mark();
        ReducePackCpuTest.fusedCase(32, 8, 7);
        ReducePackCpuTest.fusedCase(32, 8, 513);
        ReducePackCpuTest.fusedCase(32, 4, 300);
        ReducePackCpuTest.fusedCase(64, 8, 2000);
        ValueCheck.credit(vc);
    }

    static void fusedCase(int32 nH, int32 nKv, int32 count) {
        int32 hd = 128;
        int64 kvDim = (int64) (nKv * hd);
        int64 qn = (int64) (nH * hd);
        int64 kn = (int64) count * kvDim;
        float32 scale = 1.0f / Math.sqrt((float32) hd);
        float32[] qh #= heap float32[qn];
        float32[] kh #= heap float32[kn];
        float32[] vh #= heap float32[kn];
        int64 i = 0;
        while (i < qn) { qh[i] = (float32) (((i * 29L + 7L) % 53L) - 26L) / 13.0f; i = i + 1L; }
        i = 0;
        while (i < kn) {
            kh[i] = (float32) (((i * 31L + 3L) % 61L) - 30L) / 17.0f;
            vh[i] = (float32) (((i * 23L + 5L) % 47L) - 23L) / 11.0f;
            i = i + 1L;
        }
        KernelBuffer<float32> qb #= heap KernelBuffer<float32>((uint64) qn);
        qb.upload(qh);
        float16[] kf #= AttnKernel.halfOf(kh, kn);
        float16[] vf #= AttnKernel.halfOf(vh, kn);
        KernelBuffer<float16> kb #= heap KernelBuffer<float16>((uint64) kn);
        KernelBuffer<float16> vb #= heap KernelBuffer<float16>((uint64) kn);
        kb.upload(kf);
        vb.upload(vf);
        int64 pb = (int64) (nH / 2) * 320L;
        AttnKernel.setCpuDecodePack(false);
        Assert.isTrue(AttnKernel.attendDecodePartialsLaunchNoSync(qb, kb, vb, nH, nKv, hd, count, 0, scale));
        KernelBuffer<int8> rb #= heap KernelBuffer<int8>((uint64) pb);
        AttnKernel.reducePackLaunchNoSync(rb, nH);
        QuantKernel.stream().sync();
        AttnKernel.setCpuDecodePack(true);
        int8[] want #= heap int8[pb];
        rb.download(want, pb);
        int32 pass = 0;
        while (pass < 2) {
            KernelBuffer<int8> st = Linear.stagedPacked(qn);
            int8[] z #= heap int8[pb];
            st.upload(z, pb);
            AttnKernel.armDecodePack();
            Assert.isTrue(AttnKernel.attendDecodePartialsLaunchNoSync(qb, kb, vb, nH, nKv, hd, count, 0, scale));
            AttnKernel.reducePackLaunchNoSync(st, nH);
            QuantKernel.stream().sync();
            int8[] got #= heap int8[pb];
            st.download(got, pb);
            i = 0;
            while (i < pb) {
                if (i % 320L < 292L && got[i] != want[i]) {
                    Assert.fail("nH " + nH + " nKv " + nKv + " count " + count + " pass " + pass + ": packed byte " + i
                        + " is " + (int32) got[i] + ", the two launches' " + (int32) want[i]);
                }
                i = i + 1L;
            }
            pass = pass + 1;
        }
    }
}
