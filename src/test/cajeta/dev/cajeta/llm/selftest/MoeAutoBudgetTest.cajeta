package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * cajeta-llm 15.2.15.4 — the AUTO expert-residency budget is what the device
 * has free when the first slab asks, less the engine's own reserve; not half
 * the card. Measured before: a 24 GB part under a 30B-A3B bound 30 of 48
 * layers' slabs at "half" and served the rest from the host at 2.5 tok/s.
 */
public class MoeAutoBudgetTest {

    public MoeAutoBudgetTest() { return; }

    @Test
    public void theAutoBudgetIsFreeMemoryLessTheEngineReserve() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        ExpertBank.resetResidency();
        EngineOptions o #= heap EngineOptions(ResidentMoeDecodeTest.FIX);
        o.ctx = 128;
        o.maxSeqs = 2;
        o.blockTokens = 16;
        o.chunk = 64;
        LlmEngine e #= LlmEngine.load(#o);
        int64 budget = ExpertBank.residencyBudget();
        int64 free = ExpertBank.residencyBudgetFree();
        int64 reserve = ExpertBank.residencyBudgetReserve();
        int64 pool = e.model().deviceKvPoolBytes();
        e.close();
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
        // Frozen from a real reading, with the pool inside the reserve.
        Assert.isTrue(free > 0L);
        Assert.isTrue(reserve >= pool);
        int64 want = free - reserve;
        if (want < 0L) { want = 0L; }
        Assert.equals(want, budget);
        // And not the old rule, where a card's capacity set the budget.
        if (Device.memoryBytes() > 0L && free > reserve) {
            Assert.isTrue(budget != Device.memoryBytes() / 2L);
        }
    }
}
