package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.ModelConfig;
import cajeta.lang.String;

/** cajeta-llm 15.2.16.1: the prefill outputs are one set for every layer, sized to a chunk. */
public class BatchOutShareTest {

    public BatchOutShareTest() { return; }

    /** A toy model of `layers` layers and a 1024-position context, prewarmed. */
    static #CausalLM prewarmed(String tag, int32 layers) {
        String cfgPath = "/tmp/cajeta_llama_bos_" + tag + "_cfg.json";
        String stPath = "/tmp/cajeta_llama_bos_" + tag + ".safetensors";
        ToyModel.writeConfig(cfgPath, "LlamaForCausalLM", 64, 256, layers, 4, 2, 0, 96, 1024, false);
        ToyModel s #= ToyModel.spec(layers, 64, 256, 4, 2, 16, 96, false);
        ToyModel.writeWeights(stPath, s);
        ModelConfig cfg #= ModelConfig.parse(cfgPath);
        cfg.blockTokens = 4;
        CausalLM m = heap CausalLM(#cfg, 1024, 1, 0);
        Checkpoint ck #= Checkpoint.open(stPath);
        m.bind(ck, false);
        ck.close();
        m.prewarmPrefillWeights();
        return #m;
    }

    /** Bytes the prewarm allocates for batch outputs from a clean slate. */
    static int64 prewarmBytes(String tag, int32 layers) {
        Linear.resetSharedBatchOut();
        int64 b0 = Linear.batchOutAllocBytes();
        CausalLM m #= BatchOutShareTest.prewarmed(tag, layers);
        return Linear.batchOutAllocBytes() - b0;
    }

    /** Twice the layers allocate no more output bytes. */
    @Test
    public void theOutputsDoNotGrowWithTheLayerCount() {
        int64 two = BatchOutShareTest.prewarmBytes("l2", 2);
        int64 four = BatchOutShareTest.prewarmBytes("l4", 4);
        Assert.isTrue(two > 0L);
        Assert.equals(two, four);
    }

    /** A 1024-position context allocates outputs for a 512-row chunk, not 1024 rows. */
    @Test
    public void theOutputsAreSizedToTheChunkNotTheContext() {
        int64 got = BatchOutShareTest.prewarmBytes("c", 2);
        CausalLM m #= BatchOutShareTest.prewarmed("c2", 2);
        ModelConfig c = m.cfg;
        int64 outs = (int64) (c.qDim() + 2 * c.kvDim() + 2 * c.hiddenSize + 2 * c.intermediateSize);
        Assert.equals(512L * outs * 4L, got);
    }
}
