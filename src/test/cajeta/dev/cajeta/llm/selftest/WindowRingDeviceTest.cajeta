package dev.cajeta.llm.selftest;

import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.xpu.Device;
import dev.cajeta.unit.AfterEach;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.bench.Metrics;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.DecoderLayer;
import dev.cajeta.llm.model.DeviceKv;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.llm.model.ModelConfig;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** cajeta-llm plan 15.2.21.8: a windowed layer's device K/V is a ring of the window's rows, to the host path's answer. */
public class WindowRingDeviceTest {

    static final String DIR = "tmp/cajeta_llm_ring_dev";
    static final int32 LAYERS = 6;
    static final int32 WINDOW = 8;
    static final int32 CAP = 128;
    static final int32 V = 256;
    static boolean written = false;

    public WindowRingDeviceTest() { return; }

    @AfterEach
    public void restore() {
        QuantKernel.setRoutingEnabled(true);
        CausalLM.setDeviceAttention(true);
        return;
    }

    /** The six-layer Gemma 3 toy at head size `hd`: H 512 over one kv head. */
    static #ToyModel spec(int32 hd) {
        return ToyModel.specVariant(WindowRingDeviceTest.LAYERS, 512, 512, 512 / hd, 1, hd, WindowRingDeviceTest.V,
            true, true, true);
    }

    static #String configOf(int32 hd, boolean windowed) {
        return WindowRingDeviceTest.DIR + (windowed ? "/w" : "/n") + hd + ".json";
    }

    /** Writes, per head size, the weights and two configs: five windowed layers then a full one, and all full. */
    static void writeFixture() {
        if (WindowRingDeviceTest.written) { return; }
        Path dir #= Path.of(WindowRingDeviceTest.DIR);
        dir.mkdirs();
        int32 hd = 128;
        while (hd <= 256) {
            String tail #= "\"hidden_activation\":\"gelu_pytorch_tanh\",\"query_pre_attn_scalar\":" + hd
                + ",\"rope_local_base_freq\":10000.0,";
            ToyModel.writeConfigX(WindowRingDeviceTest.configOf(hd, true), "Gemma3ForCausalLM", 512, 512,
                WindowRingDeviceTest.LAYERS, 512 / hd, 1, hd, WindowRingDeviceTest.V, WindowRingDeviceTest.CAP, true,
                "\"sliding_window\":" + WindowRingDeviceTest.WINDOW + ",\"layer_types\":[\"sliding_attention\","
                + "\"sliding_attention\",\"sliding_attention\",\"sliding_attention\",\"sliding_attention\","
                + "\"full_attention\"]," + tail);
            ToyModel.writeConfigX(WindowRingDeviceTest.configOf(hd, false), "Gemma3ForCausalLM", 512, 512,
                WindowRingDeviceTest.LAYERS, 512 / hd, 1, hd, WindowRingDeviceTest.V, WindowRingDeviceTest.CAP, true,
                "\"layer_types\":[\"full_attention\",\"full_attention\",\"full_attention\",\"full_attention\","
                + "\"full_attention\",\"full_attention\"]," + tail);
            ToyModel s #= WindowRingDeviceTest.spec(hd);
            ToyModel.writeWeights(WindowRingDeviceTest.DIR + "/m" + hd + ".safetensors", s);
            hd = hd * 2;
        }
        WindowRingDeviceTest.written = true;
        return;
    }

    /** The toy bound with every layer's projections repacked as Q8_0. */
    static #CausalLM mk(int32 hd, boolean windowed) {
        WindowRingDeviceTest.writeFixture();
        ModelConfig cfg #= ModelConfig.parse(WindowRingDeviceTest.configOf(hd, windowed));
        CausalLM m #= heap CausalLM(#cfg, WindowRingDeviceTest.CAP, 1, 0);
        Checkpoint ck #= Checkpoint.open(WindowRingDeviceTest.DIR + "/m" + hd + ".safetensors");
        m.bind(ck, false);
        ck.close();
        ToyModel s #= WindowRingDeviceTest.spec(hd);
        int32 l = 0;
        while (l < WindowRingDeviceTest.LAYERS) {
            DecoderLayer d = m.model.layerArr[l];
            String p #= "model.layers." + l + ".";
            FourNormDeviceTest.rebind(d.selfAttn.qProj, s, p + "self_attn.q_proj.weight");
            FourNormDeviceTest.rebind(d.selfAttn.kProj, s, p + "self_attn.k_proj.weight");
            FourNormDeviceTest.rebind(d.selfAttn.vProj, s, p + "self_attn.v_proj.weight");
            FourNormDeviceTest.rebind(d.selfAttn.oProj, s, p + "self_attn.o_proj.weight");
            FourNormDeviceTest.rebind(d.mlp.gateProj, s, p + "mlp.gate_proj.weight");
            FourNormDeviceTest.rebind(d.mlp.upProj, s, p + "mlp.up_proj.weight");
            FourNormDeviceTest.rebind(d.mlp.downProj, s, p + "mlp.down_proj.weight");
            l = l + 1;
        }
        return #m;
    }

    /** Prefills `first` rows, then a chunk of `second` (0 for none), then `steps` greedy steps; `hostFrom` and
     *  `hostTo` bound the steps taken with device attention off. Tokens land in `toks`, the last logits in `last`. */
    static void run(CausalLM m, int32 first, int32 second, int32 steps, int32 hostFrom, int32 hostTo, int32[] toks,
            float32[] last) {
        int32[] p #= RoutableFixtureTest.promptOf(first + second, 3);
        int32 nxt = m.prefill(p, first);
        if (second > 0) { nxt = m.stepSeq(0, p, first, second); }
        int32[] one = heap int32[1];
        int32 g = 0;
        while (g < steps) {
            if (g == hostFrom) { CausalLM.setDeviceAttention(false); }
            if (g == hostTo) { CausalLM.setDeviceAttention(true); }
            one[0] = nxt;
            nxt = m.stepSeq(0, one, 0, 1);
            toks[g] = nxt;
            g = g + 1;
        }
        CausalLM.setDeviceAttention(true);
        FourNormDeviceTest.copyLogits(m, last);
        return;
    }

    /** Runs the device model and its host twin through the same schedule and holds the device to the host. */
    static void sameAsHost(int32 hd, int32 first, int32 second, int32 steps, int32 hostFrom, int32 hostTo,
            String what) {
        if (!FourNormDeviceTest.deviceHere()) {
            RoutableFixtureTest.saySkip();
            return;
        }
        int32 v = WindowRingDeviceTest.V;
        CausalLM dev #= WindowRingDeviceTest.mk(hd, true);
        Assert.isTrue(dev.deviceRoutable());
        Assert.isTrue(dev.batchRoutedFor(first));
        int64[] vc #= ValueCheck.mark();
        int32[] td = heap int32[steps];
        float32[] ld = heap float32[v];
        WindowRingDeviceTest.run(dev, first, second, steps, hostFrom, hostTo, td, ld);

        QuantKernel.setRoutingEnabled(false);
        CausalLM host #= WindowRingDeviceTest.mk(hd, true);
        int32[] th = heap int32[steps];
        float32[] lh = heap float32[v];
        WindowRingDeviceTest.run(host, first, second, steps, 0 - 1, 0 - 1, th, lh);
        QuantKernel.setRoutingEnabled(true);

        CausalLM flat #= WindowRingDeviceTest.mk(hd, false);
        int32[] tf = heap int32[steps];
        float32[] lf = heap float32[v];
        WindowRingDeviceTest.run(flat, first, second, steps, 0 - 1, 0 - 1, tf, lf);

        float64 cos = Metrics.cosine(lh, ld, v);
        float64 kl = Metrics.softmaxKl(lh, ld, v);
        float64 klFlat = Metrics.softmaxKl(lh, lf, v);
        System.stdout.println("  15.2.21.8 " + what + " hd " + hd + ": cosine " + cos + " kl " + kl
            + "; unwindowed control kl " + klFlat);
        Assert.isTrue(cos >= 0.99998);
        Assert.isTrue(kl <= 1.0e-6);
        Assert.isTrue(klFlat > 1.0e-6);
        int32 t = 0;
        while (t < steps) {
            Assert.equals((int64) th[t], (int64) td[t]);
            t = t + 1;
        }
        ValueCheck.credit(vc);
        return;
    }

    @Test
    public void theDeviceKvTakesAWindowedConfig() {
        WindowRingDeviceTest.writeFixture();
        ModelConfig cfg #= ModelConfig.parse(WindowRingDeviceTest.configOf(128, true));
        Assert.equals(WindowRingDeviceTest.WINDOW, cfg.windowForLayer(0));
        Assert.equals(0, cfg.windowForLayer(5));
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCap.ringHere()) { DeviceSkip.noKernel("attnScorePrefillRowKernel", be); return; }
        Assert.isTrue(DeviceKv.supports(cfg));
    }

    @Test
    public void aWindowedLayerHoldsAWindowOfRows() {
        WindowRingDeviceTest.writeFixture();
        ModelConfig cfg #= ModelConfig.parse(WindowRingDeviceTest.configOf(128, true));
        Assert.equals(WindowRingDeviceTest.WINDOW, DeviceKv.planeRows(cfg, WindowRingDeviceTest.CAP, 0));
        Assert.equals(WindowRingDeviceTest.CAP, DeviceKv.planeRows(cfg, WindowRingDeviceTest.CAP, 5));
        Assert.equals(4, DeviceKv.planeRows(cfg, 4, 0));
        CausalLM m #= heap CausalLM(#cfg, WindowRingDeviceTest.CAP, 1, 0);
        int64 rows = (int64) (5 * WindowRingDeviceTest.WINDOW + WindowRingDeviceTest.CAP);
        Assert.equals(2L * rows * 128L * 2L, m.deviceKvPoolBytes());
    }

    @Test
    public void decodePastTheWindowMatchesTheHost() {
        WindowRingDeviceTest.sameAsHost(128, 8, 0, 6, 0 - 1, 0 - 1, "decode past the window");
        WindowRingDeviceTest.sameAsHost(256, 8, 0, 6, 0 - 1, 0 - 1, "decode past the window");
    }

    @Test
    public void aPrefillLongerThanTheWindowMatchesTheHost() {
        WindowRingDeviceTest.sameAsHost(128, 12, 0, 4, 0 - 1, 0 - 1, "prefill 12");
        WindowRingDeviceTest.sameAsHost(256, 12, 0, 4, 0 - 1, 0 - 1, "prefill 12");
    }

    @Test
    public void aSecondChunkAcrossTheRingMatchesTheHost() {
        WindowRingDeviceTest.sameAsHost(128, 12, 10, 4, 0 - 1, 0 - 1, "prefill 12 then 10");
        WindowRingDeviceTest.sameAsHost(256, 6, 5, 4, 0 - 1, 0 - 1, "prefill 6 then 5");
    }

    @Test
    public void hostStepsBetweenDeviceStepsKeepTheRing() {
        WindowRingDeviceTest.sameAsHost(128, 12, 0, 9, 3, 6, "host steps 3 to 5");
        WindowRingDeviceTest.sameAsHost(256, 8, 0, 9, 3, 6, "host steps 3 to 5");
    }
}
