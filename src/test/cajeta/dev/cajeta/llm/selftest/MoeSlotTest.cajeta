package dev.cajeta.llm.selftest;

import cajeta.math.Tensor;
import cajeta.xpu.Device;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import cajeta.lang.Math;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.ExpertBank;
import dev.cajeta.llm.model.MoeFfn;

/**
 * moe-expert-cache plan 1.1 — device-resident expert slots (spec T1,
 * §3.1/§3.2).
 *
 * A slot is admitted on FIRST device dispatch — one mapping read, one
 * upload, one repack chain — and every later dispatch of that expert
 * reads the slot with zero host traffic (spec 3.1.1/3.1.2). Past the
 * budget an expert keeps the unit-28 windowed path; budget 0 IS that
 * path (spec 3.1.7). All tests gate on the device grouped route the
 * dispatch itself uses (deviceGroupedFor), the MoeGroupedTest pattern.
 */
public class MoeSlotTest {

    public MoeSlotTest() { return; }

    static void saySkip() {
        System.stdout.println("  (skipped: backend "
            + Device.activeBackend()
            + " has no batch route for the moe fixture)");
        return;
    }

    /** 8 rows with varied content so routing spreads across experts —
     *  the probe pair plus ramps. */
    static #Tensor<float32> rowsOf(int32 rows) {
        int32 h = MoeForwardTest.H;
        int64[] bs = heap int64[1];
        bs[0] = (int64) (rows * h);
        Tensor<float32> x #= Tensor.zeros<float32>(bs);
        float32[] xb = x.hostBuffer();
        int64 xo = x.hostBase();
        int32 r = 0;
        while (r < rows) {
            int32 j = 0;
            while (j < h) {
                int32 v = ((j * (3 + r) + r * 7) % 25) - 12;
                if (r % 2 == 1) { v = 0 - v; }
                xb[xo + (int64) (r * h + j)]
                    = (float32) v / 64.0f;
                j = j + 1;
            }
            r = r + 1;
        }
        return #x;
    }

    static #Tensor<float32> outOf(int32 rows) {
        int64[] bs = heap int64[1];
        bs[0] = (int64) (rows * MoeForwardTest.H);
        Tensor<float32> o #= Tensor.zeros<float32>(bs);
        return #o;
    }

    /** 1.1.1 — the form audit: what the budget was CHARGED for an
     *  admitted expert equals the device weight bytes its slot
     *  actually holds — after dispatches at TWO row counts, because
     *  the route (and so the buffer set: packed alone, or packed plus
     *  a derived form) depends on rows, and a buffer bound by a later
     *  route after the charge is exactly the silent under-accounting
     *  this test exists to catch (spec 3.1.4). */
    @Test
    public void slotChargeMatchesTheBuffersTheSlotHolds() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);

        // Small group first, then a larger one: two dispatch shapes,
        // two chances for the route tree to bind different forms.
        Tensor<float32> x3 #= MoeSlotTest.rowsOf(3);
        Tensor<float32> o3 #= MoeSlotTest.outOf(3);
        moe.forwardBatch(x3, o3, 3, 0);
        Tensor<float32> x8 #= MoeSlotTest.rowsOf(8);
        Tensor<float32> o8 #= MoeSlotTest.outOf(8);
        moe.forwardBatch(x8, o8, 8, 0);

        ExpertBank gb = moe.gateBank();
        int32 checked = 0;
        int32 e = 0;
        while (e < gb.experts()) {
            if (gb.isAdmitted(e)) {
                // Charged == held, always. What "held" means is
                // regime-dependent (unit 40): under a bank SLAB the
                // packed bytes live on the slab's own charge and a
                // slot carries only its derived forms; per-expert
                // slots carry at least their packed stride.
                Assert.equals(gb.slotBytesOf(e), gb.slotDeviceBytes(e));
                if (!gb.slabReady()) {
                    Assert.isTrue(gb.slotDeviceBytes(e)
                        >= gb.strideBytes());
                }
                checked = checked + 1;
            }
            e = e + 1;
        }
        Assert.isTrue(checked > 0);
        if (gb.slabReady()) {
            // The bank's packed bytes are on the slab's charge.
            Assert.isTrue(gb.slabBytes()
                >= (int64) gb.experts() * gb.strideBytes());
            Assert.isTrue(gb.residentBytes() >= gb.slabBytes());
        }
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }

    /** 1.1.2 — admission happens ONCE: an identical second batch
     *  admits nothing and reads nothing from the mapping; it is served
     *  from slots (spec 3.1.1, plan 9.1.1's mechanism). */
    @Test
    public void secondIdenticalBatchAdmitsNothingAndReadsNoBytes() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);

        Tensor<float32> x #= MoeSlotTest.rowsOf(8);
        Tensor<float32> o #= MoeSlotTest.outOf(8);
        moe.forwardBatch(x, o, 8, 0);
        int64 admits = ExpertBank.residencyAdmissions();
        Assert.isTrue(admits > 0L);

        // Snapshot the mapping-read counters, then go again.
        moe.resetTouched();
        int64 hits0 = ExpertBank.residencyHits();
        moe.forwardBatch(x, o, 8, 0);
        Assert.equals(admits, ExpertBank.residencyAdmissions());
        Assert.isTrue(ExpertBank.residencyHits() > hits0);
        ExpertBank gb = moe.gateBank();
        int32 e = 0;
        while (e < gb.experts()) {
            Assert.equals(0L, gb.touchedBytes(e));
            e = e + 1;
        }
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }

    /** 1.1.3 — budget 0 is the T0 path on the same binary (spec
     *  3.1.7): no slot allocated, asserted on the counters, not on
     *  the absence of a crash; the dispatch still ran (windowed
     *  counter advanced). */
    @Test
    public void budgetZeroAllocatesNoSlotAndStaysWindowed() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(0L);
        int64 w0 = ExpertBank.residencyWindowed();
        Tensor<float32> x #= MoeSlotTest.rowsOf(8);
        Tensor<float32> o #= MoeSlotTest.outOf(8);
        moe.forwardBatch(x, o, 8, 0);
        Assert.equals(0L, ExpertBank.residencyAdmissions());
        Assert.equals(0L, ExpertBank.residencyUsedBytes());
        Assert.equals(0L, (int64) moe.gateBank().admittedCount());
        Assert.isTrue(ExpertBank.residencyWindowed() > w0);
        ExpertBank.resetResidency();
    }

    /** 1.1.4 — a capped budget degrades, IDENTICALLY (spec 7.1.1,
     *  9.1.3): both paths feed the same kernels the same working-form
     *  bytes, so the outputs must be bit-identical, not merely close —
     *  anything weaker hides a staging bug. The vacuity guard: the
     *  capped run must show BOTH admissions and windowed fallbacks,
     *  or the identity arm proved nothing. */
    @Test
    public void cappedBudgetIsBitIdenticalAndActuallyMixed() {
        CausalLM ma #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moeA = ma.moeAt(0);
        if (!moeA.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        int32 rows = 8;
        int32 h = MoeForwardTest.H;

        // FULL arm: everything admits; remember what that cost.
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        Tensor<float32> x #= MoeSlotTest.rowsOf(rows);
        Tensor<float32> oa #= MoeSlotTest.outOf(rows);
        MoeSlotTest.runOnce(moeA, x, oa, rows);
        int64 fullBytes = ExpertBank.residencyAdmissionBytes();
        Assert.isTrue(fullBytes > 0L);

        // CAPPED arm on a FRESH model: half the full bytes admits some
        // experts and must refuse others.
        CausalLM mb #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moeB = mb.moeAt(0);
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(fullBytes / 2L);
        Tensor<float32> ob #= MoeSlotTest.outOf(rows);
        MoeSlotTest.runOnce(moeB, x, ob, rows);
        Assert.isTrue(ExpertBank.residencyAdmissions() > 0L);
        Assert.isTrue(ExpertBank.residencyWindowed() > 0L);

        float32[] ab = oa.hostBuffer();
        int64 ao = oa.hostBase();
        float32[] bb = ob.hostBuffer();
        int64 bo = ob.hostBase();
        int32 i = 0;
        while (i < rows * h) {
            Assert.isTrue(ab[ao + (int64) i] == bb[bo + (int64) i]);
            i = i + 1;
        }
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }

    static void runOnce(MoeFfn moe, Tensor<float32> x,
            Tensor<float32> o, int32 rows) {
        moe.forwardBatch(x, o, rows, 0);
        return;
    }

    /** 2.1.2 + 2.1.1 + the resident half of 2.1.4 — decode on
     *  resident experts launches on the DEVICE and reads NOTHING from
     *  the mapping: after a batch admits row 0's experts, a forwardRow
     *  of that same row takes exactly 3*used slot hits (gate, up,
     *  down per selected expert), every bank's touched counter stays
     *  0, and each slot's charge still equals what it holds (the
     *  decode route must not bind an uncharged form). The T0 arm —
     *  budget 0 reads used strides per token — stays in
     *  MoeForwardTest.aDecodeCountsUsedStridesPerToken, which runs at
     *  the 0 default. */
    @Test
    public void residentDecodeHitsSlotsAndReadsNoBytes() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        Tensor<float32> x #= MoeSlotTest.rowsOf(8);
        Tensor<float32> o #= MoeSlotTest.outOf(8);
        moe.forwardBatch(x, o, 8, 0);

        // Row 0's routing was in the batch, so its experts are
        // admitted in all three banks.
        moe.resetTouched();
        int64 hits0 = ExpertBank.residencyHits();
        Tensor<float32> or1 #= MoeSlotTest.outOf(1);
        moe.forwardRow(x, 0L, or1, 0L, 0);
        int64 dHits = ExpertBank.residencyHits() - hits0;
        Assert.equals((int64) (3 * moe.used()), dHits);
        int32 b = 0;
        while (b < 3) {
            ExpertBank bank = moe.gateBank();
            if (b == 1) { bank = moe.upBank(); }
            if (b == 2) { bank = moe.downBank(); }
            int32 e = 0;
            while (e < bank.experts()) {
                Assert.equals(0L, bank.touchedBytes(e));
                if (bank.isAdmitted(e)) {
                    Assert.equals(bank.slotBytesOf(e),
                        bank.slotDeviceBytes(e));
                }
                e = e + 1;
            }
            b = b + 1;
        }
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }

    /** Budget 0: a decode row takes ZERO slot hits — the negative arm
     *  without which the counter above could count anything. */
    @Test
    public void budgetZeroDecodeTakesNoSlotHits() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(0L);
        int64 hits0 = ExpertBank.residencyHits();
        Tensor<float32> x #= MoeSlotTest.rowsOf(1);
        Tensor<float32> o #= MoeSlotTest.outOf(1);
        moe.forwardRow(x, 0L, o, 0L, 0);
        Assert.equals(hits0, ExpertBank.residencyHits());
        ExpertBank.resetResidency();
    }

    /** 2.1.3 — resident decode agrees with the host decode. The
     *  device mat-vec rides the q8 integer route (activations
     *  quantized to q8_K), so this is 13.21's quantized-execution
     *  regime, not the bit-exact one: thresholds CALIBRATED below
     *  from the measured run (printed), with the host arm exact.
     *  Mixed (capped) sits between the brackets by construction —
     *  each expert takes one arm or the other, and both arms are
     *  asserted here. */
    @Test
    public void residentDecodeMatchesHostDecode() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        int32 h = MoeForwardTest.H;
        Tensor<float32> x #= MoeSlotTest.rowsOf(8);

        // HOST arm first (budget 0, routing pinned off so the shexp
        // Linears stay exact-host too — the MoeGroupedTest control).
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(0L);
        QuantKernel.setRoutingEnabled(false);
        Tensor<float32> oh #= MoeSlotTest.outOf(1);
        moe.forwardRow(x, 0L, oh, 0L, 0);
        QuantKernel.setRoutingEnabled(true);

        // RESIDENT arm: admit via a batch, then decode the same row.
        ExpertBank.setResidencyBudget(1152921504606846976L);
        Tensor<float32> ob #= MoeSlotTest.outOf(8);
        moe.forwardBatch(x, ob, 8, 0);
        int64 hits0 = ExpertBank.residencyHits();
        Tensor<float32> od #= MoeSlotTest.outOf(1);
        moe.forwardRow(x, 0L, od, 0L, 0);
        Assert.isTrue(ExpertBank.residencyHits() > hits0);

        float32[] hb = oh.hostBuffer();
        int64 ho = oh.hostBase();
        float32[] db = od.hostBuffer();
        int64 dof = od.hostBase();
        float64 dot = 0.0;
        float64 nh = 0.0;
        float64 nd = 0.0;
        float64 maxAbs = 0.0;
        int32 i = 0;
        while (i < h) {
            float64 a = (float64) hb[ho + (int64) i];
            float64 c = (float64) db[dof + (int64) i];
            dot = dot + a * c;
            nh = nh + a * a;
            nd = nd + c * c;
            float64 ad = a - c;
            if (ad < 0.0) { ad = 0.0 - ad; }
            if (ad > maxAbs) { maxAbs = ad; }
            i = i + 1;
        }
        float64 cos = dot / (Math.sqrt(nh) * Math.sqrt(nd));
        System.stdout.println("  mec 2.1.3 ffn-row: cosine " + cos
            + "  maxAbs " + maxAbs);
        Assert.isTrue(cos >= 0.9999);
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }

    /** 1.1.5 — accounting is readable and consistent (spec 3.2.4):
     *  each bank's resident bytes are the sum of its admitted slots'
     *  charges, and the process total is the sum over the banks that
     *  admitted. */
    @Test
    public void accountingSumsAcrossSlotsAndBanks() {
        CausalLM m #= MoeForwardTest.bindPath(MoeForwardTest.FIX);
        MoeFfn moe = m.moeAt(0);
        if (!moe.deviceGroupedFor(8)) {
            MoeSlotTest.saySkip();
            return;
        }
        ExpertBank.resetResidency();
        ExpertBank.setResidencyBudget(1152921504606846976L);
        Tensor<float32> x #= MoeSlotTest.rowsOf(8);
        Tensor<float32> o #= MoeSlotTest.outOf(8);
        moe.forwardBatch(x, o, 8, 0);

        int64 total = 0L;
        int32 b = 0;
        while (b < 3) {
            ExpertBank bank = moe.gateBank();
            if (b == 1) { bank = moe.upBank(); }
            if (b == 2) { bank = moe.downBank(); }
            int64 bankSum = 0L;
            int32 n = 0;
            int32 e = 0;
            while (e < bank.experts()) {
                if (bank.isAdmitted(e)) {
                    bankSum = bankSum + bank.slotBytesOf(e);
                    n = n + 1;
                }
                e = e + 1;
            }
            // Unit 40: a bound slab carries the bank's packed bytes on
            // its own charge; slot charges are derived forms only. The
            // sum invariant holds by construction in BOTH regimes.
            Assert.equals(bankSum + bank.slabBytes(),
                bank.residentBytes());
            if (bank.slabReady()) {
                // Slots materialize lazily under a slab; every expert
                // is admitted but not every slot object exists yet.
                Assert.isTrue((int64) bank.admittedCount() <= (int64) n);
            } else {
                Assert.equals((int64) n, (int64) bank.admittedCount());
            }
            total = total + bankSum + bank.slabBytes();
            b = b + 1;
        }
        Assert.isTrue(total > 0L);
        Assert.equals(total, ExpertBank.residencyUsedBytes());
        ExpertBank.setResidencyBudget(0L);
        ExpertBank.resetResidency();
    }
}
