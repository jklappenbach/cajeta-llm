package dev.cajeta.llm.selftest;

import cajeta.lang.Optional;
import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelManifest;
import dev.cajeta.llm.bench.AlignProbe;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;

/**
 * xpu-kernel-adaptor 7.0.5: every kernel launched through a block the
 * compiler cannot see as a constant declares its structural ceiling,
 * `@Occupancy(maxThreads = N)`, and N is at or above the block its
 * launcher passes. A ceiling below a real launch is a launch failure, not
 * a slowdown, so the number is read off the launcher here and pinned: a
 * launcher that grows its block past the declaration fails this test
 * before it fails a launch.
 *
 * The 24 kernels are the ones the build named `[xpu-kernel-unbounded]`
 * until 7.0.5: the scalar per-row mat-vecs and the row-read probe at
 * `QuantKernel.rowsPerBlock()`, the mxfp4 cooperative four at
 * `QuantKernel.mxfp4CoopBlock()`, the three alignment probes at
 * `AlignProbe.group()`, and the converted q2k wave kernel at
 * `QuantKernel.waveRowBlock()`.
 *
 * The manifest carries the pin (`threadsPerGroup`) only where the backend
 * records it, and that is asked as a capability of the manifests here, not
 * by backend name.
 */
public class KernelCeilingTest {

    public KernelCeilingTest() { return; }

    /** Does any registered kernel's manifest carry a block pin here? */
    static boolean anyPinRecorded() {
        int32 n = Device.registeredKernelCount();
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            KernelManifest m #= KernelManifest.of(name);
            if (m != null) {
                Optional<int32> t = m.threadsPerGroup();
                if (t.isPresent()) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    static void ceiling(String kernel, int32 launched) {
        KernelManifest m #= KernelManifest.of(kernel);
        if (m == null) {
            Assert.fail(kernel + ": no manifest on this backend");
            return;
        }
        Optional<int32> t = m.threadsPerGroup();
        if (!t.isPresent()) {
            Assert.fail(kernel + ": launched at " + launched + " through a block the "
                + "compiler cannot bound, and no ceiling is declared; give it "
                + "@Occupancy(maxThreads = N) (xpu-kernel-adaptor 7.0.5)");
            return;
        }
        if (t.get() < launched) {
            Assert.fail(kernel + ": declared ceiling " + t.get() + " is below its "
                + "launch block " + launched + ", which is a launch failure, not a "
                + "slowdown");
            return;
        }
        Optional<int32> mx = KernelManifest.measuredMaxThreads(kernel);
        if (mx.isPresent() && mx.get() < launched) {
            Assert.fail(kernel + ": the loaded code object accepts at most " + mx.get()
                + " threads, below the launch block " + launched);
            return;
        }
    }

    @Test
    public void everyDerivedBlockKernelDeclaresACeilingAtOrAboveItsLaunch() {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return; }
        if (!KernelCeilingTest.anyPinRecorded()) {
            DeviceSkip.cannot("this backend's manifests record no block pin, so no "
                + "ceiling can be read here");
            return;
        }
        int32 rpb = QuantKernel.rowsPerBlock();
        KernelCeilingTest.ceiling("q4kMatVecKernel", rpb);
        KernelCeilingTest.ceiling("q4kMatVecKernelIL", rpb);
        KernelCeilingTest.ceiling("q4kQ8MatVecKernel", rpb);
        KernelCeilingTest.ceiling("q4kQ8PackedMatVecKernel", rpb);
        KernelCeilingTest.ceiling("q40MatVecKernel", rpb);
        KernelCeilingTest.ceiling("q41MatVecKernel", rpb);
        KernelCeilingTest.ceiling("q50MatVecKernel", rpb);
        KernelCeilingTest.ceiling("q51MatVecKernel", rpb);
        KernelCeilingTest.ceiling("q5kMatVecKernel", rpb);
        KernelCeilingTest.ceiling("q6kMatVecKernel", rpb);
        KernelCeilingTest.ceiling("q8MatVecKernel", rpb);
        KernelCeilingTest.ceiling("iq4nlMatVecKernel", rpb);
        KernelCeilingTest.ceiling("iq4xsMatVecKernel", rpb);
        KernelCeilingTest.ceiling("mxfp4MatVecKernel", rpb);
        KernelCeilingTest.ceiling("mxfp4MatVecKernelFast3", rpb);
        KernelCeilingTest.ceiling("rowReadKernel", rpb);
        int32 coop = QuantKernel.mxfp4CoopBlock();
        KernelCeilingTest.ceiling("mxfp4MatVecKernelCoop", coop);
        KernelCeilingTest.ceiling("mxfp4QuantActKernel", coop);
        KernelCeilingTest.ceiling("mxfp4MatVecKernelCoopQ8", coop);
        KernelCeilingTest.ceiling("mxfp4MatVecKernelCoopQ8Surface", coop);
        int32 probe = AlignProbe.group();
        KernelCeilingTest.ceiling("flatReadKernel", probe);
        KernelCeilingTest.ceiling("wideReadKernel", probe);
        KernelCeilingTest.ceiling("skewReadKernel", probe);
        KernelCeilingTest.ceiling("q2kQ8WaveMatVecKernel",
            (int32) QuantKernel.waveRowBlock());
    }
}
