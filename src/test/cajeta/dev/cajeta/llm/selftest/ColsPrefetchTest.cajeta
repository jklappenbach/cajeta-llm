package dev.cajeta.llm.selftest;

import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.unit.Assert;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import cajeta.lang.String;
import cajeta.lang.Cajeta;

/** cajeta-llm 15.2.12.3.1 and .3.4.1: the prefetching and two-row Cols mat-vecs match the plain ones bit for bit at every column count, and a probe picks among them. */
public class ColsPrefetchTest {

    public ColsPrefetchTest() { return; }

    /** Whether the plain and prefetching Cols kernels of `q` ("q4k" or "q6k") run here; skips by name when not. */
    static boolean both(String q) {
        String be #= Device.activeBackend();
        if (be.equals("none")) { DeviceSkip.cannot("no XPU backend"); return false; }
        String plain = "q4kQ8WaveMatVecColsKernel";
        String pf = "q4kQ8WavePfMatVecColsKernel";
        if (q.equals("q6k")) {
            plain = "q6kQ8WaveMatVecColsKernel";
            pf = "q6kQ8WavePfMatVecColsKernel";
        }
        String r2 = "q4kQ8WaveR2MatVecColsKernel";
        if (q.equals("q6k")) { r2 = "q6kQ8WaveR2MatVecColsKernel"; }
        if (!KernelCap.usable(plain)) { DeviceSkip.noKernel(plain, be); return false; }
        if (!KernelCap.usable(pf)) { DeviceSkip.noKernel(pf, be); return false; }
        if (!KernelCap.usable(r2)) { DeviceSkip.noKernel(r2, be); return false; }
        return true;
    }

    /** `ncols` columns of `rows` x `cols` through the Cols launcher of `q`, the variant pinned to `pin`, over a seeded output when `accum`. */
    static #float32[] run(String q, int64 rows, int64 cols, int32 ncols, boolean accum, int32 pin) {
        boolean six = q.equals("q6k");
        int8[] raw #= MatVecPrefetchTest.weight(rows * (cols / 256L));
        if (six) { raw #= MatVecPrefetchTest.q6Weight(rows, cols); }
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xp #= heap int8[pb * (int64) ncols];
        int8[] one #= heap int8[pb];
        float32[] x #= QuantKernelTest.activations(cols);
        int32 c = 0;
        while (c < ncols) {
            int64 z = 0;
            while (z < cols) { x[z] = x[z] * -1.25f + 0.01f * (float32) c; z = z + 1; }
            Quant.q8kPack(x, 0L, cols, one);
            int64 k = 0;
            while (k < pb) { xp[(int64) c * pb + k] = one[k]; k = k + 1; }
            c = c + 1;
        }
        KernelBuffer<int8> wb #= heap KernelBuffer<int8>((uint64) raw.count());
        KernelBuffer<int8> xb #= heap KernelBuffer<int8>((uint64) xp.count());
        wb.upload(raw);
        xb.upload(xp);
        int64 n = rows * (int64) ncols;
        float32[] seed #= heap float32[n];
        int64 r = 0;
        while (r < n) { seed[r] = 0.25f * (float32) ((r % 9L) - 4L); r = r + 1; }
        KernelBuffer<float32> y #= heap KernelBuffer<float32>((uint64) n);
        y.upload(seed, n);
        if (six) {
            QuantKernel.setQ6ColsPrefetch(pin);
            QuantKernel.q6kQ8WaveMatVecColsLaunchNoSync(y, wb, xb, rows, cols, 0L, ncols, rows, pb, accum);
        } else {
            QuantKernel.setQ4ColsPrefetch(pin);
            QuantKernel.q4kQ8WaveMatVecColsLaunchNoSync(y, wb, xb, rows, cols, 0L, ncols, rows, pb, accum);
        }
        KernelStream s = QuantKernel.stream();
        s.sync();
        QuantKernel.setQ4ColsPrefetch(0);
        QuantKernel.setQ6ColsPrefetch(0);
        float32[] got #= heap float32[n];
        y.download(got, n);
        return #got;
    }

    /** Fails naming the first output where the prefetching variant of `q` differs from the plain one. */
    static void same(String q, int64 rows, int64 cols, int32 ncols, boolean accum) {
        ColsPrefetchTest.sameAs(q, rows, cols, ncols, accum, 1);
    }

    /** Fails naming the first output where variant `pin` of `q` differs from the plain one. */
    static void sameAs(String q, int64 rows, int64 cols, int32 ncols, boolean accum, int32 pin) {
        float32[] plain #= ColsPrefetchTest.run(q, rows, cols, ncols, accum, 2);
        float32[] pf #= ColsPrefetchTest.run(q, rows, cols, ncols, accum, pin);
        QuantKernelTest.assertLive(plain, "plain " + q + " cols mat-vec");
        int64 n = rows * (int64) ncols;
        int64 i = 0;
        while (i < n) {
            if (Cajeta.f32ToBits(plain[i]) != Cajeta.f32ToBits(pf[i])) {
                Assert.fail(q + " variant " + pin + " " + rows + "x" + cols + " at " + ncols + " columns" + (accum ? " accum" : "")
                    + ": column " + (i / rows) + " row " + (i % rows) + " is " + pf[i] + ", plain " + plain[i]);
                return;
            }
            i = i + 1;
        }
    }

    /** Every column count from one to the most a launch serves, at a row count that is not a multiple of anything. */
    static void everyWidth(String q, int64 rows, int64 cols) {
        ColsPrefetchTest.same(q, rows, cols, 1, false);
        ColsPrefetchTest.same(q, rows, cols, 2, false);
        ColsPrefetchTest.same(q, rows, cols, 3, false);
        ColsPrefetchTest.same(q, rows, cols, 4, false);
        ColsPrefetchTest.same(q, rows, cols, 5, false);
        ColsPrefetchTest.same(q, rows, cols, 8, false);
    }

    @Test
    public void q4MatchesAtEveryColumnCount() {
        if (!ColsPrefetchTest.both("q4k")) { return; }
        ColsPrefetchTest.everyWidth("q4k", 13L, 4096L);
    }

    @Test
    public void q4MatchesAtTheDownShapeAndShortRows() {
        if (!ColsPrefetchTest.both("q4k")) { return; }
        ColsPrefetchTest.same("q4k", 9L, 14336L, 4, false);
        ColsPrefetchTest.same("q4k", 11L, 768L, 4, false);
    }

    @Test
    public void q4MatchesInTheAccumulateForm() {
        if (!ColsPrefetchTest.both("q4k")) { return; }
        ColsPrefetchTest.same("q4k", 19L, 4096L, 4, true);
    }

    @Test
    public void q6MatchesAtEveryColumnCount() {
        if (!ColsPrefetchTest.both("q6k")) { return; }
        ColsPrefetchTest.everyWidth("q6k", 13L, 4096L);
    }

    @Test
    public void q6MatchesAtTheDownShapeAndShortRows() {
        if (!ColsPrefetchTest.both("q6k")) { return; }
        ColsPrefetchTest.same("q6k", 9L, 14336L, 4, false);
        ColsPrefetchTest.same("q6k", 11L, 768L, 4, false);
    }

    @Test
    public void q6MatchesInTheAccumulateForm() {
        if (!ColsPrefetchTest.both("q6k")) { return; }
        ColsPrefetchTest.same("q6k", 19L, 14336L, 4, true);
    }

    /** FIRES: pinned to the prefetch variant, each Cols launcher launches it. */
    @Test
    public void theLaunchersTakeThePrefetchKernelWhenItIsFaster() {
        if (!ColsPrefetchTest.both("q4k") || !ColsPrefetchTest.both("q6k")) { return; }
        int64 b4 = QuantKernel.q4ColsPrefetchLaunches();
        int64 b6 = QuantKernel.q6ColsPrefetchLaunches();
        ColsPrefetchTest.run("q4k", 8L, 2048L, 4, false, 1);
        ColsPrefetchTest.run("q6k", 8L, 2048L, 4, false, 1);
        Assert.isTrue(QuantKernel.q4ColsPrefetchLaunches() == b4 + 1L);
        Assert.isTrue(QuantKernel.q6ColsPrefetchLaunches() == b6 + 1L);
    }

    /** DOES NOT FIRE: pinned to the plain variant, each Cols launcher keeps it. */
    @Test
    public void theLaunchersKeepThePlainKernelWhenItIsFaster() {
        if (!ColsPrefetchTest.both("q4k") || !ColsPrefetchTest.both("q6k")) { return; }
        int64 b4 = QuantKernel.q4ColsPrefetchLaunches();
        int64 b6 = QuantKernel.q6ColsPrefetchLaunches();
        ColsPrefetchTest.run("q4k", 8L, 2048L, 4, false, 2);
        ColsPrefetchTest.run("q6k", 8L, 2048L, 4, false, 2);
        Assert.isTrue(QuantKernel.q4ColsPrefetchLaunches() == b4);
        Assert.isTrue(QuantKernel.q6ColsPrefetchLaunches() == b6);
    }

    /** The variant a probe should pick from its three times: the fastest, plain on a tie with prefetch. */
    static int32 fastest(int64 pf, int64 plain, int64 r2) {
        int32 w = 2;
        int64 t = plain;
        if (pf < t) { w = 1; t = pf; }
        if (r2 < t) { w = 3; }
        return w;
    }

    /** The two Cols probes time all three variants each and keep the fastest, apart from the one-column probes. */
    @Test
    public void theProbesTimeAllThreeVariants() {
        if (!ColsPrefetchTest.both("q4k") || !ColsPrefetchTest.both("q6k")) { return; }
        QuantKernel.setQ4ColsPrefetch(0);
        QuantKernel.setQ6ColsPrefetch(0);
        int32 v4 = QuantKernel.q4ColsVariant();
        int32 v6 = QuantKernel.q6ColsVariant();
        Assert.isTrue(QuantKernel.q4ColsPrefetchProbePfNs() > 0L);
        Assert.isTrue(QuantKernel.q4ColsPrefetchProbePlainNs() > 0L);
        Assert.isTrue(QuantKernel.q4ColsRowsProbeNs() > 0L);
        Assert.isTrue(QuantKernel.q6ColsPrefetchProbePfNs() > 0L);
        Assert.isTrue(QuantKernel.q6ColsPrefetchProbePlainNs() > 0L);
        Assert.isTrue(QuantKernel.q6ColsRowsProbeNs() > 0L);
        Assert.equals((int64) ColsPrefetchTest.fastest(QuantKernel.q4ColsPrefetchProbePfNs(),
            QuantKernel.q4ColsPrefetchProbePlainNs(), QuantKernel.q4ColsRowsProbeNs()), (int64) v4);
        Assert.equals((int64) ColsPrefetchTest.fastest(QuantKernel.q6ColsPrefetchProbePfNs(),
            QuantKernel.q6ColsPrefetchProbePlainNs(), QuantKernel.q6ColsRowsProbeNs()), (int64) v6);
        QuantKernel.setQ4ColsPrefetch(0);
        QuantKernel.setQ6ColsPrefetch(0);
    }

    /** The Q4_K verdict is per shape class: the 4096-row shapes get their own probe at 4096 x 4096, and the
     *  gate shape keeps its own; a pin covers both (cajeta-llm 15.2.15.1: the two-row kernel wins at 4096
     *  rows while the three variants tie at the gate shape). */
    @Test
    public void theSmallShapeVariantIsProbedAtItsOwnShape() {
        if (!ColsPrefetchTest.both("q4k")) { return; }
        QuantKernel.setQ4ColsPrefetch(0);
        int32 small = QuantKernel.q4ColsVariantFor(4096L);
        Assert.isTrue(QuantKernel.q4ColsSmallProbePfNs() > 0L);
        Assert.isTrue(QuantKernel.q4ColsSmallProbePlainNs() > 0L);
        Assert.isTrue(QuantKernel.q4ColsSmallProbeRowsNs() > 0L);
        Assert.equals((int64) ColsPrefetchTest.fastest(QuantKernel.q4ColsSmallProbePfNs(),
            QuantKernel.q4ColsSmallProbePlainNs(), QuantKernel.q4ColsSmallProbeRowsNs()), (int64) small);
        Assert.equals((int64) QuantKernel.q4ColsVariant(), (int64) QuantKernel.q4ColsVariantFor(14336L));
        QuantKernel.setQ4ColsPrefetch(3);
        Assert.equals(3L, (int64) QuantKernel.q4ColsVariantFor(4096L));
        Assert.equals(3L, (int64) QuantKernel.q4ColsVariantFor(14336L));
        QuantKernel.setQ4ColsPrefetch(0);
    }

    /** Every column count, an odd row count (the last wave's second row is past the end) and the down shape, through the two-row variant. */
    static void everyWidthRows(String q, int64 rows, int64 cols) {
        ColsPrefetchTest.sameAs(q, rows, cols, 1, false, 3);
        ColsPrefetchTest.sameAs(q, rows, cols, 2, false, 3);
        ColsPrefetchTest.sameAs(q, rows, cols, 3, false, 3);
        ColsPrefetchTest.sameAs(q, rows, cols, 4, false, 3);
        ColsPrefetchTest.sameAs(q, rows, cols, 5, false, 3);
        ColsPrefetchTest.sameAs(q, rows, cols, 8, false, 3);
    }

    @Test
    public void q4TwoRowsMatchAtEveryColumnCountAndAnOddRowCount() {
        if (!ColsPrefetchTest.both("q4k")) { return; }
        ColsPrefetchTest.everyWidthRows("q4k", 13L, 4096L);
    }

    @Test
    public void q4TwoRowsMatchAtTheDownShapeShortRowsAndTheAccumulateForm() {
        if (!ColsPrefetchTest.both("q4k")) { return; }
        ColsPrefetchTest.sameAs("q4k", 9L, 14336L, 4, false, 3);
        ColsPrefetchTest.sameAs("q4k", 11L, 768L, 4, false, 3);
        ColsPrefetchTest.sameAs("q4k", 19L, 4096L, 4, true, 3);
        ColsPrefetchTest.sameAs("q4k", 1L, 4096L, 4, false, 3);
    }

    @Test
    public void q6TwoRowsMatchAtEveryColumnCountAndAnOddRowCount() {
        if (!ColsPrefetchTest.both("q6k")) { return; }
        ColsPrefetchTest.everyWidthRows("q6k", 13L, 4096L);
    }

    @Test
    public void q6TwoRowsMatchAtTheDownShapeShortRowsAndTheAccumulateForm() {
        if (!ColsPrefetchTest.both("q6k")) { return; }
        ColsPrefetchTest.sameAs("q6k", 9L, 14336L, 4, false, 3);
        ColsPrefetchTest.sameAs("q6k", 11L, 768L, 4, false, 3);
        ColsPrefetchTest.sameAs("q6k", 19L, 14336L, 4, true, 3);
        ColsPrefetchTest.sameAs("q6k", 1L, 4096L, 4, false, 3);
    }

    /** FIRES: pinned to two rows, each Cols launcher launches it; DOES NOT on the other pins. */
    @Test
    public void theLaunchersTakeTheTwoRowKernelOnlyWhenPinned() {
        if (!ColsPrefetchTest.both("q4k") || !ColsPrefetchTest.both("q6k")) { return; }
        int64 b4 = QuantKernel.q4ColsRowsLaunches();
        int64 b6 = QuantKernel.q6ColsRowsLaunches();
        ColsPrefetchTest.run("q4k", 8L, 2048L, 4, false, 3);
        ColsPrefetchTest.run("q6k", 8L, 2048L, 4, false, 3);
        Assert.equals(b4 + 1L, QuantKernel.q4ColsRowsLaunches());
        Assert.equals(b6 + 1L, QuantKernel.q6ColsRowsLaunches());
        ColsPrefetchTest.run("q4k", 8L, 2048L, 4, false, 1);
        ColsPrefetchTest.run("q4k", 8L, 2048L, 4, false, 2);
        ColsPrefetchTest.run("q6k", 8L, 2048L, 4, false, 1);
        ColsPrefetchTest.run("q6k", 8L, 2048L, 4, false, 2);
        Assert.equals(b4 + 1L, QuantKernel.q4ColsRowsLaunches());
        Assert.equals(b6 + 1L, QuantKernel.q6ColsRowsLaunches());
    }
}
