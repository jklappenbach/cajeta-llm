package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import cajeta.lang.String;

/**
 * xpu-kernel-adaptor 6.4.19: a value check that a NaN passes is not a
 * check. `d > bar` is false for a NaN, so a NaN result counted no row
 * outside the bar and never became the worst of a max tracker. Close
 * answers both questions with the NaN on the failing side.
 */
public class CloseTest {

    public CloseTest() { return; }

    static float32 nan32() {
        float32 z = 0.0f;
        return z / z;
    }

    static float64 nan64() {
        float64 z = 0.0;
        return z / z;
    }

    @Test
    public void aNanIsOutsideEveryBar() {
        Assert.isTrue(Close.outside(CloseTest.nan32(), 1.0f));
        Assert.isTrue(Close.outside(CloseTest.nan64(), 1.0));
        Assert.isFalse(Close.outside(0.5f, 1.0f));
        Assert.isFalse(Close.outside(1.0f, 1.0f));
        Assert.isTrue(Close.outside(1.5f, 1.0f));
        float32 inf = 1.0f / 0.0f;
        Assert.isTrue(Close.outside(inf, 1.0e30f));
        return;
    }

    @Test
    public void aNanIsTheWorstAndStaysIt() {
        Assert.isTrue(Close.worse(CloseTest.nan32(), 0.0f));
        Assert.isTrue(Close.worse(CloseTest.nan64(), 0.0));
        Assert.isTrue(Close.worse(2.0f, 1.0f));
        Assert.isFalse(Close.worse(1.0f, 2.0f));
        Assert.isFalse(Close.worse(1.0f, 1.0f));
        Assert.isFalse(Close.worse(5.0f, CloseTest.nan32()));
        Assert.isFalse(Close.worse(5.0, CloseTest.nan64()));
        return;
    }

    @Test
    public void aNanRowIsOutsideAndRuinsTheMaxRel() {
        float32[] a #= heap float32[3];
        float32[] b #= heap float32[3];
        a[0] = 1.0f; b[0] = 1.0f;
        a[1] = CloseTest.nan32(); b[1] = 1.0f;
        a[2] = 2.0f; b[2] = 2.0f;
        Assert.equals(1L, Close.rowsOutside(a, b, 3L, 1.0e-4f, 1.0e-6f));
        float32 rel = Close.maxRel(a, b, 3L);
        Assert.isTrue(rel != rel);
        b[1] = CloseTest.nan32();
        Assert.equals(1L, Close.rowsOutside(a, b, 3L, 1.0e-4f, 1.0e-6f));
        a[1] = 1.0f; b[1] = 1.0f;
        Assert.equals(0L, Close.rowsOutside(a, b, 3L, 1.0e-4f, 1.0e-6f));
        Assert.isTrue(Close.maxRel(a, b, 3L) == 0.0f);
        return;
    }
}
