package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.model.KernelCap;
import dev.cajeta.llm.model.Linear;
import cajeta.lang.String;
import cajeta.math.Tensor;
import cajeta.xpu.KernelManifest;

/**
 * cajeta-llm 15.2.19.1.1: a widened int8 (Mw8) GEMM whose mma the compiler lowered to the
 * software tile gives way to the format's coop GEMM where that one is native. Measured
 * 2026-10-26 on gfx1151 Vulkan: q3kWmmaDeqMw8Kernel took 1.22 s a 128x4096x4096 dispatch
 * (its epilogue verbs demote the kernel), q3kF16CoopX1Kernel 0.21 ms.
 */
public class Mw8TierTest {

    public Mw8TierTest() { return; }

    @AfterEach
    public void restore() {
        Diag.register(null);
        Linear.setDeqAuto(false);
        Linear.setDeqPrefill(false);
        return;
    }

    /** The manifest's own record, read here independently of KernelCap: 1 native, 2 software, 0 none. */
    static int32 recordedMmaTier(String kernel) {
        KernelManifest m = KernelManifest.of(kernel);
        if (m == null) { return 0; }
        int32 i = 0;
        while (i < m.nativeOpCount()) {
            if (m.nativeOp(i).equals("mma")) { return m.nativeOpTier(i).equals("native") ? 1 : 2; }
            i = i + 1;
        }
        return 0;
    }

    /** .1.1 */
    @Test
    public void theRuleDemotesOnlyASoftwareMw8BesideANativeCoop() {
        Assert.isTrue(Linear.mw8DemotedBy(2, 1));
        Assert.isFalse(Linear.mw8DemotedBy(1, 1));
        Assert.isFalse(Linear.mw8DemotedBy(2, 2));
        Assert.isFalse(Linear.mw8DemotedBy(1, 2));
        Assert.isFalse(Linear.mw8DemotedBy(0, 1));
        Assert.isFalse(Linear.mw8DemotedBy(2, 0));
    }

    /** .1.2 */
    @Test
    public void theMmaTierComesFromTheManifest() {
        Assert.equals(0L, (int64) KernelCap.mmaTier("noSuchKernelAnywhere"));
        if (!CensusReachTest.deviceHere()) { return; }
        int32 want = Mw8TierTest.recordedMmaTier("q3kF16CoopX1Kernel");
        if (want == 0) { return; }
        Assert.equals((int64) want, (int64) KernelCap.mmaTier("q3kF16CoopX1Kernel"));
    }

    /** .1.3 */
    @Test
    public void aDemotedQ3FormatTakesTheCoopRoute() {
        if (!CensusReachTest.deviceHere()) { return; }
        if (Mw8TierTest.recordedMmaTier("q3kWmmaDeqMw8Kernel") != 2
                || Mw8TierTest.recordedMmaTier("q3kF16CoopX1Kernel") != 1) {
            DeviceSkip.tracked("the Q3_K Mw8 mma is not the software tile beside a native coop here",
                "cajeta-llm 15.2.19.1.1");
            return;
        }
        int64 ci = (int64) LinearKernelRouteTest.CI;
        int64 co = (int64) LinearKernelRouteTest.CO;
        Linear lin #= LinearKernelRouteTest.tiled(Quant.GG_Q3_K, "q3_k.bin");
        Tensor<float32> x #= LinearKernelRouteTest.ramp(128L * ci, 0L);
        Tensor<float32> got #= LinearKernelRouteTest.ramp(0L, 128L * co);
        Linear.setDeqAuto(true);
        Linear.setDeqPrefill(false);
        Linear.resetRouteSaid();
        PrefillTap cap = heap PrefillTap();
        Diag.register(cap);
        Linear.stageBatch(x, 0L, 128, (int32) ci, Linear.nextStageTag());
        lin.matmulInto(128, got, 0L);
        Diag.register(null);
        String routes #= cap.namesOf("batch-route");
        if (!cap.sawContaining("batch-route", "coop q3_k")
                || cap.sawContaining("batch-route", "q3_k deqMw8")) {
            Assert.fail("expected the coop route for a demoted Q3_K Mw8, saw " + routes);
        }
    }
}
