package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.model.AttnKernel;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;

/**
 * cajeta-llm 15.2.12.3.5: the flash-decode split count follows the device, not
 * a fixed chunk. A fixed chunk of 8 capped every row over 512 positions at 64
 * splits (2048 single-wave workgroups a layer at four rows, and a 64-partial
 * reduce); the optimum measured on gfx1151 is ~16 waves a CU whatever the row
 * count, so splits = ceil(16 * CUs / (rows * nKv)), within [1, min(64, count)].
 * A pinned chunk (setFlashDecodeChunk(N), N > 0) overrides the rule for a sweep.
 */
public class FlashDecodeSplitsTest {

    public FlashDecodeSplitsTest() { return; }

    @Test
    public void theRuleTargetsSixteenWavesACu() {
        Assert.equals((int64) 10, (int64) AttnKernel.decodeSplits(640, 4, 8, 20));
        Assert.equals((int64) 20, (int64) AttnKernel.decodeSplits(640, 2, 8, 20));
        Assert.equals((int64) 40, (int64) AttnKernel.decodeSplits(640, 1, 8, 20));
        Assert.equals((int64) 5, (int64) AttnKernel.decodeSplits(640, 8, 8, 20));
        // the 4090: 128 CUs, one row -> the 64 cap
        Assert.equals((int64) 64, (int64) AttnKernel.decodeSplits(640, 1, 8, 128));
        // never more splits than positions
        Assert.equals((int64) 5, (int64) AttnKernel.decodeSplits(5, 4, 8, 20));
        Assert.equals((int64) 1, (int64) AttnKernel.decodeSplits(1, 4, 8, 20));
        // a device that reports no CUs still gets a sane count
        Assert.isTrue(AttnKernel.decodeSplits(640, 4, 8, 0) >= 1);
        Assert.isTrue(AttnKernel.decodeSplits(640, 4, 8, 0) <= 64);
    }

    @Test
    public void aPinnedChunkOverridesTheRule() {
        AttnKernel.setFlashDecodeChunk(64);
        Assert.equals((int64) 10, (int64) AttnKernel.decodeSplitsFor(640, 4, 8));
        AttnKernel.setFlashDecodeChunk(8);
        Assert.equals((int64) 64, (int64) AttnKernel.decodeSplitsFor(640, 4, 8));
        Assert.equals((int64) 2, (int64) AttnKernel.decodeSplitsFor(16, 4, 8));
        AttnKernel.setFlashDecodeChunk(0);
        int32 cus = Device.multiprocessorCount();
        Assert.equals((int64) AttnKernel.decodeSplits(640, 4, 8, cus),
            (int64) AttnKernel.decodeSplitsFor(640, 4, 8));
    }

    @Test
    public void theRowTableCarriesTheRulesSplits() {
        AttnKernel.setFlashDecodeChunk(0);
        int32[] slots #= heap int32[2];
        int32[] pos #= heap int32[2];
        slots[0] = 0; slots[1] = 4096;
        pos[0] = 639; pos[1] = 15;
        KernelBuffer<int32> tab #= heap KernelBuffer<int32>((uint64) 8);
        int32 maxS = AttnKernel.decodeRowTable(slots, pos, 2, 8, tab);
        int32[] h #= heap int32[8];
        tab.download(h);
        int32 cus = Device.multiprocessorCount();
        Assert.equals((int64) AttnKernel.decodeSplits(640, 2, 8, cus), (int64) h[3]);
        Assert.equals((int64) AttnKernel.decodeSplits(16, 2, 8, cus), (int64) h[7]);
        Assert.equals((int64) 640, (int64) h[2]);
        Assert.isTrue(maxS == h[3] || maxS == h[7]);
        Assert.isTrue(maxS >= h[3] && maxS >= h[7]);
    }
}
