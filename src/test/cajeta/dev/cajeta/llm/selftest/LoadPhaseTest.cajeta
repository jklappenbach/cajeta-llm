package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;

/**
 * prefill-routes plan 3.1.2 — `LlmEngine.load` emits a phase breakdown
 * under trace (open / bind / pack / warm-up / total nanos), so a slow
 * load has a named component before it is fixed. The toy fixture proves
 * the breakdown is emitted once and brackets the whole load; the "bytes
 * read dominates" property is a real-checkpoint claim, measured at 3.3.1.
 */
public class LoadPhaseTest {

    static final String TOY_MOE = "src/test/fixtures/gguf/toy-moe.gguf";

    public LoadPhaseTest() { return; }

    @Test
    public void loadEmitsAPhaseBreakdown() {
        EngineOptions o #= heap EngineOptions(LoadPhaseTest.TOY_MOE);
        o.ctx = 256;
        o.maxSeqs = 1;
        o.blockTokens = 16;
        o.chunk = 128;
        LoadPhaseCapture cap = heap LoadPhaseCapture();
        Diag.register(cap);
        LlmEngine e #= LlmEngine.load(#o);
        e.close();
        Diag.register(null);

        if (cap.n != 1) {
            Assert.fail("expected one load-phase breakdown, saw "
                + (int64) cap.n);
        }
        if (cap.total <= 0L) {
            Assert.fail("load total must be positive, was " + cap.total);
        }
        Assert.isTrue(cap.open >= 0L);
        Assert.isTrue(cap.bind >= 0L);
        Assert.isTrue(cap.pack >= 0L);
        Assert.isTrue(cap.warmup >= 0L);
        int64 sum = cap.open + cap.bind + cap.pack + cap.warmup;
        if (sum > cap.total) {
            Assert.fail("phases " + sum + " exceed total " + cap.total);
        }
        return;
    }
}

/** Keeps the first `load-phase` record's spans (valid only during the
 *  call, 11.8.3). Layout: v0 open, v1 bind, v2 pack, v3 warm-up,
 *  v4 total. */
final class LoadPhaseCapture implements DiagCallback {
    public int32 n;
    public int64 open;
    public int64 bind;
    public int64 pack;
    public int64 warmup;
    public int64 total;
    public LoadPhaseCapture() {
        this.n = 0;
        this.open = 0L;
        this.bind = 0L;
        this.pack = 0L;
        this.warmup = 0L;
        this.total = 0L;
    }
    public void onRecord(DiagRecord r) {
        if (!r.category.equals("load-phase")) { return; }
        if (this.n == 0) {
            this.open = r.v0;
            this.bind = r.v1;
            this.pack = r.v2;
            this.warmup = r.v3;
            this.total = r.v4;
        }
        this.n = this.n + 1;
        return;
    }
}
