package dev.cajeta.llm.selftest;

import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.WmmaKernel;

/**
 * prefill-routes 10.2.0 -- the wide-tile (128-row chunk) id-GEMM
 * against the 64-row chunk kernel at a Mixtral-shaped geometry: eight
 * experts, ragged groups 5/32/48/17/128/100/156/64 so every workgroup
 * sees 1..8 active tiles and a ragged tail, two column tiles per
 * workgroup (outDim 256), activations varied per row. Rows past the
 * batch are poisoned and must stay so.
 */
public class MoeIdMw8Test {

    public MoeIdMw8Test() { return; }

    static int32 E = 8;
    static int32 ROWS_E = 256;
    static int32 COLS = 512;
    static int32 NP = 550;

    /** Group row offsets for sizes 5, 32, 48, 17, 128, 100, 156, 64. */
    static int32 gOff(int32 e) {
        if (e <= 0) { return 0; }
        if (e == 1) { return 5; }
        if (e == 2) { return 37; }
        if (e == 3) { return 85; }
        if (e == 4) { return 102; }
        if (e == 5) { return 230; }
        if (e == 6) { return 330; }
        if (e == 7) { return 486; }
        return MoeIdMw8Test.NP;
    }

    static boolean skip() {
        String be #= Device.activeBackend();
        if (be.equals("cpu") || be.equals("none") || be.equals("vulkan")) {
            System.stdout.println("  [device-skip] (skipped: backend " + be
                + " has no wmma id kernel)");
            return true;
        }
        return false;
    }

    static #KernelBuffer<int8> packActs() {
        int64 cols = (int64) MoeIdMw8Test.COLS;
        int64 npp = (int64) MoeIdMw8Test.NP + 128L;
        float32[] xv = heap float32[npp * cols];
        int64 i = 0;
        while (i < npp * cols) {
            xv[i] = (float32) ((i % 25) - 12) / 64.0f
                + (float32) ((i / cols) % 13) * 0.02f
                + (float32) (i % 7) * 0.01f;
            i = i + 1;
        }
        KernelBuffer<float32> xf = heap KernelBuffer<float32>(
            (uint64) (npp * cols));
        xf.upload(xv, npp * cols);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>(
            (uint64) ((npp * cols / 256L) * 320L));
        QuantKernel.q8kPackLaunchNoSync(xp, xf, npp * cols);
        QuantKernel.stream().sync();
        return #xp;
    }

    static #KernelBuffer<int8> q4kSlab() {
        int32 rowBytes = (MoeIdMw8Test.COLS / 256) * 144;
        int64 total = (int64) MoeIdMw8Test.E
            * (int64) MoeIdMw8Test.ROWS_E * (int64) rowBytes;
        int8[] raw = heap int8[total];
        int64 i = 0;
        while (i < total) {
            int64 blk = i / 144L;
            int64 off = i % 144L;
            if (off == 1L) {
                raw[i] = (int8) 44;
            } else if (off == 3L) {
                raw[i] = (int8) 40;
            } else if (off == 0L || off == 2L) {
                raw[i] = (int8) ((blk * 37L + off * 11L) % 256L);
            } else {
                raw[i] = (int8) ((i * 131L + 17L) % 256L);
            }
            i = i + 1;
        }
        KernelBuffer<int8> slab = heap KernelBuffer<int8>(
            (uint64) (total + 4L));
        slab.upload(raw, total);
        return #slab;
    }

    /** One map entry per `stride`-row chunk of each group. */
    static int32 buildMaps(int32 stride, int32[] mE, int32[] mT0,
            int32[] mM1) {
        int32 nT = 0;
        int32 e = 0;
        while (e < MoeIdMw8Test.E) {
            int32 g0 = MoeIdMw8Test.gOff(e);
            int32 m = MoeIdMw8Test.gOff(e + 1) - g0;
            int32 tw = 0;
            while (tw * stride < m) {
                mE[nT] = e;
                mT0[nT] = g0 + tw * stride;
                mM1[nT] = g0 + m;
                nT = nT + 1;
                tw = tw + 1;
            }
            e = e + 1;
        }
        return nT;
    }

    @Test
    public void q4kWideIdAgreesWithTheChunkId() {
        if (MoeIdMw8Test.skip()) { return; }
        KernelBuffer<int8> slab #= MoeIdMw8Test.q4kSlab();
        KernelBuffer<int32> slabW #= slab.wordView();
        KernelBuffer<int8> xp #= MoeIdMw8Test.packActs();
        int32 cap = MoeIdMw8Test.NP / 64 + MoeIdMw8Test.E + 1;
        int32[] mE = heap int32[cap];
        int32[] mT0 = heap int32[cap];
        int32[] mM1 = heap int32[cap];
        int32 n64 = MoeIdMw8Test.buildMaps(64, mE, mT0, mM1);
        Assert.equals(12L, (int64) n64);
        KernelBuffer<int32> e64 = heap KernelBuffer<int32>((uint64) n64);
        KernelBuffer<int32> t64 = heap KernelBuffer<int32>((uint64) n64);
        KernelBuffer<int32> m64 = heap KernelBuffer<int32>((uint64) n64);
        e64.upload(mE, (int64) n64);
        t64.upload(mT0, (int64) n64);
        m64.upload(mM1, (int64) n64);
        int32 n8 = MoeIdMw8Test.buildMaps(128, mE, mT0, mM1);
        Assert.equals(9L, (int64) n8);
        KernelBuffer<int32> e8 = heap KernelBuffer<int32>((uint64) n8);
        KernelBuffer<int32> t8 = heap KernelBuffer<int32>((uint64) n8);
        KernelBuffer<int32> m8 = heap KernelBuffer<int32>((uint64) n8);
        e8.upload(mE, (int64) n8);
        t8.upload(mT0, (int64) n8);
        m8.upload(mM1, (int64) n8);
        int32[] metaH = heap int32[4];
        metaH[0] = n64;
        metaH[1] = n8;
        KernelBuffer<int32> meta = heap KernelBuffer<int32>((uint64) 4);
        meta.upload(metaH, 2L);

        int64 outDim = (int64) MoeIdMw8Test.ROWS_E;
        int64 nAll = ((int64) MoeIdMw8Test.NP + 128L) * outDim;
        int64 nOut = (int64) MoeIdMw8Test.NP * outDim;
        float32[] poison = heap float32[nAll];
        int64 pi = 0;
        while (pi < nAll) { poison[pi] = 777.0f; pi = pi + 1; }
        KernelBuffer<float32> y1 = heap KernelBuffer<float32>((uint64) nAll);
        KernelBuffer<float32> y2 = heap KernelBuffer<float32>((uint64) nAll);
        y1.upload(poison, nAll);
        y2.upload(poison, nAll);
        WmmaKernel.q4kWmmaIdMwLaunchNoSync(y1, slab, slabW, xp, e64, t64,
            m64, meta, (int64) n64 + 3L, outDim, (int64) MoeIdMw8Test.COLS,
            (int64) MoeIdMw8Test.ROWS_E);
        // The grid overshoots meta[1] on purpose: workgroups past the
        // count must exit without touching y.
        WmmaKernel.q4kWmmaIdMw8LaunchNoSync(y2, slab, slabW, xp, e8, t8,
            m8, meta, (int64) n8 + 3L, outDim, (int64) MoeIdMw8Test.COLS,
            (int64) MoeIdMw8Test.ROWS_E);
        KernelStream s = QuantKernel.stream();
        s.sync();
        float32[] a = heap float32[nAll];
        float32[] b = heap float32[nAll];
        y1.download(a, nAll);
        y2.download(b, nAll);
        int64 i = 0;
        while (i < nOut) {
            float32 av = a[i];
            float32 bv = b[i];
            float32 d = av - bv;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 mag = av;
            if (mag < 0.0f) { mag = 0.0f - mag; }
            if (d > mag * 0.002f + 0.002f) {
                Assert.fail("wide vs chunk id element " + i + " (token "
                    + (i / outDim) + ", row " + (i % outDim) + "): "
                    + bv + " vs " + av);
            }
            i = i + 1;
        }
        int64 t = 0;
        while (t < (int64) MoeIdMw8Test.NP) {
            boolean live = false;
            int64 c2 = 0;
            while (c2 < outDim) {
                if (b[t * outDim + c2] != 777.0f) { live = true; }
                c2 = c2 + 1;
            }
            Assert.isTrue(live);
            t = t + 1;
        }
        int64 q = nOut;
        while (q < nAll) {
            if (b[q] != 777.0f) {
                Assert.fail("wide id wrote past the batch at element " + q
                    + " (row " + (q / outDim) + ")");
            }
            q = q + 1;
        }
    }

    static #KernelBuffer<int8> q6kSlab() {
        int32 rowBytes = (MoeIdMw8Test.COLS / 256) * 210;
        int64 total = (int64) MoeIdMw8Test.E
            * (int64) MoeIdMw8Test.ROWS_E * (int64) rowBytes;
        int8[] raw = heap int8[total];
        int64 i = 0;
        while (i < total) {
            int64 off = i % 210L;
            if (off == 209L) {
                raw[i] = (int8) 44;
            } else {
                raw[i] = (int8) ((i * 131L + 17L) % 256L);
            }
            i = i + 1;
        }
        // Unit 9: Q6_K is resident in the split layout — a row's f16
        // scales, then its payloads — so the slab the id kernels read
        // is the split one.
        int64 bpr6 = (int64) (MoeIdMw8Test.COLS / 256);
        int64 nRows = (int64) MoeIdMw8Test.E * (int64) MoeIdMw8Test.ROWS_E;
        int64 resBytes = nRows * Quant.rowResidentBytes(Quant.GG_Q6_K, bpr6);
        int8[] dev = heap int8[resBytes];
        Quant.splitInto(Quant.GG_Q6_K, raw, 0L, nRows, bpr6, dev, 0L);
        KernelBuffer<int8> slab = heap KernelBuffer<int8>(
            (uint64) (resBytes + 4L));
        slab.upload(dev, resBytes);
        return #slab;
    }

    /** Compares rows below NP at the reassociation bar, every row
     *  live, and the poisoned rows past the batch untouched. */
    static void check(KernelBuffer<float32> y1, KernelBuffer<float32> y2,
            int64 outDim, String what) {
        int64 nAll = ((int64) MoeIdMw8Test.NP + 128L) * outDim;
        int64 nOut = (int64) MoeIdMw8Test.NP * outDim;
        float32[] a = heap float32[nAll];
        float32[] b = heap float32[nAll];
        y1.download(a, nAll);
        y2.download(b, nAll);
        int64 i = 0;
        while (i < nOut) {
            float32 av = a[i];
            float32 bv = b[i];
            float32 d = av - bv;
            if (d < 0.0f) { d = 0.0f - d; }
            float32 mag = av;
            if (mag < 0.0f) { mag = 0.0f - mag; }
            if (d > mag * 0.002f + 0.002f) {
                Assert.fail(what + " element " + i + " (token "
                    + (i / outDim) + ", row " + (i % outDim) + "): "
                    + bv + " vs " + av);
            }
            i = i + 1;
        }
        int64 t = 0;
        while (t < (int64) MoeIdMw8Test.NP) {
            boolean live = false;
            int64 c2 = 0;
            while (c2 < outDim) {
                if (b[t * outDim + c2] != 777.0f) { live = true; }
                c2 = c2 + 1;
            }
            Assert.isTrue(live);
            t = t + 1;
        }
        int64 q = nOut;
        while (q < nAll) {
            if (b[q] != 777.0f) {
                Assert.fail(what + " wrote past the batch at element " + q);
            }
            q = q + 1;
        }
    }

    /** The widened wide-tile kernel with Q6_K's per-16 image (the
     *  widen and the image kernel included) against the packed 64-row
     *  Q6_K id kernel. */
    @Test
    public void q6kWideWidenedIdAgreesWithThePackedChunkId() {
        if (MoeIdMw8Test.skip()) { return; }
        KernelBuffer<int8> slab #= MoeIdMw8Test.q6kSlab();
        KernelBuffer<int32> slabW #= slab.wordView();
        KernelBuffer<int8> xp #= MoeIdMw8Test.packActs();
        int64 rows = (int64) MoeIdMw8Test.E * (int64) MoeIdMw8Test.ROWS_E;
        int64 cols = (int64) MoeIdMw8Test.COLS;
        KernelBuffer<int8> deq = heap KernelBuffer<int8>((uint64) (rows * cols));
        KernelBuffer<float32> img = heap KernelBuffer<float32>(
            (uint64) (rows * (cols / 256L) * 16L));
        WmmaKernel.q6kWidenLaunch(deq, slab, rows, cols);
        WmmaKernel.q6kScaleImageLaunch(img, slab, rows, cols);
        int32 cap = MoeIdMw8Test.NP / 64 + MoeIdMw8Test.E + 1;
        int32[] mE = heap int32[cap];
        int32[] mT0 = heap int32[cap];
        int32[] mM1 = heap int32[cap];
        int32 n64 = MoeIdMw8Test.buildMaps(64, mE, mT0, mM1);
        KernelBuffer<int32> e64 = heap KernelBuffer<int32>((uint64) n64);
        KernelBuffer<int32> t64 = heap KernelBuffer<int32>((uint64) n64);
        KernelBuffer<int32> m64 = heap KernelBuffer<int32>((uint64) n64);
        e64.upload(mE, (int64) n64);
        t64.upload(mT0, (int64) n64);
        m64.upload(mM1, (int64) n64);
        int32 n8 = MoeIdMw8Test.buildMaps(128, mE, mT0, mM1);
        KernelBuffer<int32> e8 = heap KernelBuffer<int32>((uint64) n8);
        KernelBuffer<int32> t8 = heap KernelBuffer<int32>((uint64) n8);
        KernelBuffer<int32> m8 = heap KernelBuffer<int32>((uint64) n8);
        e8.upload(mE, (int64) n8);
        t8.upload(mT0, (int64) n8);
        m8.upload(mM1, (int64) n8);
        int32[] metaH = heap int32[4];
        metaH[0] = n64;
        metaH[1] = n8;
        KernelBuffer<int32> meta = heap KernelBuffer<int32>((uint64) 4);
        meta.upload(metaH, 2L);
        int64 outDim = (int64) MoeIdMw8Test.ROWS_E;
        int64 nAll = ((int64) MoeIdMw8Test.NP + 128L) * outDim;
        float32[] poison = heap float32[nAll];
        int64 pi = 0;
        while (pi < nAll) { poison[pi] = 777.0f; pi = pi + 1; }
        KernelBuffer<float32> y1 = heap KernelBuffer<float32>((uint64) nAll);
        KernelBuffer<float32> y2 = heap KernelBuffer<float32>((uint64) nAll);
        y1.upload(poison, nAll);
        y2.upload(poison, nAll);
        WmmaKernel.q6kWmmaIdMwLaunchNoSync(y1, slab, slabW, xp, e64, t64,
            m64, meta, (int64) n64 + 3L, outDim, cols, outDim);
        WmmaKernel.symWmmaDeqIdMw8LaunchNoSync(y2, slab, img, deq, xp, e8,
            t8, m8, meta, (int64) n8 + 3L, outDim, cols, outDim, 1L);
        KernelStream s = QuantKernel.stream();
        s.sync();
        MoeIdMw8Test.check(y1, y2, outDim, "q6k wide widened vs packed chunk id");
    }

    /** The widened wide-tile kernel with the symmetric formats' f16
     *  per-32 image against the 64-row widened id kernel, both over
     *  the same synthetic int8 slab and image. */
    @Test
    public void symWideWidenedIdAgreesWithTheChunkId() {
        if (MoeIdMw8Test.skip()) { return; }
        int64 rows = (int64) MoeIdMw8Test.E * (int64) MoeIdMw8Test.ROWS_E;
        int64 cols = (int64) MoeIdMw8Test.COLS;
        int8[] dq = heap int8[rows * cols];
        int64 i = 0;
        while (i < rows * cols) {
            dq[i] = (int8) ((i * 131L + 17L) % 256L);
            i = i + 1;
        }
        KernelBuffer<int8> deq = heap KernelBuffer<int8>((uint64) (rows * cols));
        deq.upload(dq, rows * cols);
        int64 nImg = rows * (cols / 32L) * 2L;
        int8[] im = heap int8[nImg];
        int64 k = 0;
        while (k < nImg) {
            if (k % 2L == 1L) { im[k] = (int8) 44; }
            else { im[k] = (int8) ((k * 37L + 5L) % 256L); }
            k = k + 1;
        }
        KernelBuffer<int8> img = heap KernelBuffer<int8>((uint64) nImg);
        img.upload(im, nImg);
        KernelBuffer<int8> xp #= MoeIdMw8Test.packActs();
        int32 cap = MoeIdMw8Test.NP / 64 + MoeIdMw8Test.E + 1;
        int32[] mE = heap int32[cap];
        int32[] mT0 = heap int32[cap];
        int32[] mM1 = heap int32[cap];
        int32 n64 = MoeIdMw8Test.buildMaps(64, mE, mT0, mM1);
        KernelBuffer<int32> e64 = heap KernelBuffer<int32>((uint64) n64);
        KernelBuffer<int32> t64 = heap KernelBuffer<int32>((uint64) n64);
        KernelBuffer<int32> m64 = heap KernelBuffer<int32>((uint64) n64);
        e64.upload(mE, (int64) n64);
        t64.upload(mT0, (int64) n64);
        m64.upload(mM1, (int64) n64);
        int32 n8 = MoeIdMw8Test.buildMaps(128, mE, mT0, mM1);
        KernelBuffer<int32> e8 = heap KernelBuffer<int32>((uint64) n8);
        KernelBuffer<int32> t8 = heap KernelBuffer<int32>((uint64) n8);
        KernelBuffer<int32> m8 = heap KernelBuffer<int32>((uint64) n8);
        e8.upload(mE, (int64) n8);
        t8.upload(mT0, (int64) n8);
        m8.upload(mM1, (int64) n8);
        int32[] metaH = heap int32[4];
        metaH[0] = n64;
        metaH[1] = n8;
        KernelBuffer<int32> meta = heap KernelBuffer<int32>((uint64) 4);
        meta.upload(metaH, 2L);
        int64 outDim = (int64) MoeIdMw8Test.ROWS_E;
        int64 nAll = ((int64) MoeIdMw8Test.NP + 128L) * outDim;
        float32[] poison = heap float32[nAll];
        int64 pi = 0;
        while (pi < nAll) { poison[pi] = 777.0f; pi = pi + 1; }
        KernelBuffer<float32> y1 = heap KernelBuffer<float32>((uint64) nAll);
        KernelBuffer<float32> y2 = heap KernelBuffer<float32>((uint64) nAll);
        y1.upload(poison, nAll);
        y2.upload(poison, nAll);
        KernelBuffer<float32> no32 = heap KernelBuffer<float32>((uint64) 16);
        WmmaKernel.symWmmaDeqMw8IdLaunchNoSync(y1, img, deq, xp, e64, t64,
            m64, meta, (int64) n64 + 3L, outDim, cols, outDim);
        WmmaKernel.symWmmaDeqIdMw8LaunchNoSync(y2, img, no32, deq, xp, e8,
            t8, m8, meta, (int64) n8 + 3L, outDim, cols, outDim, 0L);
        KernelStream s = QuantKernel.stream();
        s.sync();
        MoeIdMw8Test.check(y1, y2, outDim, "sym wide widened vs chunk id");
    }
}
