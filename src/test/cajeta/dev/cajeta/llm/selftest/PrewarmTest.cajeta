package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.ModelConfig;
import cajeta.lang.String;

/**
 * The load-time prewarm (11.3, `CausalLM.prewarmPrefillWeights`) builds
 * every device side a batched step touches. An f32 projection has NONE:
 * every route runs it on the host, and its `ensureDevice` is the packed
 * upload path, which throws by design ("type -1 means this Linear holds
 * no packed weight at all"). The toy fixture is mostly f32, so every
 * engine test that loaded it failed at load from 2026-09-15 until the
 * prewarm learned to pin only what has a packed weight (2026-09-25).
 */
public class PrewarmTest {

    static final String TOY = "src/test/fixtures/gguf/toy.gguf";

    public PrewarmTest() { return; }

    @Test
    public void f32ProjectionsSurviveThePrewarm() {
        Checkpoint ck #= Checkpoint.open(PrewarmTest.TOY);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        cfg.blockTokens = 4;
        CausalLM m #= heap CausalLM(#cfg, 64, 1, 0);
        m.bind(ck, false);
        ck.close();
        Linear head = m.headLinear();
        Assert.isTrue(head != null);
        // The toy's output.weight is f32: no packed weight, no device side.
        Assert.isTrue(head.packedType() < 0);
        m.prewarmPrefillWeights();
        Assert.isTrue(head.packedType() < 0);
    }
}
